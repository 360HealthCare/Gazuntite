<?xml version="1.0" encoding="utf-8"?>
<components1:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
						 xmlns:s="library://ns.adobe.com/flex/spark" 
						 xmlns:mx="library://ns.adobe.com/flex/mx" 
						 skinClass="com.gazuntite.controls.extended.skins.popupWindowSkin"
						 xmlns:components="com.gazuntite.controls.extended.components.*" 
						 xmlns:view="com.gazuntite.provider.search.services.patient.view.*" 
						 xmlns:view1="com.gazuntite.provider.search.services.patient.view.*"
						 xmlns:components1="com.gazuntite.controls.extended.components.*"
						 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.PatientDTO;
			import com.gazuntite.common.util.ValidationUtils;
			import com.gazuntite.common.view.events.ListOnlySelectionEvent;
			import com.gazuntite.provider.live.services.elab.model.ELabsAppModelLocator;
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.formatters.DateFormatter;
			
			[Bindable]
			public var model : ELabsAppModelLocator = ELabsAppModelLocator.getInstance();
			
			private var selectedPatient:PatientDTO;
			/* private var m_acDataProvider:ArrayCollection;
			
			[Bindable]
			public function get DataProvider():ArrayCollection
			{
			return m_acDataProvider;
			}
			
			public function set DataProvider(value:ArrayCollection):void
			{
			m_acDataProvider = value;
			} */
			
			protected function OK_clickHandler(event:MouseEvent):void
			{
				var hasValue:Boolean 		= false;
				var e:ListOnlySelectionEvent	= new ListOnlySelectionEvent(); 
				
				if( selectedPatient )
				{
					var PID:int   				= selectedPatient.ID;
					hasValue	 				= true; 
				}
				
				if( id_Laboratories.selectedItem )
				{
					var LID:int 				= id_Laboratories.selectedItem.ID;
					hasValue	 				= true;
				}
				
				if( id_OrderMethod.selectedItem )
				{
					var MethodID:int					= id_OrderMethod.selectedItem.ID;
					hasValue	 				= true;
				}
				
				if( id_FromDate.text.length > 0 && id_ToDate.text.length > 0 )
				{
					if(ValidationUtils.isValidDateRange(id_FromDate.selectedDate, id_ToDate.selectedDate))
					{
						var df:DateFormatter 		= new DateFormatter();
						df.formatString 			= "MM-DD-YYYY";
						e.from 						= df.format( id_FromDate.text );
						e.to 						= df.format( id_ToDate.text );
						hasValue	 				= true;
					}else
					{
						Alert.show('From date is always befor to date', 'info',4, FlexGlobals.topLevelApplication.mainContainer);
						return;
					}
				}
				
				if( hasValue )
				{
					e.selection 				= {method:id_OrderMethod.selectedItem, patientID:PID, LaboratoryID:LID, methodID:MethodID };
					dispatchEvent( e );
					removePopup();
				}
				else
				{
					Alert.show("Please provide some criteria to filter record.","Invalid Input");
				}
				
			}
			
			
			protected function Cancel_clickHandler(event:MouseEvent):void
			{
				removePopup();
			}
			
			
			protected function id_SearchPatientView_PatientSelectedHandler(event:PatientSelectedEvent):void
			{
				try
				{
					selectedPatient	= event.selection as PatientDTO;
					trace("PatientSelectedHandler --> ",selectedPatient.ID, selectedPatient.FirstName, selectedPatient.LastName);
					
					
					var fName:String = selectedPatient.FirstName ? selectedPatient.FirstName :"";
					var mName:String = selectedPatient.MiddleName? selectedPatient.MiddleName:"";
					var lName:String = selectedPatient.LastName  ? selectedPatient.LastName  :"";
					
					id_SearchPatientView.id_patientSearch.text = selectedPatient.FirstName+" "+selectedPatient.MiddleName+" "+selectedPatient.LastName; 
					/* id_PatientName.text 	= fName + " " + mName + " " + lName;
					id_PatientName.enabled 	= false;
					
					id_quivusId.text 	= selectedPatient.QuivusID;
					id_quivusId.enabled = false;k
					
					id_gender.text 		= selectedPatient.Gender;
					id_gender.enabled 	= false;
					
					selectedPatientId 	= selectedPatient.ID;
					selectedPatientName	= selectedPatient.FirstName+"|"+selectedPatient.MiddleName+"|"+selectedPatient.LastName; */
				}
				catch(e:Error)
				{
					trace("patientExamControls", e );
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<components:layout>
		<s:VerticalLayout paddingLeft="10" paddingRight="10" paddingTop="10" paddingBottom="10" />
	</components:layout>
	<s:HGroup>
		
		<s:VGroup width="50%" height="100%"	>
			
			<s:HGroup width="100%"  textAlign="left" verticalAlign="middle" >
				<components1:LabelDateField id="id_FromDate" width="100" prompt="From" fontFamily="calibri" fontSize="11" />
				<components1:LabelDateField id="id_ToDate"  width="100" prompt="To" 	 fontFamily="calibri" fontSize="11"	 />
			</s:HGroup>
			
			<components1:LabelComboBox id="id_OrderMethod" dataProvider="{model.MethodListDto.Methods}"
									   prompt="Order Method" labelField="Name" 
									   width="262" height="24" fontFamily="Calibri" fontSize="11"  />
			
		</s:VGroup>
		
		<s:VGroup width="50%" height="100%"	>
			<s:SkinnableContainer styleName="patientSearchBGContainerSkin"  width="100%" >
				<view:AutoCompleteSearch id="id_SearchPatientView"  width="100%" height="23"  
										 PatientSelected="id_SearchPatientView_PatientSelectedHandler(event)" />
				
			</s:SkinnableContainer>
			<components1:LabelComboBox id="id_Laboratories" dataProvider="{model.LaboratoryListDto.Laboratories}" 
									   prompt="Laboratory" width="262" height="24" fontFamily="Calibri" fontSize="11"  />
			
		</s:VGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" verticalAlign="middle" gap="6" horizontalAlign="right" paddingRight="6">
		
		<s:Button label="Apply" click="OK_clickHandler(event)" width="50"   skinClass="com.gazuntite.skins.controls.button.ListBtn2" buttonMode="true" />
		<s:Button label="Cancel" click="Cancel_clickHandler(event)" width="60" skinClass="com.gazuntite.skins.controls.button.ListBtn2" buttonMode="true"/>
		
	</s:HGroup>
	
</components1:PopupWindow>
