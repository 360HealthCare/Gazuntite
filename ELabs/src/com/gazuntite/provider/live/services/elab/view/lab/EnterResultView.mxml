<?xml version="1.0" encoding="utf-8"?>
<components1:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
						xmlns:s="library://ns.adobe.com/flex/spark" 
						xmlns:mx="library://ns.adobe.com/flex/mx" 
						skinClass="com.gazuntite.controls.extended.skins.popupWindowSkin"
						xmlns:view="com.gazuntite.provider.search.services.patient.view.*" 
						xmlns:components1="com.gazuntite.controls.extended.components.*"
						>
	<fx:Script>
		<![CDATA[
			
			
			public static const SAVE_RESULT_EVENT			:String		= "SaveResult"; 
			public static const CANCEL_RESULT_EVENT			:String		= "CancelResult"; 
			public static const ATTACHMENT_EVENT			:String		= "Attachment"; 
			public static const HL7_ATTACHMENT_EVENT		:String		= "HL7Attachment"; 
			
			private var m_PatientName:String;
			
			[Bindable]
			public function get PatientName():String
			{
				return m_PatientName;
			}
			
			public function set PatientName(value:String):void
			{
				m_PatientName = value;
			}
			
			private var m_TestName:String;
			
			[Bindable]
			public function get TestName():String
			{
				return m_TestName;
			}
			
			public function set TestName(value:String):void
			{
				m_TestName = value;
			}
			
			private var m_oRefRange:String;
			[Bindable]	
			public function get RefRange():String
			{
				return m_oRefRange;
			}

			public function set RefRange(value:String):void
			{
				m_oRefRange = value;
			}
			
			private var m_oMethodName:String;

			[Bindable]
			public function get MethodName():String
			{
				return m_oMethodName;
			}

			public function set MethodName(value:String):void
			{
				m_oMethodName = value;
			}

			
			protected function Attachment_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event(ATTACHMENT_EVENT, true, true ) );
			}
			
			protected function HL7_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event(HL7_ATTACHMENT_EVENT, true, true ) );
			}
			
			protected function Save_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event(SAVE_RESULT_EVENT, true, true ) );
			}
			
			protected function Cancel_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event(CANCEL_RESULT_EVENT, true, true ) );
			}
				
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer width="100%" height="100%" styleName="greyBGContainerSkin">
		
		<s:layout>
			<s:VerticalLayout horizontalAlign="center" paddingBottom="10" paddingLeft="10" paddingRight="10" paddingTop="10" gap="10" />
		</s:layout>
		
		<s:SkinnableContainer width="100%" height="100%" styleName="torquiseTitleLightGreyBGContainerSkin">
			
			<s:layout>
				<s:VerticalLayout paddingBottom="10" paddingLeft="10" paddingRight="10" paddingTop="10" gap="10" />
			</s:layout>
			
			<s:HGroup width="100%">
				<s:Label text="Patient Name:" width="100" />
				<s:Label text="{PatientName}" width="150" />
				<s:Group id="spacer1" width="100" />
				<s:Label text="Test Name:" />
				<s:Label text="{TestName}" width="100%" />
			</s:HGroup>
			
			<s:HGroup width="100%">
				<s:Label text="Refrence Range:" width="100" />
				<s:Label text="{RefRange}" width="150"  />
				<s:Group id="spacer2" width="100" />
				<components1:LabelTextInput id="id_txtResult" prompt="Enter Result" width="100%" toolTip="Enter Result" restrict="[0-9 a-zA-Z]"/>
			</s:HGroup>
			
			<s:HGroup width="100%" horizontalAlign="right">
				<s:Label id="id_UploadStatus" width="100%" visible="false" textAlign="right" />
				<s:Button width="85" label="Attachment"
						  click="Attachment_clickHandler(event)"
						  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn"/>
				<s:Button width="70" label="HL7" click="HL7_clickHandler(event)"
						  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" enabled="{MethodName == 'HL7' ? true:false}"/>
			</s:HGroup>
			
		</s:SkinnableContainer>
		
		<s:Line width="98.5%" height="1" >
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#4C4D51"  weight="1"/>
			</s:stroke>
		</s:Line>
		
		<s:HGroup width="100%" horizontalAlign="right" paddingRight="8">
			<s:Button x="1053" width="85" label="Save"
					  click="Save_clickHandler(event)"
					  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn"/>
			<s:Button width="70" label="Cancel" click="Cancel_clickHandler(event)"
					  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn"/>
		</s:HGroup>
	</s:SkinnableContainer>
	
</components1:PopupWindow>
