<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:buttonSkins="com.adobe.gazuntite.skins.chrome.buttonSkins.*" 
		 xmlns:popUps="com.gazuntite.provider.live.services.elab.view.popUps.*" 
		 xmlns:Filters="com.gazuntite.provider.live.services.elab.view.Filters.*"
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.elab.dto.ELabFilterCriteriaDTO;
			import com.gazuntite.provider.live.services.elab.dto.SearchFieldsDTO;
			import com.gazuntite.provider.live.services.elab.util.ELabsConstant;
			import com.gazuntite.provider.live.services.elab.view.event.ELabGridFilterEvent;
			import com.gazuntite.provider.live.services.elab.view.popUps.ElabSearchTypePopUp;
			import com.gazuntite.utils.ValidationUtils;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.utils.StringUtil;
			
			private static const SEARCH_BY:String = "Search by ";
			
			private var _pageNo:int;
			private var _doShowProcessButton:Boolean;
			private var _searchTypeDataProvider:ArrayCollection;
			private var _searchTypeLabelField:String;
			private var _firstRecord:int;
			private var _lastRecord:int;
			private var _totalRecords:int;
			
			private var _recordsFound:Boolean; //controls visibility of noRecordFoundLbl
			private var _recordsSelected:Boolean;// controls the enability of process button
			private var _isSearchPopUpShown:Boolean;
			
			private var searchType:SearchFieldsDTO;
			
			private var searchTypePopUp:ElabSearchTypePopUp;
			
			
			[Bindable]
			private var searchPrompt:String;
			
			public function get pageNo():int
			{
				return _pageNo;
			}
			
			public function set pageNo(value:int):void
			{
				_pageNo = value;
				
				id_lblPageNo.text = pageNo.toString();
			}
			
			[Bindable]
			public function get doShowProcessButton():Boolean
			{
				return _doShowProcessButton;
			}
			
			public function set doShowProcessButton(value:Boolean):void
			{
				_doShowProcessButton = value;
			}
			
			[Bindable]
			public function get searchTypeDataProvider():ArrayCollection
			{
				return _searchTypeDataProvider;
			}
			
			public function set searchTypeDataProvider(value:ArrayCollection):void
			{
				_searchTypeDataProvider = value;
			}
			
			[Bindable]
			public function get searchTypeLabelField():String
			{
				return _searchTypeLabelField;
			}
			
			public function set searchTypeLabelField(value:String):void
			{
				_searchTypeLabelField = value;
			}
			
			[Bindable]
			public function get firstRecord():int
			{
				return _firstRecord;
			}
			
			public function set firstRecord(value:int):void
			{
				_firstRecord = value;
				
				if (firstRecord <= 1)
				{
					id_showPrev.enabled = false;
				}
				else
				{
					id_showPrev.enabled = true;
				}
			}
			
			[Bindable]
			public function get lastRecord():int
			{
				return _lastRecord;
			}
			
			public function set lastRecord(value:int):void
			{
				_lastRecord = value;
				
				if (totalRecords - lastRecord <= 0)
				{
					id_showNext.enabled = false;
				}
				else
				{
					id_showNext.enabled = true;
				}
			}
			
			[Bindable]
			public function get totalRecords():int
			{
				return _totalRecords;
			}
			
			public function set totalRecords(value:int):void
			{
				_totalRecords = value;
			}
			
			[Bindable]
			public function get recordsFound():Boolean
			{
				return _recordsFound;
			}
			
			public function set recordsFound(value:Boolean):void
			{
				if (_recordsFound != value)
				{
					_recordsFound = value;
					
					//noRecordFoundLbl.visible = !recordsFound;
				}
			} 
			
			[Bindable]
			public function get recordsSelected():Boolean
			{
				return _recordsSelected;
			}
			
			public function set recordsSelected(value:Boolean):void
			{
				_recordsSelected = value;
			}
			
			[Bindable]
			public function get isSearchPopUpShown():Boolean
			{
				return _isSearchPopUpShown;
			}
			
			public function set isSearchPopUpShown(value:Boolean):void
			{
				_isSearchPopUpShown = value;
			}
			
			public function removeSearchPopUp():void
			{
				if (isSearchPopUpShown)
					searchTypePopUp.removePopUp();
			}
			
			private function showSearchTypePopUp():void
			{
				if (!searchTypePopUp)
					searchTypePopUp = new ElabSearchTypePopUp();
				
				searchTypePopUp.searchTypeDataProvider = searchTypeDataProvider;
				
				var pLoc:Point = new Point(moreOptions.x, moreOptions.y + moreOptions.height + 8);
				var exactLoc:Point = this.localToGlobal(pLoc);
				
				searchTypePopUp.x = exactLoc.x;
				searchTypePopUp.y = exactLoc.y;
				
				searchTypePopUp.showPopUp(this);
				isSearchPopUpShown = true;
				
				searchTypePopUp.addEventListener(ELabGridFilterEvent.SEARCH_TYPE_CHANGED, searchTypeChangedHandler, false, 0, true);
				searchTypePopUp.addEventListener(ELabGridFilterEvent.FILTER_CLICKED, filterClickedHandler, false, 0, true);
				searchTypePopUp.addEventListener(ELabGridFilterEvent.SEARCH_POP_UP_CLOSED, searchTypePopUpClosedHandler, false, 0, true);
			}
			
			private function moreOptionsClickHandler():void
			{
				showSearchTypePopUp();
			}
			
			private function searchKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.keyCode == Keyboard.ENTER)
				{
					searchClickHandler();
				}
			}
			
			private function searchTypeChangedHandler(event:ELabGridFilterEvent):void
			{
				if (!event.searchType)
					return;
				
				searchType = event.searchType;
				
				
				if (searchType.Name == "All")
				{
					searchPrompt = "Search all Records";
				}
				else
				{
					searchPrompt = SEARCH_BY + searchType.Name;
				}
				
				id_Search.prompt = searchPrompt;
				id_Search.toolTip = searchPrompt;
				
				id_Search.text = "";
				
				changeIcon(searchType.Name);
				
				if (filterView.visible)
				{
					filterView.visible = false;
					filterView.includeInLayout = false;
				}
			}
			
			private function filterClickedHandler(event:ELabGridFilterEvent):void
			{
				id_Search.prompt = "Filter";
				id_Search.text = "";
				
				enableSearchBox(false);
				
				filterView.setFocusToFirstField();
				
				filterView.visible = true;
				filterView.includeInLayout = true;
				
				filterView.addEventListener(ELabGridFilterEvent.APPLY_FILTER_CLICKED, closeFilterView, false, 0, true);
				filterView.addEventListener(ELabGridFilterEvent.CANCEL_FILTER_CLICKED, closeFilterView, false, 0, true);
			}
			
			private function searchTypePopUpClosedHandler(event:ELabGridFilterEvent):void
			{
				isSearchPopUpShown = false;
			}
			
			private function closeFilterView(event:ELabGridFilterEvent):void
			{
				if (searchType)
				{
					if (searchType.Name == "All")
						searchPrompt = "Search all Records";
						
					else
						searchPrompt = SEARCH_BY + searchType.Name;
				}
				else
				{
					searchPrompt = "Search";
				}
				
				id_Search.prompt = searchPrompt;
				id_Search.toolTip = searchPrompt;
				
				id_Search.text = "";
				
				enableSearchBox(true);
				
				filterView.visible = false;
				filterView.includeInLayout = false;
				
				if (!event.eLabFilterCriteria)
					return;
				
				if (event.type == ELabGridFilterEvent.APPLY_FILTER_CLICKED)
					event.eLabFilterCriteria.LoadType = ELabsConstant.ADVANCED_SEARCH_LOAD_TYPE;	
			}
			
			private function searchClickHandler():void
			{
				if (!searchType)
				{
					Alert.show("Please select search type to perform search", "Info", Alert.OK,
						FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
						{
							trace();
						});
					
					return;
				}
				
				if (searchType.Name == "Date") //validating date before sending search request
				{
					if (!ValidationUtils.isValidDateFormat(id_Search.text) || 
						!ValidationUtils.isValidDateString(id_Search.text))
					{
						Alert.show("Please enter valid date in valid format [MM/DD/YYYY]", "Invalid Data/format", 4,
							FlexGlobals.topLevelApplication.mainContainer);
						return;
					}
				}
				
				if (searchType.Name == "Patient" && (StringUtil.trim(id_Search.text).indexOf(",") > -1 && StringUtil.trim(id_Search.text).indexOf(",") == 0 ) ) //validating date before sending search request
				{
						
					Alert.show("Please enter last name before comma (,)", "Invalid Data", 4,
						FlexGlobals.topLevelApplication.mainContainer);
					return;					
				}
					
				if (searchType.Name == "Patient" && (StringUtil.trim(id_Search.text).indexOf(",") > -1 && String(StringUtil.trim(id_Search.text).split(",")[1]).length == 0 ) ) //validating date before sending search request
				{
							
					Alert.show("Please enter first name after comma (,)", "Invalid Data", 4,
						FlexGlobals.topLevelApplication.mainContainer);
					return;					
				}
						
				var ev:ELabGridFilterEvent = new ELabGridFilterEvent(ELabGridFilterEvent.SEARCH_CLICKED, true);
				ev.eLabFilterCriteria = initializeFilterCriteria();
				
				ev.eLabFilterCriteria.SearchTerm = StringUtil.trim(id_Search.text);
				ev.eLabFilterCriteria.FieldID = parseInt(searchType.ID);
				
				if (ev.eLabFilterCriteria.FieldID == 10) //to load all lab orders without any filter
					ev.eLabFilterCriteria.LoadType = ELabsConstant.ALL_LABS_LOAD_TYPE;
				else
					ev.eLabFilterCriteria.LoadType = ELabsConstant.SIMPLE_SEARCH_LOAD_TYPE;
				
				dispatchEvent(ev);
			}
			
			private function processClickHandler():void
			{
				var ev:ELabGridFilterEvent = new ELabGridFilterEvent(ELabGridFilterEvent.PROCESS_CLICKED, true);
				dispatchEvent(ev);
			}
			
			private function showPreviousButtonClickHandler():void
			{
				if (pageNo > 1)
				{
					pageNo = pageNo - 1;
					
					var ev:ELabGridFilterEvent = new ELabGridFilterEvent(ELabGridFilterEvent.PAGE_REQUESTED, true);
					ev.pageNo = pageNo;
					
					dispatchEvent(ev);
				}
			}
			
			private function showNextButtonClickHandler():void
			{
				pageNo += 1;
				
				var ev:ELabGridFilterEvent = new ELabGridFilterEvent(ELabGridFilterEvent.PAGE_REQUESTED, true);
				ev.pageNo = pageNo;
				
				dispatchEvent(ev);
			}
			
			private function initializeFilterCriteria():ELabFilterCriteriaDTO
			{
				var filterCriteria:ELabFilterCriteriaDTO = new ELabFilterCriteriaDTO();
				filterCriteria.FieldID = 0;
				filterCriteria.SearchTerm = "";
				filterCriteria.PageNo = 1;
				filterCriteria.PatientID = 0;
				filterCriteria.FromDate = "";
				filterCriteria.ToDate = "";
				filterCriteria.LabTypeID = "0";
				filterCriteria.MethodTypeID = "0";
				
				return filterCriteria;
			}
			
			private function changeIcon(type:String):void
			{
				switch(type)
				{
					case 'All':
					case 'Order':
					case 'Patient':
					case 'Provider':
					case 'Test':
					{
						moreOptions.source = selected_name;
						break;
					}
					case 'Date':
					{
						moreOptions.source = selected_date;
						break;
					}
					case 'Lab':
					{
						moreOptions.source = selected_lab;
						break;
					}	
				}
			}
			
			private function enableSearchBox(enable:Boolean = true):void
			{
				id_Search.enabled = enable;
				id_SearchImage.enabled = enable;
			}
			
			[Embed(source="com/gazuntite/provider/live/services/elab/view/assets/selected_name.png")]
			[Bindable]	public var selected_name:Class;
			[Embed(source="com/gazuntite/provider/live/services/elab/view/assets/selected_date.png")]
			[Bindable]	public var selected_date:Class;
			[Embed(source="com/gazuntite/provider/live/services/elab/view/assets/selected_lab.png")]
			[Bindable]	public var selected_lab:Class;
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout verticalAlign="middle" gap="0"/>
	</s:layout>
	
	<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.button.eLab.ElabFilterViewSkin" width="100%">
		
		<s:layout>
			<s:HorizontalLayout  paddingLeft="3" paddingRight="3" paddingTop="3" paddingBottom="3"/>
		</s:layout>
		
		<s:HGroup width="100%" gap="4" verticalAlign="middle">
			
			<!--<s:HGroup width="100%" gap="4">-->
			<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.eLab.SearchBgSkin" height="25" >
				<s:HGroup gap="0" width="100%" verticalAlign="middle" height="100%">
					<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.eLab.greyButtonBg" width="35" height="100%" >
						<s:Image id="moreOptions" 
								 horizontalCenter="0"
								 verticalCenter="0"
								 click="moreOptionsClickHandler()" useHandCursor="true" buttonMode="true"
								 source="{selected_name}" />
					</s:SkinnableContainer>
					
					<components:LabelTextInput id="id_Search" 
											   height="100%" borderColor="#333333" borderVisible="false" borderAlpha="0" verticalCenter="0"
											   focusAlpha="0" width="150" fontSize="14"
											   prompt="Search" restrict="[A-Z a-z , . / \- 0-9]"
											   skinClass="com.gazuntite.controls.extended.skins.transparentTextInputSkin"
											   toolTip="Search" keyUp="searchKeyUpHandler(event)"/>
					<s:Image id="id_SearchImage"
							 buttonMode="true" useHandCursor="true" toolTip="Search" width="30" right="2" verticalCenter="0"
							 click="searchClickHandler()"
							 source="@Embed('com/gazuntite/provider/live/services/elab/view/assets/pe_search_selected.png')"/>
				</s:HGroup>
			</s:SkinnableContainer>
			<!--</s:HGroup>-->
			
			<s:Label id="noRecordFoundLbl" text="No E-Lab Found" height="25"
					 fontFamily="CalibriCFF" fontSize="12"
					 color="#FFFFFFF" textAlign="center" verticalAlign="middle" 
					 visible="false" includeInLayout="{noRecordFoundLbl.visible}"/>
			
			<s:Spacer width="100%"/>
			
			<s:Button id="id_Process" 
					  label="Process" width="65"
					  visible="{doShowProcessButton}" includeInLayout="{doShowProcessButton}" enabled="{recordsSelected}"
					  click="processClickHandler()" 
					  skinClass="com.gazuntite.skins.controls.button.eLab.ProcessBlackButton" 
					  toolTip="Process" useHandCursor="true" buttonMode="true"/>
			
			<s:Group>
				<s:layout>
					<s:VerticalLayout paddingTop="4" />
				</s:layout>
				<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.ePrescription.PagingBackgroundSkin">
					<s:layout>
						<s:HorizontalLayout gap="0" horizontalAlign="center" verticalAlign="middle" />
					</s:layout>
					
					<s:Button id="id_showPrev" toolTip="Previous" enabled="{(firstRecord > 1)? true : false}"
							  click="showPreviousButtonClickHandler()" useHandCursor="true" buttonMode="true"
							  skinClass="com.gazuntite.skins.controls.button.ePrescription.PreviousPageButton"/>
					<buttonSkins:buttonNavSeparator width="1" height="100%"/>
					<s:Label id="id_lblPageNo" text="0" fontFamily="CalibriCFF" color="#FFFFFF" fontSize="13" width="18" textAlign="center"/>
					<buttonSkins:buttonNavSeparator width="1" height="100%"/>
					<s:Button id="id_showNext" 
							  toolTip="Next" enabled="{totalRecords - lastRecord > 0 ? true : false}"
							  click="showNextButtonClickHandler()" useHandCursor="true" buttonMode="true"
							  skinClass="com.gazuntite.skins.controls.button.ePrescription.NextPageButton"/>
				</s:SkinnableContainer>
			</s:Group>
		</s:HGroup>
	</s:SkinnableContainer>
	<Filters:ELabSearchFilterView id="filterView" visible="false" includeInLayout="false"/>
	
</s:Group>
