<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx">
	
	<fx:Metadata>
		[Event(name="LoadClinicUserDetailsEvent", type="com.gazuntite.provider.search.services.provider.view.event.ListVieClickEvent")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.util.QSConstants;
			import com.gazuntite.provider.search.services.provider.model.SearchProviderModelLocator;
			import com.gazuntite.provider.search.services.provider.view.event.ListVieClickEvent;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			private var m_sSearchString:String
			private var m_oDataProvider:ArrayCollection;
			
			[Bindable]
			private var model : SearchProviderModelLocator = SearchProviderModelLocator.getInstance();
			
			
			[Bindable]
			public function get dataProvider():ArrayCollection
			{
				return m_oDataProvider;
			}

			public function set dataProvider(value:ArrayCollection):void
			{
				m_oDataProvider = value;
				
				callLater( function():void
				{
					if( null != value )
					{
						var ice:IndexChangeEvent = new IndexChangeEvent( IndexChangeEvent.CHANGE, true, false, -1, 0 );
						id_SearchList.dispatchEvent( ice );
					}
				});
			}

			public function get SearchString():String
			{
				return m_sSearchString;
			}
			
			public function set SearchString(value:String):void
			{
				m_sSearchString = value;
			}
			
			protected function id_SearchList_clickHandler(event:MouseEvent):void
			{
				if( event.target is spark.components.Button )
				{
					event.stopImmediatePropagation();
					return;
				}
				
				//List(event.currentTarget).selectedItem.data
				
				/* var userListClick:ListVieClickEvent  = new ListVieClickEvent(   model.LoggedInUserId,model.LoggedInUserSelectedBranchId);
				dispatchEvent( userListClick ); */
				
			}
			
			protected function id_SearchList_creationCompleteHandler(event:FlexEvent):void
			{
				//var clinicUserId:int= List(event.currentTarget).selectedItem.data.UserId;
				
			}
			
			
			
			
			protected function id_SearchList_changeHandler(event:IndexChangeEvent):void
			{
				// TODO Auto-generated method stub
				if(model.SearchProviderResults.providers.list.length > 0 && id_SearchList != null )
				{
					var clinicUserId:int= event.currentTarget.dataProvider[event.newIndex].UserId;
					
					var userListClick:ListVieClickEvent  = new ListVieClickEvent(clinicUserId,model.LoggedInUserSelectedBranchId,getProviderDetails ,CheckStatus(event.currentTarget.dataProvider[event.newIndex].userSessionStatusID),event.currentTarget.dataProvider[event.newIndex].ProviderCompleteName);
					dispatchEvent( userListClick );
				}
				
			}
			
			private function CheckStatus(statusID:int):Boolean
			{
				return (statusID == QSConstants.SESSION_STATUS_ONLINE || statusID == QSConstants.SESSION_STATUS_BUSY ||  statusID == QSConstants.SESSION_STATUS_AWAY)
			}
			
			
			private function getProviderDetails(val:* = null):void
			{
				
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		
	</fx:Declarations>
	<s:Group  height="100%" width="100%" >
		<s:List id="id_SearchList" 
				width="100%" height="100%" 
				dataProvider="{dataProvider}"
				change="id_SearchList_changeHandler(event)" 
				horizontalScrollPolicy="off"
				borderVisible="false" 
				selectedItem="{dataProvider.getItemAt(0)}"
				click="id_SearchList_clickHandler(event)"  
				skinClass="com.gazuntite.skins.controls.scrollbar.communication.ProviderListSkin"
				itemRenderer="com.gazuntite.provider.search.services.provider.view.search.ProviderSearchListItemRenderer"
				creationComplete="id_SearchList_creationCompleteHandler(event)"/>
	</s:Group>
	
</s:Group>
