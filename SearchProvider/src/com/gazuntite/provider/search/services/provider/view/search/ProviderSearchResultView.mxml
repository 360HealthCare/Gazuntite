	<fx:Metadata>
		[Event(name="LoadClinicUserDetailsEvent", type="com.gazuntite.provider.search.services.provider.view.event.ListVieClickEvent")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.provider.search.services.provider.dto.SearchProviderResultsList;
			import com.gazuntite.provider.search.services.provider.event.SearchProviderEvent;
			import com.gazuntite.provider.search.services.provider.model.SearchProviderModelLocator;
			import com.gazuntite.provider.search.services.provider.view.event.ListVieClickEvent;
			
			import mx.collections.Sort;
			import mx.events.FlexEvent;
			
			
			private var onLoad:Boolean=false;
			
			import spark.events.TextOperationEvent;
			[Bindable]
			private var model : SearchProviderModelLocator = SearchProviderModelLocator.getInstance();
			
			protected function id_providerSearchTextInput_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
			}

			protected function id_providerSearchTextInput_changeHandler(event:TextOperationEvent):void
			{
				/* if(id_providerSearchTextInput.text.length > 2)
				{
					var psEvent:SearchProviderEvent =new SearchProviderEvent(id_providerSearchTextInput.text,getProviderList);
					CairngormEventDispatcher.getInstance().dispatchEvent(psEvent);
					event.stopImmediatePropagation();
				} */
				//if(id_providerSearchTextInput.text.length > 0)
				filter();
			}
			
			
			private function filter():void {
				
				model.SearchProviderResults.providers.filterFunction = filterMyArrayCollection;
				model.SearchProviderResults.providers.refresh();
				
			/* 	var sortA:Sort = new Sort();
				var sortB:Sort = new Sort();
				var sortC:Sort = new Sort();
				
				sortA = new SortField("FirstName", true, false, false);
				sortB = new SortField("LastName",false,false,true);
				
				sortC.fields=[sortA, sortB];
				dgAryCol.sort=sortC;
				
				dgAryCol.refresh();
				*/
			} 
			
			private function filterMyArrayCollection(item:Object):Boolean {
				var searchString:String = id_providerSearchTextInput.text.toLowerCase();
				var itemName:String = (item.ProviderCompleteName as String).toLowerCase();
				return itemName.indexOf(searchString) > -1;
			}


			protected function id_btnSearch_clickHandler(event:MouseEvent):void
			{
				SearchProvider(event);
			}
			
			
			protected function SearchProvider (event:Event):void 
			{
				var psEvent:SearchProviderEvent =new SearchProviderEvent(id_providerSearchTextInput.text,getProviderList);
				CairngormEventDispatcher.getInstance().dispatchEvent(psEvent);
				 event.stopImmediatePropagation(); 
			}
			
			private function getProviderList(val:* = null):void
			{
				/* if(model.SearchProviderResults.providers.length > 0)
				{
				var psEvent:GetClinicUserIDEvent =new GetClinicUserIDEvent(model.loggedInUserDTO.UserId,model.basicUserDTO.ClinicBranhId,getProviderList);
				CairngormEventDispatcher.getInstance().dispatchEvent(psEvent);
				event.stopImmediatePropagation();
				} */
				if(onLoad == false)
				{
					onLoad=true;
					var userListClick:ListVieClickEvent  = new ListVieClickEvent(model.LoggedInUserId,model.LoggedInUserSelectedBranchId,getProviderDetails,false,'');
					dispatchEvent( userListClick );
				}
				
			}


			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				var psEvent:SearchProviderEvent =new SearchProviderEvent(id_providerSearchTextInput.text,getProviderList);
				CairngormEventDispatcher.getInstance().dispatchEvent(psEvent);
				event.stopImmediatePropagation();
				
				//id_providerSearchTextInput.setFocus();
			}
			
			private function getProviderDetails(val:* = null):void
			{
				
			}


			protected function id_providerSearchTextInput_keyDownHandler(event:KeyboardEvent):void
			{
			  if(event.keyCode == Keyboard.ENTER)
			  {
				  SearchProvider(event);
			  }
			}

		]]>
	</fx:Script>

	<fx:Declarations>
		
	</fx:Declarations>
	
	<s:layout>
		<s:HorizontalLayout verticalAlign="middle" gap="1" />
	</s:layout>

		<components:LabelTextInput id="id_providerSearchTextInput"  prompt="Clinical User Search" 
								   width="100%" skinClass="com.gazuntite.skins.controls.textInput.SearchBoxTextInputSkin" 
								   keyDown="id_providerSearchTextInput_keyDownHandler(event)"
								   toolTip="Clinical User Search" change="id_providerSearchTextInput_changeHandler(event)"
					 />
		<s:Button id="id_btnSearch" label="Search" click="id_btnSearch_clickHandler(event)"  toolTip="Search User" buttonMode="true" 
				  height="20"  width="23"   useHandCursor="true" skinClass="com.gazuntite.skins.controls.button.orangeSearchButton" visible="false" includeInLayout="false"/>

	
</s:Group>
