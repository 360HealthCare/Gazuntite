<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="false"
				height="38" width="168"
				>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.util.QSConstants;
			import com.gazuntite.common.view.events.StartChatWithProviderEvent;
			
			import mx.utils.StringUtil;
			
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				if(event.currentTarget.id == 'id_OnlineBtn')
				{
					var startChatEvent:StartChatWithProviderEvent = new StartChatWithProviderEvent(StartChatWithProviderEvent.SEND_CALL,true);
					
					startChatEvent.providerID = data.UserId;
					startChatEvent.providerName = data.ProviderCompleteName;
					startChatEvent.SessionStatusID = data.userSessionStatusID;
					
					dispatchEvent(startChatEvent);
					
					trace('Online Click');
				}
				else if(event.currentTarget.id == 'id_BusyBtn')
				{
					dispatchEvent(new Event("UserUnavaliable_for_call",true));
					trace('Busy Click');
				}
				else if(event.currentTarget.id == 'id_AwayBtn')
				{
					dispatchEvent(new Event("UserUnavaliable_for_call",true));
					trace('Away Click');
				}
			}
			// set the Alternate color in each alternate row
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			private function onMouseOver():void
			{
				id_Header.setStyle('backgroundColor', 0xFFD08F);
			}
			private function onMouseOut():void
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
			}
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="hovered" />
		<s:State name="selected" />
	</s:states>
		
	<s:BorderContainer id="id_Header" 
					   width="100%" height="100%" 
					   useHandCursor="true" buttonMode="true"  borderVisible="false" 
					   skinClass.selected="com.gazuntite.skins.controls.container.Communication.SelectedProviderSkin"
					   mouseOver="onMouseOver()" mouseOut="onMouseOut()">
		<!--<s:layout>
			<s:VerticalLayout gap="0" verticalAlign="middle" horizontalAlign="left"/>
		</s:layout>-->
		
		<s:Group width="140" height="100%" left="23">
			<s:RichText color="#333333" 
					 color.selected="0xFFFFFF" 
					 fontFamily.selected="CalibriCFFBold" 
					 typographicCase.selected="uppercase"  
					 text="{data.ProviderCompleteName}"  
					 fontFamily="CalibriCFF"
					 fontSize="14"  
					 maxDisplayedLines="1"  
					 textAlign="left" 
					 width="100%" top="5"
					 whiteSpaceCollapse="preserve"
					 tabStops="S0 S50 S100" 
					 />
			
			<!--<s:Label color="#333333"
					 color.selected="0xFFFFFF"  
					 text="{ data.UserEmail }"  
					 textAlign="left"
					 fontFamily="CalibriCFF" 
					 fontSize="11"  
					 maxDisplayedLines="1"  
					 width="100%" top="20"
					  />-->
			<s:RichText
				color="#333333"
				color.selected="0xFFFFFF"  
				text="{ data.UserEmail }"  
				textAlign="left"
				fontFamily="CalibriCFF" 
				fontSize="11"  
				maxDisplayedLines="1"  
				width="100%" top="23" 
				whiteSpaceCollapse="preserve"
				tabStops="S0 S50 S100"
				/>
		</s:Group>
		
		<s:Group  height="100%"	left="3" >
			<s:Button  id="id_OnlineBtn" 
					   toolTip="Video Call" verticalCenter="0" horizontalCenter="0"
					   skinClass="com.gazuntite.skins.controls.button.VideoButtonOnlineSkin" 
					   click="button1_clickHandler(event)" includeInLayout="{data.userSessionStatusID == QSConstants.SESSION_STATUS_ONLINE}" 
					   visible="{id_OnlineBtn.includeInLayout}"/>
			<s:Button  id="id_BusyBtn"
					   toolTip="Busy" verticalCenter="0" horizontalCenter="0"
					   skinClass="com.gazuntite.skins.controls.button.VideoButtonBusySkin" 
					   click="button1_clickHandler(event)" includeInLayout="{data.userSessionStatusID == QSConstants.SESSION_STATUS_BUSY}" 
					   visible="{id_BusyBtn.includeInLayout}"/>
			<s:Button id="id_AwayBtn" visible="{id_AwayBtn.includeInLayout}" 
					  click="button1_clickHandler(event)"
					  includeInLayout="{data.userSessionStatusID == QSConstants.SESSION_STATUS_AWAY}"
					  skinClass="com.gazuntite.skins.controls.button.VideoButtonAwaySkin"
					  toolTip="Away" verticalCenter="0" horizontalCenter="0"/>
		</s:Group>
		
	</s:BorderContainer>
	
</s:ItemRenderer>
