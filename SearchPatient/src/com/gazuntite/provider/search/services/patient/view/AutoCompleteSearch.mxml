<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:autoComplete="com.gazuntite.components.kapit.autoComplete.*"
		 width="100%" height="100%"
		 >
	
	<fx:Metadata>
		[Event(name="PatientSelected", type="com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.provider.search.services.patient.event.SearchPatientbyClinicIdEvent;
			import com.gazuntite.provider.search.services.patient.model.SearchPatientModelLocator;
			import com.gazuntite.provider.search.services.patient.util.sql.LocalPatientsDB;
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			
			import mx.collections.ArrayList;
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			import spark.events.TextOperationEvent;
			
			[Bindable]	private var model : SearchPatientModelLocator = SearchPatientModelLocator.getInstance();
			[Bindable]
			[Embed(source="com/gazuntite/provider/search/services/patient/view/skins/assets/pe_search_selected.png")]
			private static var icon_tick_circle:Class;
			
			
			private var list:ArrayList;
			private var _patientLoaded:Boolean = false;
			private var searchCase:uint 	= LocalPatientsDB.FREE_SEARCH;
			
			
			
			[Bindable]
			public function get patientLoaded():Boolean
			{
				return _patientLoaded;
			}
			
			public function set patientLoaded(value:Boolean):void
			{
				_patientLoaded = value;
			}
			
			protected function onkeyUpHandler(event:KeyboardEvent):void
			{
				//if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8) //including only alphabets, digits, special characters, del n backspace
				if (event.keyCode == Keyboard.ENTER && !id_patientSearch.selectedItem ) //only ENTER KEY 
				{
					var searchString:String = id_patientSearch.text;
					if(searchString.length > 2)
					{
						sendToServer( searchString, 1, showSuggestPopup );
					} 
				}				
			}
			
			private function searchPatientAndDisplay():void
			{
				var isTimerAdded:Boolean;
				
				var tok:Array;
				var dispatchSearchEvent:Boolean = false;
				var searchString:String = id_patientSearch.text;
				var num:Number = new Number( id_patientSearch.text.substr( 0, 2 ) );// as Number;
				
				if( ! isNaN( num ) )
				{
					if( searchString.charAt(2) == '-' )//	its a DOB,			date format MM-DD-YY
					{
						//trace( "length",searchString.length );
						if(searchString.length >= 8)
						{
							dispatchSearchEvent = true;
							searchCase = LocalPatientsDB.DOB;
						}
						else
							return;
					}
					else if( searchString.charAt(2) == '/' )//   its a DOB,       date format MM/DD/YYYY
					{
						//trace( "length",searchString.length );
						if(searchString.length >= 8)
						{
							dispatchSearchEvent = true;
							searchCase = LocalPatientsDB.DOB;
						}
						else
							return;
					}
					else if( searchString.charAt(3) == '-' ) // its ssn with hyphen format XXX-XX-XXXX
					{
						//trace( "length",searchString.length );
						if( searchString.length == 11 )
						{
							dispatchSearchEvent = true;
							searchCase = LocalPatientsDB.SSN;
						}
						else
							return;
					}
					else if(searchString.length >= 6 && searchString.length <= 10)// its a i) date MMDDYY or MMDDYYYY  or ii) ssn without hyphen format XXXXXXXXX
					{
						dispatchSearchEvent = true;
						searchCase = LocalPatientsDB.DOB;
					}
					else
						return;
				}
				if( searchString.indexOf( ',' ) != -1 ) // its a Name 			format  Last, First
				{
					tok = searchString.split( ',' );
					if( tok.length == 2 && ( tok[0].length >= 2 || tok[1].length >= 2 ) )
					{
						dispatchSearchEvent = true;
						searchCase = LocalPatientsDB.LAST_FIRST_NAME;
					}
					else
						return;
				}
				else if( searchString.indexOf( ' ' ) != -1 ) // its a Name 			format  First <SPACE> Last OR First <SPACE> Middle <SPACE> Last
				{
					tok = searchString.split( ' ' );
					if( tok.length == 2 ||//&& ( tok[0].length >= 2 || tok[1].length == 1  || tok[1].length == 3) ||
						tok.length == 3 )//&& ( tok[0].length >= 2 || tok[2].length == 1  || tok[2].length == 3) )
					{
						dispatchSearchEvent = true;
						searchCase = LocalPatientsDB.FIRST_MIDDLE_LAST_NAME;
					}
					else
						return;
				}
				else if( searchString.charAt(0).toLowerCase() == 'q')// its a QID,
				{
					if( searchString.length == 2 )
						return;
					if ( searchString.length >= 3 && searchString.charAt( 2 ) == '-' )
					{
						for( var i:int = 3; i < searchString.length ; i++ )
						{
							num = new Number ( searchString.charAt( i ) );
							if( num > 0 )
							{
								dispatchSearchEvent = true;
								searchCase = LocalPatientsDB.FIRST_MIDDLE_LAST_NAME;
							}
						}
					}
				}
				if( searchString.length == 3 ||  searchString.length == 5)
				{
					dispatchSearchEvent = true;
				}
			}
			// ------------- call back method and show list of records -------------------------------
			private function showSuggestPopup(val:* = null):void
			{
				id_patientSearch.selectedItem = null;
				id_patientSearch.open();
			}
			
			private function dispatachPatientSelection():void
			{
				if( null != id_patientSearch.selectedItem )
				{
					var ps:PatientSelectedEvent = new PatientSelectedEvent(PatientSelectedEvent.PATIENT_SELECTED);
					ps.selection = id_patientSearch.selectedItem;
					dispatchEvent( ps );
		
					model.SearchPatientResults.Patients.removeAll();
					id_patientSearch.clear();
				}
				
			}
			//---- on results item item click handler ----------------------------
			private function OnItemClick(event:Event):void
			{
				try
				{
					if( event.currentTarget.selectedItem)
					{
						dispatachPatientSelection();
					}
					removeFocus();
					id_patientSearch.text = '';   // clear the search text input on PATITNT SELECTION
				}
				catch(e:Error)
				{
					//trace("ERROR --> PatientExamPanelHeader::OnItemClick", e );
				}
			}
			
			// ----- Call send to server for getting results ---------------------------------------
			private function sendToServer( searchString:String, pageNo:int, callBack:Function ):void
			{
				while( searchString.indexOf( "/" ) != -1 )
				{
					searchString = searchString.replace( "/", "-" ); //for REST url
				}
				
				var pseEvent : SearchPatientbyClinicIdEvent 	= new SearchPatientbyClinicIdEvent( searchString, pageNo,1, callBack);
				CairngormEventDispatcher.getInstance().dispatchEvent( pseEvent );
			}
			
			// --------- label function for getting patient's data -----------------
			private function getPatientInformation(item:Object):String
			{
				var patientInfo:String = '';
				if(item)
				{
					patientInfo = "Name: "+ item.FirstName +' '+ item.MiddleName +' '+ item.LastName + '   DOB: '+ formatDateTime.format(item.DOB);// + ' SSN: ' + item.SSN;
				}
				
				return patientInfo;
			}
			// --------- on ENTER KEY PRESS --------------------------------------
			protected function id_patientSearch_enterHandler(event:FlexEvent):void
			{
				var searchString:String = id_patientSearch.text;
				if(searchString.length > 2)
				{
					sendToServer( searchString, 1, showSuggestPopup );
				} 
			}	
			//-------------- remove focus color --------------------------------------
			/**
			 * Remove the blue focus from Search Control.
			 * Whenever focus is shifted from AutoComplete Search to another control.
			 * */
			public function removeFocus():void
			{
				id_patientSearch.setStyle('focusAlpha', 0);
			}
			/**
			 * Set the blue focus for Search Control.
			 * Whenever focus is shifted from another control to AutoComplete control.
			 * */
			public function setTheFocus():void
			{
				id_patientSearch.setStyle('focusAlpha', 1);
				//id_patientSearch.setStyle('focusColor', 0x007FFF);
			}
			// ------------ on click search Component -------------------------------- 
			protected function id_SearchPatientView_clickHandler(event:MouseEvent):void
			{
				setTheFocus();
			}
			
			protected function id_patientSearch_keyUpHandler(event:KeyboardEvent):void
			{
				if (event.keyCode == Keyboard.BACKSPACE && model.SearchPatientResults && model.SearchPatientResults.Patients)
				{
					var temp:String = id_patientSearch.text;
					model.SearchPatientResults.Patients.removeAll();
					id_patientSearch.clear();
					id_patientSearch.text = temp;
				}
				else if(event.keyCode == Keyboard.ENTER && null != id_patientSearch.selectedItem)
				{
					dispatachPatientSelection();
				}
			}
			//  On text change : limitt min = 2 cahr
			protected function id_patientSearch_changeHandler(event:TextOperationEvent):void
			{
				var searchString:String = id_patientSearch.text;
				if(searchString.length > 2)
				{
					sendToServer( searchString, 1, showSuggestPopup );
				} 
			}
			
			protected function id_patientSearch_clickHandler(event:MouseEvent):void
			{
				trace("TEST", event);
			}
			
			protected function id_patientSearch_closeHandler(event:DropDownEvent):void
			{
				dispatachPatientSelection();
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	
	<autoComplete:AutoComplete id="id_patientSearch"
							   width="100%" height="24"
							   searchMode="async"
							   dataProvider="{model.SearchPatientResults.Patients}"  icon="{icon_tick_circle}"
							   toolTip="Patient Search" prompt="Patient Search (First Name, Last Name, DOB, SSN, GID)"
							   labelFunction="getPatientInformation"
							   enter="id_patientSearch_enterHandler(event)"
							   change="id_patientSearch_changeHandler(event)"
							   keyUp="id_patientSearch_keyUpHandler(event)"
							   click="id_patientSearch_clickHandler(event)"
							   labelField="label" focusColor="0x007FFF"
							   close="id_patientSearch_closeHandler(event)"
							   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin" 
							   />
</s:Group>
