			private function LoadAllProviders():void
			{
				model.AllProviders = new ProviderList();
				model.AllProviders.FromXML( ProviderList.providersXML );
				logger.info( "All Providers Loaded." );
			}
			
			
			/**
			 * Application logs activity to a file in HTML file. Press <b> Ctrl + L</b> to see log in default browser. 
			 * The Log file is stored in following lcation on the file system as per OS:
			 * <br>
			 * <b>On Windows(2000, XP etc.)--In:</b><br>
			 * 	/Documents and Settings/{user_name}/Application Data/applicationID.publisherID/Local Store/log/<br>
			 * 
			 * <b>On Windows 7--In:</b><br> 	
			 * 	/Users/{user_name}/AppData/Roaming/Quivus/Local Store/log/GazuntiteClient/log/<br>
			 * 
			 * <b>On Mac OS--In:</b><br>
			 *	/Users/{user_name}/Library/Preferences/applicationID.publisherID/Local Store/log/<br>
			 * 
			 * <P>Press <b> Ctrl + L</b> to see log in default browser </P>
			 * 
			 */
			private function initLogging():void
			{
				initTraceLogging();
				initFileLogging();
				
				logger.info( "Logging initialization completed." );
			}
			
			private function initFileLogging():void 
			{
				
				var LogTarget:FileTarget 		= new FileTarget(); //new TextAreaTarget( out );
				
				var filters:String				= XmlUtils.getPropertyValueByName( 'FILTERS', model.SettingConfigXML );
				var level:String 				= XmlUtils.getPropertyValueByName( 'LOG_LEVEL', model.SettingConfigXML );

				if( UtilityFunctions.IsNotNullOrEmpty( filters ) && UtilityFunctions.IsNotNullOrEmpty( level ) )
				{
					LogTarget.filters 			= [filters];
					LogTarget.level 			= LoggingUtil.getLogLevel( level ); //LogEventLevel.ALL;
				}
				else
				{
					LogTarget.level 			= LogEventLevel.ALL;
				}
				
				// Add date, time, category, and log level to the output
				LogTarget.includeDate 		= true;
				LogTarget.includeTime 		= true;
				LogTarget.includeCategory 	= true;
				LogTarget.includeLevel 		= true;
				
				Log.addTarget(LogTarget);		// Begin logging.
			}
			
			private function initTraceLogging():void 
			{
				// Create a target.
				var logTarget:TraceTarget = new TraceTarget();
				
				var filters:String				= XmlUtils.getPropertyValueByName( 'FILTERS', model.SettingConfigXML );
				var level:String 				= XmlUtils.getPropertyValueByName( 'LOG_LEVEL', model.SettingConfigXML );
				
				if( UtilityFunctions.IsNotNullOrEmpty( filters ) && UtilityFunctions.IsNotNullOrEmpty( level ) )
				{
					logTarget.filters 			= [filters];
					logTarget.level 			= LoggingUtil.getLogLevel( level ); //LogEventLevel.ALL;
				}
				else
				{
					logTarget.level 			= LogEventLevel.ALL;
				}
				
				// Add date, time, category, and log level to the output.
				logTarget.includeDate 		= true;
				logTarget.includeTime 		= true;
				logTarget.includeCategory 	= true;
				logTarget.includeLevel 		= true;
				logTarget.includeCategory 	= true;
				
				Log.addTarget(logTarget);		// Begin logging.
				
				
			}
			
			
			protected function id_LoginView_loginHandler(event:LoginViewEvent):void
			{
				mainContainer.selectedIndex = event.success ? 1 : 0;
				
				if(event.success)
				{
					var eve:GetPatientGaxenIdEvent = new GetPatientGaxenIdEvent(model.LoggedInUserDTO.UserId.toString(), onGetPatientGaxenId, true);
					CairngormEventDispatcher.getInstance().dispatchEvent(eve);
				}
				
				var sessiontypeEvent:LoadUserSessionTypeEvent = new LoadUserSessionTypeEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(sessiontypeEvent);
			}
			
				private function onGetPatientGaxenId(result:XML):void
				{
					var gaxenID:String = result[0];
					
					if (!gaxenID || gaxenID == "0")
					{
						return;
					}
					
					model.LoggedInuserGaxenID = gaxenID;
					
				}
			
			protected function windowedapplication1_closingHandler(event:Event):void
			{
				VideoChatManager.getInstance().logoff();
				Logout(new LogoutViewEvent(false));
				logger.debug( " application closing - logoff video chat " );
			}
			
			public function Logout(event:LogoutViewEvent):void
			{
				doApplicatiopClosed = event.doApplicatiopClosed;
				
				if(viewModel.selectedPatient != null)
				{
					logger.debug( " application closing - requesting close patient " );
					id_MainContainer.id_examBar.whenPatientCloseRequested(null, requestServiceLogout);
				}
				else
				{
					requestServiceLogout();
				}
				
			}
			
			private var doApplicatiopClosed:Boolean;
			private function requestServiceLogout():void
			{
				var logoutevent:LogoutEvent = new LogoutEvent(serviceLogoutCallback);
				logger.debug( " application closing - requesting service logout " );
				CairngormEventDispatcher.getInstance().dispatchEvent(logoutevent);
				
				opentokManager.isAvailable = true;
				opentokManager.VideoChat_URL = '';
			}
			
			private function serviceLogoutCallback():void
			{
				logger.debug( " application closing - service logout successfully " );
				mainContainer.selectedIndex = 0;
				if(doApplicatiopClosed)
					ChromeUtil.closeWindow();
				
				model.ResetModel();
				logger.debug( " application closed - successfully " );
			}
			
			protected function id_MainContainer_creationCompleteHandler(event:FlexEvent):void
			{
				addEventListener(LogoutViewEvent.LOG_OUT,Logout);
			}
			
			protected function id_RegiterProvider_RegisterProviderHandler(event:RegisterProviderViewEvent):void
			{
				mainContainer.selectedIndex =  0;
				
				if(event.success)
				{
					id_LoginView.userNameTxt.text = event.registeredProviderId;
					id_LoginView.passwordTxt.text = "";
				}
			}
			
			protected function id_LoginView_creationCompleteHandler(event:FlexEvent):void
			{
				id_LoginView.id_registerProvider.addEventListener(MouseEvent.CLICK,viewRegistrProviderForm);
			}
			private function viewRegistrProviderForm(event:MouseEvent):void
			{
				if( !SpecialityList || SpecialityList.length == 0)
				{
					getSpecialityList();
				}
				if( !UserTypeList || UserTypeList.length == 0)
				{
					//cursorManager.setBusyCursor();
					loadUserTypes();
				}
				else
				{ 
					if(id_RegiterProvider && id_RegiterProvider.id_role)
						id_RegiterProvider.resetFileds();
					mainContainer.selectedIndex =  2;
				}
			}
			
			//[08/06/2013] Shahid Munir, for provider registration
			
			private var _SpecialityList:ArrayCollection;
			private var _UserTypeList:ArrayCollection;

			[Bindable]
			public function get UserTypeList():ArrayCollection
			{
				return _UserTypeList;
			}

			public function set UserTypeList(value:ArrayCollection):void
			{
				_UserTypeList = value;
			}


			[Bindable]
			public function get SpecialityList():ArrayCollection
			{
				return _SpecialityList;
			}

			public function set SpecialityList(value:ArrayCollection):void
			{
				_SpecialityList = value;
			}

			private function loadUserTypes():void
			{
				var ute:LoadAllUserTypeEvent = new LoadAllUserTypeEvent(loadUserTypesResponse);
				CairngormEventDispatcher.getInstance().dispatchEvent(ute);
			}
			
			private function loadUserTypesResponse(userTypeXML:XML):void
			{
				UserTypeList = new ArrayCollection();
				
				var xUserTypes:XMLList = userTypeXML.users;
				var i:int = 0;					
				for( i = 0; i < xUserTypes.length(); i++ )
				{
					var dto:UserTypeDTO = new UserTypeDTO();
					dto.FromXML( xUserTypes[i][0] );
					UserTypeList.addItem( dto );
				}	
				
				if(id_RegiterProvider && id_RegiterProvider.id_role)
					id_RegiterProvider.resetFileds();
				//cursorManager.removeBusyCursor();
				mainContainer.selectedIndex =  2;
			}
			
			private function getSpecialityList():void
			{
				
				var securityHeaderXML:XML	 			= <Header />;					
				securityHeaderXML.@EUserName	= "null";
				securityHeaderXML.@EPassword	= "null";
				securityHeaderXML.@ClinicID		= "sad";
				
				var spe:GetSpecialityEvent = new GetSpecialityEvent(getSpecialityListResponse,true);
				spe.data = securityHeaderXML;
				CairngormEventDispatcher.getInstance().dispatchEvent(spe);
			}
			
			private function getSpecialityListResponse(specialityXML:XML):void
			{
				SpecialityList = new ArrayCollection();
				
				var xSpecialityList:XMLList = specialityXML.SpecialityList.SpecialityCodes;
				var i:int = 0;					
				for( i = 0; i < xSpecialityList.length(); i++ )
				{
					var dto:SpecialityCodeDTO = new SpecialityCodeDTO();
					dto.FromXML( xSpecialityList[i][0]);
					SpecialityList.addItem( dto );
				}	
			}
			
