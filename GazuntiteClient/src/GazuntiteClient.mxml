			protected function init(event:FlexEvent):void
			{
				ToolTipManager.toolTipClass = HTMLToolTip;
				
				ChromeUtil.topLevelWindow 			= nativeWindow;
				ChromeUtil.topLevelMainContainer 	= id_MainContainer;
				ChromeUtil.topLevelApplication 		= this;
				
				this.x = 0;
				this.y = 0;
				if((Capabilities.os.indexOf("Windows") >= 0))
				{
					ChromeUtil.topLevelWindowXpos = this.x;
					ChromeUtil.topLevelWindowYpos = this.y;
				}
				else if((Capabilities.os.indexOf("Mac") >= 0))
				{
					//this.y = 25;
					ChromeUtil.topLevelWindowXpos = this.x;
					ChromeUtil.topLevelWindowYpos = this.y;
				} 
				else 
				{
					ChromeUtil.topLevelWindowXpos = this.x;
					ChromeUtil.topLevelWindowYpos = this.y;
				}
				
				this.width 			 = Capabilities.screenResolutionX; //screen.width;
				this.height 		 = Capabilities.screenResolutionY - 45; //screen.height - 30;
				
				
				LoadApplicationConfig();
			}
			
			
			
			protected function LoadApplicationConfig():void
			{
				this.configurationFile = new File("app:/config/AppConfigurations.xml");
				
				if( configurationFile && configurationFile.exists )
				{
					var stream:FileStream = new FileStream();
					stream.open( configurationFile, FileMode.READ);
					
					var prefsXML:XML 						= XML(stream.readUTFBytes(stream.bytesAvailable));
					
					stream.close();
					stream = null;
					this.configurationFile = null;
					
					var settings_config:XML 				= prefsXML.settings[0];
					model.SettingConfigXML 					= settings_config;
					
					initLogging();
					
					if( Log.isDebug() )
						logger.debug( "SettingConfigXML: " + model.SettingConfigXML );		
					
					var service_config:XML 					= prefsXML.service.(@type == prefsXML.@type)[0];
					model.ServiceConfigXML 					= service_config;
					
					UpdateConfigurations(service_config);
					
				}
				
				var appXml:XML 		= NativeApplication.nativeApplication.applicationDescriptor;
				var ns:Namespace 	= appXml.namespace();
				var appId:String 	= appXml.ns::id[0];
				var appName:String 	= appXml.ns::filename[0];
				
				var appVersion:String = appXml.ns::versionNumber[0];
				model.AppVersion = "V " + appVersion;

				logger.info( "Application ID is " + appId + ", having Name " + appName + " and Version is " + appVersion );
				
			}
			
			private function UpdateConfigurations(service_config:XML):void
			{
				QIController.getInstance().ConfigXML 					= service_config ;
				EPrescriptionModelLocator.getInstance().ConfigXML 		= service_config;
				BillingModelLocator.getInstance().ConfigXML				= service_config;
				EmailModelLocator.getInstance().ConfigXML 				= service_config;
				SMSModelLocator.getInstance().ConfigXML 				= service_config;
				ELabsAppModelLocator.getInstance().ConfigXML 			= service_config;
				WebRTCModel.getInstance().ConfigXML 					= service_config;
				SchedulerModelLocator.getInstance().ConfigXML 			= service_config;
				SearchPatientModelLocator.getInstance().ConfigXML 		= service_config;
				SearchProviderModelLocator.getInstance().ConfigXML 		= service_config;
				QSCommonModelLocater.getInstance().ConfigXML 			= service_config;
				DictationModelLocator.getInstance().ConfigXML 			= service_config;
				
			}
				
			protected function cc(event:FlexEvent):void
			{
				GazuntiteClientController.getInstance();
