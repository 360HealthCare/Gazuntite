			private function InitComponents():void
			{
				//Alert.show('InitComponents Called from MainContainer', 'test alert' );
				opentokchat.Init();
				opentokchat.addEventListener('incommingCall',OnIncomingCall);
			} 
			private var callTimer:Timer; 
			private var myAlert:Alert; 
			
			private function OnIncomingCall(event:IncomingCallViewEvent):void
			{
				var oldWidth:Number 	= Alert.buttonWidth;
				var oldYesLabel:String	= Alert.yesLabel;
				var oldNoLabel:String	= Alert.noLabel;
				Alert.yesLabel 			= "Accept Call";
				Alert.noLabel 			= "Reject Call";
				Alert.buttonWidth 		= 150;
				
				
				
				myAlert = Alert.show("Incoming Video Call from "+ event.callerName , "Call Alert!", Alert.YES|Alert.NO, this, 
					function( event:CloseEvent):void
					{
						
						if( event.detail == Alert.YES )//Alert.yesLabel="Accept Call";
						{
							if(id_patientMainContainer)//clear popups of Inputs
								id_patientMainContainer.id_patientInputMain.removeInputOptionsPopup();
							setExamBarDeafults();     // clear popups of exambar
							if(mainViewModel.showPriacticeManagerView)
								mainViewModel.showPriacticeManagerView = false;
							opentokchat.AcceptCall();
							uiPracticeManagerBar.setAllDefaults(); // de select all button into default state
							onHookVideoUI();
							
						}
							
						else if( event.detail == Alert.NO )//Alert.noLabel="Reject Call";
						{
							opentokchat.RejectCall();
						}
						
						//restore old AlertBox setting
						Alert.buttonWidth = oldWidth;
						Alert.yesLabel = oldYesLabel;
						Alert.noLabel = oldNoLabel;
					});
				
				callTimer = new Timer(50000, 1);
				callTimer.reset();
				callTimer.start();
				callTimer.addEventListener(TimerEvent.TIMER_COMPLETE, removeCallAlert); 
				
				Alert.buttonWidth = oldWidth;
				Alert.yesLabel = oldYesLabel;
				Alert.noLabel = oldNoLabel;
			}
			
			private function removeCallAlert(event:TimerEvent):void
			{
				callTimer.stop();
				callTimer = null;
				PopUpManager.removePopUp(myAlert);
			}
			
			private function addViewFromTop(type:Class):void
			{
				var toggleView:Boolean = currentOpenView_fromTop is type; // same button click is a toggle effect
				removeOpenedfromTop(); 
				
				if( toggleView )
					return;
				
				currentOpenView_fromTop 				= new type();
				currentOpenView_fromTop.percentWidth  	= 100;
				currentOpenView_fromTop.percentHeight	= 100;
				
				currentOpenView_fromTop.y	= -1;
				
				currentOpenView_fromTop.addEventListener("close", function():void{removeOpenedfromTop()});
				mainViewModel.addEventListener(MainContainerViewModel.EVENT_CLOSE_TOPBAR, function():void{removeOpenedfromTop()});
				
				id_TopContentArea.addElement( currentOpenView_fromTop );
				
				//				id_TopbarContainer.percentHeight = 92;
				id_TopContentArea.visible = true;
				mainViewModel.topbarExpended = true
				
			}
			
			private function removeOpenedfromTop(event:* = null):void
			{
				if( UtilityFunctions.IsNotNullOrEmpty( currentOpenView_fromTop ) )
				{
					if( id_TopContentArea.contains( currentOpenView_fromTop as DisplayObject ) )
					{
						removeAllConnection();
						id_TopContentArea.removeElement( currentOpenView_fromTop );
						currentOpenView_fromTop 	= null;
						id_TopContentArea.visible 	= false;
						mainViewModel.topbarExpended = false;
						
					}
				}
			}
			
			private function removeAllConnection():void
			{
				//WebsiteView
				if (id_topbarview.id_LogoButton.selected && currentOpenView_fromTop is WebsiteView) 
				{
					id_topbarview.id_LogoButton.selected = false;
				}
				
				//RapidAccessView
				if (id_topbarview.id_RapidAccess.selected && currentOpenView_fromTop is RapidAccessView) 
				{
					id_topbarview.id_RapidAccess.selected = false;
				}
				
				//CommunicationView
				if (id_topbarview.id_Communication.selected && currentOpenView_fromTop is CommunicationView) 
				{
					id_topbarview.id_Communication.selected = false;
				}
				
				//WebsearchView
				if (id_topbarview.id_WebSearch.selected && currentOpenView_fromTop is WebsearchView) 
				{
					id_topbarview.id_WebSearch.selected = false;
				}
				
				//EditProviderProfile
			//	if (id_topbarview.id_ProfileBtn.selected && currentOpenView_fromTop is EditProviderProfile) 
			//	{
			//		id_topbarview.id_ProfileBtn.selected = false;
			//	}
				
				setExamBarDeafults();
				
			}
			
