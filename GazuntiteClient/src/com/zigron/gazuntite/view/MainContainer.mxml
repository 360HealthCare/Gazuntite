			protected function onMainContainerClick(event:MouseEvent):void
			{
				var inside_practice_container:Boolean = uiPracticeManagerContainer.hitTestPoint(event.stageX, event.stageY, false);
				var inside_practice_bar:Boolean = uiPracticeManagerBar.hitTestPoint(event.stageX, event.stageY, false);
				if (mainViewModel.showPriacticeManagerView 
					&& !inside_practice_container
					&& !inside_practice_bar)
				{
					mainViewModel.showPriacticeManagerView = false;
					
					uiPracticeManagerBar.onclosePriacticeManagerView();
					event.stopImmediatePropagation();
				}
			}
			
			protected function PracticeManagerClickEventHandler(event:PracticeManagerClickEvent):void
			{
				setExamBarDeafults();
				
				uiPracticeManagerContainer.id_header.id_selectedView.text = event.selected_Section;
				uiPracticeManagerContainer.id_header.id_selectedView.toolTip = event.selected_Section;
				
				switch(event.selected_Section)
				{
					case Constants.SCHEDULAR_SECTION:
						uiPracticeManagerContainer.id_Views.selectedIndex = 0;
						break;
					case Constants.EPRESCRIPTION_SECTION:
						uiPracticeManagerContainer.id_Views.selectedIndex = 1;
						break;
					case Constants.ELAB_SECTION:
						uiPracticeManagerContainer.id_Views.selectedIndex = 2;
						break;
					case Constants.DMG_SECTION:
						uiPracticeManagerContainer.id_Views.selectedIndex = 3;
						break;
					case Constants.BILLING_SECTION:
						uiPracticeManagerContainer.id_Views.selectedIndex = 4;
						break;
					case Constants.DISEASE_MANAGEMENT:
						uiPracticeManagerContainer.id_Views.selectedIndex = 5;
						break;
				}
			}
			
			protected function practiceManagerContainer_clickHandler(event:MouseEvent):void
