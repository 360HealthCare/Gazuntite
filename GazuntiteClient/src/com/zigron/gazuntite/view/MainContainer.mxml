			private function onHookVideoUI(event:Event = null):void
			{
				id_topbarview.id_Communication.selected = true;
				var commView:CommunicationView = currentOpenView_fromTop as CommunicationView;
				if(null == commView )
				{
					addViewFromTop( CommunicationView );
					var commViewCC:Function = function(event:FlexEvent):void
					{
						currentOpenView_fromTop.removeEventListener( FlexEvent.CREATION_COMPLETE, commViewCC);
						commView = currentOpenView_fromTop as CommunicationView;
						if(null != commView )
						{
							commView.SelectVideoTab();
						}
						
					}
					currentOpenView_fromTop.addEventListener( FlexEvent.CREATION_COMPLETE, commViewCC);
				}
				else
				{
					commView.SelectVideoTab();
				}
			}
			
