<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx"
				width="100%" minWidth="0" 
				minHeight="26" autoDrawBackground="true"
				buttonMode="true" useHandCursor="true" >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.PatientDTO;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			
			private var _patient:PatientDTO;
			
			
			[Bindable]
			public function get patient():PatientDTO
			{
				return _patient;
			}
			
			public function set patient(value:PatientDTO):void
			{
				_patient = value;
			}
			
			[Bindable]
			public override function set data(value:Object):void
			{
				if(value is PatientDTO)
				{
					this.patient = value as PatientDTO;
				}
				
				super.data = value;
			}
			
			
			
			protected function load_clickHandler(event:MouseEvent):void
			{
				var ps:PatientSelectedEvent = new PatientSelectedEvent(PatientSelectedEvent.PATIENT_SELECTED, true);
				ps.selection = patient;
				dispatchEvent( ps );
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="hovered"/>
		<s:State name="selected"/>
	</s:states>     
	
	<s:layout>
		<s:VerticalLayout gap="0" />
	</s:layout>
	<s:HGroup width="100%" height="100%" verticalAlign="middle"  paddingLeft="4"  paddingRight="5"  gap="5"  >
		
		<s:Label  text="{patient.FullName}" 
				  toolTip="{'Patient Name: ' + patient.FullName}"
				  width="100%"
				  styleName="patientListItem" 
				  styleName.selected="patientListItemSelected"
				  maxDisplayedLines="1"   
				  />
		<s:Spacer width="100%" />
		<s:Label text="{UtilityFunctions.FormatDate(patient.DOB, 'MM-DD-YYYY')}" width="100%"
				 toolTip="{'Patient DOB: ' + UtilityFunctions.FormatDate(patient.DOB, 'MM-DD-YYYY')}"
				 styleName="patientListItemEmail" 
				 styleName.selected="patientListItemEmailSelected" 
				 maxDisplayedLines="1" 
				 />
		
		<s:Button  label="Load Patient" click="load_clickHandler(event)" toolTip="Load Patient"
				   skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin" width="120"/>
	</s:HGroup>
	
	<s:Line width="100%">
		<s:stroke>
			<s:SolidColorStroke color="0xCCCCCC" weight="1" caps="square"/>
		</s:stroke>
	</s:Line>
</s:ItemRenderer>
