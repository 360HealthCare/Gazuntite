<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.bar.PatientProfileHeaderSkin"
					  height="25"
					  buttonMode="true" toolTip="Toggle Profile"
					  >
	<fx:Script>
		<![CDATA[
			import com.zigron.gazuntite.model.ApplicationModel;
			[Bindable] private var model : ApplicationModel = ApplicationModel.getInstance();
			
			protected function onOptionClick(event:MouseEvent):void
			{
				
			}
			
		]]>
	</fx:Script>
	<s:layout>
		<s:BasicLayout/>
	</s:layout>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:RichText left="6" verticalCenter="0" color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="16" fontWeight="bold"
				text="PROFILE">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	
	<s:Button buttonMode="true" useHandCursor="true"
			  skinClass="com.gazuntite.skins.controls.button.input.InputOptionButtonSkin"
			  horizontalCenter="0" verticalCenter="0" />
	
	<s:RichText right="31" verticalCenter="0" color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="16"
				text="{model.selectedPatientName}" typographicCase="uppercase"
				fontWeight="bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	
	
	<s:ToggleButton id="expand" 
					label="Expand" verticalCenter="0" right="5" 
					buttonMode="true" useHandCursor="true" toolTip="Expand"
					skinClass="com.gazuntite.skins.controls.button.eLab.ExpandButtonSkin"/>
	
</s:SkinnableContainer>
