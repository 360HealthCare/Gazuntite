<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.bar.PatientHistoryHeaderSkin"
					  height="25" 
					  buttonMode="true" toolTip="Toggle History"
					  click="skinnablecontainer1_clickHandler(event)"
					  >
	<fx:Metadata>
		[Event(name="HistoryHeaderClickEvent", type="flash.events.Event")]
		[Event(name="HistoryHeaderOptionClickEvent", type="flash.events.Event")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.MaxRestorePopupManager;
			import com.gazuntite.common.view.PatientViewModel;
			import com.zigron.gazuntite.model.ApplicationModel;
			
			import mx.core.UIComponent;
			[Bindable] private var model : ApplicationModel = ApplicationModel.getInstance();
			
			[Bindable]
			public var maximizeView:UIComponent;
			
			protected function skinnablecontainer1_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("HistoryHeaderClickEvent", true, false ) );
			}
			
			protected function onOptionClick(event:MouseEvent):void
			{
				dispatchEvent( new Event("HistoryHeaderOptionClickEvent", true, false ));
				
				id_Options.visible = false;
				
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
			}
			
			protected function onExpandRestore(event:MouseEvent):void
			{
//				MaxRestorePopupManager.maxRestoreView(maximizeView);
				MaxRestorePopupManager.maxPatientView(PatientViewModel.MAIN_TAB_HISTORY);
				expand.selected = false;
			}
		]]>
	</fx:Script>
	<s:layout>
		<s:BasicLayout/>
	</s:layout>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:RichText left="6" verticalCenter="0" color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="16" fontWeight="bold"
				text="HISTORY">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	
	<s:Button id="id_Options" buttonMode="true" useHandCursor="true"
			  skinClass="com.gazuntite.skins.controls.button.input.InputOptionButtonSkin"
			  horizontalCenter="0" verticalCenter="0" click="onOptionClick(event)"/>
	
	<s:RichText right="31" verticalCenter="0" color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="16"
				text="{model.selectedPatientName}" typographicCase="uppercase"
				fontWeight="bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	
	<s:ToggleButton id="expand" 
					label="Expand" verticalCenter="0" right="5" 
					buttonMode="true" useHandCursor="true" toolTip="{expand.selected?'Restore':'Expand'}"
					skinClass="com.gazuntite.skins.controls.button.eLab.ExpandButtonSkin"
					click="onExpandRestore(event)"
					/>

</s:SkinnableContainer>
