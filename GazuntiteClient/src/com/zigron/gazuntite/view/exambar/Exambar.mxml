			public function whenPatientCloseRequested(event:Event = null, callBackAfterClose:Function = null):void 
			{
				Alert.show("Are you sure you want to close this patient ?",	"Confirmation Required!", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function( event:CloseEvent):void
				{
					if( event.detail == Alert.YES )
					{
						model.isPatientAlredayLoaded			= false;
						model.selectedPatientName 		= 'Search Patient';
						model.selectedPatientDTO 		= null;
						selectedPatient					= null;
						CloseAllPanel();
						viewModel.closeAllTabs();
						enableActionButton(false);
						viewModel.selectedPatient 		= null;
						HistoryModelLocator.getInstance().PatientGaxenID = '';
						PatientInputViewModel.getInstance().clearOldQuickInputData();//TA--Clear All Sections(Array, list, forms etc) of Quick Input on new patien Load
						
						switchToDefault();
						
						if( null != callBackAfterClose )
						{
							callBackAfterClose();
						}
					}
					else if( event.detail == Alert.NO )
					{
						return;
					}
				});
			}
			
			protected function whenRecentPatientSelected(event:PatientSelectedEvent):void 
			{
				selectedPatient 				= event.selection as PatientDTO;
				viewModel.selectedPatient 		= selectedPatient;
				
				CloseAllPanel();
				
				if(!viewModel.showMainInputTab)
					viewModel.showMainInputTab 	= true;
				model.isPatientAlredayLoaded			= true;
				
			} 
			
			private function CloseAllPanel():void
			{
				removeExamBarPopup();
			}
			
			protected function max_clickHandler(event:MouseEvent):void
			{
				MainContainerViewModel.getInstance().dispatchEvent(new Event(MainContainerViewModel.EVENT_CLOSE_TOPBAR));
				viewModel.showMainInputTab = true;
			}
			
			protected function close_clickHandler(event:MouseEvent):void
			{
				viewModel.closeAllTabs();
			}
			
			/////////////// Patient Select //////////////////////////////////////////
			protected function whenPatientSelected(event:PatientSelectedEvent):void 
			{
				switchToDefault(); // For switching Selected name and Search Patient.
				selectedPatient = event.selection as PatientDTO;
				
				if(model.isPatientAlredayLoaded)
				{
					model.confirmLoadPatientName = selectedPatient.FullName;
					showConfirlLoadPopup();
					return;
				}
				
				setPatientSelection();
				
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
			} 
			// Actually assign the seleted patient in application after Patient Search or Confirmation.
			private function setPatientSelection():void
			{
				viewModel.selectedPatient = selectedPatient;
				
				if(selectedPatient)
				{
					PatientInputViewModel.getInstance().clearOldQuickInputData();//Clear All Sections(Array, list, forms etc) of Quick Input on new patien Load
					
					dispatchEvent(new Event("ClearInputFormEvent")); //TA ---Disptach this event on every patient load, clear all input form fields from Quick input
					
					CloseAllPanel();
					
					QIModelLocator.getInstance().patientDTO 						= viewModel.selectedPatient; 
					QIModelLocator.getInstance().LoggedInUserId 					= model.LoggedInUserDTO.UserId;
					QIModelLocator.getInstance().LoggedInUserName 					= model.LoggedInUserDTO.FullName;
					
					QIModelLocator.getInstance().LoggedInUserProviderId 			= model.LoggedInProvider.UserId;
					QIModelLocator.getInstance().LoggedInUserProviderTypeId 		= model.LoggedInUserSessionDTO.UserTypeID;
					
					QIModelLocator.getInstance().userSelectedRoleDTO				= model.userSelectedRoleDTO;
					QIModelLocator.getInstance().LoggedInUserSessionID 				= model.LoggedInUserSessionDTO.SessionID;
					QIModelLocator.getInstance().LoggedInUserSelectedBranchId 		= model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
					
					QIModelLocator.getInstance().LoggedInUserSelectedPracticeName 	= model.selectedProvider.FullName;
					QIModelLocator.getInstance().IsloggedInUserProvider 			= model.IsProviderLoggedIn;
					QIModelLocator.getInstance().IsloggedInUserFemale 				= model.LoggedInUserDTO.Gender.toLowerCase().charAt(0) == "f";
					
					QIModelLocator.getInstance().LoggedInUserGaxenID 				= model.LoggedInuserGaxenID;
					
					EpresprectionyModel.LoggedInUserGaxenID 						=  model.LoggedInuserGaxenID
					
					Historymodel.PatientGaxenID 									= selectedPatient.GAXENID;
					
					PatientInputViewModel.getInstance().createVisit();
					
					if(!selectedPatient.GAXENID == '' &&  !selectedPatient.GAXENID == '0')
						QIModelLocator.getInstance().isAtRegGaxenID = true;// means the selected patient have gaxen id
					
					if(!viewModel.showMainInputTab)
						viewModel.showMainInputTab = true;
					
					enableActionButton(true);
					
					LoadHistoryViewData();
					
					EpresprectionyModel.ChronicMedCollection = new ArrayCollection();
					EpresprectionyModel.PresprectionCollection = new ArrayCollection();
					
					
					QIModelLocator.getInstance().CurrentprescriptionDToList = new ArrayCollection();
				}
				
				model.selectedPatientName 	= selectedPatient.FullName;
				model.selectedPatientDTO 	= selectedPatient;
				model.isPatientAlredayLoaded 		= true;
			}
			
			private function onLoadPatientGaxenID(result:XML):void
			{
				var gaxenID:String = result[0];
				
				if (!gaxenID)
					return;
				
				if (gaxenID == "0")
					return;
				
				QIModelLocator.getInstance().patientDTO.GAXENID = gaxenID;
				QIModelLocator.getInstance().gaxenIDSaved = true;
				
				//HistoryModelLocator.getInstance().gaxenID = gaxenID; 
				//[09/02/2013] Shahid Munir, gaxenID was updated instead of PatientGaxenID in above line
				Historymodel.PatientGaxenID = gaxenID;
			}
			
