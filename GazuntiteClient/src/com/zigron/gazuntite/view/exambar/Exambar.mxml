			// on ShowOptionPanelHandler
			protected function ShowOptionPanelHandler(event:MouseEvent):void
			{
				if(id_tbOption.selected)
				{
					optionBarPopup = new ExambarOptionPopup();
					optionBarPopup.ShowPopup(this);
					optionBarPopup.selectedPatient = selectedPatient;
					optionBarPopup.addEventListener(PatientSelectedEvent.PATIENT_SELECTED, function(event:PatientSelectedEvent):void
					{
						//whenRecentPatientSelected(event);
						whenPatientSelected(event);
						
						if( optionBarPopup && optionBarPopup.isPopUp )
						{
							optionBarPopup.removePopup();
							optionBarPopup = null;
						}
					});
					
					var pt:Point = id_tbOption.localToGlobal(new Point(event.localX, event.localY));
					
					optionBarPopup.move( 0 , pt.y + (optionBarPopup.height - 25));
					
					//	optionBarPopup.y = 120;
					optionBarPopup.width = this.width -5;
				}
				else
				{
					removeOptionBarPopup();
				}
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
				
			}
			// on removeOptionBarPopup
			private function removeOptionBarPopup():void
			{
				if( optionBarPopup && optionBarPopup.isPopUp )
				{
					optionBarPopup.removePopup();
					optionBarPopup = null;
					if(id_tbOption.selected)
						id_tbOption.selected = false;
				}
			}
			// on showConfirlLoadPopup  
			private function showConfirlLoadPopup():void
			{
				confirlLoadPopup = new ConfirmPatientLoadPopup();
				confirlLoadPopup.ShowPopup(this);
				
				var pt:Point = id_selectedSearchPatientView.localToGlobal(new Point(id_selectedSearchPatientView.x, id_selectedSearchPatientView.y));
				confirlLoadPopup.move( 67, pt.y + id_selectedSearchPatientView.height-35);
				
				confirlLoadPopup.width = id_selectedSearchPatientView.width;
				confirlLoadPopup.addEventListener("ConfirmLoadPatient", ConfirmLoadPatientHandler);
				confirlLoadPopup.addEventListener("CancelLoadPatient", CancelLoadPatientHandler);
			}
			// on ConfirmLoadPatientHandler
			protected function ConfirmLoadPatientHandler(event:Event):void
			{
				HistoryModelLocator.getInstance().PatientGaxenID = '';
				PatientInputViewModel.getInstance().clearOldQuickInputData();//Clear All Sections(Array, list, forms etc) of Quick Input on new patien Load
				setPatientSelection();
				removeConfirmPatientLoadPopup();
			}
			// on CancelLoadPatientHandler
			protected function CancelLoadPatientHandler(event:Event):void
			{
				removeConfirmPatientLoadPopup();
			}
			//Remove ConfirmPatientLoadPopup
			private function removeConfirmPatientLoadPopup():void
			{
				if( confirlLoadPopup && confirlLoadPopup.isPopUp )
				{
					confirlLoadPopup.removePopup();
					confirlLoadPopup = null;
				}
			}
			// Exambar Click handler
			protected function exambar_clickHandler(event:MouseEvent):void
			{
				switchToDefault();
				
				/* event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault(); */
			}
			
			public function switchToDefault():void
			{
				if(currentState == 'flipped')
				{
					currentState = 'default';
					id_searchPatientView.removeFocus();
				}
				
				removeExamBarPopup();
			}
			
			protected function id_selectedSearchPatientView_clickHandler(event:MouseEvent):void
			{
				removeExamBarPopup();
				
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
			}
			
			protected function bar_clickHandler(event:MouseEvent):void
			{
				removeExamBarPopup();
				
				if(event.currentTarget.id == 'id_HistoryTButton' && event.currentTarget.selected)
				{
					LoadHistoryViewData();
				}
				Historymodel.patientID = model.selectedPatientDTO.ID;
				Historymodel.PatientGaxenID = model.selectedPatientDTO.GAXENID;
				
			}
			
			protected function id_searchPatientView_clickHandler(event:MouseEvent):void
			{
				removeExamBarPopup();
				
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
			}
			
			private function removeExamBarPopup():void
			{
				removeConfirmPatientLoadPopup();
				removeOptionBarPopup();
			}
			
			protected function wipe_effectEndHandler(event:EffectEvent):void
			{
				if(currentState != 'flipped' && null != id_searchPatientView.id_patientSearch)
				{
					id_searchPatientView.id_patientSearch.text = '';
				}
			}
			
			protected function cc(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					switchToDefault();
				});
			}
			
