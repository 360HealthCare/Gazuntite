			public function getproviderXml():XML
			{
				
				var x:XML = XmlUtils.getNodeByTagName('PatientVisitProviderRequest');
				
				x.@PatientID			= selectedPatient.ID;
				x.@DemandPageNo			='1';
				x.@ClinicBranchId		= model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
				//x.@ClinicBranchId		= model.LoggedInProvider.UserSelectedClinicBranchDTO.ClinicBranch.cl .UserSelectedStation.StationID;
				//x.@UserTypeId			='7';
				x.@UserTypeId			=model.LoggedInUserDTO.AllUserTypes[0].UserTypeId;
				x.@OrderByType			='1';
				
				/* var x :XML = <PatientVisitProviderRequest PatientID="43070" DemandPageNo="1" ClinicBranchId="7" UserTypeId="3" OrderByType="1" /> ; */
				return x ;
				
			}
			//---------------------- New Exambar Impl -------------------------------------
			// enable or disable buttons on patient load.
			private function enableActionButton(bool:Boolean):void
			{
				id_HistoryTButton.enabled 	= bool;
				id_InputTButton.enabled 	= bool;
				id_ClosePatient.enabled 	= bool;
				id_patientProfile.enabled	= bool;
				//id_tbOption.enabled			= bool;
				if(bool)
					id_InputTButton.selected = bool;
				else
					id_InputTButton.selected = bool;
			}
			//-------------------------  on searchPatientView_focusOutHandler -------------------------------
