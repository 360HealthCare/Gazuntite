	</fx:Script>
	<!-- START States For patient selected Name and SearchPatient Component -->
	<s:states>
		<s:State name="default"/>
		<s:State name="flipped"/>
	</s:states>
	
	<s:transitions>
		<s:Transition id="t1">
			<s:Wipe id="wipe"
					direction="left"
					target="{id_selectedSearchPatientView}"
					effectEnd="wipe_effectEndHandler(event)"
					duration="500" />
		</s:Transition>
	</s:transitions>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" paddingRight="23" paddingTop="0" paddingLeft="21" paddingBottom="0"  gap="10"/>
	</s:layout>
	
	<s:HGroup width="50%" gap="1" verticalAlign="middle">
		<s:ToggleButton id="id_patientProfile"
						buttonMode="true" useHandCursor="true"
						width="35" height="35"
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.bar.PatientProfileTBSkin"
						toolTip="Patient Profile" enabled="false"
						selected="@{viewModel.showMainProfileTab}"
						click="bar_clickHandler(event)"
						/>
		<s:Group width="100%" height="100%">
			<view2:AutoCompleteSearch id="id_searchPatientView" 
									  width="100%"  
									  horizontalCenter="0" top="5"
									  visible.flipped="true" 
									  PatientSelected="whenPatientSelected(event)"
									  focusOut="searchPatientView_focusOutHandler(event)"
									  click="id_searchPatientView_clickHandler(event)"
									  />
			<exambar:SeletecSearchPatientView id="id_selectedSearchPatientView"
											  width="100%" height="100%" 
											  buttonMode="true" useHandCursor="true"
											  visible.flipped="false" 
											  ShowSearchPanel="{currentState = 'flipped'; id_searchPatientView.id_patientSearch.setFocus() }"
											  click="id_selectedSearchPatientView_clickHandler(event)"/>
		</s:Group>
	</s:HGroup>
	
	<s:HGroup width="50%" paddingTop="12" horizontalAlign="right" gap="5" verticalAlign="middle">
		
		<s:HGroup paddingTop="6" height="100%">
			<s:ToggleButton id="id_HistoryTButton"
							enabled="false"
							useHandCursor="true" buttonMode="true" toolTip="History"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.bar.HistoryTBSkin"
							selected="@{viewModel.showMainHistoryTab}"
							click="bar_clickHandler(event)"
							/>
			<s:ToggleButton id="id_InputTButton"
							enabled="false"
							useHandCursor="true" buttonMode="true" toolTip="Input"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.bar.InputTBSkin"
							selected="@{viewModel.showMainInputTab}"
							click="bar_clickHandler(event)"
							/>
		</s:HGroup>
		<s:Spacer width="10" />
		<s:HGroup paddingTop="6" height="100%">
			<s:ToggleButton id="id_tbOption"
							verticalCenter="0" buttonMode="true" useHandCursor="true" toolTip="More Options"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.bar.OptionTBSkin" 
							click="ShowOptionPanelHandler(event)" 
							/>
			<s:Button id="id_ClosePatient"
					  click="whenPatientCloseRequested()"
					  useHandCursor="true" buttonMode="true" toolTip="Close Patient"
					  skinClass="com.gazuntite.skins.controls.button.bar.ClosePatientButtonSkin"
					  enabled="false"
					  />
		</s:HGroup>
	</s:HGroup>
	
</s:SkinnableContainer>