<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:components="com.gazuntite.controls.extended.components.*" 
					   xmlns:exambar="com.zigron.gazuntite.view.exambar.*" 
					   xmlns:view="com.gazuntite.provider.search.services.patient.view.*" 
					   creationComplete="cc(event)" 
					   >
	<fx:Metadata>
		[Event(name="PatientSelected", type="com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent")] 
		[Event(name="ShowEmailPanel", type="flash.events.Event")]
		[Event(name="ShowSMSPanel", type="flash.events.Event")]
		[Event(name="ShowVideoPanel", type="flash.events.Event")]
		[Event(name="ShowRecentPatient", type="flash.events.Event")]
		[Event(name="ClosePatient", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			import com.zigron.gazuntite.view.event.NavigationEvent;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			
			
			protected function cc(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if( isPopUp )
					{
						//	removePopup();
						var e:Event = new Event('closePopup', true);
						dispatchEvent( e);
					}
				});
				
				
			}
			
			
			protected function searchpatientview1_PatientSelectedHandler(event:PatientSelectedEvent):void
			{
				dispatchEvent( event.clone() );
			}
			
			protected function OnPatientCommunicationEventHandler(event:NavigationEvent):void
			{
				if (event.content == null || event.content.currentTarget == null) 
				{
					dispatchEvent( new Event("ClosePatient", true, false ) );
					return;
				}
				switch( event.content.currentTarget.label )
				{
					case "Email":
						dispatchEvent( new Event("ShowEmailPanel", true, false ) );
						break;
					case "SMS":
						dispatchEvent( new Event("ShowSMSPanel", true, false ) );
						break;
					case "Video":
						dispatchEvent( new Event("ShowVideoPanel", true, false ) );
						break;
					case "RecentPatient":
						dispatchEvent( new Event("ShowRecentPatient", true, false ) );
						break;
					case "ClosePatient":
						dispatchEvent( new Event("ClosePatient", true, false ) );
						break;
				}
			}
			
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<components:layout>
		<s:VerticalLayout paddingLeft="4"/>
	</components:layout>
	
	<s:SkinnableContainer width="100%" height="100%" skinClass="com.gazuntite.skins.controls.container.ActionBarSkin" >
		
		<s:layout>
			<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="3" gap="3"/>
		</s:layout>
		
		<!--<view:SearchPatientView width="100%" height="100%" PatientSelected="searchpatientview1_PatientSelectedHandler(event)" />-->
		
		
		<exambar:PatientSearchCommunicationView id="id_CommunicationView" width="100%" height="100%"
												patientCommunicationEvent="OnPatientCommunicationEventHandler(event)" />
		
		
		
	</s:SkinnableContainer>
	
	
</components:PopupGroup>
