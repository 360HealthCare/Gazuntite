<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.UpperArrowConatinerSkin"
					  >
	<fx:Metadata>
		[Event(name="PatientSelected", type="com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			import com.gazuntite.utils.UtilityFunctions;
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			import com.zigron.gazuntite.model.valueObjects.provider.ProviderStatusDTO;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			import spark.events.IndexChangeEvent;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable] private var model : ApplicationModel = ApplicationModel.getInstance();
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<!--<s:layout>
	<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
	</s:layout>-->
	<s:BorderContainer backgroundColor="0xFFFFFF" cornerRadius="4" borderColor="0xFFFFFF" borderVisible="true"
					   width="100%" height="100%">
		<s:List left="5" right="5" top="5" bottom="5" 
				width="100%" height="100%"
				dataProvider="{model.recentPatientList.ListAll}" 
				borderVisible="false"
				itemRenderer="com.zigron.gazuntite.view.exambar.itemrenderer.RecentPatientRenderer"/>
		
	</s:BorderContainer>
	
</s:SkinnableContainer>
