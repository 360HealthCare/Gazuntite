<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.bar.SelectedSearchPatientViewSkin"
					  width="100%" height="100%"
					  click="bg_clickHandler(event)"
					  >
	<fx:Metadata>
		/* [Event(name="ShowOptionPanel", type="flash.events.MouseEvent")] */
		[Event(name="ShowSearchPanel", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.zigron.gazuntite.model.ApplicationModel;
			
			[Bindable] private var model : ApplicationModel = ApplicationModel.getInstance();
			
			
			/* protected function optionan_clickHandler(event:MouseEvent):void
			{
			dispatchEvent( new MouseEvent("ShowOptionPanel", true, false, event.localX, event.localY,event.relatedObject ) );
			} */
			
			protected function bg_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("ShowSearchPanel", true, false ) );
			}
			
		]]>
	</fx:Script>
	<s:VGroup left="5" right="43" paddingTop="2" gap="0">
		<s:Label id="id_patientFName"
				 width="100%"
				 color="#FFFFFF" fontFamily="CalibriCFF"
				 fontSize="16" maxDisplayedLines="1"  
				 text="{model.selectedPatientDTO.FirstName +' '+model.selectedPatientDTO.MiddleName}"
				 typographicCase="uppercase"
				 />
		<s:Label id="id_patientSName"
				 width="100%" color="#FFFFFF" fontFamily="CalibriCFF"
				 fontSize="16" maxDisplayedLines="1"  
				 text="{model.selectedPatientDTO.LastName}"
				 typographicCase="uppercase"
				 />
	</s:VGroup>
	
	<s:Label id="id_patientName"
			 left="5" right="43" color="#FFFFFF" fontFamily="CalibriCFF"
			 fontSize="16" maxDisplayedLines="2"  
			 text="Search Patient"
			 visible="{model.selectedPatientName == 'Search Patient' ? true:false}"
			 includeInLayout="{id_patientName.visible}"
			 verticalCenter="0"
			 typographicCase="uppercase"
			 />
	<!--			 click="patientName_clickHandler(event)"-->
	
	<s:Button id="id_btnPatientSearc"
			  buttonMode="true" useHandCursor="true"
			  skinClass="com.gazuntite.skins.controls.button.bar.PatientSearchBSkin" 
			  verticalCenter="0" right="5"
			  toolTip="Search Patient" 
			  />
	<!--			  click="patientName_clickHandler(event)"-->
	<!--
	<s:ToggleButton id="id_tbOption"
	buttonMode="true" useHandCursor="true"
	skinClass="com.gazuntite.skins.controls.toggleButtonSkin.bar.OptionTBSkin" 
	verticalCenter="0" right="5"
	visible="{model.selectedPatientName == 'Search Patient' ? false : true}"
	includeInLayout="{id_tbOption.visible}"
	click="optionan_clickHandler(event)"
	/>
	-->
</s:SkinnableContainer>
