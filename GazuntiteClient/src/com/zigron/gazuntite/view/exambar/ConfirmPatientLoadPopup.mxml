<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:components="com.gazuntite.controls.extended.components.*"
					   width="100%" height="165"
					   >
	
	<fx:Metadata>
		[Event(name="ConfirmLoadPatient", type="flash.events.Event")]
		[Event(name="CancelLoadPatient", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.zigron.gazuntite.model.ApplicationModel;
			
			[Bindable] private var model : ApplicationModel = ApplicationModel.getInstance();
			
			protected function YesclickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("ConfirmLoadPatient", true, false ) );
			}
			protected function NoclickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("CancelLoadPatient", true, false ) );
			}

			
			


		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.bar.ConfirmPatientLoadSkin" width="100%" height="100%" >
		<s:layout>
			<s:VerticalLayout horizontalAlign="center" gap="3" />
		</s:layout>
		
		<s:SkinnableContainer width="100%" height="35" skinClass="com.gazuntite.skins.controls.container.bar.SelectedSearchPatientViewSkin" >
			<s:VGroup left="5" right="43" paddingTop="4" gap="0">
				<s:Label id="id_patientFName"
						 width="100%"
						 color="#FFFFFF" fontFamily="CalibriCFF"
						 fontSize="15" maxDisplayedLines="1"  
						 text="{model.selectedPatientDTO.FirstName +' '+model.selectedPatientDTO.MiddleName}"
						 typographicCase="uppercase"
						 />
				<s:Label id="id_patientSName"
						 width="100%" color="#FFFFFF" fontFamily="CalibriCFF"
						 fontSize="15" maxDisplayedLines="1"  
						 text="{model.selectedPatientDTO.LastName}"
						 typographicCase="uppercase"
						 />
			</s:VGroup>
			<s:Button id="id_btnPatientSearc"
					  buttonMode="true" useHandCursor="true"
					  skinClass="com.gazuntite.skins.controls.button.bar.PatientSearchBSkin" 
					  verticalCenter="0" right="5"
					  />
		</s:SkinnableContainer>
							  
		<s:Label text="Are you sure, you want to close" color="#ffffff" fontFamily="CalibriCFF" fontSize="13"/>
		<s:Label text="old patient" color="#ffffff" fontFamily="CalibriCFF" fontSize="15"/>
		<s:Label text="{model.selectedPatientName}" color="#F9FE7F" fontFamily="CalibriCFFBold" fontSize="13" fontWeight="bold"/>
		
		<s:HGroup horizontalAlign="center" gap="1">
			<s:Label text="and open" color="#ffffff" fontFamily="CalibriCFF" fontSize="15" />
			<s:Label text="{model.confirmLoadPatientName}" color="#F9FE7F" fontFamily="CalibriCFFBold" fontSize="13" fontWeight="bold"/>
			<s:Label text="?" color="#ffffff" fontFamily="CalibriCFF" fontSize="15" />
		</s:HGroup>
		<s:Spacer height="6" />
		<s:HGroup horizontalAlign="center">
			<s:Button label="Yes" 
					  skinClass="com.gazuntite.skins.controls.button.eLab.ProcessBlackButton"
					  click="YesclickHandler(event)" 
					  buttonMode="true" useHandCursor="true" 
					  toolTip="Yes" width="70"
					  />
			<s:Button label="No" 
					  click="NoclickHandler(event)"
					  buttonMode="true" useHandCursor="true" 
					  toolTip="No" width="70"
					  skinClass="com.gazuntite.skins.controls.button.eLab.ProcessBlackButton"
					  />
		</s:HGroup>
	</s:SkinnableContainer>
</components:PopupGroup>
