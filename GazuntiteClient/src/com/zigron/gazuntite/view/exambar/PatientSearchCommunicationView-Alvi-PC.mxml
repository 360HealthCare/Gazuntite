<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx">
	
	<fx:Metadata>
		[Event(name="patientCommunicationEvent", type="com.zigron.gazuntite.view.event.NavigationEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.PatientDTO;
			import com.gazuntite.input.view.viewmodel.PatientInputViewModel;
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			import com.zigron.gazuntite.view.common.AlertHelper;
			import com.zigron.gazuntite.view.event.NavigationEvent;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			public var closeEvent:MouseEvent;
			public var eventLabel:String;
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			
			
			protected function cc(event:FlexEvent):void
			{
				
			}
			
			
			protected function statusButton_clickHandler(event:MouseEvent):void
			{
				closeEvent = event;
				eventLabel = event.currentTarget.label;
//				Alert.show(eventLabel);
				var modified_views:ArrayCollection = PatientInputViewModel.getInstance().getDirtyViewList();
				if (modified_views.length>0)
				{
					var msg:String = "The following views contain unsaved data:";
					for each (var view_name:String in modified_views)
					{
						msg += "\n  "+view_name;
					}
					msg += "\nThe unsaved data will be lost. Do you want to continue?";
					AlertHelper.showContinueQuestion(closePatient, msg);
				}
				else
				{
					closePatient();
				}
			}
			protected function closePatient():void
			{
				if (eventLabel == id_ClosePatientButton.label)
				{
					PatientInputViewModel.getInstance().resetDirtyViewList();
				}
				var ne:NavigationEvent = new NavigationEvent( "patientCommunicationEvent", true, true );
				var currentTarget:Object = new Object();
				currentTarget.label = eventLabel;
				ne.content = new Object();
				ne.content.currentTarget = currentTarget;
				dispatchEvent( ne );
			}
			public function resetSelectedButtons():void
			{
				id_EmailButton.selected = false;
				id_SMSButton.selected = false;
				id_VideoButton.selected = false;
				id_RecentPatientButton.selected = false;
				id_ClosePatientButton.selected = false;
			}
			
			public function enableButtonForPatient( patient:PatientDTO ):void
			{
				if( null == patient ) 
				{
					id_EmailButton.enabled 	= false;
					id_SMSButton.enabled 	= false;
					id_VideoButton.enabled 	= false;
				}
				else
				{
					id_EmailButton.enabled 	= patient.IsEmailIdAvailable;
					id_SMSButton.enabled 	= patient.IsSMSNoAvalable;
					id_VideoButton.enabled 	= patient.IsEmailIdAvailable;
				}
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<!--<s:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
	</s:layout>-->
	
	<s:HGroup width="100%" horizontalAlign="center"  >
		
		<s:ToggleButton id="id_EmailButton" label="Email" 
						click="statusButton_clickHandler(event)" 
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.EmailToggleButton"
						buttonMode="true" useHandCursor="true" toolTip="Email"/>
		<s:ToggleButton id="id_SMSButton" label="SMS" 
						click="statusButton_clickHandler(event)"
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.SmsToggleButtonSkin"
						buttonMode="true" useHandCursor="true" toolTip="SMS"/>
		<s:ToggleButton id="id_VideoButton" label="Video" 
						click="statusButton_clickHandler(event)"
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.VideoToogleButtonSkin"
						buttonMode="true" useHandCursor="true" toolTip="Video"/>
		<s:ToggleButton id="id_RecentPatientButton" label="RecentPatient" 
						click="statusButton_clickHandler(event)"
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.RecentPatientToggleButtonSkin"
						buttonMode="true" useHandCursor="true" toolTip="Recent Patient"/>
		<s:ToggleButton id="id_ClosePatientButton" label="ClosePatient" 
						click="statusButton_clickHandler(event)"
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.ClosePatientToggleButtonSkin"
						buttonMode="true" useHandCursor="true" toolTip="Close Patient"/>
		
	</s:HGroup>
	
	
	
</s:SkinnableContainer>
