<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:components="com.gazuntite.controls.extended.components.*" 
					   creationComplete="cc(event)" 
					   >
	<fx:Script>
		<![CDATA[
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			import com.zigron.gazuntite.model.valueObjects.search.SearchEngineList;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			import spark.events.IndexChangeEvent;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			[Bindable]
			private var SEList:SearchEngineList
			
			protected function cc(event:FlexEvent):void
			{
				SEList = new SearchEngineList();
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if( isPopUp )
					{
						var e:Event = new Event('closePopup', true);
						dispatchEvent( e);
						//removePopup();
					}
				});
			}
			
			protected function listItem_changeHandler(event:IndexChangeEvent):void
			{
				var e:Event = new Event('change', true);
				dispatchEvent( e );
				
				e = new Event('closePopup', true);
				dispatchEvent( e);
			}
			
			protected function id_manageTB_clickHandler(event:MouseEvent):void
			{
				if(id_manageTB.selected)
				{
					id_main.height = 230;
				}
				else
				{
					id_main.height = 130;
				}
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:BorderContainer id="id_main" width="100%" height="130" cornerRadius="4" backgroundColor="#000000"  borderVisible="false">
		<s:layout>
			<s:VerticalLayout paddingBottom="4" paddingLeft="4" paddingRight="4" paddingTop="4" gap="4"/>
		</s:layout>
		
		<s:BorderContainer backgroundColor="0xE8E8E8" width="100%" height="90" borderVisible="false" cornerRadius="0">
			<s:List id="id_Selist" 
					width="100%" height="100%" 
					dataProvider="{SEList.ListAll}"  
					borderVisible="false" contentBackgroundAlpha="0"
					change="listItem_changeHandler(event)"
					itemRenderer="com.zigron.gazuntite.view.topbar.websearch.renderer.SEItemRenderer" 
					skinClass="com.gazuntite.skins.controls.list.TransparentInvisibleScrollSkin"
					/>
		</s:BorderContainer>
		
		<s:BorderContainer backgroundColor="0x000000" width="100%" height="100%" borderVisible="false">
			<s:VGroup width="100%" height="100%" horizontalAlign="left" verticalAlign="top" gap="-2" paddingTop="3" paddingLeft="3" paddingRight="3" >
				<s:ToggleButton id="id_manageTB" 
								skinClass="com.gazuntite.skins.controls.toggleButtonSkin.ManageTBSkin"
								toolTip="Manage" useHandCursor="true" buttonMode="true"
								click="id_manageTB_clickHandler(event)"
								/>
				<s:BorderContainer backgroundColor="0xE8E8E8" width="100%" height="65" borderVisible="false" cornerRadius="0" visible="{id_manageTB.selected}" includeInLayout="{id_manageTB.selected}">
					<s:List  id="id_allSearchEngine"
							 width="100%" height="100%" 
							 borderVisible="false" contentBackgroundAlpha="0"
							 dataProvider="{SEList.ListAll}"  
							 itemRenderer="com.zigron.gazuntite.view.topbar.websearch.renderer.SECheckboxItemRenderer" 
							 skinClass="com.gazuntite.skins.controls.list.TransparentInvisibleScrollSkin"
							 />
				</s:BorderContainer>
				<s:Spacer height="8" width="100%" visible="{id_manageTB.selected}" includeInLayout="{id_manageTB.selected}"/>
				<s:Group width="100%" height="20" visible="{id_manageTB.selected}" includeInLayout="{id_manageTB.selected}">
					<s:Button label="Set as default"
							  skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin"
							  toolTip="Set as default"
							  buttonMode="true"
							  useHandCursor="true"
							  left="0" width="100"
							  />
					<s:Button label="Set as default"
							  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"
							  toolTip="save"
							  buttonMode="true"
							  useHandCursor="true"
							  right="0"
							  />
				</s:Group>
			</s:VGroup>
		</s:BorderContainer>
	</s:BorderContainer>
	
</components:PopupGroup>