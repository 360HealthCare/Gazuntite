<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="false" 
				creationComplete="cc(event)"
				>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			import mx.utils.Base64Decoder;
			
			[Bindable]
			private var iconData:ByteArray;
			/* [Bindable]
			private var label:ByteArray;
			 */
			protected function cc(event:FlexEvent):void
			{
				var decoder:Base64Decoder = new Base64Decoder();
				decoder.decode( data.IconBase64 );
				iconData = decoder.toByteArray();
				
				this.label = data.label;
			}
			
			protected function spacer1_clickHandler(event:MouseEvent):void
			{
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
			protected function checkbox1_changeHandler(event:Event):void
			{
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:HorizontalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" gap="4"/>
	</s:layout>
	
	<s:Image source="{iconData}" height="12" width="12"/>
	<s:Label text="{label}"/>
	<s:Spacer width="100%"/>
	<s:CheckBox change="checkbox1_changeHandler(event)"  click="spacer1_clickHandler(event)" skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"  />
	
</s:ItemRenderer>
