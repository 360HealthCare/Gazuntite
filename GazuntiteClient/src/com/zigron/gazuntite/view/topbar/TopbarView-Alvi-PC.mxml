<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  creationComplete="cc(event)" xmlns:status="com.zigron.gazuntite.view.topbar.provider.status.*" xmlns:topbar="com.zigron.gazuntite.view.topbar.*" xmlns:components="com.gazuntite.controls.extended.components.*"
					  >
	<fx:Metadata>
		[Event(name="logoClick", type="flash.events.Event")]
		[Event(name="userImageClick", type="flash.events.Event")]
		[Event(name="signOut", type="flash.events.Event")]
		[Event(name="rapidAccessClick", type="flash.events.Event")]
		[Event(name="communicationClick", type="flash.events.Event")]
		[Event(name="webSearchClick", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.utils.AppUtils;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.input.view.viewmodel.PatientInputViewModel;
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			import com.zigron.gazuntite.utils.ChromeUtil;
			import com.zigron.gazuntite.view.common.AlertHelper;
			import com.zigron.gazuntite.view.event.LogoutViewEvent;
			import com.zigron.gazuntite.view.topbar.provider.AddressViewPopup;
			import com.zigron.gazuntite.view.topbar.provider.StatusViewPopup;
			
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.core.IVisualElement;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			
			[Bindable]
			private var showDebugBorders:Boolean = false;
			
			[Bindable]
			public var tempimage:String ='' ;
			
			private var addressView:AddressViewPopup;
			private var statusView:StatusViewPopup;
			
			protected function cc(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if(id_tBtnAddressBook.selected)	
						id_tBtnAddressBook.selected = false;
				});
			}
			
			public function changeToopTip():void
			{
				if(id_restore.toolTip=='Restore')
				{
					id_restore.toolTip='Maximize';
				}
				else if(id_restore.toolTip=='Maximize')
				{
					
					id_restore.toolTip='Restore';
				}
			}
			
			protected function id_close_clickHandler():void
			{
				var modified_views:ArrayCollection = PatientInputViewModel.getInstance().getDirtyViewList();
				if (modified_views.length>0)
				{
					var msg:String = "The following views contain unsaved data:";
					for each (var view_name:String in modified_views)
					{
						msg += "\n  "+view_name;
					}
					msg += "\nThe unsaved data will be lost. Do you want to continue?";
					AlertHelper.showContinueQuestion(confirmedClose, msg);
				}
				else
				{
					UtilityFunctions.AskMessage(  "Do you really want to exit 'Gazuntite Online Clinic'", function():void
					{
						confirmedClose();
					});
				}
			}
			protected function confirmedClose():void
			{
				dispatchEvent(new LogoutViewEvent(true));
				
				/* var logoutevent:LogoutEvent = new LogoutEvent(function ():void{
					ChromeUtil.closeWindow();
					
				});
				CairngormEventDispatcher.getInstance().dispatchEvent(logoutevent); */
			}
			
			protected function OnSignOut(event:Event):void
			{
				removeAllPopups();
				UtilityFunctions.AskMessage(  "Do you really want to Signout from 'Gazuntite Online Clinic' ?", function():void
				{
					dispatchEvent(new LogoutViewEvent(false));
					
					id_RapidAccess.selected = false;
					id_Communication.selected = false;
					id_WebSearch.selected = false;

					id_LogoButton.selected 		 = false;
					id_ProfileBtn.selected 		 = false;
					
					dispatchEvent( new Event('CloseAllOpenPanel',true));
				});
				
				id_tBtnAddressBook.selected = false;
			}
			
			protected function id_LogoButton_clickHandler(event:MouseEvent):void
			{
				unselectAllExcept( event.currentTarget as IVisualElement);
				
				var lc:Event = new Event( "logoClick", true, false );
				dispatchEvent( lc );
			}
			
			
			protected function showDoctorsAddress(event:MouseEvent):void
			{
				var toggleView:Boolean = null != addressView;
				
				removeAllPopups();
				
				if(toggleView )
				{
					event.currentTarget.selected = false;
					return;
				}
				
				addressView = new AddressViewPopup();
				addressView.ShowPopup( this );
				addressView.addEventListener("signOut", OnSignOut);
				addressView.addEventListener("closePopup", function(event:Event):void { removeAllPopups() } );
				
				event.currentTarget.selected = true;
				
				//addressView.minWidth = 245;
				//addressView.percentWidth = 100;
				addressView.width =  id_AcContainer.width;
				
				var pt:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
				addressView.move( pt.x - (addressView.width ) + 20 , pt.y + event.currentTarget.height  + 5); 
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
			protected function signout_clickHandler(event:MouseEvent):void
			{
				var toggleView:Boolean = null != statusView;
				
				removeAllPopups();
				
				if(toggleView )
				{
					return;
				}
				
				statusView = new StatusViewPopup();
				statusView.ShowPopup( this );
				statusView.addEventListener("signOut", OnSignOut);
				statusView.addEventListener("closePopup", function(event:Event):void { removeAllPopups(); });
				
				var pt:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
				
				statusView.move( pt.x - (statusView.width - event.currentTarget.width + 4), pt.y + event.currentTarget.height + 2 );
				
			}
			
			public function removeAllPopups():void
			{
				if( addressView && addressView.isPopUp )
				{
					addressView.removePopup();
					addressView.removeEventListener("signOut", OnSignOut);
					addressView = null;
				}
				
				if( statusView && statusView.isPopUp )
				{
					statusView.removePopup();
					statusView.removeEventListener("signOut", OnSignOut);
					statusView = null;
				}
			}
			
			/* protected function tabBar_changeHandler(event:Event):void
			{
			id_RapidAccess.selected 	= false;
			id_Communication.selected 	= false;
			id_WebSearch.selected 		= false;
			
			//event.currentTarget.selected = ! event.currentTarget.selected; // select the current button
			
			var topbarAction:String = event.currentTarget.name + "Click";
			var tbe:Event = new Event( topbarAction, true, false );
			//--------------------------------------------------------------------------------------------------------------------------------------------------------------------- just stop call for time being
			if('communicationClick' == topbarAction)
			return;
			
			dispatchEvent( tbe );
			} */
			
			protected function id_RapidAccess_changeHandler(event:MouseEvent):void
			{
				unselectAllExcept( event.currentTarget as IVisualElement);
				
				var topbarAction:String = event.currentTarget.name + "Click";
				var tbe:Event = new Event( topbarAction, true, false );
				dispatchEvent( tbe );
			}
			
			protected function id_Communication_changeHandler(event:MouseEvent):void
			{
				unselectAllExcept( event.currentTarget as IVisualElement);
				
				
				var topbarAction:String = event.currentTarget.name + "Click";
				var tbe:Event = new Event( topbarAction, true, false );
				dispatchEvent( tbe );
			}
			protected function id_WebSearch_clickHandler(event:MouseEvent):void
			{
				unselectAllExcept( event.currentTarget as IVisualElement);
				
				var topbarAction:String = event.currentTarget.name + "Click";
				var tbe:Event = new Event( topbarAction, true, false );
				dispatchEvent( tbe );
				//event.currentTarget.x = -20;
			}
			
			
			protected function UserImage_clickHandler(event:MouseEvent):void
			{
				unselectAllExcept( event.currentTarget as IVisualElement);
				
				var lc:Event = new Event( "userImageClick", true, false );
				dispatchEvent( lc );
			}
			
			
			private function unselectAllExcept(element:IVisualElement):void
			{
				if(element is ToggleButton && (element as ToggleButton).selected )
				{
					id_LogoButton.selected 		= id_LogoButton 	== element;
					id_RapidAccess.selected 	= id_RapidAccess	== element;
					id_Communication.selected 	= id_Communication 	== element;
					id_WebSearch.selected 		= id_WebSearch 		== element;
					id_ProfileBtn.selected 		= id_ProfileBtn 	== element;
				}
			}
			
			protected function id_AcContainer_clickHandler(event:MouseEvent):void
			{
				id_tBtnAddressBook.dispatchEvent( new MouseEvent(MouseEvent.CLICK));
				
				event.preventDefault();
				event.stopImmediatePropagation();
				//AppUtils.getByteArray(model.userImageData)
			}
			
			private function GetUserImage(imageData:String):ByteArray
			{
				if(null != imageData && imageData.length)
					return AppUtils.getByteArray(model.userImageData);
				
				return AppUtils.getByteArray(tempimage);
			}
			
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:BorderContainer id="id_TopbarContainer"
					   borderAlpha="{showDebugBorders?1:0}" backgroundAlpha="{showDebugBorders?1:0}" 
					   borderVisible="{showDebugBorders}" borderColor="0xff0000" width="100%" height="100%" >
		<s:layout>
			<s:HorizontalLayout paddingRight="3" />
		</s:layout>
		
		<s:ToggleButton id="id_LogoButton" 
						click="id_LogoButton_clickHandler(event)"
						skinClass="com.gazuntite.skins.LogoButtonSkin" toolTip="Gazuntite Products and Services" 
						useHandCursor="true" buttonMode="true" width="146"/>
		
		<s:VGroup width="100%" height="100%" verticalAlign="top" horizontalAlign="center" gap="2">
			
			<s:SkinnableContainer id="id_AcContainer" minWidth="200" width="33%" height="24"
								  skinClass="com.gazuntite.skins.controls.container.blackBGSkin" >
				<s:Label id="actionBarTitle"
						 text="{model.LoggedInUserDTO.FullName.toUpperCase()}" textAlign="center"
						 styleName="drName" toolTip="{model.LoggedInProvider.FullName.toUpperCase()}"
						 verticalCenter="0" width="190" maxWidth="190" maxDisplayedLines="1"  click="id_AcContainer_clickHandler(event)"/>
				
				<s:ToggleButton id="id_tBtnAddressBook"
								skinClass="com.gazuntite.skins.controls.button.MoreOptionToggleButtonSkin"
								right="2" verticalCenter="0"
								click="showDoctorsAddress(event)" toolTip="More Options"
								useHandCursor="true" buttonMode="true"  />
				
			</s:SkinnableContainer>
			
			<s:Label text="{model.LoggedInProvider.UserSelectedClinicBranchDTO.UserSelectedStation.label}" styleName="gazuntiteTitleSmall"/>
			
			<s:HGroup  paddingTop="0" horizontalAlign="center" verticalAlign="top" >
				<s:ToggleButton id="id_RapidAccess" 
								name="rapidAccess" 
								skinClass="com.gazuntite.skins.controls.button.RapidAccessButtonSkin" 
								click="id_RapidAccess_changeHandler(event)"
								toolTip="Rapid Access" useHandCursor="true" buttonMode="true"/>
				<s:ToggleButton id="id_Communication" 
								name="communication" 
								skinClass="com.gazuntite.skins.controls.button.CommunictionButtonSkin" 
								click="id_Communication_changeHandler(event)"
								toolTip="Communication" useHandCursor="true" buttonMode="true"/>
				<s:ToggleButton id="id_WebSearch" 
								name="webSearch" 
								skinClass="com.gazuntite.skins.controls.button.WebSearchButtonSkin" 
								click="id_WebSearch_clickHandler(event)"
								toolTip="Web Search" useHandCursor="true" buttonMode="true"/>
			</s:HGroup>
			
			<!--<s:ButtonBar id="id_tabBar"
			skinClass="com.zigron.gazuntite.skins.controls.button.bar.TopbarButtonBarSkin"
			labelField="label"
			change="id_tabBar_changeHandler()" >
			<s:dataProvider>
			<s:ArrayCollection>
			<fx:Object label="rapidAccess" />
			<fx:Object label="communication"   />
			<fx:Object label="webSearch"   />
			</s:ArrayCollection>
			</s:dataProvider>
			</s:ButtonBar>-->
		</s:VGroup>
		
		<s:HGroup  height="100%" horizontalAlign="right" gap="3" verticalAlign="top">
			<!--<s:ToggleButton id="id_ProfileBtn" click="UserImage_clickHandler(event)"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.UserThumbSkin"
							toolTip="User Profile" useHandCursor="true" buttonMode="true"
							/>-->
			<!--<s:image id="id_ProfileBtn" click="UserImage_clickHandler(event)"
					 skinClass="com.gazuntite.skins.controls.toggleButtonSkin.UserThumbSkin"
					 toolTip="User Profile" useHandCursor="true" buttonMode="true"
					 source="{AppUtils.getByteArray(model.userImageData)}" />-->
			
			<components:ImageButton id="id_ProfileBtn" click="UserImage_clickHandler(event)" height="66" width="61"
								skinClass="com.gazuntite.controls.skins.UserThumbSkin"
								toolTip="User Profile" useHandCursor="true" buttonMode="true" Source="{GetUserImage(model.userImageData)}" />
			
			<s:VGroup  horizontalAlign="left" height="100%"  width="100%" gap="15" >	
				<s:HGroup id="id_windowControlButtons" gap="2" horizontalAlign="right" paddingTop="2">
					<s:Button id="id_min" height="15" width="16" useHandCursor="true" buttonMode="true" 
							  skinClass="com.gazuntite.skins.controls.button.MiniButtonSkin" 
							  click="ChromeUtil.minimizeWindow()" toolTip="Minimize"/>
					
					<s:Button id="id_restore" height="15" width="16" skinClass="com.gazuntite.skins.controls.button.restoreButton" visible="false" includeInLayout="false"
							  click="ChromeUtil.toggleMaximizeWindow(); changeToopTip()" toolTip="Maximize" useHandCursor="true" buttonMode="true"/>					
					
					<s:Button id="id_close" height="15" width="16" skinClass="com.gazuntite.skins.controls.button.CloseButtonSkin"
							  click="id_close_clickHandler()" toolTip="Close" useHandCursor="true" buttonMode="true"/>
					
				</s:HGroup>
				
				<status:StatusIconView 	id="id_btnSignOut" click="signout_clickHandler(event)" />
			</s:VGroup>
		</s:HGroup>
		
	</s:BorderContainer>
	
</s:SkinnableContainer>
