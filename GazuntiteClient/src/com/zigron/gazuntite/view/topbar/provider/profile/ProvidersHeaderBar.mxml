<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:sf="http://www.spicefactory.org/parsley"
		 width="100%" height="45"
		 creationComplete="init(event)"
		 >
	
	<fx:Metadata>
/* 		[Event(name="moreOptionsClick", type="flash.events.MouseEvent")] */
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.services.common.model.CommunicationViewModel;
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			
			import mx.collections.IList;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			
			[Bindable]
			private var viewModel:CommunicationViewModel = CommunicationViewModel.getInstance();
			
			
			private var _dataProvider:IList;
			
			[Bindable]
			public function get dataProvider():IList
			{
				return _dataProvider;
			}
			
			public function set dataProvider(value:IList):void
			{
				_dataProvider = value;
			}

			
			protected function init(event:FlexEvent):void
			{
				//trace("sharedModel.videoOn = " + sharedModel.videoOn);
			}
			
			protected function patientOptionsButtonClicked(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
				event.stopPropagation();
				//sharedModel.patientProfileOptionsVisible = true;
			}
			
			protected function moreOption_clickHandler(event:MouseEvent):void
			{
				var moc:MouseEvent = new MouseEvent("moreOptionsClick", true, false, event.currentTarget.x, event.currentTarget.y, event.currentTarget as InteractiveObject); 
				dispatchEvent( moc );
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
	</fx:Declarations>
	
	<s:BorderContainer width="100%" height="100%" borderWeight="1" borderColor="0xb4b4b4" cornerRadius="0" dropShadowVisible="false" borderAlpha="1">
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xfcfcfc" ratio=".3"/>
				<s:GradientEntry color="0xe0e0e0" ratio=".7"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:VerticalLayout gap="0"/>
		</s:layout>
		
		<s:HGroup verticalAlign="middle" width="100%"  paddingBottom="5"  paddingTop="5"  paddingLeft="3"  paddingRight="3" >
			<s:Image source="assets/exambar/patientProfileImg.png" />
			
			<s:VGroup width="100%" height="100%" verticalAlign="middle" gap="1">
				<s:Label id="nameTxt" text="{model.SearchProviderDetailsResults.FullName.toUpperCase()}" styleName="patientNameTitle"/>
				<s:Label id="emailTxt" text="{model.SearchProviderDetailsResults.UserEmail}" styleName="patientNameSubTitle"/>
			</s:VGroup>
			<s:Rect width="100%" />
			<s:ButtonBar id="uiTab" dataProvider="{dataProvider}" labelField="id" 
					  verticalCenter="3"
					  skinClass="com.gazuntite.skins.controls.buttonBar.communication.CommunicationButtonBar"
					  >
				<s:layout>
					<s:HorizontalLayout gap="7" paddingLeft="8" />
				</s:layout>
			</s:ButtonBar>
		</s:HGroup>

	</s:BorderContainer>
	
	
</s:Group>
