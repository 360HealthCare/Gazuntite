<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:components="com.gazuntite.controls.extended.components.*"
					   xmlns:provider="com.zigron.gazuntite.view.topbar.provider.*"
					   creationComplete="cc(event)" xmlns:status="com.zigron.gazuntite.view.topbar.provider.status.*" 
					   
					   >
	
	<fx:Metadata>
		[Event(name="signOut", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			
			
			protected function cc(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if( isPopUp )
					{
						var e:Event = new Event('closePopup', true);
						dispatchEvent( e);
						//removePopup();
					}
				});
			}
			
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	
	<s:SkinnableContainer width="100%" height="100%" skinClass="com.gazuntite.skins.controls.container.ActionBarSkin" >
		<s:layout>
			<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" gap="4"/>
		</s:layout>
		
		<status:StatusView id="id_StatusView" width="100%" height="100%"  />
		
	</s:SkinnableContainer>
		
</components:PopupGroup>
