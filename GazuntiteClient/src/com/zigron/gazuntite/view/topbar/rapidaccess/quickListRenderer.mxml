<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				buttonMode="true" useHandCursor="true"
				>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.utils.UtilityFunctions;
			import com.zigron.gazuntite.model.valueObjects.rapidAccess.QuickLinkDTO;
			
			import mx.events.FlexEvent;
			
			[Bindable]	public var dto:QuickLinkDTO;
			
			
			override public function set data(value:Object):void
			{
				super.data = value;
				dto = value as QuickLinkDTO;
				
				if (value == null || null == dto) 
					return;
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="hovered"/>
	</s:states>  
	
	<s:layout>
		<s:VerticalLayout gap="0" horizontalAlign="left" verticalAlign="top"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="40" 
						  skinClass.normal="com.gazuntite.skins.controls.list.ListNormalItemSkin" 
						  skinClass.hovered="com.gazuntite.skins.controls.list.ListHoverItemSkin" 
						  toolTip="{dto.label}" >
		<s:HGroup width="100%" height="100%" horizontalAlign="left" layoutDirection="ltr" verticalAlign="middle"
				  paddingLeft="5" paddingRight="5" paddingBottom="5" paddingTop="3">
			<s:Image source="{UtilityFunctions.getByteArray(dto.icon)}"  width="30"/>
			<s:VGroup width="100%" height="100%" verticalAlign="middle" gap="2">
				<s:Label text="{dto.label}" width="100%" color="0xFFFFFF" fontFamily="CalibriCFFBold" fontSize="14" showTruncationTip="true"/>
				<s:Label text="{dto.description}" width="100%" color="0xFFFFFF"  fontFamily="CalibriCFF" fontSize="13" showTruncationTip="true"/>
			</s:VGroup>
		</s:HGroup>
	</s:SkinnableContainer>
	<!--<s:Line width="100%">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line>-->
</s:ItemRenderer>