<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="group1_creationCompleteHandler(event)">
	
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			private var _URL:String = '';

			[Bindable]
			public function get URL():String
			{
				return _URL;
			}

			public function set URL(value:String):void
			{
				_URL = value;
				
				if(null != value)
					id_htmlArea.location = value;
			}

			protected function id_htmlArea_completeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				
				id_htmlArea.htmlLoader.navigateInSystemBrowser = false;
				
				id_htmlArea.addEventListener(Event.COMPLETE, completeHandler);
			}
			
			protected function completeHandler(event:Event):void 
			{
				 if(null != id_htmlArea.htmlLoader.window.document.getElementById("btnDisconnect"))
					id_htmlArea.htmlLoader.window.document.getElementById("btnDisconnect").onclick = clickHandler;
				
			}
			
			protected function clickHandler(object:*):void 
			{
				trace("Call disconnected!");
				
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<mx:HTML id="id_htmlArea"
			 height="100%" width="100%" complete="id_htmlArea_completeHandler(event)"
			 verticalScrollBarStyleName="htmlVScroll" horizontalScrollPolicy="off" />
</s:Group>
