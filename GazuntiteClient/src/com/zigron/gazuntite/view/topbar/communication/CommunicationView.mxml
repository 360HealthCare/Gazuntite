			private function onChattingEvent(event:Event):void
			{
				switch( event.type )
				{
					case "startChatting":
						id_CommunicationTabs.selectedIndex = id_CommunicationViews.length - 1 ;
						break;
					case "stopChatting":
						id_MainTabs.selectedIndex = 0;
						break;
				}
			}
			
			private function SendCallInvite (e:Event):void
			{
				StartVideoChat(e.target.provider.UserEmail);
			}
			
			private function StartVideoChat(UserEmail:String):void
			{
				var j:int;
				for(j = 0; j < neighborhood.length; j++ )
				{
					var selectedUser:Object = neighborhood.getItemAt( j );
					if( selectedUser.name == UserEmail )
					{
						if( CanStartVideoChat() )
						{
							
							id_MainTabs.selectedIndex = 1; 
							callLater(function():void{
								
								id_CommunicationTabs.selectedIndex = id_CommunicationViews.length - 1; //last child should be Video Chat component
								
							});
							
							chatManager.sendChatNotification( VideoChatEvent.INVITE, selectedUser );
						}
						break;
					}
				}
			}
			
