			protected function close_clickHandler(event:MouseEvent):void
			{
				var lc:Event = new Event( "close", true, false );
				dispatchEvent( lc );
			}
			
			protected function max_clickHandler(event:MouseEvent):void
			{
				PatientViewModel.getInstance().closeAllTabs();
			}
			
			protected function onRemovedFromStageHandler(event:Event):void
			{
				if( false == opentokManager.isAvailable && model.LoggedInUserSessionDTO.Status != ProviderStatusDTO.BUSY )
				{
					var h:Number = Video.height; 
					var w:Number = Video.width; 
					
					if( null != Video && id_CommunicationViews.contains(Video) )
						id_CommunicationViews.removeElement( Video );
					
					Video.ShowPopup( FlexGlobals.topLevelApplication as DisplayObject);
					
					
					var loc:Point = localToGlobal( new Point( width + x, y ) );
					
					_videoSlideoutRef = Video;
					
					
					_videoSlideoutRef.width 	= 465;
					_videoSlideoutRef.height 	= 410;
					
					Video.move( loc.x + 2, loc.y + 50 );
					
					/* _videoSlideoutRef.addEventListener('VideoCallEnded' ,CallEnded);
					_videoSlideoutRef.addEventListener('PatientChatEnd' ,patientChatEnded); */
					
					_videoSlideoutRef.addEventListener( VideoChatControlEvent.END_VIDEO_CHAT, function(event:Event ):void
					{
						_videoSlideoutRef.removePopup();
						_videoSlideoutRef = null;
					});
				}
				else
				{
					opentokManager.VideoChat_URL = '';
					_videoSlideoutRef = null;
				}
				
				if(null != AssoicationPopUP && AssoicationPopUP.isPopUp)
					AssoicationPopUP.removePopup();
				
			}
			
			protected function CheckAndSetVideoIsSlideout():void
			{
				if(null != id_CommunicationTabs && null != _videoSlideoutRef && _videoSlideoutRef.isPopUp )
				{
					id_MainTabs.selectedIndex = id_MainTabs.length - 1 ;
					callLater( function():void
					{
						//id_CommunicationTabs.removeElement( Video );
						_videoSlideoutRef.removePopup();
						
						id_CommunicationTabs.selectedIndex = id_CommunicationViews.length - 1 ;
						Video = _videoSlideoutRef;
						id_CommunicationViews.addElement( Video );
						Video.move(0, 0);
						Video.percentWidth 	= 100;
						Video.percentHeight = 100;
					});
					
				}
			}
			
			protected function searchproviderview1_creationCompleteHandler(event:FlexEvent):void
			{
				var psEvent:SearchProviderEvent =new SearchProviderEvent('',getProviderList);
				CairngormEventDispatcher.getInstance().dispatchEvent(psEvent);
				event.stopImmediatePropagation();
				
				//id_SearchProviderView.id_ProviderSearchResultView.id_providerSearchTextInput.setFocus();
			}
			
			private function SendVideoCall_callBack(dto:VideoChatDTO):void
			{
				opentokManager.model.isCallfromProvider = true;
				opentokManager.SetCallInfo( dto.OpenTokSessionID, dto.OpenTokTokenID, videoChatDTO.CallInitiatorName, videoChatDTO.CallRecieverName );
				
				callLater(function():void{ 
					
					id_CommunicationTabs.selectedIndex = id_CommunicationViews.length - 1; //last child should be Video Chat component
					
				});
				id_MainTabs.selectedIndex = 1;
			}
			
			private function getProviderList(value:* = null):void
			{
				//trace(value);
				
			}
			
			protected function searchproviderview1_LoadClinicUserDetailsEventHandler(event:ListVieClickEvent):void
			{
				
				Heading="Profile";
				if(event.userId > 0)
					userID = event.userId;
				providerAvaliable = event.isAvaliable;
				
				if(null != event.providerName)
					providerName = event.providerName;
				
				clinicBranchID = event.branchId.toString();
				
				LoadSMS_EMAIL();
				
				var clinicuserIDevent:GetClinicUserDetailsByIDEvent  = new GetClinicUserDetailsByIDEvent(event.userId,event.branchId, false, getProviderList);
				CairngormEventDispatcher.getInstance().dispatchEvent(clinicuserIDevent);
			}
			
			
			protected function id_CommunicationTabs_changeHandler(event:IndexChangeEvent):void
			{
				trace (event.newIndex);
			}
			
			protected function uiTab_clickHandler(event:MouseEvent):void
			{
				if(null != id_CommunicationTabs && id_CommunicationTabs.selectedIndex == 4)
				{
					var dto : providerdto = id_SearchProviderView.id_ProviderSearchResultList.id_SearchList.selectedItem; 
					if(null != dto)
					{
						if(dto.userSessionStatusID == QSConstants.SESSION_STATUS_ONLINE)
						{
							var startChatEvent:StartChatWithProviderEvent = new StartChatWithProviderEvent(StartChatWithProviderEvent.SEND_CALL,true);
							
							startChatEvent.providerID = dto.UserId;
							startChatEvent.providerName = dto.ProviderCompleteName;
							startChatEvent.SessionStatusID = dto.userSessionStatusID;
							
							dispatchEvent(startChatEvent);
						}
							
						else
						{
							UserUnavaliableForCall();
						}
					}
					else
					{
						Alert.show("Please select a provider to call.", "Provider not Selected", Alert.OK, this);
					}
					
				}
				
			}
			
			protected function UserUnavaliableForCall(event:* = null):void
			{
				
				Alert.show("Provider is not available for video call, please try later.", "Unavaliable", Alert.OK, this, function( event:CloseEvent):void
				{
					id_CommunicationTabs.selectedIndex = 0;
				});
			}
			protected function id_MainTabs_clickHandler(event:MouseEvent):void
			{
				
			}
			
			protected function id_MainTabs_changeHandler(event:IndexChangeEvent):void
			{
				switch( event.newIndex )
				{
					case 0 :
						comViewModel.communicationViewSectionName = "PROFILE";
						break;
					case 1 :
						comViewModel.communicationViewSectionName = "COMMUNICATION";
						LoadSMS_EMAIL();
						break;
				}
			}
			
			public function SelectVideoTab():void
			{
				id_MainTabs.selectedIndex = 1;
				callLater(function():void{
					
					callLater(function():void{ 
						id_CommunicationTabs.selectedIndex = id_CommunicationViews.length - 1;
					});
				});
			}
			
			public function LoadSMS_EMAIL():void
			{
				if(id_MainTabs.selectedIndex == 1)
				{
					id_smsView.LoadSMS();
					id_ComView.loadMailData();
				}
			}
			
		]]>
	</fx:Script>
	
