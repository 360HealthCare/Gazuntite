				//Alert.show("Call with "+opentokModel.CallerName+" ended.","Call Ended");
				if(null != _videoSlideoutRef && _videoSlideoutRef.isPopUp)
					_videoSlideoutRef.removePopup();
				//dispatchEvent(new Event('VideoCallEnded',true));
			}
			
			
			public function hasValidValue():Boolean
			{
				if( vitalsDTO.Note.length > 3 )
				{
					return true;
				}
				else if(vitalsDTO.Note.length > 0 && vitalsDTO.Note.length < 4)
				{
					Alert.show(" Notes should be more than 3 characters long.","Required!", 4, FlexGlobals.topLevelApplication.mainContainer);
					
					return false;
				}
				else
				{
					if( vitalsDTO.Temperature.length > 0 ||            
						vitalsDTO.Pulse.length > 0 ||                  
						vitalsDTO.Respiration.length > 0 ||           
						vitalsDTO.BPSys.length > 0 ||                 
						vitalsDTO.BPDys.length > 0 ||                  
						vitalsDTO.sugarLevel.length > 0 )
					{
						return true;
					} 
					
/*					Old Implementation
					
 					if( vitalsDTO.Weight.length > 0 ||                 
						vitalsDTO.Height.length > 0 ||                 
						vitalsDTO.Temperature.length > 0 ||            
						vitalsDTO.Pulse.length > 0 ||                  
						vitalsDTO.Respiration.length > 0 ||           
						vitalsDTO.BPSys.length > 0 ||                 
						vitalsDTO.BPDys.length > 0 ||                  
						vitalsDTO.Oxygen.length > 0 ||                 
						vitalsDTO.sugarLevel.length > 0 )
					{
						return true;
					}               */
				}
				
				Alert.show("Please write notes or give vitals to save the Virtual Encounter.","Required!", 4, FlexGlobals.topLevelApplication.mainContainer);
				
				return false;
			}
			
			private function AssoicateVideoRecord():void
			{
				AssoicationPopUP = new ComPatientVitalsView();
				AssoicationPopUP.vitalDTO = vitalsDTO;
				AssoicationPopUP.patientName = opentokModel.CallerName;
				AssoicationPopUP.patientDOB = "Patient DOB";
				AssoicationPopUP.patientAge = "Patient Age";
				AssoicationPopUP.width 	= id_Main.width - 17;
				AssoicationPopUP.height = 170;
				AssoicationPopUP.ShowPopup(this);
				
				var pt:Point = Video.parent.localToGlobal(new Point(Video.x, Video.y));
				AssoicationPopUP.move( pt.x+2 , pt.y+2 ); 
				
				AssoicationPopUP.addEventListener(SaveVitalsEvent.SAVE_VITAL_EVENT, function (e:SaveVitalsEvent):void
				{
					vitalsDTO = e.vitalsDTO;
					SavePatientVitals();
				});
				
				AssoicationPopUP.addEventListener("cancel", function (event:Event):void
				{
					AssoicationPopUP.removePopup();
					id_MainTabs.selectedIndex = 0;
					id_CommunicationTabs.selectedIndex = 0;
				});
				
				
				if(null != _videoSlideoutRef && _videoSlideoutRef.isPopUp)
					_videoSlideoutRef.removePopup();
				
			}
			
			private var savedEncounterVisitID:int = 0;
			private function SavePatientVitals():void
			{
				savedEncounterVisitID = 0;
				var getstaticlists: CreateVisitCommonEvent = new CreateVisitCommonEvent(opentokModel.CallerID, function(response:XML):void
				{
					
					if(response == "0")
					{
						UtilityFunctions.ShowMessage("unable to create virtual visit",'Alert',function(event:Event = null):void
						{
							
						});
						
						return ;
					}
					else
					{
						savedEncounterVisitID 	= parseInt(response);					
						vitalsDTO.VisitID 		= parseInt(response);					
						vitalsDTO.VisitDate 	= new Date();
						vitalsDTO.CreatedBy		= model.LoggedInUserDTO.UserId;
						vitalsDTO.CreatedAt 	= new Date();
						vitalsDTO.Editable 		= 'true';
						vitalsDTO.ModifiedBy 	= model.LoggedInUserDTO.UserId;
						vitalsDTO.PatientID  	= parseInt(opentokModel.CallerID);
						vitalsDTO.IsDirty		= true;
						
						var cge:ManagePatientVitalEvent = new ManagePatientVitalEvent( vitalsDTO, model.LoggedInUserDTO.UserId, vitalsDTO.VisitID, model.LoggedInUserSessionDTO.SessionID ,ManageVitalsCallBack);
						CairngormEventDispatcher.getInstance().dispatchEvent( cge );
						
					} 
					
				});	
				
				if( hasValidValue() ) //if there are Notes or other details in vital  
				{
					getstaticlists.data = createVisitXML(); 				
					CairngormEventDispatcher.getInstance().dispatchEvent(getstaticlists);    
				}
			}
			
			public function onSuccessfullVisitSave():void
			{
				if( vitalsDTO.Note.length > 3 )
				{
					var notesDTO:ModuleNoteDTO =  new ModuleNoteDTO();
					notesDTO.ModuleNoteId = 0
					
					notesDTO.NoteSubject = "Vertual Visit Note";
					notesDTO.Note = vitalsDTO.Note;
					notesDTO.ManagedByUserId = model.LoggedInUserDTO.UserId;
					notesDTO.CreatedBy = model.LoggedInUserDTO.UserId
					notesDTO.CreatedAt = new Date();
					notesDTO.ModuleTypeId = 28 //QIUtilityFunctions.getModuleIDByName(Constants.QUICK_INPUT_MODULE_NAME);
					notesDTO.VisitID = savedEncounterVisitID;
					notesDTO.PatientID = parseInt(opentokModel.CallerID);
					notesDTO.IsNewAdded = true;	
					
					var mne:ManageModuleNotesEvent = new ManageModuleNotesEvent(notesDTO, "",model.LoggedInUserDTO.UserId,model.LoggedInUserSessionDTO.SessionID);
					CairngormEventDispatcher.getInstance().dispatchEvent(mne);
				}
				
				AssoicationPopUP.CleanVitals();
				AssoicationPopUP.removePopup();
				id_MainTabs.selectedIndex = 0;
				id_CommunicationTabs.selectedIndex = 0;
				id_CommunicationTabs.setFocus();
				vitalsDTO = new VitalsDTO();
			}
			
			public function ManageVitalsCallBack(saved:Boolean):void
			{
				if(saved)
				{
					var mvdEv:MarkValidDataExistsEvent = new MarkValidDataExistsEvent(model.LoggedInUserDTO.UserId,10 ,11,model.LoggedInUserSessionDTO.SessionID, vitalsDTO.VisitID ,vitalsDTO.VisitDate.toString());
					mvdEv.functionName = onSuccessfullVisitSave;
					CairngormEventDispatcher.getInstance().dispatchEvent(mvdEv);
				}
				else
				{
					Alert.show('Unable to save Vitals please Try again','UnSuccessfull',4,this);
				}
			}
			
