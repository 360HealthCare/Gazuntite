			public function set neighborhood(value:ArrayCollection):void
			{
				if( _neighborhood && _neighborhood.length )
				{
					_neighborhood.removeEventListener(CollectionEvent.COLLECTION_CHANGE, onCollectionChange );
				}
				
				if( value && value.length )
				{
					_neighborhood = value;
					_neighborhood.addEventListener(CollectionEvent.COLLECTION_CHANGE, onCollectionChange );
				}
			}
			
			protected function init(event:FlexEvent):void
			{
				addEventListener( "startVideoChat", SendCallInvite);
				
				BindingUtils.bindProperty( this, "neighborhood", chatManager.videoChat, "neighbors" );
				
				callLater(onCollectionChange, [null] ); // update user list for video chat 
				callLater(CheckAndSetVideoIsSlideout); // checks if video chat was in slide out 
				
				chatManager.addEventListener("stopChatting", onChattingEvent );
				chatManager.addEventListener("startChatting", onChattingEvent );
				
				id_chatComponent.addEventListener('VideoCallEnded' ,CallEnded);
				id_chatComponent.addEventListener(PatientVideoChatEndEvent.PATIENT_CHAT_END ,patientChatEnded);
				
				addEventListener("UserUnavaliable_for_call",UserUnavaliableForCall);
				
				addEventListener(StartChatWithProviderEvent.SEND_CALL, function(event:StartChatWithProviderEvent):void
				{
					SendCallToProvider(event);
				});
			}
			private var videoChatDTO:VideoChatDTO;
			private function SendCallToProvider(event:StartChatWithProviderEvent):void
			{
				videoChatDTO 	= new VideoChatDTO();
				videoChatDTO.CallInitiatorID 	= model.LoggedInUserDTO.UserId;
				videoChatDTO.CallInitiatorName 	= model.LoggedInUserDTO.FullName;
				videoChatDTO.ClinicBranchID	 	= model.LoggedInUserSessionDTO.ClinicBranchID;
				videoChatDTO.CallRecieverID 		= event.providerID;
				videoChatDTO.CallRecieverName	= event.providerName;
				videoChatDTO.isProvider			= true;
				
				opentokModel.CallerName =  event.providerName;
				
				var cge:SendVideoCallToProviderEvent = new SendVideoCallToProviderEvent( videoChatDTO, SendVideoCall_callBack );
				CairngormEventDispatcher.getInstance().dispatchEvent( cge );
				
				opentokManager.isAvailable = false;
				opentokManager.model.isCallfromProvider = true;
			}
			
			private function patientChatEnded(event:PatientVideoChatEndEvent):void
			{
				vitalsDTO = event.vitals;
				
				Alert.show("Do you want to associate this conference with patient's record?", "Are you sure?", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function( event:CloseEvent):void
				{
					if( event.detail == Alert.YES )
					{
						AssoicateVideoRecord();
					}
					else if( event.detail == Alert.NO)
					{
						CallEnded();
					}
				});
				
				//UtilityFunctions.AskMessage("Do you want to associate this conference with patient's record?" ,AssoicateVideoRecord,null,CallEnded,null);
			}
			private function CallEnded(event:Event = null):void
			{
				
				id_MainTabs.selectedIndex = 0;
				id_CommunicationTabs.selectedIndex = 0;
