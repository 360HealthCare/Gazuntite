<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				   xmlns:s="library://ns.adobe.com/flex/spark" 
				   xmlns:mx="library://ns.adobe.com/flex/mx" 
				   xmlns:sf="http://www.spicefactory.org/parsley"
				   width="100%" height="100%"
				   backgroundColor="0x000000"
				   creationComplete="init(event)" 
				   xmlns:controls="com.gazuntite.view.controls.*">
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.PatientViewModel;
			import com.gazuntite.utils.UtilityFunctions;
			import com.zigron.gazuntite.logging.LoggingUtil;
			import com.zigron.gazuntite.model.ApplicationModel;
			
			import mx.events.FlexEvent;
			import mx.logging.ILogger;
			
			private var logger : ILogger = LoggingUtil.getLogger( this );
			
			[Bindable]
			private var model : ApplicationModel = ApplicationModel.getInstance();
			
			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function Close_clickHandler(event:MouseEvent):void
			{
				var lc:Event = new Event( "close", true, false );
				dispatchEvent( lc );
			}
			
			protected function max_clickHandler(event:MouseEvent):void
			{
				PatientViewModel.getInstance().closeAllTabs();
			}
			
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout verticalAlign="middle" horizontalAlign="center"/>
	</s:layout>
	<s:BorderContainer width="100%" height="100%" borderVisible="false"
					   backgroundColor="0x000000" bottom="5" top="5" right="5" left="5" cornerRadius="4">
		<s:layout>
			<s:VerticalLayout verticalAlign="middle" horizontalAlign="center"/>
		</s:layout>
		
		<s:BorderContainer width="100%" height="30" borderWeight="0" skinClass="com.gazuntite.skins.controls.container.WebPanelBodySkin" dropShadowVisible="true" borderAlpha="0">
			
			<s:backgroundFill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry color="0xdadada" ratio=".1"/>
					<s:GradientEntry color="0xbfbfbf" ratio=".9"/>
				</s:LinearGradient>
			</s:backgroundFill>
			
			<s:layout>
				<s:HorizontalLayout verticalAlign="middle" horizontalAlign="center"	paddingLeft="3" paddingRight="3" gap="0"/>
			</s:layout>
			
			<s:HGroup width="100%" gap="1" horizontalAlign="left" verticalAlign="middle">
				<s:Button skinClass="com.gazuntite.skins.controls.button.WebSearch.BrowserLeftArrowButtonSkin" toolTip="Previous" useHandCursor="true" buttonMode="true"/>
				<s:Button skinClass="com.gazuntite.skins.controls.button.WebSearch.BrowserRightArrowButtonSkin" toolTip="Next" useHandCursor="true" buttonMode="true"/>
				<!--<s:Button label="{UtilityFunctions.TitleCase('Gazuntite')}"  />-->
				<s:Spacer width="10"/>
				<s:Label text="GAZUNTITE" fontFamily="CalibriCFF" fontSize="14"/>
				<s:Spacer width="100%"/>
				<!--<s:Button width="19" 
						  click="max_clickHandler(event)"
						  skinClass="com.gazuntite.skins.controls.button.restoreButton" 
						  buttonMode="true" useHandCursor="true"
						  toolTip="Maximize"
						  />-->
				<s:Button label="Close" toolTip="Close" skinClass="com.gazuntite.skins.controls.button.blackCloseButtonSkin" useHandCursor="true" buttonMode="true" id="Close"
						  click="Close_clickHandler(event)"/>
			</s:HGroup> 
			
		</s:BorderContainer>
		
		<mx:HTML id="htmlBrowser" location="http://www.gazuntite.com:9001" width="100%" height="97%" minHeight="0"  />
	</s:BorderContainer>
	
	
</s:SkinnableContainer>