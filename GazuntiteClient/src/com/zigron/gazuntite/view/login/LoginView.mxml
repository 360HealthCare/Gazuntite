			protected function txt_enterHandler(event:FlexEvent):void
			{
				login();
			}
			
			protected function resetPassword():void
			{
				ValidationUtils.Trim(id_resetEmail);
				if(id_resetEmail.text == "")
				{
					id_errors.visible 			= true;
					id_errors.includeInLayout 	= true;
					id_errorMsg.label 			= "Please enter email";
					return;
				}
				
				if( ! isValidEmailToResetPassord)
				{
					id_errors.visible 			= true;
					id_errors.includeInLayout 	= true;
					id_errorMsg.label 			= "Email Does Not Exist";
					return;
				}
				
				id_errors.visible 			= false;
				id_errors.includeInLayout 	= false;
				
				var cgEvent : ResetPasswordEvent = new  ResetPasswordEvent( id_resetEmail.text, resetPasswordResponse);
				CairngormEventDispatcher.getInstance().dispatchEvent( cgEvent );
				cursorManager.setBusyCursor();
				model.connectedUserName = id_resetEmail.text;
				
			}
			
			protected function resetPasswordResponse(val:*=null):void
			{
				CursorManager.removeBusyCursor();
				if(model.resetPasswordResult == "true")
				{
					//id_resetEmail.enabled = false
					//submitBtn.enabled = false;
					id_resetEmail.visible = false;
					id_resetEmail.includeInLayout = false;
					submitBtn.visible = false;
					submitBtn.includeInLayout = false;					
					currentState = 'resetPassword' ;
					goBackBtn.label = "Go to Login";
				}
				else 
					invalidEmail();
			}
			
			private function invalidEmail():void
			{
				id_errors.visible 			     = true;
				id_errors.includeInLayout 	     = true;
				
				if(model.resetPasswordErrorMessageResult.length>0)
				{
					id_errorMsg.label = model.resetPasswordErrorMessageResult.replace("Login does't exsist","Email Does Not Exist");
					return;
				}
				
				if(model.resetPasswordIsActiveResult=='false' && model.resetPasswordIsValidResult=='true')
				{
					id_errorMsg.label 			     = "Inactive User";
				}
				else if (model.resetPasswordIsLockedResult=='true' && model.resetPasswordIsValidResult=='true')
				{
					id_errorMsg.label 			     = "Locked User";
				}
				else
				{
					id_errorMsg.label 			     = "Invalid Email ID";
				}
				
			}
			
			protected function id_forgotPass_clickHandler(event:MouseEvent):void	
			{
				id_errors.visible 			     = false;
				id_errors.includeInLayout 	     = false; 
				if(id_resetEmail)
				{
					//id_resetEmail.enabled 			 = true;
					id_resetEmail.visible = true;
					id_resetEmail.includeInLayout = true;
					submitBtn.visible = true;
					submitBtn.includeInLayout = true;					
				}
				//if(submitBtn)
				//submitBtn.enabled 				 = true;
				currentState                     ='forgetPassword';
				goBackBtn.label = "Go Back";
				
			}
			
			protected function group2_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER)
					resetPassword(); 
			}
			
			protected function goBackBtn_clickHandler(event:MouseEvent):void
			{
				currentState                     ='default';
				id_errors.visible 			     = false;
				id_errors.includeInLayout 	     = false;
				
			}
			
			private var isValidEmailToResetPassord:Boolean = false;
			
			protected function cc(event:FlexEvent):void
			{
				//var snow:SnowDisplay = new SnowDisplay(this.width, this.height);
