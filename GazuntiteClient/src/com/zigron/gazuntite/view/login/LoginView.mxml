	<fx:Declarations>
		<mx:StringValidator id="vUsername" property="text" required="true"
							requiredFieldError="Provider ID is required" source="{ userNameTxt }"/>
		<mx:StringValidator id="vPassword" property="text" required="true" 
							requiredFieldError="Password is required" source="{ passwordTxt }"/>
		
		<mx:EmailValidator  source="{id_resetEmail}" property="text"
							missingAtSignError="The @ sign is missing in your email address"
							valid="isValidEmailToResetPassord = true"
							invalid="isValidEmailToResetPassord = false"
							required="false" />
		
		<s:GlowFilter id="glowFilter" blurX="8" blurY="8" color="#ff6600"/>
		<fx:Vector id="motionPathVector" type="spark.effects.animation.MotionPath">
			<s:SimpleMotionPath id="blurXPath" property="blurX" valueFrom="0" valueTo="11"/>
			<s:SimpleMotionPath id="blurYPath" property="blurY" valueFrom="0" valueTo="11"/>
		</fx:Vector>
	</fx:Declarations>
	
	<s:layout>
		<s:HorizontalLayout horizontalAlign="center" verticalAlign="top"/>
	</s:layout>
	
	<s:SpriteVisualElement id="spv" />
	
	<s:Group width="100%" height="100%">
		<s:layout>
			<s:VerticalLayout horizontalAlign="center" verticalAlign="top" />
		</s:layout>
		
		<s:HGroup id="id_windowControlButtons" gap="2" width="100%" horizontalAlign="right" paddingTop="3" paddingRight="5">
			<s:Button id="id_min" 
					  height="15" width="16" useHandCursor="true" buttonMode="true" 
					  skinClass="com.gazuntite.skins.controls.button.MiniButtonSkin" 
					  click="ChromeUtil.minimizeWindow()" toolTip="Minimize"/>
			<s:Button id="id_restore"
					  height="15" width="16" skinClass="com.gazuntite.skins.controls.button.restoreButton" visible="false" includeInLayout="false"
					  click="ChromeUtil.toggleMaximizeWindow(); changeToopTip()" toolTip="Maximize" useHandCursor="true" buttonMode="true"/>					
			<s:Button id="id_close" 
					  height="15" width="16" skinClass="com.gazuntite.skins.controls.button.CloseButtonSkin"
					  click="id_close_clickHandler()" toolTip="Close" useHandCursor="true" buttonMode="true"/>
		</s:HGroup>
		
		<s:Spacer height="40%"/>
		<s:Image source="{UtilityFunctions.getByteArray(GazuntiteAssetsUtility.LOGIN_LOGO_B4STR)}" />
		<s:Spacer height="20%"/>
		
		<s:SkinnableContainer skinClass="com.gazuntite.skins.LoginBlueBGSkin" 
							  verticalCenter="0" horizontalCenter="0" width="344" height="265">
			<s:layout>
				<s:VerticalLayout horizontalAlign="center"  verticalAlign="middle" gap="25"/>
			</s:layout>
			
			<s:SkinnableContainer id="invalidGroup" 
								  visible="false" includeInLayout="false" width="70%" height="40"
								  skinClass="com.gazuntite.skins.InvalidProviderIDSkin">
				<s:layout>
					<s:HorizontalLayout paddingLeft="10" paddingRight="10" horizontalAlign="left" verticalAlign="middle"/>
				</s:layout>
				<s:Image source="assets/redX.png" />
				<s:Label text="Invalid ProviderID" styleName="loginFormInvalidProviderID" width="100%"/>
				<s:RichEditableText id="richTxt" editable="false" focusEnabled="false">
					<s:textFlow>
						<s:TextFlow>
							<s:p>
								<s:a href="#">
									<s:span color="0xffffff" fontSize="12">Forgot Password</s:span>
								</s:a>
							</s:p>
						</s:TextFlow>
					</s:textFlow>
				</s:RichEditableText>
			</s:SkinnableContainer>
			
			<!--//////////////////////////////////////////////////////////-->
			<s:SkinnableContainer id="id_errors" 
								  visible="false" width="100%" includeInLayout="{id_errors.visible}" excludeFrom="resetPassword"  >
				<s:layout>
					<s:HorizontalLayout paddingLeft="10" paddingRight="10" verticalAlign="middle"/>
				</s:layout>
				<s:Button id="id_errorMsg" width="100%" skinClass="com.gazuntite.skins.controls.container.InvalidMesageButtonSkin" />
			</s:SkinnableContainer>
			<!--//////////////////////////////////////////////////////////-->
			
			
			<s:VGroup horizontalAlign="left" verticalAlign="top" gap="10" width="296">
				<s:RichText id="id_forgotPwdLabel" fontFamily="CalibriCFF" fontSize="15" includeIn="forgetPassword,resetPassword"	text="Forgot Password?"
							text.resetPassword="Check Your Email" width="100%"/>
				<s:RichText fontFamily="CalibriCFF" fontSize="12" includeIn="forgetPassword,resetPassword" width="100%"
							text.forgetPassword="To get the new password, please enter your email" maxDisplayedLines="1"
							text.resetPassword="We sent you an email with a new password." />
				
				<s:TextInput id="id_resetEmail" 
							 width="100%"  height="28" 
							 includeIn="forgetPassword,resetPassword" 	
							 prompt="Please type your email here" toolTip="Email"
							 skinClass="com.gazuntite.skins.controls.textInput.AllTextInputSkin" 
							 />
				
				<s:RichText color="#333333" fontFamily="CalibriCFF" fontSize="17" tabStops="S0 S50" text="User Name" includeIn="default"/>
				<s:TextInput id="userNameTxt"
							 width="100%"
							 height="28" includeIn="default"
							 text="" 
							 textAlign="left"
							 prompt="User Name" toolTip="User Name"
							 enter="txt_enterHandler(event)"
							 skinClass="com.gazuntite.skins.controls.textInput.loginTI" 
							 />
			</s:VGroup>
			
			<s:VGroup id="id_view2" gap="10" horizontalAlign="left" verticalAlign="top">
				<s:Group width="100%">
					<s:RichText color="#333333" fontFamily="CalibriCFF" fontSize="17" tabStops="S0 S50" text="Password" left="0" includeIn="default"/>
					<s:Label id="id_forgotPass" 
							 click="id_forgotPass_clickHandler(event)" 
							 right="0" bottom="0" useHandCursor="true" buttonMode="true"
							 color="blue" fontSize="13" text="Problems Signing in?" includeIn="default" toolTip="Problems Signing in?" fontFamily="CalibriCFF"/>
				</s:Group>
				
				<s:TextInput id="passwordTxt"
							 width="100%" 
							 height="28" includeIn="default"
							 text=""
							 displayAsPassword="true" textAlign="left"
							 prompt="Password" toolTip="Password"
							 skinClass="com.gazuntite.skins.controls.textInput.loginTI"
							 enter="txt_enterHandler(event)"
							 />	
			</s:VGroup>
			
			<s:Group width="296">
				<s:HGroup width="100%" horizontalAlign="center">
					<s:Button id="goBackBtn" includeIn="forgetPassword,resetPassword" 
							  label="Go Back" buttonMode="true"
							  click="goBackBtn_clickHandler(event)"
							  skinClass="com.gazuntite.skins.controls.button.SignInButtonSkin"
							  toolTip="Go back to Log In page"
							  width="90"/>
					<s:Button id="submitBtn"
							  buttonMode="true" click="resetPassword()"
							  label="Submit" toolTip="Submit Provider ID" includeIn="forgetPassword,resetPassword"
							  skinClass="com.gazuntite.skins.controls.button.SignInButtonSkin"
							  useHandCursor="true"  width="90" />					
				</s:HGroup>
				<s:Button label="Sign In"
						  width="100" left="0"
						  useHandCursor="true" buttonMode="true" toolTip="Sign In"
						  click="login()" includeIn="default"
						  skinClass="com.gazuntite.skins.controls.button.SignInButtonSkin"
						  /><!--click="loginClickHandler(event)"-->		
				<s:RichText color="#000000" fontFamily="CalibriCFF" fontSize="15" tabStops="S0"
							text="Or" whiteSpaceCollapse="preserve" includeIn="default"
							x="170" verticalCenter="0"/>
				<s:Button id="id_registerProvider" right="0" label="Register yourself"
						  buttonMode="true" includeIn="default"
						  skinClass="com.gazuntite.skins.controls.button.LinkButtonSkin"
						  toolTip="Register yourself" useHandCursor="true"
						  verticalCenter="0"/>
			</s:Group>
			
		</s:SkinnableContainer>
		
		<s:Spacer height="100%"/>
		
		<s:RichText color="#5D5D5D" fontFamily="CalibriCFF" fontSize="14" tabStops="S0 S50" text="Gazuntite {model.AppVersion}" />
		<s:RichText color="#5D5D5D" fontFamily="CalibriCFF" fontSize="13" tabStops="S0 S50 S100 S150 S200 S250 S300 S350" text="Copyrights 2011-2013 Gazuntite Online Clinic LLC. All Rights Reserved." whiteSpaceCollapse="preserve" paddingBottom="10"/>
		
	</s:Group>
	
</s:BorderContainer>