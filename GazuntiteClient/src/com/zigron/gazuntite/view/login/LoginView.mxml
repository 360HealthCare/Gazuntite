			public function changeToopTip():void
			{
				if(id_restore.toolTip=='Restore')
				{
					id_restore.toolTip='Maximize';
				}
				else if(id_restore.toolTip=='Maximize')
				{
					id_restore.toolTip='Restore';
				}
			}
			
