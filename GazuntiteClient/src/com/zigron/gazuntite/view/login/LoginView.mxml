			[Bindable]	public var forgotPasswordString:String="<font color='#ffffff'><a href='#'>Forgot Password</a></font>";
			
			private function isInValid():Boolean
			{
				var InValid : Boolean = vUsername.validate().type == ValidationResultEvent.INVALID;
				InValid  = vPassword.validate().type == ValidationResultEvent.INVALID;
				return InValid;	
			}
			
			private function login() : void 
			{
				if(userNameTxt.text == "")
				{
					id_errors.visible 			= true;
					id_errors.includeInLayout 	= true;
					id_errorMsg.label 			= "Please enter username";
					return;
				}
				if(passwordTxt.text == "")
				{
					id_errors.visible 			= true;
					id_errors.includeInLayout 	= true;
					id_errorMsg.label 			= "Please enter password";
					return;
				}
				
				
				
				id_errors.visible 			= false;
				id_errors.includeInLayout 	= false;
				
				// validate the fields
				if ( isInValid()) 
				{
					return;
				}
				else 
				{
					// if everything validates, broadcast an event containing the username & password
					/* var cgEvent : LoginEvent = new LoginEvent( id_username.text, id_password.text , logInResponse);
					CairngormEventDispatcher.getInstance().dispatchEvent( cgEvent );
					return; */
					
					ValidationUtils.Trim(userNameTxt);
					ValidationUtils.Trim(passwordTxt);
					
					var request:LoginRequestDTO = new LoginRequestDTO( UtilityFunctions.TrimString( userNameTxt.text ), UtilityFunctions.TrimString( passwordTxt.text ) );
					
					var le:LoginEvent = new LoginEvent( request , logInResponse);
					
					CairngormEventDispatcher.getInstance().dispatchEvent( le );
					
					/* var cgEvent : LogInCombinedEvent = new LogInCombinedEvent( userNameTxt.text, passwordTxt.text , logInResponse);
					CairngormEventDispatcher.getInstance().dispatchEvent( cgEvent ); */
					
					//model.connectedUserName = userNameTxt.text;
				}
			}
			
			protected function logInResponse(loginApprove:Boolean):void
			{
				var e:LoginViewEvent = new LoginViewEvent(LoginViewEvent.LOGIN);
				
				if(loginApprove)
				{
					// login successful
					e.success = true;
					model.IsProviderLoggedIn = true;
					model.updateModel(model.LoggedInUserDTO);
					
				}
				else
				{
					// login failed, fire event
					e.success = false;
					id_errors.visible 			     = true;
					id_errors.includeInLayout 	     = true;
					id_errorMsg.label 			     = "Invalid User Name / Password";
				}
				
				dispatchEvent(e);
			}
			
