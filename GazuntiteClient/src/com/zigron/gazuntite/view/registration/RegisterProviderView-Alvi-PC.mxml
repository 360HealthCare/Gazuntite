			protected function id_close_clickHandler():void
			{
				var modified_views:ArrayCollection = PatientInputViewModel.getInstance().getDirtyViewList();
				if (modified_views.length>0)
				{
					var msg:String = "The following views contain unsaved data:";
					for each (var view_name:String in modified_views)
					{
						msg += "\n  "+view_name;
					}
					msg += "\nThe unsaved data will be lost. Do you want to continue?";
					AlertHelper.showContinueQuestion(confirmedClose, msg);
				}
				else
				{
					UtilityFunctions.AskMessage(  "Do you really want to exit 'Gazuntite Online Clinic'", function():void
					{
						confirmedClose();
					});
				}
			}
			protected function confirmedClose():void
			{
				//	dispatchEvent(new LogoutViewEvent(true));
				(FlexGlobals.topLevelApplication as WindowedApplication).exit();
				
				
				/* var logoutevent:LogoutEvent = new LogoutEvent(function ():void{ ChromeUtil.closeWindow(); });
				CairngormEventDispatcher.getInstance().dispatchEvent(logoutevent); */
			}
			
			public function applyMask():void
			{
				var s:String      = id_phone.text.replace(/[^0-9]/g,"");
				id_phone.text = '('+s.substring(0,3) + (s.length>3?")"+s.substring(3,6) + (s.length>6?"-"+s.substring(6,10):""):"");
				id_phone.selectRange(id_phone.text.length, id_phone.text.length);
				
				if(id_phone.text.length == 1 && id_phone.text == '(')
					id_phone	.text = '';
			}
			
