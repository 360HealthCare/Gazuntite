			{
				applyMask();
			}
			
			private var webCamPopup:RegistrationWebCamPopup = null;
			
			protected function id_snapShot_clickHandler(event:MouseEvent):void
			{
				if(webCamPopup && webCamPopup.isPopUp) return;
				
				webCamPopup = new RegistrationWebCamPopup();				
				webCamPopup.ShowPopup(this);				
				webCamPopup.getCamera();
				webCamPopup.move((this.width/2 )- 175, (this.height/2) - 150) ;
				webCamPopup.id_uploadBtn.addEventListener(MouseEvent.CLICK,snapShot);				
			}
			
			private function snapShot(event:MouseEvent):void
			{
				var jpgEncode:JPEGEncoder = new JPEGEncoder(50);
				var imageByte:ByteArray = jpgEncode.encode(webCamPopup.ImageSourceFromWebCam);
				m_oImageContentString  =  AppUtils.getBase64String(imageByte);
				id_ProviderImge.source = new Bitmap(webCamPopup.ImageSourceFromWebCam);
				webCamPopup.myvideo.attachCamera(null);
				webCamPopup.myvideo = null;
				webCamPopup.cam = null;
				webCamPopup.removePopup();
			}
			
			protected function id_deletePic_clickHandler(event:MouseEvent):void
			{
				if(id_ProviderImge.source == Constants.BLANK_PROFILE_IMAGE) return;
				
				id_ProviderImge.source = Constants.BLANK_PROFILE_IMAGE;
				m_oImageContentString = "";			
				id_imagePath.text = "";
			}		
			
			private function checkIfEmailisUnique():void
			{
				if(toSetFocus == id_email && isEmailAsyncOperationPending) 
				{
					cursorManager.setBusyCursor();
					return;
				}
				
				id_EmailValidatorWithEmailExists.isEmailExists = false;
				isEmailAsyncOperationPending = true;
				var vem:VerifyUserEmailEvent = new VerifyUserEmailEvent(id_email.text,isUniqueEmail);
				CairngormEventDispatcher.getInstance().dispatchEvent(vem);
			}
			
			private function isUniqueEmail(result:XML):void
			{
				cursorManager.removeBusyCursor();
				if(result.toString() == "false")
				{
					id_EmailValidatorWithEmailExists.isEmailExists = true;
					if(toSetFocus == id_email)
						Alert.show("Email already exists, please re-enter a valid Email.", "Registration Form Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer);
				}	
				else if(toSetFocus == id_email)
					registerBaseUser();
				
				isEmailAsyncOperationPending = false;
			}
			
			private function checkIfUserNameisUnique():void
			{
				if(toSetFocus == id_UserName && isUserNameAsyncOperationPending)
				{
					cursorManager.setBusyCursor();
					return;
				}
				
				id_UserNameValidator.isUserNameExists = false;
				isUserNameAsyncOperationPending = true;
				var vem:VerifyUserEmailEvent = new VerifyUserEmailEvent(id_UserName.text,isUniqueUserName,true);
				CairngormEventDispatcher.getInstance().dispatchEvent(vem);
			}
			
			private function isUniqueUserName(result:XML):void
			{
				cursorManager.removeBusyCursor();
				if(result.toString() == "false")
				{
					id_UserNameValidator.isUserNameExists = true;
					if(toSetFocus == id_UserName)
						Alert.show("User Name already exists, please re-enter a valid User Name.", "Registration Form Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer);
				}	
				else if(toSetFocus == id_UserName)
					registerBaseUser();
				
				isUserNameAsyncOperationPending = false;
			}
			
			private function checkIfPracticeKeyDoesNotExist():void
			{
				if(toSetFocus == id_key && isPracticeKeyAsyncPending)
				{
					cursorManager.setBusyCursor();
					return;
				}
				
				id_PracticeKeyValidator.isPracticeKeyInvalid = false;
				isPracticeKeyAsyncPending = true;
				var vpke:ValidatePracticeKeyEvent = new ValidatePracticeKeyEvent(id_key.text,isPracticeKeyExists);
				CairngormEventDispatcher.getInstance().dispatchEvent(vpke);
			}
			
			private function isPracticeKeyExists(result:XML):void
			{
				cursorManager.removeBusyCursor();
				if(result.toString() == "false")
				{
					id_PracticeKeyValidator.isPracticeKeyInvalid = true;
					if(toSetFocus == id_key)
						Alert.show("Practice Key does not exist, please enter a valid Key.", "Registration Form Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer);
				}
				else if(toSetFocus == id_key)
					registerBaseUser();
				
				isPracticeKeyAsyncPending = false;
			}
			
			protected function id_password_focusOutHandler(event:FocusEvent):void
			{
				resetApp();// call for reset tooltip
				
				id_imgPassword.source = Constants.IMG_GREEN;
				id_password.errorString = "";
				if (UtilityFunctions.TrimString(id_password.text).length > 0 && UtilityFunctions.TrimString(id_password.text).length < 8 )
				{	
					id_imgPassword.source = Constants.IMG_RED
					id_password.errorString = "Password should have 8-32 characters.";					
				}
				else if (UtilityFunctions.TrimString(id_password.text).length > 0)
				{ 
					var isNumOrSpecCharFound:Boolean = false;
					for (var i:int = 0; i < id_password.text.length; i++)
					{
						if (SPECIAL_CHARS.indexOf(id_password.text.charAt(i)) > -1 || NUMBER_CHARS.indexOf(id_password.text.charAt(i)) > -1)
						{
							isNumOrSpecCharFound = true;
							break;
						}
					}
					
					var isCapCharFound:Boolean = false;
					for (var j:int = 0; j < id_password.text.length; j++)
					{
						if (UtilityFunctions.isUpper(id_password.text.charAt(j)))
						{
							isCapCharFound = true;
							break;
						}
					}
					
					if (!isNumOrSpecCharFound && !isCapCharFound)
					{
						id_imgPassword.source = Constants.IMG_RED
						id_password.errorString = "Password should have one symbol or number and one uppercase letter.";
					}
					else if (isNumOrSpecCharFound && !isCapCharFound)
					{
						id_imgPassword.source = Constants.IMG_RED
						id_password.errorString = "Password should have one uppercase letter.";
					}
					else if (!isNumOrSpecCharFound && isCapCharFound)
					{
						id_imgPassword.source = Constants.IMG_RED
						id_password.errorString = "Password should have one symbol or number.";
					}
				}				
			}
			//Alvi - Tooltip Implementation.
			
			private var errorTip:ToolTip;
			private var myError:String;
			
			protected function id_password_focusInHandler(event:FocusEvent):void
			{
				if (errorTip)
					resetApp();
				
				myError="Password should have 8-32 characters with one symbol or number and one uppercase letter.";
				
				var pt:Point 	= event.currentTarget.localToGlobal( new Point(event.currentTarget.x, event.currentTarget.y));
				
				errorTip = ToolTipManager.createToolTip( myError, pt.x, pt.y - 75, null, IUIComponent(event.currentTarget)) as ToolTip;
				//errorTip = ToolTipManager.createToolTip( myError, pt.x + id_password.width, pt.y - 18, null, IUIComponent(event.currentTarget)) as ToolTip;
				
				// Apply the errorTip class selector.
				errorTip.setStyle("styleName", "infoTip");
			}
			private function resetApp():void 
			{
				if (errorTip) {
					ToolTipManager.destroyToolTip(errorTip);
					errorTip = null;
				}
			}
			
		]]>
