					return;
				
				registerBaseUser();
				
			}
			
			private function registerBaseUser():void
			{
				var baseUser:BaseUserDTO = new BaseUserDTO();
				
				var gender:GenderTypeDTO = new GenderTypeDTO();
				gender.GenderId = id_gender.selectedItem.ID;
				gender.GenderCode = id_gender.selectedItem.Code;
				gender.GenderName = id_gender.selectedItem.Gender;
				
				baseUser.ActiveUserType = id_role.selectedItem as UserTypeDTO
				baseUser.ClinicBranhId = parseInt(id_key.text);
				baseUser.CreatedBy = 0;
				baseUser.FirstName = id_firsName.text;
				baseUser.Gender = gender;				
				baseUser.IsActive = true;
				baseUser.IsDeleted = false;
				baseUser.LastName = id_lastName.text;
				baseUser.UserEmail = id_email.text;
				baseUser.MiddleName = "";
				baseUser.Suffix = "";
				baseUser.UserPassword = id_password.text;
				baseUser.TextPassword = id_password.text;
				baseUser.UserName = id_UserName.text;
				baseUser.LicenseNumber = "";
				baseUser.FederalTaxId = "";
				baseUser.SSN = "";
				baseUser.EIN = "";
				baseUser.QuivusUserID = "";
				baseUser.UserId = 0;
				baseUser.OtherID = "12345";
				baseUser.AccountStatus = new StatusTypeDTO();
				baseUser.AccountStatus.StatusID = 1;
				baseUser.AccountStatus.StatusName = "Active";
				
				//saving user image
				if(m_oImageContentString.length)
				{
					baseUser.Image = new ImageDTO();
					
					baseUser.Image.UserTypeID 			= (id_role.selectedItem as UserTypeDTO).ID;
					baseUser.Image.CreatedBy 			= 0;
					baseUser.Image.UserId 				= 0;
					baseUser.Image.ImageCaption 		= "ProfileImage";
					baseUser.Image.ImageData 			= m_oImageContentString;
					baseUser.Image.ImageId 				= 0;
					baseUser.Image.ImageName 			= "ProfileImage";
					baseUser.Image.ImagePath			= "";
					baseUser.Image.ImageTypeId 			= 1;
					baseUser.Image.ImageThumbnailData 	= "";
				}
				
				
				var rbue:RegisterBaseUserEvent = new RegisterBaseUserEvent(baseUser,registerBaseUserResponse);
				CairngormEventDispatcher.getInstance().dispatchEvent(rbue);
			}
			
			private function registerBaseUserResponse(result:XML):void
			{
				var userID:int = parseInt(result.toString())
				if(userID > 0)
				{
					var upe:CreateClinicUserProfileEvent = new CreateClinicUserProfileEvent(userID,(id_role.selectedItem as UserTypeDTO).ID,parseInt(id_key.text),
						(id_specaility.selectedItem as SpecialityCodeDTO).SpecialtyID,id_npi.text,createClinicUserProfile);
					CairngormEventDispatcher.getInstance().dispatchEvent(upe);	
				}
				else
					Alert.show("User not registered.");
			}
			
			private var doctorID:int  = 0;
			private function createClinicUserProfile(result:XML):void
			{
				doctorID = parseInt(result.toString())
				if(doctorID > 0)
				{					
					Alert.show("User [" + id_UserName.text+ "] registered successfully","New User Registration", 4, FlexGlobals.topLevelApplication.mainContainer);
					
					var e:RegisterProviderViewEvent = new RegisterProviderViewEvent(RegisterProviderViewEvent.REGISTER_PROVIDER);
					e.success = true;
					e.registeredProviderId = id_UserName.text;
					dispatchEvent(e);
					
				}
				else
					Alert.show("Clinic user not created.");
			}
			
			private var toSetFocus:Object;
			
			public function isInvalid() : Boolean 
			{
				var isNotValid:Boolean 	= false;
				var errorStr:String 	= ""; 
				toSetFocus 				= null;
				
				if ( id_role.selectedItem == null)
				{
					isNotValid = true;
					errorStr += "Please select a Role.\n";
					if (!toSetFocus)
						toSetFocus = id_role;
				}
				
				if (id_gender.selectedItem == null)
				{
					isNotValid = true;
					errorStr += "Please select a Gender.\n";
					if (!toSetFocus)
						toSetFocus = id_gender;
				}
				
				if (UtilityFunctions.TrimString(id_firsName.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter First Name.\n";
					if (!toSetFocus)
						toSetFocus = id_firsName;
				}
				
				if (UtilityFunctions.TrimString(id_lastName.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter Last Name.\n";
					if (!toSetFocus)
						toSetFocus = id_lastName;
				}
				
				if (UtilityFunctions.TrimString(id_email.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter Email.\n";
					if (!toSetFocus)
						toSetFocus = id_email;
				}
				
				if (id_EmailValidatorWithEmailExists.isEmailExists)
				{
					isNotValid = true;
					errorStr += "Email already exists, please re-enter a valid Email. \n";
					if (!toSetFocus)
						toSetFocus = id_email;
				}
				else if (UtilityFunctions.TrimString(id_email.text).length > 0 && id_imgEmail.source != Constants.IMG_GREEN)
				{
					isNotValid = true;
					errorStr += "Please enter a valid Email.\n";
					if (!toSetFocus)
						toSetFocus = id_email;
				}
				
				if (UtilityFunctions.TrimString(id_UserName.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter User Name.\n";
					if (!toSetFocus)
						toSetFocus = id_UserName;
				}
				
				if (id_UserNameValidator.isUserNameExists)
				{
					isNotValid = true;
					errorStr += "User Name already exists, please re-enter a valid User Name. \n";
					if (!toSetFocus)
						toSetFocus = id_UserName;
				}
				else if (UtilityFunctions.TrimString(id_UserName.text).length > 0 && id_imgUserName.source != Constants.IMG_GREEN)
				{
					isNotValid = true;
					errorStr += "Please enter a valid User Name.\n";
					if (!toSetFocus)
						toSetFocus = id_UserName;
				}
				
				if (UtilityFunctions.TrimString(id_password.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter Password.\n";
					if (!toSetFocus)
						toSetFocus = id_password;
				}
				
				if (UtilityFunctions.TrimString(id_password.text).length > 0 && UtilityFunctions.TrimString(id_password.text).length < 8 )
				{
					isNotValid = true;
					errorStr += "Password field should be upto 8-32 characters with 1 Symbol or Number and 1 Upper case letter.\n";
					if (!toSetFocus)
						toSetFocus = id_password;
				}
				else 
				{ 
					var isNumOrSpecCharFound:Boolean = false;
					for (var i:int = 0; i < id_password.text.length; i++)
					{
						if (SPECIAL_CHARS.indexOf(id_password.text.charAt(i)) > -1 || NUMBER_CHARS.indexOf(id_password.text.charAt(i)) > -1)
						{
							isNumOrSpecCharFound = true;
							break;
						}
					}
					
					var isCapCharFound:Boolean = false;
					for (var i:int = 0; i < id_password.text.length; i++)
					{
						if (UtilityFunctions.isUpper(id_password.text.charAt(i)))
						{
							isCapCharFound = true;
							break;
						}
					}
					
					if (!isNumOrSpecCharFound && !isCapCharFound)
					{
						isNotValid = true;
						errorStr += "Password field should contain at least 1 Symbol or Number and 1 Upper case letter.\n";
						if (!toSetFocus)
							toSetFocus = id_password;
					}
					else if (isNumOrSpecCharFound && !isCapCharFound)
					{
						isNotValid = true;
						errorStr += "Password field should contain at least 1 Upper case letter.\n";
						if (!toSetFocus)
							toSetFocus = id_password;
					}
					else if (!isNumOrSpecCharFound && isCapCharFound)
					{
						isNotValid = true;
						errorStr += "Password field should contain at least 1 Symbol or Number.\n";
						if (!toSetFocus)
							toSetFocus = id_password;
					}
				}
				
				if (UtilityFunctions.TrimString(id_ConfirmPassword.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter Confirmed Password.\n";
					if (!toSetFocus)
						toSetFocus = id_ConfirmPassword;
				}
				
				if (UtilityFunctions.TrimString(id_ConfirmPassword.text).length > 0 && id_imgConfirmPassword.source != Constants.IMG_GREEN  )
				{
					isNotValid = true;
					errorStr += "Please enter a valid Confirmed Password exactly matching with Password.\n";
					if (!toSetFocus)
						toSetFocus = id_ConfirmPassword;
				}
				
				if (UtilityFunctions.TrimString(id_phone.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter Phone.\n";
					if (!toSetFocus)
						toSetFocus = id_phone;
				}
				
				if (UtilityFunctions.TrimString(id_phone.text).length > 0 && UtilityFunctions.TrimString(id_phone.text).length < 13 )
				{
					isNotValid = true;
					errorStr += "Please enter a valid 10 digit Phone.\n";
					if (!toSetFocus)
						toSetFocus = id_phone;
				} 
				
				if (UtilityFunctions.TrimString(id_npi.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter NPI.\n";
					if (!toSetFocus)
						toSetFocus = id_npi;
				}
				
				if (UtilityFunctions.TrimString(id_npi.text).length > 0 && UtilityFunctions.TrimString(id_npi.text).length < 10 )
				{
					isNotValid = true;
					errorStr += "Please enter a valid 10 digit NPI.\n";
					if (!toSetFocus)
						toSetFocus = id_npi;
				}
				
				if (id_specaility.selectedItem == null)
				{
					isNotValid = true;
					errorStr += "Please select a Specialty.\n";
					if (!toSetFocus)
						toSetFocus = id_specaility;
				}
				
				if (UtilityFunctions.TrimString(id_key.text).length == 0 )
				{
					isNotValid = true;
					errorStr += "Please enter Practice Key.\n";
					if (!toSetFocus)
						toSetFocus = id_key;
				}
				
				if (id_PracticeKeyValidator.isPracticeKeyInvalid)
				{
					isNotValid = true;
					errorStr += "Practice Key does not exist, please enter a valid Key. \n";
					if (!toSetFocus)
						toSetFocus = id_key;
				}
				else if (UtilityFunctions.TrimString(id_key.text).length > 0 && id_imgKey.source != Constants.IMG_GREEN)
				{
					isNotValid = true;
					errorStr += "Please enter a valid Practice Key.\n";
					if (!toSetFocus)
						toSetFocus = id_key;
				}
				
				if (isEmailAsyncOperationPending)
				{
					isNotValid = true;
					errorStr += "\nPlease wait for server side validation to complete for Email... \n";
					if (!toSetFocus)
						toSetFocus = id_email;
				}
				else if (isUserNameAsyncOperationPending)
				{
					isNotValid = true;
					errorStr += "\nPlease wait for server side validation to complete for User Name... \n";
					if (!toSetFocus)
						toSetFocus = id_UserName;
				}
				else if (isPracticeKeyAsyncPending)
				{
					isNotValid = true;
					errorStr += "\nPlease wait for server side validation to complete for Practice Key... \n";
					if (!toSetFocus)
						toSetFocus = id_key;
				}
				
				if (isNotValid && errorStr.length && !( 
					(toSetFocus == id_email && isEmailAsyncOperationPending) || 
					(toSetFocus == id_UserName && isUserNameAsyncOperationPending) ||
					(toSetFocus == id_key && isPracticeKeyAsyncPending)
				)
				)
					Alert.show(errorStr, "Registration Form Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						if (toSetFocus)
							toSetFocus.setFocus();
						toSetFocus = null;
					});
				
				return isNotValid;
			}
			
			protected function id_gotoSignIn_clickHandler(event:MouseEvent):void
			{
				if(doctorID == 0)
				{
					UtilityFunctions.AskMessage("Do you want to leave the form without Registering?",function(): void
					{
						var e:RegisterProviderViewEvent = new RegisterProviderViewEvent(RegisterProviderViewEvent.REGISTER_PROVIDER);
						e.success = false;
						e.registeredProviderId = "";
						dispatchEvent(e);
					});
				}
				else
				{
					var e:RegisterProviderViewEvent = new RegisterProviderViewEvent(RegisterProviderViewEvent.REGISTER_PROVIDER);
					e.success = true;
					e.registeredProviderId = id_email.text;
					dispatchEvent(e);
				}
			}
			
			protected function id_reset_clickHandler(event:MouseEvent):void
			{
				resetFileds();			
			}
			public function resetFileds():void
			{
				if(RoleTypes.length > 1)
				{
					for each (var role:UserTypeDTO in RoleTypes) 
					{
						if(role.UserTypeName == "Physician")
						{
							id_role.selectedItem 		= 	role;
						}
					}
				}
				else
					id_role.selectedItem 	= RoleTypes[0] as Object;
				
				id_gender.selectedItem 		= null;				
				id_specaility.selectedItem 	= null;					
				id_specaility.text 			= "";				
				
				id_acceptTerms.selected 	= false;				
				id_email.text 				= "";				
				id_imgEmail.source			= Constants.IMG_RED;				
				id_firsName.text 			= "";				
				id_lastName.text 			= "";				
				id_imagePath.text 			= "";
				id_upload.enabled 			= false;
				id_imgUserName.source		= Constants.IMG_RED;
				id_UserName.text 			= "";				
				id_imgPassword.source		= Constants.IMG_RED;
				id_password.text 			= "";				
				id_imgConfirmPassword.source			= Constants.IMG_RED;
				id_ConfirmPassword.text 				= "";				
				id_imgKey.source			= Constants.IMG_RED;
				id_key.text 				= "";				
				id_npi.text 				= "";				
				id_phone.text				= "";	
				id_ProviderImge.source 		= Constants.BLANK_PROFILE_IMAGE;
				
				if(id_role.enabled)
					id_role.setFocus();
				else
					id_gender.setFocus();
				
				doctorID = 0;
				m_oImageContentString = "";
			}
			
			protected function CC(event:FlexEvent):void
			{
				resetFileds();
			}
			
