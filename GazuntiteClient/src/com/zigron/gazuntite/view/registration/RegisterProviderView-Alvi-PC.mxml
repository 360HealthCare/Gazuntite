			protected function linkelement1_clickHandler(event:FlowElementMouseEvent):void
			{
				var url:String = "https://www.gazuntite.com";
				navigateToURL(new URLRequest(url), '_blank');
			}
			
			protected function id_browse_clickHandler(event:MouseEvent):void
			{
				var fileTypes:FileFilter = new FileFilter( "Image Files", "*.gif;*.jpeg;*.jpg;*.png" );
				openFile = new File();
				openFile.addEventListener(Event.SELECT, fileRef_select);
				openFile.addEventListener(Event.CANCEL, fileRef_cancel);
				openFile.browse([fileTypes]);
			}	
			
			private function fileRef_select(evt:Event):void 
			{
				try
				{
					id_imagePath.text = evt.target.nativePath;
					id_upload.enabled = true;				
					
				} 
				catch (err:Error)
				{
					Alert.show(err.message,"Error",4,this);
				}
			}
			private function fileRef_cancel(evt:Event):void 
			{
				if(id_imagePath.text.length)
					id_upload.enabled = true;
				else
					id_upload.enabled = false;
				
			}
			
			protected function id_upload_clickHandler(event:MouseEvent):void
			{
				var stream:FileStream = new FileStream(); // open filestream
				stream.open(openFile, FileMode.READ); // open the file
				
				var size_500K:Number = 500 * 1024;
				
				if (stream.bytesAvailable <= size_500K)
				{
					m_oImageContent = new ByteArray();
					stream.readBytes( m_oImageContent, 0, stream.bytesAvailable ); // read file
					stream.close(); // close file
					id_ProviderImge.source =  m_oImageContent;
					m_oImageContentString  =  AppUtils.getBase64String(m_oImageContent);
					id_upload.enabled = false;
				}
				else
				{
					Alert.show("Image size can not be greater than 500k.\n", "Image size error", 4, FlexGlobals.topLevelApplication.mainContainer, function():void
					{
						id_upload.setFocus();
					});
				}
			}
			
			protected function id_register_clickHandler(event:MouseEvent):void
			{
