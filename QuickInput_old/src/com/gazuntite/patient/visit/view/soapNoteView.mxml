			public function show(value:String = "", arg_callback:Function = null, status_callback:Function = null):void
			{
				this.previewWindowType = value;
				
				ShowPopup( UtilityFunctions.getTopLevelParentContainer() );
				
				switch(value)
				{
					case REVIEW_ALL:
						this.title = "Patient History for Review";
						this.okBtn.label = "OK";
						this.okBtn.visible = false;
						this.cancelBtn.label = "Close";
						break;
					
					case SIGN_COSIGN:
						this.title = "Final Review";
						this.okBtn.label = 'Sign'; 
						model.signCoSignBtnLabel;
						break;
					
					case SAVE_AND_REVIEW:
						this.title = "Final Review";
						this.okBtn.label = "Save";
						break;
					case REVIEW_AND_PRINT:
						this.title = "Review and Print";
						this.okBtn.label = "OK";
						this.okBtn.visible = false;
						this.cancelBtn.label = "Close";
						break;
				}
				
				
				
				callback = arg_callback;
				statusCallback = status_callback
				if(null != statusCallback)
				statusCallback("Please Wait , While SOAP Note is Loading.");
			}
			
			protected function id_htmlArea_completeHandler(event:Event):void
			{
				if(null != event.currentTarget.location )
				{
					CursorManager.removeBusyCursor();
					id_htmlArea.htmlLoader.navigateInSystemBrowser = true;
					callback("RemoveLoadingPoPup" , 0); // remove Soap Loading Note Pop UP
				}
				
			}
			
