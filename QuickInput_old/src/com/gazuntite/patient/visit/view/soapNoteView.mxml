			private function okBtnClickHandler():void
			{
				//refreshModel();
				var statusMessage:String = "Please wait while ";
				switch(previewWindowType)
				{
					case SIGN_COSIGN:
						if (!authenticationPopUp)
							authenticationPopUp = new AuthenticationPopUp();
						
						if (model.VisitID)
							authenticationPopUp.visitID = model.VisitID;
						
					//	authenticationPopUp.signBtnLabel = model.signCoSignBtnLabel;
						authenticationPopUp.originName = Constants.QUICK_INPUT_MODULE_NAME;
						authenticationPopUp.onVisitSignCosignCallback = onSucessfullVisitSave;
						authenticationPopUp.ShowPopup(this);
						
						statusMessage = statusMessage + "sign / co-sign visit."
						
						break;
					
					case REVIEW_ALL:
						
						statusMessage = statusMessage + "saving visit data."
						break;
					
					case SAVE_AND_REVIEW:
						
						var MVDEvent:MarkValidDataExistsEvent = new MarkValidDataExistsEvent(); 
						MVDEvent.functionName = onSucessfullVisitSave;
						CairngormEventDispatcher.getInstance().dispatchEvent( MVDEvent )
						
						// call the newly created MarkValidDataExists event 
						
						/* var MVDEvent:ManageQuickInputEvent = new ManageQuickInputEvent( true); 
						MVDEvent.functionName = onSucessfullVisitSave;
						CairngormEventDispatcher.getInstance().dispatchEvent( MVDEvent );
						
						var uvEvent:UpdateVisitEvent = new UpdateVisitEvent(  );
						CairngormEventDispatcher.getInstance().dispatchEvent( uvEvent ); */
						
						statusMessage = statusMessage + "saving visit data."
						
						break;
				}
				if( statusCallback && previewWindowType != SIGN_COSIGN)
					statusCallback( statusMessage );
			}
			
			private function cancelBtnClickHandler():void
			{
				hide();
			}
			
			public function hide(doClose:Boolean = false, actionName:String = "", visitID:int = 0):void
			{
				removePopup();
				
				if (null != callback && doClose)
					callback(actionName, visitID);
			}
			
			private function onSucessfullVisitSave(actionName:String = "", visitID:int = 0):void
			{
				dispatchEvent(new Event('onSaveVisit',true));
				hide(true, actionName, visitID);
			}
			
			public function printBtnClickHandler():void
			{
				
			}

			protected function popupwindow1_creationCompleteHandler(event:FlexEvent):void
			{
				m_sSoapNoteText = "<b>Loading...</b>";
				
