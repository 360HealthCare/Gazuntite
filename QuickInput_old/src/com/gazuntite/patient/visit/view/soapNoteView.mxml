	<s:VGroup gap="2" height="{Capabilities.screenResolutionY - 130}" width="{(Capabilities.screenResolutionX / 2) - 30 }" verticalAlign="top" horizontalAlign="center" paddingLeft="5" >
		
			<mx:HTML id="id_htmlArea" htmlText="{SoapNoteText}" height="{Capabilities.screenResolutionY - 175}" width="{(Capabilities.screenResolutionX / 2) - 50}" complete="id_htmlArea_completeHandler(event)" x="2"/>
			
		
		<s:VGroup verticalAlign="bottom" horizontalAlign="center" paddingBottom="0" width="100%">	
			<s:HGroup horizontalAlign="center" width="100%">
				<s:Button id="okBtn" click="okBtnClickHandler()" label="OK" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.OKBtnSkin" useHandCursor="true" buttonMode="true"/>
				<s:Button id="cancelBtn" click="cancelBtnClickHandler()" label="Cancel" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.OKBtnSkin" useHandCursor="true" buttonMode="true"/>
				
			</s:HGroup>
		</s:VGroup>
	</s:VGroup>
