<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		  
		 xmlns:notes="com.gazuntite.patient.visit.view.commons.notes.*" 
		 xmlns:dictation="com.gazuntite.patient.visit.view.commons.dictation.*"
		  
		 creationComplete="group1_creationCompleteHandler(event)" 
		  >
	<s:layout>
		<s:VerticalLayout/>
	</s:layout>
	<fx:Metadata>
		[Event(name="notesSaved", type="flash.events.Event")]
		[Event(name="DictationSaved", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.gazuntite.skins.chrome.toggleButtonSkins.writeNotesButton;
			import com.adobe.gazuntite.skins.chrome.toggleButtonSkins.writeNotesButtonSelected;
			import com.gazuntite.patient.visit.dto.ModuleDictationDTO;
			import com.gazuntite.patient.visit.dto.ModuleNoteDTO;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			import mx.events.IndexChangedEvent;
			
			
			[Bindable]
			private var model : QIModelLocator = QIModelLocator.getInstance();
			
			private var m_bIsModelUpdated:Boolean;
			private var m_oDictationDTO:ModuleDictationDTO;					
			private var m_oNotesDTO:ModuleNoteDTO;
			
			
			public function get IsModelUpdated():Boolean
			{
				return m_bIsModelUpdated;
			}
			
			public function set IsModelUpdated(value:Boolean):void
			{
				m_bIsModelUpdated = value;
				
				 if( value )
				{																						
					var module:ModuleDictationDTO = DictationDTO; 								
					dictationPanel.HeadingLable 	= "Dictation";							
				} 
			}
			
			[Bindable]
			public function get DictationDTO():ModuleDictationDTO
			{
				return m_oDictationDTO;
			}
			
			public function set DictationDTO(value:ModuleDictationDTO):void
			{
				m_oDictationDTO = value;
			}
			
			[Bindable]
			public function get notesDTO():ModuleNoteDTO
			{
				return m_oNotesDTO;
			}
			
			public function set notesDTO(value:ModuleNoteDTO):void
			{
				m_oNotesDTO = value;
				//notesDTOChanged = true;
				
				if( value )
				{
					id_notesPanel.id_body.id_message.text = value.Note;
					id_notesPanel.id_body.id_subject.text = value.NoteSubject;	
				}
				invalidateProperties();
			}
			
			protected function dictationpopup1_creationCompleteHandler(event:FlexEvent):void
			{
				/* DictationID="{module.dictationID}" ModuleID="{module.ModuleTypeID.toString()}" 
				var module:ModuleDictationDTO = DictationDTO; 								
				dictationPanel.HeadingLable 	= "Dictation";							
				dictationPanel.DictationID	 	= module.DictationID;				
				dictationPanel.ModuleID	 		= module.ModuleTypeID.toString(); */
				
			}


			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				id_notesPanel.id_body.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					id_Area.visible = false;
					id_Area.includeInLayout = false; 
					
					 id_notesPanel.SaveNotes();	
					 
					//var noteDto:ModuleNoteDTO = notesDTO;					
					
					if(id_notesPanel.id_body.id_message.text.length > 0)
					{
						//id_header.id_NotesBtn.setStyle("skinClass", writeNotesButtonSelected);
					}
					else
					{
						//id_header.id_NotesBtn.setStyle("skinClass", writeNotesButton);
					} 
										
				}); 
				
				id_notesPanel.tabIndex 	= tabIndex;
				
			 	id_notesPanel.id_body.id_subject.tabIndex 	= tabIndex;
				id_notesPanel.id_body.id_message.tabIndex 	= tabIndex+1;
				id_notesPanel.id_body.id_ClearBtn.tabIndex 	= tabIndex+2;
				id_notesPanel.id_body.id_SaveBtn.tabIndex 	= tabIndex+3; 
	
				//dictationPanel.tabIndex = tabIndex + 4; 
			}


			protected function id_crossBtn_clickHandler(event:MouseEvent):void
			{
				CheckToSaveNote();
				CheckToStopRecording();
				
				this.visible 		= false;
				this.includeInLayout = false;
			}

			public function CheckToSaveNote():void
			{
				/* if(id_notesPanel.id_body.id_message.text.length > 0 && id_notesPanel.id_body.id_message.text != notesDTO.Note)
				{
					UtilityFunctions.AskMessage("There are unsaved notes, do you want to save?", 
						function():void
						{
							id_notesPanel.SaveNotes();
							
						}, null, 
						function():void
						{
							id_notesPanel.id_body.id_message.text = "";
						});
				} */
				
			}
			
			public function CheckToStopRecording():void
			{
				 if(dictationPanel.recStop_btn.enabled)
				{
					UtilityFunctions.AskMessage("Do you wnat to stop recording and close?", 
						function():void
						{
							dictationPanel.playStop_btn.dispatchEvent(new MouseEvent(MouseEvent.CLICK, true, false))
							
						}, null, 
						function():void
						{
							dictationPanel.playStop_btn.dispatchEvent(new MouseEvent(MouseEvent.CLICK, true, false))
						});
				} 
				
			}
			
			protected function id_Area_showHandler(event:FlexEvent):void
			{
				id_notesPanel.id_body.id_subject.setFocus();
			}


			protected function id_VBViews_changeHandler(event:IndexChangedEvent):void
			{
				if( event.newIndex == 1 )
				{
					CheckToSaveNote();
				}
				else
				{
					CheckToStopRecording();
					id_notesPanel.id_body.id_subject.setFocus();
				}
			}

		]]>
	</fx:Script>
	<!--<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> -->
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:SkinnableContainer id="id_Area" width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.notesAreaSkin" show="id_Area_showHandler(event)" >
		<s:layout>
			<s:VerticalLayout gap="-10" paddingBottom="4" paddingLeft="4" paddingRight="6" paddingTop="5" />
		</s:layout>	
		<s:HGroup width="100%" horizontalAlign="right" paddingRight="2">
			<s:Button id="id_crossBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBcrossBtn" click="id_crossBtn_clickHandler(event)" buttonMode="true" toolTip="Close" />
		</s:HGroup>
	
	<s:VGroup width="100%" gap="-4" paddingTop="-6">									
		<s:TabBar id="id_TabBar" dataProvider="{id_Views}" buttonMode="true" 				  
				  skinClass="com.adobe.gazuntite.skins.chrome.tabBarSkins.NotesQIrecordingsTabBar"/>
		<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.QIrecordingsSkin">
			<s:layout>
				<s:VerticalLayout paddingBottom="3" paddingLeft="3" paddingRight="3" paddingTop="3" />
			</s:layout>
			<mx:ViewStack id="id_Views" width="100%" minWidth="500" resizeToContent="true" creationPolicy="all" change="id_VBViews_changeHandler(event)">
				<s:NavigatorContent width="100%" label="Write Notes" minWidth="500" >
					<notes:NotesPanel_expanded id="id_notesPanel" width="100%" height="100" HeadingLable="Allergies" notesDTO="{notesDTO}" />
				</s:NavigatorContent>
				
				<s:NavigatorContent width="100%" label="Record Dictation" >											
					<dictation:DictationPopup_expanded id="dictationPanel" width="100%" height="80" HeadingLable="Dictation" DictationDTO="{DictationDTO}" creationComplete="dictationpopup1_creationCompleteHandler(event)" />
				</s:NavigatorContent>
				
			</mx:ViewStack>
		</s:SkinnableContainer>
	</s:VGroup>
		
		
		</s:SkinnableContainer>
</s:Group>
