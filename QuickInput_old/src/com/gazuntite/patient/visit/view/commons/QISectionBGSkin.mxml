<!--- The default skin class for a Spark SkinnableContainer container.  

     @see spark.components.SkinnableContainer
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
	alpha.disabled="0.5" 
	minWidth="100">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("com.gazuntite.patient.visit.view.commons.QICollapseableView")]
		
    ]]>
    </fx:Metadata> 
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
	
	<s:Rect id="background" left="0" right="0" top="0" bottom="0" alpha="1.0" radiusX="3">
		
		<s:filters >
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#333333" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>		
			<s:GlowFilter  blurX="90" blurY="90" color="#738DB1" inner="true" knockout="false" quality="3" strength="1" alpha="{hostComponent.ExpandedView ? 1 : 0.45}"/>
			<s:GlowFilter blurX="5" blurY="5" color="#00B3FF" inner="true" strength="5"  quality="2" knockout="false"  alpha="{hostComponent.ExpandedView ? 1 : 0.45}" />
		</s:filters>
		<s:fill>
			<s:SolidColor color="#000000"/>
		</s:fill>
	</s:Rect>
	
	
	
	
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
	<!--<s:Rect id="background" height="100%" radiusX="0" width="100%" >
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#333333" distance="1" hideObject="false" inner="false"
								knockout="false" quality="3" strength="1"/>
			<s:GlowFilter blurX="5" blurY="5" color="#ee0202" inner="true" strength="20" alpha="1.0" quality="2" knockout="false" />
			<s:GlowFilter alpha="1.0" blurX="90" blurY="90" color="#738DB1" inner="true" knockout="false" quality="3" strength="1"/>
			<s:GlowFilter alpha="1.0" blurX="5" blurY="5" color="#00BFFF" inner="true" knockout="false" quality="3" strength="3"/>
		</s:filters>
		<s:fill>
			<s:SolidColor color="#000000"/>
		</s:fill>
	</s:Rect>-->
    
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
