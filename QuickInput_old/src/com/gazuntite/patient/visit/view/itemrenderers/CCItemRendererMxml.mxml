		</s:SkinnableContainer>
		<s:VGroup id="id_hpiContent" width="100%">		
			<itemrenderers:HPIItemRenderer id="hpiItemRenderer" width="100%" height="100%" horizontalAlign="left"/>
		</s:VGroup>
	</s:VGroup>
</s:ItemRenderer>
