				*/	
				
				
				
				/* if( model.visitDTO && model.visitDTO.VisitStatus != Constants.UN_SIGNED_STATUS )
				id_ButtonGroup.enabled = false; */
				
				//For associated records in Diagnosis & immunization
				/* if( data.hasOwnProperty("IsNA") && data.IsNA )
				id_ButtonGroup.enabled = false; */
				
				if( data.IsDirty )
				{
					id_SaveBtn.visible = true;
					id_Edit.visible = false;
				}
				else
				{
					id_SaveBtn.visible = false;
					id_Edit.visible = true;
				}
				
				/**
				 * Ayesha 28/01/2013
				 **/
				if (data && data.hasOwnProperty("IsRecordEditable"))
				{
					id_Edit.enabled = data.IsRecordEditable;
				}
				
				extractDataForNotes();
				extractDataForDictation();
				
				setNotesIcon();
				setDictationIcons();
			}
			
			private function setNotesIcon():void
			{
				if (gridNotesDTO)
				{
					if (gridNotesDTO.Note || gridNotesDTO.NoteSubject)
					{
						id_WriteNotes.setStyle("skinClass", writeNotesButtonSelected);
					}
					else
					{
						id_WriteNotes.setStyle("skinClass", notesBtn);
					}
				}
				else
				{
					id_WriteNotes.setStyle("skinClass", notesBtn);
				}
			}
			
			private function setDictationIcons():void
			{
				var dicID:String = deriveComplexData(dictationIDField);
				if (dicID && dicID != Constants.GUID_FORMAT)
				{
					id_WriteDictation.setStyle("skinClass", gridDictationButtonSelectedSkin);
				}
				else
				{
					id_WriteDictation.setStyle("skinClass", dictationBtn);
				}
			}
			
			private function onEmailClick(event:MouseEvent):void
			{
				dispatchEvent(new Event("emailRecordClick", true));
				dispatchEvent(new DataGridActionsEvent(DataGridActionsEvent.EMAIL_RECORD_CLICK, true));
			}
			
			private function onWriteNotesClick(event:MouseEvent):void
			{
				if (!recordGridNotesPopUp)
					recordGridNotesPopUp = new NotesPanel();
				recordGridNotesPopUp = new  NotesPanel();
				
				if (!recordGridNotesPopUp.isPanelShown)
				{
					gridNotesDTO = new ModuleNoteDTO ();
					gridNotesDTO = new  ModuleNoteDTO; //Object();
					var headingLabel:String = "";
					
					extractDataForNotes();
					
					headingLabel = deriveComplexData(headerField);
					recordGridNotesPopUp 				= new  NotesPanel ();
					recordGridNotesPopUp 				= new  NotesPanel();
					recordGridNotesPopUp.width			= 250;
					recordGridNotesPopUp.height			= 110;
					recordGridNotesPopUp.HeadingLable 	= headingLabel;
					recordGridNotesPopUp.VisitDateLable = UtilityFunctions.FormatDate(model.VisitDate, "MM-DD-YYYY");
					//recordGridNotesPopUp.VisitDateLable = new Date().toString();
					recordGridNotesPopUp.ShowPopup(this);
					
					var pt:Point = localToGlobal(new Point(id_WriteNotes.x - 196, id_WriteNotes.y + 15));
					recordGridNotesPopUp.move(pt.x, pt.y);
					recordGridNotesPopUp.notesDTO		=  gridNotesDTO;
					recordGridNotesPopUp.onNotesSaved = updateNotesData;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					/* recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
					updateNotesData();
					
					}, false, 0, true); */
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						//recordGridNotesPopUp.removePopup();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
				}
			}
			
			private function deriveComplexData(field:String):*	
			{
				var currentObj:*;
				
				if (field)
				{
					var arr:Array = [field];
					
					if (field.indexOf(".") != -1)
					{
						arr = field.split(".");
						field = arr[arr.length - 1];
					}
					
					currentObj = data
					
					if (currentObj)
					{
						for (var i:int = 0; i < arr.length; i++)
						{
							currentObj = currentObj[arr[i]];
						}
					}
				}
				
				return currentObj;
			}
			
			private function updateNotesData():void
			{
				if (data)
				{
					var isDirty:Boolean = false;
					
					if (notesField && data.hasOwnProperty(notesField) && data[notesField] != gridNotesDTO.Note)
					{
						data[notesField] = gridNotesDTO.Note;
						isDirty = true;
					}
					
					if (notesSubjectField && data.hasOwnProperty(notesSubjectField) && data[notesSubjectField] != gridNotesDTO.NoteSubject)
					{
						data[notesSubjectField] = gridNotesDTO.NoteSubject;
						isDirty = true;
					}
					
					if ( null != statusFunction )
					{
						var status:Boolean
						
						if(( gridNotesDTO.Note && gridNotesDTO.Note.length ) || ( gridNotesDTO.NoteSubject && gridNotesDTO.NoteSubject.length )) 
							status = true;
						else
							status = false;
						
						statusFunction(status, data)
					}
					
					if (isDirty)
					{
						setNotesIcon();
						
						if (recordIDField)
						{
							var id:int = deriveComplexData(recordIDField);
							
							if (id != 0 && data.hasOwnProperty("IsDirty"))
							{
								data["IsDirty"] = true;
							}
						}
					}
					
					dispatchEvent(new Event("NotesSavedFromGrid", true));
				}
			}
			
			private function extractDataForNotes():void
			{
				if (listData && listData is DataGridListData)
				{
					var dataGrid:DataGrid = DataGrid(listData.owner);
					
					if (dataGrid.columns[listData.columnIndex] is DataGridColumnEx)
					{
						var gridCol:DataGridColumnEx = DataGridColumnEx(dataGrid.columns[listData.columnIndex]);
						if (gridCol.data)
						{
							if (gridCol.data.hasOwnProperty("noteDataFields") && gridCol.data.noteDataFields)
							{
								notesField = gridCol.data.noteDataFields.note;
								notesSubjectField = gridCol.data.noteDataFields.subject;
								
								if (!gridNotesDTO)
									gridNotesDTO = new ModuleNoteDTO();
								
								
								gridNotesDTO.Note = deriveComplexData(gridCol.data.noteDataFields.note);
								gridNotesDTO.NoteSubject = deriveComplexData(gridCol.data.noteDataFields.subject);
								
								headerField = gridCol.data.noteDataFields.header;
								
								statusFunction = gridCol.data.noteDataFields.statusFunction;
							}
							
							if (gridCol.data.hasOwnProperty("section") && gridCol.data.section)
							{
								section = gridCol.data.section;
							}
							
							if (gridCol.data.hasOwnProperty("recordIDField") && gridCol.data.recordIDField)
							{
								recordIDField = gridCol.data.recordIDField;
							}
						}
					}
				}
			}
			
			private function extractDataForDictation():void
			{
				if (listData && listData is DataGridListData)
				{
					var dataGrid:DataGrid = DataGrid(listData.owner);
					
					if (dataGrid.columns[listData.columnIndex] is DataGridColumnEx)
					{
						var gridCol:DataGridColumnEx = DataGridColumnEx(dataGrid.columns[listData.columnIndex]);
						if (gridCol.data)
						{
							if (gridCol.data.hasOwnProperty("dictationDataField"))
							{
								dictationIDField = gridCol.data.dictationDataField;
							}
							
							if (gridCol.data.hasOwnProperty("section") && gridCol.data.section)
							{
								section = gridCol.data.section;
							}
						}
					}
				}
			}
			
			private var dictationPopUp: DictationPopup;
			private var recordDictationDTO:ModuleDictationDTO;
			private function onWriteDictationClick(event:MouseEvent):void
			{
				if (!dictationPopUp)
				{
					dictationPopUp = new  DictationPopup();
				}
				
				if (!dictationPopUp.isPopUpShown)
				{
					extractDataForDictation();
					
					dictationPopUp.width			= 200;
					dictationPopUp.height			= 75;
					dictationPopUp.HeadingLable 	= "Dictation";
					
					dictationPopUp.ShowPopup(this);
					dictationPopUp.DictationID = deriveComplexData(dictationIDField);
					var pt:Point = localToGlobal(new Point(id_WriteDictation.x - 194, id_WriteDictation.y + 13));
					
					//dictationPopUp.move(pt.x - dictationPopUp.width/2, pt.y);
					
					dictationPopUp.move(pt.x , pt.y );
					/* dictationPopUp.move(pt.x - (dictationPopUp.width/2)-95, pt.y + 10); */
					
					QIPopUpManager.addPopUp(dictationPopUp, section);
					
					dictationPopUp.id_closeBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						dictationPopUp.removePopup();
						QIPopUpManager.removePopUp(dictationPopUp, section);
						
						if (data && dictationIDField )
						{
							if(dictationPopUp.DictationID)
								data[dictationIDField] = dictationPopUp.DictationID;
							
							if(data[dictationIDField] != Constants.GUID_FORMAT)
							{
								data["IsDirty"] = true;
								dispatchEvent(new Event("DictationSavedFromGrid", true));
							}
							
						}
						else
						{
							trace( "DeleteRecordRenderer::dictationIDField", dictationIDField );
						}
						
						setDictationIcons();
					});
				}
				
				dispatchEvent(new DataGridActionsEvent(DataGridActionsEvent.WRITE_DICTATION_CLICK, true));
			}
			
			private function onEditClick(event:MouseEvent):void
			{
				id_SaveBtn.visible 	= true;
				id_Edit.visible 	= false;
				
				var ev:DataGridActionsEvent = new DataGridActionsEvent(DataGridActionsEvent.EDIT_RECORD_CLICK, true);
				ev.data = this.data;
				
				dispatchEvent(ev);
			}
			
			private function onDeleteClick(event:MouseEvent):void	
			{
				var ev:DataGridActionsEvent = new DataGridActionsEvent(DataGridActionsEvent.DELETE_RECORD_CLICK, true);
				ev.data = this.data;
				
				dispatchEvent(ev);
			}
			
