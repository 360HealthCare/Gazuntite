				  buttonMode="true" toolTip="Email" visible="false" includeInLayout="{id_Email.visible}"/>
		<s:Button id="id_WriteDictation" width="12" height="12" click="onWriteDictationClick(event)" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.dictationBtn" 
				  buttonMode="true" toolTip="Record Dictation"/>
		<s:Button id="id_WriteNotes" width="12" height="12" click="onWriteNotesClick(event)" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.notesBtn" 
				  buttonMode="true" toolTip="Write Notes"/>
		
		<s:Button id="id_Edit" width="12" height="12" click="onEditClick(event)" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.editButton"
				  buttonMode="true" toolTip="Edit" includeInLayout="{id_Edit.visible}"/>
		
		<s:Button id="id_SaveBtn" width="12" height="12" click="onSaveClick(event)" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.saveButton" 
				  buttonMode="true" useHandCursor="true" toolTip="Save" visible="false" includeInLayout="{id_SaveBtn.visible}"/>
		
		<s:Button id="id_Delete" width="12" height="12" click="onDeleteClick(event)"
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.removeBtn"
				  buttonMode="true" toolTip="Delete"/>
	</s:HGroup>
