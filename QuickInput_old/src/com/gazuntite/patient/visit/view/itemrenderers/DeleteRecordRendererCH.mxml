<?xml version="1.0" encoding="utf-8"?>
<s:MXDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
						  xmlns:s="library://ns.adobe.com/flex/spark" 
						  xmlns:mx="library://ns.adobe.com/flex/mx">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.events.DataGridActionsEvent;
			
			import flash.net.dns.AAAARecord;
			
			private function onWriteDictationClick(event:MouseEvent):void
			{
				var ev:DataGridActionsEvent = new DataGridActionsEvent(DataGridActionsEvent.WRITE_DICTATION_CLICK, true);
				ev.data = data;
				
				dispatchEvent(ev);
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
			private function onWriteNotesClick(event:MouseEvent):void
			{
				var ev:DataGridActionsEvent = new DataGridActionsEvent(DataGridActionsEvent.WRITE_NOTES_CLICK, true);
				ev.data = data;
				
				dispatchEvent(ev);
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
			private function onDeleteClick(event:MouseEvent):void
			{
				var ev:DataGridActionsEvent = new DataGridActionsEvent(DataGridActionsEvent.DELETE_RECORD_CLICK, true);
				ev.data = data;
				
				dispatchEvent(ev);
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
		]]>
	</fx:Script>
	<s:HGroup id="id_ButtonGroup" paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0" horizontalAlign="center" verticalAlign="middle">
		<s:Button id="id_WriteDictation" width="12" height="12" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.dictationBtn" 
				  buttonMode="true" toolTip="Record Dictation" click="onWriteDictationClick(event)"/>
		<s:Button id="id_WriteNotes" width="12" height="12" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.notesBtn" 
				  buttonMode="true" toolTip="Write Notes" click="onWriteNotesClick(event)"/>
		<s:Button id="id_Delete" width="12" height="12" 
				  skinClass="com.adobe.gazuntite.skins.chrome.gridButtonSkins.removeBtn"
				  buttonMode="true" toolTip="Delete" click="onDeleteClick(event)"/>
	</s:HGroup>
</s:MXDataGridItemRenderer>
