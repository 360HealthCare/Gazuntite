<?xml version="1.0" encoding="utf-8"?>
<components1:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:layout="com.greensock.layout.*"
					   creationComplete="cc()" 
					   xmlns:components1="com.gazuntite.controls.extended.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.patient.visit.utils.Constants;
			
			import mx.controls.Label;
			
			
			private function cc():void
			{
				this.addEventListener("loadButtonClicked", loadButtonClickHandler, false, 0, true);
			}
			
			private function loadButtonClickHandler(event:Event):void
			{
				var selectedIndex:int = importVisitGrid.selectedIndex;
				var templateId:int =  1;
				
				switch(selectedIndex)
				{
					case 0:
						templateId = Constants.VISIT_TEMPLATE_TYPE_COMPREHENSIVE_VISIT;
						break;
					case 1:
						templateId = Constants.VISIT_TEMPLATE_TYPE_CHRONICDISEASE_VISIT;
						break;
					case 2:
						templateId = Constants.VISIT_TEMPLATE_TYPE_ACCUTE_VISIT;
						break;
				}
				
				/* var importVisitEvent:ImportVisitByPatientIdEvent = new ImportVisitByPatientIdEvent(templateId);
				CairngormEventDispatcher.getInstance().dispatchEvent(importVisitEvent); */
				
				removePopup();
			}
			
			private function closeBtnClickHandler(event:MouseEvent):void
			{
				removePopup();					
			}
			
			public function displayRowNumber(item:Object, iCol:int):String
			{
				var rowNumber:String = "";
				
				rowNumber = String(importVisitGrid.dataProvider.getItemIndex(item) + 1);
				
				return rowNumber;
			}
			
		]]>
	</fx:Script>
	
	<s:SkinnableContainer width="250" height="100%" skinClass="com.adobe.gazuntite.skins.QuickInput.ImportPrevVisitSkin" >
		<s:layout>
			<s:VerticalLayout gap="7" paddingBottom="4" paddingLeft="4" paddingRight="4" paddingTop="4" />
			
		</s:layout>
		<s:HGroup width="100%" horizontalAlign="right" paddingRight="8" paddingTop="8">
			<s:Button id="id_closeBtn" click="removePopup()" width="19" height="21" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QICrossButtonSkin" 
					  toolTip="Close" useHandCursor="true" buttonMode="true"/>
		</s:HGroup>
	
		<mx:DataGrid id="importVisitGrid" width="100%" fontFamily="Verdana" 
					 rowCount="{importVisitGrid.dataProvider.length}" editable="false"
					>
			<mx:dataProvider>
				<s:ArrayCollection>
					<fx:Object visitType="Comprehensive Visit"/>
					<fx:Object visitType="Chronic Disease Visit"/>
					<fx:Object visitType="Acute Visit"/>
				</s:ArrayCollection>
			</mx:dataProvider>
			<mx:columns>
				<mx:DataGridColumn headerText="Sr.#" labelFunction="displayRowNumber" width="30" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn headerText="Visit Type" dataField="visitType" width="150" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn>
					<mx:itemRenderer>
						<fx:Component>
							<s:MXItemRenderer>
								<s:Button label="Load" click="{dispatchEvent(new Event('loadButtonClicked', true))}"
										  buttonMode="true" useHandCursor="true" toolTip="Load Visit"  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ImportVisitLoadBtn"/>
							</s:MXItemRenderer>
						</fx:Component>
					</mx:itemRenderer>
				</mx:DataGridColumn>
			</mx:columns>
		</mx:DataGrid>
	</s:SkinnableContainer>
	
</components1:PopupGroup>
