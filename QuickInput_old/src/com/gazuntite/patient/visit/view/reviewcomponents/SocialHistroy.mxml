<?xml version="1.0" encoding="utf-8"?>
<components1:CollapsiblePanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 title="Social Histroy" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.checkboxCollapsiblePanelSkin" 
							 xmlns:mx="library://ns.adobe.com/flex/mx"  xmlns:components1="com.gazuntite.controls.extended.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.model.QIModelLocator;
			[Bindable]
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			
			[Bindable]
			override public function set isSelected(value:Boolean):void
			{
				super.isSelected = value;
				
				model.reviewHistroy.IsSocialReviewed = value;
			}
			
		]]>
	</fx:Script>
	<components1:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
	</components1:layout>
	<components1:LabelDataGrid id="id_SocialHistroy" horizontalScrollPolicy="off" verticalScrollPolicy="auto" width="100%" maxHeight="150"
							  rowCount="{id_SocialHistroy.dataProvider.length?id_SocialHistroy.dataProvider.length:1}"
							  columnWidths="{['30%','20%','20%','30%']}" verticalGridLines="false"
							  dataProvider="{model.PreviousSocialHistoryList}"
							  >
		<components1:columns>
			<mx:DataGridColumn headerText="Social History" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"  dataField="Social"/>
			<mx:DataGridColumn headerText="Status" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"  dataField="Status" />
			<mx:DataGridColumn headerText="Type"   dataField="Type" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
			<mx:DataGridColumn headerText="Educated" dataField="Educated" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
		</components1:columns>
	</components1:LabelDataGrid>
</components1:CollapsiblePanel>

