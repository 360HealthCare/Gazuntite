<?xml version="1.0" encoding="utf-8"?>
<components1:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					    height="100%" width="100%" xmlns:components1="com.gazuntite.controls.extended.components.*" >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.utils.Constants;
			
			import mx.managers.PopUpManager;
			[Bindable]
			public var TITLE:String = "This feature is coming soon";
			

			protected function id_btnOK_clickHandler(event:MouseEvent):void
			{
				PopUpManager.removePopUp( this );
			}

		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer width="100%" height="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.popupSkin">
		<s:layout>
			<s:VerticalLayout gap="5" paddingBottom="4" paddingLeft="4" paddingRight="4" paddingTop="10" horizontalAlign="center"  />
		</s:layout>
		<s:HGroup width="100%" height="35" horizontalAlign="left">
		<s:Label text="Coming Soon" fontFamily="Calibri Bold" color="#ffffff"    />
		</s:HGroup>	
	
		<s:Label  color="#ffffff" fontFamily="Calibri Bold" fontSize="12"
				 text="{Constants.COMING_SOON}"/>
			<s:Button id="id_btnOK" label="OK" click="id_btnOK_clickHandler(event)" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.OKBtnSkin" />
	</s:SkinnableContainer>
</components1:PopupGroup>
