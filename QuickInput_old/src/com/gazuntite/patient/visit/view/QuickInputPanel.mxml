		<s:VGroup id="id_contents" gap="-4" width="100%" height="100%" paddingTop="-4" horizontalAlign="center"
				  >
			
			<s:BorderContainer borderVisible="false" width="100%" height="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.QuickInputBackGroundSkin">
				<s:layout>
					<s:VerticalLayout gap="3" paddingLeft="3" paddingRight="3" paddingTop="6"/>
