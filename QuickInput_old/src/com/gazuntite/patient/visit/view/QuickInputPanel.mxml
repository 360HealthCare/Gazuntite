			[Bindable]
			public override function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			public override function set hasChange(value:Boolean):void
			{
				m_bHasChange = value;
				
				
				if( value || (id_QIContent.id_PMHView && id_QIContent.id_PMHView.hasChange ) || (id_QIContent.id_PhysicalView && id_QIContent.id_PhysicalView.hasChange ) || (id_QIContent.id_AssessmentView && id_QIContent.id_AssessmentView.hasChange ) )
				{
					m_bHasChange = true;
					
					if( id_header &&  id_header.id_ChangeIndicator )
					{
						id_header.id_ChangeIndicator.visible		 = true;
						id_header.id_ChangeIndicator.includeInLayout = true;
					}
					
				}
				else
				{
					m_bHasChange = false;
					
					if( id_header &&  id_header.id_ChangeIndicator )
					{
						id_header.id_ChangeIndicator.visible		 = false;
						id_header.id_ChangeIndicator.includeInLayout = false;
					}
				}
			}
			
			private function ShowSetProviderPanel(event:MouseEvent):void
			{
				showProviderPopup();
			}
			
			private function showProviderPopup():void
			{
				var popup:SetProviderPopup = new SetProviderPopup();
				popup = PopUpManager.createPopUp(this,SetProviderPopup,true) as SetProviderPopup;
				var pLoc:Point = id_header.id_ProviderBtn.parent.localToGlobal( new Point( id_header.id_ProviderBtn.x -250 , id_header.id_ProviderBtn.y  +  id_header.id_ProviderBtn.height + 10 ) );
				popup.move(pLoc.x ,pLoc.y);
				popup.id_btnSave.addEventListener(MouseEvent.CLICK, onSaveSetProviderPopup);
				popup.id_closeBtn.addEventListener(MouseEvent.CLICK, onCloseSetProviderPopup);
			}
			private function onSaveSetProviderPopup(event:MouseEvent):void
			{
				id_header.id_OptionPopUp.displayPopUp = false;
				id_header.id_iconButtons.selected = false;
			}
			
			private function ShowComingSoonPanel(event:MouseEvent):void
			{
				
				var popup:ComingSoon = new ComingSoon();
				popup.ShowPopup( this );
				popup.height = 125;
				popup.width = 200;
				
				var pLoc:Point = id_header.id_ImportBtn.parent.localToGlobal( new Point( id_header.id_ImportBtn.x -250 , id_header.id_ImportBtn.y  +  id_header.id_ImportBtn.height + 10 ) ); 
				popup.move(pLoc.x ,pLoc.y  ); 
				
			}
			
