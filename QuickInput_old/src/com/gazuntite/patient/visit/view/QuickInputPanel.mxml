			private function TogglePanelVisiblity():void
			{
				if(id_QIContent.visible)
				{
					id_QIContent.visible = false;
					id_QIContent.includeInLayout = false;
					id_header.id_expandBtn.selected = false;
				}
				else
				{
					id_QIContent.visible = true;
					id_QIContent.includeInLayout = true;
					id_header.id_expandBtn.selected = true;
				}
			}
			
			private function saveVisitDataClickHandler(event:MouseEvent):void
			{
				if (model.EncounterTypeId != 0 && model.placeOfServiceID != 0)
				{
					var SaveEvent:MarkValidDataExistsEvent = new MarkValidDataExistsEvent(callBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(SaveEvent);
					//UtilityFunctions.ShowMessage("Visit Saved successfully","Visit Saved");
				}
				else
				{
					Alert.show('Please select encounter Type and Place of service.','Info',4, FlexGlobals.topLevelApplication.mainContainer);
				}
			}
