			public function ResetPanelsExpendedViews():void
			{
				if(id_QIContent.id_PMHView)
				{
					id_QIContent.id_PMHView.DeSelectAllNavButton();
					id_QIContent.id_PMHView.DeSelectAllPageBtn();
					id_QIContent.id_PMHView.collupseAllPanel();
					id_QIContent.id_PMHView.currentSelectedView = null;
					id_QIContent.id_PMHView.currentIndex = 1;
				}
				if(id_QIContent.id_PhysicalView)
				{
					id_QIContent.id_PhysicalView.DeSelectAllNavButton();
					id_QIContent.id_PhysicalView.DeSelectAllPageBtn();
					id_QIContent.id_PhysicalView.collupseAllPanel();
					id_QIContent.id_PhysicalView.currentSelectedView = null;
					id_QIContent.id_PhysicalView.currentIndex = 1;
				}
				if(id_QIContent.id_AssessmentView)
				{
					id_QIContent.id_AssessmentView.DeSelectAllNavButton();
					id_QIContent.id_AssessmentView.DeSelectAllPageBtn();
					id_QIContent.id_AssessmentView.collupseAllPanel();
					id_QIContent.id_AssessmentView.currentSelectedView = null;
					id_QIContent.id_AssessmentView.currentIndex = 1;
				}
				
				id_QIContent.id_QIViews.selectedIndex = 0;
			}
			private function ResetArrayCollections():void
			{
				if(model.QIAllergyDTOList != null && model.QIAllergyDTOList.length > 0)
					model.QIAllergyDTOList.removeAll();
				// MEDICAL HISTORY
				if(model.PreviousGeneralMedicalHistoryList != null && model.PreviousGeneralMedicalHistoryList.length > 0)
					model.PreviousGeneralMedicalHistoryList.removeAll();
				// FAMILY HISTORY
				if(model.PreviousFamilyHistoryList!= null && model.PreviousFamilyHistoryList.length > 0)
					model.PreviousFamilyHistoryList.removeAll();
				// SOCIAL HISTORY
				if(model.PreviousSocialHistoryList!= null && model.PreviousSocialHistoryList.length > 0)
					model.PreviousSocialHistoryList.removeAll();
				// CHRONIC MEDICATION
				if(model.medicationDTOList!= null && model.medicationDTOList.length > 0)
					model.medicationDTOList.removeAll();
				// VITALS
				if(model.immunizationDTOList!= null && model.immunizationDTOList.length > 0)
					model.immunizationDTOList.removeAll();
				// CC HPI
				if(model.HPI_CCDTOList!= null && model.HPI_CCDTOList.length > 0)
					model.HPI_CCDTOList.removeAll();
				// ROS
				if(model.rosDTOList!= null && model.rosDTOList.length > 0)
				{
					model.rosDTOList.removeAll();
					model.rosDTOList = null;
				}
				// PHYSICALS
				if(model.physicalDTOList!= null && model.physicalDTOList.length > 0)
				{
					model.physicalDTOList.removeAll();
					model.physicalDTOList = null;
				}
				// LAB IN
				if(model.inHouseLabList!= null && model.inHouseLabList.length > 0)
					model.inHouseLabList.removeAll();
				// DIAGANOSIS
				if(model.patientDiagnosisDTOListByPatientId!= null && model.patientDiagnosisDTOListByPatientId.length > 0)
					model.patientDiagnosisDTOListByPatientId.removeAll();
				// PRESCRIPTION
				if(model.prescriptionDToList!= null && model.prescriptionDToList.length > 0)
					model.prescriptionDToList.removeAll();
				// PROCEDURE
				if(model.ProcedureDTOList!= null && model.ProcedureDTOList.length > 0)
					model.ProcedureDTOList.removeAll();
				// LAB OUT				
				if(model.laboutDTOList!= null && model.laboutDTOList.length > 0)
					model.laboutDTOList.removeAll();
				// UN SINGED VISITS
				if(model.unSignedVisitDates!= null && model.unSignedVisitDates.length > 0)
					model.unSignedVisitDates.removeAll();
				// RECOMMENDATION
				if(model.RecommendationDTOList!= null && model.RecommendationDTOList.length > 0)
					model.RecommendationDTOList.removeAll();
				// FOLLOW UP
				if(model.followUpDataControlType!= null && model.followUpDataControlType.length > 0)
					model.followUpDataControlType.removeAll();
				// 
				
				if(model.PatientFollowupMerged!= null && model.PatientFollowupMerged.length > 0)
					model.PatientFollowupMerged.removeAll();
				
				if(model.PatientMedicationDTOlist!= null && model.PatientMedicationDTOlist.length > 0)
					model.PatientMedicationDTOlist.removeAll();
				
				
				
				if(model.moduleNotes!= null && model.moduleNotes.length > 0)
					model.moduleNotes.removeAll();
				
				if(model.moduleDictationList!= null &&model.moduleDictationList.length > 0)
					model.moduleDictationList.removeAll();
				
				model.gaxenID = '';
				
				if(model.VitalDTO != null )
					model.VitalDTO = null;
				
				if(!model.checkNotesExsist) // force excution binding
					model.checkNotesExsist = true;
				model.checkNotesExsist = false;
				model.NotesDictationFlag = false;
				//id_QIContent.id_AssessmentView.id_DiagnosisPanel.ExpandedView = false;
			}
			//Tahir Alvi - Here reset all quick input form to default state
			private function ResetQIForms():void
			{
				id_QIContent.id_PMHView.id_AlergiesPanel.id_alergiesView.resetAllergyForm();//clear Allergy panel
				id_QIContent.id_PMHView.id_ChronicmedicationPanel.id_MedicationBodyView.resetMedicationForm();//clear medication panel
				id_QIContent.id_PMHView.id_HistoryPanel.resetComprehensiveHistory();//clear comprehensive history panel
				id_QIContent.id_AssessmentView.id_TreatmentPanel.id_Prescription.resetPrescriptionForm();//clear Prescription panel
				id_QIContent.id_PhysicalView.id_vital.id_vitalBodyView.resetVitalForm();
				//Reset Header Setting 
				id_header.id_EncounterType.selectedIndex 	= -1;
				id_header.id_PlaceOfService.selectedIndex 	= -1;
				
			}
			
