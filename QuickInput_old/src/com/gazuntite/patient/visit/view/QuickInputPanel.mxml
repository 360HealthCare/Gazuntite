				<view:QuickInputView id="id_QIContent" width="100%" height="100%" left="4" right="4" top="4" bottom="4" creationComplete="id_QIContent_creationCompleteHandler(event)"/>
				
				<s:SkinnableContainer width="100%" height="15" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.scrollerBlueBG">
