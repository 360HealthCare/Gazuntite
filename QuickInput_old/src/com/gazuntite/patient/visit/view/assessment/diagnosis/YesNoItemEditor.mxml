<?xml version="1.0" encoding="utf-8"?>
<s:MXItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				  xmlns:s="library://ns.adobe.com/flex/spark" 
				  xmlns:mx="library://ns.adobe.com/flex/mx">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<s:RadioButtonGroup id="yesNoGrp" itemClick="yesNoItemClickHandler(event)"/>
	</fx:Declarations>
	
	<!--<fx:Metadata>
	[Event(name="yesItemCliked", type="flash.events.Event")]
	</fx:Metadata>-->
	
	<fx:Script>
		<![CDATA[
			import com.adobe.gazuntite.skins.chrome.radioButtonSkins.ARadioButton;
			import com.adobe.gazuntite.skins.chrome.radioButtonSkins.NRadioButton;
			import com.adobe.gazuntite.skins.chrome.radioButtonSkins.YRadioButton;
			import com.gazuntite.patient.visit.utils.Constants;
			
			import mx.events.ItemClickEvent;
			
			private var _isYes:String;
			
			private var _dataChanged:Boolean;
			private var _property:String;
			
			private var swap:Boolean = false;
			private var _Changed:Boolean = false;
			private var _skinFirstButton:Class = com.adobe.gazuntite.skins.chrome.radioButtonSkins.YRadioButton;
			
			private var _isNormalAbnormal:Boolean = false;
			
			[Bindable]
			public function get isNormalAbnormal():Boolean
			{
				return _isNormalAbnormal;
			}
			
			public function set isNormalAbnormal(value:Boolean):void
			{
				_isNormalAbnormal = value;
				if(value)
				{
					id_YesBtn.setStyle("skinClass", NRadioButton);
					id_NoBtn.setStyle("skinClass", ARadioButton); // abnormal
				}
				else
				{
					id_YesBtn.setStyle("skinClass", YRadioButton);
					id_NoBtn.setStyle("skinClass", NRadioButton);
				}
			}
			
			[Bindable]
			public function get skinFirstButton():Class
			{
				return _skinFirstButton;
			}
			
			public function set skinFirstButton(value:Class):void
			{
				_skinFirstButton = value;
			}
			
			public function get isChanged():Boolean
			{
				return _Changed;
			}
			
			public function set isChanged(value:Boolean):void
			{
				_Changed = value;
			}
			
			public function get SwapYesNo():Boolean
			{
				return swap;
			}
			
			public function set SwapYesNo(value:Boolean):void
			{
				swap = value;
			}
			
			public function get isYes():String
			{
				return _isYes;
			}
			
			public function set isYes(value:String):void
			{
				if (_isYes != value)
					_isYes = value;
			}
			
			public function get property():String
			{
				return _property;
			}
			
			public function set property(value:String):void
			{
				_property = value;
			}
			
			override public function set data(value:Object):void
			{
				super.data = value;
				_dataChanged = true;
				
				invalidateProperties();
			}
			
			private function yesNoItemClickHandler(event:ItemClickEvent):void
			{
				isChanged = true;
				
				if(event.item == "yes")
				{
					_isYes = Constants.STRING_TRUE;
					//dispatchEvent( new Event( "yesItemCliked", true, false ) );
				}
				else
					_isYes = Constants.STRING_FALSE;
				
				
				if (data && _property)
				{
					if (data.hasOwnProperty(_property))
					{
						if( SwapYesNo )//false means yes, do nothing, edit event will be handled 
						{
							/* if( data[_property] is String )
							data[_property] = _isYes == Constants.STRING_TRUE? Constants.STRING_FALSE : Constants.STRING_TRUE;
							else if( data[_property] is Boolean )
							data[_property] = _isYes == Constants.STRING_TRUE? false:true;
							else
							trace( "YesNoItemRenderer::yesNoItemClickHandler", "has some unknown value" ); */
							
						}
						else
						{
							if( data[_property] is String )
								data[_property] = _isYes;
							else if( data[_property] is Boolean )
								data[_property] = _isYes == Constants.STRING_TRUE ? true:false;
							else
								trace( "YesNoItemRenderer::yesNoItemClickHandler", "has some unknown value" );
						}
						if (data.hasOwnProperty("IsDirty"))
						{
							data["IsDirty"] = true;
						}
					}
				}
			}
			
			override protected function commitProperties():void
			{
				super.commitProperties();
				
				if (_dataChanged)
				{
					_dataChanged = false;
					
					if (data && _property)
					{
						if (data.hasOwnProperty(_property))
						{
							_isYes = data[_property];
							
							if( SwapYesNo )
							{
								if (_isYes == Constants.STRING_FALSE)
									id_YesBtn.selected = true;
								else if (_isYes == Constants.STRING_TRUE)
									id_NoBtn.selected = true;
							}
							else
							{
								if (_isYes == Constants.STRING_TRUE)
									id_YesBtn.selected = true;
								else if (_isYes == Constants.STRING_FALSE)
									id_NoBtn.selected = true;
							}
						}
					}
					else if ( null == _property )
					{
						id_NoBtn.selected = false;
						id_YesBtn.selected = false;
					}
				}
			}
		]]>
	</fx:Script>
	<s:HGroup width="100%" height="100%" gap="0" horizontalAlign="center" verticalAlign="middle">
		<s:RadioButton id="id_YesBtn" groupName="yesNoGrp" value="yes" skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.YRadioButton"/>
		<s:RadioButton id="id_NoBtn" groupName="yesNoGrp" value="no" skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.NRadioButton"/>
	</s:HGroup>
</s:MXItemRenderer>
