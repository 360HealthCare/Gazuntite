			private function comboChangeHandler(event:Event):void
			{
				var combo:LabelComboBox = LabelComboBox(event.currentTarget);
				
				id_Add.enabled = isGetEdited();
				
				if (combo.id == "id_TestType")
				{
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
					
				else if (combo.id == "id_TestCode")
				{
					id_TestName.textInput.text = "";
					
					var selectedCodeDTO:LabOutLIONICLabTestDTO = id_TestCode.selectedItem as LabOutLIONICLabTestDTO;
					id_TestName.selectedItem = selectedCodeDTO;
					
					if (id_TestName.dataProvider)
						id_TestName.selectedIndex = id_TestName.dataProvider.getItemIndex(selectedCodeDTO);
					
					if (id_TestCode.dataProvider)
						id_TestCode.selectedIndex = id_TestCode.dataProvider.getItemIndex(selectedCodeDTO);
					
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
					
				else if (combo.id == "id_TestName")
				{
					id_TestCode.textInput.text = "";
					
					var selectedNameDTO:LabOutLIONICLabTestDTO = id_TestName.selectedItem as LabOutLIONICLabTestDTO;
					id_TestCode.selectedItem = selectedNameDTO;
					
					if (id_TestCode.dataProvider)
						id_TestCode.selectedIndex = id_TestCode.dataProvider.getItemIndex(selectedNameDTO);
					
					if (id_TestName.dataProvider)
						id_TestName.selectedIndex = id_TestName.dataProvider.getItemIndex(selectedNameDTO);
					
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
					
				else if (combo.id == "id_Laboratory")
				{
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
				else if(combo.id == "id_OrderMethod")
				{
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
			}
			
			private function comboKeyUpHandler(event:Event):void
			{
				var combo:LabelComboBox = LabelComboBox(event.currentTarget);
				var testType:LabOutTestTypeDTO;
				var testTypeId:int = 0;
				
				id_Add.enabled = isGetEdited();
				
				if (combo.id == "id_AssociatedDiagnosis")
				{
					/* var searchString:String = id_AssociatedDiagnosis.textInput.text;
					if(searchString.length == 2 || searchString.length == 5 || searchString.length == 7 || searchString.length >= 9 )
					{
					var icdEvent : LoadICDCodeEvent = new LoadICDCodeEvent(searchString);
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );					
					
					} */
				}
				else if (combo.id == "id_TestCode")
				{	
					if(id_TestType.selectedIndex >= 0)
					{
						testType = id_TestType.selectedItem as LabOutTestTypeDTO;
						testTypeId = testType.ID;							
					}
					
					var searchCodeString:String = id_TestCode.textInput.text;
					if(searchCodeString.length > 2)
					{
						var loinCodeEvent : LoadLIONICLabTestTypeEvent = new LoadLIONICLabTestTypeEvent(searchCodeString, testTypeId);
						CairngormEventDispatcher.getInstance().dispatchEvent( loinCodeEvent );
					}
				}				
				else if (combo.id == "id_TestName")
				{
					if(id_TestType.selectedIndex >= 0)
					{
						testType = id_TestType.selectedItem as LabOutTestTypeDTO;
						testTypeId = testType.ID;							
					}
					
					var searchNameString:String = id_TestName.textInput.text;
					if(searchNameString.length > 2)
					{
						var loinNameEvent : LoadLIONICLabTestTypeEvent = new LoadLIONICLabTestTypeEvent(searchNameString, testTypeId);
						CairngormEventDispatcher.getInstance().dispatchEvent( loinNameEvent );
					}
				}
				
			}
			
