		<validators:ComboValidator id="comboValidator"/>
		<validators:ComboValidator id="associatedDiagnosisValidator" source="{id_AssociatedDiagnosis}" property="selectedItem" error="Select valid associated diagnosis"/>
		<validators:ComboValidator id="priorityValidator" source="{id_Priority}" property="selectedItem" error="Select valid priority"/>
		<validators:ComboValidator id="specimenValidator" source="{id_Specimen}" property="selectedItem" error="Select valid specimen"/>
		<validators1:FutureDateValidator id="collectionDateValidator" source="{id_CollectionDate}" property="text" error="Select valid collection date"/>
		<validators:ComboValidator id="laboratoryValidator" source="{id_Laboratory}" property="selectedItem" error="Select valid laboratory"/>
		
