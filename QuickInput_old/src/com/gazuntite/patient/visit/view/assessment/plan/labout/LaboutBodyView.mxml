			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				isGetEdited();
				
				if ((id_TestType.selectedIndex != -1 || id_TestType.selectedItem != null) &&
					(id_OrderMethod.selectedIndex != -1 || id_OrderMethod.selectedItem != null) &&
					(id_TestCode.selectedIndex != -1 || id_TestCode.selectedItem != null) &&
					(id_TestName.selectedIndex != -1 || id_TestName.selectedItem != null) &&
					(id_Laboratory.selectedIndex != -1 || id_Laboratory.selectedItem != null))
					return true;
				
				return false;
			}
			
			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if ((id_TestType.selectedIndex != -1  || id_TestType.textInput.text.length) || 
					(id_OrderMethod.selectedIndex != -1  || id_OrderMethod.textInput.text.length) ||
					(id_TestCode.selectedIndex != -1 || id_TestCode.textInput.text.length) ||
					(id_TestName.selectedIndex != -1 || id_TestName.textInput.text.length) ||
					id_Description.text.length ||
					(id_AssociatedDiagnosis.selectedIndex != -1 || id_AssociatedDiagnosis.textInput.text.length) ||
					(id_Specimen.selectedIndex != -1 || id_Specimen.textInput.text.length) ||
					(id_Priority.selectedIndex != -1 || id_Priority.textInput.text.length) ||
					(id_Laboratory.selectedIndex != -1 || id_Laboratory.textInput.text.length))
				{
					
					edited = true;
				}
				
				return edited;
			}
			
			private var recordGridNotesPopUp:NotesPanel;
			private var section:String;
			
			private function onWriteNotesClick(event:Event):void
			{
				if (!recordGridNotesPopUp)
					recordGridNotesPopUp = new NotesPanel();
				
				if (!recordGridNotesPopUp.isPanelShown)
				{
					var headingLabel:String = "";
					
					
					
					var addRecord:AddRecord = AddRecord(event.target);
					
					recordGridNotesPopUp 				= new NotesPanel();
					recordGridNotesPopUp.width			= 250;
					recordGridNotesPopUp.height			= 110;
					recordGridNotesPopUp.HeadingLable 	= id_TestName.textInput.text;
					recordGridNotesPopUp.VisitDateLable = UtilityFunctions.FormatDate(model.VisitDate, "MM-DD-YYYY");//new Date().toDateString();
					recordGridNotesPopUp.ShowPopup(this);
					
					
					
					recordGridNotesPopUp.notesDTO		=  addRecord.notesDTO; //gridNotesDTO;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					
					var pt:Point = id_Add.localToGlobal(new Point(id_Add.id_WriteNotes.x ,id_Add.id_WriteNotes.y));
					
					recordGridNotesPopUp.move(pt.x - 195, pt.y + 20);
					
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);								
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
						}
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
					
					
					recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);								
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
						}
					});
				}
			}
			
			private var recordLevelDicPanel:DictationPopup;
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.LAB_OUT);
				recordLevelDicPanel.move( recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.LAB_OUT);
					
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
			}
			
			public function areRequiredFieldsProvided():Boolean
			{	
				var result:Boolean = true;
				
				id_TestType.errorString 			= "";
				id_TestType.errorString 			= "";
				id_Laboratory.errorString 			= "";
				id_Specimen.errorString 			= "";
				id_Priority.errorString 			= "";
				id_AssociatedDiagnosis.errorString 	= "";
				id_TestName.errorString 			= "";
				id_TestCode.errorString 			= "";
				id_OrderMethod.errorString 			= "";
				
				if (!UtilityFunctions.IsNullOrEmpty(id_TestType.selectedItem))
				{
					id_TestType.errorString = "invalid Test Type value";
					id_TestType.setFocus();
					result = false;
				}
				if (UtilityFunctions.IsNullOrEmpty(id_OrderMethod.selectedItem))
				{
					id_OrderMethod.errorString = "invalid OrderMethod value";
					id_OrderMethod.setFocus();
					result = false;
				}
				else if (UtilityFunctions.IsNullOrEmpty(id_TestCode.selectedItem))
				{
					id_TestCode.errorString = "invalid Test Code value";
					id_TestCode.setFocus();
					result = false;
				}
				else if (UtilityFunctions.IsNullOrEmpty(id_TestName.selectedItem))
				{
					id_TestName.errorString = "invalid Test Name value";
					id_TestName.setFocus();
					result = false;
				}
				else if (UtilityFunctions.IsNullOrEmpty(id_AssociatedDiagnosis.selectedItem))
				{
					id_AssociatedDiagnosis.errorString = "invalid Associated Diagnosis value";
					id_AssociatedDiagnosis.setFocus();
					result = false;
				}
				else if (UtilityFunctions.IsNullOrEmpty(id_Priority.selectedItem))
				{
					id_Priority.errorString = "invalid Test Priority";
					id_Priority.setFocus();
					result = false;
				}
				else if (UtilityFunctions.IsNullOrEmpty(id_Specimen.selectedItem))
				{
					id_Specimen.errorString = "invalid Specimen value";
					id_Specimen.setFocus();
					result = false;
				}
				else if (UtilityFunctions.IsNullOrEmpty(id_Laboratory.selectedItem))
				{
					id_Laboratory.errorString = "invalid Laboratory value";
					id_Laboratory.setFocus();
					result = false;
				}
				
				return result;
			}
			
			private function onAddRecordClick(event:Event):void
			{
				id_Add.enableAll = !areRequiredFieldsProvided();
				if (!id_add.enabled )
				{
					return; // invalid data
				}
				
				AddLab();
				
				id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
				id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
			}
				
			private function AddLab():void
			{
				var labObj:LabDTO = new LabDTO();
				
				if (id_TestType.selectedIndex >= 0)
					labObj.LabTestType = id_TestType.selectedItem;
				
				if(id_OrderMethod.selectedIndex >= 0 )
					labObj.LabTestOrderMethodType = id_OrderMethod.selectedItem;
				
				labObj.IsLabIn = false;
				
				if(id_TestCode.selectedIndex >= 0)
					labObj.LIONICLabTestType = id_TestCode.selectedItem;
				
				labObj.Description = id_Description.text;
				
				if(id_AssociatedDiagnosis.selectedIndex >= 0)
					labObj.ICDCode = id_AssociatedDiagnosis.selectedItem;
				
				if(id_Priority.selectedIndex >= 0)
					labObj.LabTestPriorityType = id_Priority.selectedItem;
				
				if(id_Specimen.selectedIndex >= 0)
					labObj.LabTestSpecimenType = id_Specimen.selectedItem;
				
				if(id_CollectionDate.text != '')					
					labObj.CollectionDate = id_CollectionDate.text;//selectedDate;
				
				if(id_Laboratory.selectedIndex >= 0)
					labObj.LabType = id_Laboratory.selectedItem;
				
				labObj.CreatedAt = new Date();
				
				if( id_Yes.selected)
					labObj.IsFasting = Constants.STRING_TRUE;
					
				else if (id_No.selected)
					labObj.IsFasting = Constants.STRING_FALSE;
				
				labObj.VisitDate = model.VisitDate;
				
				labObj.DictationID = Constants.GUID_FORMAT;				
				
				labObj.VisitID = model.VisitID;
				
				labObj.CreatedAt = new Date();
				labObj.CreatedBy = model.LoggedInUserId;
				
				labObj.PatientID = model.patientID;
				labObj.UserID = model.LoggedInUserId;
				labObj.ClinicBranchID = model.LoggedInUserSelectedBranchId;
				
				labObj.ModifiedAt = Constants.NULL_DATE;
				labObj.OrderDate = Constants.NULL_DATE.toDateString();
				labObj.Onset = Constants.NULL_DATE.toDateString();
				
				labObj.IsDirty = true;
				labObj.LabID = 0;
				labObj.StationID = model.LoggedInUserSelectedStationID;
				
				/* //Start Comment - Tahir Alvi - set three properties for HL7
				labObj.PatientID    		= model.loadedPatientId;
				labObj.ClinicBranchID    	= model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
				labObj.StationID    		= model.userSelectedStationDTO.StationID;
				labObj.UserID    		    = model.loggedInUserDTO.UserId;
				//END Comment - Tahir Alvi - set three properties for HL7 */
				
				
				if (id_Add.notesDTO)
				{
					labObj.Note = id_Add.notesDTO.Note;
					labObj.NoteSubject = id_Add.notesDTO.NoteSubject; 
				}
				
				if (id_Add.dictationDTO != null && id_Add.dictationDTO.DictationID != Constants.GUID_FORMAT)
				{
					labObj.DictationID = id_Add.dictationDTO.DictationID;
				}
				
				if(null == model.laboutDTOList)
					model.laboutDTOList = new ArrayCollection();
				
				model.laboutDTOList.addItem(labObj);
				
				var managelabOut : ManagePatientLabsEvent = new ManagePatientLabsEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( managelabOut );
				
				resetFields();
			}
			
			private function resetFields():void
			{
				id_TestType.textInput.text 				= "All";
				id_TestType.selectedIndex 				= 0;//-1; //all is selected
				id_TestType.setFocus();
				
				id_OrderMethod.textInput.text			= "";
				id_OrderMethod.selectedIndex			= -1;
				
				id_TestCode.textInput.text				= "";
				id_TestCode.selectedIndex				= -1;
				
				id_TestName.textInput.text				= "";
				id_TestName.selectedIndex				= -1;
				
				id_Description.text 					= "";
				
				id_AssociatedDiagnosis.textInput.text 	= "";
				id_AssociatedDiagnosis.selectedIndex	= -1;
				
				id_Priority.textInput.text 				= "";
				id_Priority.selectedIndex				= -1;
				
				id_Specimen.textInput.text				= "";
				id_Specimen.selectedIndex				= -1;
				
				id_CollectionDate.selectedDate			= null;
				id_CollectionDate.text					= "";
				
				id_Laboratory.textInput.text			= "";
				id_Laboratory.selectedIndex				= -1;
				
				id_Yes.selected							= false;
				id_No.selected							= false;
				
				id_Add.enabled							= false;
				id_Add.enableAll						= false;
				
				recordNotesDTO = new  ModuleNoteDTO();
				
				if (id_Add.notesDTO)
					id_Add.notesDTO = new ModuleNoteDTO ();
				
				if (id_Add.dictationDTO)
					id_Add.dictationDTO = new ModuleDictationDTO();
				
				if (recordNotesPanel)
					recordNotesPanel.removePopup();
			}
			
			public function associatedDiagnosisLabel(oItem:Object):String
			{
				var label:String = "";
				
				if (oItem && oItem.IcdDto )
				{
					if (oItem.hasOwnProperty("IcdDto"))
					{
						label += oItem.IcdDto.IcdCodeName + ", ";
					}
					
					if (oItem.hasOwnProperty("IcdDto"))
					{
						label += oItem.IcdDto.IcdCodeDescription;
					}
					
					label += oItem.IsChronic ? " (Chronic) " : " (Acute) ";
				}
				return label;
			}
			
			private function validateTestCode():void
			{
				isNotValid = isInValid();
			}
			
			public function isInValid():Boolean
			{	
				var notValid:Boolean = false;
				
				if (!ValidationUtils.isValidValueSelected(id_TestType))
					notValid = true;
				
				if (id_OrderMethod.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_OrderMethod))
					notValid = true;
					
				else if (!ValidationUtils.isValidValueSelected(id_TestCode))
					notValid = true;
					
				else if (!ValidationUtils.isValidValueSelected(id_TestName))
					notValid = true;
					
				else if (id_AssociatedDiagnosis.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_AssociatedDiagnosis))
					notValid = true;
					
				else if (id_Priority.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_Priority))
					notValid = true;
					
				else if (id_Specimen.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_Specimen))
					notValid = true;
				
				else if (!ValidationUtils.isValidValueSelected(id_Laboratory))
					notValid = true;
				
				return notValid;
			}
			
			public function loadGridData():void
			{
				if(UtilityFunctions.IsNullOrEmpty(model.laboutDTOList))
				{
					var lplabOut : LoadPatientLabsByVisitEvent = new LoadPatientLabsByVisitEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( lplabOut );
				}
				
				loadstaticData();
			}
			
			public function loadstaticData():void
			{
				
				if(model.labTestTypeDTOList==null || model.labTestTypeDTOList.length==0)
				{
					var llttEvent : LoadLabTestTypeStaticDataEvent = new LoadLabTestTypeStaticDataEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( llttEvent );
				}
				
				if(model.labTestSpecimenTypeDTOList==null || model.labTestSpecimenTypeDTOList.length==0)
				{
					var lltsEvent : LoadLabSpecimenTypeStaticDataEvent = new LoadLabSpecimenTypeStaticDataEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( lltsEvent );
				}
				
				if(model.labTypeDTOList==null || model.labTypeDTOList.length==0)
				{
					var ltsEvent : LoadLabTypeStaticDataEvent = new LoadLabTypeStaticDataEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( ltsEvent );
				}
				
				if(model.labTestOrderMethodTypeDTOList==null || model.labTestOrderMethodTypeDTOList.length==0)
				{
					var ltomEvent : LoadLabTestOrderMethodTypeEvent = new LoadLabTestOrderMethodTypeEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( ltomEvent );
				}
				
				if(model.labPriorityTypeDTOList==null || model.labPriorityTypeDTOList.length==0)
				{
					var LPTEvent : LoadLabPriorityTypeEvent = new LoadLabPriorityTypeEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( LPTEvent );
				}
			}
			
