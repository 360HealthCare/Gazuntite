			private function doValidation():void
			{
					//bindData();
				
				if( isInvalid() )
				{
					id_Add.enableAll = false;
					return;
				}
				
				id_Add.enableAll = true;
				id_Add.enabled = true;
			}
			
			private function followUpDateKeyUpHandler():void
			{
				doValidation();
				
				var searchStr:String = id_FollowUpDate.textInput.text;
				
				if (searchStr.length > 2)
				{		
					var lfmtEvent:LoadFollowUpServiceTypeEvent= new LoadFollowUpServiceTypeEvent(QIConstants.FOLLOWUP_DATE_ID, searchStr);//date ID is 2 for date dictionaries
					CairngormEventDispatcher.getInstance().dispatchEvent( lfmtEvent );
				}
			}
			
			private function followUpServiceKeyUpHandler():void
			{
				doValidation();
				
				var searchStr:String = id_Service.textInput.text;
				
				if (searchStr.length > 2)
				{
					var lfmtEvent:LoadFollowUpServiceTypeEvent= new LoadFollowUpServiceTypeEvent(QIConstants.FOLLOWUP_SERVICE_ID, searchStr);//serviceID is 1 for service dictionaries
					CairngormEventDispatcher.getInstance().dispatchEvent( lfmtEvent );
				}
			}
			
			public function labelFunction(item:Object) : String
			{
				if ( item )
					return item.LabTestDescription + ", " + item.TestCode  ;
				else
					return "";
			}
			
			
			private var recordGridNotesPopUp:NotesPanel;
			private var section:String = QIPopUpManager.FOLLOW_UP_INSTRUCTIONS;
			private function onWriteNotesClick(event:Event):void
			{
				if (!recordGridNotesPopUp)
					recordGridNotesPopUp = new NotesPanel();
				
				if (!recordGridNotesPopUp.isPanelShown)
				{
					var headingLabel:String = "";
					
					var addRecord:AddRecord = AddRecord(event.target);
					
					recordGridNotesPopUp 				= new NotesPanel();
					recordGridNotesPopUp.width			= 250;
					recordGridNotesPopUp.height			= 110;
					recordGridNotesPopUp.HeadingLable 	= "Follow Up";
					recordGridNotesPopUp.VisitDateLable = UtilityFunctions.FormatDate(model.VisitDate, "MM-DD-YYYY");//new Date().toDateString();
					recordGridNotesPopUp.ShowPopup(this);
					
					recordGridNotesPopUp.notesDTO		=  addRecord.notesDTO; //gridNotesDTO;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					var pt:Point = id_Add.localToGlobal(new Point(id_Add.id_WriteNotes.x ,id_Add.id_WriteNotes.y));
					
					recordGridNotesPopUp.move(pt.x - 195, pt.y + 20);
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);
							
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
							
						}
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
				}
				
			}
			
			private var recordLevelDicPanel:DictationPopup;
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.LAB_OUT);
				recordLevelDicPanel.move( recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.LAB_OUT);
					
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
				
			}
		
			private function bindData():void
			{
				/*if( isInvalid() )
				{
					trace( "followup data is invalid" );
					id_Add.enableAll = false;
					return;
				}
				id_Add.enableAll = true;*/
				
				if(PatientFollowup ==  null)
				{
					PatientFollowup = new PatientFollowupMergedDTO();
				}
				
				if( id_ByDate.selected )
				{
					PatientFollowup.IsByDate 				= true;				
					PatientFollowup.IsOnCompletion 			= false;
					
					if(id_FollowUpDate != null && id_FollowUpDate.textInput.text.length > 2 )
					{
						PatientFollowup.FollowUpDate = id_FollowUpDate.textInput.text;//.selectedDate;
					}
					
				}
				else if( id_OnCompletion.selected )
				{
					PatientFollowup.IsByDate 				= false;				
					PatientFollowup.IsOnCompletion 			= true;
					
					if(id_ddlLabs.selectedItem)
					{
						PatientFollowup.labtest 				= id_ddlLabs.selectedItem as GeneralTypeDTO;// .LabTestType.LabTestTypeID; on W. Baber 					
						PatientFollowup.IsLabTestSelected 		= true;
						PatientFollowup.IsDrugselected 			= false;
					}
					else
					{
						PatientFollowup.labtest.ID = -1;
					}
					
					if(id_ddlDrugs.selectedItem)
					{	
						PatientFollowup.drug = id_ddlDrugs.selectedItem as GeneralTypeDTO;//.PatientMedicationPrescribedID;on W. Baber 
						PatientFollowup.IsDrugselected =  true;
						
						PatientFollowup.IsLabTestSelected =  false;
					}
					else
					{
						PatientFollowup.drug.ID = -1;
					}
				}
				
				if(PatientFollowup.followupMethodType==null)
					PatientFollowup.followupMethodType = new GeneralTypeDTO();
				//M
				if(id_Office.selected)
				{
					PatientFollowup.followupMethodType = (QIUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.OFFICE_FOLLOWUP_METHOD_NAME) as GeneralTypeDTO) ;
				}
				else if(id_Phone.selected)
				{
					PatientFollowup.followupMethodType = (QIUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.PHONE_FOLLOWUP_METHOD_NAME) as GeneralTypeDTO) ;
				}
				else if(id_Email.selected)
				{
					PatientFollowup.followupMethodType = (QIUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.EMAIL_FOLLOWUP_METHOD_NAME) as GeneralTypeDTO) ;
				}
				else if(id_Chat.selected)
				{
					PatientFollowup.followupMethodType = (QIUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.CHAT_FOLLOWUP_METHOD_NAME) as GeneralTypeDTO) ;
				}
				else if(id_Video.selected)
				{
					PatientFollowup.followupMethodType = (QIUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.VIDEO_FOLLOWUP_METHOD_NAME) as GeneralTypeDTO) ;
				}
				
				
				PatientFollowup.IsAcute = id_Acute.selected;
				PatientFollowup.IsChronic = id_Chronic.selected;
				PatientFollowup.IsPreventive = id_Preventive.selected;
				
				if( id_Service.selectedIndex >= 0 )
				{
					if(PatientFollowup.objServiceTypeDTO == null)
						PatientFollowup.objServiceTypeDTO = new FollowUpServiceTypeDTO();
					if(id_Service.selectedItem)
						PatientFollowup.objServiceTypeDTO = id_Service.selectedItem as FollowUpServiceTypeDTO;
				}
				else
				{
					var serviceDto:FollowUpServiceTypeDTO 		= new FollowUpServiceTypeDTO();
					serviceDto.followUpService 	  		= id_Service.textInput.text;
					PatientFollowup.objServiceTypeDTO 	= serviceDto;
				}
				
				if (id_FreqAge.selected)
				{
					PatientFollowup.IsAgeSelected = true;
					PatientFollowup.IsDurationSelected = false;
					
					if(id_AgeType.selectedItem)
					{
						PatientFollowup.AgeType = id_AgeType.selectedItem as GeneralTypeDTO;
						PatientFollowup.AgeValueType = id_AgeValue.selectedItem as GeneralTypeDTO;
					}
				}
				else if (id_FreqDuration.selected)
				{
					PatientFollowup.IsAgeSelected = false;
					PatientFollowup.IsDurationSelected = true;
					
					PatientFollowup.AfterDurationValue = parseInt(id_AfterDurationValue.text);
					
					if(id_AfterDurationType.selectedItem)
					PatientFollowup.AfterInstructionDurationTypeDTO = id_AfterDurationType.selectedItem as GeneralTypeDTO;
					
					PatientFollowup.ForDurationValue = parseInt(id_ForDurationValue.text);
					
					if(id_ForDurationType.selectedItem)
					PatientFollowup.ForInstructionDurationTypeDTO = id_ForDurationType.selectedItem as GeneralTypeDTO;
				}
				
				PatientFollowup.IsPRN = id_PRN.selected;
				
				PatientFollowup.VisitDate = model.VisitDate;
				PatientFollowup.VisitID = model.VisitID;;
				PatientFollowup.PatientID = model.patientID;
				PatientFollowup.CreatedBy = model.LoggedInUserId;
				PatientFollowup.CreatedAt = new Date();
				PatientFollowup.ModifiedAt = Constants.NULL_DATE;
				PatientFollowup.DictationID = Constants.GUID_FORMAT;
				PatientFollowup.ClinicBranchId = model.LoggedInUserSelectedBranchId;
				PatientFollowup.CreatedByUserTypeID = model.LoggedInUserProviderTypeId;
				PatientFollowup.IsDirty = 	true;
				
				if (id_Add.notesDTO)
				{
					PatientFollowup.Note 		= id_Add.notesDTO.Note;
					PatientFollowup.NoteSubject = id_Add.notesDTO.NoteSubject;
				}
				
				if (id_Add.dictationDTO != null && id_Add.dictationDTO.DictationID != Constants.GUID_FORMAT)
				{
					PatientFollowup.DictationID = id_Add.dictationDTO.DictationID;
				}
				
			}
			
			private function addRecordClickHandler():void
			{
				if (isInvalid())
				{
					id_Add.enableAll = false;
					return;
				}
				
				if( null == model.PatientFollowupMerged )
					model.PatientFollowupMerged = new ArrayCollection();
				
				/* if(!PatientFollowup.followupMethodType)
					PatientFollowup.followupMethodType = new GeneralTypeDTO();
				
				PatientFollowup.followupMethodType.ID = 0; */
				bindData();
				model.PatientFollowupMerged.addItemAt(PatientFollowup, 0);
				
				var followupEvent:ManagePatientFollowupMergedEvent = new ManagePatientFollowupMergedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(followupEvent);
				
				if(hasViewChanged)
					hasViewChanged = false;
				
				hasViewChanged = true;
				resetFields();
			}
			
