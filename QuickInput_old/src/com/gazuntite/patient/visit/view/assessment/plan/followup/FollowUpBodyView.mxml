			private function isFrequencyValid():Boolean
			{
				if (id_PRN.selected)
					return true;
				
				if (id_FreqAge.selected)
				{
					if (!ValidationUtils.isValidValueSelected(id_AgeType))
					{
						return false;
					}	
					
					if (!ValidationUtils.isValidValueSelected(id_AgeValue))
					{
						return false;
					}
					
					return true;
				}
				
				if (id_FreqDuration.selected)
				{
					ValidationUtils.Trim(id_AfterDurationValue);
					ValidationUtils.Trim(id_ForDurationValue);
					
					var afterVal:Number = Number(id_AfterDurationValue.text);
					var forVal:Number = Number(id_ForDurationValue.text);
					
					if (isNaN(afterVal))
					{
						return false;
					}
					
					if (!ValidationUtils.isValidValueSelected(id_AfterDurationType))
					{
						return false;
					}
					
					if (isNaN(forVal))
					{
						return false;
					}
					
					if (!ValidationUtils.isValidValueSelected(id_ForDurationType))
					{
						return false;
					}
					
					return true;
				}
				
				return false;
			}
			
			private function resetFields():void
			{
				PatientFollowup = null;
				
				id_Add.enableAll = false;
					
				id_grpByDate.visible 		= true;
				id_grpOnComplition.visible 	= false;
				
				id_ByDate.selected = true;
				id_Chronic.selected = true;
				
				id_FollowUpDate.selectedIndex = -1;
				id_FollowUpDate.textInput.text = "";
				
				id_Service.selectedItem = null;
				id_Service.textInput.text = "";
				
				//id_FreqAge.selected = true;
				id_FrequencyViews.selectedIndex = 0;
				
				id_PRN.selected = false;
				id_Chronic.selected = true;
				id_Office.selected = true;
				
				if (id_AgeType)
				{
					id_AgeType.selectedItem = null;
					id_AgeType.textInput.text = "";
				}
				
				if (id_AgeValue)
				{
					id_AgeValue.selectedItem = null;
					id_AgeValue.textInput.text = "";
				}
				
				if (id_AfterDurationType)
				{
					id_AfterDurationType.selectedItem = null;
					id_AfterDurationType.textInput.text = "";
				}
				
				if (id_AfterDurationValue)
					id_AfterDurationValue.text = "";
				
				if (id_ForDurationType)
				{
					id_ForDurationType.selectedItem = null;
					id_ForDurationType.textInput.text = "";
				}
				
				if (id_ForDurationValue)
					id_ForDurationValue.text = "";
				
				
				if ( id_Add.notesDTO != null )
				{
					id_Add.notesDTO = null;
				}
				
				if ( id_Add.dictationDTO != null )
				{
					id_Add.dictationDTO = null 
				}
				
				id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
				id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
			}
			
			protected function rbGroup_itemClickHandler(event:ItemClickEvent):void
			{
				//bindData();
				
				if( isInvalid() )
				{
					id_Add.enableAll = false;
					return;
				}
				
				id_Add.enableAll = true;
			}
			
			protected function rbSection_itemClickHandler(event:ItemClickEvent):void
			{
				if( event.item == "LabTest" )
				{
					id_ddlLabs.enabled 	= true;
					id_ddlDrugs.enabled = false;
					id_ddlLabs.setFocus();
				}
				else
				{
					id_ddlDrugs.enabled = true;
					id_ddlLabs.enabled 	= false;
					id_ddlDrugs.setFocus();
				}
			}
			
			private function frequencyItemClickHandler(event:ItemClickEvent):void
			{
				if (event.item == "age")
					id_FrequencyViews.selectedIndex = 0;
				else
					id_FrequencyViews.selectedIndex = 1;
				
			}
			
			private function id_OptionType_changeHandler(event:ItemClickEvent):void
			{
				//bindData();
				
				if( isInvalid() )
				{
					id_Add.enableAll = false;
					return;
				}
				
				id_Add.enableAll = true;
			}
			
			protected function id_FollowUpType_changeHandler(event:ItemClickEvent):void
			{
				if( event.item == "ByDate" )
				{
					id_grpByDate.visible 		= true;
					id_grpOnComplition.visible 	= false;	
				}
				
				else if( event.item == "OnCompletion" )
				{
					id_grpByDate.visible 		= false;
					id_grpOnComplition.visible 	= true;
					
					id_ddlLabs.enabled 			= true;
					id_ddlDrugs.enabled 		= false;
					id_rbLabTest.selected 		= true;
					
					id_ddlLabs.setFocus();
					
				}
			}
			
			public function loadGridData():void
			{
				if(UtilityFunctions.IsNullOrEmpty(model.followUpDataControlType))
				{
					var lfdcEvent : LoadFollowupDataControlTypeEvent= new LoadFollowupDataControlTypeEvent(LoadStaticData);
					CairngormEventDispatcher.getInstance().dispatchEvent( lfdcEvent );
				}				
			}
				
			private function LoadStaticData():void
			{	
				if(model.followUpinstructionAgeTypeDTOList==null || model.followUpinstructionAgeTypeDTOList.length==0)
				{
					var fuiaEvent : LoadFollowUpInstructionAgeTypesEvent= new LoadFollowUpInstructionAgeTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( fuiaEvent );
				}
				
				if(model.instructionAgeValueTypeDTOList==null || model.instructionAgeValueTypeDTOList.length==0)
				{
					var fuiavEvent : LoadFollowUpInstructionAgeValueTypesEvents= new LoadFollowUpInstructionAgeValueTypesEvents();
					CairngormEventDispatcher.getInstance().dispatchEvent( fuiavEvent );
				}
				
				if(model.instructionAgeValueTypeDTOList==null || model.instructionAgeValueTypeDTOList.length==0)
				{
					var fuidEvent : LoadFollowupInstructionDurationTypeEvent= new LoadFollowupInstructionDurationTypeEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( fuidEvent );
				}
				
				if(model.instructionAgeValueTypeDTOList==null || model.instructionAgeValueTypeDTOList.length==0)
				{
					var fumtEvent : LoadFollowUpMethodTypeEvent= new LoadFollowUpMethodTypeEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( fumtEvent );
				}
				
				if(model.PatientFollowupMerged==null || model.PatientFollowupMerged.length==0)
				{
					var lfmEvent : LoadFollowUpMergeByVisitIdEvent= new LoadFollowUpMergeByVisitIdEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( lfmEvent );
				}
			}
			
			protected function id_ddlDrugs_openHandler(event:DropDownEvent):void
			{
				if(model.PatientMedicationDTOlist.length <= 0 && model.gaxenID != '')
				{
					var ve:GetPatientAllMedEvent = new GetPatientAllMedEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent(ve);
				}
					
			}
			
			protected function NotesDictationSavedFromGrid(event:Event):void
			{
				var evn:ManagePatientFollowupMergedEvent = new ManagePatientFollowupMergedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(evn);
			}
			
			protected function cc(event:FlexEvent):void
			{
				gridView.addEventListener("NotesSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
				gridView.addEventListener("DictationSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
			}
			
