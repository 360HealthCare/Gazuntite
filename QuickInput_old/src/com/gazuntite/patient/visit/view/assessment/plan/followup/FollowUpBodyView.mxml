	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="rbGroup" itemClick="rbGroup_itemClickHandler(event)" 		/>
		<s:RadioButtonGroup id="rbSection" itemClick="rbSection_itemClickHandler(event)" 	/>
		<s:RadioButtonGroup id="frequencyGrp" itemClick="frequencyItemClickHandler(event)"	/>
		<s:RadioButtonGroup id="rbOptionType" itemClick="id_OptionType_changeHandler(event)" />
		<s:RadioButtonGroup id="id_FollowUpType" itemClick="id_FollowUpType_changeHandler(event)" />
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="5" paddingRight="5" paddingLeft="5"/>
	</s:layout>
	<s:HGroup>
		<s:RadioButton id="id_ByDate" label="By Date" value="ByDate" selected="true" fontFamily="Calibri" fontSize="11"
					   groupName="id_FollowUpType"
					   buttonMode="true" useHandCursor="true" toolTip="By Date" color="#ffffff" />
		<s:RadioButton id="id_OnCompletion" label="Upon Completion of" value="OnCompletion" fontFamily="Calibri" fontSize="11"
					   groupName="id_FollowUpType" 
					   buttonMode="true" useHandCursor="true" toolTip="Upon Completion of" color="#ffffff" />
	</s:HGroup>
	<s:HGroup width="100%" gap="3" >
		<s:VGroup>
			
			<s:HGroup id="id_grpByDate">
				<components:LabelComboBox id="id_FollowUpDate" prompt="Date" width="150" change="doValidation()" keyUp="followUpDateKeyUpHandler()" includeInLayout="{id_grpByDate.visible}"
										  dataProvider="{model.followUpServiceDateList}" labelField="followUpService"/>
			</s:HGroup>
			
			<s:HGroup id="id_grpOnComplition" gap="20" visible="false" includeInLayout="{id_grpOnComplition.visible}" >
				<s:VGroup gap="20" >
					<s:HGroup>	
						<s:Label text="Lab Test" fontFamily="Calibri" fontSize="11" color="#ffffff" />
						<s:RadioButton id="id_rbLabTest" label="Lab Test" groupName="rbSection" value="LabTest" visible="true" fontFamily="Calibri" fontSize="11" 
									   skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn" buttonMode="true" useHandCursor="true"/>
					</s:HGroup>
					<s:HGroup>
						<s:Label text="Drug" fontFamily="Calibri" fontSize="11" color="#ffffff" paddingRight="15" verticalAlign="middle" />
						<s:RadioButton id="id_rbDrug" label="Drug" groupName="rbSection" value="Drug" visible="true" fontFamily="Calibri" fontSize="11" 
									   skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn" buttonMode="true" useHandCursor="true"/>
					</s:HGroup>
				</s:VGroup>
				<s:VGroup gap="2">
					<components:LabelComboBox id="id_ddlLabs" width="150"  labelFunction="labelFunction" 
											  change="doValidation()" keyUp="doValidation()" tabIndex="1" /><!--dataProvider="{model.followupLabsDTOList}" -->
					<components:LabelComboBox id="id_ddlDrugs" width="150"  labelField="DrugName" 
											  change="doValidation()" keyUp="doValidation()" open="id_ddlDrugs_openHandler(event)" tabIndex="3" dataProvider="{model.PatientMedicationDTOlist}"/>
				</s:VGroup>
			</s:HGroup >
			<s:HGroup>
				<s:RadioButton id="id_Chronic" label="Chronic" groupName="rbOptionType" value="Chronic" visible="true" fontFamily="Calibri" fontSize="11" selected="true"
							   buttonMode="true" useHandCursor="true" tabIndex="2" color="#ffffff"/>
				<s:RadioButton id="id_Preventive" label="Preventive" groupName="rbOptionType" value="Preventive" visible="true" fontFamily="Calibri" fontSize="11"
							   buttonMode="true" useHandCursor="true" color="#ffffff"/>
				<s:RadioButton id="id_Acute" label="Acute" groupName="rbOptionType" value="Acute" visible="true" fontFamily="Calibri" fontSize="11"
							   buttonMode="true" useHandCursor="true" color="#ffffff"/>
			</s:HGroup>
			
		</s:VGroup>
		
		<s:RadioButton id="id_Office" label="Office" groupName="rbGroup" value="Office" visible="true" fontFamily="Calibri" fontSize="11" selected="true"
					   buttonMode="true" useHandCursor="true" tabIndex="2" color="#ffffff"/>
		<s:RadioButton id="id_Phone" label="Phone" groupName="rbGroup" value="Phone" visible="true" fontFamily="Calibri" fontSize="11"
					   buttonMode="true" useHandCursor="true" color="#ffffff"/>
		<s:RadioButton id="id_Email" label="Email" groupName="rbGroup" value="Email" visible="true" fontFamily="Calibri" fontSize="11"
					   buttonMode="true" useHandCursor="true" color="#ffffff"/>
		<s:RadioButton id="id_Chat" label="Chat" groupName="rbGroup" value="Chat" visible="true" fontFamily="Calibri" fontSize="11"
					   buttonMode="true" useHandCursor="true" color="#ffffff"/>
		<s:RadioButton id="id_Video" label="Video" groupName="rbGroup" value="Video" visible="true" fontFamily="Calibri" fontSize="11"
					   buttonMode="true" useHandCursor="true" color="#ffffff"/>
		
		<s:HGroup width="100%">
			<commons:AddRecord id="id_Add" writeNotesClick="onWriteNotesClick(event)"  writeDictationClick="writeDictationClickHandler(event)" enabled="false" tabIndex="3" horizontalAlign="center" paddingLeft="10" />
		</s:HGroup>
	</s:HGroup>
	
	<s:VGroup width="100%" gap="2">
		<s:Label text="Post Visit Preventive and Wellness Instructions" fontFamily="Calibri" color="#ffffff"/>
		<s:HGroup width="100%">
			<components:LabelComboBox id="id_Service" prompt="Select Required Preventive and Wellness Service" width="100%" restrict="/[0-9a-zA-Z]*[.-_]]/"
									  labelField="followUpService" change="doValidation()" keyUp="followUpServiceKeyUpHandler()" dataProvider="{model.followUpServiceTypeList}" tabIndex="4"/><!---->
		</s:HGroup>
		<s:HGroup width="100%" verticalAlign="middle">
			<s:Label text="Frequency" height="23" verticalAlign="middle" fontFamily="Calibri" color="#ffffff"/>
			<s:RadioButton label="Age" id="id_FreqAge" value="age" groupName="frequencyGrp" fontFamily="Calibri" selected="true" height="23"
						   
						   buttonMode="true" useHandCursor="true" tabIndex="5" color="#ffffff" />
			<s:RadioButton label="Duration" id="id_FreqDuration" value="duration" groupName="frequencyGrp" fontFamily="Calibri" height="23"
						   buttonMode="true" useHandCursor="true" color="#ffffff"
						   />
			
			<s:CheckBox id="id_PRN" label="PRN" width="50" change="doValidation()" fontFamily="Calibri" color="#ffffff" />
			<mx:ViewStack id="id_FrequencyViews" width="100%" paddingLeft="5">
				<s:NavigatorContent width="100%">
					<s:layout>
						<s:HorizontalLayout/>
					</s:layout>
					
					<components:LabelComboBox id="id_AgeType" prompt="Age Type" width="120"  labelField="Name"
											  change="doValidation()" keyUp="doValidation()" tabIndex="6" dataProvider="{model.followUpinstructionAgeTypeDTOList}" />
					<components:LabelComboBox id="id_AgeValue" prompt="Age Value" width="100%"  change="doValidation()" keyUp="doValidation()" 
											   labelField="Name" tabIndex="7" dataProvider="{model.instructionAgeValueTypeDTOList}" /> 
				</s:NavigatorContent>
				<s:NavigatorContent width="100%">
					<s:layout>
						<s:HorizontalLayout/>
					</s:layout>
					<s:Label text="After Every:" height="23" verticalAlign="middle" fontFamily="calibri" color="#ffffff"/>
					<components:LabelTextInput id="id_AfterDurationValue" prompt="Value" width="55" height="23" change="doValidation()" keyUp="doValidation()"/>
					<components:LabelComboBox id="id_AfterDurationType" prompt="Type" width="100%"  labelField="Name"
											  change="doValidation()" keyUp="doValidation()" dataProvider="{model.followUpDurationTypeList}"/>
					
					<s:Label text="For:" height="23" verticalAlign="middle" fontFamily="calibri" color="#ffffff"/>
					<components:LabelTextInput id="id_ForDurationValue" prompt="Value" width="55" height="23" change="doValidation()" keyUp="doValidation()"/>
					<components:LabelComboBox id="id_ForDurationType" prompt="Type" width="100%"  labelField="Name"
											  change="doValidation()" keyUp="doValidation()"  dataProvider="{model.followUpDurationTypeList}"/>
				</s:NavigatorContent>
			</mx:ViewStack>
		</s:HGroup>
		<s:HGroup width="100%" >
			<s:Button id="id_AddRecord" click="addRecordClickHandler()" enabled="{id_Add.enableAll}" buttonMode="true" useHandCursor="true" 
					  toolTip="Add Record"  label="Add Follow Up"
					  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreTooltipBtn"  width="150" tabIndex="8"/>
			<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.tooltipBG" visible="{!id_Add.enabled}" width="100%" />
		</s:HGroup>
		<followup:FollowUpBodyGridView id="gridView" width="100%"/>
	</s:VGroup>
</s:Group>
