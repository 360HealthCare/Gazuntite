		<s:Button id="id_add" click="addRecordClickHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Add Record" width="135"
				  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreTooltipBtn" tabIndex="7" label="Add Diagnosis" enabled="{id_AddRecord.enabled}" />

		<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.tooltipBGContainer" width="100%" visible="{!id_add.enabled}" />
		<mx:Spacer width="100%"/>
		<s:Button id="id_nextBtn" label="Next" click="button1_clickHandler(event)" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QInextBtnSkin" toolTip="Next Section" buttonMode="true" />
