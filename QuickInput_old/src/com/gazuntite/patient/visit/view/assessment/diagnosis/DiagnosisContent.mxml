			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				var result:Boolean = false;
				
				if(id_Onset.text.length > 0 || id_Onset.selectedDate)
				{
					result = true;
					
					if( UtilityFunctions.IsNullOrEmpty( id_ICDCode.textInput.text ))// || UtilityFunctions.IsNullOrEmpty( id_ICDCode.selectedItem ) )
					{
						id_ICDCode.errorString = "invalid ICDCode value";
						id_ICDCode.setFocus();
						result = false;
					}
						
					else if( UtilityFunctions.IsNullOrEmpty( id_Diagnosis.textInput.text ))// &&  UtilityFunctions.IsNullOrEmpty( id_Diagnosis.selectedItem ) )
					{
						id_Diagnosis.errorString = "invalid Diagnosis value";
						id_Diagnosis.setFocus();
						result = false;
					}
				}
				else
				{
					id_Onset.errorString = "invalid Onset value";
					//id_Onset.setFocus();
					result = false;
				}
				
				return result;
			}
			
			private function addRecordClickHandler(event:Event):void
			{
				id_add.enabled = areRequiredFieldsProvidedAndValid();
				if( ! id_add.enabled )
				{
					return; // invalid data
				}
				
				var patientDiagnosisDTO:PatientDiagnosisDTO = new PatientDiagnosisDTO();
				
				if(id_ICDCode.textInput.text && id_Diagnosis.textInput.text)
				{
					patientDiagnosisDTO.IcdDto 			= selectedIcdCodeDTO; //id_ICDCode.selectedItem;
					patientDiagnosisDTO.OnSet 				= id_Onset.text;//new Date(Date.parse(id_Onset.text));
					/* patientDiagnosisDTO.IcdDto.IcdCodeDescription 	= id_Diagnosis.textInput.text;
					patientDiagnosisDTO.IcdDto.IcdCodeName 	= id_ICDCode.textInput.text; */
				}
				
				if (id_ChronicYes.selected)
					patientDiagnosisDTO.IsChronic = true;
				else
					patientDiagnosisDTO.IsChronic = false;
				
				patientDiagnosisDTO.IsActive = true;
				patientDiagnosisDTO.ID = '0';
				
				patientDiagnosisDTO.IsDirty = true;
				
				patientDiagnosisDTO.CreatedAt = new Date();
				patientDiagnosisDTO.CreatedBy = model.LoggedInUserId;
				
				patientDiagnosisDTO.DictationID = Constants.GUID_FORMAT;
				
				patientDiagnosisDTO.ModifiedAt = Constants.NULL_DATE;
				
				patientDiagnosisDTO.PatientID = model.patientID;
				patientDiagnosisDTO.VisitID = model.VisitID;
				
				model.signCosignBtnEnabled = true;

				if (id_AddRecord.notesDTO)
				{
					patientDiagnosisDTO.Note = id_AddRecord.notesDTO.Note;
					patientDiagnosisDTO.NoteSubject = id_AddRecord.notesDTO.NoteSubject;
				}
				
				if (id_AddRecord.dictationDTO && id_AddRecord.dictationDTO.DictationID!=Constants.GUID_FORMAT)
					patientDiagnosisDTO.DictationID = id_AddRecord.dictationDTO.DictationID;
				
				//Tahir Alvi - New Feature implemented of associate record with visit.
				
				patientDiagnosisDTO.VisitDate 	= new Date (model.DiagnosisAssociatedVisit.VisitDate);//datetostring(Tahir)				
				patientDiagnosisDTO.VisitID 	= model.DiagnosisAssociatedVisit.ID;
				
				patientDiagnosisDTO.IsNA = false;
				
				if (id_AssociateVisitzCombo.selectedIndex == 2)
				{
					patientDiagnosisDTO.IsNA = true;
				}
				
				if (model.patientDiagnosisDTOListByPatientId == null)
					model.patientDiagnosisDTOListByPatientId = new ArrayCollection();
				
				if ((id_AssociateVisitzCombo.selectedIndex == 2) || (id_AssociateVisitzCombo.selectedIndex == 1 && id_VisitDatesCombo.selectedIndex != -1))
				{
					patientDiagnosisDTO.IsDirty = true;
					model.patientDiagnosisDTOListByPatientId.addItem(patientDiagnosisDTO);
					Alert.show('Are you sure, you want to save this record.', 'Save Confirmation', Alert.YES | Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertSaveDBListener, null, Alert.OK)
				}
				else
				{
					model.patientDiagnosisDTOListByPatientId.addItem(patientDiagnosisDTO);
					
					var mpdEvent : ManagePatientDiagnosisEvent = new ManagePatientDiagnosisEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( mpdEvent );	
				}
				
				resetFields();
				
				hasViewChanged = _hasGridChanged = true;
				
				id_AddRecord.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
				id_AddRecord.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
			}
			
			private function alertSaveDBListener(eventObj:CloseEvent):void 
			{
				if (eventObj.detail == Alert.YES) 
				{
					var mpdEvent : ManagePatientDiagnosisEvent = new ManagePatientDiagnosisEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( mpdEvent );
				}  
			}
			
