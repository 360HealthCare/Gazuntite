			protected function id_AssociateVisitzCombo_changeHandler():void
			{
				resetForm();
				
				if(model.DiagnosisAssociatedVisit == null)
					model.DiagnosisAssociatedVisit = new AssociatedVisit(); 
				
				if(id_AssociateVisitzCombo.selectedIndex != -1)
				{
					id_ImportAllChronic.enabled =  model.patientDiagnosisAllChronicTemplateAvailable;
				}
				
				id_form1.enabled = true;
				
				if(id_AssociateVisitzCombo.selectedIndex == 1)
				{
					id_form1.enabled = false;	
					id_VisitDatesCombo.visible = true;
					id_VisitDateContainer.visible = true;
					id_VisitDatesCombo.selectedIndex = -1;
					id_VisitDateContainer.includeInLayout = true;
					id_DateContainer.text ="Please Select Visit Date";
					id_VisitDateContainer.width = 128;
					
					if(id_add.enabled)
						id_add.enabled = false;
					
				}
				else
				{
					id_VisitDatesCombo.visible = false;
					id_VisitDatesCombo.includeInLayout= false;
					if(id_AssociateVisitzCombo.selectedIndex == 0)
					{						
						id_VisitDateContainer.visible = false;
						id_VisitDateContainer.includeInLayout = false;
						
						model.DiagnosisAssociatedVisit.VisitDate = model.VisitDate;
						model.DiagnosisAssociatedVisit.ID   	 = model.VisitID;
						
						
					}else if(id_AssociateVisitzCombo.selectedIndex == 2){
						
						id_VisitDateContainer.visible = false;
						id_VisitDateContainer.includeInLayout = false;
						model.DiagnosisAssociatedVisit.VisitDate = Constants.NULL_DATE;
						model.DiagnosisAssociatedVisit.ID   	 = 0; 
					}
				}
			}
			
