				  buttonMode="true" useHandCursor="true" toolTip="Import Chronic Diagnosis" tabIndex="8"/>
		
		
		
	</s:HGroup>
	
	<s:HGroup id="id_form1" verticalAlign="middle" width="100%" tabIndex="1" enabled="false">
		<components:LabelDateField id="id_Onset" prompt="OnSet" width="100" change="validateOnset()"  textInputStyleName="mandatoryDateSkin"
								   yearNavigationEnabled="true" editable="true" maxYear="{new Date().getFullYear()}" minYear="1901"
								   selectableRange="{{rangeEnd : new Date()}}" tabIndex="2" />
		<components:LabelComboBox id="id_ICDCode" prompt="ICD Code" width="100" maxChars="10"
								  keyUp="icdCodeChangeHandler()" keyDown="id_ICDCode_keyDownHandler(event)"
								  click="Icdcode_clickHandler(event, 0)" useHandCursor="true" buttonMode="true"
								  skinClass="com.adobe.gazuntite.skins.chrome.comboBoxSkins.comboBoxSearchSkin" tabIndex="3" />
		<components:LabelComboBox id="id_Diagnosis" prompt="Diagnosis" width="100%"
								  keyUp="icdDescriptionChangeHandler()" keyDown="id_Diagnosis_keyDownHandler(event)"
