			public function VisitsLoaded(response:XML):void
			{
				var response:XML = AppUtils.removeDefaultNamespaceFromXML(response);
				visitArray.removeAll();
				
				/* if(id_AssociateVisitzCombo.dataProvider)//Tahir Alvi - takle exception on null
				id_AssociateVisitzCombo.dataProvider.removeAll(); */
				
				for(var i:uint=0; i<response.Visits.PatientVisitDTO.length(); i++)
				{
					var VisitDateLbl:String = AppUtils.formatDate(response.Visits.PatientVisitDTO[i].VisitDate.toString());
					var VisitDate:String = response.Visits.PatientVisitDTO[i].VisitDate.toString();
					var VisitID:String = response.Visits.PatientVisitDTO[i].VisitID.toString();
					//trace(VisitDate);
					visitArray.addItem({VisitDate:VisitDate, VisitID:VisitID, VisitDateLbl:VisitDateLbl});
				}
				
				if(visitArray.length > 0)
					model.patientDiagnosisAllChronicTemplateAvailable = true;
				else
					model.patientDiagnosisAllChronicTemplateAvailable = false;
				
				model.unSignedVisitDates = visitArray;
				id_AssociateVisitzCombo.labelField = "VisitDateLbl";
			}
			
			public function loadGridData():void
			{
				if( UtilityFunctions.IsNullOrEmpty( model.patientDiagnosisDTOListByPatientId ) )
				{
					var icdEvent : LoadPatientDiagnosisByVisitIdEvent = new LoadPatientDiagnosisByVisitIdEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
				}
				
				if( UtilityFunctions.IsNullOrEmpty( model.unSignedVisitDates ) )
				{
					var loadPatientVisitsEvent: LoadPatientVisitsEvent = new LoadPatientVisitsEvent(model.patientID.toString(), model.LoggedInUserSelectedBranchId.toString(), VisitsLoaded);				
					CairngormEventDispatcher.getInstance().dispatchEvent(loadPatientVisitsEvent);
				}
				
			}
			protected function button1_clickHandler(event:MouseEvent):void
			{
				AllowMoveToNextPanel ( dispactchSelectSectionEvent );
				
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new SelectSection('SelectSection', 'id_DiagnosisPanel', true, true) );
			}
			
			public function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_AddRecord.enabled )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
					
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				gridView.addEventListener("NotesSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
				gridView.addEventListener("DictationSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
			}
			
			protected function NotesDictationSavedFromGrid(event:Event):void
			{
				var evn:ManagePatientDiagnosisEvent = new ManagePatientDiagnosisEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(evn);
			}
			
		]]>
	</fx:Script>
