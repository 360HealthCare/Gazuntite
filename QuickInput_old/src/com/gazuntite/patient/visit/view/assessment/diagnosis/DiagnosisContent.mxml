			private function filterRecordsWhichAreAddedInGrid():void
			{
				if (!model.patientDiagnosisDTOListByPatientId)
					return;
				
				if (!model.patientDiagnosisDTOAllChronicListByPatientId)
					return;
				
				var chronicDiagnosisFilteredList:ArrayCollection = new ArrayCollection();
				var found:Boolean = false;
				
				for (var i:int = 0; i < model.patientDiagnosisDTOAllChronicListByPatientId.length; i++)
				{
					for (var j:int = 0; j < model.patientDiagnosisDTOListByPatientId.length; j++)
					{
						var recordInImportChronicGrid:PatientDiagnosisDTO = PatientDiagnosisDTO(model.patientDiagnosisDTOAllChronicListByPatientId[i]);
						var recordInGrid:PatientDiagnosisDTO = PatientDiagnosisDTO(model.patientDiagnosisDTOListByPatientId[j]);
						
						if (recordInImportChronicGrid.IcdDto.IcdCodeName == recordInGrid.IcdDto.IcdCodeName)
						{
							found = true;
							break;
						}
					}
					
					if (!found)
					{
						chronicDiagnosisFilteredList.addItem(recordInImportChronicGrid);
					}
				}
				
				model.patientDiagnosisDTOAllChronicListByPatientId = chronicDiagnosisFilteredList;
			}
			
			private function icdCodeChangeHandler():void
			{
				searchTermDiagnosis = '';
				searchTermDiagnosis = id_ICDCode.textInput.text;
				
				id_Diagnosis.textInput.text = '';
				id_Diagnosis.selectedIndex = -1;
				selectedIcdCodeDTO = null;
				id_AddRecord.enabled = isGetEdited();
				
				//if value exceeds 4 characters then search Icd Code and map the Icd Code.
				if(searchTermDiagnosis.length >=5)
				{
					var icdEvent : LoadDiagnosisICDCodeEvent = new LoadDiagnosisICDCodeEvent(searchTermDiagnosis, loadData);
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					
				}
			}
			
			private function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				//Only able to enter record when all mandatory records are enterd
				if((id_Onset.text.length > 0 || id_Onset.selectedDate))// && (id_ICDCode.textInput.text.length > 2) && (id_Diagnosis.textInput.text.length > 0))
				{
					if (selectedIcdCodeDTO) // it means id_ICDCode and id_Diagnosis has valid values
					{
						edited = true;
					}
				}
				
				return edited;
			}
			
			protected function id_ICDCode_keyDownHandler(event:KeyboardEvent):void
			{	
				if(event.keyCode == 13 ){
					searchTermDiagnosis = id_ICDCode.textInput.text;
					if(searchTermDiagnosis.length >2)
						openDiagnosisPopup(0);
				}
			}
			
			public  function loadData(val:* = null):void
			{
				if (model.icdCodeDTOList.length)
				{
					selectedIcdCodeDTO = null;
					for(var i:uint=0; i < model.icdCodeDTOList.length; i++)
					{
						var codeComp:Boolean = UtilityFunctions.compareStringsIgnoringCase(searchTermDiagnosis, model.icdCodeDTOList[i].IcdCodeName);
						var nameComp:Boolean = UtilityFunctions.compareStringsIgnoringCase(searchTermDiagnosis, model.icdCodeDTOList[i].IcdCodeDescription);
						
						if (codeComp || nameComp)
						{
							id_ICDCode.textInput.text = model.icdCodeDTOList[i].IcdCodeName;
							id_Diagnosis.textInput.text = model.icdCodeDTOList[i].IcdCodeDescription;
							selectedIcdCodeDTO = model.icdCodeDTOList[i];
							break;
						}
					}
					
					id_AddRecord.enabled = isGetEdited();
				}
			}
			
