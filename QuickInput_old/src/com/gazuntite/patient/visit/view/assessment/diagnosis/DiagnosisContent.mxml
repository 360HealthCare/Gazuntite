		<s:Label id="id_ChronicLbl" text="Chronic" fontFamily="Calibri" color="#ffffff"/>
		<s:HGroup gap="0" verticalAlign="middle">
			<s:RadioButton id="id_ChronicYes" groupName="chronicGrp" toolTip="Yes" skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.YRadioButton" buttonMode="true" tabIndex="4"/>
			<s:RadioButton id="id_ChronicNo" groupName="chronicGrp" toolTip="No" skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.NRadioButton" buttonMode="true"/>
		</s:HGroup>
		<commons:AddRecord id="id_AddRecord" writeNotesClick="onWriteNotesClick(event)" writeDictationClick="writeDictationClickHandler(event)" enabled="false" tabIndex="5"/>
	</s:HGroup>
