			private function addRecordClickHandler():void
			{
				var patientRecommendationDTO:PatientRecommendationDTO = new PatientRecommendationDTO();
				
				if( id_Plan.selectedIndex >= 0 )
				{
					patientRecommendationDTO.plantype = id_Plan.selectedItem as GeneralTypeDTO;
				}
				else if( id_Plan.textInput.text.length > 2)//free text
				{
					//patientRecommendationDTO.RecommendationPlanTypeID 	= 0;
					patientRecommendationDTO.plantype = id_Plan.selectedItem as GeneralTypeDTO;
					patientRecommendationDTO.plantype.ID = 0;
				}
				
				if( id_Method.selectedIndex >= 0 )
				{
					patientRecommendationDTO.methodtype = id_Method.selectedItem as GeneralTypeDTO;
				}
				else if( id_Method.textInput.text.length > 2 )//free text
				{
					patientRecommendationDTO.methodtype = id_Method.selectedItem as GeneralTypeDTO;
					patientRecommendationDTO.methodtype.ID = 0;
				}
				
				if( id_Duration.selectedIndex >= 0 )
				{
					patientRecommendationDTO.DurationType = id_Duration.selectedItem as GeneralTypeDTO;
				}
				else if( id_Duration.textInput.text.length > 2 )//free text
				{
					patientRecommendationDTO.DurationType = id_Duration.selectedItem as GeneralTypeDTO;
					patientRecommendationDTO.DurationType.ID = 0;
					
				}
				
				if( id_AssociatedDiagnosis.selectedItem )
				{
					patientRecommendationDTO.Diagnosistype = id_AssociatedDiagnosis.selectedItem as GeneralTypeDTO;
				}
				
				patientRecommendationDTO.PatientID = model.patientID;
				patientRecommendationDTO.VisitID = model.VisitID;
				patientRecommendationDTO.ID = 0;
				patientRecommendationDTO.IsDirty = true;
				
				if (id_Yes.selected)
					patientRecommendationDTO.IsDiscussedWithPatient = true; //Constants.STRING_TRUE;
				else if (id_No.selected)
					patientRecommendationDTO.IsDiscussedWithPatient = false; //Constants.STRING_FALSE;
				
				
				patientRecommendationDTO.Description = id_DescriptionArea.text;
				patientRecommendationDTO.CreatedByUserTypeID = model.LoggedInUserProviderTypeId;
				
				patientRecommendationDTO.ClinicBranchID = model.LoggedInUserSelectedBranchId;
				patientRecommendationDTO.VisitDate = model.VisitDate;
				
				patientRecommendationDTO.CreatedAt = new Date();
				patientRecommendationDTO.ModifiedAt = new Date();
				patientRecommendationDTO.DictationID = Constants.GUID_FORMAT;
				
				 
				if (id_Add.notesDTO)
				{
					patientRecommendationDTO.Note = id_Add.notesDTO.Note;
					patientRecommendationDTO.NoteSubject = id_Add.notesDTO.NoteSubject;
				}
				//H
				if (id_Add.dictationDTO && id_Add.dictationDTO.DictationID != null)
				{
					patientRecommendationDTO.DictationID = id_Add.dictationDTO.DictationID;
				} 
				
				var linkRef:String = ValidationUtils.TrimString(id_Links.textInput.text);
				
				patientRecommendationDTO.Links = linkRef;
					
				if (linkRef.length)
				{	
					if(model.linksList == null)
						model.linksList = new ArrayCollection();
					model.linksList.addItem(linkRef);
				}
				
				if(null == model.RecommendationDTOList)
					model.RecommendationDTOList = new ArrayCollection();
				
				model.RecommendationDTOList.addItemAt(patientRecommendationDTO, 0);
				
				var rptEvent : ManagePatientRecommendationEvent= new ManagePatientRecommendationEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( rptEvent );
				
				resetFields();
				
				if(hasViewChanged)
					hasViewChanged = false;
				
				_hasGridChanged = true;
				hasViewChanged  = true;
				
				
				id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
				id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
			}
			
			private function resetFields():void
			{
				id_Plan.selectedIndex = -1;
				id_Plan.textInput.text = "";
				
				id_AssociatedDiagnosis.selectedIndex = -1;
				id_AssociatedDiagnosis.textInput.text = "";
				
				id_Method.selectedIndex = -1;
				id_Method.textInput.text = "";
				
				id_Duration.selectedIndex = -1;
				id_Duration.textInput.text = "";
				
				id_Links.selectedIndex = -1;
				id_Links.textInput.text = "";
				
				id_DescriptionArea.text = "";
				
				id_Yes.selected = false;
				id_No.selected = false;
				
				id_Add.enableAll = false;
				
				id_Add.notesDTO = new ModuleNoteDTO();
				id_Add.dictationDTO = new ModuleDictationDTO();
				
				recordNotesDTO = new ModuleNoteDTO();
				
				if (recordNotesPanel)
					recordNotesPanel.removePopup(); 
				
				/* id_Add.id_WriteNotes.setStyle("skinClass", ImmunizationWriteNotesBtn);
				id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationDictationBtn); */
			}
			
			public function loadGridData():void
			{
				if(UtilityFunctions.IsNullOrEmpty(model.RecommendationDTOList))
				{
					var rptEvent : LoadPatientRecommendationByVisitIdEvents= new LoadPatientRecommendationByVisitIdEvents();
					CairngormEventDispatcher.getInstance().dispatchEvent( rptEvent );
				}
				
				loadStaticData();
			}
			
			private function loadStaticData():void
			{
				if(model.recommendationPlanTypeDTOList==null || model.recommendationPlanTypeDTOList.length==0)
				{
					var rptEvent : LoadAllRecommendationPlanTypesEvent= new LoadAllRecommendationPlanTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( rptEvent );
				}
				
				if(model.recommendationMethodTypeDTOList==null || model.recommendationMethodTypeDTOList.length==0)
				{
					var rmtEvent : LoadAllRecommendationMethodTypesEvent= new LoadAllRecommendationMethodTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( rmtEvent );
				}
				
				if(model.recommendationDurationTypeDTOList==null || model.recommendationDurationTypeDTOList.length==0)
				{
					var rdtEvent : LoadAllRecommendationDurationTypesEvent= new LoadAllRecommendationDurationTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( rdtEvent );
				}
			}
			
			protected function id_DescriptionArea_keyUpHandler(event:KeyboardEvent):void
			{
				if(id_DescriptionArea.text.length > 0)
				{
					id_Add.enableAll = true;
				}
				else
					id_Add.enableAll = false;
			}
			
			protected function cc(event:FlexEvent):void
			{
				gridView.addEventListener("NotesSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
				gridView.addEventListener("DictationSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
			}
			
			protected function NotesDictationSavedFromGrid(event:Event):void
			{
				var evn:ManagePatientRecommendationEvent = new ManagePatientRecommendationEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(evn);
			}
			
