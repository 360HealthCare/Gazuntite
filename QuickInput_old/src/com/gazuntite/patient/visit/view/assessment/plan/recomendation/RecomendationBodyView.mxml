								  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="7" dataProvider="{model.recommendationDurationTypeDTOList}" /><!---->
		<s:HGroup width="100%" paddingTop="5" paddingLeft="5">
			<s:Label text="Discussed with Patient?" fontFamily="Calibri" fontSize="12" color="#FFFFFF" paddingRight="8" verticalAlign="bottom"/>
			<s:HGroup gap="0" paddingLeft="5" verticalAlign="middle" horizontalAlign="center" >
				<s:RadioButton id="id_Yes"  skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.YRadioButton" tabIndex="8" toolTip="Yes" buttonMode="true"/>
				<s:RadioButton id="id_No"  skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.NRadioButton" toolTip="No" buttonMode="true"/>
			</s:HGroup>
		</s:HGroup>
