			private function comboChangeHandler():void
			{
				id_Add.enableAll = !isInvalid();
				id_Add.enabled = isGetEdited();				
			}
			
			public function isInvalid():Boolean
			{
				var notValid:Boolean = false;
				
				if (!(id_Plan.selectedIndex >= 0 || id_Plan.textInput.text.length > 3))//Free text
					notValid = true;
					
				else if (!(id_Method.selectedIndex >= 0 || id_Method.textInput.text.length > 3))//Free text
					notValid = true;
					
				else if (!(id_Duration.selectedIndex >= 0 || id_Duration.textInput.text.length > 2))//Free text
					notValid = true;
				
				return notValid && ( id_DescriptionArea.text.length == 0 );
			}
			
			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if ((id_Plan.selectedIndex >= 0 || id_Plan.textInput.text.length > 3) ||
					(id_Method.selectedIndex >= 0 || id_Method.textInput.text.length > 3) ||
					(id_Links.selectedIndex >= 0 || id_Links.textInput.text.length > 3) ||
					(id_Duration.selectedIndex >= 0 || id_Duration.textInput.text.length > 3))
					
					edited = true;
				
				//hasViewChanged = (_hasGridChanged)? _hasGridChanged : edited;
				
				return edited;
			}
			
			
			private function comboKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8)
				{
					if (event.currentTarget.id != "id_Links")
					{
						id_Add.enableAll = false;
					}
					if (event.currentTarget.id == "id_Plan" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						/* var laptEvent : LoadAllPlanTypesEvent = new LoadAllPlanTypesEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent( laptEvent ); */
					}
					if (event.currentTarget.id == "id_Method" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						/* var lmtEvent : LoadAllMethodTypesEvent = new LoadAllMethodTypesEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent( lmtEvent );  */
					}
					if (event.currentTarget.id == "id_Duration" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						/* var ladtEvent : LoadAllDurationTypesEvent = new LoadAllDurationTypesEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent( ladtEvent ); */
					}
					if( event.currentTarget.id == "id_AssociatedDiagnosis" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						/* var ldrbpid:LoadDiagnosisForRecommendationByPatientIdEvent = new LoadDiagnosisForRecommendationByPatientIdEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent(ldrbpid); */
					}
					else
					{
						var searchString:String = event.currentTarget.textInput.text;
						
						if (searchString.length > 2)
						{
							searchString = UtilityFunctions.convertStringToBase64String(searchString)
							var loadLinksEv:LoadRecommendationLinksAutoCompleteEvent = new LoadRecommendationLinksAutoCompleteEvent(searchString);
							CairngormEventDispatcher.getInstance().dispatchEvent(loadLinksEv); 
						}
					}
					
					id_Add.enabled = true;
				}
				
				/* calling isGetEdited() to check whether is there any change in view or not
				just to set hasViewChanged boolean
				*/
				isGetEdited();
			}
			
