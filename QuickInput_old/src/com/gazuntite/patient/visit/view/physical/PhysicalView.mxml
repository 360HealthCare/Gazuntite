<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:cchpi="com.gazuntite.patient.visit.view.physical.cchpi.*" 
		 xmlns:labin="com.gazuntite.patient.visit.view.physical.labin.*" 
		 xmlns:ros="com.gazuntite.patient.visit.view.physical.ros.*" 
		 xmlns:vitals="com.gazuntite.patient.visit.view.physical.vitals.*" 
		 xmlns:physical="com.gazuntite.patient.visit.view.physical.physical.*"
		 
		 creationComplete="init(event)"
		 >
	<fx:Script>
		<![CDATA[
			import com.adobe.gazuntite.skins.chrome.buttonSkins.PMHButtonSkin;
			import com.adobe.gazuntite.skins.chrome.toggleButtonSkins.QICloseRedButtonSkin;
			import com.gazuntite.common.view.events.QSViewStateEvent;
			import com.gazuntite.common.view.events.SelectSection;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.view.commons.QICollapseableView;
			
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.ItemClickEvent;
			
			[Bindable]
			private var model : QIModelLocator = QIModelLocator.getInstance();
			
			
			public var currentIndex:int = 1;
			public var currentSelectedView:QICollapseableView  = new QICollapseableView() ;
			
			private var m_bHasChange:Boolean;
			
			public function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			[Bindable]
			public function set hasChange(value:Boolean):void
			{
				m_bHasChange = value;
				
				if( value || id_vital.hasChange || id_CCPanel.hasChange || id_ROSPanel.hasChange || id_labIn.hasChange )
				{
					m_bHasChange = true;
				}
				else
				{
					m_bHasChange = false;
				}
			}
			
			protected function SwitchToNextPanel(event:SelectSection):void
			{
				SelectNextByID(event.SectionID);
			}
			
			
			private function SelectNextByID( sectionID:String ):void
			{
				removeAllPopups();
				collupseAllPanel();
				switch( sectionID )
				{
					case "id_labIn":
						setSelectedById( "id_VitalsBtn" );
						break;
					case "id_vital":
						setSelectedById( "id_CCBtn" );
						break;
					case "id_CCPanel":
						setSelectedById( "id_ROSBtn" );
						break;
					case "id_ROSPanel":
						setSelectedById( "id_PhysicalBtn" );
						break;
					case "id_PhysicalPanel":
						setSelectedById( "id_LabsBtn" );
						break;
					
					default:
						setSelectedById( "id_VitalsBtn" );
						break;
				}
			}
			
			public function removeAllPopups():void
			{
				/* id_AlergiesPanel.AllowOtherPopup		= false;
				id_HistoryPanel.AllowOtherPopup		= false;
				id_ImmunizationPanel.AllowOtherPopup	= false;
				id_ChronicmedicationPanel.AllowOtherPopup	= false; */
			}
			
			protected function init(event:FlexEvent):void
			{
				addEventListener("SelectSection" , SwitchToNextPanel);
				addEventListener(CloseEvent.CLOSE , onClosePanel);
				//SelectNextByIndex();
			}
			
			
			private function onClosePanel(event:CloseEvent):void
			{
				switch( event.target.id )
				{
					case "id_VitalsBtn":
					case "id_vital":
						
						id_VitalsBtn.setStyle("skinClass", QICloseRedButtonSkin);
						
						break;
					
					case "id_CCBtn":
					case "id_CCPanel":
						
						id_CCBtn.setStyle("skinClass", QICloseRedButtonSkin);
						
						break;
					
					case "id_ROSBtn":
					case "id_ROSPanel":
						
						id_ROSBtn.setStyle("skinClass", QICloseRedButtonSkin);
						break;
					
					case "id_PhysicalBtn":
					case "id_PhysicalPanel":
						
						id_PhysicalBtn.setStyle("skinClass", QICloseRedButtonSkin);
						break;
					
					case "id_LabsBtn":
					case "id_labIn":
						id_LabsBtn.setStyle("skinClass", QICloseRedButtonSkin);
						
						
						break;
					
				}
			}
			
			public function ScrollUp():void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition + 15;
				removeAllPopups();
			}
			
			public function ScrollDown():void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition - 15;
				removeAllPopups();
			}
			
			public function setFirstTab():void
			{
				collupseAllPanel();
				setSelectedById( "id_VitalsBtn" );	
			}
			
			private function ShowPanel(event:MouseEvent):void
			{
				
				
				collupseAllPanel();
				
				DeSelectAllNavButton();
				
				
				
				//getCurrentSelectedPanel().ExpandedView = true; 
				
				getCurrentSelectedPanel() .AllowMoveToNextPanel( function():void
				{
					event.currentTarget.selected = true;
					
					setSelectedById( event.currentTarget.id )
				}); 
			}
			
			
			
			public function collupseAllPanel():void
			{
				
				id_vital.ExpandedView 			= false;
				id_CCPanel.ExpandedView 		= false;
				id_ROSPanel.ExpandedView 		= false; 
				id_PhysicalPanel.ExpandedView 	= false; 
				id_labIn.ExpandedView 			= false;
				
			}
			
			public function collupseAllPanelexcept(current:String):void
			{
				if(current != id_vital.id)
					id_vital.ExpandedView 			= false;
				if(current != id_CCPanel.id)
					id_CCPanel.ExpandedView 		= false;
				if(current != id_ROSPanel.id)
					id_ROSPanel.ExpandedView 		= false;
				if(current != id_PhysicalPanel.id)
					id_PhysicalPanel.ExpandedView 	= false; 
				if(current != id_labIn.id)
					id_labIn.ExpandedView 			= false;
				
				
			}
			
			public function DeSelectAllNavButton():void
			{
				id_VitalsBtn.selected		=	false;
				id_CCBtn.selected			=	false;
				id_ROSBtn.selected			=	false;
				id_PhysicalBtn.selected		=	false;
				id_LabsBtn.selected			=	false;
				
			}
			
			
			public function DeSelectAllPageBtn():void
			{
				id_VitalsPage.selected = false;
				id_CCPage.selected = false;
				id_ROSPage.selected = false;
				id_PhysicalPage.selected = false;
				id_LabsPage.selected = false;
			}
			
			
			private function getCurrentSelectedPanel():QICollapseableView
			{
				if( id_vital.ExpandedView )
				{
					return id_vital;
				}
				else if( id_CCPanel.ExpandedView )
				{
					return id_CCPanel;
				}
				else if( id_ROSPanel.ExpandedView )
				{
					return id_ROSPanel;
				}
				else if( id_labIn.ExpandedView )
				{
					return id_labIn;
				}
				
				return id_vital;
			}
			
			protected function next_clickHandler(event:MouseEvent):void
			{
				
				collupseAllPanel();
				
				DeSelectAllNavButton();
				
				currentIndex += 1 ;
				SelectNextByIndex()
				
			}
			
			protected function previous_clickHandler(event:MouseEvent):void
			{
				
				collupseAllPanel();
				
				DeSelectAllNavButton();
				
				currentIndex -= 1 ;
				SelectNextByIndex()
				
			}
			
			
			protected function pagination_itemClickHandler(event:ItemClickEvent):void
			{
				
				collupseAllPanel();
				
				DeSelectAllNavButton();
				
				DeSelectAllPageBtn();
				
				getCurrentSelectedPanel() .AllowMoveToNextPanel ( function():void
				{
					setSelectedById( event.item as String );
				});
			}
			
			
			public function SelectNextByIndex():void
			{
				if( currentIndex == 0 )
					currentIndex = 5;
				
				switch( currentIndex )
				{
					case 1:
						setSelectedById( "id_VitalsBtn" );
						break;
					case 2:
						setSelectedById( "id_CCBtn" );
						break;
					case 3:
						setSelectedById( "id_ROSBtn" );
						break;
					case 4:
						setSelectedById( "id_PhysicalBtn" );
						break;
					case 5:
						setSelectedById( "id_LabsBtn" );
						break;
					default:
						setSelectedById( "id_VitalsBtn" );
						break;
				}
			}
			
			
			public function checkPinAll():Boolean
			{
				return id_vital.PinView 	&&
					id_CCPanel.PinView 		&&
					id_ROSPanel.PinView		&&					
					id_labIn.PinView			;
				
			}
			
			public function PinAll( value:Boolean ):void
			{
				id_vital.PinView 						= value;
				id_vital.id_Header.id_Pin.selected 		= value;
				
				id_CCPanel.PinView 						= value;
				id_CCPanel.id_Header.id_Pin.selected 	= value;
				
				id_ROSPanel.PinView 							= value;
				id_ROSPanel.id_Header.id_Pin.selected 		= value;
				
				id_PhysicalPanel.PinView 						= value;
				id_PhysicalPanel.id_Header.id_Pin.selected 		= value;
				
				id_labIn.PinView 						= value;
				id_labIn.id_Header.id_Pin.selected 		= value;
				
				 if( !value )
					currentSelectedView.ExpandedView = true;
				
				removeAllPopups();
			}
			
			private function inActivateBorders():void 
			{				
				
				id_vital.ShowFocusBorder 		= false;
				id_CCPanel.ShowFocusBorder 			= false;
				id_ROSPanel.ShowFocusBorder 		= false;
				id_labIn.ShowFocusBorder		= false;
			}
			
			private function setSelectedById(tabId:String):void
			{
				DeSelectAllNavButton();
				DeSelectAllPageBtn();
				
				switch( tabId )
				{
					case "id_VitalsBtn":
					case "id_vital":
						inActivateBorders(); 
						currentSelectedView				= id_vital;
						id_VitalsBtn.selected			= true;
						id_vital.ExpandedView 		    = true;
						id_vital.visible		 		= true;
						id_VitalsPage.selected			= true;
						
						
						callLater( function():void
						{
						 	id_vital.id_vitalBodyView.id_height.id_numericStipper.setFocus(); 
						});
						
						currentIndex						= 1;
						id_VitalsBtn.setStyle("skinClass", PMHButtonSkin);
						
						id_Scroller.viewport.verticalScrollPosition = 5;
						break;
					
					case "id_CCBtn":
					case "id_CCPanel":
						inActivateBorders();
						currentSelectedView					= id_CCPanel;
						id_CCBtn.selected					= true;
						id_CCPanel.ExpandedView 			= true;
						id_CCPanel.visible		 			= true;
						id_CCPage.selected					= true;
						
						callLater( function():void
						{	
						 id_CCPanel.id_ccBodyView.id_ComplaintArea.setFocus();
						});
						
						currentIndex						= 2;
						id_CCBtn.setStyle("skinClass", PMHButtonSkin);
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_labIn.height;
						else
							id_Scroller.viewport.verticalScrollPosition = id_labIn.height + 25;
						
						break;
					
					case "id_ROSBtn":
					case "id_ROSPanel":
						inActivateBorders();
						currentSelectedView					= id_ROSPanel;
						id_ROSBtn.selected					= true;
						id_ROSPanel.ExpandedView 			= true;
						id_ROSPanel.visible		 			= true;
						id_ROSPage.selected					= true;
						currentIndex						= 3;
						id_ROSBtn.setStyle("skinClass", PMHButtonSkin);
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_vital.height + id_labIn.height;
						else
							id_Scroller.viewport.verticalScrollPosition = id_vital.height + 45;
						
						break;
					
					case "id_PhysicalBtn":
					case "id_PhysicalPanel":
						inActivateBorders();
						currentSelectedView					= id_PhysicalPanel;
						id_PhysicalBtn.selected				= true;
						id_PhysicalPanel.ExpandedView 		= true;
						id_PhysicalPanel.visible		 	= true;
						id_PhysicalPage.selected			= true;
						currentIndex						= 4;
						id_PhysicalBtn.setStyle("skinClass", PMHButtonSkin);
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_vital.height + id_labIn.height;
						else
							id_Scroller.viewport.verticalScrollPosition = id_vital.height + 45;
						
						break;
					
					case "id_LabsBtn":
					case "id_labIn":
						inActivateBorders();
						currentSelectedView				= id_labIn;
						id_LabsBtn.selected				= true;
						id_labIn.ExpandedView 			= true;
						id_labIn.visible		 		= true;
						id_LabsPage.selected			= true;
						
						
						callLater( function():void
						{
						 id_labIn.id_inhouseLab.id_TestCode.setFocus();						
						});
						
						currentIndex						= 5;
						id_LabsBtn.setStyle("skinClass", PMHButtonSkin);
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_vital.height + id_labIn.height + id_CCPanel.height + id_ROSPanel.height;
						else
							id_Scroller.viewport.verticalScrollPosition = id_CCPanel.height + 85;
						
						break;
					
				}
				
				
			}
			
			
			protected function QSViewStateChangeHandler(event:QSViewStateEvent):void
			{

				if(event.viewState == QSViewStateEvent.EXPANDED_VIEW && event.currentTarget.id != currentSelectedView.id)
				{
					collupseAllPanelexcept(event.currentTarget.id);
					DeSelectAllNavButton();
					DeSelectAllPageBtn();
					setSelectedById( event.currentTarget.id );
				}

				else if(event.viewState ==  QSViewStateEvent.COLLAPSED_VIEW)
				{
					DeSelectAllNavButton();
					DeSelectAllPageBtn();
					currentSelectedView = new QICollapseableView();
				} 			
			}
			
		
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="pagination" itemClick="pagination_itemClickHandler(event)"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	<s:HGroup width="100%" horizontalAlign="center" height="40" verticalAlign="middle">
		<s:Button skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBPMHPrevBtn"  click="previous_clickHandler(event)"
				  toolTip="Previous Section" buttonMode="true"/>
		
		<s:HGroup width="100%" horizontalAlign="left">		
			<s:ToggleButton id="id_VitalsBtn" width="65" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PMHButtonSkin" label="VITALS"
							click="ShowPanel(event)" buttonMode="true" useHandCursor="true" /> <!--selected="{ !id_VitalsPanel.visible} -->
			
			<s:ToggleButton id="id_CCBtn" width="115" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PMHButtonSkin" label="CHIEF COMPLAINT/HPI"
							click="ShowPanel(event)" buttonMode="true" useHandCursor="true" /> <!--selected="{ !id_CCPanel.visible}"-->
			
			<s:ToggleButton id="id_ROSBtn" width="115" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PMHButtonSkin" label="REVIEW OF SYSTEM"
							click="ShowPanel(event)" buttonMode="true" useHandCursor="true" /> <!--"selected="{ !id_ROSPanel.visible}"-->
			
			
			
			<s:ToggleButton id="id_PhysicalBtn" width="70" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PMHButtonSkin" label="PHYSICAL"
							click="ShowPanel(event)" buttonMode="true" useHandCursor="true" /> <!--selected="{ !id_PhysicalPanel.visible}"-->
			
			<s:ToggleButton id="id_LabsBtn" width="80" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PMHButtonSkin" label="IN-HOUSE LAB"
							click="ShowPanel(event)" buttonMode="true" useHandCursor="true" /> <!--selected="{ !id_LabsPanel.visible}"-->
			
		</s:HGroup>
		<s:Button skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBPMHNextBtn" click="next_clickHandler(event)"
				  toolTip="Next Section" buttonMode="true"/>
	</s:HGroup>
	
	<s:BorderContainer width="100%" height="100%" cornerRadius="3" backgroundColor="#999AAA" 
					   borderAlpha="0" borderColor="#999AAA" backgroundAlpha="0">
		<s:layout>
			<s:VerticalLayout paddingTop="0" horizontalAlign="left" gap="1"  />
		</s:layout>
		<s:Scroller id="id_Scroller" width="100%" height="100%" verticalScrollPolicy="off" horizontalScrollPolicy="off" >
			<s:Group width="100%" height="100%" >
				<s:layout>
					<s:VerticalLayout paddingTop="2" horizontalAlign="center" verticalAlign="top" gap="-5" clipAndEnableScrolling="true" />
				</s:layout>
				
				
				
				
				<vitals:VitalPanel  id="id_vital" width="100%" ExpandedView="false" includeInLayout="{id_vital.visible}"
									HeadingLable="Vitals" QSViewStateChange="QSViewStateChangeHandler(event)"/>
				
				
				
				
				<cchpi:CCPanel      id="id_CCPanel" width="100%" ExpandedView="false" includeInLayout="{id_CCPanel.visible}"
									HeadingLable="Cheif Complaint" 
									QSViewStateChange="QSViewStateChangeHandler(event)"/>
				
				
				
				<ros:ROSPanel 		id="id_ROSPanel" dataProvider="{model.rosDTOList}" includeInLayout="{id_ROSPanel.visible}"
									 width="100%" ExpandedView="false"
									HeadingLable="Review of System" 
									QSViewStateChange="QSViewStateChangeHandler(event)"/>
				
				
				
				
				<physical:PhysicalTreePanel id="id_PhysicalPanel" dataProvider="{model.physicalDTOList}"	
												includeInLayout="{id_PhysicalPanel.visible}"
											  width="100%" ExpandedView="false"
											 HeadingLable="Physical"
											 QSViewStateChange="QSViewStateChangeHandler(event)"/>
				
				
				<labin:LabInPanel 	id="id_labIn" width="100%" ExpandedView="false" includeInLayout="{id_labIn.visible}"
									HeadingLable="In-House Lab" 
									QSViewStateChange="QSViewStateChangeHandler(event)"/>
				
				
				
			</s:Group>
		</s:Scroller>
		
		<s:HGroup width="100%" horizontalAlign="center" paddingTop="5">
			
			<s:RadioButton id="id_VitalsPage"  selected="true"	groupName="pagination" value="id_VitalsBtn" skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn" buttonMode="true" useHandCursor="true" toolTip="Vitals"	/>
			<s:RadioButton id="id_CCPage" 			groupName="pagination" value="id_CCBtn" 	skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn"	buttonMode="true" useHandCursor="true" toolTip="Chief Compliant"/>
			<s:RadioButton id="id_ROSPage" 			groupName="pagination" value="id_ROSBtn" 		skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn" buttonMode="true" useHandCursor="true" toolTip="Review of System"/>
			<s:RadioButton id="id_PhysicalPage" 	groupName="pagination" value="id_PhysicalBtn" 	skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn" buttonMode="true" useHandCursor="true" toolTip="Physical"/>
			<s:RadioButton id="id_LabsPage" 		groupName="pagination" value="id_LabsBtn" 		skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.QIPaginationRadioBtn" buttonMode="true" useHandCursor="true" toolTip="In-house Lab"/>
		</s:HGroup>
		
	</s:BorderContainer>
</s:Group>
