<?xml version="1.0" encoding="utf-8"?>
<commons:SectionHeader xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:commons="com.gazuntite.patient.visit.view.commons.*" 
					   xmlns:components="com.gazuntite.controls.extended.components.*" >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.dto.ROSDTO;
			import com.gazuntite.patient.visit.dto.common.BaseDTO;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.view.physical.rosPhysicalCommon.MainCatRenderer;
			
			import spark.components.IItemRenderer;
			import spark.events.IndexChangeEvent;
			
			private var _m_oParentSelectedItem:IItemRenderer;
			
			[Bindable]
			private var model : QIModelLocator = QIModelLocator.getInstance();
			
			
			
			[Bindable]
			public function get m_oParentSelectedItem():IItemRenderer
			{
				return _m_oParentSelectedItem;
			}

			public function set m_oParentSelectedItem(value:IItemRenderer):void
			{
				_m_oParentSelectedItem = value;
			}

			protected function id_SpinerList_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
			}
			
			protected function id_SpinerList_changeHandler(event:IndexChangeEvent):void
			{
				if(id_SpinerList.id_DDList.selectedItem != m_oParentSelectedItem.data)
				{
					id_SpinerList.id_DDList.selectedItem = m_oParentSelectedItem.data;
				}
										
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:HGroup width="100%" horizontalAlign="center" verticalAlign="middle">
		<s:HGroup paddingTop="-1" horizontalAlign="left">			
			<components:SpinerList id="id_SpinerList" width="130" change="id_SpinerList_changeHandler(event)" DataProvider="{model.rosDTOList}" click="id_SpinerList_clickHandler(event)"/>
		</s:HGroup>
		<s:Group id="spacer" width="100%" />
		<s:HGroup width="100%" horizontalAlign="right" paddingTop="0">					
			<s:Button id="id_AllNormalBtn" skinClass="com.adobe.gazuntite.skins.QuickInput.ros.ROSallNormalBtn" toolTip="All Normal" buttonMode="true" />
		</s:HGroup>
	</s:HGroup>
	
	
</commons:SectionHeader>
