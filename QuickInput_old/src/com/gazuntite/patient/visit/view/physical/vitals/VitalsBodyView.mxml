			private function registerFocusOutHandlers():void
			{
				id_height.addEventListener(FocusEvent.FOCUS_OUT, validateHeight, false, 0, true);
				id_weight.addEventListener(FocusEvent.FOCUS_OUT, validateWeight, false, 0, true);
				id_Temperature.addEventListener(FocusEvent.FOCUS_OUT, validateTemperature, false, 0, true);
				id_pulse.addEventListener(FocusEvent.FOCUS_OUT, validatePulse, false, 0, true);
				id_resp.addEventListener(FocusEvent.FOCUS_OUT, validateRespiratory, false, 0, true);
				id_sys.addEventListener(FocusEvent.FOCUS_OUT, validateBloodPressureSYS, false, 0, true);
				id_dys.addEventListener(FocusEvent.FOCUS_OUT, validateBloodPressureDYS, false, 0, true);
			}
			
			private function unRegisterFocusOutHandlers():void
			{
				id_height.removeEventListener(FocusEvent.FOCUS_OUT, validateHeight);
				id_weight.removeEventListener(FocusEvent.FOCUS_OUT, validateWeight);
				id_Temperature.removeEventListener(FocusEvent.FOCUS_OUT, validateTemperature);
				id_pulse.removeEventListener(FocusEvent.FOCUS_OUT, validatePulse);
				id_resp.removeEventListener(FocusEvent.FOCUS_OUT, validateRespiratory);
				id_sys.removeEventListener(FocusEvent.FOCUS_OUT, validateBloodPressureSYS);
				id_dys.removeEventListener(FocusEvent.FOCUS_OUT, validateBloodPressureDYS);
			}
			
			private function registerChangeWatcherHandlers():void
			{
				ChangeWatcher.watch(id_height, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_weight, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_Temperature, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_pulse, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_resp, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_sys, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_dys, "hasViewChanged", vitalsViewChangedWatcherHandler);
				ChangeWatcher.watch(id_oxygen, "text", vitalsViewChangedWatcherHandler);
			}
			
			private function vitalsViewChangedWatcherHandler(event:Event):void
			{
				vitalsGetEdited();
				//trace(event.kind, event.property, event.oldValue, event.newValue);
			}
			
			
			private function vitalsGetEdited():void
			{
				hasChange = id_height.hasViewChanged;
				
				hasChange = hasChange || id_weight.hasViewChanged;
				
				hasChange = hasChange || id_Temperature.hasViewChanged;
				
				hasChange = hasChange || id_resp.hasViewChanged;
				
				hasChange = hasChange || id_pulse.hasViewChanged;
				
				hasChange = hasChange || id_sys.hasViewChanged;
				
				hasChange = hasChange || id_dys.hasViewChanged;
				
				hasChange = hasChange || id_oxygen.text.length > 0;
			}
			
			private function validateBloodPressureSYS(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_sys.values;
				
				if (value && value.length > 1)
				{
					var sys:Number = value[0];
					//var dys:Number = value[1];
					
					var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
					
					if (event.relatedObject == stepper.id_numericStipper)
					{
						inputStepper = stepper.id_numericStipper;
						
						if (sys != 0 && (sys < 70 || sys > 140))
						{
							isNotValid = true;
						}
					}
					
					/* else if (event.relatedObject == stepper.secondNumericStepper)
					{
					inputStepper = stepper.secondNumericStepper;
					
					if (dys != 0 && (dys < 50 || dys > 95))
					{
					isNotValid = true;
					}
					} */
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_sys;
						
						var errorMsg:String = "";
						
						if (inputStepper == stepper.id_numericStipper)
							errorMsg = "Provided value for blood pressure(Sys) does not occur in feasible range";
						/* else
						errorMsg = "Provided value for blood pressure(Dys) does not occur in feasible range"; */
						
						errorMsg += ".\n Do you want to keep this value";
						selectedUnit = 6;
						
						UtilityFunctions.AskMessage(errorMsg + "Blood pressure out of Range error",alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						
						/* Alert.show(errorMsg, "Blood pressure out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertsCloseHandler); */
					}
				}
			}
			
			private function validateBloodPressureDYS(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_dys.values;
				
				if (value && value.length > 1)
				{
					//var sys:Number = value[0];
					var dys:Number = value[1];
					
					var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
					
					if (event.relatedObject == stepper.id_numericStipper)
					{
						inputStepper = stepper.id_numericStipper;
						
						if (dys != 0 && (dys < 70 || dys > 140))
						{
							isNotValid = true;
						}
					}
					
					/* else if (event.relatedObject == stepper.secondNumericStepper)
					{
					inputStepper = stepper.secondNumericStepper;
					
					if (dys != 0 && (dys < 50 || dys > 95))
					{
					isNotValid = true;
					}
					} */
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_dys;
						
						var errorMsg:String = "";
						
						if (inputStepper == stepper.id_numericStipper)
							errorMsg = "Provided value for blood pressure(Sys) does not occur in feasible range";
						else
							errorMsg = "Provided value for blood pressure(Dys) does not occur in feasible range";
						
						errorMsg += ".\n Do you want to keep this value";
						selectedUnit = 6;
						UtilityFunctions.AskMessage("Blood pressure out of Range error"+errorMsg ,alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						
						/* 	Alert.show(errorMsg, "Blood pressure out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertsCloseHandler); */
					}
				}
			}
			
			private function validateWeight(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_weight.values;
				
				var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
				
				if (value && value.length)
				{
					if (englishMode)
					{
						var lbs:Number = value[0];
						
						if (lbs != 0 && (lbs < 4 || lbs > 442 ))
						{
							isNotValid = true;
							
							inputStepper = stepper.id_numericStipper;
						}
					}
					else
					{
						var kgs:Number = value[0];
						
						if (kgs != 0 && (kgs < 2 || kgs > 200))
						{
							isNotValid = true;
							
							inputStepper = stepper.id_numericStipper;
						}
					}
					
					calculateBMI();
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_weight;
						selectedUnit = 2;
						UtilityFunctions.AskMessage("Provided value for weight does not occur in feasible range.\n Do you want to keep these values",alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						/* 	Alert.show("Provided value for weight does not occur in feasible range.\n Do you want to keep these values",
						"Weight out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertsCloseHandler); */
					}
				}
			}
			
			private function validateTemperature(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_Temperature.values;
				
				var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
				
				if (value && value.length)
				{
					if (englishMode == false)
					{
						var c:Number = value[0];
						
						if (c != 0 && (c < 35 || c > 40 ))
						{
							isNotValid = true;
							
							inputStepper = stepper.id_numericStipper;
						}
					}
					else
					{
						var f:Number = value[0];
						
						if (f != 0 && (f < 95.5 || f > 104.5))
						{
							isNotValid = true;
							
							inputStepper = stepper.id_numericStipper;
						}
					}
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_Temperature;
						selectedUnit = 3;
						UtilityFunctions.AskMessage("Provided value for temperature does not occur in feasible range.\n Do you want to keep these values",alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						/* Alert.show("Provided value for temperature does not occur in feasible range.\n Do you want to keep these values",
						"Temperature out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertsCloseHandler); */
					}
				}
			}
			
			private function validatePulse(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_pulse.values;
				
				var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
				
				if (value && value.length)
				{
					var p:Number = value[0];
					
					if (p != 0 && (p < 50 || p > 135 ))
					{
						isNotValid = true;
						
						inputStepper = stepper.id_numericStipper;
					}
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_pulse;
						selectedUnit = 4;
						UtilityFunctions.AskMessage("Provided value for pulse does not occur in feasible range.\n Do you want to keep these values",alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						/* Alert.show("Provided value for pulse does not occur in feasible range.\n Do you want to keep these values",
						"Pulse out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertsCloseHandler); */
					}
				}
			}
			
			private function validateRespiratory(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_resp.values;
				
				var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
				
				if (value && value.length)
				{
					var r:Number = value[0];
					
					if (r != 0 && (r < 10 || r > 65))
					{
						isNotValid = true;
						
						inputStepper = stepper.id_numericStipper;
					}
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_resp;
						selectedUnit = 5;
						UtilityFunctions.AskMessage("Provided value for respiratory does not occur in feasible range.\n Do you want to keep these values",alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						/* UtilityFunctions.AskMessage("Provided value for respiratory does not occur in feasible range.\n Do you want to keep these values",
						, alertsCloseHandler); */
					}
				}
			}
			
			private function alertsCloseHandlerYes():void
			{
				vital.selected = false;
				
				if (hasFocus)
					//hasFocus.setFocus();
					focusManager.setFocus(hasFocus);
				registerFocusOutHandlers();
			}
			
			private function alertsCloseHandlerNo():void
			{
				vital.selected = true;
				
				if (inputStepper == vital.id_numericStipper){
					vital.reset(true, false); 
					resetData();
				}
				else{
					vital.reset(false, true);
				}
				registerFocusOutHandlers();
			}
			
			
			private function resetData():void
			{
				if(null == model.VitalDTO)
					return;
				
				switch(selectedUnit)
				{
					case 1:
						model.VitalDTO.Height = '';
						break;
					case 2:
						model.VitalDTO.Weight = '';
						break;
					case 3:
						model.VitalDTO.Temperature = '';
						break;
					case 4:
						model.VitalDTO.Pulse = '';
						break;
					case 5:
						model.VitalDTO.Respiration = '';
						break;
					case 6:
						model.VitalDTO.BPDys = '';
						break;
					default:
						break;
				}
			}
			
			private function ValidateHeightInFeet(event:FocusEvent, stepper:vitalsNumericStipper):Boolean
			{
				var value:Array = id_height.values;
				var ft:Number = value[0];
				var inches:Number = value[1];
				
				
				if (ft != 0 && (event.relatedObject == stepper.id_numericStipper) )
				{
					inputStepper = stepper.id_numericStipper;
					
					if (ft > 0 && ft < 1)
					{
						return true;
					}
					else if (ft > 8)
					{
						return true;
					}
				}
				
				/* else if (event.relatedObject == stepper.secondNumericStepper)
				{
				inputStepper = stepper.secondNumericStepper;
				
				if (ft == 1 && inches < 3)
				{
				return true;
				}
				} */
				
				return false
			}
			
			private function ValidateHeightInInches(event:FocusEvent, stepper:vitalsNumericStipper):Boolean
			{
				var value:Array = id_height.values;
				var inches:Number = value[0];
				
				if (event.relatedObject == stepper.id_numericStipper)
				{
					inputStepper = stepper.id_numericStipper;
					
					if ( inches != 0 && ( inches < 15 || inches > 96 ) )
					{
						return true;
					}
				}
				
				return false
			}
			
			private function validateHeight(event:FocusEvent):void
			{
				var isNotValid:Boolean = false;
				var value:Array = id_height.values;
				
				var stepper:vitalsNumericStipper = vitalsNumericStipper(event.target);
				
				if (value && value.length)
				{
					//if (id_Height.doubleModeOn && value.length > 1)
					if (englishMode)
					{
						/* if( stepper.doubleModeOn )
						isNotValid = ValidateHeightInFeet( event, stepper );
						else */
						isNotValid = ValidateHeightInInches( event, stepper );
					}
					else
					{
						var cm:Number = value[0];
						
						if (cm != 0 && (cm < 38 || cm > 245))
						{
							isNotValid = true;
							inputStepper = stepper.id_numericStipper;
						}
					}
					
					calculateBMI();
					
					if (isNotValid)
					{
						unRegisterFocusOutHandlers();
						hasFocus = focusManager.getFocus();
						
						vital = id_height;
						selectedUnit = 1;
						UtilityFunctions.AskMessage("Provided value for height does not occur in feasible range.\n Do you want to keep these values",alertsCloseHandlerYes,null,
							alertsCloseHandlerNo,null);
						/* Alert.show("Provided value for height does not occur in feasible range.\n Do you want to keep these values",
						"Height out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertsCloseHandler); */
					}
				}
			}
			
