				id_dys.id_numericStipper.textDisplay.text 			= '0';
				id_oxygen.text 										= '0';
				id_BMI.id_Value.text								= '0';
				lbl_Height.text										= 'Ht. (Cm)'; 
				lbl_Weight.text 									= 'Wt. (Kg)'; 
				lbl_Temperature.text 								= 'Temp(C)';
			}
