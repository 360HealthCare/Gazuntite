						id_dys.values     			= [0.0, 0.0];
						
						PhysicalHeight 			= [0.0, 0.0];
						PhysicalWeight 			= 0.0;
						PhysicalTemperature 	= 0.0;
						PhysicalPulse 			= 0.0;
						PhysicalRespiration 	= 0.0;
						PhysicalBPSys 			= 0.0;
						PhysicalBPDys 			= 0.0;
						id_BMI.value 			= 0.0;
						Oxygen 					= "";
						id_oxygen.text 			= "";
						
						/* if (notesPanel && notesPanel.notesDTO)
						{
						notesPanel.notesDTO.Note = "";
						notesPanel.notesDTO.NoteSubject = "";
						notesPanel.id_body.id_subject.text = "";
						notesPanel.id_body.id_message.text = "";
						} */
					});
