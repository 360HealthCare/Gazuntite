			public function SaveData(event:Event):void
			{
				var vital:VitalsDTO = new VitalsDTO();
				
				vital.BPDys = id_dys.values[0].toString();	// this.PhysicalBPDys.toString();
				vital.BPSys =  id_sys.values[0].toString();	//this.PhysicalBPSys.toString();
				vital.Height =  id_height.values[0].toString();	//this.PhysicalHeight.toString();
				vital.Weight =  id_weight.values[0].toString();	//this.PhysicalWeight.toString();
				vital.Pulse = id_pulse.values[0].toString(); 	//this.PhysicalPulse.toString();
				vital.Respiration =  id_resp.values[0].toString();	//this.PhysicalRespiration.toString();
				vital.Temperature =  id_Temperature.values[0].toString();	//this.PhysicalTemperature.toString();
				vital.Oxygen =  id_oxygen.text;					//this.Oxygen.toString(); 
				vital.ID = 0;
				
				
				
				vital.CreatedAt = new Date();
				vital.CreatedBy = model.LoggedInUserId;
				
				vital.IsDeleted = false;
				vital.IsDirty  = true;
				vital.IsMetricDisplaySelected = !englishMode;
				vital.Editable = "true";
				
				vital.PatientID = model.patientID;
				
				vital.VisitDate = model.VisitDate;
				vital.VisitID	=	model.VisitID;
				
				
				if(model.VitalDTO == null)
					model.VitalDTO = new VitalsDTO();
					
				else 
					model.VitalDTO.IsDirty = true;
				
				model.VitalDTO = vital;
				
				
				var mpve:ManagePatientVitalEvent = new ManagePatientVitalEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(mpve);
				
				resetData();
			}
			
