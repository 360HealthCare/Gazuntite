					/* id_Header.id_import.selected = false; */
				}
				
				importVitalsPanel.removePopup();
			}
			
			
			
			private function calculateBMI():void
			{
				
				var hgt:Array = id_height.values;
				var wgt:Array = id_weight.values;
				
				if (_englishMode)
				{
					if (hgt && hgt.length && wgt && wgt.length)
					{
						//var hgtInMeterSq1:Number = Math.pow(UnitConverter.centimetersToMeters(UnitConverter.feetToCentimeters(hgt[0]) + UnitConverter.inchesToCentimeters(hgt[1])), 2);
						
						var cm:Number 				= UnitConverter.inchesToCentimeters( hgt[0] );
						var m:Number 				= UnitConverter.centimetersToMeters( cm );
						var hgtInMeterSq1:Number 	= Math.pow( m, 2 );
						var kg:Number				= UnitConverter.poundsToKilograms( wgt[0] );
						
						if (hgtInMeterSq1 > 0)
						{
							bmi =  int( ( kg / hgtInMeterSq1)* 100 ) / 100;
						}
						else
							bmi = 0;
					}
					else
						bmi = 0;
				}
				else
				{
					if (hgt && hgt.length && wgt && wgt.length)
					{
						var m:Number 				= UnitConverter.centimetersToMeters( hgt[0] );
						
						var hgtInMeterSq2:Number = Math.pow( m , 2);
						
						if (hgtInMeterSq2 > 0)
							bmi = int(( wgt[0] / hgtInMeterSq2 ) * 100 ) / 100;
							//							bmi = Math.round( wgt[0] / hgtInMeterSq2 );
						else
							bmi = 0;
					}
					else
						bmi = 0;
				}
				
				if (isNaN(bmi))
					bmi = 0;
			}
			
			
