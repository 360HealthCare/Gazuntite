							<s:VerticalLayout gap="2" horizontalAlign="center" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
						</s:layout>
						
						<s:Label id="labelField" text="O2" width="100%" fontFamily="Calibri" fontSize="11" textAlign="center" color="#9B9C9C" />
						
						<s:HGroup width="100%" gap="-15" horizontalAlign="center">							
							<components:LabelTextInput   id="id_oxygen"	width="100%" minWidth="40" prompt="" 
														 change="id_oxygen_changeHandler(event)" text="{[this.Oxygen]}"/>
							<components:LabelTextInput  width="15" prompt="%" enabled="false" text="%" />
						</s:HGroup>
						
					</s:SkinnableContainer>	
					<s:VGroup width="40" horizontalAlign="center">
						<vitals:LabelBMI id="id_BMI" fontFamily="Calibri" color="#000000"  label="BMI" value="{bmi}" width="100%" />
					</s:VGroup>
				</s:HGroup> 
				<s:HGroup width="100%">
					<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.VitalsToolTipBG" >
						<s:layout>
							<s:HorizontalLayout verticalAlign="middle"  paddingLeft="5"  />
						</s:layout>
						<s:Label id="lbl_Height" color="#333333"  fontFamily="Calibri" fontSize="12" width="80" maxDisplayedLines="1"/>
						<buttonSkins:buttonSeparator/>
						<s:Label id="lbl_Weight" color="#333333" fontFamily="Calibri" fontSize="12" width="80" maxDisplayedLines="1"/>
						<buttonSkins:buttonSeparator/>
						<s:Label id="lbl_Temperature" color="#333333" fontFamily="Calibri" fontSize="12"  width="80" maxDisplayedLines="1"/>
					</s:SkinnableContainer>
					<mx:Spacer width="100%"/>
					<s:Button label="Next" click="dispatchEvent( new SelectSection('SelectSection', 'id_vital', true, true) )" 
							  buttonMode="true" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QInextBtnSkin" toolTip="Next Section"/>
					
				</s:HGroup>			
				<s:HGroup id="id_IndicatorGrp" width="100%" horizontalAlign="left" includeInLayout="{id_noteIndicator.visible}">
					<s:Button id="id_noteIndicator" label="Notes" visible="false" includeInLayout="{id_noteIndicator.visible}"
							  click="id_noteIndicator_clickHandler(event)" toolTip="View Notes" 
							  useHandCursor="true" buttonMode="true" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.notesIndicatorBtnSkin" />
					<s:Button id="id_dictationIndicator" label="Dictation" visible="false" includeInLayout="{id_dictationIndicator.visible}"
							  click="id_dictationIndicator_clickHandler(event)" toolTip="Play Dictation" 
							  useHandCursor="true" buttonMode="true" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.dictationIndicatorBtnSkin"/>
				</s:HGroup>
				
				
			</s:VGroup>
		</s:SkinnableContainer>
	</s:SkinnableContainer>
</s:Group>
