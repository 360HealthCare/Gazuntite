			private function convertInMetricUnits():void
			{
				if(model.VitalDTO == null)
					return;
				
				var w:Number = UnitConverter.poundsToKilograms(Number(model.VitalDTO.Weight));
				var h:Number = UnitConverter.inchesToCentimeters(Number(model.VitalDTO.Height));
				var t:Number = UnitConverter.fahrenheitToCelsius(Number(model.VitalDTO.Temperature));
				
				this.PhysicalWeight = w;
				this.PhysicalHeight = [h];
				this.PhysicalTemperature = t;
				
				id_weight.values = [w];
				id_height.values = [h];
				id_Temperature.values = [t];
				convertInEnglishAgain();//Tahir Alvi - For display previous selected System values
			}
			
			private function convertInMetricAgain():void
			{
				if(model.VitalDTO == null)
					return;
				
				var t:Number;
				var h:Number;
				var w:Number;
				
				if(Number(id_Temperature.values[0]) == 0){
					t = 0;
				}else{
					t = UnitConverter.fahrenheitToCelsius(Number(id_Temperature.values[0]));
				}
				if(Number(id_height.values[0])== 0){
					h = 0;
				}else{
					h= UnitConverter.inchesToCentimeters(Number(id_height.values[0]));
				}
				if(Number(id_weight.values[0]) == 0){
					w = 0;
				}else{
					w = UnitConverter.poundsToKilograms(Number(id_weight.values[0]));
				}
				
				lbl_Height.text			= 'Ht. (Cm): '  +  numFormatter.format(h).toString() ; 
				lbl_Weight.text 		= 'Wt. (Kg): '  + numFormatter.format(w).toString() ; 
				lbl_Temperature.text 	= 'Temp(C): '   + numFormatter.format(t).toString() ; 
			}
			
			private function convertInEnglishUnits():void
			{
				if(model.VitalDTO == null)
					return;
				
				var w:Number = UnitConverter.kilogramsToPounds(Number(model.VitalDTO.Weight));
				var h:Number = UnitConverter.centimetersToInches(Number(model.VitalDTO.Height));
				var t:Number = UnitConverter.celsiusToFahrenheit(Number(model.VitalDTO.Temperature));
				
				this.PhysicalWeight = w;
				this.PhysicalHeight = [h];
				this.PhysicalTemperature = t;
				
				id_weight.values = [w];
				id_height.values = [h];
				id_Temperature.values = [t];
				convertInMetricAgain();//Tahir Alvi - For display previous selected System values
			}
			
			private function convertInPreviousSystem():void
			{
				if(this.englishMode == true)
					convertInMetricAgain();
				else
					convertInEnglishAgain();
			}
			
			
			private function convertInEnglishAgain():void
			{
				if(model.VitalDTO == null)
					return; 
				
				var t:Number;
				var h:Number;
				var w:Number
				if(Number(id_Temperature.values[0]) == 0){
					t = 0;
				}else{
					t = UnitConverter.celsiusToFahrenheit(Number(id_Temperature.values[0]));
				}
				if(Number(id_height.values[0]) == 0){
					h = 0;
				}else{
					h = UnitConverter.centimetersToInches(Number(id_height.values[0]));
				}
				if(Number(id_weight.values[0]) == 0){
					w = 0;
				}else{
					w = UnitConverter.kilogramsToPounds(Number(id_weight.values[0]));
				}
				
				lbl_Height.text			= 'Ht. (Inch): ' 		+	numFormatter.format(h).toString() ; 
				lbl_Weight.text 		= 'Wt. (lbs): ' 		+	numFormatter.format(w).toString() ; 
				lbl_Temperature.text 	= 'Temp(F): ' 			+ 	numFormatter.format(t).toString() ; 
			}
			
