					englishMode = false;
				}
				else if (event.type == VitalsHeaderEvent.ENGLISH_UNIT_SELECTED)
				{
					englishMode = true;
				}
				else if (event.type == VitalsHeaderEvent.CLEAR_CLICKED)
				{
					(PhysicalHeight[0]   > 	 0 || PhysicalHeight[1] > 0) ||
						PhysicalWeight 		 >	 0;
					PhysicalTemperature  > 	 0;
					PhysicalPulse 		 >   0;
					PhysicalRespiration  >   0;
					PhysicalBPSys 		 >   0.0;
					PhysicalBPDys 		 >   0.0;
					id_BMI.value 		 >   0.0;
					id_oxygen.text 		 != "";
					
					
