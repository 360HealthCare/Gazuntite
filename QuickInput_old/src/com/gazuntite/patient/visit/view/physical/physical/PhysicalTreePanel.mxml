			private function createDummyData( maxDataSize:int = 10, max2rdLevelDataSize:int = 23, max3rdLevelDataSize:int = 23 ):ArrayCollection
			{
				var dummy:ArrayCollection = new ArrayCollection();
				var i:int;
				for( i = 0; i < maxDataSize; i++ )
				{
					var pDTO:PhysicalDTO = new PhysicalDTO();
					pDTO.MainCategoryName = "Parent " + i;
					pDTO.PhysicalMainCategoryTypeID = i;
					pDTO.label = "Parent " + i;
					pDTO.children = new ArrayCollection();
					var j:int;
					var add:Boolean = true;
					for( j = 0; j < max2rdLevelDataSize; j++ )
					{
						add = true;
						var cDTO:PhysicalDTO = new PhysicalDTO();
						cDTO.label = "Child " + i + " " + j;
						cDTO.PhysicalSubCategoryTypeID = j * 2;
						cDTO.PhysicalMainCategoryTypeID = pDTO.PhysicalMainCategoryTypeID;
						cDTO.SubCategoryName = "Child " + i + " " + j;
						if( i == 4 || i == 6 || i == 8 )
						{
							add = false;
							if( j == 3 || j == 5 || j == 7 )
							{
								add = true;
								cDTO.children = new ArrayCollection();
								var k:int;
								for( k = 0; k < max3rdLevelDataSize; k++ )
								{
									var ccDTO:PhysicalDTO = new PhysicalDTO();
									ccDTO.label = "Child " + i + " " + j + " " + k;
									ccDTO.PhysicalSubLevel3CategoryName = "Child " + i + " " + j + " " + k;
									ccDTO.PhysicalSubLevel3CategoryTypeID = k * 3;
									ccDTO.PhysicalSubCategoryTypeID = cDTO.PhysicalSubCategoryTypeID;
									ccDTO.PhysicalMainCategoryTypeID = pDTO.PhysicalMainCategoryTypeID;
									cDTO.children.addItem( ccDTO );
								}
							}
						}
						if( add )
							pDTO.children.addItem( cDTO );
					}
					dummy.addItem( pDTO );
				}
				
				return dummy;
			}
			
			protected function qicollapseableview1_saveDataHandler(event:Event):void
			{
				var mpe:ManagePatientPhysicalEvent = new ManagePatientPhysicalEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( mpe );
				
			}
			
			protected function qicollapseableview1_QSViewStateChangeHandler(event:QSViewStateEvent):void
			{
				if(event.viewState == QSViewStateEvent.EXPANDED_VIEW)
				{
					if( UtilityFunctions.IsNullOrEmpty( model.physicalDTOList ) )
					{
						var cgEvent:LoadPhysicalCategoryTypesEvent = new LoadPhysicalCategoryTypesEvent(model.patientDTO.Gender.toLowerCase() == 'female' ? false:true);
						CairngormEventDispatcher.getInstance().dispatchEvent( cgEvent ); 
						id_PhysicalView.ShowStatusWindow("Please wait while Physical is loading ...");
					}
					
					if( id_Header )
					{
						id_Header.HeadingLable = id_Header.HeadingLable.toUpperCase();
						id_Header.setStyle("skinClass", QIinternalBarFocusSkin);
						id_Header.id_headingLbl.setStyle("color", 0xffffff);
						id_Header.id_expandBtn.selected = true;
						
					} 
				}
					
				else if(event.viewState == QSViewStateEvent.COLLAPSED_VIEW)
				{
					if( id_Header )
					{
						id_Header.HeadingLable = UtilityFunctions.TitleCase(id_Header.HeadingLable);
						id_Header.setStyle("skinClass", QIinternalBarSkin);
						id_Header.id_headingLbl.setStyle("color", 0x000000);
						id_Header.id_expandBtn.selected = false;
						
					} 
					
					QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.PHYSICAL);
				}
				
			}
			
			override protected function id_Header_showNotesPanelHandler(event:Event):void
			{			
				this.notesDTO = null;
				this.DictationDTO = null;
				
				this.notesDTO = QIUtilityFunctions.getModuleNoteDTO(Constants.PHYSICAL_MODULE_NAME);	
				this.DictationDTO = QIUtilityFunctions.getModuleDictationDTO(Constants.PHYSICAL_MODULE_NAME);
				
				super.id_Header_showNotesPanelHandler( event );
				
				
			}
			override protected function onNotesSave(event:Event):void
			{
				if(this.notesDTO.ModuleNoteId == 0) // new note
				{
					this.notesDTO.ManagedByUserId = model.LoggedInUserId;
					this.notesDTO.CreatedBy = model.LoggedInUserId;
					this.notesDTO.CreatedAt = new Date();
					this.notesDTO.ModuleTypeId = QIUtilityFunctions.getModuleIDByName(Constants.PHYSICAL_MODULE_NAME);
					this.notesDTO.VisitID = model.VisitID;
					this.notesDTO.PatientID = model.patientID;
				}
				else // edited Notes
				{
					this.notesDTO.ModifiedBy = model.LoggedInUserId;
					this.notesDTO.ModifiedAt = new Date();
					this.notesDTO.IsDirty = true;
				}	
				
				var ev: ManageModuleNotesEvent = new ManageModuleNotesEvent(this.notesDTO);
				CairngormEventDispatcher.getInstance().dispatchEvent(ev);
				
				if(SetIcon)
					SetIcon = false;
				SetIcon = true;
				trace("child class should implement dictation here");
			}
			
			override protected function id_Header_showDictationPanelHandler(event:Event):void
			{	
				this.notesDTO = null;
				this.DictationDTO = null;
				
				this.notesDTO = QIUtilityFunctions.getModuleNoteDTO(Constants.PHYSICAL_MODULE_NAME);	
				this.DictationDTO = QIUtilityFunctions.getModuleDictationDTO(Constants.PHYSICAL_MODULE_NAME);
				
				super.id_Header_showDictationPanelHandler( event );
			}
			
			override protected function onDictationSave(event:Event):void
			{
				if(this.DictationDTO.ModuleDictationId == 0) // new Dication
				{
					this.DictationDTO.ManagedByUserId = model.LoggedInUserId;
					this.DictationDTO.CreatedBy = model.LoggedInUserId;
					this.DictationDTO.CreatedAt = new Date();
					this.DictationDTO.ModuleTypeID = QIUtilityFunctions.getModuleIDByName(Constants.PHYSICAL_MODULE_NAME);
					this.DictationDTO.VisitID = model.VisitID;
					this.DictationDTO.PatientID = model.patientID;
				}
				else // edited Dication
				{
					this.DictationDTO.ModifiedBy = model.LoggedInUserId;
					this.DictationDTO.ModifiedAt = new Date();
					this.DictationDTO.IsDirty = true;
				}	
				
				var ev: ManageModuleDictationEvent = new ManageModuleDictationEvent(this.DictationDTO);
				CairngormEventDispatcher.getInstance().dispatchEvent(ev);
				
				if(SetIcon)
					SetIcon = false;
				SetIcon = true;
				//trace("child class should implement saveNotes here");
			}
			
			
			
