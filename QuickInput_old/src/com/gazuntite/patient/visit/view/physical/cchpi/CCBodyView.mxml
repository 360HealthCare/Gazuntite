			private function complaintChangeHandler(event : Event /* event:TextOperationEvent */):void
			{
				id_Add.enableAll = (id_ComplaintArea.text.length || id_Symptom.textInput.text.length) && !isNotValid;
				
				//calling isGetEdited() just to check whether to show check mark on complaint change or not
				isGetEdited();
			}
			
			private function onWriteNotesClick(event:Event):void
			{
				if (!recordGridNotesPopUp)
					recordGridNotesPopUp = new NotesPanel();
				
				if (!recordGridNotesPopUp.isPanelShown)
				{
					var headingLabel:String = "";
					
					
					
					var addRecord:AddRecord = AddRecord(event.target);
					
					recordGridNotesPopUp 				= new NotesPanel();
					recordGridNotesPopUp.width			= 250;
					recordGridNotesPopUp.height			= 110;
					recordGridNotesPopUp.HeadingLable 	= id_ComplaintArea.text;
					recordGridNotesPopUp.VisitDateLable = UtilityFunctions.FormatDate(model.VisitDate, "MM-DD-YYYY");//model.FormatedVisitDate;new Date().toDateString();
					recordGridNotesPopUp.ShowPopup(this);
					
					
					
					recordGridNotesPopUp.notesDTO		=  addRecord.notesDTO; //gridNotesDTO;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					
					var pt:Point = id_Add.localToGlobal(new Point(id_Add.id_WriteNotes.x ,id_Add.id_WriteNotes.y));
					
					recordGridNotesPopUp.move(pt.x - 195, pt.y + 20);
					
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);
							
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
							
						}
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
					
					
					recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);								
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
						}
					});
				}
			}
			
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.IMMUNIZATION);
				
				recordLevelDicPanel.move( recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				
				
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.IMMUNIZATION);
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
			}
			
			
			private function comboKeyUpHandler(event:KeyboardEvent):void
			{
				if( event.currentTarget.textInput.text.length < 2 || event.keyCode == Keyboard.DOWN || event.keyCode == Keyboard.UP || event.keyCode == Keyboard.ENTER) 
					return;
				
				var sectionName:String = null;
				var searchString:String;
				if( event.currentTarget == id_Symptom)
				{
					sectionName = QIConstants.SYMPTOM_MODULE_NAME;
					id_Add.enableAll = (id_ComplaintArea.text.length || id_Symptom.textInput.text.length) && !isNotValid;
					
					isGetEdited();
				}
				else if( event.currentTarget == id_Duration )
				{
					sectionName = QIConstants.DURATION_MODULE_NAME;
				}
				else if( event.currentTarget == id_Exacerbating )
				{
					sectionName = QIConstants.EXACERBATING_MODULE_NAME;
				}
				else if( event.currentTarget == id_Location ) 
				{
					sectionName = QIConstants.LOCATION_MODULE_NAME;
				}
				else if( event.currentTarget == id_ModifyingFactors )
				{
					sectionName = QIConstants.MODIFYINGFACTORS_MODULE_NAME;
				}
				else if( event.currentTarget == id_Progression )
				{
					sectionName = QIConstants.PROGRESSION_MODULE_NAME;
				}
				else if( event.currentTarget == id_Quality )
				{
					sectionName = QIConstants.QUALITY_MODULE_NAME;
				}
				else if( event.currentTarget == id_Radiation )
				{
					sectionName = QIConstants.RADIATION_MODULE_NAME;
				}
				else if( event.currentTarget == id_Severity )
				{
					sectionName = QIConstants.SEVERITY_MODULE_NAME;
				}
				else if( event.currentTarget == id_Context )
				{
					sectionName = QIConstants.CONTEXT_MODULE_NAME;
				}
				
				if( sectionName != null )
				{
					searchString = event.currentTarget.textInput.text;
					var ldsdEvent : LoadHPIStaticDataEvent = new LoadHPIStaticDataEvent(sectionName, searchString);
					CairngormEventDispatcher.getInstance().dispatchEvent( ldsdEvent ); 
				}
			}
			private function hpiFocusOutHandler(event:FocusEvent):void
			{
				
			}
			
			private function comboChangeHandler(event:Event):void
			{
				var combo:LabelComboBox = LabelComboBox(event.currentTarget);
				
				id_Add.enabled = isGetEdited() && !isNotValid;
				
				switch(combo.id)
				{
					case "id_Symptom":
						id_Add.enableAll = (id_ComplaintArea.text.length && id_Symptom.textInput.text.length || id_Symptom.selectedIndex != -1) && !isNotValid;
						break;
				}
			}
			
			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if (id_ComplaintArea.text.length || id_Symptom.textInput.text.length || id_Symptom.selectedIndex != -1 ||
					id_OnSet.text.length || id_OnSet.selectedDate != null ||
					id_Duration.textInput.text.length || id_Duration.selectedIndex != -1 ||
					id_Location.textInput.text.length || id_Location.selectedIndex != -1 || 
					id_Quality.textInput.text || id_Quality.selectedIndex != -1 ||
					id_Severity.textInput.text.length || id_Severity.selectedIndex != -1 ||
					id_ModifyingFactors.textInput.text.length || id_ModifyingFactors.selectedIndex != -1 || 
					id_Progression.textInput.text || id_Progression.selectedIndex != -1 ||
					id_Context.textInput.text.length || id_Context.selectedIndex != -1 ||
					id_Exacerbating.textInput.text.length || id_Exacerbating.selectedIndex != -1 ||
					id_Radiation.textInput.text.length || id_Radiation.selectedIndex != -1)
					
					edited = true;
				
				return edited;
			}
			
			private function validateOnSet():void
			{
				id_Add.enabled = isGetEdited() && !isNotValid;
			}
			
			public function resetFields():void
			{
				id_ComplaintArea.text = "";
				id_Symptom.textInput.text = "";
				id_Symptom.selectedIndex = -1;
				
				id_Context.textInput.text = "";
				id_Context.selectedIndex = -1;
				
				id_Duration.textInput.text = "";
				id_Duration.selectedIndex = -1;
				
				id_Exacerbating.textInput.text = "";
				id_Exacerbating.selectedIndex = -1;
				
				id_Location.textInput.text = "";
				id_Location.selectedIndex = -1;
				
				id_ModifyingFactors.textInput.text = "";
				id_ModifyingFactors.selectedIndex = -1;
				
				id_OnSet.text = "";
				id_OnSet.prompt = 'OnSet';
				id_OnSet.selectedDate = null;
				
				id_Progression.textInput.text = "";
				id_Progression.selectedIndex = -1;
				
				id_Quality.textInput.text = "";
				id_Quality.selectedIndex = -1;
				
				id_Radiation.textInput.text = "";
				id_Radiation.selectedIndex = -1;
				
				id_Severity.textInput.text = "";
				id_Severity.selectedIndex = -1;
				
				id_Add.enableAll = false;
				recordNotesDTO = new ModuleNoteDTO();
				
				if (id_Add.dictationDTO)
					id_Add.dictationDTO = new ModuleDictationDTO();
				
				if (id_Add.notesDTO)
					id_Add.notesDTO = new ModuleNoteDTO();
				
				if (recordNotesPanel)
					recordNotesPanel.removePopup();
			}
			
			
			
			private function addRecordClickHandler(event:Event):void
			{
				model.HPI_CCDTOList.addItemAt(getCCHPIDetails(), 0);
				
				var mphe:ManagePatientHPIEvent = new ManagePatientHPIEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( mphe );
				
				hasViewChanged  = true;
				
				resetFields();
				
				id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
				id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
			}
			
