				<s:Label id="id_HPI" text="History of Present Illness" fontFamily="Calibri" fontSize="12" color="#D5DDEA"/>
				<s:HGroup width="100%" >
					<s:VGroup width="50%" gap="2">
						<components1:LabelComboBox id="id_Symptom" prompt="Symptoms" width="100%"  dataProvider="{model.Symptoms}" 
												  keyUp="comboKeyUpHandler(event)"  focusOut="hpiFocusOutHandler(event)" change="comboChangeHandler(event)"
												  maxChars="350" skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="4"
												  toolTip="Select Symptom"/>
						<components1:LabelComboBox id="id_Location"  maxChars="220" fontFamily="Calibri" prompt="Location" width="100%"  
												  keyUp="comboKeyUpHandler(event)"  dataProvider="{model.Location}"
												  change="comboChangeHandler(event)" tabIndex="7"
												  toolTip="Select Location"/>
						<components1:LabelComboBox id="id_Severity"  maxChars="220" fontFamily="Calibri" prompt="Severity" width="100%" 
												  keyUp="comboKeyUpHandler(event)"   dataProvider="{model.Severity}"
												  change="comboChangeHandler(event)" tabIndex="9"
												  toolTip="Select Severity"/>
						<components1:LabelComboBox id="id_ModifyingFactors" maxChars="220"  fontFamily="Calibri" prompt="Modifying Factors" width="100%"  
												  keyUp="comboKeyUpHandler(event)"   dataProvider="{model.ModifyingFactors}"
												  change="comboChangeHandler(event)" tabIndex="11"
												  toolTip="Select Modifying Factors"/>
						<components1:LabelComboBox id="id_Progression"  maxChars="220" fontFamily="Calibri" prompt="Progression" width="100%"  
												  keyUp="comboKeyUpHandler(event)"   dataProvider="{model.Progression}"
												  change="comboChangeHandler(event)" tabIndex="13"
												  toolTip="Select Progression"/>
					</s:VGroup>
					<s:VGroup width="50%" gap="2">
						<s:HGroup width="100%">
							<components1:LabelDateField id="id_OnSet" prompt="OnSet" width="50%"  editable="true" 
													   keyUp="validateOnSet()" yearNavigationEnabled="true"
													   change="validateOnSet()" restrict="[/ 0-9]"
													   selectableRange="{{rangeEnd : new Date()}}" tabIndex="5" toolTip="Select Onset date"/>													
							
							<components1:LabelComboBox id="id_Duration" maxChars="220" fontFamily="Calibri " prompt="Duration" width="50%"  
													  keyUp="comboKeyUpHandler(event)"   dataProvider="{model.Duration}"
													  change="comboChangeHandler(event)" tabIndex="6" toolTip="Select Duration"/>
						</s:HGroup>
						<components1:LabelComboBox id="id_Quality" maxChars="220" fontFamily="Calibri " prompt="Quality" width="100%"  
												  keyUp="comboKeyUpHandler(event)"    dataProvider="{model.Quality}"
												  change="comboChangeHandler(event)" tabIndex="8" toolTip="Select Quality"/>
						<components1:LabelComboBox id="id_Context" maxChars="220" fontFamily="Calibri " prompt="Context" width="100%"  
												  keyUp="comboKeyUpHandler(event)"    dataProvider="{model.Context}"
												  change="comboChangeHandler(event)" tabIndex="10" toolTip="Select Context"/>
						<components1:LabelComboBox id="id_Exacerbating" maxChars="220" fontFamily="Calibri" prompt="Exacerbating" width="100%"  
												  keyUp="comboKeyUpHandler(event)"   dataProvider="{model.Exacerbating}"
												  change="comboChangeHandler(event)" tabIndex="12" toolTip="Select Exacerbating"/>
						<components1:LabelComboBox id="id_Radiation" maxChars="220" fontFamily="Calibri " prompt="Radiation" width="100%"  
												  keyUp="comboKeyUpHandler(event)"   dataProvider="{model.Radiation}"
												  change="comboChangeHandler(event)" tabIndex="14" toolTip="Select Radiation"/>
					</s:VGroup>
				</s:HGroup>
			</s:VGroup>
			<s:HGroup width="100%">
				<s:Button id="id_add" click="addRecordClickHandler(event)" width="135" buttonMode="true" useHandCursor="true" toolTip="Add Record"
						  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreTooltipBtn" label="Add CC/HPI" tabIndex="15" enabled="{id_Add.enableAll}"/> <!-- -->
				<s:SkinnableContainer width="229" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.tooltipBG" visible="{!id_add.enabled}"  />
				<!-- Tahir Alvi - Linking of HPI entries with already added complaint -->
				<s:CheckBox id="id_HPICheckBox" label="Attach HPI with" change="id_HPICheckBox_changeHandler(event)" color="#FFFFFF" visible="false" includeInLayout="{id_HPICheckBox.visible}"/>
				<components1:LabelComboBox id="id_SavedComplaint" prompt="Complaint...." width="120" enabled="{id_HPICheckBox.selected ? true : false}" visible="false" includeInLayout="{id_SavedComplaint.visible}"/>
				<mx:Spacer width="100%"/>
				<s:Button id="id_nextBtn" label="Next" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QInextBtnSkin" buttonMode="true" 
						  toolTip="Next Section" enabled="true" click="id_nextBtn_clickHandler(event)" />
				
			</s:HGroup>
			
			<s:List id="id_List"  width="100%" height="100%"  
					itemRenderer="com.gazuntite.patient.visit.view.itemrenderers.CCItemRendererMxml"
					rollOverColor="#D5CFB8" selectionColor="#D5CFB8" verticalScrollPolicy="off" horizontalScrollPolicy="off"
					dataProvider="{ccCollection}"
					maxHeight="200"
					visible="{id_List.dataProvider.length > 0}" includeInLayout="{id_List.visible}"
					>
				<s:layout>
					<s:VerticalLayout requestedRowCount="{id_List.dataProvider.length}" requestedMinRowCount="0" 
									  paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0" gap="0"/>
				</s:layout>
			</s:List>      
		</s:SkinnableContainer>
	</s:SkinnableContainer>
</s:Group>
