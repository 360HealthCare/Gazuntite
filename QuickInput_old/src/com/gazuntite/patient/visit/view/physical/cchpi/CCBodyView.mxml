			private function getCCHPIDetails():HPI_CCDTO
			{
				var hpi_ccDTO:HPI_CCDTO = new  HPI_CCDTO();
				hpi_ccDTO.ChiefComplaint = id_ComplaintArea.text;
				
				//Moeen , to add new record
				hpi_ccDTO.IsDirty = true;
				hpi_ccDTO.IsRecordEditable = true;
				hpi_ccDTO.PatientHPIID = 0;
				hpi_ccDTO.ClinicBranchID = model.ClinicBranchIdSeq;
				
				
				if(id_Add.notesDTO)
				{
					hpi_ccDTO.NoteSubject = id_Add.notesDTO.NoteSubject;
					hpi_ccDTO.Note = id_Add.notesDTO.Note;
				}
				
				if(null != recordLevelDicPanel)
				{
					if(recordLevelDicPanel.DictationID != Constants.GUID_FORMAT)
						hpi_ccDTO.DictationID = recordLevelDicPanel.DictationID;
				}
				
				
				hpi_ccDTO.HPIFields = new HPIDetailsDTO();
				
				if(ValidationUtils.TrimString(id_Symptom.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Symptom 			= ValidationUtils.TrimString(id_Symptom.textInput.text);
				
				if(ValidationUtils.TrimString(id_Location.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Location 			= ValidationUtils.TrimString(id_Location.textInput.text);
				
				if(ValidationUtils.TrimString(id_Severity.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Severity 			= ValidationUtils.TrimString(id_Severity.textInput.text);
				
				if(ValidationUtils.TrimString(id_ModifyingFactors.textInput.text).length>0)
					hpi_ccDTO.HPIFields.ModifyingFactors 	= ValidationUtils.TrimString(id_ModifyingFactors.textInput.text);
				
				if(ValidationUtils.TrimString(id_Progression.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Progression 		= ValidationUtils.TrimString(id_Progression.textInput.text);
				
				
				if(id_OnSet.text != null)
				{
					hpi_ccDTO.HPIFields.Onset 			= id_OnSet.text;//selectedDate;
				}									
				
				if(ValidationUtils.TrimString(id_Duration.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Duration 			= ValidationUtils.TrimString(id_Duration.textInput.text);
				
				if(ValidationUtils.TrimString(id_Quality.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Quality 			= ValidationUtils.TrimString(id_Quality.textInput.text);
				
				if(ValidationUtils.TrimString(id_Context.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Context 			= ValidationUtils.TrimString(id_Context.textInput.text);
				
				
				if(ValidationUtils.TrimString(id_Exacerbating.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Exacerbating 		= ValidationUtils.TrimString(id_Exacerbating.textInput.text);
				
				if(ValidationUtils.TrimString(id_Radiation.textInput.text).length>0)
					hpi_ccDTO.HPIFields.Radiation 			= ValidationUtils.TrimString(id_Radiation.textInput.text);
				
				//M these are to be initialized as well
				hpi_ccDTO.DictationID = Constants.GUID_FORMAT;
				hpi_ccDTO.CreatedAt = new Date();
				hpi_ccDTO.ModifiedAt = Constants.NULL_DATE;
				
				hpi_ccDTO.CreatedBy = model.LoggedInUserId;		
				
				
				
				//hpi_ccDTO.ClinicBranchID				= model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
				hpi_ccDTO.CreatedBy			= model.LoggedInUserId;//userSelectedRoleDTO.UserTypeRole.UserTypeId;
				hpi_ccDTO.ModifiedBy		= model.LoggedInUserId;//userSelectedRoleDTO.UserTypeRole.UserTypeId;
				
				hpi_ccDTO.PatientID = model.patientID;
				
				if( model.VisitID)
				{
					hpi_ccDTO.VisitID 	= model.VisitID;
					hpi_ccDTO.VisitDate = model.VisitDate;
				}
				/* else if(model.quickInputDTO!= null && model.quickInputDTO.Visit!=null)
				{
				hpi_ccDTO.VisitID 	= model.quickInputDTO.Visit.VisitId;
				hpi_ccDTO.VisitDate = model.quickInputDTO.Visit.VisitDate;
				} */
				
				if (id_Add.notesDTO)
				{
					/* hpi_ccDTO.Note = id_Add.notesDTO.Note;
					hpi_ccDTO.NoteSubject = id_Add.notesDTO.NoteSubject; */
				}
				
				//M need to add in model also
				//model.quickInputDTO.Physical.HPI_CC.addItem(hpi_ccDTO);
				//model.quickInputDTO.Physical.HPI_CC.addItem(hpi_ccDTO);
				
				
				//if (!model.symptom.contains(id_Symptom.textInput.text))
				if(ValidationUtils.TrimString(id_Symptom.textInput.text).length>0)
					model.Symptoms.addItem(ValidationUtils.TrimString(id_Symptom.textInput.text));
				
				if(ValidationUtils.TrimString(id_Location.textInput.text).length>0)
					model.Location.addItem(ValidationUtils.TrimString(id_Location.textInput.text));
				
				if(ValidationUtils.TrimString(id_Severity.textInput.text).length>0)
					model.Severity.addItem(ValidationUtils.TrimString(id_Severity.textInput.text));
				
				if(ValidationUtils.TrimString(id_ModifyingFactors.textInput.text).length>0)
					model.ModifyingFactors.addItem(ValidationUtils.TrimString(id_ModifyingFactors.textInput.text));
				
				if(ValidationUtils.TrimString(id_Progression.textInput.text).length>0)
					model.Progression.addItem(ValidationUtils.TrimString(id_Progression.textInput.text));
				
				if(ValidationUtils.TrimString(id_Duration.textInput.text).length>0)
					model.Duration.addItem(ValidationUtils.TrimString(id_Duration.textInput.text));
				
				if(ValidationUtils.TrimString(id_Quality.textInput.text).length>0)
					model.Quality.addItem(ValidationUtils.TrimString(id_Quality.textInput.text));
				
				if(ValidationUtils.TrimString(id_Context.textInput.text).length>0)
					model.Context.addItem(ValidationUtils.TrimString(id_Context.textInput.text));
				
				if(ValidationUtils.TrimString(id_Exacerbating.textInput.text).length>0)
					model.Exacerbating.addItem(ValidationUtils.TrimString(id_Exacerbating.textInput.text));
				
				if(ValidationUtils.TrimString(id_Radiation.textInput.text).length>0)
					model.Radiation.addItem(ValidationUtils.TrimString(id_Radiation.textInput.text)); 
				
				return hpi_ccDTO;
			}
			
			protected function cc(event:FlexEvent):void
			{
				id_List.addEventListener(DataGridActionsEvent.SAVE_RECORD_CLICK, saveRecordClickHandler, false, 0, true);
				id_List.addEventListener(DataGridActionsEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				id_List.addEventListener("NotesSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
				id_List.addEventListener("DictationSavedFromGrid", NotesDictationSavedFromGrid, false, 0, true);
			}
			
			private function saveRecordClickHandler(event:DataGridActionsEvent):void
			{
				if (!event.data)
					return;
				
				var hpi_ccDTO:HPI_CCDTO;
				
				if (event.data is HPI_CCDTO)
					hpi_ccDTO = event.data as HPI_CCDTO;
				
				if (!hpi_ccDTO)
					return;
				
				if (!hpi_ccDTO.IsDirty)
					return;
				
				if (model && model.HPI_CCDTOList)
				{
					//model.HPI_CCDTOList.removeAll();
					//model.HPI_CCDTOList = ccCollection;
					
					var mphe:ManagePatientHPIEvent = new ManagePatientHPIEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( mphe );
				}
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if (!event.data)
					return;
				
				var hpi_ccDTO:HPI_CCDTO;
				
				if (event.data is HPI_CCDTO)
					hpi_ccDTO = event.data as HPI_CCDTO;
				
				if (!hpi_ccDTO)
					return;
				
				
				UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
				{
					hpi_ccDTO.IsDeleted = true;
					hpi_ccDTO.IsDirty = true;
					
					hasViewChanged = true;
					
					var mphe:ManagePatientHPIEvent = new ManagePatientHPIEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( mphe );
				});
			}
			
			protected function NotesDictationSavedFromGrid(event:Event):void
			{
				var mphe:ManagePatientHPIEvent = new ManagePatientHPIEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( mphe );
			}
			
			protected function id_nextBtn_clickHandler(event:MouseEvent):void
			{
				
				AllowMoveToNextPanel ( dispactchSelectSectionEvent );
				
				
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new SelectSection('SelectSection', 'id_CCPanel', true, true) );
			}
			
			public function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_Add.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
			
		]]>
	</fx:Script>
