<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:social="com.gazuntite.patient.visit.view.pmh.compHistory.social.*"
		 
		 
		 >
	<fx:Script>
		<![CDATA[
			
			private var m_sLabel:String = "Press Yes or No";
			private var m_bIsSelected:Boolean 		= false;
			
			[Bindable]
			public function get Label():String
			{
				return m_sLabel;
			}
			
			public function set Label(value:String):void
			{
				m_sLabel = value;
			}
			
			[Bindable]
			public function get IsSelected():Boolean
			{
				return m_bIsSelected;
			}
			
			public function set IsSelected(value:Boolean):void
			{
				m_bIsSelected = value;
			}
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" />
	</s:layout>
	<mx:ViewStack id="id_Views" width="100%" height="100%" resizeToContent="true"  creationPolicy="all" selectedIndex="{IsSelected ? 1:0}">
		<s:NavigatorContent width="100%">
			<s:RichText id="id_label" text="{Label}" width="100%" />
		</s:NavigatorContent>
		
		<s:NavigatorContent width="100%">
			<social:socialDetails id="id_DetailsView" width="100%" />
		</s:NavigatorContent>
	</mx:ViewStack>
	
	
</s:Group>
