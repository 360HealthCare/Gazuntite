			private function OnSocialYesNoClick(value:String, secLabel:String, target:OptionButton):void
			{
				setSelectedTab( secLabel );
				
				 var selSec:socialYesNo = ( id_Views.selectedChild as NavigatorContent ).getElementAt( 0 ) as socialYesNo;
				selSec.Label = "You have selected";
				selSec.Label2 = value;
				selSec.IsSelected = (value.toLowerCase() == QIConstants.STRING_YES_UI) ? true:false;
				
				if(value == QIConstants.STRING_YES_UI)
				{
					selSec.id_Views.selectedIndex = 2;
				}
				else if( value == QIConstants.STRING_NO_UI )
				{
					selSec.id_Views.selectedIndex = 0;
				}
				
				callLater( function():void 
				{
					UpdateModel( value );
					if( selSec.SocialHistoryAddictionDto )
						selSec.SocialHistoryAddictionDto.IsDirty = true;
					hasChange = true;
					dispatchEvent( new Event("data_added", true, true) );
				}); 
			}
			
