			private function OnDrugYesNoClick(value:String, secLabel:String, target:OptionButton):void
			{
				setSelectedTab( secLabel );
				
				var sec:socialYesNo 	= ( id_Views.selectedChild as NavigatorContent ).getElementAt( 0 ) as socialYesNo;
				sec.Label 				= "You have selected";
				sec.Label2				= value;
				sec.IsSelected 			= (value.toLowerCase() == "yes") ? true:false;
				
				if( null == sec.SocialHistoryAddictionDto )
					BindTabData( secLabel );
				
				if( sec.SocialHistoryAddictionDto )
				{
					 switch( value )
					{
						case QIConstants.STRING_YES_UI:
							sec.SocialHistoryAddictionDto.IsYesSelected 	= QIConstants.STRING_TRUE;
							sec.SocialHistoryAddictionDto.IsNoSelected 		= QIConstants.STRING_FALSE;
							sec.SocialHistoryAddictionDto.IsUnknown 		= false;
							break;
						case QIConstants.STRING_NO_UI:
							sec.SocialHistoryAddictionDto.IsYesSelected 	= QIConstants.STRING_FALSE;
							sec.SocialHistoryAddictionDto.IsNoSelected 		= QIConstants.STRING_TRUE;
							sec.SocialHistoryAddictionDto.IsUnknown 		= false;
							break;
						case QIConstants.UNKNOWN:
							sec.SocialHistoryAddictionDto.IsYesSelected 	= QIConstants.STRING_FALSE;
							sec.SocialHistoryAddictionDto.IsNoSelected 		= QIConstants.STRING_FALSE;
							sec.SocialHistoryAddictionDto.IsUnknown 		= true;
							break;
					} 
				}
				
				callLater( function():void 
				{
					UpdateModel( value );
					dispatchEvent( new Event("data_added", true, true) );
				});
			}
