			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				
				if (!event.data)
					return;
				
				var medicalHistoryDTO:MedicalHistoryDTO;
				
				if (event.data is MedicalHistoryDTO)
					medicalHistoryDTO = event.data as MedicalHistoryDTO;
				
				if (!medicalHistoryDTO)
					return;
				
				UtilityFunctions.AskMessage("Do you want to delete selected record", function():void
				{
					medicalHistoryDTO.IsDeleted = true;
					medicalHistoryDTO.IsDirty = true;
					medicalHistoryDTO.ModifiedAt = new Date();
					medicalHistoryDTO.ModifiedBy = model.LoggedInUserId;
					
					if (!model.GeneralMedicalHistoryList)
						model.GeneralMedicalHistoryList = new ArrayCollection();
					
					model.GeneralMedicalHistoryList.addItemAt(medicalHistoryDTO, 0);
					
					dispatchEvent(new Event("saveGeneralHistoryEvent", true));
				});
			}
			
			private function getIcdCodeName(oItem:Object,iCol:int):String
			{
				var strIcdCodeName:String = '';
				
				if (oItem && oItem.ICDDTO && oItem.ICDDTO.IcdCodeName)
				{
					strIcdCodeName = oItem.ICDDTO.IcdCodeName;
					if(strIcdCodeName == '0')
					{
						strIcdCodeName = '';
					}
				}
				return strIcdCodeName;
			}
			private function setOnSet(oItem:Object,iCol:int):String
			{
				 var strVisitDate:String = '';
				
				if (oItem && oItem.OnSet)
