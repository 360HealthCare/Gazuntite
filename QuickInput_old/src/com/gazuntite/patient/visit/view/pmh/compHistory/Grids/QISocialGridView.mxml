				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Amount" wordWrap="true"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" dataField="Amount" editorDataField="editorText">
