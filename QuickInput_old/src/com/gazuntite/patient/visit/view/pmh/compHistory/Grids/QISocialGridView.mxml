			protected function getCurrentLabel(obj:Object, dgc:DataGridColumn):String
			{
				if( obj.Current == Constants.STRING_YES_UI )
					return "Present";
				if( obj.Current == Constants.STRING_NO_UI )
					return "Past";
				
				return "";
			}
			private function setOnSet(oItem:Object,iCol:int):String
			{
				var str:String = '';
				
				if (oItem && oItem.OnSet)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.OnSet));
					str = formatDateTime.format(dateRecieved);
					if( str.indexOf('NaN',0) != -1)
						str = oItem.OnSet;
				}
				return str;
			}
			private function setEndDate(oItem:Object,iCol:int):String
			{
				var str:String = '';
				
				if (oItem && oItem.EndDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.EndDate));
					str = formatDateTime.format(dateRecieved);
					if( str.indexOf('NaN',0) != -1)
						str = oItem.EndDate;
				}
				
				if(str == '01/01/1901')
					str = '';
				return str;
			}
			
