			public override function set AllowContents(value:Boolean):void
			{
				super.AllowContents 		= value;
				
				if( !value )
					DeselectAllButtons();
				
				if( id_Views )
				{
					id_Views.visible 			= value;
					id_Views.includeInLayout	= value;
					
					if( value )
					{
						setSelectedTab( id_Views.selectedChild.label );
						BindTabData( id_Views.selectedChild.label );
					}
					
					/* if( ! model.isNewVisitCreated && value  ) //load data if not new visit
					{
					LoadData();
					} */
				}
			}
			
			public function ClearData( executeBinding:Boolean = false ):void
			{
				id_MedicalTab.medicalHistoryDto = null;
				id_ChildhoodTab.medicalHistoryDto = null;
				id_SurgicalTab.medicalHistoryDto = null;
				id_OtherTab.medicalHistoryDto = null;
				
				if( executeBinding )
				{
					setSelectedTab( id_Views.selectedChild.label );
					BindTabData( id_Views.selectedChild.label.toLowerCase() );
				}
			}
			
			protected function id_Views_changeHandler(event:IndexChangedEvent):void
			{
				BindTabData( id_Views.selectedChild.label )
				makeAllLabelsTitleCase();
				(id_Views.selectedChild as NavigatorContent).label = id_Views.selectedChild.label.toUpperCase();
				
				QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.COMPREHENSIVE_HISTORY);
			}
			
			private function makeAllLabelsTitleCase():void
			{
				id_MedicalSec.label		= UtilityFunctions.TitleCase( id_MedicalSec.label 	);
				id_ChildhoodSec.label	= UtilityFunctions.TitleCase( id_ChildhoodSec.label );
				id_SurgicalSec.label	= UtilityFunctions.TitleCase( id_SurgicalSec.label 	);
				id_OtherSec.label		= UtilityFunctions.TitleCase( id_OtherSec.label 	);
			}
			
			private function BindTabData(tabName:String):void
			{
				var tabtitle:String = UtilityFunctions.TitleCase( tabName );
				switch( tabtitle )
				{
					case QIConstants.MEDICAL_MODULE_NAME:
						//if( ! id_MedicalNotes.medicalHistoryDto )
						id_MedicalTab.medicalHistoryDto = QIUtilityFunctions.getGeneralHistoryDTO(  QIConstants.MEDICAL_MODULE_NAME );
						break;
					case QIConstants.CHILDHOOD_MODULE_NAME:
						//if( ! id_ChildhoodNotes.medicalHistoryDto )
						id_ChildhoodTab.medicalHistoryDto = QIUtilityFunctions.getGeneralHistoryDTO(  QIConstants.CHILDHOOD_MODULE_NAME );
						break;
					case QIConstants.SURGICAL_MODULE_NAME:
						//if( ! id_SurgicalNotes.medicalHistoryDto )
						id_SurgicalTab.medicalHistoryDto = QIUtilityFunctions.getGeneralHistoryDTO(  QIConstants.SURGICAL_MODULE_NAME );
						break;
					case QIConstants.OTHER_MODULE_NAME:
						//if( ! id_OtherNotes.medicalHistoryDto )
						id_OtherTab.medicalHistoryDto = QIUtilityFunctions.getGeneralHistoryDTO(  QIConstants.OTHER_MODULE_NAME );
						break;
				}
			}
			
			public function set selectFirstTab( value:Boolean ):void
			{
				if( value )
				{
					callLater( function():void
					{
						BindTabData( QIConstants.MEDICAL_MODULE_NAME );
						setSelectedTab( QIConstants.MEDICAL_MODULE_NAME );
						
						id_MedicalTab.id_NotesView.id_TextArea.setFocus();
					});
				}
			}
			
			public function DeselectAllButtons():void
			{
				if( id_tab1 != null )
				{
					id_tab1.id_MainButton.selected = false;
					id_tab2.id_MainButton.selected = false;
					id_tab3.id_MainButton.selected = false;
					id_tab4.id_MainButton.selected = false;
				}
			}
			
			public function clearGeneralSectionView():void
			{
				id_MedicalTab.id_View.id_DetailsView.resetFields();
				id_MedicalTab.id_NotesView.id_TextArea.text 		= '';
				id_MedicalTab.id_NotesView.hasChange 				= false;
				id_ChildhoodTab.id_View.id_DetailsView.resetFields();
				id_ChildhoodTab.id_NotesView.id_TextArea.text 		= '';
				id_ChildhoodTab.id_NotesView.hasChange 				= false;
				id_SurgicalTab.id_View.id_DetailsView.resetFields();
				id_SurgicalTab.id_NotesView.id_TextArea.text 		= '';
				id_SurgicalTab.id_NotesView.hasChange 				= false;
				id_OtherTab.id_View.id_DetailsView.resetFields();
				id_OtherTab.id_NotesView.id_TextArea.text 			= '';
				id_OtherTab.id_NotesView.hasChange 					= false;
			}
			
