			private function getMedicalDTOofSelectedTab():MedicalHistoryDTO
			{
				var medicalDTO:MedicalHistoryDTO;
				
				switch(id_Views.selectedIndex)
				{
					case 0:
						if (id_MedicalTab)
							medicalDTO = id_MedicalTab.medicalHistoryDto;
						break;
					
					case 1: 
						if (id_ChildhoodTab)
							medicalDTO = id_ChildhoodTab.medicalHistoryDto;
						break;
					
					case 2:
						if (id_SurgicalTab)
							medicalDTO = id_SurgicalTab.medicalHistoryDto;
						break;
					
					case 3:
						if (id_OtherTab)
							medicalDTO = id_OtherTab.medicalHistoryDto;
						break;	
				}
				
				return medicalDTO;
			}
			
			private function UpdateChange():void
			{
				try
				{
					hasChange = WasYesNoClicked || id_MedicalTab.hasChange || id_ChildhoodTab.hasChange || id_SurgicalTab.hasChange || id_OtherTab.hasChange || model.GeneralMedicalHistoryList.length > 0;
					
				}
				catch( e:Error )
				{
					trace( "QICH::General Section", e.message );
				}
			}
			
			private function OnNotesChangeHandler(event:Event):void
			{
				showRButton();
			}
			
			private function showRButton():void
			{
				if( id_MedicalTab.id_NotesView.id_TextArea.text.length > 0 )
					ShowRButtonOn( id_tab1, true );
				else
					ShowRButtonOn( id_tab1, false );
				
				if( id_ChildhoodTab.id_NotesView.id_TextArea.text.length > 0 )
					ShowRButtonOn( id_tab2, true );
				else
					ShowRButtonOn( id_tab2, false );
				
				if( id_SurgicalTab.id_NotesView.id_TextArea.text.length > 0 )
					ShowRButtonOn( id_tab3, true );
				else
					ShowRButtonOn( id_tab3, false );
				
				if( id_OtherTab.id_NotesView.id_TextArea.text.length > 0 )
					ShowRButtonOn( id_tab4, true );
				else
					ShowRButtonOn( id_tab4, false );
				
			}
			
			private function ShowRButtonOn(tab:OptionButton, value:Boolean):void
			{
				/* tab.id_R.includeInLayout = value;
				tab.id_R.visible		 = value; */
				
				
				
				if( value )
				{
					tab.id_Y.selected = true;
					tab.id_N.selected = false;
					tab.id_Y.setStyle("skinClass", YNotesRadioButton);
				}
				else
				{
					tab.id_Y.setStyle("skinClass", YRadioButton);
					/* tab.id_Y.selected = false;
					tab.id_N.selected = true; */
				} 
			}
			
			private function OnNotesCloseClick(event:MouseEvent):void
			{
				OnNotesClose();			
				DeselectAllButtons();
				
				event.stopImmediatePropagation();
			}
			//-- check has any record save with Yes
			private function isPreviousYesValue():Boolean
			{
				var hasYes:Boolean = false;

				for( var i:int = 0; i < model.PreviousGeneralMedicalHistoryList.length; i++ )
				{
					var dto:MedicalHistoryDTO = model.PreviousGeneralMedicalHistoryList.getItemAt( i ) as MedicalHistoryDTO;
					hasYes = dto.IsNone != QIConstants.STRING_TRUE;
					if( hasYes )
						break;
				} 
				return hasYes;
			}
			//find the sub section id of general section
			private function findSectionTypeID(label:String):int
			{
				var val:int = 0;
				
				switch(label)
				{
					case 'Medical':
						val = 1;
						break;
					case 'Childhood':
						val = 2;
						break;
					case 'Surgical':
						val = 3;
						break;
					case 'Other':
						val = 4;
						break;
				}
				return val;
			}
			// ---Tahir Alvi-------- on Yes No Click option button -------------------
			private function OnYesNoClick(value:String, secLabel:String, target:OptionButton):void
			{
				setSelectedTab( secLabel );
				var sectionTypeID:int = findSectionTypeID(secLabel);
				WasYesNoClicked = true;
				
				var elm:GeneralSectionTabImpl = (id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as GeneralSectionTabImpl;
				
				if( null == elm.medicalHistoryDto )
					BindTabData( id_Views.selectedChild.label )
				
				if( ( isPreviousYesValue()  || elm.medicalHistoryDto.ICDDTO.ID  ) && value == QIConstants.STRING_NONE_UI )
				{
					var strAlertMessage:String = "Do you want to delete"+" "+secLabel+" "+" history?";
					Alert.show(strAlertMessage,"Clear Data", Alert.YES|Alert.NO, 
						FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
						{
							if( event.detail == Alert.YES)
							{
								elm.medicalHistoryDto.Note 					= "";
								elm.id_NotesView.id_TextArea.text 		 	= "";
								elm.medicalHistoryDto.IsNone 				= true;
								elm.medicalHistoryDto.IsDirty 				= true;
								//elm.medicalHistoryDto.ICDCodeList.removeAll();

								if(null != model.GeneralMedicalHistoryList)
									model.GeneralMedicalHistoryList.removeAll();
								else
									model.GeneralMedicalHistoryList = new ArrayCollection();
								
								model.GeneralMedicalHistoryList.addItem(elm.medicalHistoryDto);
								
								changeTabYesNoSkin(elm.id);
								var medical_section:int = 1;
								
								var delEve:DeleteComprehensiveModuleDatabyPatientIDEvent = new DeleteComprehensiveModuleDatabyPatientIDEvent(model.patientID, medical_section, sectionTypeID, model.ClinicBranchIdSeq,clearGeneralHistory); 
								CairngormEventDispatcher.getInstance().dispatchEvent( delEve );
								
								setYesNoValue(value); 
							}
							else if( event.detail == Alert.NO)
							{
								elm.IsSelected 					= true;
								target.id_Y.selected 			= true;
								target.id_N.selected 			= false;
								elm.medicalHistoryDto.IsNone 	= false;
								setYesNoValue(QIConstants.STRING_YES_UI);
								showRButton();
							}
						});
				}
				else
				{
					setYesNoValue(value);
				}
				
				UpdateChange();
				/* elm.id_View.id_DetailsView.id_ICDCode.setFocus(); */
				dispatchEvent( new Event("data_added", true, true) );
			}
			
			// Tahir Alvi -- response of delete records from general history
			private function clearGeneralHistory(val:*=null):void
			{
				dispatchEvent( new Event("saveGeneralHistoryEvent", true, true) );
			}
			
			private function setYesNoValue(value:String):void
			{
				var elm:GeneralSectionTabImpl = (id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as GeneralSectionTabImpl;
				
				elm.Label = "You have selected \n" + value;
				elm.IsSelected = (value == QIConstants.STRING_YES_UI) ? true:false;
				
				/* if( value == QIConstants.STRING_YES_UI )
				callLater( elm.id_NotesView.id_TextArea.setFocus ); */
				
				//elm.medicalHistoryDto.IsNone = (value == QIConstants.STRING_NONE_UI )? QIConstants.STRING_TRUE:QIConstants.STRING_FALSE;
				
				if( value == QIConstants.STRING_NONE_UI )
				{
					elm.id_Views.selectedIndex = 0;
				}
			}
			
			private function changeTabYesNoSkin(id_name:String):void
			{
				if(id_name == "id_MedicalTab")
				{
					//id_tab1.id_Y.selected = false;//com.adobe.Quivus.view.controls.skins.radioButtonSkins.YRadioButton
					id_tab1.id_Y.setStyle("skinClass", YRadioButton);
				}
				else if(id_name == "id_ChildhoodTab")
				{
					//id_tab2.id_Y.selected = false;
					id_tab2.id_Y.setStyle("skinClass", YRadioButton);
				}
				else if(id_name == "id_SurgicalTab")
				{
					//id_tab3.id_Y.selected = false;
					id_tab3.id_Y.setStyle("skinClass", YRadioButton);
				}
				else if(id_name == "id_OtherTab")
				{
					//id_tab4.id_Y.selected = false;
					id_tab4.id_Y.setStyle("skinClass", YRadioButton);
				}
			}
			
			private function OnTabClick(event:MouseEvent, secLabel:String):void
			{
				setSelectedTab( secLabel );
			}
			
			private function setSelectedTab(tabName:String):void
			{
				var tabtitle:String = UtilityFunctions.TitleCase( tabName );
				switch( tabtitle )
				{
					case QIConstants.MEDICAL_MODULE_NAME:
						id_Views.selectedIndex = 0;
						id_MedicalTab.id_View.id_DetailsView.id_ICDCode.setFocus();
						break;
					case QIConstants.CHILDHOOD_MODULE_NAME:
						id_Views.selectedIndex = 1;
						id_ChildhoodTab.id_View.id_DetailsView.id_ICDCode.setFocus();
						break;
					case QIConstants.SURGICAL_MODULE_NAME:
						id_Views.selectedIndex = 2;
						id_SurgicalTab.id_View.id_DetailsView.id_ICDCode.setFocus();
						break;
					case QIConstants.FAMILY_OTHER_MODULE_NAME:
						id_Views.selectedIndex = 3;
						id_OtherTab.id_View.id_DetailsView.id_ICDCode.setFocus();
						break;
					
				}
				
				callLater( QIUtilityFunctions.EnableSelection, [ id_TabButtons, QIUtilityFunctions.getButtonByLabel( id_TabButtons, tabtitle ) ] );
				
				/* var selSec:NotesBox = ( id_Views.selectedChild as NavigatorContent ).getElementAt( 0 ) as NotesBox;
				callLater( selSec.id_TextArea.setFocus ); */
			}
			
			
			protected function id_tab4_creationCompleteHandler(event:FlexEvent):void
			{
				id_tab1.id_MainButton.height = 32;
				id_tab2.id_MainButton.height = 32;
				id_tab3.id_MainButton.height = 32;
				id_tab4.id_MainButton.height = 32;
			}
			
			
			protected function OnTabCreationComplete(event:FlexEvent):void
			{
				var notesBox:NotesBox = NotesBox(event.currentTarget.id_NotesView);
				
				notesBox.id_BoxHeader.id_CloseBtn.addEventListener(MouseEvent.CLICK, OnNotesCloseClick);
				notesBox.id_TextArea.addEventListener(TextOperationEvent.CHANGE, OnNotesChangeHandler);
				notesBox.id_TextArea.addEventListener( "textChanged", function(event:Event):void
				{
					if( notesBox.id_TextArea.text.length > 0 )
					{
						OnNotesChangeHandler( event );
						UpdateChange();
					}
				});
				
				notesBox.id_BoxHeader.id_VoiceBtn.addEventListener(MouseEvent.CLICK, voiceBtnClickHandler, false, 0, true); 
			}
			
			protected function selectablepanel1_creationCompleteHandler(event:FlexEvent):void
			{
				id_tab1.id_N.toolTip 	= QIConstants.STRING_NONE_UI;
				id_tab1.id_N.value		= QIConstants.STRING_NONE_UI;
				
				id_tab2.id_N.toolTip 	= QIConstants.STRING_NONE_UI;
				id_tab2.id_N.value 		= QIConstants.STRING_NONE_UI;
				
				id_tab3.id_N.toolTip 	= QIConstants.STRING_NONE_UI;
				id_tab3.id_N.value 		= QIConstants.STRING_NONE_UI;
				
				id_tab4.id_N.toolTip 	= QIConstants.STRING_NONE_UI;
				id_tab4.id_N.value 		= QIConstants.STRING_NONE_UI;
				
				id_MedicalTab.id_NotesView.id_ClearBtn.addEventListener( FocusEvent.FOCUS_OUT, function( event:FocusEvent ):void
				{
					if( Keyboard.TAB )
					{
						id_tab2.id_MainButton.setFocus();
					}
				});
				
				id_ChildhoodTab.id_NotesView.id_ClearBtn.addEventListener( FocusEvent.FOCUS_OUT, function( event:FocusEvent ):void
				{
					if( Keyboard.TAB )
					{
						id_tab3.id_MainButton.setFocus();
					}
				});
				
				id_SurgicalTab.id_NotesView.id_ClearBtn.addEventListener( FocusEvent.FOCUS_OUT, function( event:FocusEvent ):void
				{
					if( Keyboard.TAB )
					{
						id_tab4.id_MainButton.setFocus();
					}
				});
				
				addEventListener("data_added", function(event:Event):void
				{
					var elm:GeneralSectionTabImpl = (id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as GeneralSectionTabImpl;
					changeTabYesNoSkin( elm.id );
				});
				
				addEventListener('clearGenralNotesEvent', function(event:Event):void
				{
					id_tab1.id_Y.setStyle("skinClass", YRadioButton);
					
					id_tab2.id_Y.setStyle("skinClass", YRadioButton);
					
					id_tab3.id_Y.setStyle("skinClass", YRadioButton);
					
					id_tab4.id_Y.setStyle("skinClass", YRadioButton);
					
				});
				
			}
			
		]]>
