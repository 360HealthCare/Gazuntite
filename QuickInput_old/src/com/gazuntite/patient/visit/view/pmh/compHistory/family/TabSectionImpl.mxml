			protected function YesNoLabel_creationCompleteHandler(event:FlexEvent):void
			{
				id_View.id_DetailsView.id_header.id_SpinerList.DataProvider = id_MenuList;
				id_View.id_DetailsView.id_header.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, OnHeaderClick );
				id_View.id_DetailsView.id_header.id_SpinerList.id_minBtn.toolTip = "Switch to Notes";
				id_View.id_DetailsView.id_header.id_SpinerList.id_MaxBtn.toolTip = "Switch to Notes";
//				id_View.id_DetailsView.id_header.id_SpinerList.currIndex = 0;
//				id_View.id_DetailsView.id_header.id_SpinerList.id_DDList.selectedIndex = 0;
				
				id_NotesView.id_BoxHeader.id_CloseBtn.addEventListener(MouseEvent.CLICK, OnNotesCloseClick);
				id_NotesView.id_BoxHeader.visible 			= false;
				id_NotesView.id_BoxHeader.includeInLayout 	= false;
				id_NotesView.id_notesBorder.height = 100;
				
				id_NotesHeader.id_SpinerList.DataProvider = id_MenuList;
				id_NotesHeader.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, OnHeaderClick );
//				id_NotesHeader.id_SpinerList.currIndex = 1;
//				id_NotesHeader.id_SpinerList.id_DDList.selectedIndex = 1;
				id_NotesHeader.id_SpinerList.id_minBtn.toolTip = "Switch to Form";
				id_NotesHeader.id_SpinerList.id_MaxBtn.toolTip = "Switch to Form";
				
				id_GridHeader.id_SpinerList.DataProvider = id_MenuList;
				id_GridHeader.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, OnHeaderClick );
//				id_GridHeader.id_SpinerList.currIndex = 2;
//				id_GridHeader.id_SpinerList.id_DDList.selectedIndex = 2;
				id_GridHeader.id_SpinerList.id_minBtn.toolTip = "Switch to Notes";
				id_GridHeader.id_SpinerList.id_MaxBtn.toolTip = "Switch to Form";
				
				id_View.id_Views.addEventListener(IndexChangedEvent.CHANGE, function(e:IndexChangedEvent):void
				{
					if(id_View.id_Views.selectedIndex == 1)
					{
						id_ButtonContainer.visible 	= true;
						id_add.visible				= true;
					}
					else if(id_View.id_Views.selectedIndex == 0)
					{
						id_ButtonContainer.visible 	= false;
						id_add.visible				= false;
					}
				});
			}
			
			private function OnNotesCloseClick(event:MouseEvent):void
			{
				this.ShowNotes = false;
				id_Views.selectedIndex = 0;
				id_View.id_DetailsView.id_header.id_SpinerList.currIndex = 0;
				event.stopImmediatePropagation();
			}
			
			private function OnHeaderClick(event:IndexChangeEvent):void
			{
				if( event.newIndex == 1 )
				{
					OnNotesClick ( null );
				}
				else 
				{
					selectByIndex(event.newIndex);
				}
				
				event.stopImmediatePropagation();
			}
			
			private function selectByIndex(index:int):void
			{
				id_Views.selectedIndex 							 			= index;
				id_GridHeader.id_SpinerList.currIndex  		 				= index;
				id_NotesHeader.id_SpinerList.currIndex  		 			= index;
				id_View.id_DetailsView.id_header.id_SpinerList.currIndex 	= index;
			}
			// add record click handler
			protected function id_add_clickHandler(event:MouseEvent):void
			{
				model.selectedFamilyHistoryRecord = new FamilyHistroyDTO();
				
				 var selectedIcdCodeDTO:FamilyHistroyDTO;
				if( id_View.id_DetailsView.isGetEdited() )
				{
					selectedIcdCodeDTO = id_View.id_DetailsView.selectedIcdCodeDTO;
					id_View.id_DetailsView.resetFields();
				}
				
				if( null == selectedIcdCodeDTO )
					selectedIcdCodeDTO = new FamilyHistroyDTO();
									
				selectedIcdCodeDTO.FamilyHistoryNote 		= id_NotesView.id_TextArea.text;
				selectedIcdCodeDTO.CreatedAt 				= model.VisitDate;
				selectedIcdCodeDTO.CreatedBy 				= model.LoggedInUserId;
				selectedIcdCodeDTO.PatientID 				= model.patientID;
				selectedIcdCodeDTO.VisitDate 				= model.VisitDate;
				selectedIcdCodeDTO.VisitID   				= model.VisitID;
				selectedIcdCodeDTO.IsDirty   				= true;
				selectedIcdCodeDTO.IsYesSelected 			= Constants.STRING_TRUE;
				selectedIcdCodeDTO.IsNA 					= false;
				selectedIcdCodeDTO.FamilyHistoryType.ID 	= FamilyHistoryDto.id;
				selectedIcdCodeDTO.FamilyHistoryType.Name 	= QIUtilityFunctions.getModuleFamilyNamebyID( FamilyHistoryDto.id);
				selectedIcdCodeDTO.DiseaseType.Name 		= selectedIcdCodeDTO.IcdCodeDescription;

				id_NotesView.id_TextArea.text = "";//clear notes
				
				if( null == FamilyHistoryDto.PatientDiseaseList)
					this.FamilyHistoryDto.PatientDiseaseList = new ArrayCollection();
				
				selectedIcdCodeDTO.DictationID = FamilyHistoryDto.DictationID;// copy dictation to this record.
				model.selectedFamilyHistoryRecord = selectedIcdCodeDTO;
				id_add.enabled = false; 
				
				//update skins for icons....
				dispatchEvent(new Event("clearNotesEvent",true, true ));
				
				//update controls
				dispatchEvent( new Event("data_added", true, true) );
				dispatchEvent( new Event("saveFamilyHistoryEvent", true, true) );
				
				selectByIndex(0); //show form;
			}
			
			protected function id_Views_changeHandler(event:IndexChangedEvent):void
			{
				if( event.newIndex == 0 || event.newIndex == 1 )
				{
					//id_add.visible = true;
					
					id_ButtonContainer.visible = true;
					if(id_View.id_Views.selectedIndex == 0)
					{
						id_ButtonContainer.visible = false;
					}
					
					id_add.enabled = true;
					//event.newIndex == 1? id_ButtonContainer.paddingRight = 45: id_ButtonContainer.paddingRight = 10;
				}
				else
				{
					//id_add.visible = false;
					id_add.enabled = false;
					id_ButtonContainer.visible = false;
				}
				
				if( id_View.id_DetailsView )
				{
					id_add.enabled = id_View.id_DetailsView.isGetEdited();
					id_add.visible = true;
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:ArrayList id="id_MenuList">
			<fx:String>Form</fx:String>
			<fx:String>Notes</fx:String>
			<!--<fx:String>Grid</fx:String>-->
		</s:ArrayList>
	</fx:Declarations>
	
	<fx:Binding source="id_View.id_DetailsView.id_header.id_SpinerList.currIndex" destination="id_NotesHeader.id_SpinerList.currIndex" twoWay="true" />
	<fx:Binding source="id_GridHeader.id_SpinerList.currIndex" destination="id_NotesHeader.id_SpinerList.currIndex" twoWay="true" />
	
	<s:VGroup width="100%" gap="-20">
		
		<mx:ViewStack id="id_Views" width="100%" height="115" resizeToContent="true" change="id_Views_changeHandler(event)"  
					  creationPolicy="all" selectedIndex="{ShowNotes ? 1:0}" >
			<s:NavigatorContent width="100%" >
				<renderer:YesNoLabel id="id_View" width="100%" height="100%" creationComplete="YesNoLabel_creationCompleteHandler(event)" />
			</s:NavigatorContent>
			<s:NavigatorContent width="100%" > <!-- 2 Notes View -->
				<s:layout>
					<s:VerticalLayout gap="0" />
				</s:layout>
				
				<family:DetailViewHeader id="id_NotesHeader" width="100%" />
				<notes:NotesBox id="id_NotesView" width="100%" height="86"  />
				
			</s:NavigatorContent>
			<s:NavigatorContent width="100%" > <!-- 3 Grid View -->
				<s:layout>
					<s:VerticalLayout />
				</s:layout>
				
				<family:DetailViewHeader id="id_GridHeader" width="100%" />
				<family:FamilyGridView id="id_GridView" width="100%" height="90" miniView="{miniView}"  />
				
			</s:NavigatorContent>
		</mx:ViewStack>
		<s:HGroup id="id_ButtonContainer" width="100%" horizontalAlign="left" paddingLeft="4" paddingRight="4" paddingTop="5" visible="false" gap="1"> 			
			<s:Button id="id_add" label="Add" enabled="false" tabIndex="5" click="id_add_clickHandler(event)" toolTip="Add Record" buttonMode="true" 
					  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreRecordBtn" visible="true"/>
			<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.tooltipBGSmall" visible="{id_add.visible &amp;&amp; !id_add.enabled}"  />
		</s:HGroup>
		
	</s:VGroup>	
</s:Group>
