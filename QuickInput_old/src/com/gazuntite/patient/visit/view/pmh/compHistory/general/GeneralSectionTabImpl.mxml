									   creationComplete="YesNoLabel_creationCompleteHandler(event)" />
			</s:NavigatorContent>
			<s:NavigatorContent width="100%" > <!-- 2 Notes View -->
				<s:VGroup width="100%" gap="0">
					<family:DetailViewHeader id="id_NotesHeader" width="100%" />
					<notes:NotesBox id="id_NotesView" width="100%" height="89"  />
				</s:VGroup>
			</s:NavigatorContent>
			<s:NavigatorContent width="100%" > <!-- 3 Grid View -->
				<s:layout>
					<s:VerticalLayout />
				</s:layout>
				<family:DetailViewHeader id="id_GridHeader" width="100%" />
				<general:GeneralGridView id="id_GridView" width="100%" height="90" miniView="{miniView}" />
			</s:NavigatorContent>
		</mx:ViewStack>
		<s:HGroup id="id_ButtonContainer" width="100%" horizontalAlign="left" paddingLeft="4" paddingRight="4" paddingTop="4" visible="false" gap="1">			
			<s:ToggleButton id="id_add" label="Add" enabled="false" tabIndex="5" click="id_add_clickHandler(event)" toolTip="Add Record" buttonMode="true"  
							skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreRecordBtn" visible="true"/>
			<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.tooltipBGSmall" visible="{id_add.visible &amp;&amp; !id_add.enabled}"  />
		</s:HGroup>
