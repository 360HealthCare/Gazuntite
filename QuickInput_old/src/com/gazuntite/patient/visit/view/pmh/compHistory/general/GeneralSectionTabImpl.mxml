			private function OnHeaderClick(event:IndexChangeEvent):void
			{
				if( event.newIndex == 1 )
				{
					OnNotesClick ( null );
				}
				else 
				{
					selectByIndex( event.newIndex );
				}
				
				event.stopImmediatePropagation();
			}
			
			private function selectByIndex(index:int):void
			{
				id_Views.selectedIndex 							 			= index;
