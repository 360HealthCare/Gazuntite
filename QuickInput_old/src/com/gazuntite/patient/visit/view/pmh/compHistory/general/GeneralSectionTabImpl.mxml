						id_add.enabled = true;
						//id_add.visible = true;
					}
				});
				
				id_View.id_DetailsView.id_Description.textInput.addEventListener(TextOperationEvent.CHANGE, function(event:TextOperationEvent):void
				{
					if( id_View.id_DetailsView.id_Description.textInput.text.length > 3 )
					{
