				id_GridHeader.id_SpinerList.DataProvider = id_MenuList;
				id_GridHeader.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, OnHeaderClick );
				//				id_GridHeader.id_SpinerList.currIndex = 2;
				//				id_GridHeader.id_SpinerList.id_DDList.selectedIndex = 2;
				id_GridHeader.id_SpinerList.id_minBtn.toolTip = "Switch to Notes";
				id_GridHeader.id_SpinerList.id_MaxBtn.toolTip = "Switch to Form";
				//				
				id_View.id_Views.addEventListener(IndexChangedEvent.CHANGE, function(e:IndexChangedEvent):void
				{
					if(id_View.id_Views.selectedIndex == 1)
					{
						id_ButtonContainer.visible 	= true;
						id_add.visible				= true;
					}
					else if(id_View.id_Views.selectedIndex == 0)
					{
						id_ButtonContainer.visible 	= false;
						id_add.visible				= false;
					}
					
				});
				
			}
			
			private function OnNotesCloseClick(event:MouseEvent):void
			{
				this.ShowNotes = false;
				id_Views.selectedIndex = 0;
				id_View.id_DetailsView.id_header.id_SpinerList.currIndex = 0;
				event.stopImmediatePropagation();
			}
			// add record of general
			protected function id_add_clickHandler(event:MouseEvent):void
			{
				medicalHistoryDto.ICDDTO = id_View.id_DetailsView.id_ICDCode.selectedItem as ICDCodeDTO;
				if(medicalHistoryDto.ICDDTO == null)
				{
					medicalHistoryDto.ICDDTO = new ICDCodeDTO();
					medicalHistoryDto.ICDDTO.IcdCodeDescription = id_View.id_DetailsView.id_Description.textInput.text;
				}
				
				if(id_View.id_DetailsView.id_Onset.selectedDate)
				{
					medicalHistoryDto.OnSet  = UtilityFunctions.FormatDate(id_View.id_DetailsView.id_Onset.selectedDate, "MM-DD-YYYY");
				}
				medicalHistoryDto.Note   = id_NotesView.id_TextArea.text;
				
				
				medicalHistoryDto.PatientID 	= model.patientID;
				medicalHistoryDto.IsNA 			= false;
				medicalHistoryDto.IsNone 		= false;
				medicalHistoryDto.IsDirty 		= true;
				medicalHistoryDto.VisitDate 	= model.VisitDate;
				
				if(id_View.id_DetailsView.id_ActiveYes)
					medicalHistoryDto.isActive = true;
				else if(id_View.id_DetailsView.id_ActiveNo)
					medicalHistoryDto.isActive = false;
				
				id_add.enabled = false; 
				
				if(null != model.GeneralMedicalHistoryList)
					model.GeneralMedicalHistoryList.removeAll();
				else
					model.GeneralMedicalHistoryList = new ArrayCollection();
				
				model.GeneralMedicalHistoryList.addItem(medicalHistoryDto);
				//update skins for icons....
				dispatchEvent(new Event("clearNotesEvent",true, true ));
				
				//update controls
				dispatchEvent( new Event("data_added", true, true) );
				dispatchEvent( new Event("saveGeneralHistoryEvent", true, true) );
				
				selectByIndex(0); //show form;
			}
			
			
			
			protected function id_Views_changeHandler(event:IndexChangedEvent):void
			{
				if( event.newIndex == 0 || event.newIndex == 1 )
				{
					//id_add.visible = true;
					
					id_ButtonContainer.visible = true;
					if(id_View.id_Views.selectedIndex == 0) // yesno
					{
						id_ButtonContainer.visible = false;
					}
					else // details view
					{
						id_ButtonContainer.visible = true;
						id_add.visible = true;
					}
					
					
					id_add.enabled = true;
					//	event.newIndex == 1? id_ButtonContainer.paddingRight = 45: id_ButtonContainer.paddingRight = 10;
				}
				else
				{
					//id_add.visible = false;
					id_add.enabled = false;
					id_ButtonContainer.visible = false;
				}
				
				if( id_View.id_DetailsView )
				{
					id_add.visible = true;
					id_add.enabled = id_View.id_DetailsView.isGetEdited();
				} 
				
				if(id_NotesView.id_TextArea.text.length>0)
					id_add.enabled = true;
			}
			
			
