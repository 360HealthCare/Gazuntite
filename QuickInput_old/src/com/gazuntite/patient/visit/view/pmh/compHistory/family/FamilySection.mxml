			private function isPreviousYesValue():Boolean
			{
				var hasYes:Boolean = false;

				for( var i:int = 0; i < model.PreviousFamilyHistoryList.length; i++ )
				{
					var dto:FamilyHistroyDTO = model.PreviousFamilyHistoryList.getItemAt( i ) as FamilyHistroyDTO
					hasYes = dto.IsYesSelected != QIConstants.STRING_FALSE;
					if( hasYes )
						break;
				} 
				return hasYes;
			}
			// ---Tahir Alvi-------- on Yes No Click option button -------------------
			private function OnYesNoClick(value:String, secLabel:String, target:OptionButton):void
			{
				setSelectedTab( secLabel );
				var sectionTypeID:int = findSectionTypeID(secLabel);
				hasChange = true;
				
				var elm:TabSectionImpl = (id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as TabSectionImpl;
				
				if( null == elm.FamilyHistoryDto )
					BindTabData( id_Views.selectedChild.label );
				
				if( isPreviousYesValue() && value == QIConstants.STRING_NO_UI )
				{
					var strAlertMessage:String = "Do you want to delete"+" "+ secLabel +" "+" history?";
					Alert.show(strAlertMessage,"Clear Data", Alert.YES|Alert.NO, 
						FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
						{
							if( event.detail == Alert.YES)
							{
								model.selectedFamilyHistoryRecord 							= new FamilyHistroyDTO();
								
								model.selectedFamilyHistoryRecord.FamilyHistoryNote 		= "";
								model.selectedFamilyHistoryRecord.CreatedAt 				= model.VisitDate;
								model.selectedFamilyHistoryRecord.CreatedBy 				= model.LoggedInUserId;
								model.selectedFamilyHistoryRecord.PatientID 				= model.patientID;
								model.selectedFamilyHistoryRecord.VisitDate 				= model.VisitDate;
								model.selectedFamilyHistoryRecord.VisitID   				= model.VisitID;
								model.selectedFamilyHistoryRecord.IsDirty   				= true;
								model.selectedFamilyHistoryRecord.IsYesSelected 			= Constants.STRING_FALSE;
								model.selectedFamilyHistoryRecord.IsNA 						= true;
								model.selectedFamilyHistoryRecord.FamilyHistoryType.ID 		= elm.FamilyHistoryDto.id;
								model.selectedFamilyHistoryRecord.FamilyHistoryType.Name 	= QIUtilityFunctions.getModuleFamilyNamebyID( elm.FamilyHistoryDto.id);
								model.selectedFamilyHistoryRecord.DiseaseType.Name 			= '';
								
								elm.id_NotesView.id_TextArea.text 		 = "";
							//	elm.FamilyHistoryDto.PatientDiseaseList.removeAll();
								
								var family_section:int = 2;
								
								var delEve:DeleteComprehensiveModuleDatabyPatientIDEvent = new DeleteComprehensiveModuleDatabyPatientIDEvent(model.patientID, family_section, sectionTypeID, model.ClinicBranchIdSeq, clearFamilyHistory); 
								CairngormEventDispatcher.getInstance().dispatchEvent( delEve );
								
								setYesNoValue(value);
							}
							else if( event.detail == Alert.NO)
							{
								setYesNoValue(QIConstants.STRING_YES_UI);
								target.id_Y.selected = true;
								target.id_N.selected = false;
							}
							
						});
				}
				else
				{
					setYesNoValue(value);
				}
				//elm.FamilyHistoryDto.IsYesSelected = (value == QIConstants.STRING_YES_UI)? QIConstants.STRING_TRUE:QIConstants.STRING_FALSE;
				
				//setYesNoValue(value); //remove it when itegration done...
				dispatchEvent( new Event("data_added", true, true) );
			}
			// Tahir Alvi -- response of delete records from family history
			private function clearFamilyHistory(val:*=null):void
			{
