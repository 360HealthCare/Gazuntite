			private function setYesNoValue(value:String):void
			{
				var elm:TabSectionImpl = ( id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as TabSectionImpl;
				
				elm.id_View.Label = "You have selected \n" + value;
				elm.id_View.IsSelected = (value == QIConstants.STRING_YES_UI) ? true:false;
				
				//elm.FamilyHistoryDto.IsYesSelected = (value == QIConstants.STRING_YES_UI)? QIConstants.STRING_TRUE:QIConstants.STRING_FALSE;
				
				if( value == QIConstants.STRING_NO_UI )
				{
					elm.id_Views.selectedIndex = 0;
				}
				else
				{
					elm.id_View.id_DetailsView.id_Relation.setFocus();
				} 
			}
			
			private function OnTabClick(event:MouseEvent, secLabel:String):void
			{
				setSelectedTab( secLabel );
			}
			
			private function findSectionTypeID(label:String):int
			{
				var val:int = 0;
				
				switch(label)
				{
					case QIConstants.FAMILY_HEARTDISEASE_MODULE_NAME:
						val = 2;
						break;
					case QIConstants.FAMILY_HYPERTENSION_MODULE_NAME:
						val = 3;
						break;
					case QIConstants.FAMILY_DIABETES_MODULE_NAME:
						val = 4;
						break;
					case QIConstants.FAMILY_CANCER_MODULE_NAME:
						val = 5;
						break;
					case QIConstants.FAMILY_OTHER_MODULE_NAME:
						val = 6;
						break;
				}
				return val;
			}
			//find the sub section id of Family section
			private function setSelectedTab(tabName:String):void
			{
				switch(  UtilityFunctions.TitleCase( tabName ) )
				{
					case QIConstants.FAMILY_HEARTDISEASE_MODULE_NAME:
						id_Views.selectedIndex = 0;
						break;
					case QIConstants.FAMILY_HYPERTENSION_MODULE_NAME:
						id_Views.selectedIndex = 1;
						break;
					case QIConstants.FAMILY_DIABETES_MODULE_NAME:
						id_Views.selectedIndex = 2;
						break;
					case QIConstants.FAMILY_CANCER_MODULE_NAME:
						id_Views.selectedIndex = 3;
						break;
					case QIConstants.FAMILY_OTHER_MODULE_NAME:
						id_Views.selectedIndex = 4;
						break;
					
				}
				
				callLater( QIUtilityFunctions.EnableSelection, [ id_TabButtons, QIUtilityFunctions.getButtonByLabel( id_TabButtons, tabName ) ]);
			}
			
			public override function set AllowContents(value:Boolean):void
			{
				super.AllowContents 		= value;
				
				if( !value )
					DeselectAllButtons();
				
				if( id_Views )
				{
					id_Views.visible 			= value;
					id_Views.includeInLayout	= value;
					
					if( value )
					{
						setSelectedTab( id_Views.selectedChild.label );
						BindTabData( id_Views.selectedChild.label );
					} 
					
					/* if( ! model.isNewVisitCreated && value  ) //load data if not new visit
					{
					LoadData();
					BindTabData( QIConstants.FAMILY_HEARTDISEASE_MODULE_NAME );
					} */
				}
			}
			
