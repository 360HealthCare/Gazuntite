			private function BindTabData(tabName:String):void
			{
				switch( UtilityFunctions.TitleCase( tabName ) )
				{
					case QIConstants.FAMILY_HEARTDISEASE_MODULE_NAME:
						id_HeartDisease.FamilyHistoryDto = QIUtilityFunctions.getFamilyHistoryDTO(  QIConstants.FAMILY_HEART_DISEASE_MODULE_NAME );
						id_HeartDisease.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.heartDiseaseDiseaseTypesDTOList ;
						break;
					case QIConstants.FAMILY_HYPERTENSION_MODULE_NAME:
						id_Hypertension.FamilyHistoryDto = QIUtilityFunctions.getFamilyHistoryDTO(  QIConstants.FAMILY_HYPERTENSION_MODULE_NAME );
						id_Hypertension.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.hypertensionDiseaseTypesDTOList ;
						break;
					case QIConstants.FAMILY_DIABETES_MODULE_NAME:
						id_Diabetes.FamilyHistoryDto = QIUtilityFunctions.getFamilyHistoryDTO(  QIConstants.FAMILY_DIABETES_MODULE_NAME );
						id_Diabetes.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.diabetesDiseaseTypesDTOList ;
						break;
					case QIConstants.FAMILY_CANCER_MODULE_NAME:
						id_Cancer.FamilyHistoryDto = QIUtilityFunctions.getFamilyHistoryDTO(  QIConstants.FAMILY_CANCER_MODULE_NAME );
						id_Cancer.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.cancerDiseaseTypesDTOList ;
						break;
					case QIConstants.FAMILY_OTHER_MODULE_NAME:
						id_Other.FamilyHistoryDto = QIUtilityFunctions.getFamilyHistoryDTO(  QIConstants.FAMILY_OTHER_MODULE_NAME );
						id_Other.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.otherDiseaseTypesDTOList ;
						break;
				} 
			}
			
