<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" xmlns:general="com.gazuntite.patient.visit.view.pmh.compHistory.general.*" xmlns:family="com.gazuntite.patient.visit.view.pmh.compHistory.family.*" xmlns:social="com.gazuntite.patient.visit.view.pmh.compHistory.social.*" xmlns:Grids="com.gazuntite.patient.visit.view.pmh.compHistory.Grids.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout horizontalAlign="left" verticalAlign="top" gap="1" paddingLeft="0" paddingRight="0" paddingBottom="0" />
	</s:layout>
	
	<s:VGroup width="100%" gap="-4" paddingTop="5">									
		<s:TabBar id="id_TabBar2" dataProvider="{id_tabs}" buttonMode="true" 				  
				  skinClass="com.adobe.gazuntite.skins.chrome.tabBarSkins.QIrecordingsTabBar"/>
		<s:SkinnableContainer id="id_VS" width="100%" skinClass="com.gazuntite.patient.visit.view.commons.QISectionBGSkin">			
			<s:layout>
				<s:VerticalLayout paddingBottom="3" paddingLeft="3" paddingRight="3" paddingTop="3" />
			</s:layout>
			
			<mx:ViewStack id="id_tabs" width="100%" minWidth="500" resizeToContent="true">
				<s:NavigatorContent width="100%" label="General History" >
					<Grids:QIGeneralGridView width="100%" id="id_gen" />
				</s:NavigatorContent>
				
				<s:NavigatorContent width="100%" label="Family History" >											
					<Grids:QIFamilyGridView width="100%" id="id_fam" />
				</s:NavigatorContent>
				<s:NavigatorContent width="100%" label="Social History" >											
					<Grids:QISocialGridView width="100%" id="id_sol" />
				</s:NavigatorContent>
				
			</mx:ViewStack>
			
		</s:SkinnableContainer>
	</s:VGroup>
</s:Group>
