			private function OnNotesCloseClick(event:MouseEvent):void
			{
				//this.ShowNotes = false;
				id_Views.selectedIndex = 0;
				id_DetailsView.id_header.id_SpinerList.currIndex = 0;
				event.stopImmediatePropagation();
			}
			
			private function OnHeaderClick(event:IndexChangeEvent):void
			{
				
				id_Views.selectedIndex = event.newIndex == 1 ? 2:1;
				id_header.id_SpinerList.currIndex  				 	= event.newIndex;
				id_DetailsView.id_header.id_SpinerList.currIndex 	= event.newIndex;
				event.stopImmediatePropagation();
			}

