	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Binding source="id_DetailsView.id_header.id_SpinerList.currIndex" destination="id_header.id_SpinerList.currIndex" twoWay="true" />
	
	<s:layout>
		<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" />
	</s:layout>
	<mx:ViewStack id="id_Views" width="100%" height="120" resizeToContent="true" creationPolicy="all" selectedIndex="{IsSelected ? 1:0}">
		<s:NavigatorContent width="100%">
			<s:SkinnableContainer width="100%" height="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.QIInnerYesNoBG"
								  creationComplete="YesNoLabel_creationCompleteHandler(event)"
								  >
				<s:layout>
					<s:VerticalLayout horizontalAlign="center" verticalAlign="middle" />
				</s:layout>
					
				<s:RichText id="id_label1" text="{Label}" color="#000000" fontFamily="Calibri Bold" fontSize="13"/>
				
				<s:RichText id="id_label" text="{Label2}" color="#0000a0"  fontFamily="Calibri Bold" fontSize="14"/>
				
			</s:SkinnableContainer>
		</s:NavigatorContent>
		
		<s:NavigatorContent width="100%">
			<social:socialDetails id="id_DetailsView" width="100%" height="120" />
		</s:NavigatorContent>
		
		<s:NavigatorContent width="100%" height="120" creationComplete="id_NotesView_creationCompleteHandler(event)">
			<!--<notes:NotesBox id="id_NotesView" width="100%" creationComplete="id_NotesView_creationCompleteHandler(event)"/>-->
			<s:VGroup width="100%" gap="-1">
				<family:DetailViewHeader id="id_header" width="100%" />
				<notes:NotesBox id="id_NotesView" width="100%" creationComplete="id_NotesView_creationCompleteHandler(event)" />
			</s:VGroup>
		</s:NavigatorContent>
	</mx:ViewStack>
	
	
</s:Group>
