<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:social="com.gazuntite.patient.visit.view.pmh.compHistory.social.*" 
		 xmlns:family="com.gazuntite.patient.visit.view.pmh.compHistory.family.*" 
		 xmlns:notes="com.gazuntite.patient.visit.view.notes.*" 
		 creationComplete="group1_creationCompleteHandler(event)" 
		 >
	<fx:Script>
		<![CDATA[
			import com.adobe.gazuntite.skins.chrome.buttonSkins.QIInnerNotes;
			import com.gazuntite.patient.visit.dto.ch.SocialHistoryAddictionDTO;
			import com.gazuntite.patient.visit.dto.ch.SocialHistoryMediumTypeDTO;
			import com.gazuntite.patient.visit.dto.ch.SocialHistoryUsageAmountTypeDTO;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.Constants;
			import com.gazuntite.controls.extended.components.LabelComboBox;
			
			import mx.collections.ArrayList;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			
			[Bindable]
			private var model : QIModelLocator = QIModelLocator.getInstance();
			
			private var m_sLabel2:String = "";
			
			private var m_sLabel:String = "Press Yes or No";
			private var m_bIsSelected:Boolean 		= false;
			
			
			private var m_oSocialHistoryAddictionDto:SocialHistoryAddictionDTO = new SocialHistoryAddictionDTO();
			[Bindable]
			public function get Label2():String
			{
				return m_sLabel2;
			}

			public function set Label2(value:String):void
			{
				m_sLabel2 = value;
			}

			[Bindable]
			public function get SocialHistoryAddictionDto():SocialHistoryAddictionDTO
			{
				return m_oSocialHistoryAddictionDto;
			}

			public function set SocialHistoryAddictionDto(value:SocialHistoryAddictionDTO):void
			{
				m_oSocialHistoryAddictionDto = value;
				LoadForm();
				/* if( ! model.isNewVisitCreated && value )
				{
					
				}  */
			}

			[Bindable]
			public function get Label():String
			{
				return m_sLabel;
			}
			
			public function set Label(value:String):void
			{
				m_sLabel = value;
			}
			
			[Bindable]
			public function set IsSelected(value:Boolean):void
			{
				m_bIsSelected = value;
			}
			
			public function get IsSelected():Boolean
			{
				return m_bIsSelected;
			}
			
			private function LoadForm():void
			{
				if( SocialHistoryAddictionDto )
				{
					id_DetailsView.id_PastBtn.selected 			= SocialHistoryAddictionDto.IsPresentSelected == Constants.STRING_TRUE;
					id_DetailsView.id_PresentBtn.selected 		= SocialHistoryAddictionDto.IsPresentSelected == Constants.STRING_FALSE;
					
					id_DetailsView.id_Yes.selected				= SocialHistoryAddictionDto.IsEducated == Constants.STRING_TRUE;
					id_DetailsView.id_No.selected				= SocialHistoryAddictionDto.IsEducated == Constants.STRING_FALSE;
					
					id_DetailsView.id_OnsetDate.text 	= SocialHistoryAddictionDto.OnSet;
					if( SocialHistoryAddictionDto.EndDate && SocialHistoryAddictionDto.EndDate.length > 0 )
						id_DetailsView.id_EndDate.visible = true;
					id_DetailsView.id_EndDate.text 		= SocialHistoryAddictionDto.EndDate;
					
					id_DetailsView.selectType( SocialHistoryAddictionDto.SocialHistoryAddictionTypeID );
					id_DetailsView.selectUsageAmount( SocialHistoryAddictionDto.SocialHistoryAddictionTypeID );					
					
					if( SocialHistoryAddictionDto.AddictionNotes )
						id_NotesView.id_TextArea.text = SocialHistoryAddictionDto.AddictionNotes;
				} 
				
			}
			

			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				id_DetailsView.id_AmountCmbo.addEventListener(IndexChangeEvent.CHANGE, 			OnIndexChangeEvent);
				id_DetailsView.id_TypeCmbo.addEventListener(IndexChangeEvent.CHANGE, 			OnIndexChangeEvent);
				id_DetailsView.id_OnsetDate.addEventListener(CalendarLayoutChangeEvent.CHANGE, 	OnDateChange);
				id_DetailsView.id_EndDate.addEventListener(CalendarLayoutChangeEvent.CHANGE, 	OnDateChange);
				id_DetailsView.id_OnsetDate.addEventListener(FocusEvent.FOCUS_OUT, OnDateFocusOut);
				id_DetailsView.id_EndDate.addEventListener(FocusEvent.FOCUS_OUT, OnDateFocusOut);
				id_DetailsView.id_header.id_NotesBtn.addEventListener(MouseEvent.CLICK, 		OnNotesClick);
				
				id_DetailsView.id_PastBtn.addEventListener(MouseEvent.CLICK, OnPastPresentClick);
				id_DetailsView.id_PresentBtn.addEventListener(MouseEvent.CLICK, OnPastPresentClick);

				id_DetailsView.id_Yes.addEventListener(MouseEvent.CLICK, OnEducatedClick);
				id_DetailsView.id_No.addEventListener(MouseEvent.CLICK, OnEducatedClick);
				
				
				addEventListener('clearNotesEvent', function(event:Event):void
				{
					id_DetailsView.id_header.id_NotesBtn.setStyle("skinClass", QIInnerNotes);
					id_header.id_NotesBtn.setStyle("skinClass", QIInnerNotes);
					
				}); 
				
			}
			
			
			private function OnEducatedClick(event:MouseEvent):void
			{
				SocialHistoryAddictionDto.IsDirty = true;
				
				 if(event.currentTarget.id == "id_No" )
				{
					SocialHistoryAddictionDto.IsEducated	= "false";
					id_DetailsView.id_Yes.selected 			= false;
				}
				else
				{
					SocialHistoryAddictionDto.IsEducated	= "true";
					id_DetailsView.id_No.selected  			= false;
				} 
				
			}
			
			private function OnPastPresentClick(event:MouseEvent):void
			{
				SocialHistoryAddictionDto.IsDirty = true;
				
				 if(event.currentTarget.id == "id_PastBtn" )
				{
					SocialHistoryAddictionDto.IsPresentSelected	= "false";
					id_DetailsView.id_PresentBtn.selected 		= false;
					
					id_DetailsView.id_EndDate.visible			= true;
				}
				else
				{
					SocialHistoryAddictionDto.IsPresentSelected = "true";
					id_DetailsView.id_PastBtn.selected  		= false;
					
					id_DetailsView.id_EndDate.visible			= false;
				} 
				
			}
			
			private function OnNotesClick(event:MouseEvent):void
			{
			 	id_Views.selectedIndex 							 = 2; //select notes 
				id_header.id_SpinerList.currIndex  				 = 1;
				id_DetailsView.id_header.id_SpinerList.currIndex = 1; 
				
			}
			
			private function OnIndexChangeEvent(event:IndexChangeEvent):void
			{
				if (!event.currentTarget)
					return;
				
				var curTar:LabelComboBox;
				if (event.currentTarget is LabelComboBox)
					curTar = event.currentTarget as LabelComboBox;
				
				if (!curTar)
					return;
				
				if( curTar.id == "id_AmountCmbo" && curTar.selectedItem is SocialHistoryUsageAmountTypeDTO)
				{
					SocialHistoryAddictionDto.UsageAmountID = ( curTar.selectedItem as SocialHistoryUsageAmountTypeDTO).ID;
				}
				else if (curTar.id == "id_AmountCmbo")
				{
					SocialHistoryAddictionDto.UsageAmountID = -1;
					SocialHistoryAddictionDto.UsageAmount = curTar.textInput.text;
				}
				else if (curTar.id == "id_TypeCmbo" && curTar.selectedItem is SocialHistoryMediumTypeDTO)
				{
					SocialHistoryAddictionDto.MediumTypeID = (curTar.selectedItem as SocialHistoryMediumTypeDTO).ID;
				}
				else if (curTar.id == "id_TypeCmbo")
				{
					SocialHistoryAddictionDto.MediumTypeID = -1;
					SocialHistoryAddictionDto.MediumType = curTar.textInput.text;
				}
				
				/* if( event.currentTarget.id == "id_AmountCmbo" && event.currentTarget.selectedItem is SocialHistoryUsageAmountTypeDTO)
				{
					SocialHistoryAddictionDto.UsageAmountID = ( event.currentTarget.selectedItem as SocialHistoryUsageAmountTypeDTO).ID;
				}
				else if(event.currentTarget.id == "id_AmountCmbo")
				{
					SocialHistoryAddictionDto.UsageAmountID = -1;
					SocialHistoryAddictionDto.UsageAmount = event.currentTarget.
				}
				else if( event.currentTarget.id == "id_TypeCmbo" && event.currentTarget.selectedItem is SocialHistoryMediumTypeDTO)
				{
					SocialHistoryAddictionDto.MediumTypeID = ( event.currentTarget.selectedItem as SocialHistoryMediumTypeDTO).ID; 
					
				}
				else if(event.currentTarget.id == "id_TypeCmbo")
				{
					SocialHistoryAddictionDto.MediumTypeID = -1;
				} */
				
				 SocialHistoryAddictionDto.PatientID = model.patientID;
				 SocialHistoryAddictionDto.VisitID = model.VisitID;
				 
				SocialHistoryAddictionDto.IsDirty = true;
			}
			
			private function OnDateChange(event:CalendarLayoutChangeEvent):void
			{
				SocialHistoryAddictionDto.IsDirty = true;
				
				 if( event.currentTarget.id == "id_OnsetDate" /*&& event.currentTarget.selectedDate */)
				{
					SocialHistoryAddictionDto.OnSet = event.currentTarget.text;//selectedDate;
				}
				else if( event.currentTarget.id == "id_EndDate" /*&& event.currentTarget.selectedDate */)
				{
					SocialHistoryAddictionDto.EndDate = event.currentTarget.text;//selectedDate; 
				} 
			}
	
			private function OnDateFocusOut(event:FocusEvent):void
			{
				SocialHistoryAddictionDto.IsDirty = true;
				
				if( event.currentTarget.id == "id_OnsetDate")
				{
					SocialHistoryAddictionDto.OnSet = event.currentTarget.text;
				}
				else if( event.currentTarget.id == "id_EndDate")
				{
					SocialHistoryAddictionDto.EndDate = event.currentTarget.text; 
				} 
			}

			protected function id_NotesView_creationCompleteHandler(event:FlexEvent):void
			{
				/* if( SocialHistoryAddictionDto )
				{ */
				
					//id_NotesView.id_TextArea.addEventListener(TextOperationEvent.CHANGE, OnNotesChange);
					//id_NotesView.id_TextArea.addEventListener( "textChanged", OnNotesChange);
				/* } */
			}
			
			private function OnNotesChange(event:Event):void
			{
				/* if( SocialHistoryAddictionDto )
					SocialHistoryAddictionDto.AddictionNotes = id_NotesView.id_TextArea.text; */
			}


			protected function YesNoLabel_creationCompleteHandler(event:FlexEvent):void
			{
				id_DetailsView.id_header.id_SpinerList.DataProvider = new ArrayList( ["Form","Notes"] );
				id_DetailsView.id_header.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, OnHeaderClick );
				
				id_DetailsView.id_header.id_SpinerList.id_minBtn.toolTip = "Switch to Notes";
				id_DetailsView.id_header.id_SpinerList.id_MaxBtn.toolTip = "Switch to Notes";
				
				id_DetailsView.id_header.id_SpinerList.currIndex = 0;
				id_DetailsView.id_header.id_SpinerList.id_DDList.selectedIndex = 0;
				
				id_NotesView.id_BoxHeader.id_CloseBtn.addEventListener(MouseEvent.CLICK, OnNotesCloseClick);
				id_NotesView.id_BoxHeader.visible 			= false;
				id_NotesView.id_BoxHeader.includeInLayout 	= false;
				id_NotesView.id_notesBorder.height = 100;
				
				//for notes component only, to make single header view....
				id_header.id_SpinerList.DataProvider = new ArrayList( ["Form","Notes"] );
				id_header.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, OnHeaderClick );
				
				//id_header.id_SpinerList.currIndex = 1;
				id_header.id_SpinerList.id_minBtn.toolTip = "Switch to Form";
				id_header.id_SpinerList.id_MaxBtn.toolTip = "Switch to Form"; 
				
				/*
				id_DetailsView.id_header.id_VoiceBtn.addEventListener(MouseEvent.CLICK, voiceBtnClickHandler1, false, 0, true);
				id_header.id_VoiceBtn.addEventListener(MouseEvent.CLICK, voiceBtnClickHandler2, false, 0, true);*/
			}
			
			
