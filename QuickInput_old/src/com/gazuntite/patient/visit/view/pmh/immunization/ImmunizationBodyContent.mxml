				}
				
			}
			
			protected function Combo_keyUpHandler(event:KeyboardEvent):void
			{
				var searchString:String = event.currentTarget.textInput.text;
				
				if( searchString.length == 2 || searchString.length == 5 )  //only search if length is 2 or 5
				{
					var lisd:LoadImmunicationStaticDataEvent;
					
					switch(event.currentTarget)
					{
						case id_ImmunizationCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.TYPE_SELECT_TYPE);
							
							break;
						case id_DoseCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.DOSE_SELECT_TYPE);
							
							break;
						case id_ManufacturerCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.MANUFACTURER_SELECT_TYPE);
							
							break;
						case id_SeriesCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.SERIERS_SELECT_TYPE);
							
							break;
						case id_ReasonOfRefusalCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.REFUSAL_SELECT_TYPE);
							
							break;
						case id_BodySideRouteCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.ROUT_SELECT_TYPE);
							
							break;
						case id_SiteCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.SITE_SELECT_TYPE);
							
							break;
						case id_LotNoCmbo:
							
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.LOT_SELECT_TYPE);
							
							break;	
					}
					
					if( null != lisd )
						CairngormEventDispatcher.getInstance().dispatchEvent( lisd );
				}
			}
			
			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if (id_ImmunizationCmbo.selectedItem != null ||
					id_DoseCmbo.textInput.text.length ||  id_DoseCmbo.selectedItem != null ||
					id_LotNoCmbo.textInput.text.length || id_LotNoCmbo.selectedItem != null ||
					id_DateAdmin.text.length || id_DateAdmin.selectedItem != null ||
					id_NextDue.text.length || id_NextDue.selectedItem != null ||
					id_ManufacturerCmbo.textInput.text.length || id_ManufacturerCmbo.selectedItem != null ||
					id_BodySideRouteCmbo.textInput.text.length > 2 || id_BodySideRouteCmbo.selectedItem != null ||
					id_ExpiryDate.text.length || id_ExpiryDate.selectedDate != null ||
					id_ReasonOfRefusalCmbo.textInput.text.length || id_ReasonOfRefusalCmbo.selectedItem != null ||
					id_SiteCmbo.textInput.text.length > 2 || id_SiteCmbo.selectedItem != null ||
					id_SeriesCmbo.textInput.text.length > 2 || id_SeriesCmbo.selectedItem != null)
					
					edited = true;
				
				//hasViewChanged = (_hasGridChanged)? _hasGridChanged : edited;
				
				return edited;
			}
			
			
			
