			private function onPreviousVisitDateChange(event:Event):void
			{
				if (id_VisitDatesCombo.selectedItem)
				{
					id_ImnzationForm.enabled = true;
					
					dateToolTipContainer.visible = false;
					dateToolTipContainer.includeInLayout = false;
				}
				else
				{
					id_ImnzationForm.enabled = false;
					
					dateToolTipContainer.visible = true;
					dateToolTipContainer.includeInLayout = true;
				}
			}
			
			public function loadData():void
			{
