			public function saveRecordsConfirmed():void 
			{
				/* if (eventObj.detail == Alert.NO)
					return; */
				
				var immDTO:ImmunizationDTO = new ImmunizationDTO();
				immDTO.ImmunizationType = id_ImmunizationCmbo.selectedItem as GeneralTypeDTO;
				immDTO.Dose	= id_DoseCmbo.textInput.text;
				immDTO.LotNumber = id_LotNoCmbo.textInput.text;
				immDTO.Manufacturer	= id_ManufacturerCmbo.textInput.text;
				immDTO.Rout	= id_BodySideRouteCmbo.textInput.text;
				
				var reasonOfRefusal:String = ValidationUtils.TrimString(id_ReasonOfRefusalCmbo.textInput.text);
				
				if (reasonOfRefusal.length)
				{
					immDTO.RefusalReason = reasonOfRefusal;
				}
				
				immDTO.Site	= id_SiteCmbo.textInput.text;
				immDTO.Series = id_SeriesCmbo.textInput.text;
				
				immDTO.CreatedAt = new Date();
				immDTO.UpdatedAt = new Date();
				immDTO.PatientID = model.patientID;
				
				//Tahir Alvi - New Feature implemented
				switch(id_AssociateVisitzCombo.selectedIndex)
				{
					case 0:
						immDTO.IsNA = false;
						immDTO.VisitID = model.VisitID;
						immDTO.VisitDate = model.VisitDate;
						break;
					
					case 1:
						immDTO.IsNA = false;
						immDTO.VisitID = id_VisitDatesCombo.selectedItem.VisitID;
						
						var prevAssociatedVisitDate:Date;
						if (id_VisitDatesCombo.selectedItem)
						{
							prevAssociatedVisitDate = new Date(Date.parse(id_VisitDatesCombo.selectedItem.VisitDate));
						}
						
						immDTO.VisitDate = prevAssociatedVisitDate;
						break;
					
					case 2:
						immDTO.IsNA = true;
						immDTO.VisitID = 0;
						immDTO.VisitDate = QIConstants.NULL_DATE;
						break;
				}
				
				immDTO.CreatedBy = model.LoggedInUserId;
				immDTO.ManagedBy = model.LoggedInUserId;
				immDTO.DateAdmin = id_DateAdmin.text;
				immDTO.NextDoseDue = id_NextDue.text;
				immDTO.ExpiryDate = id_VISDate.text; 
				
				immDTO.ModifiedAt = Constants.NULL_DATE;
				immDTO.IsRecordEditable = true;
				
				if (id_Add.notesDTO)
				{
					immDTO.Note = id_Add.notesDTO.Note;
					immDTO.NoteSubject = id_Add.notesDTO.NoteSubject; 
				}
				// Mansoor
				
				if (id_Add.dictationDTO != null && id_Add.dictationDTO.DictationID != null)
				{
					immDTO.DictationID = id_Add.dictationDTO.DictationID;
					
					//id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
				}
				
				if(model.immunizationDTOList == null)
					model.immunizationDTOList = new ArrayCollection();
				
				//Tahir Alvi - Associated Visit
				if((id_AssociateVisitzCombo.selectedIndex == 2) || (id_AssociateVisitzCombo.selectedIndex == 1 && id_VisitDatesCombo.selectedIndex != -1))
				{
					immDTO.IsDirty = true;
					model.immunizationDTOList.addItemAt(immDTO, 0);
					
					Alert.show('Are you sure you want to save this record.', 'Save Confirmation', Alert.YES | Alert.NO, this, alertSaveListener, null, Alert.OK)	
				}
				
				else
				{
					immDTO.IsDirty = true;
					model.immunizationDTOList.addItemAt(immDTO, 0);
					
					 var mpiEvent:ManagePatientImmunizationEvent = new ManagePatientImmunizationEvent(model, onImmunizationSave);
					CairngormEventDispatcher.getInstance().dispatchEvent(mpiEvent); 
					
					isRecordAddInGrid = true;
				}
				
				hasViewChanged = _hasGridChanged = true;
				resetFields();
			}
			
			public function onImmunizationSave():void
			{
				var lpviEvent:LoadImmunizationByVisitIDEvent = new LoadImmunizationByVisitIDEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent( lpviEvent );
			}
			
			private function alertSaveListener(eventObj:CloseEvent):void 
			{
				if (eventObj.detail == Alert.YES) 
				{
					 var mpiEvent:ManagePatientImmunizationEvent = new ManagePatientImmunizationEvent(model, onImmunizationSave);
					CairngormEventDispatcher.getInstance().dispatchEvent( mpiEvent ); 
				}
				else
				{
					return;	
				}
			} 
			private function isNonRequiredFieldsLengthValid():Boolean
			{
				var result:Boolean = true;
				
				if( id_BodySideRouteCmbo.textInput.text.length > 0 && id_BodySideRouteCmbo.textInput.text.length > 200 )
				{
					result = false;
					id_BodySideRouteCmbo.setFocus();
					UtilityFunctions.ShowMessage("Max length for \"Body Side Route\" is 200 chars", "Invalid Input");
				}
				else if( id_SiteCmbo.textInput.text.length > 0 && id_SiteCmbo.textInput.text.length > 200 )
				{
					result = false;
					id_SiteCmbo.setFocus();
					UtilityFunctions.ShowMessage("Max length for Site is 200 chars", "Invalid Input");
				}
				else if( id_SeriesCmbo.textInput.text.length > 0 && id_SeriesCmbo.textInput.text.length > 200 )
				{
					result = false;
					id_SeriesCmbo.setFocus();
					UtilityFunctions.ShowMessage("Max length for Series is 200 chars", "Invalid Input");
				}
				
				return result;
			}
			
