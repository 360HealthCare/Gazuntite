			protected function id_add_clickHandler(event:MouseEvent):void
			{
				id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				id_Add.enableAll = isNonRequiredFieldsLengthValid();
				enable = isGetEdited();
				if( id_Add.enableAll )
				{
					saveRecords();
					
					id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
					id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
				}
				else
				{
					if(UtilityFunctions.IsNullOrEmpty(id_ImmunizationCmbo.selectedItem) )
					{
						id_ImmunizationCmbo.errorString = "invalid immunization";
						id_ImmunizationCmbo.setFocus();
					}
					else if(UtilityFunctions.IsNullOrEmpty(id_DoseCmbo.selectedItem) )
					{
						id_DoseCmbo.errorString = "invalid dose value";
						id_DoseCmbo.setFocus();
					}
				}
			}
			
			
