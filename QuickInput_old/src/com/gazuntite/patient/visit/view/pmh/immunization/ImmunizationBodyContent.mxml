	<fx:Declarations>
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="5" paddingRight="5" paddingLeft="5" />
	</s:layout>
	<s:HGroup id="id_NotesArea" width="100%" paddingTop="0" />
	
	<s:HGroup width="100%">
		<s:DropDownList id="id_AssociateVisitzCombo"  focusEnabled="true"
						prompt="Associate With" visible="false"   change="id_AssociateVisitzCombo_changeHandler()" dataProvider="{arrAssociateTypes}"
						width="{id_ImmunizationCmbo.width}" skinClass="com.adobe.gazuntite.skins.chrome.comboBoxSkins.requiredDropDownList" includeInLayout="false"/> 
		<s:DropDownList id="id_VisitDatesCombo" prompt="Select Visit Date" focusEnabled="true" visible="false" width="{id_DoseCmbo.width}" 
						labelField="VisitDateLbl" includeInLayout="{id_VisitDatesCombo.visible}" dataProvider="{model.unSignedVisitDates}"
						change="onPreviousVisitDateChange(event)"
						skinClass="com.adobe.gazuntite.skins.chrome.comboBoxSkins.requiredDropDownList"/>
		<s:SkinnableContainer id="dateToolTipContainer" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.dateToolTipBG" 
							  visible="false" includeInLayout="false"  > <!---->
			<s:Label id="id_DateLabel" text="Please Select Visit" fontFamily="Calibri" fontSize="12"
					 width="100%" paddingLeft="10" horizontalCenter="0"  verticalCenter="0"/>
		</s:SkinnableContainer>
	</s:HGroup>
	
	<s:HGroup id="id_ImnzationForm" width="100%" visible="false" includeInLayout="false" enabled="false"> 
		
		<s:VGroup width="33%">
			<components:LabelComboBox id="id_ImmunizationCmbo" prompt="Immunization" width="100%" maxChars="30"
									  dataProvider="{model.GeneralTypeDTOListForImmunizationType}"
									  keyUp="Combo_keyUpHandler(event)" 
									  change="comboChangeHandler(event)"
									  focusOut="areRequiredFieldsProvidedAndValid()"
									  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="1"/> <!--dataProvider="{model.immunizationTypeDTOList}"-->
			<components:LabelComboBox id="id_ManufacturerCmbo" prompt="Manufacturer" width="100%" maxChars="250"
									  dataProvider="{model.GeneralLabelDTOListForManufacturer}"
									  keyUp="Combo_keyUpHandler(event)" tabIndex="8" /><!-- dataProvider="{model.immunizationManufacturerList}" -->
			
			<s:HGroup width="100%" verticalAlign="middle">
				
				<s:CheckBox id="id_RefusalChk" fontFamily="Calibri" color="#ffffff" label="Refusal" tabIndex="12"
							skinClass="com.gazuntite.controls.skins.QICheckBoxSkin"  />
				<s:Label text="Refusal" fontFamily="Calibri" color="#ffffff" fontSize="11" />
				
				<components:LabelComboBox id="id_ReasonOfRefusalCmbo" prompt="Reason of Refusal" width="100%" maxChars="500"
										  dataProvider="{model.GeneralLabelDTOListForRefusal}"
										  keyUp="Combo_keyUpHandler(event)" change="comboChangeHandler(event)" tabIndex="13"/>
			</s:HGroup>
			
		</s:VGroup>
		
		<s:VGroup width="33%">
			<s:HGroup width="100%" >
				<components:LabelComboBox id="id_DoseCmbo" prompt="Dose" width="50%"  maxChars="50"
										  dataProvider="{model.GeneralLabelDTOListForDose}"
										  keyUp="Combo_keyUpHandler(event)" 
										  change="id_DoseCmbo_changeHandler(event)"
										  focusOut="areRequiredFieldsProvidedAndValid()"
										  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="2"/>
				<components:LabelComboBox id="id_LotNoCmbo" prompt="Lot#" width="50%"
										  dataProvider="{model.GeneralLabelDTOListForLot}"
										  keyUp="Combo_keyUpHandler(event)" tabIndex="3"  maxChars="50"/> 
			</s:HGroup>
			<components:LabelComboBox id="id_BodySideRouteCmbo" prompt="Body Side/Route" width="100%" maxChars="250"
									  dataProvider="{model.GeneralLabelDTOListForRoute}"
									  keyUp="Combo_keyUpHandler(event)"
									  tabIndex="9" />
			
			<components:LabelComboBox id="id_SiteCmbo" prompt="Site" width="100%" maxChars="250"
									  dataProvider="{model.GeneralLabelDTOListForSite}"
									  keyUp="Combo_keyUpHandler(event)" tabIndex="14"/>
			
		</s:VGroup>
		
		<s:VGroup width="34%">
			<s:HGroup width="100%" >
				
				<components:LabelDateField id="id_DateAdmin" prompt="Date Admin" toolTip="Admin Date" width="50%" 
										   yearNavigationEnabled="true" editable="true" maxYear="{new Date().getFullYear()}" minYear="1901"
										   selectableRange="{{rangeEnd : new Date()}}" fontFamily="calibri" fontSize="11" tabIndex="4"/>
				<components:LabelDateField id="id_NextDue" prompt="Next Due" toolTip="Next Due" width="50%" 
										   yearNavigationEnabled="true" editable="true" selectableRange="{{rangeStart:new Date()}}"
										   fontFamily="calibri" fontSize="11" tabIndex="5"/>
			</s:HGroup>
			<s:HGroup width="100%" >
				<components:LabelDateField id="id_VISDate" toolTip="Visit Date" width="50%" yearNavigationEnabled="true" textInputStyleName="optionalDateTextBox"  
										   enabled="false" editable="false" 
										   maxYear="{new Date().getFullYear()}" minYear="1901" tabIndex="10" selectedDate="{model.VisitDate}"/>
				<components:LabelDateField id="id_ExpiryDate" prompt="Expiry Date" textInputStyleName="optionalDateTextBox" toolTip="Expiry Date" width="50%" 
										   yearNavigationEnabled="true" editable="true" maxYear="{new Date().getFullYear()}" minYear="1901"
										   fontFamily="calibri" fontSize="11" tabIndex="11"/>
			</s:HGroup>
			<components:LabelComboBox id="id_SeriesCmbo" prompt="Series" width="100%" maxChars="250"
									  dataProvider="{model.GeneralLabelDTOListForSeries}"
									  keyUp="Combo_keyUpHandler(event)" tabIndex="15" />
			
		</s:VGroup>
		
		<s:VGroup verticalAlign="top" horizontalAlign="left" width="10%" paddingTop="0" gap="12">
			<commons:AddRecord id="id_Add" writeNotesClick="onWriteNotesClick(event)" writeDictationClick="onWriteDictationClick(event)" 
							   tabIndex="6"/>
		</s:VGroup>	
	</s:HGroup>
	
	<s:HGroup width="100%">
		
		<s:HGroup id="id_imnzButtons" width="100%" > <!--includeInLayout="false" visible="false"-->
			<s:Button id="id_btnAdd"  buttonMode="true" useHandCursor="true" toolTip="Add Record"	  
					  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreTooltipBtn" label="Add Immunization" tabIndex="16" 
					  click="id_add_clickHandler(event)" enabled="{id_Add.enableAll}"
					  width="135"/>
			<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.tooltipBGContainer" visible="{!id_btnAdd.enabled}"/>
		</s:HGroup>
		<s:HGroup horizontalAlign="right" width="100%">
			<s:Button id="id_AddMoreBtn" label="Add More" click="id_AddMoreBtn_clickHandler(event)"
					  skinClass="{id_AddMoreBtn.label=='Close' ? closeCrossButton : AddMoreAllergiesBtn}"
					  toolTip="{id_AddMoreBtn.label=='Close' ? 'Close Immunization Form' :'Add Immunization'}"
					  buttonMode="true" useHandCursor="true"  />
			<s:Button label="Next" id="id_nextBtn" 
					  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QInextBtnSkin"
					  toolTip="Move to Next Section Physical" buttonMode="true" />
		</s:HGroup>
		
		
	</s:HGroup>	
	<immunization:ImmunizationBodyGridView id="gridView" width="100%"/>
</s:Group>