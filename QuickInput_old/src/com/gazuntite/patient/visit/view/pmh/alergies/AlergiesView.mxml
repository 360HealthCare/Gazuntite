					//id_AllergiesGrid.visible 			= false;
					id_nkda.visible = true;
				}
				else
				{
					id_nkda.visible = false;
					
					//id_AllergiesGrid.visible 			= true;
					id_isNKDA.selected 		= false;
					id_onSet.enabled   		= true;
					id_allergyList.enabled	= true;
					id_reaction.enabled 	= true;
					id_Yes.enabled 			= true;
					id_No.enabled 			= true;
				}
				//tahir Alvi - whenevr allergy is added from PR Green mark show in QI Header
				if(model.QIAllergyDTOList && model.QIAllergyDTOList.length)
				{
					if(IsModelUpdated)
