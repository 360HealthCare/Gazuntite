			//---------- delete Record Click Handler -----------------------------------------
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
				
				if (curTar.selectedItem)
				{
					var gaID:String = AllergDTO(curTar.selectedItem).GaxenAllergyID;
					
					if ( ! UtilityFunctions.IsNullOrEmpty( gaID ) )
					{
						UtilityFunctions.AskMessage(  "Do you want to delete selected Allergy", function():void
						{
							var IDsXml:XML = <DeleteAllergies  />
							
							IDsXml.@GaxenAllergyIDS = "'"+ gaID +"'";
							
							callQSAllergyEvent(4, IDsXml, afterDelStatus);
							hasChange = true;
						});
					}
				}
			}
			// Call back method for Allergy delete
			private function afterDelStatus(response:XML):void
			{
				if(UtilityFunctions.IsNotNullOrEmpty(model.gaxenID))
				{
					callQSAllergyEvent(2, model.gaxenID, callBackAllergy);
				}
			}
			// call back allergy 
			private function callBackAllergy(arrAllergy:ArrayCollection):void
			{
				model.ThirdSectionLabel = '';
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
				else
					model.QIAllergyDTOList = new ArrayCollection();
				
				model.QIAllergyDTOList.addAll(arrAllergy);
				
				if(model.QIAllergyDTOList.length > 0)
				{					
					var allergyDto:AllergDTO = new AllergDTO();
					allergyDto			= model.QIAllergyDTOList.getItemAt(0) as AllergDTO;
					//Tahir Alvi - Set Third Section data && NKDA LAbel Flag
					
					if(!allergyDto.isNKDA)
					{
						model.ThirdSectionLabel = allergyDto.AllergyName;
						model.AllergyNKDAFlag 	= false;
					}
					else if(allergyDto.isNKDA)
					{
						model.ThirdSectionLabel = 'No Known Drug Allergies';
						model.AllergyNKDAFlag 	= true;
					}
				}				
				loadAllergiesData();
			}
			// ---------Load allergies from server after loading patient profile in edit mode---------------------------------
			private function loadAllergiesData(response:XML = null):void
			{
				clearForm();// Clear all form 
				if(model.QIAllergyDTOList.length == 0)
				{
					if(!IsModelUpdated)
						IsModelUpdated = true;
					
					IsModelUpdated = false;
					
					if(!hasChange)
						hasChange = true;
					
					hasChange = false;
				}
			}
			//----------- Add Record Click Handler ----------------------------------------------------------------
			protected function id_AddMoreBtn_clickHandler(event:MouseEvent):void
			{
				saveAllergyDTO = null;	
				
				if(id_isNKDA.selected)
				{
					if(allergyCollection && allergyCollection.length == 1 &&  (allergyCollection[0] as AllergDTO).isNKDA )
					{
						UtilityFunctions.ShowMessage("The existing entry is already NKDA.", "Duplicate Entry");
						return;
					}
					else if(allergyCollection && allergyCollection.length >= 1 && ! (allergyCollection[0] as AllergDTO).isNKDA )
					{
						Alert.show("Are you sure, you want to remove all existing allergies?","Confirmation", Alert.YES|Alert.NO, this, function( event:CloseEvent):void
						{
							if( event.detail == Alert.YES )
							{
								var patientAllergyIDs:String = "";
								for each (var ad:AllergDTO in allergyCollection) 
								{
									patientAllergyIDs += ",'" + ad.GaxenAllergyID + "'";
								}								
								
								var IDsXml:XML = <DeleteAllergies  />
								
								IDsXml.@GaxenAllergyIDS = patientAllergyIDs.substring(1);
								
								callQSAllergyEvent(4, IDsXml, deleteStatus);
							}
							else if(event.detail == Alert.NO)
							{
								id_isNKDA.selected 				= false;
								id_onSet.enabled 				= true;
								id_allergyList.enabled 			= true;
								id_reaction.enabled 			= true;
								id_Yes.enabled 					= true;
								id_No.enabled 					= true;
								return;
							}
							
						});
					}
					else 
					{
						callQSAllergyEvent(3, NKDARecord.ToXML(), saveStatus);
					}
				}
				else
				{					
					if( ! ValidationUtils.isValidDateFormat(id_onSet.text))
					{
						id_onSet.setFocus();
						UtilityFunctions.ShowMessage("Please enter OnSet date in valid format: [MM/DD/YYYY]", "Invalid Data");
						return;						
					}
					
					if(id_allergyList.selectedIndex < 0 )
					{
						id_allergyList.setFocus();
						Alert.show("Please select Allergy.", "Required field", Alert.OK, FlexGlobals.topLevelApplication.mainContainer);
						return;
					}
					
					
					
					hasChange = true; 
					
					saveAllergyDTO  					= new AllergDTO();				
					saveAllergyDTO.GaxenPatientID		= model.gaxenID;
					saveAllergyDTO.GaxenAllergyID		= "";
					saveAllergyDTO.modNotesID			= 0;
					saveAllergyDTO.modDictationID		= 0;
					saveAllergyDTO.AllergyName			= id_allergyList.selectedItem.DISPLAY_NAME;
					saveAllergyDTO.isNKDA				= false;
					saveAllergyDTO.isActive				= id_Yes.selected;
					saveAllergyDTO.OnSet				= UtilityFunctions.FormatDate(id_onSet.text);
					saveAllergyDTO.DictationID			= 0;
					saveAllergyDTO.Note					= "";
//					saveAllergyDTO.VisitDate			= formatDateTime.format(model.VisitDate.toString());
					saveAllergyDTO.VisitDate			= formatDateTime.format((new Date()).toString());
					saveAllergyDTO.Reaction				= id_reaction.text;
					
					saveAllergyDTO.LastName 			= model.patientDTO.LastName;
					saveAllergyDTO.FirstName 			= model.patientDTO.FirstName;
					saveAllergyDTO.Gender 				= model.patientDTO.Gender.substring(0,1);
					saveAllergyDTO.DOB 					= model.patientDTO.DOB;
					saveAllergyDTO.Phone 				= ''
					saveAllergyDTO.Address 				= '';
					saveAllergyDTO.ClinicID 			="sad";
					saveAllergyDTO.UserName 			= "TESTUSER";
					saveAllergyDTO.UserPassord 			= "TESTPASS";
					saveAllergyDTO.SSN 					= model.patientDTO.SSN; 
					
					callQSAllergyEvent(3, saveAllergyDTO.ToXML(), saveStatus);
				}
			}
			// -------------------delete status method ----------------------------------------
			private function deleteStatus(response:XML):void
			{
				var msg:String = response.@Description;
				var status:String = response.@status;
				
				if(status == "false" || status == "0" )
				{
					var alert:Alert = Alert.show(msg, "Allergy Status", 4, FlexGlobals.topLevelApplication.mainContainer);	
					return;
				}
				else
				{
					callQSAllergyEvent(3, NKDARecord.ToXML(), saveStatus); 		
				}
				CursorManager.removeBusyCursor();
			}
			//------------------ saveStatus mehod ----------------------------------------------------
			private function saveStatus(response:XML):void
			{
				var msg:String     = response.@Description;
				var status:String  = response.@status;
				model.gaxenID 	   = response.@GaxenPatientID;
				
				if(status == "false" || status == "0" )
				{
					var alert:Alert = Alert.show(msg, "Allergy Status", 4, FlexGlobals.topLevelApplication.mainContainer);	
					return;
				}
				else
				{
					if((model.gaxenID && model.gaxenID != "0") && (model.patientID.toString() != '' && model.patientID.toString() != '0') )
					{
						var gEvent : SavePatientGaxenIdEvent = new SavePatientGaxenIdEvent(model.patientID.toString(), model.gaxenID ,callbackSavePatientGaxenIdEvent);					
						CairngormEventDispatcher.getInstance().dispatchEvent( gEvent ); 
					}
					
					if(UtilityFunctions.IsNotNullOrEmpty(model.gaxenID))
					{
						callQSAllergyEvent(2, model.gaxenID, callBackAllergy);
						dispatchEvent(new SyncPatientGaxenIDEvent(model.gaxenID));
					}
				}
				
				CursorManager.removeBusyCursor();
				clearForm(); 
				if(!id_isNKDA.selected)
					id_onSet.setFocus(); 
			}
			// ---------------- Call Back of SavePatientGaxenIdEvent------------------------------ 
			private function callbackSavePatientGaxenIdEvent(val:Boolean):void
			{
				model.isAtRegGaxenID = true;
				if(model.isAtRegGaxenID)
				{
					model.gaxenIDSaved 			= false;
					model.newRegGaxenID 		= '';
				}
				
			}
			// -------------- Clear Allergy Form ---------------------------------------------------
			private function clearForm():void
			{
				if(id_onSet.text)
					id_onSet.text = '';
				id_onSet.selectedDate = null;
				
				id_allergyList.selectedIndex = -1;
				id_reaction.text = '';
				id_Yes.selected = false;
				id_No.selected = false;
				id_Add.enableAll = false;
				
			}
			//------------ GETTER of Allergy Collection ----------------------------------
			[Bindable]
			public function get allergyCollection():ArrayCollection
			{
				return _allergyCollection;
			}
			//------------------- SETTER of ALLergy Collection ----------------------
			public function set allergyCollection(value:ArrayCollection):void
			{
				_allergyCollection = value;
				
				if(_allergyCollection)
				{
					allergyCollection.addEventListener(CollectionEvent.COLLECTION_CHANGE, collectionChangeHandler, false, 0, true); 
					if(_allergyCollection.length > 0)
					{
						if(hasChange)
							hasChange = false;
						
						hasChange = true;
						
						if(!model.quickInputDataLoadedFlag)
						{
							id_isNKDA.selected 		= false;
							id_onSet.enabled   		= true;
							id_allergyList.enabled	= true;
							id_reaction.enabled 	= true;
							id_Yes.enabled 			= true;
							id_No.enabled 			= true;
						}
					}
				}
			}
			//---------- collectionChangeHandler method ------------------------------------------------
			private function collectionChangeHandler(event:CollectionEvent):void
			{
				//whenevr allergy is added from PR Green mark show in QI Header
				if(model.QIAllergyDTOList && model.QIAllergyDTOList.length)
				{
					if(IsModelUpdated)
						IsModelUpdated = false;
					
					IsModelUpdated = true;
					if(hasChange)
						hasChange = false;
					
					hasChange = true;
				}
			}
			//----------------- label function od On Set -----------------------------------------------
			private function setOnSet(oItem:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.OnSet)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.OnSet));
					strVisitDate = formatDateTime.format(dateRecieved);
					if( strVisitDate.indexOf('NaN',0) != -1)
						strVisitDate = oItem.OnSet;
				}
				return strVisitDate;
			}
			// --------------------------- allergy combo key up handler -----------------------------
			protected function id_allergyList_keyUpHandler(event:KeyboardEvent):void
			{
				if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8) //including only alphabets, digits, special characters, del n backspace
				{
					var searchString:String = id_allergyList.textInput.text;
					if(searchString.length > 2)
					{
						var alEvent : QSAllergyEvent = new QSAllergyEvent(1, searchString, callbackList);
						CairngormEventDispatcher.getInstance().dispatchEvent( alEvent ); 
					}		
				}
			}
			
			private function callbackList(arr:ArrayCollection):void
			{
				if(model.AllergyList)
					model.AllergyList.removeAll();
				else
					model.AllergyList = new ArrayCollection();
				
				model.AllergyList.addAll(arr);
			}
