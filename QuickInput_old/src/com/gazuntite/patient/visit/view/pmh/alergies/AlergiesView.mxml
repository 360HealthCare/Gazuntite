				id_Add.enableAll = areRequiredFieldsProvidedAndValid();
			}
			
			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				var result:Boolean = false;
				
				if (id_onSet.selectedDate != null &&
					(id_allergyList.selectedIndex >= 0 && id_allergyList.selectedItem != null))
				{
					result = true;
				}
				else 
					result = false;
				
				return result;
			}
			
			protected function id_allergyList_changeHandler(event:IndexChangeEvent):void
			{
				id_Add.enableAll = areRequiredFieldsProvidedAndValid();
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				AllowMoveToNextPanel ( dispactchSelectSectionEvent );
				
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new SelectSection('SelectSection','id_AlergiesPanel', true, true) )
				//dispatchEvent( new Event('SelectSection',true,true));
			}
			
			public function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_Add.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YYYY" />
		<mx:DateFormatter id="formatDateTime2" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	<fx:Binding source="model.QIAllergyDTOList" destination="allergyCollection" />
	<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> 
	<fx:Binding source="model.AllergyNKDAFlag" destination="isNKDAFlag" />
	<s:SkinnableContainer id="id_cc" skinClass="com.gazuntite.patient.visit.view.commons.QISectionBGSkin" width="100%">
		<s:layout>
			<s:VerticalLayout paddingTop="7" paddingRight="6" paddingLeft="6" paddingBottom="6"/>
		</s:layout>
		<s:SkinnableContainer  width="100%" > <!--{id_Header.width}skinClass="com.adobe.quivus.skins.chrome.containerSkins.QISectionBGSkin"-->
			<s:layout>
				<s:VerticalLayout  verticalAlign="top" gap="5"  paddingRight="3" paddingLeft="3" paddingTop="3" paddingBottom="3"/>
			</s:layout>
			
			<s:HGroup width="100%"  verticalAlign="middle">
				
				<s:HGroup width="70" verticalAlign="middle">
					<s:CheckBox id="id_isNKDA"
								change="id_isNKDA_changeHandler(event)" width="20" label="NKDA" tabIndex="1" />
					<s:Label color="#ffffff"  text="NKDA" toolTip="Slect NKDA"/>
				</s:HGroup>
				
				<components1:LabelDateField  id="id_onSet" tabIndex="2" change="id_onSet_changeHandler(event)"
											width="30%" textInputStyleName="mandatoryDateSkin" prompt="OnSet"  selectableRange="{{rangeEnd : new Date()}}" yearNavigationEnabled="true" editable="false"/>
				<components1:LabelComboBox id="id_allergyList" tabIndex="3"
										  width="30%"  labelField="DISPLAY_NAME" prompt="Allergy" required="true"
										  toolTip="Allergy" change="id_allergyList_changeHandler(event)"
										  keyUp="id_allergyList_keyUpHandler(event)"  dataProvider="{model.AllergyList}" />
				<components1:LabelTextInput id="id_reaction" tabIndex="4"
										   width="40%" prompt="Reaction" toolTip="Recation" />
				<s:Label text="Active" fontFamily="Calibri" fontSize="12" color="#ffffff"/>
				
				<s:HGroup gap="0">
					<s:RadioButton id="id_Yes"  tabIndex="5"
								   buttonMode="true" skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.YRadioButton" toolTip="Active" />
					<s:RadioButton id="id_No" tabIndex="6"
								   buttonMode="true"  skinClass="com.adobe.gazuntite.skins.chrome.radioButtonSkins.NRadioButton" toolTip="InActive"/>
				</s:HGroup>
				
				<commons:AddRecord id="id_Add" tabIndex="7" visible="false"  />
				
			</s:HGroup>
			
			<s:HGroup width="100%" horizontalAlign="right" >
				<s:Button id="id_AddMoreBtn" tabIndex="8"
						  enabled="{id_Add.enableAll}"
						  label="Add More" click="id_AddMoreBtn_clickHandler(event)" width="80"
						  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.AddMoreTooltipBtn"
						  buttonMode="true" useHandCursor="true" toolTip="Add More Allergies"/>
				
				<s:Button label="Next" 
						  click="button1_clickHandler(event)"
						  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QInextBtnSkin" buttonMode="true" toolTip="Next Section" />
			</s:HGroup>
			<s:Label id="id_nkda" text="NO KNOWN DRUG ALLERGIES" fontFamily="Calibri" fontSize="15"  textAlign="center" fontWeight="bold" verticalAlign="top" 
					 visible="false" includeInLayout="{id_nkda.visible}" width="100%" color="#FFFFFF"/>
			<!--<s:BorderContainer width="100%" borderWeight="5">-->
				
				<components1:LabelDataGrid id="id_AllergiesGrid" 
										  width="100%"  
										  rowCount="{id_AllergiesGrid.dataProvider.length? id_AllergiesGrid.dataProvider.length : 1}" 
										  rowHeight="23" horizontalScrollPolicy="off"
										  minHeight="70" maxHeight="250"
										  verticalScrollPolicy="on"
										  includeInLayout="{id_AllergiesGrid.visible}"
										  columnWidths="{['10%','15%','15%','20%','20%','10%','10%']}"
										  visible="{(!model.AllergyNKDAFlag) &amp;&amp; (!id_nkda.visible) &amp;&amp; (!id_lbl.visible) &amp;&amp; (id_AllergiesGrid.dataProvider.length > 0)}"
										  dataProvider="{allergyCollection}"
										  >
					<components1:columns>
						<mx:DataGridColumn headerText="NKDA" dataField="NKDA" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="Visit Date" width="100" dataField="VisitDate" headerWordWrap="true" labelFunction="displayVisitDate" />
						<mx:DataGridColumn headerText="OnSet" dataField="OnSet" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="setOnSet"/>
						<mx:DataGridColumn headerText="Allergy" dataField="AllergyName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText="Reaction" dataField="Reaction" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText="Status" dataField="Status" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText=""	itemRenderer="com.gazuntite.patient.visit.view.itemrenderers.AllergyDeleteRenderer" sortable="false"/>
					</components1:columns>
				</components1:LabelDataGrid>
				
				<s:Label id="id_lbl" text="No Allergies" color="#FFFFFF" verticalAlign="top" visible="{(!id_AllergiesGrid.dataProvider.length > 0)  &amp;&amp; (!id_nkda.visible)}"  includeInLayout="{id_lbl.visible}" fontFamily="Calibri" fontSize="14" width="100%" textAlign="center"/>
				
			<!--</s:BorderContainer>-->
			
		</s:SkinnableContainer>
	</s:SkinnableContainer>
	
</s:Group>
