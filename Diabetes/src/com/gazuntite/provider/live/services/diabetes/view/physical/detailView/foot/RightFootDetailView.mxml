	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="3" paddingBottom="3" paddingLeft="3" paddingRight="3" paddingTop="3" />
	</s:layout>
	<s:Group width="100%" height="70">
		<s:layout>
			<s:HorizontalLayout />
		</s:layout>
		
		<s:HGroup width="50%" height="100%" horizontalAlign="left">
			<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.WhiteViewSkin" width="53" height="53">
				<s:Image source="@Embed('com/gazuntite/provider/live/services/diabetes/view/physical/assets/rightFoot.png')"
						 width="100%" height="100%"/>
			</s:SkinnableContainer>
			<s:VGroup height="100%" width="100">
				<s:CheckBox width="100%" label="Redness" toolTip="Redness"
							skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"
							buttonMode="true" useHandCursor="true"/>
				<s:CheckBox width="100%" label="Swelling" toolTip="Swelling"
							skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"
							buttonMode="true" useHandCursor="true"/>
				<s:CheckBox width="100%" label="Warmth" toolTip="Warmth"
							skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"
							buttonMode="true" useHandCursor="true"/>
			</s:VGroup>
			<s:VGroup height="100%" width="100">
				<s:CheckBox width="100%" label="Dryness" toolTip="Dryness"
							skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"
							buttonMode="true" useHandCursor="true"/>
				<s:CheckBox width="100%" label="Maceration" toolTip="Maceration"
							skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"
							buttonMode="true" useHandCursor="true"/>
			</s:VGroup>
		</s:HGroup>
		
		<s:HGroup width="50%" height="100%" horizontalAlign="right" verticalAlign="middle">
			<s:RichText fontSize="14" tabStops="S0" whiteSpaceCollapse="preserve" fontFamily="CalibriCFFBold" fontWeight="bold">
				<s:content><s:p><s:span>Identify</s:span></s:p><s:p><s:span>Spots</s:span></s:p></s:content>
			</s:RichText>
			
			<s:ToggleButton skinClass="com.gazuntite.skins.controls.toggleButtonSkin.diabetics.RightPreUlsarTBSkin" 
							useHandCursor="true" buttonMode="true" toolTip="Pre-Ulser"/>
			<s:ToggleButton skinClass="com.gazuntite.skins.controls.toggleButtonSkin.diabetics.RightUlsarTBSkin" 
							useHandCursor="true" buttonMode="true" toolTip="Ulser"/>
			<s:ToggleButton skinClass="com.gazuntite.skins.controls.toggleButtonSkin.diabetics.RightCallousTBSkin" 
							useHandCursor="true" buttonMode="true" toolTip="Callous"/>
		</s:HGroup>
	</s:Group>
	
	
	<s:HGroup width="100%" height="50%" gap="2">
		<detailView:DecimalInputWithSpinnerPop id="id_BrachialSystolic" label="Brachial Systolic Pressure" width="25%" show2ndValue="false" valueA="0"
											   creationComplete="id_SystolicPressure_creationCompleteHandler(event)"/>
		
		<detailView:DecimalInputWithSpinnerPop id="id_AnkelSystolic" label="Ankle Systolic Pressure" width="25%" show2ndValue="false" valueA="0"
											   creationComplete="id_AnkelSystolic_creationCompleteHandler(event)"/>
		
		<detailView:DecimalInputWithSpinnerPop id="id_IschemicIndex" label="Ischemic Index" width="25%" show2ndValue="false" valueA="0"
											   creationComplete="id_IschemicIndex_creationCompleteHandler(event)"/>
		<s:Spacer width="5" />
		<s:VGroup height="100%" width="25%" horizontalAlign="right">
			<s:DropDownList id="id_examType" 
							width="100%" prompt="Assign Risk Category:" height="28"
							skinClass="com.gazuntite.skins.controls.dropdownList.DDStepperSkin"
							itemRenderer="com.gazuntite.provider.live.services.diabetes.view.physical.itemRenderer.DDItemrederer"
							useHandCursor="true" buttonMode="true" horizontalScrollPolicy="off"
							click="id_examType.openDropDown()">
				<s:ArrayCollection>
					<fx:Object label="No Present Risk" Field="No Present Risk" />
					<fx:Object label="Impeding Risk" Field="Impeding Risk" />
					<fx:Object label="High Risk" Field="High Risk" />
				</s:ArrayCollection>
			</s:DropDownList>
		</s:VGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" horizontalAlign="right" >
		<s:Button toolTip="Save" 
				  buttonMode="true" useHandCursor="true"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"/>
	</s:HGroup>
</s:Group>