<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:physical="com.gazuntite.provider.live.services.diabetes.view.physical.*" 
		 xmlns:detailView="com.gazuntite.provider.live.services.diabetes.view.physical.detailView.*"
		 xmlns:eye="com.gazuntite.provider.live.services.diabetes.view.physical.detailView.eye.*" 
		 xmlns:foot="com.gazuntite.provider.live.services.diabetes.view.physical.detailView.foot.*"
		 xmlns:lung="com.gazuntite.provider.live.services.diabetes.view.physical.detailView.lung.*"
		 creationComplete="cc()" 
		 >
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			private var _selectedOrganIndex:int = 0; // 0 for feet , 1 for eye , 2 for lung
			
			[Bindable]
			public function get selectedOrganIndex():int
			{
				return _selectedOrganIndex;
			}
			
			public function set selectedOrganIndex(value:int):void
			{
				_selectedOrganIndex = value;
			}
			
			protected function cc():void
			{
				// TODO Auto-generated method stub
			}
			
			public function PrepareView(index:int):void
			{
				selectedOrganIndex = index;
				
				switch(selectedOrganIndex)
				{
					case 0:
					{
						// Eye is selected
						break;
					}
					case 1:
					{
						// Foot is selected
						break;
					}
					case 2:
					{
						// Lung is selected
						break;
					}
						
					default:
					{
						break;
					}
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer width="100%" height="100%" ><!-- skinClass="com.gazuntite.skins.controls.container.PinkBackgroundSkin"-->
		<components:LabelViewStack id="uiViewStack" 
								   width="100%" height="100%" backgroundAlpha="0" borderVisible="false"
								   selectedIndex="{selectedOrganIndex}">
			<s:ArrayList>
				<foot:DiabeticFootDetailView width="100%" height="100%" />
				<eye:DiabeticEYEDetailView width="100%" height="100%" />
				<lung:DiabeticLungDetailView width="100%" height="100%" />
			</s:ArrayList>
		</components:LabelViewStack>
	</s:SkinnableContainer>
</s:Group>