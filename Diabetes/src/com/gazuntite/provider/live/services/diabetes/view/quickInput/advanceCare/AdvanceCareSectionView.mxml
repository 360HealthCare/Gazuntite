<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:quickInput="com.gazuntite.provider.live.services.diabetes.view.quickInput.*" 
		 xmlns:advanceCare="com.gazuntite.provider.live.services.diabetes.view.quickInput.advanceCare.*"
		 xmlns:components1="com.gazuntite.components.*"
		 creationComplete="cc(event)" xmlns:dictation="com.gazuntite.components.dictation.*" 
		 xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" 
		 xmlns:dictation2="com.gazuntite.dictation.view.dictation.*"
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.events.SelectSection;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.events.FlexEvent;
			
			private var _data:Object;
			
			public function get data():Object
			{
				return _data;
			}

			[Bindable]
			public function set data(value:Object):void
			{
				_data = value;
			}

			protected function cc(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			private var _dictationNoteViewModel:PatientDictationNoteViewModel;
			
			[Bindable]
			public function get dictationNoteViewModel():PatientDictationNoteViewModel
			{
				return _dictationNoteViewModel;
			}
			
			public function set dictationNoteViewModel(value:PatientDictationNoteViewModel):void
			{
				_dictationNoteViewModel = value;
			}

			
			private function saveClickHandler():void
			{
				
			}
			
			protected function next_clickHandler(event:MouseEvent):void
			{
				dispatchEvent(new SelectSection(SelectSection.SelectInnerTabEvent,'Start for Allergy'));
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<!--<s:layout>
		<s:VerticalLayout horizontalAlign="right" paddingBottom="2" paddingTop="2"/>
	</s:layout>
	-->
	<s:layout>
		<s:VerticalLayout  horizontalAlign="right" gap="5" paddingLeft="5" paddingRight="5" paddingTop="8" paddingBottom="8"/>
	</s:layout>
	
	<s:HGroup width="100%"  height="150" gap="0">
		<advanceCare:AdvanceCareFormView id="id_FormView" width="100%" height="100%" data="{data}"/>
		<advanceCare:AdvanceCareInnerView id="id_InnerView" width="100%"  height="145" />
	</s:HGroup>
	
	<!--<s:Button id="id_saveBtn" right="5"
			  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"
			  toolTip="Save" useHandCursor="true" buttonMode="true"/>-->
	
	<s:HGroup width="100%" height="25" verticalAlign="middle" horizontalAlign="right">
		<s:ToggleButton  includeInLayout="false" visible="false"
			id="dictation" depth="3"
			buttonMode="true" toolTip="Dictation"
			skinClass="com.gazuntite.skins.controls.button.input.DictationButtonSkin"
			selected="@{dictationNoteViewModel.inDictationMode}"/>
		<s:ToggleButton  includeInLayout="false" visible="false"
			id="note" depth="3"
			buttonMode="true" toolTip="Note"
			skinClass="com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin"
			selected="@{dictationNoteViewModel.inNoteMode}"/>
		
		<s:Button id="save" toolTip="Save" buttonMode="true" useHandCursor="true" skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"
				  click="saveClickHandler()"/>
		<s:Button id="next" toolTip="Next" buttonMode="true" useHandCursor="true" click="next_clickHandler(event)" skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin" 
				  label="Next" />
	</s:HGroup>
	
	<dictation2:PatientDictationNoteView id="dictationNoteView" width="100%" viewModel="{dictationNoteViewModel}" isSaveButtonVisible="false"/>
</s:Group>
