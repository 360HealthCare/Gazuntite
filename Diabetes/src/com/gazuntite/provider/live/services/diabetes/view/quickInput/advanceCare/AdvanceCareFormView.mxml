<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:components="com.gazuntite.controls.extended.components.*"
		 
		 creationComplete="cc(event)"
		 >
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected function cc(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			
			private var _data:Object;
			
			[Bindable]
			public function get data():Object
			{
				return _data;
			}
			
			public function set data(value:Object):void
			{
				_data = value;
			}

			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout paddingLeft="5" paddingBottom="5" paddingTop="5" />
	</s:layout>
	<s:CheckBox id="id_DiscussedChkBox" 
				width="100%" label="Discussed with Patient" 
				skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"  />
	
	<s:BorderContainer width="100%" height="100%" cornerRadius="3" borderColor="0xC1A39E" borderWeight="2">
		<s:layout>
			<s:VerticalLayout paddingBottom="3" paddingTop="3" paddingLeft="4" paddingRight="3"/>
		</s:layout>
		
		<s:HGroup width="100%"  verticalAlign="middle">
			<s:Label text="Agent 01: " width="25%" styleName="patientFormLabel" />
			<s:TextInput id="id_agent" prompt="Enter Agent" width="100%" height="21" toolTip="Enter Agent"
						 skinClass="com.gazuntite.skins.IPEControls.IPETextInputSkin"  text="{data.AgentName}" />
		</s:HGroup>
		
		<s:HGroup width="100%" verticalAlign="middle">
			<s:Label text="Address: " width="25%" styleName="patientFormLabel" />
			<s:TextInput id="id_Address" prompt="Enter Address" width="100%" height="21" toolTip="Enter Address"
						 skinClass="com.gazuntite.skins.IPEControls.IPETextInputSkin"  text="{data.Address}" />
		</s:HGroup>
		
		<s:HGroup width="100%" verticalAlign="middle">
			<s:Label text="Relation: " width="25%" styleName="patientFormLabel" />
			<s:TextInput id="id_Relation" prompt="Enter your relation" width="100%" height="21" toolTip="Enter your relation"
						 skinClass="com.gazuntite.skins.IPEControls.IPETextInputSkin"  text="{data.Relation}" />
		</s:HGroup>
		
		<s:HGroup width="100%">
			
			<s:HGroup width="60%" verticalAlign="middle">
				<s:Label text="Phone #: " width="33%" styleName="patientFormLabel" />
				<s:TextInput id="id_Phone" prompt="Enter phone. #" width="60%" height="21"  toolTip="Enter phone. #"
							 skinClass="com.gazuntite.skins.IPEControls.IPETextInputSkin"  text="{data.Phone}" />
			</s:HGroup>
			
			<s:HGroup width="40%"  verticalAlign="middle">
				<s:Label text="Zip: " width="30%" styleName="patientFormLabel" />
				<s:TextInput id="id_zip" prompt="Enter Zip" width="100%" height="21" toolTip="Enter Zip"
							 skinClass="com.gazuntite.skins.IPEControls.IPETextInputSkin"   text="{data.ZipCode}" />
				
			</s:HGroup>
		</s:HGroup>
	</s:BorderContainer>
	
</s:Group>