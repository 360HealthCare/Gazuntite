	<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
		</s:layout>
		<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
		<s:DropDownList skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
						selectedIndex="0" buttonMode="true" toolTip="Sort List">
			<s:dataProvider>
				<s:ArrayCollection>
					<fx:Object label="Recently Added"/>
					<fx:Object label="Agent Name"/>
				</s:ArrayCollection>
			</s:dataProvider>
		</s:DropDownList>
		<s:Spacer width="100%"/>
	</s:SkinnableContainer>
	
	<s:List id="id_list" width="100%" height="100%" allowMultipleSelection="false"
			skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
			verticalScrollPolicy="auto" horizontalScrollPolicy="off"
			borderVisible="false" dataProvider="{DataSET}"
			itemRenderer="com.gazuntite.provider.live.services.diabetes.view.ItemRenderer.DiabeticHistoryIR"/>
