				{label:'label 5', id:6, propx:'prop 6', commonProp:'xyz' , commonProp2:'13' , groupID:''},
				{label:'label 7', id:7, propx:'prop 7', commonProp:'john' , commonProp2:'13' , groupID:''},
				{label:'label 8', id:9, propx:'prop 9', commonProp:'xyz' , commonProp2:'12' , groupID:''},
				
