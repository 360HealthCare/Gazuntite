<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				useHandCursor="true" buttonMode="true"
				autoDrawBackground="false"
				mouseOver="this.currentState = 'over'"
				mouseOut="this.currentState = 'normal'"
				>
	<s:layout>
		<s:VerticalLayout gap="0"/>
	</s:layout>
	<s:states>
		<s:State name="normal"/>		
		<s:State name="over"/>
	</s:states>
	
	<s:Spacer height="2" />
	
	<s:Line width="99%">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line>
	<s:Spacer height="1" />
	<s:BorderContainer width="100%" height="17" borderVisible="false" backgroundColor.over="0xC5D1DA">
		<s:Label  text="{data.label}" paddingLeft="5"  toolTip="{data.label}"  width="100%" fontFamily="CalibriCFF" fontSize="12" 
				  verticalCenter="0" showTruncationTip="true"/>
	</s:BorderContainer>
	
	
</s:ItemRenderer>
