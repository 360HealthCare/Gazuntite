<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout  paddingLeft="7" paddingTop="7"/>
	</s:layout>
	
	<s:VGroup width="100%" height="100%" >
		<s:CheckBox id="id_UncounsionCondition" width="100%" 
					label="Permanent Uncounsious Condition" toolTip="Permanent Uncounsious Condition" 
					skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack" buttonMode="true" useHandCursor="true"/>
		<s:CheckBox id="id_PermanantConfusion" width="100%" label="Permanant Confusion" toolTip="Permanant Confusion" 
					skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack" buttonMode="true" useHandCursor="true" />
		<s:CheckBox id="id_DailyActivities" width="100%" label="Dependent in Daily Activities" toolTip="Dependent in Daily Activities"
					skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack" buttonMode="true" useHandCursor="true" />
		<s:CheckBox id="id_EndStageIllness" width="100%" label="End-Stage Illness" toolTip="End-Stage Illness"
					skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack" buttonMode="true" useHandCursor="true" />
	</s:VGroup>
	
</s:Group>
