<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:foot="com.gazuntite.provider.live.services.diabetes.view.physical.detailView.foot.*">
	
	<fx:Script>
		<![CDATA[
			protected function button1_clickHandler(event:MouseEvent):void
			{
				dispatchEvent(new Event('BackClicked',true));
				
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:Button label="Back" toolTip="Back" left="5" top="5"
			  useHandCursor="true" buttonMode="true"
			  click="button1_clickHandler(event)"
			  skinClass="com.gazuntite.skins.controls.button.BackSectionButtonSkin"/>
	
	<s:VGroup width="100%" height="100%" gap="-5" paddingTop="10" paddingLeft="2" paddingRight="2" paddingBottom="5" horizontalAlign="center">
		
		<s:TabBar dataProvider="{uiViewStack}" labelField="name" 
				  skinClass="com.gazuntite.skins.controls.tabbar.PinkTabBarSkin"/>
		<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
			<s:Group width="100%" height="100%">
				<s:layout>
					<s:VerticalLayout gap="0" />
				</s:layout>
				<s:SkinnableContainer width="100%" height="100%" skinClass="com.gazuntite.skins.controls.container.PinkBackgroundSkin">
					<components:LabelViewStack id="uiViewStack" width="100%" height="100%" backgroundAlpha="0" borderVisible="false">
						<s:ArrayList>
							<foot:LeftFootDetailView name="Left" width="100%" height="135" />
							<foot:RightFootDetailView name="Right" width="100%" height="135" />
						</s:ArrayList>
					</components:LabelViewStack>
				</s:SkinnableContainer>
			</s:Group>
		</s:Scroller>
	</s:VGroup>
	
</s:Group>
