<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:s="library://ns.adobe.com/flex/spark"
		 xmlns:fx="http://ns.adobe.com/mxml/2009"
		 xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		 width="375" height="112">
	
	<fx:Script>
		<![CDATA[
			import mx.managers.PopUpManager;
			protected function button1_clickHandler(event:MouseEvent):void
			{
				mx.managers.PopUpManager.removePopUp(this);
			}
			
			protected function button2_clickHandler(event:MouseEvent):void
			{
				
				
				
				mx.managers.PopUpManager.removePopUp(this);
			}
			
		]]>
	</fx:Script>
	
	<s:Rect height="112" radiusX="6" width="375" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0.396078431372549"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="20" blurY="20" color="0x000000" distance="10" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="33" radiusX="6" width="375" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#424242" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect height="12" width="375" x="0" y="28">
		<s:fill>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill>
	</s:Rect>
	<s:RichText color="#000000" fontFamily="Calibri" fontSize="15" tabStops="S0 S50 S100 S150" whiteSpaceCollapse="preserve" x="83" y="45">
		<s:content><s:p><s:span color="#1b75bb" fontWeight="bold">John H. Doe</s:span><s:span><![CDATA[ Calling...]]></s:span></s:p></s:content>
	</s:RichText>
	<s:RichText color="#FFFFFF" fontFamily="Calibri" fontSize="14" tabStops="S0" text="Call Alert" x="12" y="7"/>
	<s:Button enabled="true" 
			  skinClass="com.gazuntite.skins.controls.button.CallAcceptBtnSkin"
			   click="button2_clickHandler(event)"
			  toolTip="Accept Call" d:userLabel="AcceptCall" x="83" y="69"/>
	<s:Button buttonMode="true" label="Button" 
			  skinClass="com.gazuntite.skins.controls.button.CallRejectBtnSkin"
		 toolTip="Reject Call" d:userLabel="RejectCall" x="187" y="69" click="button1_clickHandler(event)"/>
	<s:Group x="12" y="41">
		<s:Rect height="53" radiusX="5" width="54" x="0" y="0">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#94A0B2" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#A6B4C0" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>
		<s:BitmapImage smooth="true" source="@Embed('/assets/picbgtransparent.png')" x="0" y="1"/>
		<s:BitmapImage smooth="true" source="@Embed('/assets/profilepic02.png')" x="8" y="5"/>
	</s:Group>
</s:Group>
