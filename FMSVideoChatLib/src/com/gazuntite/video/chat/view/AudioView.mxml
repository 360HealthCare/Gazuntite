	<fx:Script>
		<![CDATA[
			import mx.managers.PopUpManager;
			protected function clear_clickHandler(event:Event):void
			{
				contents.visible=false;

				var pop:CallAlertPop=new CallAlertPop();
				pop.x=300;
				pop.y=400;
				pop.addEventListener(Event.REMOVED_FROM_STAGE, onRemove);
				mx.managers.PopUpManager.addPopUp(pop,this.parentApplication as DisplayObject,true);
				mx.managers.PopUpManager.bringToFront(pop);
				
			}
			
			protected function call_clickHandler(event:Event):void
			{
				contents.visible=false;

				var pop:CallConnectPop=new CallConnectPop();
				pop.x=300;
				pop.y=400;
				pop.addEventListener(Event.REMOVED_FROM_STAGE, onRemove);
				mx.managers.PopUpManager.addPopUp(pop,this.parentApplication as DisplayObject,true);
				mx.managers.PopUpManager.bringToFront(pop);
			}
			
			private function onRemove(event:Event):void
			{
				contents.visible=true;
			}
			
		]]>
	</fx:Script>
