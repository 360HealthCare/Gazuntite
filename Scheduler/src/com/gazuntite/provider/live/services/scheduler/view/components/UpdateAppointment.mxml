			[Bindable]
			private var model:SchedulerModelLocator = SchedulerModelLocator.getInstance();
			
			private var isValid:Boolean;
			private var schedularUtils:SchedularUtils = new SchedularUtils();
			private var obj_selectedAppointment:Object;
			private static var counter:int;
			
			//******** Find Selected patient & Appointment *********************************************************************************			
			public function loadAppointment(val:int):void
			{
				obj_selectedAppointment = new Object();
				for(var i:uint = 0; i < model.ScheduledAppointmentList.length; i++ )
				{
					obj_selectedAppointment 			= model.ScheduledAppointmentList[i];
					if(obj_selectedAppointment.ID == val)
					{
						counter = i;
						loadPatientCompleteInfoEvent(model.ScheduledAppointmentList[i].Patient.ID);
						populateFormData(model.ScheduledAppointmentList[i] as Object);
					}
				}
			}
			
			// ********** Load Selected Patient Complete Info in EditAppointment View ******************************************************************
			private function loadPatientCompleteInfoEvent(patientID:String):void
			{
				var lPCInfoEvent : LoadPatientCompleteInfoEvent = new LoadPatientCompleteInfoEvent(int(patientID), model.loggedInUserSelectedBranchId, model.loggedInUserId, model.loggedInUserSelectedStationId, loadCompleteInfo);
				CairngormEventDispatcher.getInstance().dispatchEvent( lPCInfoEvent );
				CursorManager.setBusyCursor();
			}
			private function loadCompleteInfo(val:*=null):void
			{
				btnSave.enabled = true;
			}
			// ******************* Load the Appointment data into Form ***********************************************
			private function populateFormData(obj:Object):void
			{
				//Select Appointment Type
				for(var i:uint = 0; i < model.StaticData.AppointmentTypesList.length; i ++){
					var strType:String	= model.StaticData.AppointmentTypesList[i].Name;
					if(obj.Type.Name == strType)	
						cmbType.selectedIndex = i;
				}
				//Select Appointment Status
				for(var k:uint = 0; k < model.StaticData.AppointmentCurrentStatusList.length; k ++){
					var strStatus:String	= model.StaticData.AppointmentCurrentStatusList[k].Name;
					if(obj.Action.Name == strStatus)	
						cmbStatus.selectedIndex = k;
				}
				//Select Appointment Location
				for (var a:uint = 0; a < model.StaticData.StationsByClinicIDList.length; a++ ){
					var strLocation:String = model.StaticData.StationsByClinicIDList[a].Name;
					if(obj.StationName == strLocation)
						cmbLocation.selectedIndex = a;
				}
				//Select Provider
				for(var p:uint =0; p < model.StaticData.ProviderByClinicIDList.length; p++){
					var strProvider:String	= model.StaticData.ProviderByClinicIDList[p].UserID;
					if(obj.UserID == strProvider)	
						cmbProvider.selectedIndex = p;
				} 
				
				//Selected Appointment Description / chief complaint
				taCompleint.text = StringUtil.trim(obj.ChiefComplaint);
				//Selected Appointment Date / Date on which Appointment is Created.
				cmbDate.selectedDate = new Date(obj.Date);
				
				var strDate:String = obj.Date;
				
				//call Selected Provider Working Hours Service
				var LPWHEvent:LoadProviderWorkingHoursEvent	= new LoadProviderWorkingHoursEvent(cmbProvider.selectedItem.UserID, cmbProvider.selectedItem.ID ,cmbProvider.selectedItem.StationID, dateFormatter.format(obj.Date), populateWorkingHours);
				CairngormEventDispatcher.getInstance().dispatchEvent(LPWHEvent);
				CursorManager.setBusyCursor();
				
				
			}
			//********************** populate Working Hours in Form ****************************************************
			private function populateWorkingHours(val:*=null):void
			{
				for(var s:uint =0; s <model.ProviderWorkingHourList.length; s++)
				{
					if(model.ScheduledAppointmentList[counter].StartTime == model.ProviderWorkingHourList[s].StartTime)
						cmbStartTime.selectedIndex = s;
					
					if(model.ScheduledAppointmentList[counter].EndTime == model.ProviderWorkingHourList[s].EndTime)
						cmbEndTime.selectedIndex = s;
				}
			}
			// ********** Remove UpdateAppointment View ******************************************************************
			private function removePopup():void
			{
				PopUpManager.removePopUp(this);
			}
			// ********** Open popup for Description ************************************************
			protected function btnUpdate_clickHandler():void
			{
				var infoUpdate:InformationUpdateAlert = new InformationUpdateAlert();
				PopUpManager.addPopUp(infoUpdate, this, true);
				PopUpManager.centerPopUp(infoUpdate);  
			}
			
			// ********** Appointment Form Methods *******************************************************////
			protected function cmbProvider_changeHandler(event:IndexChangeEvent):void
			{
				cmbStartTime.enabled = true;		cmbEndTime.enabled = true;
				cmbStartTime.selectedIndex = -1;	cmbEndTime.selectedIndex = -1; 
				// Call ProviderWorkingHour Service
				var LPWHEvent:LoadProviderWorkingHoursEvent	= new LoadProviderWorkingHoursEvent(cmbProvider.selectedItem.UserID, cmbProvider.selectedItem.ID ,cmbProvider.selectedItem.StationID, dateFormatter.format(cmbDate.text), populateWorkingHours);
				CairngormEventDispatcher.getInstance().dispatchEvent(LPWHEvent);
				CursorManager.setBusyCursor();
			}
			
			//******************** label Date Formater Function (label date Field)****************************			
			private function doLabelDate(item:Date):String 
			{
				return dateFormatter.format(item);
			}
			//*********************** validate Form and call for Save Edit Appointment  ******************************************************
			private function updateAppointment():void
			{
				validateAppointForm();
				if(!isValid)
				{
					if(isAppTimeinValid()){
						Alert.show('Start Time must before End Time', 'Invalid Appointment Time',4,FlexGlobals.topLevelApplication.mainContainer);
						return;
					}  
					/* if(checkDuplicateAppointment(String(cmbProvider.selectedItem.UserID), String(model.SelectedPatient.ID), 
						String(dateFormatter3.format(cmbDate.text)), String(cmbStartTime.selectedItem.StartTime), 
						String(cmbEndTime.selectedItem.EndTime), String(cmbLocation.selectedItem.ID)))
					{
						Alert.show('Appointment is already created for this patient'+'\n'+ 'with same Provider', 'Already Scheduled Appointment');
						return;
					}  */
					var date:Date = new Date();
					var mAppointmentDto:AppointmentDTO = new AppointmentDTO();
					
					var obj:Object 			= new Object();
					obj					 	= model.ScheduledAppointmentList[counter];
					obj.StationID			= cmbLocation.selectedItem.ID;
					obj.StationName			= cmbLocation.selectedItem.Name;
					obj.UserID				= cmbProvider.selectedItem.UserID;
					obj.FirstName			= cmbProvider.selectedItem.FirstName;
					obj.LastName			= cmbProvider.selectedItem.LastName;
					obj.MiddleName			= '';
					obj.Date  				= dateFormatter2.format(cmbDate.text)+'T'+time.format(date);
					obj.StartTime 			= cmbStartTime.selectedItem.StartTime;
					obj.EndTime 			= cmbEndTime.selectedItem.EndTime;
					obj.ChiefComplaint 		= StringUtil.trim(taCompleint.text);
					obj.ModifiedBy 			= String(model.loggedInUserProviderId);
					obj.ModifiedAt 			= dateFormatter2.format(date.toDateString())+'T'+time.format(date);
					obj.Type.ID 			= cmbType.selectedItem.ID;
					obj.Type.Name 			= cmbType.selectedItem.Name;
					obj.Action.ID 			= cmbStatus.selectedItem.ID;
					obj.Action.Name 		= cmbStatus.selectedItem.Name;
					obj.Action.NextAction	= cmbStatus.selectedItem.NextAction;
					
					model.ScheduledAppointmentList[counter] = obj;
					var appointmentXML:XML = mAppointmentDto.ToXML(model.ScheduledAppointmentList[counter] as Object)
				///	trace('Edit Appointment XML ------ >>>>> ',appointmentXML.toXMLString());
					
					//call ManageAppointment Service
					var MAPPEvent:ManageAppointmentEvent = new ManageAppointmentEvent(appointmentXML, cmbProvider.selectedItem.ID, cmbProvider.selectedItem.UserID, callRefeshAppointments );
					CairngormEventDispatcher.getInstance().dispatchEvent(MAPPEvent);
					CursorManager.setBusyCursor();
					removePopup();
				}else
				{
					shakeEffect.play();
				}
			}
			//*************************** Refresh Appointments and Show update message *******************************
			private function callRefeshAppointments(val:* = null):void
			{
				dispatchEvent(new RefreshCalendarAppoinmentsEvent('refreshCalendarAppoinmentsEvent'));
				Alert.show('Appointment Update Successfully', 'Done',4,FlexGlobals.topLevelApplication.mainContainer);
			}
			
			//************************* validation of Form **************************************************************	
			private function validateAppointForm():void
			{
				isValid = false;
				if(cmbType.selectedIndex == -1 || cmbDate.text.length == 0 || cmbProvider.selectedIndex == -1 || cmbLocation.selectedIndex == -1 
					|| cmbStartTime.selectedIndex == -1 || cmbEndTime.selectedIndex == -1 || cmbStatus.selectedIndex == -1 ||taCompleint.text.length == 0)
				{
					isValid = true;
				}
			}
			//************* validate for duplicate appointment ************************************************
			private function checkDuplicateAppointment(userID:String, patientID:String, date:String, startTime:String, endTime:String, stationID:String):Boolean
			{
				var isMatched:Boolean = false;
				if(model.AllAppointmentList.length > 1)
				{
					for(var i:uint =0; i< model.AllAppointmentList.length; i++)
					{
						var obj:Object = new Object();
						obj		= model.AllAppointmentList[i];
						var strDate:String  = obj.Date;
						if( userID 		== obj.UserID && 
							patientID 	== obj.Patient.ID &&
							date		== strDate.substr(0,10)      &&
							startTime  	== obj.StartTime  &&
							endTime	 	== obj.EndTime    &&
							stationID  	== obj.StationID)
						{
						trace(userID    +' == '+ obj.UserID ,
							patientID 	+' == '+ obj.Patient.ID,
							date 		+' == '+ strDate.substr(0,10),
							startTime 	+' == '+ obj.StartTime,
							endTime		+' == '+ obj.EndTime,
							stationID  	+' == '+ obj.StationID)
							isMatched =  true;
						}
					}
				}
				
				return isMatched;
			} 
			//************************ validate start time and end time **************************************
			private function isAppTimeinValid():Boolean
			{
				var strdate:String = cmbDate.text;
				var arrdate:Array = new Array();
				arrdate = strdate.split('-', strdate.length);
				var strSTime:String = cmbStartTime.selectedItem.StartTime;
				var strETime:String = cmbEndTime.selectedItem.EndTime;
				var arrSTime:Array = new Array();
				var arrETime:Array = new Array();
				strSTime = strSTime.substr(0,5);
				strETime = strETime.substr(0,5);
				arrSTime = strSTime.split(':', 5);
				arrETime = strETime.split(':', 5);
				
				var sD:Date = new Date(arrdate[2], arrdate[0], arrdate[1], arrSTime[0], arrSTime[1]);//Date(2011, 12, 20, 09, 15);
				var eD:Date = new Date(arrdate[2], arrdate[0], arrdate[1], arrETime[0], arrETime[1]);
				
				return schedularUtils.comapreTime(sD, eD);
			}
			
		]]>
	</fx:Script>
	
