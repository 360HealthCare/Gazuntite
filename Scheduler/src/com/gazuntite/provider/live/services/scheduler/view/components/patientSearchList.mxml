<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:extended="com.adobe.gazuntite.view.controls.extended.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 creationComplete="popupgroup1_creationCompleteHandler(event)"
		 >
	<fx:Metadata>
		[Event(name="SearchListPatientSelected", type="com.zigron.provider.live.services.documentMgmt.view.event.PatientSelectedEvent")]
	</fx:Metadata>
	<components:layout>
		<s:VerticalLayout gap="-1" paddingBottom="0" paddingLeft="0" paddingTop="-6" verticalAlign="top" horizontalAlign="center" />
	</components:layout>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.scheduler.dto.SearchPatientDTO;
			import com.gazuntite.provider.live.services.scheduler.model.SchedulerModelLocator;
			import com.gazuntite.provider.live.services.scheduler.view.event.PatientSelectedEvent;
			import com.gazuntite.provider.live.services.scheduler.view.itemrenderer.PatientSearchListRenderer;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			[Bindable]
			private var model : SchedulerModelLocator = SchedulerModelLocator.getInstance();
			
			private var m_sSearchString:String

			public function get SearchString():String
			{
				return m_sSearchString;
			}

			public function set SearchString(value:String):void
			{
				m_sSearchString = value;
			}

			public function closeHandler():void
			{
				this.removePopup();
			}
			
			public function getListLength():Number{
				
				if(id_SearchList && id_SearchList.dataProvider.length < 5)
				{
					trace( "list hieght: " + id_SearchList.dataProvider.length * 10);
					return id_SearchList.dataProvider.length * 10;					
				}
				else
				{
					return 115;
				}
			} 
			
			public function refreshList(query:String):void
			{
				SearchString = query;
				model.SearchPatientsList.refresh();
			}
			
			public function setListHeight():void
			{
				
				if(id_SearchList && id_SearchList.dataProvider.length < 5)
				{
					trace( "list hieght: " + id_SearchList.dataProvider.length * 25);
					id_SearchList.height= id_SearchList.dataProvider.length * 25;
					id_listBorder.height = (id_SearchList.dataProvider.length * 25) + 15;
				}
				else
				{
					id_SearchList.height= 115;
					id_listBorder.height = 130;
				}
			}
			
			protected function id_SearchList_creationCompleteHandler(event:FlexEvent):void
			{
				setListHeight();
			//	model.lPatientSearchDTOList.filterFunction = filterForData;
				
				id_SearchList.setStyle("useRollOver", true);
				
				
				id_SearchList.setStyle("backgroundColor", 0xFFFFFF );
				id_SearchList.setStyle( "rollOverColor", 0xF7C174 );
				id_SearchList.setStyle( "textRollOverColor", 0x333333 );
				id_SearchList.setStyle( "selectionColor", 0x7c632c ); 
				
			}
			
			private function filterForData(item:Object):Boolean
			{
				var dto:SearchPatientDTO = item as SearchPatientDTO;
				if(dto.FirstName !=null && dto.FirstName.toLowerCase().search( SearchString.toLowerCase() ) != -1 )
					return true;
				if(dto.LastName!=null && dto.LastName.toLowerCase().search( SearchString.toLowerCase() ) != -1 )
					return true;
				if(dto.MiddleName!=null && dto.MiddleName.toLowerCase().search( SearchString.toLowerCase() ) != -1 )
					return true;
				if(dto.QuivusID!=null && dto.QuivusID.toLowerCase().search( SearchString.toLowerCase() ) != -1 )
					return true;
				if(dto.DOB!=null && dto.DOB.toLowerCase().search( SearchString.toLowerCase() ) != -1 )
					return true;
				return false;      
			}
			
			protected function id_SearchList_clickHandler(event:MouseEvent):void
			{
				if( event.target is spark.components.Button )
				{
					event.stopImmediatePropagation();
					return;
				}
				var evt:PatientSelectedEvent = new PatientSelectedEvent("SearchListPatientSelected");
				this.dispatchEvent( evt );
				closeHandler(); 
				
				//see patientExampnael for event
			}

			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void{closeHandler()});
			}

		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:BorderContainer id="id_listBorder" backgroundColor="#cccccc" borderColor="#246D9B" cornerRadius="4" 
					   width="100%" height="100%" minWidth="265">
		<s:layout>
			<s:HorizontalLayout gap="0" paddingTop="0" paddingLeft="2" paddingRight="2"
								paddingBottom="0" verticalAlign="middle" horizontalAlign="left" />
		</s:layout>
	<s:Scroller >
	<s:Group >
	<s:List id="id_SearchList"  width="100%" height="100%" minHeight="280" minWidth="280" dataProvider="{model.SearchPatientsList}" 
			itemRenderer="com.gazuntite.provider.live.services.scheduler.view.itemrenderer.PatientSearchListRenderer" 
			 click="id_SearchList_clickHandler(event)" 
			creationComplete="id_SearchList_creationCompleteHandler(event)"
			
			
			/>		
	</s:Group>
	</s:Scroller>
	</s:BorderContainer>
	<s:Button id="id_CloseBtn"  
			  click="closeHandler()" buttonMode="true" useHandCursor="true" toolTip="Close Patient Search"
			   styleName="closeButtonSkin"/>
	
	
	
</components:PopupGroup>
