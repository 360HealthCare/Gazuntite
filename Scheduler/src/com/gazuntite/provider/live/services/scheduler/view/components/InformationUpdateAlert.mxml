<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" width="350" height="110"
					   xmlns:components="com.gazuntite.controls.extended.components.*" >
	
	
	
	<fx:Script>
		<![CDATA[
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.managers.PopUpManager;
			
			
			
			
			protected function btnUpdate_clickHandler(event:MouseEvent):void
			{
				Alert.show('Coming Soon', 'Update Button Click',4, FlexGlobals.topLevelApplication.mainContainer)
			}
			
			
			protected function enable_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub 
			}
			private function removePopups():void
			{
				PopUpManager.removePopUp(this);
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer width="100%" height="100%" styleName="blackTitleBlueBGContainerSkin" >
	
		<s:Button label="X" right="1" top="-1" width="29"
				  click="removePopups()" toolTip="Close this Alert" styleName="popupCloseButtonSkin"/>
		<s:Button styleName="alertButtonSkin"  x="0" y="-3"/>
		<s:Label x="27" y="1" text="Information Update Alert" fontFamily="Calibri Bold" fontSize="14" color="#FFFFFF"/>
		<components:LabelTextInput prompt="Description" left="6" right="10" top="28" bottom="37"  styleName="optionalTextInputSkin" color="#EDDA8C"/>
		
		<s:CheckBox label="Enable" left="6" bottom="9" toolTip="Enable this Alert"
					change="enable_changeHandler(event)" fontFamily="Calibri" fontSize="12"/>
	
		<s:Button id="btnUpdate" label="Update" width="60" bottom="5"
				  click="btnUpdate_clickHandler(event)"  height="25" right="80" toolTip="Update this Alert"
				   styleName="blackButtonSkin"/>
		<s:Button label="Cancel"  styleName="blackButtonSkin"
				  click="removePopups()" height="25" right="10" toolTip="Cancel this Alert" width="60" bottom="5"/>
		
	</s:SkinnableContainer>
</components:PopupGroup>