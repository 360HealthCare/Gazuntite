				var strModiedAt:String =  dateFormatter2.format(date.toDateString());//+'T'+time.format(date);
				var statusID:int	= 1;
				var RREvent:ManageAppointmentRequestEvent = new ManageAppointmentRequestEvent(data.ID, statusID, model.loggedInUserProviderId, strModiedAt,	'false', model.loggedInUserSelectedBranchId,'', populateRequests);
				CairngormEventDispatcher.getInstance().dispatchEvent( RREvent );
				cursorManager.setBusyCursor(); */
			}
			//Callback function
			/* private function populateRequests(val:* =null):void
			{
				dispatchEvent(new LoadAppointmentEvent('loadAppointmentEvent'));
			} */

		]]>
	</fx:Script>
	<s:Button id="lblData" 
			  label="Reject" horizontalCenter="-0" verticalCenter="0" useHandCursor="true" buttonMode="true"
			  click="lblData_clickHandler(event)" styleName="actionButtonSkin" toolTip="Reject" />
</s:MXDataGridItemRenderer>
