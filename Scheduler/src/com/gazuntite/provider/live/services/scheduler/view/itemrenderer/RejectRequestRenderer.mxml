			[Bindable]
			private var model:SchedulerModelLocator = SchedulerModelLocator.getInstance();
			
			//Button Click handler
			protected function lblData_clickHandler(event:MouseEvent):void
			{
				Alert.show('Do you really want to reject this request ?','Confirmation', Alert.YES | Alert.NO, this, alertCancelListener, null, Alert.OK);
			}
			//************** Alert of yes/No handler *****************************
			private function alertCancelListener(eventObj:CloseEvent):void
			{
				if (eventObj.detail == Alert.YES) 
				{
					rejectRequest();
				}else
				{
					return;
				}
			}
			//On click ok from Alert
			protected function rejectRequest():void
			{
				model.RejectionReason 	= '';
				model.SelectedRequestID = data.ID;
				dispatchEvent(new Event('rejectionViewOpenEvent', true, true));
				
