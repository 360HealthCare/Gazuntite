			private function isInvalid() : Boolean 
			{
				var isNotValid:Boolean = false;
				
				Trim(taCompleint);
				
				var errorStr:String = ""; 
				var toSetFocus:Object;
				//Appointment Type 
				if (!isValidValueSelected(cmbType))
				{
					isNotValid = true;
					errorStr += "The data in appointment type is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbType;
				}
				
				// Appointment date
				if (!cmbDate.selectedDate && cmbDate.text.length == 0)
				{
					isNotValid = true;
					errorStr += "The data in appointment date is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbDate;
				}
				
				//Appointment Start Time
				if (!isValidValueSelected(cmbStartTime))
				{
					isNotValid = true;
					errorStr += "The data in start time is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbStartTime;
				}
				//Appointment End Time
				if (!isValidValueSelected(cmbEndTime))
				{
					isNotValid = true;
					errorStr += "The data in end time is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbEndTime;
				}
				// Appointment Provider
				if (!isValidValueSelected(cmbProvider))
				{
					isNotValid = true;
					errorStr += "The data in provider is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbProvider;
				}
				// Appointment location
				if (!isValidValueSelected(cmbLocation))
				{
					isNotValid = true;
					errorStr += "The data in location is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbLocation;
				}
				//Appointment Status
				if (!isValidValueSelected(cmbStatus))
				{
					isNotValid = true;
					errorStr += "The data in status is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = cmbStatus;
				}
				// Appointment complaint
				if (taCompleint.text.length >= 1 && taCompleint.text.length <= 100)
				{
					if (taCompleint.text.length <= 1 || taCompleint.text.length >= 101)
					{
						isNotValid = true;
						errorStr += "The data in complaint is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = taCompleint;
					}
				}
				else
				{
					isNotValid = true;
					errorStr += "Please enter data in complaint.\n";
					
					if (!toSetFocus)
						toSetFocus = taCompleint;
				}
				
				
				if (isNotValid && errorStr.length)
					Alert.show(errorStr, "Patient Registration Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
				
				return isNotValid;
			}
			//********************** Validate the start and End time ************************************************		
			private function isAppTimeinValid():Boolean
			{
				var strdate:String = cmbDate.text;
				var arrdate:Array = new Array();
				arrdate = strdate.split('-', strdate.length);
				var strSTime:String = cmbStartTime.selectedItem.StartTime;
				var strETime:String = cmbEndTime.selectedItem.EndTime;
				var arrSTime:Array = new Array();
				var arrETime:Array = new Array();
				strSTime = strSTime.substr(0,5);
				strETime = strETime.substr(0,5);
				arrSTime = strSTime.split(':', 5);
				arrETime = strETime.split(':', 5);
				
				var sD:Date = new Date(arrdate[2], arrdate[0], arrdate[1], arrSTime[0], arrSTime[1]);//Date(2011, 12, 20, 09, 15);
				var eD:Date = new Date(arrdate[2], arrdate[0], arrdate[1], arrETime[0], arrETime[1]);
				
				return schedularUtils.comapreTime(sD, eD);
			}
			//************* validate for duplicate appointment ************************************************
			private function checkDuplicateAppointment(userID:String, patientID:String, date:String, startTime:String, endTime:String, stationID:String):Boolean
			{
				var isMatched:Boolean = false;
				if(model.AllAppointmentList.length > 0)
				{
					for(var i:uint =0; i< model.AllAppointmentList.length; i++)
					{
						var strDate:String  = date;	strDate = strDate.substr(0,10);
						var strDate2:String  = model.AllAppointmentList[i].Date;	strDate2 = strDate2.substr(0,10);
						if( userID     == model.AllAppointmentList[i].UserID && 
							patientID == model.AllAppointmentList[i].Patient.ID &&
							strDate		  == strDate2       &&
							startTime  == model.AllAppointmentList[i].StartTime  &&
							endTime	  == model.AllAppointmentList[i].EndTime    &&
							stationID  == model.AllAppointmentList[i].StationID)
						{
							/* trace(userID    +' == '+ model.AllAppointmentList[i].UserID ,
							patientID    +' == '+model.AllAppointmentList[i].QuivusID,
							strDate        +' == '+ model.AllAppointmentList[i].Date,
							startTime   +' == '+ model.AllAppointmentList[i].StartTime,
							endTime	   +' == '+ model.AllAppointmentList[i].EndTime,
							stationID   +' == '+ model.AllAppointmentList[i].StationID); */
							isMatched =  true;
						}
					}
				}
				return isMatched;
			}
