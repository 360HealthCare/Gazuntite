				var loc:Point 			= this.localToGlobal( pLoc );
				SearchListView.x 		= loc.x; 
				SearchListView.y 		= loc.y;
				
				SearchListView.addEventListener( "SearchListPatientSelected", OnItemClick);
				SearchListView.ShowPopup( this );
			}
