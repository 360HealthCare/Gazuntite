			private function createAppointment():void
			{
				//validateAppointForm();
				//if(isValid)
				//{
				if(isAppTimeinValid()){
					Alert.show('Start Time must before End Time', 'Invalid Appointment Time',4, FlexGlobals.topLevelApplication.mainContainer);
					cmbStartTime.setFocus();
					return;
				} 
				
				var date:Date = new Date();
				var mAppointmentDto:AppointmentDTO 		= new AppointmentDTO();
				mAppointmentDto.ID						= String(0);
				mAppointmentDto.StationID				= cmbLocation.selectedItem.ID; 
				mAppointmentDto.StationName				= cmbLocation.selectedItem.Name;
				mAppointmentDto.RequestID				= String(0);;
				mAppointmentDto.Date					= dateFormatter2.format(cmbDate.text)+'T'+time.format(date);
				mAppointmentDto.StartTime				= cmbStartTime.selectedItem.StartTime;
				mAppointmentDto.EndTime					= cmbEndTime.selectedItem.EndTime;
				mAppointmentDto.ClinicID				= model.loggedInUserSelectedBranchId.toString();
				mAppointmentDto.UserID					= cmbProvider.selectedItem.UserID;
				mAppointmentDto.FirstName				= cmbProvider.selectedItem.FirstName;
				mAppointmentDto.MiddleName				= '';
				mAppointmentDto.LastName				= cmbProvider.selectedItem.LastName;
				mAppointmentDto.ChiefComplaint			= StringUtil.trim(taCompleint.text);
				mAppointmentDto.CreatedBy				= model.loggedInUserProviderId.toString();
				mAppointmentDto.CreatedAt				= dateFormatter2.format(date.toDateString())+'T'+time.format(date);
				mAppointmentDto.ModifiedBy				= model.loggedInUserProviderId.toString();
				mAppointmentDto.ModifiedAt				= dateFormatter2.format(date.toDateString())+'T'+time.format(date);
				mAppointmentDto.IsDeleted				= SchedulerConstant.FALSE;
				mAppointmentDto.Alert					= SchedulerConstant.NO;
				mAppointmentDto.QuivusID				= model.SelectedPatient.QuivusID;
				mAppointmentDto.LastVisit				= model.SelectedPatient.LastVisit;
				
				mAppointmentDto.Type.ID					= cmbType.selectedItem.ID;
				mAppointmentDto.Type.Name				= cmbType.selectedItem.Name;
				
				mAppointmentDto.Action.ID				= cmbStatus.selectedItem.ID;
				mAppointmentDto.Action.Name				= cmbStatus.selectedItem.Name;
				mAppointmentDto.Action.NextAction		= cmbStatus.selectedItem.NextAction;
				
				mAppointmentDto.Patient.ID				= model.SelectedPatient.ID;
				mAppointmentDto.Patient.FirstName		= model.SelectedPatient.FirstName;
				mAppointmentDto.Patient.MiddleName		= model.SelectedPatient.MiddleName;
				mAppointmentDto.Patient.LastName		= model.SelectedPatient.LastName;
				
				//Check if the Patient on the same day with Same Provider, 
				//provide validation message to confirm that the appointment is already scheduled for that Patient on same day
				if(checkDuplicateAppointment(String(cmbProvider.selectedItem.UserID), String(model.SelectedPatient.ID), 
					String(dateFormatter3.format(cmbDate.text)), String(cmbStartTime.selectedItem.StartTime), 
					String(cmbEndTime.selectedItem.EndTime), String(cmbLocation.selectedItem.ID)))
				{
					Alert.show('Appointment is already created for this patient'+'\n'+ 'with same Provider', 'Already Scheduled Appointment',4, FlexGlobals.topLevelApplication.mainContainer);
					return;
				}
				var appointmentXML:XML = mAppointmentDto.ToXML(mAppointmentDto)
				//	trace('New Appointment XML --------- >>>> ', appointmentXML.toXMLString());
				//call ManageAppointment Service
				var MAPPEvent:ManageAppointmentEvent = new ManageAppointmentEvent(appointmentXML, cmbProvider.selectedItem.ID, cmbProvider.selectedItem.UserID, callRefeshAppointments );
				CairngormEventDispatcher.getInstance().dispatchEvent(MAPPEvent);
				CursorManager.setBusyCursor();
				removePopups();
				/* }else
				{
				shakeEffect.play();
				
				} */
			}
