			//Search the patient on base of enterd text and validate it 
			//Then dispatch event and show list of match result
			private function searchPatientAndDisplay():void
			{
				if( id_patientSearchTextInput.text.length < 2 )
				{
					//model.patientSearchPageNo = 1;
					if( SearchListView )
					{
						SearchListView.removePopup();
					}
					return;
				}
				var dispatchSearchEvent:Boolean = false;
				var tok:Array
				var searchString:String = id_patientSearchTextInput.text;
				var num:Number = new Number( id_patientSearchTextInput.text.substr( 0, 2 ) );// as Number;
				//search every thing on server ... shamsi requested ---- tj
				while( searchString.indexOf( "/" ) != -1 )
					searchString = searchString.replace( "/", "-" );
				
				//Call SearchPatient Service
				var pseEvent : SearchPatientEvent = new SearchPatientEvent(model.loggedInUserSelectedBranchId, model.loggedInUserProviderId, 3, searchString, 1, showSuggestPopup );
				
				//return; //search every thing on server ... shamsi requested ---- tj
				
				if( ! isNaN( num ) )
				{
					if( searchString.charAt(2) == '-' )//	its a DOB,			date format MM-DD-YY
					{
						//	trace( "length",searchString.length );
						if(searchString.length >= 8)
							dispatchSearchEvent = true;
						else
							return;
					}
					else if( searchString.charAt(2) == '/' )//   its a DOB,       date format MM/DD/YYYY
					{
						//	trace( "length",searchString.length );
						if(searchString.length >= 8)
						{
							while( searchString.search( "/" ) != -1 )
							{
								searchString = searchString.replace( new RegExp( "/", "i" ), "-" );
							}
							
							dispatchSearchEvent = true;
						}
						else
							return;
					}
					else if( searchString.charAt(3) == '-' ) // its ssn with hyphen format XXX-XX-XXXX
					{
						//	trace( "length",searchString.length );
						if( searchString.length == 11 )
							dispatchSearchEvent = true;
						else
							return;
					}
					else if(searchString.length >= 6 && searchString.length <= 10)// its a i) date MMDDYY or MMDDYYYY  or ii) ssn without hyphen format XXXXXXXXX
						dispatchSearchEvent = true;
					else
						return;
				}
				if( searchString.indexOf( ',' ) != -1 ) // its a Name 			format  Last, First
				{
					tok = searchString.split( ',' );
					if( tok.length == 2 && ( tok[0].length >= 2 || tok[1].length >= 2 ) )
						dispatchSearchEvent = true;
					else
						return;
				}
				else if( searchString.indexOf( ' ' ) != -1 ) // its a Name 			format  First <SPACE> Last OR First <SPACE> Middle <SPACE> Last
				{
					tok = searchString.split( ' ' );
					if( tok.length == 2 ||
						tok.length == 3 )
						dispatchSearchEvent = true;
					else
						return;
				}
				else if( searchString.charAt(0).toLowerCase() == 'q')// its a QID,
				{
					if( searchString.length == 2 )
						return;
					if ( searchString.length >= 3 && searchString.charAt( 2 ) == '-' )
					{
						for( var i:int = 3; i < searchString.length ; i++ )
						{
							num = new Number ( searchString.charAt( i ) );
							if( num > 0 )
								dispatchSearchEvent = true;
						}
					}
				}
				if( searchString.length == 3 ||  searchString.length == 5)
				{
					dispatchSearchEvent = true;
				}
				
				if( dispatchSearchEvent )
				{
					//Call SearchPatient Service
					pseEvent = new SearchPatientEvent(model.loggedInUserSelectedBranchId, model.loggedInUserProviderId, 3, searchString, 1, showSuggestPopup );
					CairngormEventDispatcher.getInstance().dispatchEvent( pseEvent );
					cursorManager.setBusyCursor();
				}
				
				if( SearchListView )
					SearchListView.refreshList( searchString );
				
			}
