<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin 
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:s="library://ns.adobe.com/flex/spark" 
	xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
	blendMode="normal" mouseEnabled="false"
	alpha.disabled="0.5" 
	alpha.disabledWithControlBar="0.5"
	minWidth="76" minHeight="76" 
	>
	<fx:Metadata>[HostComponent("com.gazuntite.controls.extended.components.PopupWindow")]</fx:Metadata>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="inactive" stateGroups="inactiveGroup" />
		<s:State name="disabled" />
		<s:State name="normalWithControlBar" stateGroups="withControls" />
		<s:State name="inactiveWithControlBar" stateGroups="withControls, inactiveGroup" />
		<s:State name="disabledWithControlBar" stateGroups="withControls" />
	</s:states>
	
	<s:BorderContainer left="0" right="0" top="0" bottom="0" 
					   cornerRadius="6" borderWeight="2" borderColor="0x787878" backgroundColor="0xffffff" dropShadowVisible="true">
		<s:Group left="5" right="5" top="5" bottom="5" id="contents">
			<s:layout>
				<s:VerticalLayout gap="0" horizontalAlign="justify" />
			</s:layout>
			<!--- @private -->
			<s:Group height="20">
				<s:Button id="closeButton"
						  skinClass="com.gazuntite.skins.controls.button.blackCloseButtonSkin"
						  right="0" top="0" toolTip="Close" buttonMode="true" useHandCursor="true"/>
			</s:Group>
			
			<s:Group id="contentGroup" width="100%" height="100%" minWidth="0" minHeight="0">
			</s:Group>
			
			<s:Group id="bottomGroup" minWidth="0" minHeight="0" 
					 includeIn="withControls">  
				
				<s:Group id="controlBarGroup" left="0" right="0" top="1" bottom="1" minWidth="0" minHeight="0">
					<s:layout>
						<s:HorizontalLayout paddingLeft="10" paddingRight="10" paddingTop="7" paddingBottom="7" gap="10" />
					</s:layout>
				</s:Group>
			</s:Group>
		</s:Group>
	</s:BorderContainer>
	
</s:SparkSkin>