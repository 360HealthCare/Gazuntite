			private var _pharmacyname:String = '0';
			public var address:String = '0';
			public var zipcode:String = '0';
			public var state:String = '0';
			public var city:String = '0';
			public var phone:String = '0';
			public var fax:String = '0'
			public var serviceLevel:int  = -1;
			public var changelevel:String = "0";
			public var isActivated:Boolean = true;
			
			private var searchTypeCase:int 		= 1;
			// fax:String, serviceLevel:int,  changelevel:String, activated:Boolean
			private var personalPhoneNumbers:ArrayCollection;
			
			[Bindable]
			public function get inSearchPopup():Boolean
			{
				return _inSearchPopup;
			}
			
			public function set inSearchPopup(value:Boolean):void
			{
				_inSearchPopup = value;
			}
			
			[Bindable]
			public function get pharmacyname():String
			{
				return _pharmacyname;
			}
			
			public function set pharmacyname(value:String):void
			{
				_pharmacyname 	= value;
			}
			//--------------- Creation Complete -------------------------------------------
			protected function creComp():void
			{
				if(!model.isSetNewRXView)//only call when New RX is opend from LPS
				{
					var loadStateonlyEvent:LoadStateCodesOnlyEvent = new LoadStateCodesOnlyEvent(loadStateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(loadStateonlyEvent);
				}
			}
			
			//----- call back for LoadStateCodesOnlyEvent -------------------------
			private function loadStateCallBack(arrType:ArrayCollection):void
			{
				if(null != model.stateCodeList)
					model.stateCodeList.removeAll();
				else 
					model.stateCodeList = new ArrayCollection();
				
				model.stateCodeList.addAll(arrType); 
				
				PharmacyFields();
				SearchPharmacies(0);
			}
			//------------- call SearchPharmaciesEvent ---------------------------------
			private function SearchPharmacies(_pageNo:int):void
			{
				var pharmacyEvent: SearchPharmaciesEvent = new SearchPharmaciesEvent(_pageNo, npcid, pharmacyname, address, zipcode, state, city, phone, fax, serviceLevel, changelevel, isActivated, getPharmacies);
				CairngormEventDispatcher.getInstance().dispatchEvent(pharmacyEvent); 
			}
			// ---------- call back SearchPharmaciesEvent ------------------------
			private function getPharmacies():void
			{
				if(id_lblPageNo.text == '0')
					id_lblPageNo.text = (int(id_lblPageNo.text) + 1).toString();
				//resetFields();
				return;	
			}
			//------------ reset fields -------------------
			private function resetFields():void
			{
				/* ti_npcid.text 					= '';
				ti_name.text  					= '';
