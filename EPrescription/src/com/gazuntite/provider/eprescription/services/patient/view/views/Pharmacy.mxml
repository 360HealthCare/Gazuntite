				changelevel     = ti_changeLevel.text;
				isActivated		= id_chActive.selected;
				
				if(ti_npcid.text == "") 
				npcid = "0";
				if(ti_name.text == "") { 
				pharmacyname = "0";
				ti_name.text = "";
