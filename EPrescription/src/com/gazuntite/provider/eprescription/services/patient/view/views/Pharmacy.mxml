				ti_city.text 					= '';
				ti_phone.text 					= '';
				ti_fax.text 					= '';
				ti_servicelevel.selectedIndex 	= -1;
				ti_changeLevel.text 			= '';
				id_chActive.selected 			= false; */
			}
			//--------- select data from Fields -----------------
			public function PharmacyFields():void
			{
				/* npcid 			= ti_npcid.text;
				pharmacyname	= ti_name.text;
				address 		= ti_address.text;
				zipcode  		= ti_zip.text;
				if(null != ti_state.selectedItem)
				state 			= ti_state.selectedItem.StateCode;
