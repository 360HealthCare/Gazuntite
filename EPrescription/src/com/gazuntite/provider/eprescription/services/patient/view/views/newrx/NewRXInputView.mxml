			protected function visitDate_clickHandler(event:MouseEvent):void
			{
				if( selectVisitPopup && selectVisitPopup.isPopUp )
				{
					selectVisitPopup.removePopup();
					return;
				}
				selectVisitPopup = new SelectVisitPopup();
				
				selectVisitPopup.patient_ID = selectedPatient.ID.toString();
				selectVisitPopup.userId = model.LoggedInUserId.toString();
				selectVisitPopup.userId = model.LoggedInUserId.toString();
				selectVisitPopup.CreateVisitAllowed = !IsforInput;
				
				selectVisitPopup.QIVisitDate = QIVisitDate;
				selectVisitPopup.QIVisitID = QIVisitID;
				
				//selectVisitPopup.NASelected = visitDate == 'N/A' ? true : false;
				
				
				selectVisitPopup.ShowPopup( this );
				
				var pt:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
				selectVisitPopup.move( pt.x  - 150, pt.y + event.currentTarget.height  + 5); 
				
				selectVisitPopup.loadSelectedPatientData(selectedPatient, model.LoggedInUserSelectedBranchId.toString());
				
				selectVisitPopup.addEventListener("visitSelected", function(event:Event):void
				{
					encounterID = selectVisitPopup.id_associatedVisit.selectedItem.VisitID;	
					visitDate = selectVisitPopup.id_associatedVisit.selectedItem.VisitDate;	
					
					model.visitID = encounterID;
					model.visitDate = visitDate;
					
					selectVisitPopup.removePopup();
				});
				selectVisitPopup.addEventListener("visitCreated", function(event:Event):void
				{
					encounterID = selectVisitPopup.encounterId;	
					visitDate = AppUtils.getToday();	
					
					model.visitID = encounterID;
					model.visitDate = visitDate;
					
					selectVisitPopup.removePopup();
				});
				
				/* selectVisitPopup.addEventListener("NASelected", function(event:Event):void
				{
					QIVisitID = encounterID;
					QIVisitDate = visitDate;
					
					encounterID = '0';	
					visitDate = 'N/A';	
					
					model.visitID = '0';
					model.visitDate ='';
					
					selectVisitPopup.removePopup();
				}); */
				/* selectVisitPopup.addEventListener("NADeSelected", function(event:Event):void
				{
					encounterID = QIVisitID;
					visitDate = QIVisitDate;
					
					model.visitID = encounterID;
					model.visitDate = visitDate;
					
					selectVisitPopup.removePopup();
				}); */
			}
			
			protected function id_previewBtn_clickHandler(event:MouseEvent):void
			{
				if(id_ChronicMedication.selected)
