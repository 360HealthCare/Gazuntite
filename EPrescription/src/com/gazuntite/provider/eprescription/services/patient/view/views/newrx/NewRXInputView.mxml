			}
			
			protected function id_Prescription_changeHandler(event:Event):void
			{
				//IsforInput = id_Prescription.selected;
				return ;
				
				if(id_Prescription.selected)
				{
					id_pharmacyView.visible = true;
					
					if(selectedPharmacy != null)
					{
						id_medicationSelection.visible = true ;
					}
					else
						id_medicationSelection.visible = false ;
				}
				
				id_MedicineInputView.IsCompletlyFilled();
			}
			
			protected function id_ChronicMedication_changeHandler(event:Event):void
			{
				
				openforChronic = id_ChronicMedication.selected;
				return;
				
				if(id_ChronicMedication.selected)
				{
					id_pharmacyView.visible = false;
					id_medicationSelection.visible = true ;
					
				}
				id_MedicineInputView.IsCompletlyFilled();
			}
			
