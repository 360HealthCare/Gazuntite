			private var comOptionpoup:OptionPopUp;
			protected function uiOptionButton_clickHandler(event:MouseEvent):void
			{
				
				var toggleView:Boolean = null != comOptionpoup;
				
				removeAllPopups();
				
				if(toggleView )
				{
					return;
				}
				
				comOptionpoup = new OptionPopUp();
				comOptionpoup.ShowPopup( this );
				
				comOptionpoup.addEventListener("ClosePopup", function(closeevent:Event):void 
				{ 
					removeAllPopups();
				});
				
				var pt:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
				
				comOptionpoup.move( pt.x - comOptionpoup.width + 25, pt.y + 25 ); 
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
			public function removeAllPopups():void
			{
				if( comOptionpoup && comOptionpoup.isPopUp )
				{
					comOptionpoup.removePopup();
					comOptionpoup = null;
					uiOptionButton.selected = false;
				}
			}
			
			[Bindable]
			public var PharmNotes:String = '';
			public function LoadRXMedicationDTO(DTO:MedRXDTO):void
			{
				
				/* selectedPatient = new PatientDTO();
				selectedPatient.GAXENID = DTO.GaxenPatientID;
				selectedPatient.FirstName = DTO.FirstName;
				selectedPatient.LastName = DTO.LastName;
				selectedPatient.Gender = DTO.Gender;
				selectedPatient.DOB = DTO.DOB; */
				
				
				selectedPharmacy = new PharmaciesResult();
				selectedPharmacy.NCPDPID = DTO.NCPDPID;
				selectedPharmacy.Phone = DTO.PharmPhone;
				selectedPharmacy.StoreNumber = DTO.PharmName;
				selectedPharmacy.AddressLine1 = DTO.PharmAddress;
					
				tempRefrenceNo = DTO.ReferenceNumber;
				id_MedicineInputView.loadStaticData()
				selectedMedicine = new MedicineDTO();
				selectedMedicine.LoadMedDTO(DTO);
				
				id_MedicineInputView.GeneratedSig = DTO.SIG;
				
				PharmNotes = DTO.Notes;
				
				selectedPatientPhone = DTO.Phone;
				selectedPatientAddress = DTO.Address;
				
				id_MedicineInputView.LoadMedicineValues(DTO);
				
				
				id_medicationGroup.visible = true;
				id_medicationGroup.includeInLayout = true;
				
				id_PlusButtonBtn.visible = true;
				id_PlusButtonBtn.includeInLayout = true;
				
				
				
			}
		]]>
