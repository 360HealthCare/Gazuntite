								  ><!--visible="{null != selectedPharmacy }" includeInLayout="{id_medicationSelection.visible}"-->
				<s:layout>
					<s:HorizontalLayout paddingRight="3" paddingLeft="0" verticalAlign="middle"/>
				</s:layout>
				
				<newrx:MedicineSelectionView id="id_MedicineSelectionView" selectedMedicine="{selectedMedicine}" width="100%" enabled="{selectedPatient != null}"  />
				
				<s:HGroup  verticalAlign="middle" height="28" >
					<s:Label text="Visit Date : " color="#666666" fontFamily="CalibriCFF" fontSize="15"/>
					<s:Label text="{visitDate}" color="#666666" fontFamily="CalibriCFF" fontSize="15" toolTip="{visitDate}"/>
					<s:Image id="id_visitBtn" 
							 click="visitDate_clickHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Select Visit Date"
							 source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/visitdatecal.png')"/>
				</s:HGroup>
			</s:SkinnableContainer>
			
			<s:VGroup width="100%" id="id_medicationGroup" visible="{null != selectedMedicine &amp;&amp; id_MedicineSelectionView.visible}" includeInLayout="{id_medicationGroup.visible}" paddingTop="-4" gap="-1">
				
				<newrx:MedicineInputView id="id_MedicineInputView"  width="100%" isChronic="{openforChronic}" />
				
				<s:SkinnableContainer width="100%" height="40" skinClass="com.gazuntite.skins.controls.container.ePrescription.RxInputViewRoundBg">
					<s:layout>
						<s:HorizontalLayout verticalAlign="top" paddingBottom="3" paddingLeft="4" paddingRight="4" paddingTop="4" />
					</s:layout>
					<s:BorderContainer borderColor="#4987DF" backgroundColor="#4987DF" cornerRadius="3" height="19">
						<s:Label text="sig" fontFamily="CalibriCFF" fontSize="15" color="0xFFFFFF" horizontalCenter="0" verticalCenter="0" />
					</s:BorderContainer>
					<components1:LabelTextArea id="id_SIG" maxChars="140"
											   width="100%" height="100%" skinClass="com.gazuntite.controls.extended.skins.transparentTextAreaSkin"
											   text="{id_MedicineInputView.GeneratedSig}" toolTip="{id_MedicineInputView.GeneratedSig}"   
											   fontFamily="CalibriCFF" fontSize="14" />
				</s:SkinnableContainer>
				
				
				<s:HGroup width="100%" id="id_addSend" visible="false" includeInLayout="false"><!--visible="{id_MedicineInputView.isComplete}" includeInLayout="{id_addSend.visible}" visible="false" includeInLayout="false"-->
					<s:Button label="Send" click="send_clickHandler(event)" />
					<s:Spacer width="100%" />
					<s:Button label="Add" click="add_clickHandler(event)" />
				</s:HGroup>
				
				<s:Spacer height="5" />
				
				<s:HGroup width="100%" height="40" id="id_previewView" horizontalAlign="right"> <!--visible="{id_medicationGroup.visible}" includeInLayout="{id_previewView.visible}"-->
					<s:BorderContainer width="100%" height="100%" backgroundColor="#FDEF9F" borderColor="#B6B485" cornerRadius="5" includeInLayout="{id_Prescription.selected}" visible="{id_Prescription.selected}">
						<s:layout>
							<s:HorizontalLayout verticalAlign="top" paddingBottom="3" paddingLeft="4" paddingRight="4" paddingTop="4"/>
						</s:layout>
						
						<s:BorderContainer borderColor="#4987DF" backgroundColor="#4987DF" cornerRadius="3" height="19" width="85">
							<s:Label text="pharmacist" fontFamily="CalibriCFF" fontSize="15"  color="#FFFFFF"  horizontalCenter="0" verticalCenter="0" />
						</s:BorderContainer>
						
						<components1:LabelTextArea id="id_pharmacyNote" text="@{PharmNotes}"
												   width="100%" height="100%" maxChars="210"
												   skinClass="com.gazuntite.controls.extended.skins.transparentTextAreaSkin"
												   fontFamily="CalibriCFF" fontSize="14" bottom="0"/>
					</s:BorderContainer>
					
					<s:HGroup height="100%" horizontalAlign="right">
						<s:Button id="id_previewBtn"  enabled="{(id_MedicineInputView.isFormComplete)  &amp;&amp; id_MedicineSelectionView.id_selectMedicineVS.selectedIndex == 1}" includeInLayout="{id_Prescription.selected}" visible="{id_Prescription.selected}"
								  click="id_previewBtn_clickHandler(event)" 
								  buttonMode="true" useHandCursor="true" toolTip="Preview Summary" skinClass="com.gazuntite.skins.controls.button.ePrescription.PreviewButtonSkin"
								  fontFamily="CalibriCFF" fontSize="14" bottom="0"/>
						
						<s:Button id="id_PlusButtonBtn" label="Plus"  
								  enabled="{(id_MedicineInputView.isFormComplete)  &amp;&amp; id_MedicineSelectionView.id_selectMedicineVS.selectedIndex == 1}" 
								  click="id_previewBtn_clickHandler(event)" 
								  includeInLayout="false" visible="false"
								  buttonMode="true" useHandCursor="true" toolTip="Add Medication"
								  fontFamily="CalibriCFF" fontSize="14" bottom="0"
								  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"
								  /><!-- includeInLayout="{id_ChronicMedication.selected &amp;&amp; !IsforInput}" 
								  visible="{id_ChronicMedication.selected &amp;&amp; !IsforInput}"-->
					</s:HGroup>
				</s:HGroup>
			</s:VGroup>	
		</s:VGroup>
	</s:Scroller>
	
</s:VGroup>
