	<s:HGroup id="id_forChronic" width="100%" verticalAlign="top" gap="3" includeInLayout="{id_forChronic.visible}">
		
		<newrx:PatientSelectionView  id="id_PatientSelectionView" selectedPatient="{selectedPatient}" width="50%" AllowSearch="{!IsforInput}"/>
		
		<pharmacy:PharmacyView id="id_pharmacyView" width="40%" visible="{id_Prescription.selected &amp;&amp; !IsforInput }"  selectedPharmacy="{selectedPharmacy}" enabled="{selectedPatient != null}" selectedPatient="{selectedPatient}"/>
		
		<s:VGroup width="125" id="id_optionView" verticalAlign="top" horizontalAlign="right" paddingTop="4">
			
			<s:HGroup width="100%" horizontalAlign="right" verticalAlign="middle" gap="2">
				
				<s:SkinnableContainer width="76" height="20" skinClass="com.gazuntite.skins.controls.container.BlueRadioButtonBG" >
					<s:layout>
						<s:HorizontalLayout verticalAlign="middle" gap="0" horizontalAlign="center"/>
					</s:layout>
					<s:RadioButton id="id_Prescription" label="P" value="ByPrescription" fontSize="15"
								   groupName="rbGroup" buttonMode="true" useHandCursor="true" toolTip="Prescription"
								   skinClass="com.gazuntite.skins.controls.radioButton.RadioButtonRXSkin"
								   change="id_Prescription_changeHandler(event)" selected="@{openforPresprection}"
								   /><!-- -->
					<s:RadioButton id="id_ChronicMedication" label="C" value="ChronicMedication" fontSize="15"
								   groupName="rbGroup" buttonMode="true" useHandCursor="true" toolTip="Chronic Medication"
								   skinClass="com.gazuntite.skins.controls.radioButton.RadioButtonChronic"
								   change="id_ChronicMedication_changeHandler(event)" selected="@{openforChronic}"
								   /><!---->
				</s:SkinnableContainer>
				
				<s:ToggleButton id="uiOptionButton"
								skinClass="com.gazuntite.skins.controls.toggleButtonSkin.OptionToggleButton"
								buttonMode="true" toolTip="More Options" 
								click="uiOptionButton_clickHandler(event)"/><!--selected="@{newRXDictationNoteViewModel.visible}"-->
				<s:Button
					click="{dispatchEvent(new FlipViewEvent())}"
					verticalCenter="0" skinClass="com.gazuntite.skins.controls.button.FlipViewButtonSkin"
					buttonMode="true" useHandCursor="true" toolTip="Flip the View"/>
			</s:HGroup>
			
		</s:VGroup>
		
	</s:HGroup>
	
