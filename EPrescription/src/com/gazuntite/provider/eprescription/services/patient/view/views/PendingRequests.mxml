	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout  gap="1"/>
	</s:layout>
	
	<s:BorderContainer width="100%" backgroundColor="#707981" borderColor="#707981" >
		<s:layout>
			<s:HorizontalLayout  verticalAlign="middle" paddingLeft="5" paddingRight="5"/>
		</s:layout>
		<s:BorderContainer borderColor="#FFFFFF" backgroundColor="#FFFFFF" cornerRadius="4" width="50%" height="23">
			
			<s:Group left="0" verticalCenter="0">
				<s:DropDownList id="id_searchType"
								labelField="label" 
								requireSelection="true"
								skinClass="com.gazuntite.skins.controls.combobox.CustomDropDownListSkin"
								itemRenderer="spark.skins.spark.DefaultComplexItemRenderer"	
								width="1" height="1" left="0"
								change="searchType_changeHandler(event)" 
								>
					<s:dataProvider>
						<s:ArrayList>
							<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/patient.png')" />
							<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/pharmacy.png')" />
							<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/provider.png')" />
						</s:ArrayList>
					</s:dataProvider>
				</s:DropDownList>
				<s:Image id="id_image" 
						 width="30" height="19" source="{selected_name}" left="0" click="id_image_clickHandler(event)" buttonMode="true" useHandCursor="true" />
			</s:Group>
			<components:LabelTextInput id="id_pharmacy" 
									   height="100%"  borderColor="#333333" borderVisible="false" borderAlpha="0" verticalCenter="0"
									   focusAlpha="0" left="30" right="20"
									   prompt="Patient" restrict="[A-Z a-z , . / \- 0-9]" fontSize="14"
									   keyUp="textInput_keyUpHandler(event)"
									   click="textInput_clickHandler(event)"  
									   change="id_pharmacy_changeHandler(event)"
									   skinClass="com.gazuntite.controls.extended.skins.transparentTextInputSkin"
									   toolTip="Search Pending Request"/>
			<s:Image id="id_search"
					 buttonMode="true" useHandCursor="true" toolTip="Search" right="2" verticalCenter="0"
					 source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/pe_search_selected.png')"/>
		</s:BorderContainer>
		<s:Spacer width="100%" />
		
		<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.ePrescription.PagingBackgroundSkin">
			<s:layout>
				<s:HorizontalLayout gap="0" horizontalAlign="center" verticalAlign="middle"/>
			</s:layout>
			
			<s:Button id="id_showPharmaciesPrev"  
					  skinClass="com.gazuntite.skins.controls.button.ePrescription.PreviousPageButton" 
					  buttonMode="true" toolTip="Previous" tabIndex="13"/>
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Label id="id_lblPageNo"   text="01" fontFamily="CalibriCFF" color="#FFFFFF" fontSize="13" width="18" textAlign="center"/>
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Button id="id_showPharmacies" 
					  buttonMode="true" toolTip="Next" tabIndex="14"
					  skinClass="com.gazuntite.skins.controls.button.ePrescription.NextPageButton"/>
		</s:SkinnableContainer>
		
		
	</s:BorderContainer>
	
	<s:SkinnableContainer id="id_ListHeader" width="100%" height="29" skinClass="com.gazuntite.skins.controls.container.ePrescription.RxHeaderSkin">
		<s:layout>
			<s:HorizontalLayout horizontalAlign="left" verticalAlign="middle" />
		</s:layout>
		
		<s:Label width="25%" text="Patient" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="4" />
		<s:Line height="100%">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		<s:Label width="25%" text="Prescriber" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="4" />
		<s:Line height="100%">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		<s:Label width="25%" text="SIG" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="6" />
		<s:Line height="100%">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		<s:Label width="25%" text="Actions" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="6" />
	</s:SkinnableContainer>
	
	<s:List id="id_pendingRequestList"  
			dataProvider="{model.PendingRequestList}"
			width="100%" height="100%"
			allowMultipleSelection="false"
			skinClass="com.gazuntite.skins.controls.list.TransparentInvisibleFullScrollSkin"
			borderVisible="false"
			creationComplete="id_pendingRequestList_creationCompleteHandler(event)"
			itemRenderer="com.gazuntite.provider.eprescription.services.patient.view.views.pendingRequest.PendingRequestIR" />
</s:Group>
