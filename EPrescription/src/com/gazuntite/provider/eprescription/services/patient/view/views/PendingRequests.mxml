			// Label function patient name
			private function getPatientName(oItem:Object,iCol:int):String
			{
				var result:String = '';
				if(oItem.pharmacyPatientDTO.FirstName)
					result = oItem.pharmacyPatientDTO.FirstName;
				
				if(oItem.pharmacyPatientDTO.LastName)
					result =result+' '+ oItem.pharmacyPatientDTO.LastName;
				
				return result;
			}
			// Label function Prescriber name
			private function getPrescriberName(oItem:Object,iCol:int):String
			{
				var result:String = '';
				if(oItem.prescriberDTO.FirstName)
					result = oItem.prescriberDTO.FirstName;
				
				if(oItem.prescriberDTO.LastName)
					result =result+' '+ oItem.prescriberDTO.LastName;
				
				return result;
			}
			
			protected function id_pendingRequestList_creationCompleteHandler(event:FlexEvent):void
			{
				id_pendingRequestList.addEventListener("DentPrescriptionBtnClicked",deniedNewPrescriptionto_ClickHandler);
				id_pendingRequestList.addEventListener("ApproveChangeBtnClicked",approveWithChange_clickHandler);
				id_pendingRequestList.addEventListener("ApproveBtnClicked",approve_ClickHandler);
				id_pendingRequestList.addEventListener("DenyBtnClicked",deny_clickHandler);
			}
			
			protected function textInput_keyUpHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER)
				{
					//Search();
				}
			}
			
			protected function textInput_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();				
			}
			
			protected function id_pharmacy_changeHandler(event:TextOperationEvent):void
			{
				if(id_pharmacy.text.length == 3)
				{
					//Search();
				}
			}
			protected function searchType_changeHandler(event:IndexChangeEvent):void
			{
				switch(id_searchType.selectedIndex)
				{
					case 0:
						id_pharmacy.prompt = 'Patient';
						id_image.source = selected_name;
						break;
					case  1:
						id_pharmacy.prompt = 'Pharmacy';
						id_image.source = selected_name;
						break;
					case 2:
						id_pharmacy.prompt = 'Provider';
						id_image.source = selected_name; 
						break;
				}
			}	
			
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/name_selected.png")]
			[Bindable]	public var selected_name:Class;
			
			protected function id_image_clickHandler(event:MouseEvent):void
			{
				id_searchType.openDropDown();
				event.stopImmediatePropagation();
			}
			
