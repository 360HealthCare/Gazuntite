			public var approveSummary:SummaryPopUp;//RXRefillApproveSummary;
			public var denypopup:NewRXRefillDenyPopup;
			public var denyNewPrescriptionPopup:NewDenyNewPrescriptionPopup;
			
			// **************** GETTER & SETTER ************** STRAT *************
			[Bindable]
			public function get securityHeaderXML():XML
			{
				return _securityHeaderXML;
			}
			
			public function set securityHeaderXML(value:XML):void
			{
				_securityHeaderXML = value;
			}
			
			[Bindable]
			public function get userId():String
			{
				return _userId;
			}
			
			public function set userId(value:String):void
			{
				_userId = value;
			}
			// **************** GETTER & SETTER ************** END *************
			
			// Ceation complete handler
			protected function creComp():void
			{
				securityHeaderXML	 			= <Header />;					
				securityHeaderXML.@EUserName	= "TESTUSER";
				securityHeaderXML.@EPassword	= "TESTPASS";
				securityHeaderXML.@ClinicID		= "sad";
				
				var rpEvent_ : GetPendingRefillsEvent = new GetPendingRefillsEvent();	
				rpEvent_.data = securityHeaderXML;
				CairngormEventDispatcher.getInstance().dispatchEvent( rpEvent_ );  
			}
			// Open deny summary popup
			private function createDenySummaryReport():void
			{
				
				/* summary = new SummaryPopUp()
				summary.height = this.height - 25;
				summary.width = this.width + 10;
				
				summary.URL = queryStr;
				
				var pt:Point = new Point(this.x, this.y);
				var loc:Point = localToGlobal( pt );
				summary.move( loc.x - 5  , loc.y -5 ); 
				
				summary.ShowPopup(this); */
				
				
				denypopup  							= new NewRXRefillDenyPopup();
				denypopup.height 					= this.height;
				denypopup.width 					= this.width; 
				var pLoc:Point 						= new Point( this.x , this.y );
				var loc:Point 						= this.localToGlobal( pLoc );
				denypopup.move( loc.x  , loc.y );
				denypopup.Status					= "2";
				denypopup.GaxenRefillRequestID		= model.selectedApproveRefillRequest.GaxenRefillRequestID;
				denypopup.securityHeaderXML 		= securityHeaderXML;
				denypopup.ShowPopup(this);
			}
			// Open approve summary poopup
			private function createApproveSummaryReport():void
			{
				approveSummary  					= new SummaryPopUp();
				
				approveSummary.height = this.height;
				approveSummary.width = this.width;
				approveSummary.URL = "http://beta.quivus.com/Eprescriptionstagging/Reports/SummaryView/View/summaryview2.html";
				var pLoc:Point 						= new Point( this.x , this.y );
				var loc:Point 						= this.localToGlobal( pLoc );
				approveSummary.x 					= loc.x ; 
				approveSummary.y 					= loc.y ;				
				/* approveSummary.GaxenRefillRequestID	= model.selectedApproveRefillRequest.GaxenRefillRequestID;
				approveSummary.securityHeaderXML 	= securityHeaderXML; */
				approveSummary.ShowPopup(this);
			}
			// Approve change click handler
			private function createApproveChangesSummaryReport():void
			{
				approveSummary  					= new SummaryPopUp();
				
				approveSummary.height = this.height;
				approveSummary.width = this.width;
				approveSummary.URL = "http://beta.quivus.com/Eprescriptionstagging/Reports/SummaryView/View/summaryview2.html";
				//approveSummary.isApproveChangeCase 		= true;
				var pLoc:Point 							= new Point( this.x , this.y );
				var loc:Point 							= this.localToGlobal( pLoc );
				approveSummary.x 						= loc.x ; 
				approveSummary.y 						= loc.y ;				
				/* approveSummary.GaxenRefillRequestID		= model.selectedApproveRefillRequest.GaxenRefillRequestID;
				approveSummary.securityHeaderXML 		= securityHeaderXML; */
				approveSummary.ShowPopup(this);
			}
			// Deny new prescription open popup
			private function createDeniedNewPrescriptionton(selectedDto:PendingRefillRequestDTO):void
			{
				denyNewPrescriptionPopup 						= new NewDenyNewPrescriptionPopup();
				denyNewPrescriptionPopup.height = this.height;
				denyNewPrescriptionPopup.width = this.width;
				var pLoc:Point 									= new Point( this.x , this.y );
				var loc:Point 									= this.localToGlobal( pLoc );
				denyNewPrescriptionPopup.x 						= loc.x ; 
				denyNewPrescriptionPopup.y 						= loc.y ;				
				denyNewPrescriptionPopup.securityHeaderXML 		= securityHeaderXML;
				
				denyNewPrescriptionPopup.selectedPatient = GetPatientDTO(selectedDto);
				denyNewPrescriptionPopup.selectedPharmacy = GetPharmacyDTO(selectedDto);
				
				denyNewPrescriptionPopup.ShowPopup(this);
			}
			
			private function GetPatientDTO(DTO:PendingRefillRequestDTO):PatientDTO
			{
				var patient:PatientDTO = new PatientDTO();
				patient.FirstName = DTO.pharmacyPatientDTO.FirstName;
				patient.LastName = DTO.pharmacyPatientDTO.LastName;
				patient.DOB = DTO.pharmacyPatientDTO.DOB;
				patient.GAXENID = DTO.pharmacyPatientDTO.GaxenPatientID;
				patient.Gender = DTO.pharmacyPatientDTO.Gender;
				patient.SSN = DTO.pharmacyPatientDTO.SSN;
				patient.RecGuid = QSConstants.GUID_FORMAT; // this should come from backend.
				
				return patient;
			}
			
			private function GetPharmacyDTO(DTO:PendingRefillRequestDTO):PharmaciesResult
			{
				var pharmacy:PharmaciesResult = new PharmaciesResult();
				
				pharmacy.StoreName = DTO.pharmacyDTO.StoreName;
				pharmacy.AddressLine1 = DTO.pharmacyDTO.AddressLine1;
				pharmacy.NCPDPID = DTO.pharmacyDTO.NCPDPID;
				pharmacy.PharmaciesID  = int(DTO.pharmacyDTO.PharmaciesID);
				pharmacy.Phone = DTO.pharmacyDTO.PhonePrimary;
				pharmacy.rownum = DTO.pharmacyDTO.rownum;
				pharmacy.Zip = DTO.pharmacyDTO.Zip;
				
				return pharmacy;
			}
			// Deny NewPrescriptionto changes click handler
			public function deniedNewPrescriptionto_ClickHandler(event:MouseEvent):void
			{
				var selectedDTO:PendingRefillRequestDTO = new PendingRefillRequestDTO();
				selectedDTO = (id_pendingRequestList.dataProvider as ArrayCollection).getItemAt(id_pendingRequestList.selectedIndex) as PendingRefillRequestDTO;
				
				createDeniedNewPrescriptionton(selectedDTO);
			}
			// Approve with changes click handler
			public function approveWithChange_clickHandler(event:MouseEvent):void
			{
				model.selectedApproveRefillRequest = new PendingRefillRequestDTO();
				model.selectedApproveRefillRequest = (id_pendingRequestList.dataProvider as ArrayCollection).getItemAt(id_pendingRequestList.selectedIndex) as PendingRefillRequestDTO;
				createApproveChangesSummaryReport();
			}
			// Approve Click handler
			public function approve_ClickHandler(event:MouseEvent):void
			{
				model.selectedApproveRefillRequest = new PendingRefillRequestDTO();
				model.selectedApproveRefillRequest = (id_pendingRequestList.dataProvider as ArrayCollection).getItemAt(id_pendingRequestList.selectedIndex) as PendingRefillRequestDTO;;
				if(model.selectedApproveRefillRequest.pharmacyPatientDTO.GaxenPatientID != '')
				{
					
				}
				createApproveSummaryReport();
			}
			// Deny button click Handler
			public function deny_clickHandler(event:MouseEvent):void
			{
				model.selectedApproveRefillRequest = new PendingRefillRequestDTO();
				model.selectedApproveRefillRequest = (id_pendingRequestList.dataProvider as ArrayCollection).getItemAt(id_pendingRequestList.selectedIndex) as PendingRefillRequestDTO;;
				createDenySummaryReport();
			}
			// Label function for refill
			private function getREfillData(oItem:Object,iCol:int):String
			{
				var result:String = '';
				
				if(oItem.PreisPRN)
					result =oItem.PreisPRN;
				
				if(result.toUpperCase() == 'TRUE')
				{
					result = 'AS NEEDED';
				}else
				{
					if(oItem.PreRefill)
						result = oItem.PreRefill;
				}
				
				return result;
			}
