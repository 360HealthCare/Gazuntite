			// Pharmacy search button click handler
			protected function pharmacy_clickHandler(event:MouseEvent):void
			{
				var pharmacyname:String = id_pharmacy.text;
				if(pharmacyname == "")
					pharmacyname = "0";
				
				if(!pharmacySearch)
					pharmacySearch = new pharmacySearchPopup();
				
				pharmacySearch.addEventListener("SelectButtonClicked", selectPharmacy);
				var pLoc:Point = new Point( this.x , this.y );
				var loc:Point = this.localToGlobal( pLoc );
				pharmacySearch.x = loc.x ; 
				pharmacySearch.y = loc.y ;			
				pharmacySearch.pharmacyName 	= pharmacyname;
				pharmacySearch.inSearchPopup 	= true;
				pharmacySearch.ShowPopup(this);
				id_pharmacy.text = "";
			}
			// on selting pharmacy click handler
			private function selectPharmacy(event:Event):void
			{
				if(pharmacySearch.id_pharmacySearch._Phone == "")
				{
					var alert:Alert = Alert.show("This Pharmacy does not have phone number, please select Other Pharmacy", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						id_PharmacyName.text 		= "";
						id_NPCDID.text 				= "";
						id_pharmacyAddress.text 	= "";
						id_pharmacyPhone.text		= "";
						return;
					});
					return;
				}
				
				var servicelevels:int = parseInt(pharmacySearch.id_pharmacySearch._ServiceLevel);
				if(servicelevels % 2 != 1)
				{
					var alert:Alert = Alert.show("This Pharmacy does not allow NewRX", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						id_PharmacyName.text 		= "";
						id_NPCDID.text 				= "";
						id_pharmacyAddress.text 	= "";
						id_pharmacyPhone.text		= "";
						return;
					});
				}
				
				id_PharmacyName.text 		= pharmacySearch.id_pharmacySearch._storename;
				id_NPCDID.text 				= pharmacySearch.id_pharmacySearch._NCPDPID;
				id_pharmacyAddress.text 	= pharmacySearch.id_pharmacySearch._AddressLine1;
				id_pharmacyPhone.text		= pharmacySearch.id_pharmacySearch._Phone;
				_ServiceLevel 				= pharmacySearch.id_pharmacySearch._ServiceLevel;
				
				pharmacySearch.removePopup();
			}
			//medicine search click handler
			protected function id_searchBtn_clickHandler(event:MouseEvent):void
