			// validate form
			private function ValidateNEWRX():Boolean
			{
				var success:Boolean = new Boolean();
				var errorStr:String = new String();
				success = true;	
				var toSetFocus:Object;
				
				if (id_PharmacyName.text.length == 0)
				{
					success = false;
					errorStr += "Please select pharmacy \n";	
					if (!toSetFocus)
						toSetFocus = id_pharmacy;
				}
				
				if (id_medicine.text.length == 0)
				{
					success = false;
					errorStr += "Please select medicine \n";	
					if (!toSetFocus)
						toSetFocus = id_medicine;					
				} 
				
				if(! (id_strength.selectedItem))
				{
					success = false;
					errorStr += "Please Select Strength \n";
					if (!toSetFocus)
						toSetFocus = id_strength;
					
				} 
				
				if (id_ndc.text.length == 0)
				{
					success = false;
					errorStr += "NDC code is must \n";	
					//id_ndc.setFocus();
					if (!toSetFocus)
						toSetFocus = id_ndc;
				}
				
				if (id_dose.text.length == 0)
				{
					success = false;
					errorStr += "Please enter dose \n";	
					//id_dose.setFocus();
					
					if (!toSetFocus)
						toSetFocus = id_dose;
				}
				/* if (parseInt(id_dose.text) > 18)
				{
				success = false;
				errorStr += "Maximum dose cannot exceed 18 \n";	
				
				if (!toSetFocus)
				toSetFocus = id_dose;
				} */
				
				if(! (id_dosageForm.selectedItem))
				{
					success = false;
					errorStr += "Please Select Dosage Form \n";
					//id_dosageForm.setFocus();
					if (!toSetFocus)
						toSetFocus = id_dosageForm;
					
				}
				if (id_quantity.text.length == 0)
				{
					success = false;
					errorStr += "Please enter quantity \n";	
					//id_quantity.setFocus();
					if (!toSetFocus)
						toSetFocus = id_quantity;
				}
				if(! (id_quantityForm.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Quantity Form \n";	
					//id_quantityForm.setFocus();
					if (!toSetFocus)
						toSetFocus = id_quantityForm;
				}
				if(! (id_frequency.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Frequency \n";	
					//id_frequency.setFocus();
					if (!toSetFocus)
						toSetFocus = id_frequency;
				}
				if(! (id_route.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Route \n";	
					//id_route.setFocus();
					if (!toSetFocus)
						toSetFocus = id_route;
				}
				
				if(!id_chk_PRN.selected)
				{
					if (id_refills.text.length == 0)
					{
						id_refills.text = "0";
						/* success = false;
						errorStr += "Please enter refills \n";	
						id_refills.setFocus(); */
					}
				}
				if(! (id_substitution.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Substitution \n";	
					//id_substitution.setFocus();
					if (!toSetFocus)
						toSetFocus = id_substitution;
				}
				
				/* 	if(! (id_type.selectedItem ))
				{
				success = false;
				errorStr += "Please Select Type \n";	
				id_type.setFocus();
				} */
				
				if(!id_chkCreateVisit.selected && !id_chkNAVisit.selected)
				{
					if(! (id_associatedVisit.selectedItem ))
					{
						success = false;
						errorStr += "Please Select Associated Visit \n";	
						//id_associatedVisit.setFocus();
						if (!toSetFocus)
							toSetFocus = id_associatedVisit;
					}
				}
				
				if (id_sig.text.length == 0)
				{
					success = false;
					errorStr += "Please enter SIG \n";	
					//id_quantity.setFocus();
					if (!toSetFocus)
						toSetFocus = id_sig;
				}
				
				if(success == false)
				{
					var alert:Alert = Alert.show(errorStr, "Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
					
					//PopUpManager.centerPopUp (alert);
				}
				return success;
			}
			
