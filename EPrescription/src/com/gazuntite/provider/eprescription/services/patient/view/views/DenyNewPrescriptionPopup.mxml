				ProdListView.id_SearchList.dataProvider 	= prodArrayCol;
				ProdListView.id_SearchList.labelField 		= "GenericName";
			}	
			private function OnProdItemClick(event:Event):void
			{
				try
				{
					//trace("OnProdItemClick MEdlist  --> ",ProdListView.id_SearchList.selectedItem.GenericName );
					var prodId:String 			= ProdListView.id_SearchList.selectedItem.GENPRODUCT_ID;
					id_genericName.text 		= ProdListView.id_SearchList.selectedItem.GenericName;
					csa_code 					= ProdListView.id_SearchList.selectedItem.CSA_CODE;
					
					if(csa_code == "1" || csa_code == "2")
					{
						var alert:Alert = Alert.show("This medication contains controlled substance", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						});
					}
					
					GetMedStrength(id_genericName.text, '0');
					var GenericName:String = ProdListView.id_SearchList.selectedItem.GenericName;
					getNDCField("0", prodId, "0");
					PopulateMedicineField("0", "0", GenericName, "0");
					//{DrugID}/{GENPRODUCT_ID}/{NDC}										
					clearProdSearchResults();
					isMedicineSelected = true;
				}
				catch(e:Error)
				{
					//trace("ERROR --> OnItemClick", e );
				}
			}
			
