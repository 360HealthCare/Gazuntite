					//id_genericName.text = MedListView.id_SearchList.selectedItem.tradeName;
					//id_ndc.text 		= MedListView.id_SearchList.selectedItem.rownum;
					var drugId:String = MedListView.id_SearchList.selectedItem.DRUG_ID;
					var drugName:String = MedListView.id_SearchList.selectedItem.DrugName;
					PopulateProductGenericField(drugId, "0", "0");
					/* var ps:PharmacySelectedEvent = new PharmacySelectedEvent(PharmacySelectedEvent.PHARMACY_SELECTED);
					ps.selection = SearchListView.id_SearchList.selectedItem;
					dispatchEvent( ps ); */
					clearMedSearchResults();
					isMedicineSelected = true;
				}
				catch(e:Error)
				{
					//trace("ERROR --> OnItemClick", e );
				}
			}
			private function PopulateProductGenericField(drugId:String="0", medicineName:String="0", ndc:String="0"):void
			{
				var GENPRODUCT_ID:String;
				var getStaticLists: GetProductByDrugIDEvent = new GetProductByDrugIDEvent(drugId, medicineName, ndc,  function(response:XML):void
				{
					for(var i:int=0; i<response.Product.length(); i++)
					{
						var GenericName:String 	= response.Product[i].@GenericName.toString();
						GENPRODUCT_ID 			= response.Product[i].@GENPRODUCT_ID.toString();					
						csa_code 				= response.Product[i].@CSA_CODE.toString();
						
						if(csa_code == "1" || csa_code == "2")
						{
							var alert:Alert = Alert.show("This medication contains controlled substance", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
								
								if(chk1 && chk5)
								{
									checkPrescriberServiceLevels = true;
								}
								else
								{
									checkPrescriberServiceLevels = false;
								}
								
							});
						}
						
						//prodArrayCol.addItem({ GenericName:GenericName, GENPRODUCT_ID:GENPRODUCT_ID});
						id_genericName.text = GenericName;
						
						GetMedStrength(GenericName, '0');
						//PopulateNDCField(drugId, "0", "0");
						getNDCField("0", GENPRODUCT_ID, "0");
					}
				}
				);
				getStaticLists.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(getStaticLists); 				
			}
			private function GetMedStrength(GENPRODUCT_NAME:String, NDC:String):void
			{
				//GET STRENGTH...
				var getMedicineStrengthEvent: GetStrengthByGenericProductIDEvent = new GetStrengthByGenericProductIDEvent(GENPRODUCT_NAME, NDC,  function(response:XML):void
				{
					//trace("MEDICINE STRENGTH ");
					//trace(response.toXMLString());
					var strengthAC:ArrayCollection = new ArrayCollection();
					for(var i:int=0; i<response.Strengths.Strength.length(); i++)
					{
						var STRENGTH_ID:String 			= response.Strengths.Strength[i].@STRENGTH_ID.toString();
						var STRENGTH_DESCRIPTION:String = response.Strengths.Strength[i].@STRENGTH_DESCRIPTION.toString();
						strengthAC.addItem({ STRENGTH_ID:STRENGTH_ID, STRENGTH_DESCRIPTION:STRENGTH_DESCRIPTION});
					}
					id_strength.dataProvider = strengthAC;
					id_strength.labelField = "STRENGTH_DESCRIPTION";
					id_strength.selectedIndex = 0;
				});
				getMedicineStrengthEvent.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(getMedicineStrengthEvent); 	
			}
			private function getNDCField(strengthID:String = '0', ProductId:String="0", ndc:String="0", drugId:String="0"):void
			{
				var getNDCByDRUGIDProductIDEvent: GetNDCByDRUGIDProductIDEvent = new GetNDCByDRUGIDProductIDEvent(strengthID, ProductId, ndc, drugId, function(response:XML):void
				{
					//trace("response MedicineNDCSearch "+response.toXMLString());	
					medArrayCol = new ArrayCollection();
					for(var i:int=0; i<response.NDC.length(); i++)
					{
						
						var FORMATTED_NDC:String 	= response.NDC[i].@FORMATTED_NDC.toString();
						var NDC:String 				= response.NDC[i].@NDC.toString();					
						
						medArrayCol.addItem({ FORMATTED_NDC:FORMATTED_NDC, NDC:NDC});
						id_ndc.text = NDC;
						break; // select top 1
					} 			
				}
				);				
				getNDCByDRUGIDProductIDEvent.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(getNDCByDRUGIDProductIDEvent);	
			}
