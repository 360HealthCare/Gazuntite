			//TA -  on N/A Visit change handler
			protected function id_chkNAVisit_clickHandler(event:MouseEvent):void
			{
				if(id_chkNAVisit.selected)
				{
					id_associatedVisit.enabled = false;
					id_chkCreateVisit.selected = false;
				}
				else
				{
					id_associatedVisit.enabled = true;
				}
			}
			//TA -  on Create new visit Visit change handler
			protected function id_chkCreateVisit_clickHandler(event:MouseEvent):void
			{
				if(id_chkCreateVisit.selected)
				{
					id_associatedVisit.enabled = false;
					id_chkNAVisit.selected     = false;
				}
				else
				{
					id_associatedVisit.enabled = true;
				}
			}
