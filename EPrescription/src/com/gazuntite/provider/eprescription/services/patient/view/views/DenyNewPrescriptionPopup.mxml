			}
			
			private function MedicineSearch(meds:XML):void
			{
				//trace("medicine Search results");
				//trace("MEDICINE SEARH RES -- > "+meds.toXMLString());	
				medArrayCol = new ArrayCollection();
				for(var i:int=0; i<meds.Drugs.Drug.length(); i++)
				{
					var s_rownum:String = meds.Drugs.Drug[i].@rownum.toString();
					var s_DrugName:String = meds.Drugs.Drug[i].@DrugName.toString();
					var s_DRUG_ID:String = meds.Drugs.Drug[i].@DRUG_ID.toString();
					medArrayCol.addItem({ rownum:s_rownum, DrugName:s_DrugName, DRUG_ID:s_DRUG_ID});
				}
				
				if(MedListView)
				{
					if(!MedListView.visible)
					{
						MedListView.visible = true;
						MedListView.x = loc.x - 15; 
						MedListView.y = loc.y + 5 ;  
						
						MedListView.id_SearchList.dataProvider 	= medArrayCol;
					}
				}
				else
				{
					createMedSearchList();		
					MedListView.id_SearchList.labelField 	= "DrugName";
				}
			}
			private function createMedSearchList():void
			{
