			public function calculateDuration():void
			{
				if(id_dose.text.length != 0 && id_quantity.text.length != 0)
				{
					var dose:int 		= parseInt(id_dose.text);
					var quantity:int 	= parseInt(id_quantity.text);
					var duration:Number;
					var eachday:Number;
					var freq:Number;
					
					if(id_frequency.selectedItem.Abbreviation == "TID")
					{
						freq = 3;
					}
					else if(id_frequency.selectedItem.Abbreviation == "3X/W")
					{
						freq = 3/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "QID")
					{
						freq = 4;
					}
					else if(id_frequency.selectedItem.Abbreviation == "5X/D")
					{
						freq = 5;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q18H")
					{
						freq = 24/18;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q36H")
					{
						freq = 24/36;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q48H")
					{
						freq = 24/48;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q72H")
					{
						freq = 24/72;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q7D")
					{
						freq = 1/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "every other day")
					{
						freq = 0.5;
					}
					else if(id_frequency.selectedItem.Abbreviation == "once a day")
					{
						freq = 1;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q1MO")
					{
						freq = 1/30;
					}
					else if(id_frequency.selectedItem.Abbreviation == "1X/W")
					{
						freq = 1/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "BID")
					{
						freq = 2;
					}
					else if(id_frequency.selectedItem.Abbreviation == "2X/W")
					{
						freq = 2/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q15MIN")
					{
						freq = 60*24 / 15;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q1H")
					{
						freq = 24;
					}
					else if(id_frequency.selectedItem.Abbreviation == "10X/D") //10 times a day
					{
						freq = 10;
					}
					else if(id_frequency.selectedItem.Abbreviation == "12X/D")
					{
						freq = 12;
					}
					else if(id_frequency.selectedItem.Abbreviation == "16X/D")
					{
						freq = 16;
					}
					else if(id_frequency.selectedItem.Abbreviation == "6X/D")
					{
						freq = 6;
					}
					else if(id_frequency.selectedItem.Abbreviation == "7X/D")
					{
						freq = 7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "8X/D")
					{
						freq = 8;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q16H") //every 16 hours
					{
						freq = 24/16;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q2W") //every 2 weeks
					{
						freq = 1/14;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q30MIN") //every 30 minutes
					{
						freq = 60*24 / 30;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q40H") //every 40 hours
					{
						freq = 24 / 40;
					}
					else if(id_frequency.selectedItem.Abbreviation == "QY") //yearly
					{
						freq = 1/365;
					}
					else if(id_frequency.selectedItem.Abbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(id_frequency.selectedItem.Abbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q3W")
					{
						freq = 1/21;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q5D")
					{
						freq = 1/5;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q60H")
					{
						freq = 24 / 60;
					}
					else
					{
						freq = 1;
					}
					
					eachday = dose * freq;
					duration = quantity/eachday;
					duration = Math.round(duration);
					id_duration.text = duration.toString();
				}
			}
			protected function id_chk_PRN_clickHandler(event:Event):void
			{
				if(id_chk_PRN.selected)
				{					
					id_refills.text 	= "0";
					id_refills.enabled 	= false;
				}
				else
				{
					id_refills.enabled 	= true;
				}
			}
		]]>
	</fx:Script>
	
