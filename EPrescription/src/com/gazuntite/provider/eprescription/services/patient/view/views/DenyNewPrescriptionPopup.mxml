				summary  = new RXSummary();
				
				var pLoc:Point = new Point( this.x , this.y );
				var loc:Point = this.localToGlobal( pLoc );
				summary.x = loc.x ; 
				summary.y = loc.y ;				
				
				summary.gaxenPatiendId 		= gaxenPatiendId;
				summary.patientID 			= patientID;
				summary.securityHeaderXML 	= securityHeaderXML;
				
				summary.ShowPopup(this);
				//provider
				summary.SPI							= SPI;
				
				summary.sendOnly 	= sendOnly;
				summary.isChronic 	= isChronic;
				
				//patient
				summary.id_PatientName.label 		= id_PatientName.label; 
				summary.id_quivusId.text 			= id_quivusId.text;
				summary.id_dob.text 				= id_dob.text;
				summary.id_gender.text 				= id_gender.text;
				
				//patient insurance
				summary.insuranceCol 				= InsurancesXML; //insuranceCol;
				
				//pharmacy
				summary.id_PharmacyName.text 		= id_PharmacyName.text; 
				summary.id_NPCDID.text 				= id_NPCDID.text;
				summary.id_pharmacyPhone.text 		= id_pharmacyPhone.text; 
				summary.id_pharmacyAddress.text 	= id_pharmacyAddress.text;
				
				//summary.id_pharmacyNotes.text		= id_pharmacyNotes.text;
				//TA			summary.id_pharmacyNotes.label		= id_pharmacyNotes.text;
				
				//medication
				summary.id_medicine.text 			= id_medicine.text; 
				summary.id_genericName.text 		= id_genericName.text;
				summary.id_ndc.text					= id_ndc.text;
				summary.id_strength.text			= id_strength.selectedItem? id_strength.selectedItem.STRENGTH_DESCRIPTION: "";
				summary.StrengthId					= id_strength.selectedItem? id_strength.selectedItem.STRENGTH_ID: "";
				summary.id_dose.text				= id_dose.text;
				summary.id_ndc.text					= id_ndc.text;
				summary.id_dosageForm.text			= id_dosageForm.selectedItem?id_dosageForm.selectedItem.Term: "";
				summary.DosageCode					= id_dosageForm.selectedItem?id_dosageForm.selectedItem.Code: "";
				summary.id_quantity.text			= id_quantity.text;
				summary.id_quantityForm.text		= id_quantityForm.selectedItem? id_quantityForm.selectedItem.Term: "";
				summary.QuantityForm				= id_quantityForm.selectedItem? id_quantityForm.selectedItem.Code: "";
				summary.Frequency					= id_frequency.selectedItem? id_frequency.selectedItem.Abbreviation: "";
				summary.id_frequency.text			= id_frequency.selectedItem? id_frequency.selectedItem.Description: "";
				summary.id_route.text				= id_route.selectedItem? id_route.selectedItem.DOSE_ROUTE_DESCRIPTION: "";
				summary.Route						= id_route.selectedItem? id_route.selectedItem.DOSE_ROUTE_ID: "";
				summary.id_duration.text			= id_duration.text;
				//summary.id_ndc.text				= id_chk_PRN.selected;
				
				if(id_chk_PRN.selected)
				{
					summary.isPRN					= "true";
					summary.id_refills.text			= "As needed";
				}
				else
				{
					summary.isPRN					= "false";
					summary.id_refills.text			= id_refills.enabled? id_refills.text: "0";
				}
				summary.id_substitution.text		= id_substitution.selectedItem? id_substitution.selectedItem.SubstitutionCode: "";
				summary.id_type.text				= id_type.selectedItem? id_type.selectedItem.data:"";
				
				if(encounterId != "0" && encounterId != "" && id_chkCreateVisit.selected)
				{
					//new visit created.
					summary.id_associatedVisit.text		= AppUtils.formatDate(AppUtils.getToday()); 
					summary.EncounterId					= encounterId;
					summary.visitDate					= AppUtils.getToday(); 
				}
				else if(encounterId == "-1" && id_chkNAVisit.selected)
				{
					//NA visit created.
					summary.id_associatedVisit.text		= 'N/A'; // NA shown in summary view --- AppUtils.formatDate(AppUtils.getToday()); 
					summary.EncounterId					= encounterId;
					summary.visitDate					= AppUtils.getToday(); 
				}
				else
				{
					//Associate visit
					summary.id_associatedVisit.text		= id_associatedVisit.selectedItem? AppUtils.formatDate(id_associatedVisit.selectedItem.VisitDate): "";
					summary.EncounterId					= id_associatedVisit.selectedItem? id_associatedVisit.selectedItem.VisitID: "";
					//encounterId							= id_associatedVisit.selectedItem? id_associatedVisit.selectedItem.VisitID: "";
					trace("encounterId of exisiting Visit: "+summary.EncounterId);
					summary.visitDate					= id_associatedVisit.selectedItem? id_associatedVisit.selectedItem.VisitDate: "";
				}
				
				//summary.id_sig.text					= id_sig.text;
				summary.id_sig.label					= id_sig.text;
				summary.id_NPCDID.text				= id_NPCDID.text;
				
				summary.id_PatientName.label			= fName + ' '+ lName;
				summary.id_gender.text				= id_gender.text;
				summary.id_dob.text					= id_dob.text;
				summary.id_phone.text				= id_phone.text;
				summary.id_address.label			= id_address.text;
				summary.id_address.toolTip			= id_address.text;
				summary.isActive					= id_isActiveBtn.selected? "true":"false";				
				summary.addEventListener("NewRXSuccessful", resetForm);
			}
			
