			private function MedicineProdSearchList(response:XML):void
			{
				//trace("response MedicineProdSearch "+response.toXMLString());	
				prodArrayCol = new ArrayCollection();
				for(var i:int=0; i<response.Product.length(); i++)
				{
					var GenericName:String 		= response.Product[i].@GenericName.toString();
					var GENPRODUCT_ID:String 	= response.Product[i].@GENPRODUCT_ID.toString();		
					csa_code 					= response.Product[i].@CSA_CODE.toString();
					
					prodArrayCol.addItem({ GenericName:GenericName, GENPRODUCT_ID:GENPRODUCT_ID, CSA_CODE:csa_code});
				} 							
				
				if(ProdListView)
				{
					if(!ProdListView.visible)
					{
						ProdListView.visible = true;
						ProdListView.x = loc.x - 15; 
						ProdListView.y = loc.y + 5 ;  
						ProdListView.id_SearchList.dataProvider 	= prodArrayCol;
					}
				}
				else
				{
					createProdSearchList();	
					ProdListView.id_SearchList.labelField 	= "GenericName";
				} 
			}
			private function PopulateMedicineField(medName:String, StartNo:String, genericName:String, ndc:String ):void
			{
				//{GENERICNAME}/{StartNumber}/{productGenName}/{NDC}							
				var getStaticLists: SearchDrugbyGNameEvent = new SearchDrugbyGNameEvent(medName, StartNo , genericName, ndc,function(meds:XML):void
				{
					//trace("got meds ");
					//trace("response MedicineSearch "+meds.toXMLString());	
					//medArrayCol = new ArrayCollection();
					for(var i:int=0; i<meds.Drugs.Drug.length(); i++)
					{
						var s_rownum:String = meds.Drugs.Drug[i].@rownum.toString();
						var s_DrugName:String = meds.Drugs.Drug[i].@DrugName.toString();
						var s_DRUG_ID:String = meds.Drugs.Drug[i].@DRUG_ID.toString();
						//medArrayCol.addItem({ rownum:s_rownum, DrugName:s_DrugName, DRUG_ID:s_DRUG_ID});
						id_medicine.text = s_DrugName;
					}
				});
				getStaticLists.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(getStaticLists); 	
			}
			private function createProdSearchList():void
			{
				ProdListView 				= new medicineSearchList();
				ProdListView.addEventListener( MedicineSelectedEvent.MED_SELECTED, OnProdItemClick);
				ProdListView.addEventListener( "closeSearchBox", clearProdSearchResults);
				ProdListView.minWidth = id_ndc.width;
				ProdListView.width = id_ndc.width;
				ProdListView.maxHeight = 170;
