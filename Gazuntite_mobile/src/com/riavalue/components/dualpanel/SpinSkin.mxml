<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
		xmlns:mx="library://ns.adobe.com/flex/mx">
	
	<fx:Metadata>
		[HostComponent("com.riavalue.components.dualpanel.DualPanel")]
	</fx:Metadata>
	
	<s:states>
		<s:State name="front"/>
		<s:State name="back"/>
	</s:states>
	
	<s:transitions>
		<s:Transition fromState="front"
					  toState="back"
					  autoReverse="true">
			
			<s:Sequence duration="{hostComponent.transitionDuration}" suspendBackgroundProcessing="true">
				<s:Rotate3D angleYFrom="0"
							angleYTo="90"
							focalLength="1000"
							autoCenterTransform="true"
							target="{frontContainerHolder}"/>
				
				<s:RemoveAction target="{frontContainerHolder}"/>
				<s:AddAction target="{backContainerHolder}"/>
				
				<s:Rotate3D angleYFrom="270"
							angleYTo="360"
							autoCenterTransform="true"
							target="{backContainerHolder}"/>
				
			</s:Sequence>
		</s:Transition>
		
		<s:Transition fromState="back"
					  toState="front"
					  autoReverse="true">
			<s:Sequence duration="{hostComponent.transitionDuration}" 
						suspendBackgroundProcessing="true">
				<s:Rotate3D angleYFrom="360"
							angleYTo="270"
							autoCenterTransform="true"
							target="{backContainerHolder}"/>
				
				<s:RemoveAction target="{backContainerHolder}"/>
				<s:AddAction target="{frontContainerHolder}"/>
				
				<s:Rotate3D angleYFrom="90"
							angleYTo="0"
							focalLength="1000"
							autoCenterTransform="true"
							target="{frontContainerHolder}"/>
			</s:Sequence>
		</s:Transition>
	</s:transitions>
	
	
	<s:Group id="frontContainerHolder"
			 width="100%" height="100%"
			 includeIn="front"/>
	
	<s:Group id="backContainerHolder"
			 width="100%" height="100%"
			 includeIn="back"/>
	
	<s:Button id="prefsButton"
			  width="30"
			  right="0"
			  top="5"
			  skinClass="com.gazuntite.skins.FlipBtnSkin"/>
</s:Skin>
