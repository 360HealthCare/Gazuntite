<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:views="com.adobe.audio.views.*"
		 xmlns:spicefactory="http://www.spicefactory.org/parsley"
		 width="100%" height="100%">
	
	<fx:Metadata>
		[Event(name="playingEnd", type="com.gazuntite.events.SoundClipEvent")]
		[Event(name="deleteItem", type="com.gazuntite.events.SoundClipEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.CloseSlideoutEvent;
			import com.gazuntite.events.SoundClipEvent;
			
			protected var soundClip:ByteArray;
			protected var sound:Sound;
			protected var channel:SoundChannel;

			public function startPlaying(soundClip:ByteArray):void
			{
				this.soundClip = soundClip;
				soundClip.position = 0;
				sound = new Sound();
				sound.addEventListener(SampleDataEvent.SAMPLE_DATA, sound_sampleDataHandler);
				channel = sound.play();
				channel.addEventListener(Event.SOUND_COMPLETE, soundCompleteHandler);
				av.start();
			}
			
			public function stopPlaying():void
			{
				channel.stop();
				av.stop();
				dispatchEvent(new SoundClipEvent(SoundClipEvent.PLAYING_END));
			}
			
			protected function sound_sampleDataHandler(event:SampleDataEvent):void
			{
				if (!soundClip.bytesAvailable > 0)
				{
					return;
				}
				
				for (var i:int = 0; i < 8192; i++)
				{
					var sample:Number = 0;
					if (soundClip.bytesAvailable > 0)
					{
						sample = soundClip.readFloat();
					}
					event.data.writeFloat(sample); 
					event.data.writeFloat(sample);  
				}
			}
			
			[MessageHandler]
			public function stopSound(event:CloseSlideoutEvent):void
			{
				stopPlaying();
			}
			
			protected function soundCompleteHandler(event:Event):void
			{
				dispatchEvent(new SoundClipEvent(SoundClipEvent.PLAYING_END));
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<mx:DateFormatter id="df" formatString="EEEE MMMM D YYYY, L:NNA"/>
	</fx:Declarations>
	
	<s:Label text="Playing dictation..." top="20" horizontalCenter="0"/>
	<s:Label top="10" horizontalCenter="0"/>
	
	<views:AudioVisualizer id="av" verticalCenter="-100"/>
	
	<s:Button label="Stop Playing" 
			  skinClass="com.gazuntite.skins.StopButtonSkin" 
			  click="stopPlaying()" 
			  horizontalCenter="0"
			  bottom="0"/>		

</s:Group>
