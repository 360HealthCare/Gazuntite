<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 width="100%" height="100%">
	
	<fx:Metadata>
		[Event(name="recordingEnd", type="com.gazuntite.events.SoundClipEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SoundClipEvent;
			
			protected var microphone:Microphone;
			protected var soundClip:ByteArray;
			protected var sound:Sound;
			protected var channel:SoundChannel;
			
			public function startRecording():void
			{
				soundClip = new ByteArray();
				microphone = Microphone.getMicrophone();
				microphone.rate = 44;
				microphone.gain = 100;
				microphone.addEventListener(SampleDataEvent.SAMPLE_DATA, microphone_sampleDataHandler);
			}
			
			public function stopRecording():void
			{
				microphone.removeEventListener(SampleDataEvent.SAMPLE_DATA, microphone_sampleDataHandler);
				dispatchEvent(new SoundClipEvent(SoundClipEvent.RECORDING_END, soundClip));
			}
			
			protected function microphone_sampleDataHandler(event:SampleDataEvent):void
			{
				level.width = microphone.activityLevel * 2;
				level.height = microphone.activityLevel * 2;
				
				while (event.data.bytesAvailable)
				{
					var sample:Number = event.data.readFloat();
					soundClip.writeFloat(sample);
				}
			}
			
		]]>
	</fx:Script>

	<s:Label text="Recording dictation..." top="10" horizontalCenter="0"/>
	
	<s:Ellipse id="level" horizontalCenter="0" verticalCenter="0">
		<s:fill>
			<s:SolidColor color="#FF0000"/>
		</s:fill>
	</s:Ellipse>
	
	<s:Button label="Stop" 
			  click="stopRecording()"
			  skinClass="com.gazuntite.skins.StopButtonSkin"
			  bottom="0"
			  horizontalCenter="0"/>		

</s:Group>
