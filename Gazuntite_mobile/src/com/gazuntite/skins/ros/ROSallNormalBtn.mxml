<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="15" radiusX="3" width="75" visible.over="false" visible.down="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C1E88D" ratio="0" color.disabled="#E2E3E3"/>
				<s:GradientEntry alpha="1.0" color="#B2E47A" ratio="0.47058823529411764" ratio.disabled="0.4627450980392157" color.disabled="#CCCCCC"/>
				<s:GradientEntry alpha="1.0" color="#9BCE6C" ratio="0.47058823529411764" color.disabled="#C1C2C2"/>
				<s:GradientEntry alpha="1.0" color="#9FE479" ratio="1" color.disabled="#CCCCCC"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="15" includeIn="down,over" radiusX="3" width="75" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C1FF70" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#9FE54E" ratio="0.48627450980392156"/>
				<s:GradientEntry alpha="1.0" color="#75C12D" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#9AEF6C" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:RichText color="#666666" fontFamily="Calibri" fontSize="11" tabStops="S0" text="All Normal" x="22" y="3" color.disabled="#999999"/>
	<s:RichText color="#333333" fontFamily="Calibri" fontSize="11" tabStops="S0" text="N" x="5" y="3" color.disabled="#999999"/>
	<s:Line x="16.5" y="0.5" yTo="14">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#006E00" joints="miter" miterLimit="4" weight="1" color.disabled="#999999"/>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="0" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Line>
</s:Skin>
