<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 width="100%" 
		 height="100%" 
		 xmlns:ipeControls="qs.ipeControls.*" 
		 xmlns:controls="com.gazuntite.components.controls.*"
		 creationComplete="init(event)" 
		 xmlns:forms="com.gazuntite.forms.*">
	
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SaveFormDataEvent;
			
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function addSaveRecord(event:SaveFormDataEvent):void
			{
				trace("bubbling saved record");
			}
			
			
			protected function addRecord(event:MouseEvent):void
			{
				
				// dummy data for test binding
				var r:ObjectProxy = new ObjectProxy();
				r.allergy = cb1.selectedItemText;
				r.reaction = cb2.selectedItemText;
				r.onSet = ds1.selectedItemText;
				
				var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
				e.payload = r;
				
				dispatchEvent(e);
				
				
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout paddingBottom="3"
						  paddingLeft="3"
						  paddingRight="3"
						  paddingTop="3"
						  gap="0"
						  horizontalAlign="center"
						  verticalAlign="top"/>
	</s:layout>
	
	<s:HGroup width="100%" height="100%">
		
		<controls:CalloutButtonText id="cb1" 
									buttonLabel="Allergy name:"
									required="true"
									labelField="name">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object name="Allergy 1"/>
					<fx:Object name="Allergy 2"/>
					<fx:Object name="Allergy 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb2"
									buttonLabel="Reaction:"
									required="true"
									labelField="name">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object name="Reaction 1"/>
					<fx:Object name="Reaction 2"/>
					<fx:Object name="Reaction 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
			
		</controls:CalloutButtonText>
		
		<controls:CalloutDateSpinner id="ds1" buttonLabel="OnSet:"/>
		
	</s:HGroup>
	
	<s:Button label="Add new allergy" 
			  styleName="button"
			  click="addRecord(event)"/>
	
</s:Group>
