<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:controls="com.gazuntite.components.controls.*"
		 xmlns:spicefactory="http://www.spicefactory.org/parsley"
		 xmlns:forms="com.gazuntite.forms.*"
		 width="100%" height="100%"
		 creationComplete="init(event)">
	
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SaveFormDataEvent;
			
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			public function setState(state:String):void
			{
				resetForm();
				this.currentState = state;
			}
			
			protected function resetForm():void
			{
				if(this.currentState == "form")
				{
					cl1.selectedItemText = "";
					cl2.selectedItemText = "";
					dsl1.selectedItemText = "";
					notesTxt.text = "";
				}
				
			}
			
			protected function addBtnHandler(event:MouseEvent):void
			{
				if(this.currentState == "form")
				{
					var o:ObjectProxy = new ObjectProxy();
					o.icdCode = cl1.selectedItemText;
					o.icdDescription = cl2.selectedItemText;
					o.onSet = dsl1.selectedItemText;
					o.active = activeTS.selected;
					o.notes = notesTxt.text;
					
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
					e.payload = o;
					
					dispatchEvent(e);
					
					resetForm();
				}
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="nonselected"/>
		<s:State name="form"/>
		<s:State name="none"/>
	</s:states>
	
	<s:VGroup width="100%" 
			  height="100%"
			  includeIn="nonselected"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<s:Label text="Select Yes or None" 
				 styleName="vbTitle"/>
	</s:VGroup>
	
	<s:VGroup width="100%" 
			  height="100%"
			  includeIn="none"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<s:Label text="You have selected None" 
				 styleName="vbTitle"/>
	</s:VGroup>
	
	<s:VGroup width="100%" 
			  height="100%"
			  includeIn="form"
			  paddingLeft="5"
			  paddingRight="5">
		
		
		<controls:CalloutLabelText id="cl1" 
								   styleName="vbSubTitle"
								   labelField="icdCode" 
								   buttonLabel="ICD Code:"
								   required="true">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object icdCode="111"/>
					<fx:Object icdCode="222"/>
					<fx:Object icdCode="333"/>
					<fx:Object icdCode="444"/>
					<fx:Object icdCode="555"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutLabelText>
		
		<controls:CalloutLabelText id="cl2" 
								   styleName="vbSubTitle"
								   labelField="description" 
								   buttonLabel="ICD Description:"
								   required="true">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object description="Description 1"/>
					<fx:Object description="Description 2"/>
					<fx:Object description="Description 3"/>
					<fx:Object description="Description 4"/>
					<fx:Object description="Description 5"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutLabelText>
		
		<controls:ToggleSwitchLabel id="activeTS" 
									label="Active:"
									width="120"/>
		
		<controls:CalloutLabelDateSpinner id="dsl1"
										  newStyleName="grayText"
										  labelField="onSet" 
										  buttonLabel="OnSet:"
										  required="false"/>
		
		<s:TextArea id="notesTxt" 
					width="100%" 
					height="40" 
					skinClass="spark.skins.mobile.TextInputSkin"/>
		
		<s:HGroup width="100%">
			
			<s:Button label="Add"
					  styleName="button"
					  click="addBtnHandler(event)"/>
			
			<!--<controls:NotesAndDictationCalloutButton width="21"
													 skinClass="com.gazuntite.skins.RecordLevelNotesDictationBtnSkin"/>-->
			
		</s:HGroup>
		
		
	</s:VGroup>
	
	
	
	
</s:Group>
