<?xml version="1.0" encoding="utf-8"?>
<forms:MobileFormBase xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:controls="com.gazuntite.components.controls.*"
					  width="100%" 
					  height="100%"
					  creationComplete="init(event)"
					  xmlns:spicefactory="http://www.spicefactory.org/parsley"
					  xmlns:forms="com.gazuntite.forms.*">
	
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<!-- this is just for testing Parsley -->
	<fx:Metadata>
		[ManagedEvents("saveFormData")]
		[ManagedEvents("getAllergyClassTypesEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.allergy.GetAllergyClassTypesEvent;
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.model.SharedModel;
			
			//import mx.controls.Alert;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			public override function set isEditForm(value:Boolean):void
			{
				_isEditForm = value;
				
				if(value == true)
				{
					this.currentState = "presentation";
				}else
				{
					this.currentState = "normal";
				} 
				
			}
			
			
			
			public function set selectedRecord(value:ObjectProxy):void
			{
				_selectedRecord = value;
				setForm();
			}
			
			protected function validateForm():Boolean
			{
				if(cl1.selectedItemText == "")
				{
					return false;
				}
				
				if(cl2.selectedItemText == "")
				{
					return false;
				}
				
				if(dsl1.selectedItemText == "")
				{
					return false;
				}
				
				
				return true;
			}
			
			protected function validateEditForm():Boolean
			{
				/* if(cl1.selectedItemText == "")
				{
				return false;
				}
				
				if(cl2.selectedItemText == "")
				{
				return false;
				}
				
				if(dsl1.selectedItemText == "")
				{
				return false;
				} */
				
				
				return true;
			}
			
			protected function updateRecord(event:MouseEvent):void
			{
				if(validateForm() || id_NKDA.selected)
				{
					// dummy data for test binding
					var r:ObjectProxy = new ObjectProxy();
					
					if( id_NKDA.selected )
					{
						r.allergy 	= "NKDA";
						r.reaction 	= "NKDA";
						r.status 	= "Active";
						r.onSet 	= "";
					}
					else
					{
						r.allergy = cl1.selectedItemText;
						r.reaction = cl2.selectedItemText;
						r.onSet = dsl1.selectedItemText;
						r.status = id_Active.selected ? "Active":"Inactive";
					}
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
					e.payload = r;
					
					if(_isEditForm)
					{
						e.isUpdate = true;
					}else
						
					{
						clearForm();
					}
					
					dispatchEvent(e);
					
				} 
			}
			
			protected function setForm():void
			{
				this.currentState = "presentation";
				cl1.selectedItemText = _selectedRecord.allergy;
				cl2.selectedItemText = _selectedRecord.reaction;
				dsl1.selectedItemText = _selectedRecord.onSet;
				
			}
			
			protected function clearForm():void
			{
				cl1.selectedItemText = "";
				cl2.selectedItemText = "";
				dsl1.selectedItemText = "";
				
			}
			
			protected function init(event:FlexEvent):void
			{
				if(sharedModel.allergyHistoryAC.length > 0)
				{
					_selectedRecord = sharedModel.allergyHistoryAC.getItemAt(0) as ObjectProxy;
				}
				
				var e:GetAllergyClassTypesEvent = new GetAllergyClassTypesEvent();
				dispatchEvent(e);
				
			}
			
			protected function id_NKDA_clickHandler(event:MouseEvent):void
			{
				if(!id_NKDA.selected)
				{
					g1.enabled = true;
					//Alert.show("NKDA" );
				}
				else
				{
					g1.enabled = false;
				}
			}
			
		]]>
	</fx:Script>
	
	<forms:states>
		<s:State name="normal"/>
		<s:State name="presentation"/>
	</forms:states>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<forms:layout>
		<s:VerticalLayout paddingBottom="0"
						  paddingLeft="3"
						  paddingRight="3"
						  paddingTop="0"
						  gap="1"
						  horizontalAlign="center"
						  verticalAlign="top"/>
	</forms:layout>
	
	<s:BorderContainer id="presentationForm" 
					   width="100%"
					   height="100%"
					   borderWeight="0" 
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="0">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xf3f3f3"/>
				<s:GradientEntry color="0xffffff"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:VerticalLayout paddingBottom="0"
							  paddingLeft="10"
							  paddingRight="10"
							  paddingTop="5"
							  gap="5"/>
		</s:layout>
		
		<s:HGroup height="100%" id="g1">
			<s:Image source="assets/done.png" includeInLayout="{_isEditForm}"/>
			<s:Image source="assets/edit.png" includeInLayout="{!_isEditForm}"/>
			
			<s:VGroup width="100%">
				<controls:CalloutLabelText id="cl1" 
										   styleName="title" 
										   labelField="Name" 
										   buttonLabel="Allergy Name:"
										   required="true" 
										   isEditForm="{_isEditForm}"
										   dataProvider="{sharedModel.AllergyClassTypes}"/>
				
				<controls:CalloutLabelText id="cl2"
										   styleName="subTitle" 
										   labelField="name" 
										   buttonLabel="Reaction:"
										   required="true"
										   isEditForm="{_isEditForm}" >
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object name="Reaction 1"/>
							<fx:Object name="Reaction 2"/>
							<fx:Object name="Reaction 3"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<controls:CalloutLabelDateSpinner id="dsl1"
												  styleName="grayText" 
												  buttonLabel="OnSet:" 
												  isEditForm="{_isEditForm}"/>
				
			</s:VGroup>
			
		</s:HGroup>
		
		<s:HGroup width="100%">
			
			<s:Spacer width="16"/>
			
			
			
			<controls:ToggleSwitchLabel id="id_Active" 
										label="Active:"
										enabled="{g1.enabled}"
										/>
			
			<controls:ToggleSwitchLabel id="id_NKDA" 
										label="NKDA:" 
										click="id_NKDA_clickHandler(event)"/>
			
			<s:Button id="actionBtn"
					  styleName="button"
					  label="{_buttonLabel}"
					  click="updateRecord(event)"/>
		</s:HGroup>
		
		
		
		
		
	</s:BorderContainer>
	
	
	<!-- end presentation form -->
	
	
	
</forms:MobileFormBase>
