		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:Scroller id="id_Scroller" width="100%" height="100%" verticalScrollPolicy="off" horizontalScrollPolicy="auto"  >
		
		<components1:ListTree id="id_TreeList" width="100%" MaxRows="15" DataProvider="{m_acDataProvider}" 
							 itemRenderer="{new ClassFactory( MainCatRenderer)}"  
							 childItemRenderer="{new ClassFactory( SubCatRenderer )}" 
							 footerItemRenderer="{new ClassFactory( FooterRenderer )}"
							 itemClick="treelist1_ItemClickEventHandler(event)" 
							 footerClick="treelist1_footerClickHandler(event)"
							 skinClass="com.gazuntite.skins.ros.QIPhysicalBG"							
							 creationComplete="id_TreeList_creationCompleteHandler(event)"
							 />
		<!--childBGSkin="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QIPhysicalChildBG"-->
		
	</s:Scroller>
	
</s:Group>
