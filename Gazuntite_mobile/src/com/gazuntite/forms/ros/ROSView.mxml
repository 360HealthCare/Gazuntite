			[Bindable]
			private var m_acDataProvider:ArrayCollection;// = createDummyData();
			
			private var m_bHasChange:Boolean;
			
			[Bindable]
			public function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			public function set hasChange(value:Boolean):void
			{
				m_bHasChange = value;
			}
			
			public function get DataProvider():ArrayCollection
			{
				return m_acDataProvider;
			}
			
			public function set DataProvider(value:ArrayCollection):void
			{
				m_acDataProvider = value;
			}
			
			private var previouslySelectedItem:SubCatRenderer;
			protected function treelist1_ItemClickEventHandler(event:ItemClickEvent):void
			{
				if( event.relatedObject is SubCatRenderer )
				{
					var dto:ROSDTO = event.currentTarget.ParentSelectedItem.data as ROSDTO;
					dto.IsNormal = IsAllChildNormal( dto ) ? Constants.STRING_TRUE : Constants.STRING_FALSE;
					
					if (event.relatedObject != previouslySelectedItem)
					{
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.ROS);
						previouslySelectedItem = SubCatRenderer(event.relatedObject);
					}
					
				}
				if (event.relatedObject is MainCatRenderer)
				{
					QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.ROS);
				}
				
			}
			private function IsAllChildNormal( dto:ROSDTO ):Boolean
			{
				var retVal:Boolean = true;
				var i:int;
				for( i = 0; i < dto.children.length; i++ )
				{
					var child:ROSDTO = dto.children.getItemAt(i) as ROSDTO ;
					retVal = child.IsNormal != Constants.STRING_FALSE ;
					
					if( ! retVal )
						break;
				}
				
				return retVal;
			}
			
			protected function treelist1_footerClickHandler(event:ItemClickEvent):void
			{
				var itemIndex:int = DataProvider.getItemIndex( id_TreeList.ParentSelectedItem.data );
				switch( event.item.id )
				{
					case "id_AllNormalBtn":
						var dataDTO:ROSDTO = id_TreeList.ParentSelectedItem.data as ROSDTO;
						//if 2nd level parent is selected, check it
						if( id_TreeList.ParentSelectedItem2level )
							dataDTO = id_TreeList.ParentSelectedItem2level.data as ROSDTO;
						
						trace( "id_AllNormalBtn", dataDTO.label);
						
						var mainCatID:int = dataDTO.ROSMainCategoryTypeID;
						var subCatID:int = -1;
						if( dataDTO.ROSSubCategoryTypeID && dataDTO.ROSSubCategoryTypeID != 0 )
							subCatID = dataDTO.ROSSubCategoryTypeID;
						
						if( QSUtilityFunctions.checkMainCategoryNotes( DataProvider, mainCatID, subCatID ) )
						{
							Alert.show("This action will clear all notes/dictation in this section, Are you sure you want to clear all notes/dictation?","Clear Notes and Dictation", Alert.YES|Alert.NO, 
								this, function(event:CloseEvent):void
								{
									if( event.detail == Alert.YES)
									{
										hasChange = QSUtilityFunctions.setMainCategoryToNormal( DataProvider, mainCatID, true, subCatID );
										if( hasChange )
											dispatchEvent( new Event("dataIsDirty", true, true) );
									}
									else if( event.detail == Alert.NO)
									{
										// NO button was clicked, do nothing
									}
								});
						}
						else
						{
							hasChange = QSUtilityFunctions.setMainCategoryToNormal( DataProvider, mainCatID, false, subCatID );
							if( hasChange )
								dispatchEvent( new Event("dataIsDirty", true, true) );
						}
						break;
					case "id_PreviousBtn":
						id_TreeList.selectItemByIndex( --itemIndex )
						break;
					case "id_NextBtn":
						id_TreeList.selectItemByIndex( ++itemIndex )
						break;
				}
			}
			
			public function UpdateCheckStatus():void
			{
				( id_TreeList.ParentSelectedItem as MainCatRenderer ).UpdateCheckStatus();
				if( id_TreeList.ParentSelectedItem2level )
					( id_TreeList.ParentSelectedItem2level as MainCatRenderer ).UpdateCheckStatus();
				
				hasChange = true;
			}
			
			protected function id_TreeList_creationCompleteHandler(event:FlexEvent):void
			{
				id_TreeList.setStyle("rollOverAlpha", 0);
				id_TreeList.setStyle("useRollOver", false);
				id_TreeList.setStyle("selectionColor", 0xffffff);
				
				addEventListener( "dataIsDirty", function(event:Event):void
				{
					trace("dataIsDirty", id_TreeList.ParentSelectedItem.label);
					var p:MainCatRenderer = id_TreeList.ParentSelectedItem as MainCatRenderer;
					p.BaseDTO.IsDirty = true;
					if( id_TreeList.ParentSelectedItem2level )
					{
						var p2:MainCatRenderer = id_TreeList.ParentSelectedItem2level as MainCatRenderer;
						p2.BaseDTO.IsDirty = true;
						p2.UpdateCheckStatus();
					}
					p.UpdateCheckStatus();
					
					hasChange = true;
				});
			}
			
