			protected function saveFormDataHandler(event:SaveFormDataEvent):void
			{
				if(event.payload != null)
				{
					if(event.isUpdate)
					{
						// save updated form item
						var i:int =id_ListView.selectedIndex;
						sharedModel.procedureAC.setItemAt(event.payload, i);
						editObject = sharedModel.procedureAC.getItemAt(i) as ProcedureDTO;
					}
					else
					{
						sharedModel.procedureAC.addItem(event.payload);
						sharedModel.procedureAC.addItem(event.payload);
					}
					
				} 
				
				invalidateDisplayList();
				
			}
			
