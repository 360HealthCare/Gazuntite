				id_Normal.selected		= true;
				rosPhysicalBaseDTO.IsNormal   		= Constants.STRING_TRUE;
				rosPhysicalBaseDTO.IsAbNormal   	= Constants.STRING_FALSE;
				
				
				if(notesBoxN.id_TextArea.text.length > 0)
				{
					id_Normal.setStyle("skinClass", NNotesRadioButton);
				}
				else
				{
					id_Normal.setStyle("skinClass", QINormalBtn);
				} 
				
				dispatchEvent( new Event("dataIsDirty", true, true) );
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		
	</fx:Declarations>
	
	<!--<fx:Binding destination="selected" source="id_Abnormal.selected" twoWay="true" />-->
	
	<fx:Binding destination="ChangeSkin" 	source="rosPhysicalBaseDTO.IsDirty" />
	<fx:Binding destination="GotNormal" 	source="rosPhysicalBaseDTO.IsNormal" />
	<fx:Binding destination="GotAbnormal" 	source="rosPhysicalBaseDTO.IsAbNormal" />
	
	<s:layout>
		<s:HorizontalLayout paddingLeft="0" paddingRight="5" paddingBottom="0" paddingTop="0" gap="0" />
	</s:layout>
	
	<s:SkinnableContainer id="id_Contents" skinClass="com.gazuntite.skins.ros.ROSSubcategorySkin" width="100%" height="21">
		<!--DBDC9B-->
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" horizontalAlign="center" paddingLeft="3" paddingRight="3" paddingTop="1" paddingBottom="3" />
		</s:layout>
		
		<s:Label id="id_MainButton" width="150" text="{label}" toolTip="{label}" maxDisplayedLines="1" fontFamily="Calibri" color="#222222" textAlignLast="left" />
		
		<s:HGroup gap="2">
			
			<s:ToggleButton id="id_Normal" click="id_Normal_clickHandler(event)"
							toolTip="Normal" selected="{rosPhysicalBaseDTO.IsNormal == Constants.STRING_TRUE}"
							skinClass="com.gazuntite.skins.ros.QINormalBtn" buttonMode="true" useHandCursor="true" />
			
			<s:ToggleButton id="id_Abnormal" click="id_NotesBtn_clickHandler(event)" 
							toolTip="Abnormal" selected="{rosPhysicalBaseDTO.IsAbNormal == Constants.STRING_TRUE}"
							skinClass="com.gazuntite.skins.ros.QIAbnormalBtnSkin" 
							buttonMode="true" useHandCursor="true"/>		
		</s:HGroup>
		
		
	</s:SkinnableContainer>
	<s:Group id="id_NotesSpacer" width="100%" height="20" includeInLayout="false" visible="false"/>
	
</s:ItemRenderer>
