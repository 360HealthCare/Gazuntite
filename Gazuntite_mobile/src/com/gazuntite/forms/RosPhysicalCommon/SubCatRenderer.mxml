				return m_bChangeSkin;
			}
			
			public function set ChangeSkin(value:Boolean):void
			{
				m_bChangeSkin = value;
				if( ( rosPhysicalBaseDTO.Notes && rosPhysicalBaseDTO.Notes.length > 0 ) || rosPhysicalBaseDTO.DictationID != Constants.GUID_FORMAT)
				{
					if( rosPhysicalBaseDTO.IsAbNormal == Constants.STRING_TRUE )
						id_Abnormal.setStyle("skinClass", ANotesRadioButton);
					
					if( rosPhysicalBaseDTO.IsNormal == Constants.STRING_TRUE)
						id_Normal.setStyle("skinClass", NNotesRadioButton);
				}
				else 
				{
					id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
					id_Normal.setStyle("skinClass", QINormalBtn);
				}	
			}
			
