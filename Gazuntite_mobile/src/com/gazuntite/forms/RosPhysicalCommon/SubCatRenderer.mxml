			private function getNotesPopupPosition():Point
			{
				if( this.y < 70 )
					var pLoc:Point = new Point( id_Contents.width , id_Contents.y );
				else
					pLoc = new Point( id_Contents.width , -this.y );
				
				var loc:Point = id_Contents.localToGlobal( pLoc );
				
				return loc;
			}
			
