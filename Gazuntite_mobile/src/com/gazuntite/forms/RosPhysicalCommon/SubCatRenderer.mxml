			private function NotesChanged(event:Event):void
			{
				rosPhysicalBaseDTO.Notes 			= event.currentTarget.text;
				rosPhysicalBaseDTO.IsDirty 			= true;
				id_Normal.selected		= false;
				rosPhysicalBaseDTO.IsNormal   		= Constants.STRING_FALSE;
				rosPhysicalBaseDTO.IsAbNormal   	= Constants.STRING_TRUE;
				
				if(notesBox.id_TextArea.text.length > 0)
				{
					id_Abnormal.setStyle("skinClass", ANotesRadioButton);
				}
				else
				{
					id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
				}
				
				dispatchEvent( new Event("dataIsDirty", true, true) );
			}
			
			private function removeNotesPopup():void
			{
				id_MainButton.setStyle("color", 0x222222);
				popGrp.removePopup();
				m_bIsOpen						= false;
				id_NotesSpacer.includeInLayout 	= false;
				id_NotesSpacer.visible			= false;
			}
			
			
			protected function itemrenderer1_focusOutHandler(event:Event):void
			{
				if( m_bIsOpen )
					removeNotesPopup();
			}
			
			
			
			private function onDataIsDirty(event:Event):void
			{
				//Tahir Alvi
				//if(rosPhysicalBaseDTO.Notes && rosPhysicalBaseDTO.Notes.length > 0)
				if(rosPhysicalBaseDTO.Notes && rosPhysicalBaseDTO.Notes.length > 0 && rosPhysicalBaseDTO.IsAbNormal == Constants.STRING_TRUE)
				{
					ChangeSkin = true; //id_NotesBtn.setStyle("skinClass", ImmunizationNotesFilledBtn);
				}
				else
				{
					ChangeSkin = false; //id_NotesBtn.setStyle("skinClass", WriteNotesBtn);
				}				
			}
			
			protected function itemrenderer1_creationCompleteHandler(event:FlexEvent):void
			{
				addEventListener("dataIsDirty" , onDataIsDirty );
				callLater( function():void
				{
					FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK,onStageClick);
					/* if( rosPhysicalBaseDTO.IsNormal == Constants.STRING_TRUE )
					id_Abnormal.selected = true;
					else */ 
					if( rosPhysicalBaseDTO.Notes )
					{
						//rosPhysicalBaseDTO.IsAbNormal = rosPhysicalBaseDTO.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
						
						if( rosPhysicalBaseDTO.Notes.length > 0 && rosPhysicalBaseDTO.IsAbNormal == Constants.STRING_TRUE)
						{
							id_Abnormal.setStyle("skinClass", ANotesRadioButton);
						}
						else if(rosPhysicalBaseDTO.Notes.length < 0 && rosPhysicalBaseDTO.IsAbNormal == Constants.STRING_FALSE)
						{
							id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
						}
						else if(rosPhysicalBaseDTO.Notes.length > 0 && rosPhysicalBaseDTO.IsNormal == Constants.STRING_TRUE)
						{
							id_Normal.setStyle("skinClass", NNotesRadioButton);
						}else 
						{
							id_Normal.setStyle("skinClass", QINormalBtn);
						}
						
					}
					ChangeSkin = true;
				});
			}
			
