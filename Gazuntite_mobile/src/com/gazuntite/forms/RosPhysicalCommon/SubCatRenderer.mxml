			protected function id_Normal_clickHandler(event:MouseEvent):void
			{
				///-- Tahir Alvi -- Normal Notes implementation --
				if(  popGrpN.isPopUp )
				{
					removeNormalNotesPopup();										
				}
				
				if( rosPhysicalBaseDTO.IsNormal && rosPhysicalBaseDTO.IsNormal == Constants.STRING_FALSE  )
				{
					//When A is selected & notes in Notes Window.
					if( rosPhysicalBaseDTO.Notes && rosPhysicalBaseDTO.Notes.length > 0)
						Alert.show("This action will clear abnormal notes, Are you sure you want to clear notes?","Clear Notes", Alert.YES|Alert.NO, 
							this, function(event:CloseEvent):void
							{
								if( event.detail == Alert.YES)
								{rosPhysicalBaseDTO
									rosPhysicalBaseDTO.IsNormal 		= Constants.STRING_TRUE;
									rosPhysicalBaseDTO.IsAbNormal 		= Constants.STRING_FALSE;
									rosPhysicalBaseDTO.Notes 			= null;
									//id_Abnormal.selected 	= false;
									id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
									dispatchEvent( new Event("dataIsDirty", true, true) );
								}
								else if( event.detail == Alert.NO)
								{
									// NO button was clicked
									id_Normal.selected = false;
									
								}
								RemovePopups();
								ChangeSkin = true;
							});
					else if(id_Abnormal.selected)//When A is selected but no notes in Notes Window.
					{
						rosPhysicalBaseDTO.IsNormal 		= Constants.STRING_TRUE;
						rosPhysicalBaseDTO.IsAbNormal 		= Constants.STRING_FALSE;
						id_Abnormal.selected 	= false;
						id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
						showNormalNotes(); 
					}
					else if( id_Normal.selected && ( rosPhysicalBaseDTO.Notes == null || rosPhysicalBaseDTO.Notes.length == 0 ) )
					{
						showNormalNotes(); 
						rosPhysicalBaseDTO.IsNormal = Constants.STRING_TRUE;
					}
				}
				else if(rosPhysicalBaseDTO.Notes && rosPhysicalBaseDTO.Notes.length > 0)
				{
					showNormalNotes(); 
					rosPhysicalBaseDTO.IsNormal = rosPhysicalBaseDTO.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					if( rosPhysicalBaseDTO.Notes.length > 0)
					{
						id_Normal.setStyle("skinClass", NNotesRadioButton);
					}
					else
					{
						id_Normal.setStyle("skinClass", QINormalBtn);
					}
				}
				else if( id_Normal.selected && ( rosPhysicalBaseDTO.Notes == null || rosPhysicalBaseDTO.Notes.length == 0 ) )
				{
					showNormalNotes(); 
					rosPhysicalBaseDTO.IsNormal = Constants.STRING_TRUE;
				}	
				else if( rosPhysicalBaseDTO.Notes == null || rosPhysicalBaseDTO.Notes.length == 0 )
				{
					id_Normal.selected = false;
					ChangeSkin = true;
					rosPhysicalBaseDTO.IsAbNormal = Constants.STRING_NULL;
				}	
				else
				{
					if( !id_Normal.selected && rosPhysicalBaseDTO.Notes ) 
						//id_Abnormal.selected		= rosPhysicalBaseDTO.Notes.length > 0;
						rosPhysicalBaseDTO.IsNormal = rosPhysicalBaseDTO.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					if( rosPhysicalBaseDTO.Notes.length > 0)
					{
						id_Normal.setStyle("skinClass", NNotesRadioButton);
					}
					else
					{
						id_Normal.setStyle("skinClass", QINormalBtn);
					}
				}	
				
				ChangeSkin = true;
				
				rosPhysicalBaseDTO.IsDirty 	= true;
				
				dispatchEvent( new Event("dataIsDirty", true, true) );
				
				
				QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.ROS);
			}
			
			protected function id_NotesBtn_clickHandler(event:MouseEvent):void
			{
				if(  popGrp.isPopUp )
				{
					removeNotesPopup();										
				}
				if( rosPhysicalBaseDTO.IsAbNormal && rosPhysicalBaseDTO.IsAbNormal == Constants.STRING_FALSE  )
				{
					//When N is selected & notes in Notes Window.
					if( rosPhysicalBaseDTO.Notes && rosPhysicalBaseDTO.Notes.length > 0)
						Alert.show("This action will clear normal notes, Are you sure you want to clear notes?","Clear Notes", Alert.YES|Alert.NO, 
							FlexGlobals.topLevelApplication as Sprite, function(ce:CloseEvent):void
							{
								if( ce.detail == Alert.YES)
								{
									rosPhysicalBaseDTO.IsNormal 		= Constants.STRING_FALSE;
									rosPhysicalBaseDTO.IsAbNormal 		= Constants.STRING_TRUE;
									rosPhysicalBaseDTO.Notes 			= null;
									//id_Abnormal.selected 	= false;
									id_Normal.setStyle("skinClass", QINormalBtn);
									dispatchEvent( new Event("dataIsDirty", true, true) );
								}
								else if( ce.detail == Alert.NO)
								{
									// NO button was clicked
									id_Abnormal.selected = false;
									
								}
								RemovePopups();
								ChangeSkin = true;
							});
					else if(id_Normal.selected || id_Abnormal.selected)
					{
						//When N is selected but no notes in Notes Window.
						rosPhysicalBaseDTO.IsNormal 		= Constants.STRING_FALSE;
						rosPhysicalBaseDTO.IsAbNormal 		= Constants.STRING_TRUE;
						id_Normal.selected = false;
						id_Normal.setStyle("skinClass", QINormalBtn);
						showNotes();
					}
					
				}else if(UtilityFunctions.IsNotNullOrEmpty( rosPhysicalBaseDTO.Notes ) && UtilityFunctions.IsNotNullOrEmpty( rosPhysicalBaseDTO.DictationID ) && ( rosPhysicalBaseDTO.Notes.length > 0 || rosPhysicalBaseDTO.DictationID != Constants.GUID_FORMAT ) )
				{
					showNotes();
					//id_Abnormal.selected		= rosPhysicalBaseDTO.Notes.length > 0;
					rosPhysicalBaseDTO.IsAbNormal = rosPhysicalBaseDTO.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					if( rosPhysicalBaseDTO.Notes.length > 0 || rosPhysicalBaseDTO.DictationID != Constants.GUID_FORMAT)
					{
						id_Abnormal.setStyle("skinClass", ANotesRadioButton);
					}
					else
					{
						id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
					}
				}
				else if( id_Abnormal.selected && ( rosPhysicalBaseDTO.Notes == null || rosPhysicalBaseDTO.Notes.length == 0 ) )
				{
					showNotes();
					rosPhysicalBaseDTO.IsAbNormal = Constants.STRING_TRUE;
				}
				else if( rosPhysicalBaseDTO.Notes == null || rosPhysicalBaseDTO.Notes.length == 0 )
				{
					id_Abnormal.selected = false;
					ChangeSkin = true;
					rosPhysicalBaseDTO.IsNormal = Constants.STRING_NULL;
				}
				else
				{
					if( !id_Abnormal.selected && rosPhysicalBaseDTO.Notes ) 
						//id_Abnormal.selected		= rosPhysicalBaseDTO.Notes.length > 0;
						rosPhysicalBaseDTO.IsAbNormal = rosPhysicalBaseDTO.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					if( rosPhysicalBaseDTO.Notes.length > 0)
					{
						id_Abnormal.setStyle("skinClass", ANotesRadioButton);
					}
					else
					{
						id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
					}
				}
				
				rosPhysicalBaseDTO.IsDirty 	   = true;
				dispatchEvent( new Event("dataIsDirty", true, true) );
			}
			
