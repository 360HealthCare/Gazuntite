<?xml version="1.0" encoding="utf-8"?>
<quickInput:PMHSectionHeader xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:quickInput="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.*" 
							 xmlns:comprehensiveHistory="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.comprehensiveHistory.*"
							 >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			


			protected function id_SpinerList_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
			}

		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:HGroup width="100%" horizontalAlign="left" verticalAlign="middle">
		<s:HGroup paddingTop="-1" horizontalAlign="left">			
		<comprehensiveHistory:SpinerList id="id_SpinerList" width="130" DataProvider="{model.rosDTOList}" click="id_SpinerList_clickHandler(event)"	/>
		</s:HGroup>
		<mx:Spacer width="100%" />
		<s:HGroup width="100%" horizontalAlign="right" paddingTop="0">					
		<s:Button id="id_AllNormalBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.ROSallNormalBtn" toolTip="All Normal" buttonMode="true" />
		</s:HGroup>
	</s:HGroup>
	
	
</quickInput:PMHSectionHeader>
