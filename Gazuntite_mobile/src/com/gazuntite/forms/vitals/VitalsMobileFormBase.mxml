<?xml version="1.0" encoding="utf-8"?>
<forms:MobileFormBase xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:controls="com.gazuntite.components.controls.*"
					  width="100%" 
					  height="100%"
					  creationComplete="init(event)"
					  xmlns:spicefactory="http://www.spicefactory.org/parsley"
					  xmlns:forms="com.gazuntite.forms.*">
	
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<!-- this is just for testing Parsley -->
	<fx:Metadata>
		[ManagedEvents("saveFormData")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			public function set selectedRecord(value:ObjectProxy):void
			{
				_selectedRecord = value;
				setForm();
			}
			
			protected function validateForm():Boolean
			{
				
				return true;
			}
			
			protected function addRecord(event:MouseEvent):void
			{
				
				if(validateForm())
				{
					// dummy data for test binding
					var r:ObjectProxy = new ObjectProxy();
					r.height = id_height.textDisplay.text;
					r.weight = id_weight.textDisplay.text;
					
					r.temp 	= id_temp.textDisplay.text;
					r.pulse = id_pulse.textDisplay.text;
					r.resp 	= id_resp.textDisplay.text;
					r.o2 	= id_o2.textDisplay.text;
					r.bp 	= id_bp.textDisplay.text;
					r.bp2 	= id_bp2.textDisplay.text;					
					
					
					
					
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
					e.payload = r;
					
					if(_isEditForm)
					{
						e.isUpdate = true;
					}else
						
					{
						clearForm();
					}
					
					dispatchEvent(e);
					
				} 
			}
			
			protected function updateRecord(event:MouseEvent):void
			{
				
				if(validateForm())
				{
					// dummy data for test binding
					var r:ObjectProxy = new ObjectProxy();
					r.height = id_height.textDisplay.text;
					r.weight = id_weight.textDisplay.text;
					
					r.temp 	= id_temp.textDisplay.text;
					r.pulse = id_pulse.textDisplay.text;
					r.resp 	= id_resp.textDisplay.text;
					r.o2 	= id_o2.textDisplay.text;
					r.bp 	= id_bp.textDisplay.text;
					r.bp2 	= id_bp2.textDisplay.text;					
					
					
					
					
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
					e.payload = r;
					
					if(_isEditForm)
					{
						e.isUpdate = true;
					}else
						
					{
						clearForm();
					}
					dispatchEvent(e);
					
				} 
			}
			
			protected function setForm():void
			{
				//this.currentState = "presentation";
				id_height.textDisplay.text = _selectedRecord.height;
				id_weight.textDisplay.text = _selectedRecord.weight;
				
				
			}
			
			protected function clearForm():void
			{
				
				id_height.textDisplay.text = "";
				id_weight.textDisplay.text = "";
				
				id_temp.textDisplay.text = "";
				id_pulse.textDisplay.text = "";
				id_resp.textDisplay.text = "";
				id_o2.textDisplay.text = "";
				id_bp.textDisplay.text = "";
				id_bp2.textDisplay.text = "";	
			}
			
			protected function init(event:FlexEvent):void
			{
				if(sharedModel.vitalsAC.length > 0)
				{
					_selectedRecord = sharedModel.vitalsAC.getItemAt(0) as ObjectProxy;
				}
				
			}
			
		]]>
	</fx:Script>
	<forms:states>			
		<s:State name="normal"/>
		<s:State name="presentation"/>
	</forms:states>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<forms:layout>
		
		
		<s:VerticalLayout paddingBottom="0"
						  paddingLeft="3"
						  paddingRight="3"
						  paddingTop="5"
						  gap="1"
						  horizontalAlign="center"
						  verticalAlign="top"/>
	</forms:layout>
	
	<s:BorderContainer id="presentationForm" 
					   width="100%"
					   height="100%"
					   borderWeight="0" 
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="0">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xf3f3f3"/>
				<s:GradientEntry color="0xffffff"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:VerticalLayout paddingBottom="0"
							  paddingLeft="10"
							  paddingRight="10"
							  paddingTop="5"
							  gap="5"/>
		</s:layout>
		
		<s:HGroup height="100%">
			<s:Image source="assets/done.png" includeInLayout="{_isEditForm}"/>
			
			<s:VGroup width="100%">
				
				
				
				<s:HGroup width="100%"
						  id="g1"
						  styleName="ipeForm" 
						  horizontalAlign="center" >
					
					
					<s:VGroup>
						<s:Label text="Height" />		
						<s:NumericStepper id="id_height" width="40" />
					</s:VGroup>
					<s:VGroup>
						<s:Label text="Weight" />		
						<s:NumericStepper id="id_weight" width="40" />
					</s:VGroup>
					<s:VGroup>
						<s:Label text="Temp" />		
						<s:NumericStepper id="id_temp" width="40" />
					</s:VGroup>
					<s:VGroup>
						<s:Label text="Pulse" />		
						<s:NumericStepper id="id_pulse" width="40" />
					</s:VGroup>
					<s:VGroup>
						<s:Label text="Resp" />		
						<s:NumericStepper id="id_resp" width="40" />
					</s:VGroup>
					<s:VGroup>
						<s:Label text="O2" />		
						<s:TextInput id="id_o2" text="" width="20" skinClass="spark.skins.spark.TextInputSkin"/>
					</s:VGroup>
					
					<s:VGroup>
						<s:Label text="Blood Pressure" />
						<s:HGroup>			
							<s:NumericStepper id="id_bp" width="30" />
							<s:NumericStepper id="id_bp2" width="30" />
							
						</s:HGroup>
					</s:VGroup>
					<s:VGroup>
						<s:Label text="BMI" />		
						<s:TextInput text="" width="20" editable="false" 
									 skinClass="spark.skins.spark.TextInputSkin"/>
					</s:VGroup>
					
					
				</s:HGroup>
				
				
				<s:Button id="actionBtn2"
						  styleName="button"
						  label="Save"
						  click="updateRecord(event)"/>
				
			</s:VGroup>
			
			
			
		</s:HGroup>
		
	</s:BorderContainer>
	
	
	<!-- end presentation form -->
	
	
	
</forms:MobileFormBase>
