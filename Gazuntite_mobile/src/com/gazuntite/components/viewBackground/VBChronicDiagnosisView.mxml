<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:components="com.gazuntite.components.*"
		 width="100%"
		 height="100%"
		 creationComplete="init(event)" 
		 xmlns:forms="com.gazuntite.forms.*" 
		 xmlns:input="com.gazuntite.view.controls.custom.patientExamView.quickInput.immunization.input.*" 
		 xmlns:controls="com.gazuntite.components.controls.*" 
		 xmlns:spicefactory="http://www.spicefactory.org/parsley" 
		 xmlns:allergies="com.gazuntite.forms.allergies.*" 
		 xmlns:viewBackground="com.gazuntite.components.viewBackground.*">
	
	<fx:Metadata>
		[Event(name="close", type="mx.events.CloseEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.components.itemrenderers.viewBackground.VBChronicDiagnosisItemRenderer;
			import com.gazuntite.components.itemrenderers.viewBackground.VBPrescriptionsItemRenderer;
			import com.gazuntite.events.ArrangeByEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			protected var selectedRecord:int;
			
			[Bindable]
			protected var editObject:ObjectProxy;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			protected function init(event:FlexEvent):void
			{
				// DF: need logic to pull only the most recent 5 data items from each ArrayCollection as per requirements I believe
				
			}
			
			protected function list_changeHandler(event:IndexChangeEvent):void
			{
				editObject = list.selectedItem;
			}
			
			protected function arrangebycalloutbutton1_arrangeByHandler(event:ArrangeByEvent):void
			{
				//trace(event.field);
				
				var l:List;
				l = list;
				
				switch(event.field)
				{
					case "ICD Code":
						l.itemRenderer = new ClassFactory(VBChronicDiagnosisItemRenderer);
						break;
				} 
			}
			
			protected function closeButtonClickHandler(event:MouseEvent):void
			{
				var e:CloseEvent = new CloseEvent(CloseEvent.CLOSE);
				dispatchEvent(e);
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout paddingBottom="0"
						  paddingLeft="0"
						  paddingRight="0"
						  paddingTop="0"
						  gap="0"/>
	</s:layout>
	
	<s:BorderContainer width="100%"
					   height="24"
					   borderWeight="1" 
					   borderColor="0x898989"
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="1">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0x898989" ratio=".1"/>
				<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:HorizontalLayout verticalAlign="bottom" 
								paddingLeft="10"
								paddingBottom="10"/>
		</s:layout>
		<controls:ArrangeByCalloutButton label="Arrange By:"
										 color="0x000000"
										 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object name="ICD Code"/>
					<fx:Object name="ICD Description"/>
					<fx:Object name="OnSet"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:ArrangeByCalloutButton>
		
		<s:Label text="Chronic Medications:" 
				 styleName="listLabel"/>
		
		<s:HGroup width="100%" horizontalAlign="right">
			<s:Button click="closeButtonClickHandler(event)" />
		</s:HGroup>
		
	</s:BorderContainer>
	
	<s:HGroup width="100%" height="100%">
		
		<s:List id="list" 
				width="40%"
				height="100%"
				change="list_changeHandler(event)"
				dataProvider="{sharedModel.diagnosisHistoryAC}"
				contentBackgroundColor="0xffffff"
				itemRenderer="com.gazuntite.components.itemrenderers.viewBackground.VBChronicDiagnosisItemRenderer"
				horizontalScrollPolicy="off"/>
		
		<viewBackground:VBChronicMedicationPresentationForm width="100%" 
															height="100%" 
															selectedRecord="{editObject}"/>
		
	</s:HGroup>
	
	
</s:Group>
