<?xml version="1.0" encoding="utf-8"?>
<dualpanel1:DualPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:dualpanel="com.riavalue.components.dualpanel.*" 
					  xmlns:components="com.gazuntite.components.*"
					  width="100%"
					  height="100%"
					  transitionDuration="300"
					  skinClass="com.riavalue.components.dualpanel.SpinSkin"
					  creationComplete="init(event)" 
					  xmlns:forms="com.gazuntite.forms.*" 
					  xmlns:input="com.gazuntite.view.controls.custom.patientExamView.quickInput.immunization.input.*" 
					  xmlns:controls="com.gazuntite.components.controls.*" 
					  xmlns:skins="com.gazuntite.skins.*" 
					  xmlns:dualpanel1="com.riavalue.components.dualpanel.*"
					  xmlns:spicefactory="http://www.spicefactory.org/parsley" 
					  xmlns:immunization="com.gazuntite.forms.immunization.*">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.components.itemrenderers.immunization.AssociatedWithFieldItemRenderer;
			import com.gazuntite.components.itemrenderers.immunization.DoseFieldItemRenderer;
			import com.gazuntite.components.itemrenderers.immunization.ImmunizationFieldItemRenderer;
			import com.gazuntite.events.ArrangeByEvent;
			import com.gazuntite.events.OptionsButtonClickedEvent;
			import com.gazuntite.events.PinViewEvent;
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.events.ToggleFormOptionsEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			import spark.components.supportClasses.ListBase;
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			protected var selectedRecord:int;
			
			[Bindable]
			protected var editObject:ObjectProxy;
			
			[Bindable]
			protected var notes:Boolean = true;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			protected function init(event:FlexEvent):void
			{
				this.currentState = "normal";
				
				this.prefsButton.addEventListener(MouseEvent.CLICK, handlePrefsButtonClick);
			}
			
			protected function handlePrefsButtonClick(event:MouseEvent):void
			{
				
				if(sharedModel.addedImmunizationsAC.length > 0)
				{
					editObject = list.selectedItem as ObjectProxy;
				}
				
				if(editObject == null)
				{
					if(sharedModel.immunizationHistoryAC.length > 0)
					{
						editObject = sharedModel.immunizationHistoryAC.getItemAt(0) as ObjectProxy;
					}
				}
				
				resetState();
			}
			
			protected function resetState():void
			{
				trace("start: " + this.currentState);
				
				if(this.currentState == "normal")
				{
					this.currentState = "normalFlipped";
					invalidateDisplayList();
					return;
				}
				
				if(this.currentState == "normalFlipped")
				{
					this.currentState = "normal";
					invalidateDisplayList();
					return;
				}
			}
			
			protected function list_changeHandler(event:IndexChangeEvent):void
			{
				editObject = list.selectedItem;
				
				selectedRecord = list.selectedIndex;
				
				toggleStateHandler();
				
				resetState();
			}
			
			protected function detailList_changeHandler(event:IndexChangeEvent):void
			{
				editObject = detailList.selectedItem;
			}
			
			
			protected function toggleFormOptionsHandler(event:ToggleFormOptionsEvent):void
			{
				
				if(this.currentState == "fullForm")
				{
					this.currentState = "normal";
					return;
				}
				
				if(event.full && this.currentState == "normal")
				{
					this.currentState = "fullForm";	
					return;
				}
				
			}
			
			protected function saveFormDataHandler(event:SaveFormDataEvent):void
			{
				if(event.payload != null)
				{
					if(event.isUpdate)
					{
						// save updated form item
						var i:int = detailList.selectedIndex;
						sharedModel.immunizationHistoryAC.setItemAt(event.payload, i);
						editObject = sharedModel.immunizationHistoryAC.getItemAt(i) as ObjectProxy;
					}else
					{
						sharedModel.addedImmunizationsAC.addItem(event.payload);
						sharedModel.immunizationHistoryAC.addItem(event.payload);
					}
					
				}
				
				invalidateDisplayList();
				
			}
			
			protected function updateEditObject():void
			{
				editObject = detailList.selectedItem;
			}
			
			protected function previousBtnClickHandler(event:MouseEvent):void
			{
				if(detailList.selectedIndex != 0)
				{
					detailList.selectedIndex--;
					detailList.invalidateDisplayList();
					updateEditObject();
				}
				
			}
			
			protected function nextBtnClickHandler(event:MouseEvent):void
			{
				if(detailList.selectedIndex < sharedModel.immunizationHistoryAC.length)
				{
					detailList.selectedIndex++;
					detailList.invalidateDisplayList();
					updateEditObject();
				}
			}
			
			protected function optionsButtonClickedHandler(event:OptionsButtonClickedEvent):void
			{
				if(!event.notes)
				{
					notes = false;
				}else
				{
					notes = true;
				}
			}
			
			protected function pinBtnClickHandler(event:MouseEvent):void
			{
				var e:PinViewEvent = new PinViewEvent(PinViewEvent.PIN_VIEW_EVENT, true);
				dispatchEvent(e);
			}
			
			
			protected function arrangebycalloutbutton1_arrangeByHandler(event:ArrangeByEvent):void
			{
				//trace(event.field);
				
				var l:ListBase; // we don't know yet if this is a List or SpinnerList we're dealing with
				
				if(this.currentState == "normal")
				{
					l = list;
				}else
				{
					l = detailList;
				}
				
				switch(event.field)
				{
					case "Associated With":
						l.itemRenderer = new ClassFactory(AssociatedWithFieldItemRenderer);
						break;
					case "Immunization":
						l.itemRenderer = new ClassFactory(ImmunizationFieldItemRenderer);
						break;
					case "Dose":
						l.itemRenderer = new ClassFactory(DoseFieldItemRenderer);
						break;
				}
			}  
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<dualpanel:states>
		<s:State name="normal"/>
		<s:State name="normalFlipped"/>
	</dualpanel:states> 
	
	<!-- dual panel views -->

	<dualpanel:frontView>
		<controls:CoverFlowPanelView id="frontPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Immunization: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 controlBarVisible="false">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				<immunization:QIImmunizationMobileForm id="immunizationForm"
													   width="100%" 
													   saveFormData="saveFormDataHandler(event)"/>
				
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
					<controls:ArrangeByCalloutButton label="Arrange By:"
													 color="0x000000"
													 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
						<controls:dataProvider>
							<s:ArrayCollection>
								<fx:Object name="Associated With"/>
								<fx:Object name="Immunization"/>
								<fx:Object name="Dose"/>
							</s:ArrayCollection>
						</controls:dataProvider>
					</controls:ArrangeByCalloutButton>
					
					<s:Label text="Immunization records added:" styleName="listLabel"/>
					
				</s:BorderContainer>
				
				<s:List id="list"
						width="100%"
						height="100%"
						contentBackgroundColor="0xffffff"
						dataProvider="{sharedModel.addedImmunizationsAC}"
						itemRenderer="com.gazuntite.components.itemrenderers.immunization.ImmunizationFieldItemRenderer"/>
				
			</s:BorderContainer>
			
		</controls:CoverFlowPanelView>
		
	</dualpanel:frontView>
	
	<!-- Back view dual panel -->
	
	<dualpanel:backView>
		<controls:CoverFlowPanelView id="backPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Immunization History: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 controlBarVisible="false"
									 optionsButtonClicked="optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				<immunization:QIImmunizationMobileHistoryForm id="immunizationFormFlipped"
															  width="100%"
															  selectedRecord="{editObject}"
															  saveFormData="saveFormDataHandler(event)"/>
				
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
					<controls:ArrangeByCalloutButton label="Arrange By:"
													 color="0x000000"
													 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
						<controls:dataProvider>
							<s:ArrayCollection>
								<fx:Object name="Associated With"/>
								<fx:Object name="Immunization"/>
								<fx:Object name="Dose"/>
							</s:ArrayCollection>
						</controls:dataProvider>
					</controls:ArrangeByCalloutButton>
					
					<s:Label text="Immunization History records added:" styleName="listLabel"/>
					
				</s:BorderContainer>
				
				<!--
				
				DF: we may still use these, so don't delete the code
				
				<s:SpinnerListContainer width="100%"
										height="100%"
										skinClass="com.gazuntite.skins.SpinnerIndicatorContainerSkin">
					
					<s:SpinnerList id="detailList"
								   width="100%"
								   height="100%"
								   change="detailList_changeHandler(event)"
								   dataProvider="{sharedModel.immunizationHistoryAC}"
								   itemRenderer="com.gazuntite.components.itemrenderers.immunization.ImmunizationFieldItemRenderer"/>
				</s:SpinnerListContainer>-->
				
				<s:List id="detailList"
							   width="100%"
							   height="100%"
							   change="detailList_changeHandler(event)"
							   dataProvider="{sharedModel.immunizationHistoryAC}"
							   itemRenderer="com.gazuntite.components.itemrenderers.immunization.ImmunizationFieldItemRenderer"/>
				
			</s:BorderContainer>
			
		</controls:CoverFlowPanelView>
	</dualpanel:backView>
	
</dualpanel1:DualPanel>
