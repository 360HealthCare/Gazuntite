<?xml version="1.0" encoding="utf-8"?>
<dualpanel:DualPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					 xmlns:s="library://ns.adobe.com/flex/spark" 
					 xmlns:mx="library://ns.adobe.com/flex/mx" 
					 xmlns:dualpanel="com.riavalue.components.dualpanel.*"
					 xmlns:spicefactory="http://www.spicefactory.org/parsley" 
					 xmlns:controls="com.gazuntite.components.controls.*"
					 
					 skinClass="com.riavalue.components.dualpanel.SpinSkin"
					 
					 width="100%"
					 height="100%"
					 transitionDuration="300" 
					 xmlns:treatment="com.gazuntite.forms.treatment.*" 
					 creationComplete="creationCompleteHandler(event)"
					 xmlns:procedure="com.gazuntite.forms.treatment.procedure.*" 
					 xmlns:prescription="com.gazuntite.forms.treatment.prescription.*"
					 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.ArrangeByEvent;
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.model.SharedModel;
			import com.gazuntite.services.valueObjects.Treatment.PrescriptionDTO;
			import com.gazuntite.services.valueObjects.Treatment.ProcedureDTO;
			
			import mx.events.FlexEvent;
			
			import spark.components.supportClasses.ListBase;
			
			
			[Bindable]
			protected var editObject:Object;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			protected function creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			
			protected function saveProcedureDataHandler(event:SaveFormDataEvent):void
			{
				if(event.payload != null)
				{
					if(event.isUpdate)
					{
						// save updated form item
						var i:int =id_ProcedureFormBV.id_SortableList.id_ListView.selectedIndex;
						sharedModel.procedureAC.setItemAt(event.payload, i);
						editObject = sharedModel.procedureAC.getItemAt(i) as ProcedureDTO;
					}
					else
					{
						sharedModel.addedProcedureAC.addItem(event.payload);
						sharedModel.procedureAC.addItem(event.payload);
					}
					
				} 
				
				invalidateDisplayList();
				
			}
			
			protected function savePrescriptionDataHandler(event:SaveFormDataEvent):void
			{
				if(event.payload != null)
				{
					if(event.isUpdate)
					{
						// save updated form item
						var i:int =id_ProcedureFormBV.id_SortableList.id_ListView.selectedIndex;
						sharedModel.PrescriptionAC.setItemAt(event.payload, i);
						editObject = sharedModel.PrescriptionAC.getItemAt(i) as PrescriptionDTO;
					}
					else
					{
						sharedModel.addedPrescriptionAC.addItem(event.payload);
						sharedModel.PrescriptionAC.addItem(event.payload);
					}
					
				} 
				
				invalidateDisplayList();
				
			}
			
			
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<dualpanel:states>
		<s:State name="normal"/>
		<s:State name="normalFlipped"/>
	</dualpanel:states> 
	
	
	<dualpanel:frontView>
		
		<controls:CoverFlowPanelView id="id_CFPFrontView"
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 title="{'Treatment: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 
									 >
			<controls:layout>
				<s:VerticalLayout paddingBottom="0"
								  paddingLeft="0"
								  paddingRight="0"
								  paddingTop="0"
								  horizontalAlign="center"/>
			</controls:layout>
			
			<s:TabBar width="100%" dataProvider="{vs}" />
			
			<mx:ViewStack id="vs" width="100%" height="100%" >
				<s:NavigatorContent  width="100%" height="100%" label="Prescription" >	
					<prescription:PrescriptionForm id="id_prescriptionFormFV" saveFormData="savePrescriptionDataHandler(event)" dataProvider="{sharedModel.addedPrescriptionAC}" width="100%" height="100%" />
					<!--<s:Label text="Add prescription here" /> 	-->				
				</s:NavigatorContent>
				<s:NavigatorContent  width="100%" height="100%" label="Procedure" >
					<procedure:ProcedureForm id="id_ProcedureFormFV" saveFormData="saveProcedureDataHandler(event)" dataProvider="{sharedModel.addedProcedureAC}"  width="100%" height="100%" />				
				</s:NavigatorContent>
			</mx:ViewStack>
			
		</controls:CoverFlowPanelView>
		
		
		
	</dualpanel:frontView>
	
	
	<dualpanel:backView>
		
		
		<controls:CoverFlowPanelView id="id_CFPBackView"
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 title="{'Treatment: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 
									 >
			<controls:layout>
				<s:VerticalLayout paddingBottom="0"
								  paddingLeft="0"
								  paddingRight="0"
								  paddingTop="0"
								  horizontalAlign="center"/>
			</controls:layout>
			
		<!--<procedure:ProcedureForm id="id_ProcedureFormBV" dataProvider="{sharedModel.procedureAC}" width="100%" height="100%" />			-->
			
			<s:TabBar width="100%" dataProvider="{vsBV}" />
			
			<mx:ViewStack id="vsBV" width="100%" height="100%" >
				<s:NavigatorContent  width="100%" height="100%" label="Prescription" >	
					<prescription:PrescriptionForm id="id_prescriptionFormBV" saveFormData="savePrescriptionDataHandler(event)" dataProvider="{sharedModel.addedPrescriptionAC}" width="100%" height="100%" />
					<!--<s:Label text="Add prescription here" /> 	-->				
				</s:NavigatorContent>
				<s:NavigatorContent  width="100%" height="100%" label="Procedure" >
					<procedure:ProcedureForm id="id_ProcedureFormBV" saveFormData="saveProcedureDataHandler(event)" dataProvider="{sharedModel.addedProcedureAC}"  width="100%" height="100%" />				
				</s:NavigatorContent>
			</mx:ViewStack>
			
		</controls:CoverFlowPanelView>
		
		
		
	</dualpanel:backView>
	
</dualpanel:DualPanel>
