<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 tabChildren="true">
	
	<fx:Script>
		<![CDATA[
			
			import mx.events.ItemClickEvent;
			
			private var m_sLabel:String;
			private var m_sCounter:int;
			
			public var indicator:String;
			
			/**
			 * 
			 * @param 1 string value,selected value 'Yes' or 'No'
			 * @param 2 string value,section label where clicked
			 * 
			 */	
			public var YesNoClickHandler:Function;
			/**
			 * 
			 * @PARAM 1 MOUSE EVENT RELATED TO BUTTON CLICK
			 * @PARAM 2 STRING VALUE,SECTION lABEL WHERE CLICKED
			 * 
			 */	
			public var ButtonClickHandler:Function;
			
			[Bindable]
			public function get Label():String
			{
				return m_sLabel;
			}
			
			public function set Label(value:String):void
			{
				m_sLabel = value;
			}
			
			protected function buttonbarbutton1_clickHandler(event:MouseEvent):void
			{
				ButtonClickHandler(event, Label);
			}
			
			protected function rbGroup_itemClickHandler(event:ItemClickEvent):void
			{
				YesNoClickHandler( event.item, Label, this);
			}
			
			public function set showOptionButtons(value:String):void
			{
				id_Y.visible 			= false;
				id_Y.includeInLayout 	= false;
				id_U.visible 			= false;
				id_U.includeInLayout 	= false;
				id_N.visible 			= false;
				id_N.includeInLayout 	= false;
				id_M.visible 			= false;
				id_M.includeInLayout 	= false;
				id_R.visible 			= false;
				id_R.includeInLayout 	= false;
				id_S.visible 			= false;
				id_S.includeInLayout 	= false;
				id_D.visible 			= false;
				id_D.includeInLayout 	= false;
				id_W.visible 			= false;
				id_W.includeInLayout 	= false;
				
				for( var i:int = 0; i < value.length; i++ )
				{
					trace( value.charAt( i ) )
					switch( value.charAt( i ).toLowerCase() )
					{
						case 'y':
							id_Y.visible = true;
							id_Y.includeInLayout = true;
							break;
						case 'u':
							id_U.visible = true;
							id_U.includeInLayout = true;
							break;
						case 'n':
							id_N.visible = true;
							id_N.includeInLayout = true;
							break;
						case 'm':
							id_M.visible = true;
							id_M.includeInLayout = true;
							break;
						/* case 'r':
						id_R.visible = true;
						id_R.includeInLayout = true;
						break; */
						case 's':
							id_S.visible = true;
							id_S.includeInLayout = true;
							break;
						case 'd':
							id_D.visible = true;
							id_D.includeInLayout = true;
							break;
						case 'w':
							id_W.visible = true;
							id_W.includeInLayout = true;
							break;
					}
				}
				
			}
			
			
			protected function set ChangeLabelCase(value:Boolean):void
			{
				if( value )
				{
					id_MainButton.label = id_MainButton.label.toUpperCase();
				}
				else
				{
					//id_MainButton.label = AppUtils.TitleCase( id_MainButton.label );
				}
			}
			
			
			protected function rbGroup_changeHandler(event:Event):void
			{
				YesNoClickHandler( event.currentTarget.selectedValue, Label, this);
				indicator = event.currentTarget.selectedValue;
			}
			
			[Bindable]
			public function get Counter():int
			{
				return m_sCounter;
			}
			
			public function set Counter(value:int):void
			{
				m_sCounter = value;
			}
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="rbGroup" change="rbGroup_changeHandler(event)" />
	</fx:Declarations>
	
	<s:ToggleButton minWidth="110" 
					id="id_MainButton" 
					maxWidth="131" 
					width="100%" 
					label="{Label}" 
					toolTip="Total record count: {Counter}" 
					click="buttonbarbutton1_clickHandler(event)"
					textAlignLast="left" 
					height="100%" 
					skinClass="com.gazuntite.skins.QIVerticalTabs"/>
	
	<s:HGroup left="0" 
			  width="100%" 
			  height="{id_MainButton.height}"  
			  tabEnabled="true" 
			  tabChildren="true" 
			  verticalAlign="middle" 
			  gap="0" 
			  horizontalAlign="right" 
			  right="2" 
			  paddingRight="5" 
			  paddingLeft="-11">
		
		
		<s:RadioButton id="id_Y" 
					   groupName="rbGroup" 
					   value="Y" 
					   visible="true"
					   toolTip="Yes"  
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.YRadioButton"
					   />
		
		<s:RadioButton id="id_U" 
					   groupName="rbGroup" 
					   value="U" 
					   visible="true" 
					   toolTip="Unknown"  
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.URadioButton"
					   />
		
		<s:RadioButton id="id_N" 
					   groupName="rbGroup" 
					   value="N"
					   visible="true" 
					   toolTip="No" 
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.NRadioButton"/>
		
		<s:RadioButton id="id_M" 
					   groupName="rbGroup" 
					   value="M" 
					   visible="true" 
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.MRadioButton" 
					   toolTip="Married"/>
		
		<s:RadioButton id="id_R" 
					   groupName="rbGroup" 
					   value="Record" 
					   visible="false" 
					   includeInLayout="false" 
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.RRadioButton"/>
		
		<s:RadioButton id="id_S" 
					   groupName="rbGroup" 
					   value="S" 
					   visible="true" 
					   toolTip="Single" 
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.SRadioButton"/>
		
		<s:RadioButton id="id_D" 
					   groupName="rbGroup" 
					   value="D" 
					   visible="true" 
					   toolTip="Divorced" 
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.DRadioButton"/>
		
		<s:RadioButton id="id_W" 
					   groupName="rbGroup" 
					   value="W" 
					   visible="true" 
					   toolTip="Widow" 
					   buttonMode="true" 
					   useHandCursor="true"
					   skinClass="com.gazuntite.skins.radioButton.WRadioButton"
					   />
		
		
	</s:HGroup>
	
	
</s:Group>
