<?xml version="1.0" encoding="utf-8"?>
<s:CalloutButton xmlns:fx="http://ns.adobe.com/mxml/2009" 
				 xmlns:s="library://ns.adobe.com/flex/spark" 
				 xmlns:mx="library://ns.adobe.com/flex/mx"
				 creationComplete="init(event)" 
				 xmlns:ns="library://ns.tink.ws/flex/spark" 
				 xmlns:controls="com.gazuntite.components.controls.*"
				 xmlns:dictation="com.gazuntite.media.dictation.*" 
				 calloutDestructionPolicy="auto">
	
	<fx:Metadata>
		[Event(name="optionsButtonClicked", type="com.gazuntite.events.OptionsButtonClickedEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.OptionsButtonClickedEvent;
			
			import mx.events.FlexEvent;
			
			protected function init(event:FlexEvent):void
			{
				
			}
			
			protected function handleClick(event:MouseEvent):void
			{
				
				if(event.currentTarget.id == "dictationBtn")
				{
					this.currentState = "dictation";
				}else
				{
					this.currentState = "notes";
				}
				
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				// save note or dictation
				this.closeDropDown();
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="notes"/>
		<s:State name="dictation"/>
	</s:states>
	
	<s:calloutLayout>
		<s:VerticalLayout horizontalAlign="center"
						  paddingBottom="5"
						  paddingLeft="5"
						  paddingRight="5"
						  paddingTop="5"/>
	</s:calloutLayout>
	
	<s:VGroup minWidth="200" maxHeight="450" horizontalAlign="center">
		
		<s:HGroup horizontalAlign="center">
			<s:Button id="notesBtn"
					  useHandCursor="true"
					  buttonMode="true"
					  click="handleClick(event)"/>
			<s:Button id="dictationBtn"
					  useHandCursor="true"
					  buttonMode="true"
					  click="handleClick(event)"/>
		</s:HGroup>
		
		<controls:Notes includeIn="notes" width="100%" />
		<dictation:Dictation includeIn="dictation" 
						 width="100%" 
						 height="100%"/>
		
		<s:HGroup excludeFrom="normal" horizontalAlign="center">
			<s:Button label="Save" 
					  styleName="button"
					  click="button1_clickHandler(event)"/>
			
			<s:Button label="Close" 
					  styleName="button"
					  click="{this.closeDropDown()}"/>
		</s:HGroup>
		
		
	</s:VGroup>
	
</s:CalloutButton>
