<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:controls="com.gazuntite.components.controls.*"
		 creationComplete="init(event)">
	
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected var _selected:Boolean = false;
			
			[Bindable]
			protected var _label:String;
			
			public function get label():String
			{
				return _label;
			}

			public function set label(value:String):void
			{
				_label = value;
			}

			[Bindable]
			public function get selected():Boolean
			{
				return _selected;
			}

			public function set selected(value:Boolean):void
			{
				_selected = value;
				ts.selected = value;
			}

			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function ts_changeHandler(event:Event):void
			{
				selected = event.currentTarget.selected;
				trace(ts.selected);
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:HorizontalLayout gap="5"
							paddingLeft="2"
							verticalAlign="middle"/>
	</s:layout>
	
	<s:Label text="{_label}"/>
	
	<controls:ToggleSwitch id="ts" 
						   selectedLabel="Yes" 
						   deselectedLabel="No" 
						   skinClass="com.gazuntite.skins.ToggleSwitchSkin"
						   click="ts_changeHandler(event)"/>
	
</s:Group>
