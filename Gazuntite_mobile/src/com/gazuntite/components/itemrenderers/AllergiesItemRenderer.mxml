<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				width="100%" 
				height="100%"
				minHeight="40" 
				contentBackgroundAlpha="0">
	
	<s:layout>
		<s:VerticalLayout paddingBottom="0"
						  paddingRight="10"
						  paddingTop="0"
						  paddingLeft="10"/>
	</s:layout>
	
	<s:Group width="100%" height="100%">
		
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle"/>
		</s:layout>
		
		<s:Label text="{itemIndex + 1}"/>
		
		<s:Label fontWeight="bold" text="{data.allergy}"/>
		
		<s:Label fontSize="10" text="{data.onSet}"/>
		
		<s:Label text="{data.reaction != null ? data.reaction : ' --- '}"/>
		
		<s:Label text="{data.status != null ? data.status : ' --- '}"/>
		
	</s:Group>
	
</s:ItemRenderer>
