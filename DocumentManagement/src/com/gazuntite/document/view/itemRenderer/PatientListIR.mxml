<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="false" 
				width="100%" 
				>
	<fx:Declarations>
		<mx:DateFormatter formatString="MM/DD/YYYY" id="df" /> 
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.document.dto.DocomentSearchedDTO;
			import com.gazuntite.document.dto.PatientSearchedDTO;
			import com.gazuntite.document.model.DMModelLocator;
			[Bindable]	private var isPatientDTO:Boolean;
			[Bindable]	public var DMmodel : DMModelLocator = DMModelLocator.getInstance();
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				if(value is DocomentSearchedDTO )
				{
					isPatientDTO = false;
				}
				else if(value is PatientSearchedDTO)
				{
					isPatientDTO = true;
				}
			}
			
			// set the Alternate color in each alternate row
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			private function onMouseOver():void
			{
				id_Header.setStyle('backgroundColor', 0xFFD08F);
			}
			private function onMouseOut():void
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
			}
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="hovered" />
		<s:State name="selected" />
	</s:states>
	
	<s:BorderContainer id="id_Header" 
					   width="100%" height="100%" 
					   useHandCursor="true" buttonMode="true"  borderVisible="false" 
					   skinClass.selected="com.gazuntite.skins.controls.container.dmg.DMGSelectedPatientSkin"
					   mouseOver="onMouseOver()" mouseOut="onMouseOut()"
					   >
		
		<s:HGroup width="100%" paddingLeft="5" paddingRight="5" paddingTop="5" height="20" x="0" y="0" verticalAlign="middle" >
			
			<s:Group width="25" height="15" visible="{!DMmodel.isSearchByDocument}">
				<s:Rect  width="100%" height="100%" radiusX="2">
					<s:fill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry alpha="1.0" color="#CC6952" ratio="0"/>
							<s:GradientEntry alpha="1.0" color="#A45340" ratio="0.48627450980392156"/>
							<s:GradientEntry alpha="1.0" color="#993F2A" ratio="0.49019607843137253"/>
							<s:GradientEntry alpha="1.0" color="#892108" ratio="1"/>
						</s:LinearGradient>
					</s:fill>
					<s:filters>
						<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="#000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
					</s:filters>
				</s:Rect>
				
				<s:RichText  width="25" text="{data.docomentCount}" 
							 includeInLayout="{isPatientDTO}" color="0xFFFFFF" visible="{isPatientDTO}"
							 fontSize="11" tabStops="S0" fontFamily="CalibriCFF"
							 verticalCenter="0" horizontalCenter="0"
							 maxDisplayedLines="1" textAlign="center"
							 />
			</s:Group>
			
			<s:Label text="{data.Name}"
					 toolTip="{data.Name}"
					 fontSize="15"
					 left="0" width="100%"
					 color.selected="0xFFFFFF"
					 color="0x333333"
					 fontFamily.selected="CalibriCFFBold" fontFamily="CalibriCFF" 
					 typographicCase.selected="uppercase"
					 maxDisplayedLines="1"
					 />
		</s:HGroup>
		
		<s:HGroup height="20" width="100%" x="0" y="21" paddingLeft="5" paddingRight="5" paddingTop="5" horizontalAlign="left" verticalAlign="middle">
			<s:RichText toolTip="{data.age +' '+data.Gender +' '+ df.format(data.DOB)}" text="{data.age +' '+data.Gender +' '+ df.format(data.DOB)} " color.selected="0xFFFFFF"  width="100%" height="100%" maxDisplayedLines="1" fontFamily="CalibriCFF"/>
		</s:HGroup>
		
		<s:HGroup height="20" width="100%" x="0" y="41" paddingLeft="5" paddingRight="5" paddingTop="5" horizontalAlign="left" verticalAlign="middle" includeInLayout="{!isPatientDTO}" visible="{!isPatientDTO}">
			<s:Label text="Patient: {data.patientName}" toolTip="Patient: {data.patientName}" fontFamily="CalibriCFF" color.selected="0xFFFFFF" maxDisplayedLines="1" width="100%" height="100%" />
		</s:HGroup>
		
		<!--<s:Label text="Patient: {data.patientName}" includeInLayout="{!isPatientDTO}" visible="{!isPatientDTO}" />-->
	</s:BorderContainer>
</s:ItemRenderer>