		<s:Button id="id_EditBtn"
				  toolTip="Edit" enabled="false"
				  buttonMode="true" useHandCursor="true"
				  skinClass="com.gazuntite.skins.controls.button.dmg.EditDocumentBtnSkin"
				  />
	</s:HGroup>
</s:Group>