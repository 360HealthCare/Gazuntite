			} 
			
			private function sendToServer():void
			{
				/* var medicineEvent: GetMedicationsEvent = new GetMedicationsEvent(MedicineSearchDTO ,getMedicines);
				CairngormEventDispatcher.getInstance().dispatchEvent(medicineEvent);  */
