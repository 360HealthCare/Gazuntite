			private var patientNames:ArrayCollection = new ArrayCollection(['John Harrison','Barbara Geater','Isobel Stevens','Meredith Grey','Alex Karev','Lexie Grey','Mark Slone','Owen Hunt','Cristina Yang','Miranda Bailey','Renda Kepner','Frodo Miller','Harry Lockhart','Damon Stewart','Kelley Clarkson','George Omelley','David Burke','Micheal Scolfield','Lincon Burrows','Sherry Blaire','Henery Lahm','Jenefer Anniston','Joey Tribbiani','Ross Gellar','Monica Gellar','Emma Watson','Denial Redcliff','Cedric Diggory','Tom Riddle','Klenn Hansard','Shafiq Ahmed','Tamjeed Hassan','Eric Huu','Moeen Mohsin','Azka zafar',' Saba Riaz','TA','Tahir Ramzan']);
			
			private var FileNames:ArrayCollection = new ArrayCollection(['AbdominalX-Ray.png','ECGReport.docx','ECGdetailed.pdf','Finaltest.docx','FinalizedMRI.png','FootX-Ray.png','Throatinfection.docx','Facialacnereport.png','BrokenribsX-ray.jpg','BackboneMRI.png','Intestinalreport.docx','Dislocatedshoulder.png','Brokenlimb.jpg','Infectedwound.png','CTscan.jpg','Brokenkneereport.png','Eyewhite.png','Neuroscans.png','Swollenwristjoint.jpg','Cardiovessels.pdf','Noseinfection.pdf','Skullfracture.png','Mouthcancer.docx','Earbleedingreport.pdf','Lungsreport.docx']);
			
			public var SearchString:String;
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				LoadPatients();
			}
			
			public function LoadPatients():void
			{
				// load 30 patients in to the patient list
				DMmodel.PatientDocomentsDTOList = getPatients(30); 
			}
			
			private function getPatients(length:int = 10):ArrayCollection
			{
				var DataSET:ArrayCollection = new ArrayCollection();
				var obj:PatientSearchedDTO;
				
				for(var i:int = 0 ; i < length ; i++)
				{
					var a:int = Math.floor(Math.random()*95 + 1);
					
					obj 		= new PatientSearchedDTO();
					obj.age 	= a.toString()+'Yrs';
					obj.DOB		= calculateDOB(a);
					obj.id 		= i;
					obj.docomentCount = Math.floor(Math.random()*15 + 1);
					
					obj.Name = getPatientName();
					
					if(i%2 == 0)
					{
						obj.Gender = 'M';
					}
						
					else
					{
						obj.Gender = 'F';
						
					}
					
					DataSET.addItem(obj);
				}
				
				return DataSET;
			}
			
			public function getPatientName():String
			{
				return patientNames[Math.floor(Math.random()*patientNames.length + 0)];
			}
			
			public function getFileName():String
			{
				return FileNames[Math.floor(Math.random()*FileNames.length + 0)];
			}
			
			public function calculateDOB(age:int):String
			{
				
				return (2013-age+'/'+Math.floor(Math.random()*12 + 1)+'/'+Math.floor(Math.random()*30 + 1));
			}
			
			private function getDocoments(length:int = 10):ArrayCollection
			{
				var DataSET:ArrayCollection = new ArrayCollection();
				var obj:DocomentSearchedDTO;
				
				for(var i:int = 0 ; i < length ; i++)
				{
					var a:int = Math.floor(Math.random()*95 + 1);
					
					obj 		= new DocomentSearchedDTO();
					obj.age 	= a.toString()+'Yrs';
					obj.DOB		= calculateDOB(a);
					obj.id 		= i;
					obj.Name = getFileName();
					
					if(i%2 == 0)
					{
						obj.patientName = getPatientName();
						obj.Gender = 'M';
						
					}
						
						
					else
					{
						obj.patientName = getPatientName();
						obj.Gender = 'F';
						
					}
					
					DataSET.addItem(obj);
				}
				
				return DataSET;
			}
			
			protected function id_SearchInput_changeHandler(event:TextOperationEvent):void
			{
				
			}
			
			protected function id_searchType_clickHandler(event:MouseEvent):void
			{
				
			}
			
			
			protected function id_image_clickHandler(event:MouseEvent):void
			{
				id_searchType.openDropDown();
				event.stopImmediatePropagation();
			}
			
			protected function searchType_changeHandler(event:IndexChangeEvent):void
			{
				switch(id_searchType.selectedIndex)
				{
					case 0:
						id_searchbylabel.text = 'Patient';
						id_SearchInput.prompt = 'Search Patient';
						id_SearchInput.toolTip = 'Search By: Patient';
						DMmodel.PatientDocomentsDTOList = getPatients(30);
						DMmodel.isSearchByDocument = false;
						break;
					
					case 1:
						id_searchbylabel.text = 'Document';
						id_SearchInput.prompt = 'Search Document';
						id_SearchInput.toolTip = 'Search By: Document';
						DMmodel.PatientDocomentsDTOList = getDocoments(13);
						DMmodel.isSearchByDocument = true;
						break;
					
				} 
				
				dispatchEvent(new Event("ResetListDesprictionView",true));
			}	
			
			protected function textInput_clickHandler(event:MouseEvent):void
			{
				
			}
			
			protected function textInput_keyUpHandler(event:KeyboardEvent):void
