			[Embed(source="../assets/selected_name.png")]
			[Bindable]	public var selected_name:Class;
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:HorizontalLayout verticalAlign="middle" gap="5"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="100%" skinClass="com.gazuntite.skins.controls.container.dmg.DMGSearchPatientBgSkin">
		<s:HGroup id="id_Main" width="100%" height="100%" verticalAlign="middle" horizontalAlign="left" paddingLeft="5" paddingRight="5">
			
			<s:Group    width="30" height="100%">
				<s:DropDownList id="id_searchType"
								labelField="label" requireSelection="true"
								skinClass="com.gazuntite.skins.controls.combobox.CustomDropDownListSkin"
								itemRenderer="spark.skins.spark.DefaultComplexItemRenderer"	
								change="searchType_changeHandler(event)" 
								width="1" height="1" left="0"	
								click="id_searchType_clickHandler(event)"
								>
					<s:dataProvider>
						<s:ArrayList>
							<s:BitmapImage source="@Embed('../assets/patientName.png')" />
							<s:BitmapImage source="@Embed('../assets/documentName.png')" />
						</s:ArrayList>
					</s:dataProvider>
				</s:DropDownList>
				
				<s:Image id="id_image"
						 width="30" height="100%"  
						 left="0" verticalCenter="0"
						 click="id_image_clickHandler(event)" 
						 source="{selected_name}" 
						 buttonMode="true" useHandCursor="true" 
						 />
			</s:Group>	
			
			<s:Label id="id_searchbylabel" 
					 text="Patient"  width="30%" color="#333333" fontSize="15" fontFamily="CalibriCFF"/>
			<s:SkinnableContainer  width="100%" height="25" 
								   skinClass="com.gazuntite.skins.controls.container.PatientSearchBackgroundSkin">
				<s:TextInput id="id_SearchInput" 
							 left="3" right="25"
							 fontSize="15"  height="20"
							 prompt="Search Patient"
							 keyUp="textInput_keyUpHandler(event)"
							 click="textInput_clickHandler(event)"  
							 change="id_SearchInput_changeHandler(event)"
							 toolTip="Search By: Patient"
							 verticalCenter="0"
							 contentBackgroundAlpha="0" borderVisible="false"
							 fontFamily="CalibriCFF" fontStyle="normal" color="0x666666"
							 /><!--restrict="[A-Z a-z , . / \- 0-9]" -->
				
				<s:Button id="id_searchBtn" right="4" 
						  skinClass="com.gazuntite.skins.controls.container.dmg.DMGSearchPatientIconSkin"
