<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				xmlns:medication="com.gazuntite.input.view.components.patient.itemrenderer.medication.*"
				autoDrawBackground="false"
				width="100%" 
				>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.MedRXDTO;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.provider.eprescription.services.patient.event.DeletePatientMedEvent;
			import com.gazuntite.provider.eprescription.services.patient.event.SaveNewRXEvent;
			import com.gazuntite.provider.eprescription.services.patient.view.views.newrx.NewRXPanel;
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			[Bindable]	public var inEditMode:Boolean = false;
			[Bindable]  private var isEditViewOpen:Boolean = false;
			[Bindable]  private var isStatusViewOpen:Boolean = false;
			[Bindable]	public var dto:MedRXDTO;
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			[Bindable]	public var model:QIModelLocator = QIModelLocator.getInstance();
			
			override public function set data(value:Object):void
			{
				super.data = value;
				dto = value as MedRXDTO;
				
				if (value == null || null == dto) 
					return;
				
				/**
				 * Everytime the data is assigned to the renderer, 
				 * its notes and dictation buttons mode should be reset either in seleced on deselected state
				 * */
				setDictationNoteButtonMode();
				//isEditViewOpen = false;
				//removeEditView();
				glowAnimation.play(null, true);
				glow1.alpha = 0;
				
				invalidateDisplayList();
			}
			private function setDictationNoteButtonMode():void
			{
				if (!inEditMode)
				{
					if (viewModel.inDictationMode)
						viewModel.inDictationMode = false;
					
					if (viewModel.inNoteMode)
						viewModel.inNoteMode = false;
				}else if(inEditMode)
				{
					id_ItemExpandView.viewModel.visible = false;
				}
				showGlow();
			}
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				if(itemIndex == 0)
					id_layout.paddingTop = 3;
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			protected function toggleEditView(event:MouseEvent, val:int):void
			{
				switch(val)
				{
					case 1://Expand View
					{
						inEditMode = !inEditMode;
						if(inEditMode)
						{
							id_ItemExpandView.visible				= true;
							isStatusViewOpen						= false;
							//id_continueBtn.selected					= false;
							id_btnEdit.selected						= false;
							isEditViewOpen 							= false;
							removeEditView();
						}
						else
						{
							id_ItemExpandView.visible				= false;
							id_yesRB.selected 						=dto.isActive;
						}
						
						showGlow();
						break;
					}
					case 2: // Status View
					{
						if(id_NoRB.selected)
						{
							id_ItemExpandView.visible				= false;
							id_btnEdit.selected						= false;
							id_StatusView.visible					= true;
							id_StatusView.resetForm();
							isStatusViewOpen						= true;
							isEditViewOpen 							= false;
							removeEditView();
						}
						else
						{
							id_StatusView.visible					= false;
							isStatusViewOpen						= false;
						} 
						
						showGlow();
						event.stopImmediatePropagation();
						break;
					}
					case 3: // Edit View
					{
						if(id_btnEdit.selected)
						{
							id_ItemExpandView.visible				= false;
							id_StatusView.visible					= false;
							isStatusViewOpen						= false;
							isEditViewOpen 							= true;
							showEditView();
						}
						else
						{
							isEditViewOpen 							= false;
							showGlow();
							removeEditView();
						}
						event.stopImmediatePropagation();
						break;
					}
					case 4: // Delete Case
					{
						Alert.show('Are you sure you want to delete \n this record?', "Confirmation?",Alert.YES|Alert.NO , FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
						{
							if(event.detail == 1)
							{
								var eve:DeletePatientMedEvent = new DeletePatientMedEvent(dto.ReferenceNumber, function():void{
									
									dispatchEvent(new Event("LoadPatientMedications",true));
									
								});
								
								
								var eusername:String =  "TESTUSER"; 
								var epassword:String =  "TESTPASS";
								
								var securityHeaderXML:XML   	= <Header />;					
								securityHeaderXML.@EUserName	= eusername;
								securityHeaderXML.@EPassword	= epassword;
								securityHeaderXML.@ClinicID		= "sad";
								
								eve.data = securityHeaderXML; 				
								
								CairngormEventDispatcher.getInstance().dispatchEvent(eve);
							}
							
						});
						
						event.stopImmediatePropagation();
						break;
					}
				}
				
			}
			
			private function showGlow():void
			{
				if (inEditMode || isEditViewOpen || isStatusViewOpen)
				{
					glow1.alpha = 1;
					glowAnimation.play();
				}
				else
				{
					glowAnimation.play(null, true);
					glow1.alpha = 0;
					id_ItemExpandView.viewModel.visible 	= false;
				}
			}
			private function showEditView():void
			{
				if(!id_btnEdit.selected)
					return;
				else if(id_editExpandView.numChildren > 0)
					removeEditView()
				
				var editor:NewRXPanel				= new NewRXPanel();
				editor.RXMedicationDTO 				= dto;
				editor.openforInputChronic			= dto.isChronic; 
				editor.IsforInput					= true; // moeen comment here please 
				editor.selectedPatient				= model.patientDTO;
				editor.visitID						= dto.EncounterID;
				editor.visitDate					= dto.VisitDate;
				//editor.width 						= 871;
				editor.height 						= 194;
				//editor.width  						= id_editExpandView.width - 5;
				id_editExpandView.height			= 194;
				//id_editExpandView.width				= 876;
				
				
				/* editor.addEventListener('PanelCreationCompleted',function(event:Event):void{
				
				id_editExpandView.addElement(editor);
				showGlow();
				
				}); */
				
				editor.addEventListener('saveStatus',function(event:Event):void{
					
					isEditViewOpen = false;
					id_btnEdit.selected = false;
					removeEditView();
					
				});
				
				editor.addEventListener('LoadPatientMedications',function(event:Event):void{
					
					dispatchEvent(new Event("LoadPatientMedications",true));
					
				});
				
				callLater(function():void{
					id_editExpandView.addElement(editor);
					editor.width  						= id_editExpandView.width - 5;
					showGlow(); 
				});
			}
			
			private function removeEditView():void
			{
				if(id_editExpandView)
				{
					if(id_editExpandView.numChildren > 0)
						id_editExpandView.removeAllElements();
				}
				
			}
			
			public var tempDiscountinutypeID:String;   // in case the updating fails, 
			public var tempDiscountinutypeDate:String;   // in case the updating fails, 
			public var tempReason:String;   // in case the updating fails, 
			private function countinueMedication():void
			{
				if(dto.isActive == false)
					Alert.show('Are you Sure you want to continue this Medication?', "Confirm?", Alert.YES|Alert.NO, this, function( event:CloseEvent):void
					{
						if(event.detail == Alert.YES)
						{
							tempDiscountinutypeID 	= dto.DiscontinuedTypeID;
							tempDiscountinutypeDate = dto.EndDateofDiscontinue;
							tempReason				= dto.Reason;
							
							dto.Reason = '';
							dto.EndDateofDiscontinue = '';
							dto.DiscontinuedTypeID = '0';
							dto.Status	='1';
							dto.isActive = true;
							
							var ChronicEvent : SaveNewRXEvent = new SaveNewRXEvent(NewRXSaved,false);
							ChronicEvent.data = dto.ToXml();
							CairngormEventDispatcher.getInstance().dispatchEvent( ChronicEvent );
						}
					});
				
				id_StatusView.visible					= false;
				isStatusViewOpen						= false;
			}
			
			
			public function NewRXSaved(response:XML):void
			{
				var status:String = response.@status;
				
				if(status == "false")
				{
					UtilityFunctions.ShowMessage('UnSuccessfull Upadate','UnSuccessfull',function():void{
						//Restore the DTO.
						dto.DiscontinuedTypeID = tempDiscountinutypeID 
						dto.EndDateofDiscontinue =  tempDiscountinutypeDate; 
						dto.Reason				= tempReason;
						
						dto.isActive = true;
					});
					return;
				}
				else
				{
					dispatchEvent(new Event("LoadPatientMedications",true));
				}
				
			}
			
			protected function id_YesNoRGgroup_changeHandler(event:Event):void
			{
				/* 
				if(id_NoRB.selected)
				toggleEditView(new MouseEvent(),2);
				else
				Alert.show('Are you Sure you want to continue this Medication?', "Confirm?", Alert.YES|Alert.NO, this, function( event:CloseEvent):void
				{
				if(event.detail == Alert.YES)
				} */
				
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="id_YesNoRGgroup" change="id_YesNoRGgroup_changeHandler(event)" />
		<s:Animate id="glowAnimation" target="{glow1}" duration="250" >
			<s:motionPaths>
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurX"  />
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurY"/>
			</s:motionPaths>
		</s:Animate>
	</fx:Declarations>
	
	<s:filters>
		<s:GlowFilter id="glow1" blurX="5" blurY="5" alpha="0" color="#3575D0" strength="3" inner="false"/>
	</s:filters>
	
	<s:layout> 
		<s:VerticalLayout id="id_layout" horizontalAlign="center" verticalAlign="top" gap="-4" paddingBottom="1" />
	</s:layout>
	
	<s:SkinnableContainer id="id_Header" width="{this.width - 7}" height="26" >
		
		<s:HGroup left="0" width="100%" top="0" bottom="0"
				  horizontalAlign="left"  verticalAlign="middle"
				  paddingLeft="8" paddingRight="8" gap="4"
				  buttonMode="true" toolTip="Open/Close Details"
				  click="toggleEditView(event, 1)"
				  >
			
			<!--<s:Label text="{itemIndex + 1 +'. '+ dto.drugName}" width="100%" toolTip="{dto.drugName}" 
					 fontFamily="CalibriCFF"	 fontSize="14" maxDisplayedLines="1" showTruncationTip="true"/>-->
			<s:Label text="{itemIndex + 1 +'. '+ dto.drugName +' ('+dto.GenericName+'), '+ dto.StrengthDes}" width="100%" toolTip="{dto.drugName +' ('+dto.GenericName+')'}" 
					 fontFamily="CalibriCFF"	 fontSize="14" maxDisplayedLines="1" showTruncationTip="true"
					 />
			<s:Spacer width="100%"/>
			<s:HGroup height="100%" verticalAlign="middle" gap="6">
				<s:Image buttonMode="true" useHandCursor="true" toolTip="Permamnent" skinClass="com.gazuntite.skins.controls.image.PermanentIconSkin"
						 visible="{dto.DiscontinuedTypeID == '2' ? true : false}" includeInLayout="{dto.DiscontinuedTypeID == '2' ? true : false}"/>
				<s:Image buttonMode="true" useHandCursor="true" toolTip="Temporary" skinClass="com.gazuntite.skins.controls.image.TemporaryIconSkin"
						 visible="{dto.DiscontinuedTypeID == '1' ? true : false}" includeInLayout="{dto.DiscontinuedTypeID == '1' ? true : false}"/>
				
				<s:Label text="{dto.VisitDate == '01/01/1901' ? 'N/A' : dto.VisitDate }" width="100%" toolTip="{dto.VisitDate == '01/01/1901' ? 'N/A' : dto.VisitDate }" 
						 fontFamily="CalibriCFFBold" fontSize="14" maxDisplayedLines="1" showTruncationTip="true"/>
				
				<s:SkinnableContainer width="110" height="25" skinClass="com.gazuntite.skins.controls.container.input.MedicationCoverViewSkin">
					<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.BlueRadioButtonBG" right="1" verticalCenter="0">
						<s:layout>
							<s:HorizontalLayout gap="1" paddingBottom="1" paddingLeft="1" paddingRight="1" paddingTop="1"/>
						</s:layout> 
						
						<s:RadioButton id="id_yesRB" buttonMode="true" useHandCursor="true" toolTip="Continue" 
									   right="1" verticalCenter="0" groupName="id_YesNoRGgroup"
									   selected="{dto.isActive}"
									   click="countinueMedication()"
									   skinClass="com.gazuntite.skins.controls.radioButton.YesRadioButtonSkin"
									   />
						<s:RadioButton id="id_NoRB" buttonMode="true" useHandCursor="true" toolTip="Discontinue" 
									   right="1" verticalCenter="0" groupName="id_YesNoRGgroup"
									   click="toggleEditView(event,2);"
									   selected="{!dto.isActive}"
									   skinClass="com.gazuntite.skins.controls.radioButton.NoRadionButtonSkin"
									   />
					</s:SkinnableContainer>
				</s:SkinnableContainer>
			</s:HGroup>
			<s:ToggleButton id="id_btnEdit"
							click="toggleEditView(event, 3)"
							buttonMode="true" useHandCursor="true" toolTip="Edit the Record" 
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.input.EditRecordArrowTBSkin" enabled="{(dto.DiscontinuedTypeID != '1' &amp;&amp; dto.DiscontinuedTypeID != '2')}"
							/>
			<s:Button id="id_deleteBtn" 
					  buttonMode="true" useHandCursor="true" toolTip="Delete" 
					  skinClass="com.gazuntite.skins.controls.button.input.RecycleButtonSkin"
					  click="toggleEditView(event, 4)"
					  />
		</s:HGroup>
	</s:SkinnableContainer>
	
	<s:Group id="gp" width="{id_Header.width - 5}" top="21"  >
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
		<medication:CMExpandedView id="id_ItemExpandView" 
								   width="100%"  visible="false" includeInLayout="{id_ItemExpandView.visible}"
								   dto="{dto}"
								   skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin"
								   
								   />
		<medication:CMedicationStatusView id="id_StatusView" dto="@{dto}"
										  width="100%" visible="{isStatusViewOpen}"  includeInLayout="{isStatusViewOpen}"
										  />
		<s:SkinnableContainer id="id_editExpandView" 
							  width="100%"  visible="{isEditViewOpen}" includeInLayout="{isEditViewOpen}"
							  skinClass="com.gazuntite.skins.controls.container.input.RecordEditPopupSkin"
							  >
			<s:layout>
				<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
			</s:layout>
		</s:SkinnableContainer>
	</s:Group>
	
</s:ItemRenderer>