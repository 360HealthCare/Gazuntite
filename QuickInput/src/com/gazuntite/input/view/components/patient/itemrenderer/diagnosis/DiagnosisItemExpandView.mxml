<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" xmlns:dictation="com.gazuntite.components.dictation.*"
					  xmlns:dictation2="com.gazuntite.dictation.view.dictation.*"
					  creationComplete="cc(event)" 
					  >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.assessment.diagnosis.DiagnosisDTO;
			import com.gazuntite.dictation.utils.DictationConstants;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.skins.controls.button.input.DictationButtonSkin;
			import com.gazuntite.skins.controls.button.input.DictationRedButtonSkin;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]	public var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]	public var labelWidth:Number = 100;
			private var _diagnosisDTO:DiagnosisDTO;
			
			[Bindable]
			public function get diagnosisDTO():DiagnosisDTO
			{
				return _diagnosisDTO;
			}

			public function set diagnosisDTO(value:DiagnosisDTO):void
			{
				_diagnosisDTO = value;
			}
			private function getFormattedVisitDate(value:DiagnosisDTO):String
			{
				if (!value)
					return "";
				
				var formattedDate:String = "";
				formattedDate = UtilityFunctions.FormatDate(value.VisitDate, 'MM/DD/YYYY');
				
				if(value.AssociateType =='N/A')
					formattedDate = 'N/A';
				return formattedDate;
			}
			private var _isExpand:Boolean = false;
			
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			[Bindable]
			public function get isExpand():Boolean
			{
				return _isExpand;
			}
			
			public function set isExpand(value:Boolean):void
			{
				_isExpand = value;
				if(!isExpand)
					viewModel.visible = false;
			}

			protected function cc(event:FlexEvent):void
			{
				viewModel.inlineEditing = true;
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="5" paddingRight="5" paddingTop="5" paddingBottom="5"/>
	</s:layout>

	<s:HGroup width="100%" verticalAlign="middle" height="21">
		<s:Spacer width="11"/>
		<s:Label text="Visit Date:" width="{labelWidth}" styleName="patientFormLabel"/>
		<s:Label text="{getFormattedVisitDate(diagnosisDTO)}"	 toolTip="{getFormattedVisitDate(diagnosisDTO)}" 
				 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="100%" height="21" verticalAlign="middle">
			<s:BitmapImage id="img_IcdCode" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="ICD Code:" width="{labelWidth}" styleName="patientFormLabel"/>
			<s:Label text="{diagnosisDTO.IcdDto.IcdCodeName}"	 toolTip="{diagnosisDTO.IcdDto.IcdCodeName}" 
					 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
		</s:HGroup>
		
		<s:HGroup width="100%" height="21" verticalAlign="middle">
			<s:BitmapImage id="img_Diagnosis" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Diagnosis:" width="{labelWidth}" styleName="patientFormLabel"/>
			<s:Label text="{diagnosisDTO.IcdDto.IcdCodeDescription}"	 toolTip="{diagnosisDTO.IcdDto.IcdCodeDescription}" 
					 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="100%" height="21" verticalAlign="middle">
			<s:BitmapImage id="img_OnSet" source="{diagnosisDTO.OnSet.length > 0 ? QIConstants.IMG_GREEN : QIConstants.IMG_RED}"/>
			<s:Label text="OnSet:" width="{labelWidth}" styleName="patientFormLabel" />
			<s:Label id="id_OnSet" text="{diagnosisDTO.OnSet}"	 toolTip="{diagnosisDTO.OnSet}" 
					 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
		</s:HGroup>
		
		<s:HGroup width="100%" height="21" verticalAlign="middle">
			<s:Spacer width="11"/>
			<s:Label text="Chronic:" width="{labelWidth}" styleName="patientFormLabel"/>
			<s:Label text="{diagnosisDTO.IsChronic == true ? 'Yes' : 'No'}"	 toolTip="{diagnosisDTO.IsChronic == true ? 'Yes' : 'No'}" 
					 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
		</s:HGroup>
	</s:HGroup>
	<s:HGroup width="100%" visible="{diagnosisDTO.showActiveField}" includeInLayout="{diagnosisDTO.showActiveField}">
		<s:HGroup width="100%" height="21" verticalAlign="middle">
			<s:Spacer width="11"/>
			<s:Label text="Active:" width="{labelWidth}" styleName="patientFormLabel"/>
			<s:Label text="{diagnosisDTO.IsActive == true ? 'Yes' : 'No'}"	 toolTip="{diagnosisDTO.IsActive == true ? 'Yes' : 'No'}" 
					 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
		</s:HGroup>
		<!--<s:HGroup width="100%" height="21" verticalAlign="middle" visible="{!diagnosisDTO.IsActive}" includeInLayout="{!diagnosisDTO.IsActive}">-->
		<s:HGroup width="100%" height="21" verticalAlign="middle" visible="false" includeInLayout="false">
			<s:Spacer width="11"/>
			<s:Label text="Resolved Date:" width="{labelWidth}" styleName="patientFormLabel"/>
			<s:Label text="{diagnosisDTO.ResolvedDate == 'null' ? '' : diagnosisDTO.ResolvedDate}"	 toolTip="{diagnosisDTO.ResolvedDate == 'null' ? '' : diagnosisDTO.ResolvedDate}"	 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
			<!--<s:SkinnableContainer  width="100" height="25" skinClass="com.gazuntite.skins.controls.container.input.DateCoverSkin" >
				<components:LabelDateField id="id_ResolvedDate" 
										   prompt="Resolved Date" width="100%" 
										   text="{diagnosisDTO.ResolvedDate == 'null' ? '' : diagnosisDTO.ResolvedDate}" toolTip="{id_ResolvedDate.text}"
										   IsEditAllow="false" editable="false"
										   styleName="coverDateField"
										   />
			</s:SkinnableContainer>-->
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" paddingRight="8" >
		<s:Spacer width="{img_Diagnosis.width}"/>
		<s:Label text="Notes:"	 styleName="patientFormLabel" width="{labelWidth}"/>
		<s:Label text="{diagnosisDTO.Note}" toolTip="{diagnosisDTO.Note}" styleName="patientFormValue" maxDisplayedLines="1" showTruncationTip="true" width="100%"/>
		<s:ToggleButton id="id_btnDictation"
						selected="@{viewModel.inDictationMode}"
						toolTip="Record Level Dictation"
						click="{!id_btnDictation.selected ? viewModel.visible = false : true}"
						skinClass="{ (diagnosisDTO.DictationID &amp;&amp; diagnosisDTO.DictationID != DictationConstants.GUID_FORMAT) ? DictationRedButtonSkin:DictationButtonSkin }"
						/>
	</s:HGroup>
	
	<dictation2:PatientDictationNoteView width="100%" minHeight="47" viewModel="{viewModel}" noteTooltip="{diagnosisDTO.Note}" note="@{diagnosisDTO.Note}"	isSaveButtonVisible="false"
										 DictationID="{diagnosisDTO.DictationID}" IsDictaionEditMode="{false}"/>
	
</s:SkinnableContainer>