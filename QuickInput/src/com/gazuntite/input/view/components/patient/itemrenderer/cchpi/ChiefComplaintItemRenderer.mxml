<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				xmlns:component="com.gazuntite.view.patient.component.*"
				xmlns:components="com.gazuntite.components.*" 
				xmlns:allergy="com.gazuntite.input.view.inputsections.history.allergy.*"
				xmlns:vitals="com.gazuntite.input.view.inputsections.physical.vitals.*" 
				xmlns:chiefcomplaint="com.gazuntite.input.view.inputsections.physical.chiefcomplaint.*"
				xmlns:dictation="com.gazuntite.dictation.view.dictation.*"
				xmlns:cchpi="com.gazuntite.input.view.components.patient.itemrenderer.cchpi.*" 
				autoDrawBackground="false"
				width="100%"
				initialize="init()" 
				>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.physical.ccHpi.ChiefComplaintHpiDTO;
			import com.gazuntite.dictation.view.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.controls.extended.components.PopupGroup;
			import com.gazuntite.input.view.inputsections.physical.chiefcomplaint.PatientInputPhysicalChiefComplaintEvent;
			import com.gazuntite.skins.controls.button.input.NotesRedButtonSkin;
			import com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin;
			import com.gazuntite.skins.controls.container.input.RecordEditPopupSkin;
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			[Bindable]	private var dto:ChiefComplaintHpiDTO;
			[Bindable]	private var headerLbl:String;
			[Bindable]  private var headerToolTip:String;
			[Bindable]  private var isEditViewOpen:Boolean = false;
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				dto = data as ChiefComplaintHpiDTO;
				
				
				if (value == null || null == dto) //value as AllergyDTO fails somw how ... why object is being passed here in place of AllergyDTO ?
					return;
				
				setDictationNoteButtonMode();
				//	isEditViewOpen = false;
				//	removeEditView();
				glowAnimation.play(null, true);
				glow1.alpha = 0;
				
				invalidateDisplayList();
				
				setHeaderLabel();
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				if(itemIndex == 0)
					id_layout.paddingTop = 3;
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			private function init():void
			{
				viewModel.inlineEditing = true;
			}
			
			private function deleteClickHandler(event:MouseEvent):void
			{
				if (!dto)
					return;
				
				UtilityFunctions.AskMessage("Do you want to delete selected record?", function():void
				{
					dto.IsDeleted = true;
					dto.IsDirty = true;
					
					var ev:PatientInputPhysicalChiefComplaintEvent= new PatientInputPhysicalChiefComplaintEvent(
						PatientInputPhysicalChiefComplaintEvent.PATIENT_INPUT_CHIEF_COMPLAINT_DELETE_EVENT, true);
					
					ev.chiefComplaintHpiDTO = dto;
					
					dispatchEvent(ev);
				});
				
				event.stopPropagation();
			}
			
			private function setHeaderLabel():void
			{
				if (!dto)
					return;
				
				headerToolTip = "";
				
				if (!dto.ChiefComplaint)
				{
					if (!dto.HPIFields)
						return;
					
					headerLbl += dto.HPIFields.Symptom;
					headerToolTip += dto.HPIFields.Symptom
				}
					
				else if (dto.ChiefComplaint.length < 1)
				{
					if (!dto.HPIFields)
						return;
					
					headerLbl += dto.HPIFields.Symptom;
					headerToolTip += dto.HPIFields.Symptom;
				}
					
				else 
				{
					headerLbl += dto.ChiefComplaint;
					headerToolTip += dto.ChiefComplaint;
				}	
			}
			
			// section 1 is Expand View & section 2 for Edit view
			protected function toggleEditView(sectionNo:int):void
			{				
				if (!dto)
					return;
				
				if(sectionNo == 2 )
				{
					if(id_btnEdit.selected)
					{
						dto.inEditMode = false;
						isEditViewOpen = true;
						openEditView();
						showGlow();
						return;
					}else
					{
						removeEditView();
						glowAnimation.play(null, true);
						glow1.alpha = 0;
						isEditViewOpen 								= false;
						id_btnEdit.selected 						= false;
						return;
					}
				}else
				{
					removeEditView();
					if(id_btnEdit.selected)
						id_btnEdit.selected = false;
					isEditViewOpen = false;
				}
				
				dto.inEditMode = !dto.inEditMode;
				setDictationNoteButtonMode();
				showGlow();
			}
			
			private function setDictationNoteButtonMode():void
			{
				if (!dto.inEditMode)
				{
					if (viewModel.inDictationMode)
						viewModel.inDictationMode = false;
					
					if (viewModel.inNoteMode)
						viewModel.inNoteMode = false;
				}else if(dto.inEditMode)
				{
					id_ItemExpandView.viewModel.visible = false;
				}
				showGlow();
			}
			
			private function showGlow():void
			{
				if (!dto)
					return;
				
				if (dto.inEditMode || isEditViewOpen)
				{
					glow1.alpha = 1;
					glowAnimation.play();
				}
				else
				{
					glowAnimation.play(null, true);
					glow1.alpha 								= 0;
					id_ItemExpandView.viewModel.visible 	= false;
				}
			}
			
			protected function openEditView():void
			{
				if(!id_btnEdit.selected)
					return;
				else if(id_editExpandView.numChildren > 0)
					removeEditView();
				
				var editor:ChiefComplaintItemEditView					= new ChiefComplaintItemEditView();
				editor.chiefComplaintHpiDTO 							= dto;
				editor.width  											= id_editExpandView.width - 5;
				
				editor.setStyle('skinClass', RecordEditPopupSkin);
				id_editExpandView.addElement(editor);
				
				editor.id_ChiefComplaint.text = dto.ChiefComplaint;
				
				if (editor.chiefComplaintHpiDTO.HPIFields)
				{
					editor.id_SymptomsCmbo.text = dto.HPIFields.Symptom;
					editor.id_DurationCmbo.text = dto.HPIFields.Duration;
					editor.id_LocationCmbo.text = dto.HPIFields.Location;
					editor.id_QualityCmbo.text = dto.HPIFields.Quality;
					editor.id_SeverityCmbo.text = dto.HPIFields.Severity;
					editor.id_ContextCmbo.text = dto.HPIFields.Context;
					editor.id_ModifyingFactorsCmbo.text = dto.HPIFields.ModifyingFactors;
					editor.id_ExacerbatingCmbo.text = dto.HPIFields.Exacerbating;
					editor.id_ProgressionCmbo.text = dto.HPIFields.Progression;
					editor.id_RadiationCmbo.text = dto.HPIFields.Radiation;
				}
				
				editor.toolTipChanged = true;
				
				editor.addEventListener('saveStatus',function(event:Event):void{
					
					isEditViewOpen = false;
					id_btnEdit.selected = false;
					removeEditView();
				});
			}
			
			private function removeEditView():void
			{
				if(id_editExpandView)
				{
					if(id_editExpandView.numChildren > 0)
						id_editExpandView.removeAllElements();
				}
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:Animate id="glowAnimation" target="{glow1}" duration="250" >
			<s:motionPaths>
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurX"  />
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurY"/>
			</s:motionPaths>
		</s:Animate>
	</fx:Declarations>
	
	<s:filters>
		<s:GlowFilter id="glow1" blurX="5" blurY="5" alpha="0" color="#3575D0" strength="3" inner="false"/>
	</s:filters>
	
	<s:layout>
		<s:VerticalLayout id="id_layout" horizontalAlign="center" verticalAlign="top" gap="-4" paddingBottom="1" />
	</s:layout>
	
	<s:SkinnableContainer id="id_Header" width="{this.width - 7}" height="26" >
		
		<s:HGroup left="0" right="70" top="0" bottom="0"
				  horizontalAlign="left"
				  verticalAlign="middle"
				  paddingLeft="8" paddingRight="8" gap="6"
				  buttonMode="true" toolTip="Open/Close Details"
				  click="toggleEditView(1)"
				  >
			<s:Label width="100%" color="#333333" 
					 fontFamily="CalibriCFF" fontSize="14" maxDisplayedLines="1" verticalCenter="0"
					 text="{itemIndex + 1 +' . '+ dto.ChiefComplaint}" toolTip="{dto.ChiefComplaint}" showTruncationTip="true"/>
		</s:HGroup>
		
		<s:HGroup right="5" gap="4" verticalCenter="0" height="100%" verticalAlign="middle" horizontalAlign="right">
			<s:Image buttonMode="true" source="@Embed('assets/images/new.png')"	 useHandCursor="true" visible="false" />
			<s:ToggleButton id="id_btnEdit"
							click="toggleEditView(2)"
							buttonMode="true" toolTip="Edit the Record"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.input.EditRecordArrowTBSkin"
							/>
			
			<s:Button right="4" top="8"
					  skinClass="com.gazuntite.skins.controls.button.input.RecycleButtonSkin"
					  buttonMode="true" useHandCursor="true" toolTip="Delete Chief Complaint"
					  click="deleteClickHandler(event)"/>
		</s:HGroup>
	</s:SkinnableContainer>
	
	<s:Group id="gp" width="{id_Header.width - 5}" visible="{dto.inEditMode}" includeInLayout="{dto.inEditMode}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
		<cchpi:ChiefComplaintItemExpandView id="id_ItemExpandView" width="100%" chiefComplaintHpiDTO="{dto}" 
												   visible="{dto.inEditMode}" includeInLayout="{dto.inEditMode}" 
												   skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin"/>
	</s:Group>
	
	<s:Group id="id_editExpandView" width="{id_Header.width - 5}" top="21"  visible="{id_btnEdit.selected}" includeInLayout="{id_btnEdit.selected}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
	</s:Group>
</s:ItemRenderer>