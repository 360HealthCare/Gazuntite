<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				xmlns:immunization="com.gazuntite.input.view.components.patient.itemrenderer.immunization.*" 
				xmlns:dictation="com.gazuntite.dictation.view.dictation.*"
				xmlns:components="com.gazuntite.components.*" 
				autoDrawBackground="false"
				initialize="init()"
				width="100%" 
				>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.pmh.immunization.ImmunizationDTO;
			import com.gazuntite.controls.extended.components.PopupGroup;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.view.inputsections.history.Immunization.PatientInputHistoryImmunizationEvent;
			import com.gazuntite.skins.controls.button.input.NotesRedButtonSkin;
			import com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin;
			import com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin;
			import com.gazuntite.skins.controls.container.input.RecordEditPopupSkin;
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			
			[Bindable]  private var isEditViewOpen:Boolean = false;
			[Bindable]	public var dto:ImmunizationDTO;
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			override public function set data(value:Object):void
			{
				if (value == null)
					return;
				
				super.data = value;
				dto = value as ImmunizationDTO;
				
				if (value == null || null == dto) //value as AllergyDTO fails somw how ... why object is being passed here in place of AllergyDTO ?
					return;
				
				setDictationNoteButtonMode();
				/* isEditViewOpen = false;
				removeEditView(); */
				glowAnimation.play(null, true);
				glow1.alpha = 0;
				
				invalidateDisplayList();
			}
			
			private function init():void
			{
				viewModel.inlineEditing = true;
			}
			
			// section 1 is Expand View & section 2 for Edit view
			protected function toggleEditView(sectionNo:int):void
			{				
				if(sectionNo == 2 )
				{
					if(id_btnEdit.selected)
					{
						dto.inEditMode = false;
						isEditViewOpen = true;
						openEditView();
						showGlow();
						return;
					}
					else
					{
						removeEditView();
						glowAnimation.play(null, true);
						glow1.alpha = 0;
						isEditViewOpen 								= false;
						id_btnEdit.selected 						= false;
						return;
					}					
				}
				else
				{
					removeEditView();
					if(id_btnEdit.selected)
						id_btnEdit.selected = false;
					isEditViewOpen = false;
				}
				
				dto.inEditMode = !dto.inEditMode;
				setDictationNoteButtonMode();
				showGlow();
			}
			
			private function setDictationNoteButtonMode():void
			{
				if (!dto.inEditMode)
				{
					if (viewModel.inDictationMode)
						viewModel.inDictationMode = false;
					
					if (viewModel.inNoteMode)
						viewModel.inNoteMode = false;
				}else if(dto.inEditMode)
				{
					id_ItemExpandView.viewModel.visible = false;
				}				
				showGlow();
			}
			
			private function showGlow():void
			{
				if (!dto)
					return;
				
				if (dto.inEditMode || isEditViewOpen)
				{
					glow1.alpha = 1;
					glowAnimation.play();
				}
				else
				{
					glowAnimation.play(null, true);
					glow1.alpha 								= 0;
					id_ItemExpandView.viewModel.visible 	= false;
				}
			}
			
			protected function delete_Record(event:MouseEvent):void
			{
				if (!dto)
					return;
				
				UtilityFunctions.AskMessage("Do you want to delete selected record?", function():void
				{
					dto.IsDeleted = true;
					dto.IsDirty = true;
					
					var ev:PatientInputHistoryImmunizationEvent = new PatientInputHistoryImmunizationEvent(
						PatientInputHistoryImmunizationEvent.PATIENT_INPUT_IMMUNIZATION_DELETE_EVENT, true);
					ev.immunizationDTO = dto;
					
					dispatchEvent(ev);
				});
				
				event.stopPropagation();
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				if(itemIndex == 0)
					id_layout.paddingTop = 3;
				
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			protected function openEditView():void
			{
				if(!id_btnEdit.selected)
					return;
				else if(id_editExpandView.numChildren > 0)
					removeEditView();
				
				var editor:ImmunizationItemEditView				= new ImmunizationItemEditView();
				editor.immDTO 									= dto;
				editor.width  									= id_editExpandView.width - 5;

				editor.setStyle('skinClass', RecordEditPopupSkin);
				id_editExpandView.addElement(editor);
				
				if (editor.immDTO != null)// Populate the Form with Selected DTO
				{
					if (editor.immDTO.AssociateType == 'This Visit')
					{
						editor.id_AssociateVisitzCombo.selectedIndex = 0;
					}
					else if (editor.immDTO.AssociateType == 'Previous Visit')
					{
						editor.id_AssociateVisitzCombo.selectedIndex = 1;
						editor.id_VisitDatesCombo.prompt    = UtilityFunctions.FormatDate(editor.immDTO.VisitDate, 'MM/DD/YYYY');
				//		editor.id_VisitDatesCombo.text 		= UtilityFunctions.FormatDate(editor.immDTO.VisitDate, 'MM/DD/YYYY'); 	
						editor.id_VisitDatesCombo.enabled 	= true;
					}
					else if (editor.immDTO.AssociateType == 'N/A')
					{
						editor.id_AssociateVisitzCombo.selectedIndex = 2;
					}
					
			//		editor.id_AssociateVisitzCombo.text = editor.immDTO.AssociateType;
					
					
					editor.addEventListener('saveStatus',function(event:Event):void{
						
						isEditViewOpen = false;
						id_btnEdit.selected = false;
						removeEditView();
						
					});
					
					editor.img_Associated.source 		= QIConstants.IMG_GREEN;
					
					editor.id_ImmunizationCmbo.selectedItem = editor.immDTO.ImmunizationType;
					editor.id_ImmunizationCmbo.text = editor.immDTO.ImmunizationType.Name;
					
					editor.id_DoseCmbo.text = editor.immDTO.Dose;
					editor.img_Dose.source = QIConstants.IMG_GREEN;
					
					editor.id_BodySideRouteCmbo.text = editor.immDTO.Rout;
					
					editor.id_DateAdmin.text = editor.immDTO.DateAdmin;
					
					editor.id_LotNoCmbo.text	= editor.immDTO.LotNumber;
					
					editor.id_ExpiryDate.text = editor.immDTO.ExpiryDate;
					
					editor.id_NextDue.text = editor.immDTO.NextDoseDue;
					
					editor.id_ManufacturerCmbo.text = editor.immDTO.Manufacturer;
					
					editor.id_SiteCmbo.text = editor.immDTO.Site;
					
					if (editor.immDTO.RefusalReason.length)
					{
						editor.id_ReasonOfRefusalCmbo.text = editor.immDTO.RefusalReason;
						editor.id_RefusalChk.selected	= true;
					}
					
					editor.id_SeriesCmbo.text = editor.immDTO.Series;
					
					editor.toolTipChanged = true;
					invalidateProperties();
				}
				//	editor.uiReaction.text 						= dto.Reaction;
				//	editor.id_allergyList.text 					= dto.AllergyName;
			}
			
			private function removeEditView():void
			{
				if(id_editExpandView)
				{
					if(id_editExpandView.numChildren > 0)
						id_editExpandView.removeAllElements();
				}
			}

		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:Animate id="glowAnimation" target="{glow1}" duration="250" >
			<s:motionPaths>
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurX"  />
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurY"/>
			</s:motionPaths>
		</s:Animate>
	</fx:Declarations>
	
	<s:filters>
		<s:GlowFilter id="glow1" blurX="5" blurY="5" alpha="0" color="#3575D0" strength="3" inner="false"/>
	</s:filters>
	
	<s:layout>
		<s:VerticalLayout id="id_layout" horizontalAlign="center" verticalAlign="top" gap="-4" paddingBottom="1" />
	</s:layout>
	
	<s:SkinnableContainer id="id_Header" width="{this.width - 7}" height="26" >
		
		<s:HGroup left="0" right="55" top="0" bottom="0"
				  horizontalAlign="left"
				  verticalAlign="middle"
				  paddingLeft="8" paddingRight="8" gap="6"
				  buttonMode="true" toolTip="Open/Close Details"
				  click="toggleEditView(1)"
				  >
			<s:Label color="#333333" fontFamily="CalibriCFF" fontSize="14" 	 maxDisplayedLines="1"
					 text="{itemIndex +  1 +'. '+ dto.ImmunizationType.Name}"
					 toolTip="{dto.ImmunizationType.Name}" width="100%"/>
		</s:HGroup>
		
		<s:HGroup right="5" gap="4" verticalCenter="0" height="100%" verticalAlign="middle" horizontalAlign="right">
			<s:Image source="@Embed('assets/images/new.png')" buttonMode="false" useHandCursor="false"/>
			<s:ToggleButton id="id_btnEdit"
							click="toggleEditView(2)"
							buttonMode="true" toolTip="Edit the Record"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.input.EditRecordArrowTBSkin"
							/>
			<s:Button click="delete_Record(event)"
					  skinClass="com.gazuntite.skins.controls.button.input.RecycleButtonSkin" 
					  buttonMode="true" useHandCursor="true"  toolTip="Delete Immunization"	  />
		</s:HGroup>
	</s:SkinnableContainer>
	
	<s:Group id="gp" width="{id_Header.width - 5}" visible="{dto.inEditMode}" includeInLayout="{dto.inEditMode}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
		<immunization:ImmunizationItemExpandView id="id_ItemExpandView" immDTO="{dto}"
												 width="100%"  skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin"/>
	</s:Group>
	
	<s:Group id="id_editExpandView" width="{id_Header.width - 5}" top="21"  visible="{id_btnEdit.selected}" includeInLayout="{id_btnEdit.selected}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
	</s:Group>
</s:ItemRenderer>