<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  xmlns:advancedTextInput="com.gazuntite.components.kapit.advancedTextInput.*"
					  skinClass="com.gazuntite.skins.controls.container.input.RecordEditPopupSkin"
					  width="100%" 
					  >
	<fx:Metadata >
		[Event(name="CloseEditView", type="flash.events.Event")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.MedRXDTO;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.provider.eprescription.services.patient.event.SaveNewRXEvent;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.CloseEvent;
			
			[Bindable]	public var dto:MedRXDTO;
			
			public function resetForm():void
			{
				id_TemporaryRButton.selected = true;
				id_PermanentRButton.selected = false;
				id_date.selectedDate		 = null;
				id_Reason.text				 = '';
			}
			protected function id_date_changeHandler(event:CalendarLayoutChangeEvent):void
			{
				
			}
			
			protected function medicationStatus_changeHandler(event:Event):void
			{
				var group:RadioButtonGroup = event.currentTarget as RadioButtonGroup;
				if(group.selection.label)
				{
					switch(group.selection.label)
					{
						case 'Temporary':
							
							break;
						case 'Permanent':
							
							break;
					}
				}
			}
			
			protected function id_save_clickHandler(event:MouseEvent):void
			{
				if(id_Reason.text.length > 0)
				{
					if(id_TemporaryRButton.selected)
					{
						if(id_date.selectedDate)
						{
							setDiscontinue();
						}
						else
						{
							Alert.show('Please select a valid date.', "Required Fields", 4, this, function(event:Event):void{
								id_date.open();
							});
						}
					}
					else
					{
						setDiscontinue();
					}
					
				}
				else
				{
					Alert.show('Please provide reason for discontinuation.', "Required Fields", 4, this, function(event:Event):void{
						id_Reason.setFocus();
					});
				}
			}
			
			private function setDiscontinue():void
			{
				Alert.show('Are you sure you want to discontinue \n this record?', "Confirmation?", Alert.YES|Alert.NO, this, function(event:CloseEvent):void{
					
					
					if(event.detail = 1) // yes
					{
						if(id_TemporaryRButton.selected)
						{
							dto.EndDateofDiscontinue = UtilityFunctions.FormatDate(id_date.selectedDate,'MM/DD/YYYY');
							dto.DiscontinuedTypeID = '1';
						}
						else
						{
							dto.DiscontinuedTypeID = '2';
						}
						
						dto.Reason = id_Reason.text;
						dto.Status	='1';
						dto.isActive = false;
						
						var ChronicEvent : SaveNewRXEvent = new SaveNewRXEvent(NewRXSaved,false);
						ChronicEvent.data = dto.ToXml();
						CairngormEventDispatcher.getInstance().dispatchEvent( ChronicEvent );
						
					}
					else
					{
						dispatchEvent(new Event("saveStatus",true));
						dispatchEvent(new Event("CloseEditView",true));
					}
				});
			}
			
			public function NewRXSaved(response:XML):void
			{
				
				var status:String = response.@status;
				
				if(status == "false")
				{
					UtilityFunctions.ShowMessage('UnSuccessfull Upadate','UnSuccessfull',function():void{
						
						
					});
					return;
				}
					
				else
				{
					
					dispatchEvent(new Event("saveStatus",true));
					dispatchEvent(new Event("CloseEditView",true));
					dispatchEvent(new Event("LoadPatientMedications",true));
					
				}
				
				
			}
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="medicationStatus" change="medicationStatus_changeHandler(event)"/>
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout horizontalAlign="left" gap="6" paddingBottom="5" paddingTop="5" paddingLeft="5" paddingRight="5"/>
	</s:layout>
	
	<s:HGroup width="100%" verticalAlign="middle" height="25" gap="12">
		<s:RadioButton id="id_TemporaryRButton"
					   skinClass="com.gazuntite.skins.controls.radioButton.RadioButtonWhiteTextSkin"
					   label="Temporary"
					   group="{medicationStatus}"
					   selected="true"
					   />
		<s:RadioButton id="id_PermanentRButton" 
					   skinClass="com.gazuntite.skins.controls.radioButton.RadioButtonWhiteTextSkin"
					   label="Permanent"
					   group="{medicationStatus}"
					   />
		<s:HGroup visible="{id_TemporaryRButton.selected}" includeInLayout="{id_TemporaryRButton.selected}" verticalAlign="middle">
			<s:BitmapImage  source="{id_date.selectedDate ? QIConstants.IMG_GREEN : QIConstants.IMG_RED}"   />
			<s:SkinnableContainer enabled="{id_date.enabled}" width="150" skinClass="com.gazuntite.skins.controls.container.input.DateCoverSkin" >
				<components:LabelDateField id="id_date"
										   prompt="Discontinue Till" width="100%" horizontalCenter="0" verticalCenter="0" 
										   change="id_date_changeHandler(event)" 
										   yearNavigationEnabled="true"   minYear="{new Date().getFullYear()}"
										   selectableRange="{{rangeStart  : new Date()}}" 
										   IsEditAllow="false" editable="false"
										   styleName="coverDateField"
										   /><!--maxYear="{new Date().getFullYear()}"-->
			</s:SkinnableContainer>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" verticalAlign="middle">
		<s:BitmapImage   source="{id_Reason.text.length ? QIConstants.IMG_GREEN : QIConstants.IMG_RED}"   />
		<advancedTextInput:AdvancedTextInput id="id_Reason" 
											 width="100%" 
											 prompt="Reason" 
											 skinClass="com.gazuntite.components.kapit.advancedTextInput.AdvancedTextInputWithClearButtonSkin"
											 maxChars="250" tabIndex="4"
											 />
		<s:Button id="id_save"
				  toolTip="Save"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"
				  click="id_save_clickHandler(event)"
				  />
	</s:HGroup>
	
</s:SkinnableContainer>