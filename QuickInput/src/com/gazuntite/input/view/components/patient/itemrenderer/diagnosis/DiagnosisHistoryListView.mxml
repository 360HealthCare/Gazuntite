<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="cc()">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.view.inputsections.assessment.diagnosis.PatientInputAssessmentDiagnosisEvent;
			import com.gazuntite.input.view.inputsections.assessment.diagnosis.PatientInputAssessmentDiagnosisViewModel;
			import com.gazuntite.utils.UtilityFunctions;
			
			private var viewModel:PatientInputAssessmentDiagnosisViewModel = PatientInputAssessmentDiagnosisViewModel.getInstance();
			
			private var _diagnosisCollection:ArrayCollection;
			private var _sectionName:String;
			
			[Bindable]
			public function get diagnosisCollection():ArrayCollection
			{
				return _diagnosisCollection;
			}

			public function set diagnosisCollection(value:ArrayCollection):void
			{
				_diagnosisCollection = value;
			}

			[Bindable]
			public function get sectionName():String
			{
				return _sectionName;
			}

			public function set sectionName(value:String):void
			{
				_sectionName = value;
			}
			
			private function cc():void
			{
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_ITEM_EDIT_KEY_UP_EVENT, patientInputDiagnosisItemEditKeyUpEvent, false, 0, true);
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_EDIT_EVENT, managePatientInputDiagnosisHandler, false, 0, true);
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_DELETE_EVENT, managePatientInputDiagnosisHandler, false, 0, true);
			}
			
			private function patientInputDiagnosisItemEditKeyUpEvent(event:PatientInputAssessmentDiagnosisEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 2 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadPatientDiagnosisStaticData(event.searchString);
			}
			
			private function managePatientInputDiagnosisHandler(event:PatientInputAssessmentDiagnosisEvent):void
			{
				viewModel.managePatientDiagnosis(sectionName);
			}
			
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(diagnosisCollection && diagnosisCollection.length)
				{
					switch (uiSortDropDown.selectedIndex)
					{
						case 0:
							diagnosisCollection = UtilityFunctions.SortArrayCollection(diagnosisCollection,'serialNumber',true,false);
							break;
						case 1: 
							diagnosisCollection = UtilityFunctions.SortArrayCollection(diagnosisCollection,'label',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSortDropDown)
						uiSortDropDown.selectedIndex = 0;
				}
			}
		]]>
	</fx:Script>
	<fx:Binding source="diagnosisCollection" destination="DataList_changeHandler" />
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="5" paddingLeft="5"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
		</s:layout>
		
		<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
		
		<s:DropDownList id="uiSortDropDown"
						skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
						selectedIndex="0"
						buttonMode="true" toolTip="Sort List"
						change="SortDataList()">
			<s:dataProvider>
				<s:ArrayCollection>
					<fx:Object label="Recently Added"/>
					<fx:Object label="Diagnosis" />
				</s:ArrayCollection>
			</s:dataProvider>
		</s:DropDownList>
		<s:Spacer width="100%"/>
	</s:SkinnableContainer>
	
	<s:List id="uiDiagnosisHistoryList" 
			width="100%" height="100%" minHeight="50" allowMultipleSelection="false"
			dataProvider="{diagnosisCollection}"
			borderVisible="false"	
			skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
			itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.diagnosis.DiagnosisHistoryListItemRenderer"
			/>
</s:Group>