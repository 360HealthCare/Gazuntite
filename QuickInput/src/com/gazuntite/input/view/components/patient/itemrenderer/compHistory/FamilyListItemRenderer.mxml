<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				xmlns:dictation="com.gazuntite.dictation.view.dictation.*"
				xmlns:components="com.gazuntite.components.*" 
				xmlns:compHistory="com.gazuntite.input.view.components.patient.itemrenderer.compHistory.*"
				width="100%"
				autoDrawBackground="false"
				initialize="init()"
				>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.pmh.compHistory.FamilyHistoryDTO;
			import com.gazuntite.controls.extended.components.PopupGroup;
			import com.gazuntite.input.event.visit.pmh.comphistory.LoadFamilyHistoryByPatientIdEvent;
			import com.gazuntite.input.event.visit.pmh.comphistory.ManagePatientFamilyHistoryEvent;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.skins.controls.button.input.NotesRedButtonSkin;
			import com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin;
			import com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin;
			import com.gazuntite.skins.controls.container.input.RecordEditPopupSkin;
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			
			[Bindable]  private var isEditViewOpen:Boolean = false;
			[Bindable]	public var dto:FamilyHistoryDTO;
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			[Bindable]	protected var model:QIModelLocator = QIModelLocator.getInstance();
			
			protected function init():void
			{
				viewModel.inlineEditing = true;
			}
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				dto = value as FamilyHistoryDTO;
				
				if (value == null || null == dto) //value as AllergyDTO fails somw how ... why object is being passed here in place of AllergyDTO ?
					return;
				
				setDictationNoteButtonMode();
				//	isEditViewOpen = false;
				//	removeEditView();
				glowAnimation.play(null, true);
				glow1.alpha = 0;
				
				invalidateDisplayList();
			}
			
			// section 1 is Expand View & section 2 for Edit view
			protected function toggleEditView(sectionNo:int):void
			{				
				 if(!dto.IsPresent) 
					return; 
				
				if(sectionNo == 2 )
				{
					if(id_btnEdit.selected)
					{
						dto.inEditMode = false;
						isEditViewOpen = true;
						openEditView();
						showGlow();
						return;
					}else
					{
						removeEditView();
						glowAnimation.play(null, true);
						glow1.alpha = 0;
						isEditViewOpen 								= false;
						id_btnEdit.selected 						= false;
						return;
					}
				}else
				{
					removeEditView();
					if(id_btnEdit.selected)
						id_btnEdit.selected = false;
					isEditViewOpen = false;
				}
				
				dto.inEditMode = !dto.inEditMode;
				setDictationNoteButtonMode();
				showGlow();
			}
			
			private function setDictationNoteButtonMode():void
			{
				if (!dto.inEditMode)
				{
					if (viewModel.inDictationMode)
						viewModel.inDictationMode = false;
					
					if (viewModel.inNoteMode)
						viewModel.inNoteMode = false;
				}else if(dto.inEditMode)
				{
					id_ItemExpandView.viewModel.visible = false;
				}
				showGlow();
			}
			
			private function showGlow():void
			{
				if (!dto)
					return;
				
				if (dto.inEditMode || isEditViewOpen)
				{
					glow1.alpha = 1;
					glowAnimation.play();
				}
				else
				{
					glowAnimation.play(null, true);
					glow1.alpha 								= 0;
					id_ItemExpandView.viewModel.visible 	= false;
				}
			}
			
			public function getDispTooltip(dataModel:FamilyHistoryDTO):String
			{
				var result:String = "";
				if (dto == null)
				{
					result = "";
				}
				else if(!dto.IsPresent)
				{
					result = (dto.FamilyHistoryType.Name == "HeartDisease"? "Heart Disease":dto.FamilyHistoryType.Name) + "- None";
				}
				else 
				{
					result = (dto.FamilyHistoryType.Name == "HeartDisease"? "Heart Disease":dto.FamilyHistoryType.Name) + "- " + dto.DiseaseType.Description;
				}
				
				return result;
			}
			
			
			protected function delete_Record():void
			{
				UtilityFunctions.AskMessage("Do you want to delete selected record?", function():void
				{
					dto.IsDeleted = true;
					dto.IsDirty = true;
					dto.ModifiedAt = new Date();
					dto.ModifiedBy = model.LoggedInUserId;
					
					if(null != model.FamilyHistoryList)
						model.FamilyHistoryList.removeAll();
					else
						model.FamilyHistoryList = new ArrayCollection();
					
					model.FamilyHistoryList.addItem(dto);
					
					saveFamilyHistory();
				});
			}
			
			private function saveFamilyHistory():void
			{
				var familyHistoryRecord:FamilyHistoryDTO = new FamilyHistoryDTO();
				if( null != model.FamilyHistoryList && model.FamilyHistoryList.length)
				{
					familyHistoryRecord = model.FamilyHistoryList.getItemAt(0) as FamilyHistoryDTO;
				}
				var evt:ManagePatientFamilyHistoryEvent = new ManagePatientFamilyHistoryEvent( model.patientDTO.ID, model.LoggedInUserSelectedBranchId, familyHistoryRecord, clearFamilyHistory );
				CairngormEventDispatcher.getInstance().dispatchEvent( evt );
			}
			private function clearFamilyHistory():void
			{	
				//update skins for icons....
				dispatchEvent(new Event("clearNotesEvent",true, true ));
				
				//update controls
				dispatchEvent( new Event("data_added", true, true) );
				
				loadFamilyHistory();
			}
			private function loadFamilyHistory():void
			{
				var ll:LoadFamilyHistoryByPatientIdEvent = new LoadFamilyHistoryByPatientIdEvent( );
				CairngormEventDispatcher.getInstance().dispatchEvent( ll );
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				if(itemIndex == 0)
					id_layout.paddingTop = 3;
				
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			protected function openEditView():void
			{
				if(!id_btnEdit.selected)
					return;
				else if(id_editExpandView.numChildren > 0)
					removeEditView();
				
				var editor:FamilyListItemEditView					= new FamilyListItemEditView();
				editor.familyHistoryDto 							= dto;
				editor.width  										= id_editExpandView.width - 5;
				
				editor.setStyle('skinClass', RecordEditPopupSkin);
				
				editor.addEventListener('saveStatus',function(event:Event):void{
					
					isEditViewOpen = false;
					id_btnEdit.selected = false;
					removeEditView();
					
				});
				
				id_editExpandView.addElement(editor);
				
				editor.id_Relation.selectedItem						= dto.ReletionshipType;
				editor.id_ICDCode.selectedItem						= dto.DiseaseType;
				editor.id_TypeOfDisease.selectedItem				= dto.DiseaseType;
				
			}
			
			private function removeEditView():void
			{
				if(id_editExpandView)
				{
					if(id_editExpandView.numChildren > 0)
						id_editExpandView.removeAllElements();
				}
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:Animate id="glowAnimation" target="{glow1}" duration="250" >
			<s:motionPaths>
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurX"  />
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurY"/>
			</s:motionPaths>
		</s:Animate>
	</fx:Declarations>
	
	<s:filters>
		<s:GlowFilter id="glow1" blurX="5" blurY="5" alpha="0" color="#3575D0" strength="3" inner="false"/>
	</s:filters>
	
	<s:layout>
		<s:VerticalLayout id="id_layout" horizontalAlign="center" verticalAlign="top" gap="-4" paddingBottom="1" />
	</s:layout>
	
	<s:SkinnableContainer id="id_Header" width="{this.width - 7}" height="26" >
		
		<s:HGroup left="0" right="55" top="0" bottom="0"
				  horizontalAlign="left"
				  verticalAlign="middle"
				  paddingLeft="8" paddingRight="8" gap="6"
				  buttonMode="true" toolTip="Open/Close Details"
				  click="toggleEditView(1)"
				  >
			<s:Label text="{itemIndex + 1 +'. '+ dto.label}" width="100%" toolTip="{getDispTooltip(dto)}"  color="#333333" fontFamily="CalibriCFF"	 fontSize="14"/>
		</s:HGroup>
		
		<s:HGroup right="5" gap="4" verticalCenter="0" height="100%" verticalAlign="middle" horizontalAlign="right">
			<s:Image visible="{dto.VisitID == model.VisitID}" includeInLayout="{dto.VisitID == model.VisitID}" source="@Embed('assets/images/new.png')"/>
			<s:ToggleButton id="id_btnEdit"
							click="toggleEditView(2)" visible="{dto.IsPresent}" includeInLayout="{dto.IsPresent}"
							buttonMode="true" toolTip="Edit the Record"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.input.EditRecordArrowTBSkin"
							/>
			<s:Button id="id_delete"
					  click="delete_Record()"
					  skinClass="com.gazuntite.skins.controls.button.input.RecycleButtonSkin" 
					  buttonMode="true" useHandCursor="true"
					  toolTip="{'Delete ' + dto.FamilyHistoryType.Name + ' history' }"	  
					  />
		</s:HGroup>
		
	</s:SkinnableContainer>
	
	<s:Group id="gp" width="{id_Header.width - 5}" top="21"  visible="{dto.inEditMode}" includeInLayout="{dto.inEditMode}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
		<compHistory:FamilyListItemExpandView id="id_ItemExpandView" familyHistoryDto="{dto}" width="100%" skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin"/>
	</s:Group>
	
	<s:Group id="id_editExpandView" width="{id_Header.width - 5}" top="21"  visible="{id_btnEdit.selected}" includeInLayout="{id_btnEdit.selected}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
	</s:Group>
	
</s:ItemRenderer>