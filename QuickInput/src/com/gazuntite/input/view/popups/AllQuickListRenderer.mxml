<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				buttonMode="true" useHandCursor="true"
				>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.QuickLinksAllDTO;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.collections.ArrayCollection;
			
			[Bindable]	public var dto:QuickLinksAllDTO;
			[Bindable]private var model : QIModelLocator = QIModelLocator.getInstance();
			
			
			override public function set data(value:Object):void
			{
				super.data = value;
				dto = value as QuickLinksAllDTO;
				
				if (value == null || null == dto) 
					return;
				
			}
			
			protected function checkbox1_changeHandler(event:Event):void
			{
				/*
				id_checkbox.selected = !id_checkbox.selected;
				
				if(!model.allQuickLinksList)
					model.allQuickLinksList = new ArrayCollection();
				
				if(id_checkbox.selected)
				{
					var obj:Object 				= new Object();
					obj.QuickLinkTypeID         = dto.QuickLinkTypeID;
					model.allQuickLinksList.addItem(obj);
				}
				else
				{
					if(model.allQuickLinksList)
						model.manageQuickLinksList = UtilityFunctions.removeAddedLinks(model.manageQuickLinksList, dto.QuickLinkTypeID);
				}
				*/
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="hovered"/>
	</s:states>  
	
	<s:layout>
		<s:VerticalLayout gap="0" horizontalAlign="left" verticalAlign="top"/>
	</s:layout>
	
	<s:BorderContainer width="100%" height="20" backgroundColor.normal="0xE8E8E8" backgroundColor.hovered="0xFFD08F" toolTip="{dto.QuickLinkName}" borderVisible="false"
					   click="checkbox1_changeHandler(event)">
		<s:HGroup width="100%" height="20" gap="10" horizontalAlign="left" layoutDirection="ltr" paddingLeft="2" paddingTop="3" paddingBottom="3">
			<s:CheckBox id="id_checkbox" change="checkbox1_changeHandler(event)"
						skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack" selected="@{dto.isSelected}"/>
			<s:Label text="{dto.QuickLinkName}" width="100%" color="0x484848" fontFamily="CalibriCFF" fontSize="14" showTruncationTip="true"/>
		</s:HGroup>
	</s:BorderContainer>
	
	<s:Line width="100%">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line>
</s:ItemRenderer>