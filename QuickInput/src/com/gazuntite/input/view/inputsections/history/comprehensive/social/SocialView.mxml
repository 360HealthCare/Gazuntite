			public function clearSocialView():void
			{
				if(id_social)
					id_social.clearSocialHistoryFormHandler(null);
			}
			
			protected function next_clickHandler(event:MouseEvent):void
			{
				if(!model.isDirtyCompSocialView)
				{
					dispatchEvent( new SelectSection( SelectSection.SelectInnerTabEvent,'Chronic Medication'));
					return;
				}
				
				var hideOption:String = CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE ;
				QIUtilityFunctions.AskMoveNextAlert( MoveNextHandler, null, hideOption );
			}
			
			private function MoveNextHandler(value:String):void
			{
				switch(value)
				{
					case CustomSaveAndMoveNextAlert.SAVE_AND_MOVE_NEXT :
						var ge:GeneralEvent = new GeneralEvent("HXSocialSave",true);
						ge.value = true;
						dispatchEvent(ge);	
						break;
					case CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE :
						var ge:GeneralEvent = new GeneralEvent("HXSocialSave",true);
						ge.value = false;
						dispatchEvent(ge);
						break;
					case CustomSaveAndMoveNextAlert.DISCARD_AND_MOVE_NEXT :
						dispatchEvent( new Event("clearSocialHistoryForm", true, false ) );
						dispatchEvent( new SelectSection( SelectSection.SelectInnerTabEvent,'Chronic Medication'));
						break;
				}
			}
			
		]]>
