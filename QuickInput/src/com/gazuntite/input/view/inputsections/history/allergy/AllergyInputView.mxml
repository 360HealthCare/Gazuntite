<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:allergy1="com.gazuntite.input.view.components.patient.itemrenderer.allergy.*"
					  xmlns:allergy="com.gazuntite.input.view.inputsections.history.allergy.*" 
					  xmlns:dictation="com.gazuntite.components.dictation.*" 
					  xmlns:skins="com.gazuntite.input.view.skins.*" 
					  xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" 
					  xmlns:dictation2="com.gazuntite.dictation.view.dictation.*" 
					  creationComplete="cc()" 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleDictationDTO;
			import com.gazuntite.common.dto.pmh.Allergy.AllergyDTO;
			import com.gazuntite.common.event.FlipViewEvent;
			import com.gazuntite.common.event.QSAllergyEvent;
			import com.gazuntite.common.event.visit.ManageModuleNotesEvent;
			import com.gazuntite.dictation.view.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.input.event.visit.NotesDictation.ManageModuleDictationEvent;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.utils.QIUtilityFunctions;
			import com.gazuntite.input.utils.SortType;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.core.UITextField;
			
			import spark.components.supportClasses.Skin;
			import spark.events.IndexChangeEvent;
			
			[Bindable] public var NavItems:ArrayCollection;
			[Bindable] public var model:QIModelLocator = QIModelLocator.getInstance();		
			[Bindable] public var RecordLevelNote:String = '';
			
			//M:13Nov2013
			[Bindable]	private var dictationDTO:ModuleDictationDTO;
			[Bindable]	public var viewModel:PatientInputHistoryAllergyViewModel = PatientInputHistoryAllergyViewModel.getInstance();
			
			//-------- Creation Complete --------------
			protected function cc():void
			{
				addEventListener(PatientInputHistoryAllergyEvent.PATIENT_INPUT_ALLERGY_DELETE_EVENT, patientInputAllergyDeleteHandler, false, 0, true);
				addEventListener(PatientInputHistoryAllergyEvent.PATIENT_INPUT_ALLERGY_EDIT_EVENT, patientInputAllergyEditHandler, false, 0, true);
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
			}
			
			private function patientInputAllergyDeleteHandler(event:PatientInputHistoryAllergyEvent):void
			{
				if (event.gaxenAllergyID != '')
				{
					UtilityFunctions.AskMessage("Do you want to delete selected Allergy ?", function():void
					{
						var IDsXml:XML = <DeleteAllergies  />
						IDsXml.@GaxenAllergyIDS = "'"+ event.gaxenAllergyID +"'";
						
						callQSAllergyEvent(4, IDsXml, afterDelStatus);
					});
				}
			}
			
			//--------- Call back method for Allergy delete -----------------------
			private function afterDelStatus(response:XML):void
			{
				if (UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.GAXENID))
				{
					callQSAllergyEvent(2, model.patientDTO.GAXENID, callBackAllergy);
				}
			}
			//------------ call back allergy------------------------------ 
			private function callBackAllergy(arrAllergy:ArrayCollection):void
			{
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
				else
					model.QIAllergyDTOList = new ArrayCollection();
				
				model.QIAllergyDTOList.addAll(arrAllergy);
				
				for (var ser:Number = 0; ser<model.QIAllergyDTOList.length; ser++)
				{
					var allergy:AllergyDTO = model.QIAllergyDTOList.getItemAt(ser) as AllergyDTO;
					allergy.seriesNumber = ser+1;
				}
				
				if(model.QIAllergyDTOList.length > 0)
				{					
					var allergyDto:AllergyDTO = new AllergyDTO();
					allergyDto			= model.QIAllergyDTOList.getItemAt(0) as AllergyDTO;
					//TA - Set Third Section data && NKDA LAbel Flag
					
					if(!allergyDto.isNKDA)
					{
						model.AllergyNKDAFlag 	= false;
					}
					else if(allergyDto.isNKDA)
					{
						model.AllergyNKDAFlag 	= true;
					}
				}				
			}
			// -------------- Dispatch Allergy Common Event -------------------------------------
			private function callQSAllergyEvent(param1:int, param2:*, param3:Function = null):void
			{
				var alEvent : QSAllergyEvent = new QSAllergyEvent(param1, param2, param3);
				CairngormEventDispatcher.getInstance().dispatchEvent( alEvent ); 
			}
			
			protected function onSortChange(event:IndexChangeEvent):void
			{
				var sort_type:String = "";				
				switch (uiSort.selectedIndex)
				{
					case 0:
						sort_type = SortType.RECENTLY_ADDED;
						break;
					case 1: 
						sort_type = SortType.ALLERGY_NAME;
						break;
				}
				viewModel.sortAllergyList(sort_type);
			}
			
			private function patientInputAllergyEditHandler(event:PatientInputHistoryAllergyEvent):void
			{
				if (!event.allergyDTO)
					return;
				
				viewModel.savePatientAllergy(event.allergyDTO);
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				if (!viewModel.notesDTO)
				{
					var note:String = id_DictationNote.SectionLevelNote;
					
					viewModel.notesDTO = QIUtilityFunctions.getModuleNoteDTO(QIConstants.ALLERGY_MODULE_NAME);
					viewModel.notesDTO.Note = note;
				}
				
				event.moduleName = QIConstants.ALLERGY_MODULE_NAME;
				event.data = viewModel.notesDTO;
				
				if(event.isNoteSave)
				{
					if( viewModel.notesDTO.Note.length > 0 )
					{
						var manage:ManageModuleNotesEvent = new ManageModuleNotesEvent( viewModel.notesDTO, QIConstants.ALLERGY_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, ManageModuleNotesCallBack);
						CairngormEventDispatcher.getInstance().dispatchEvent( manage );
					}
				}
				else					
				{					
					if (!viewModel.dictationDTO)
					{
						var dictaionId:String = id_DictationNote.SectionLevelDictationID;
						
						viewModel.dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.ALLERGY_MODULE_NAME);
						viewModel.dictationDTO.DictationID = dictaionId;
					}
					
					var dicEvent:ManageModuleDictationEvent = new ManageModuleDictationEvent( viewModel.dictationDTO, QIConstants.ALLERGY_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, model.LoggedInUserSelectedBranchId, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( dicEvent );
				}
			}
			
			private function ManageModuleNotesCallBack(isNoteSaved:Boolean, moduleName:String):void
			{
				trace(moduleName + " module Notes save operation " + isNoteSaved ? "successful":"failed")
				if(isNoteSaved)
					viewModel.newAllergyInputDictationNoteViewModel.visible = false;
			}
			
			public function clearAllergyInputView():void
			{
				if(allergyInputView)
					allergyInputView.clearFields();
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
				
				viewModel.notesDTO = null;				
				viewModel.dictationDTO = null;
				
				if( null != id_DictationNote )
				{
					id_DictationNote.SectionLevelNote = "";
					id_DictationNote.RecordLevelNote = '';
				}
				
				if(id_DictationNote)
					id_DictationNote.resetToDefault();
				
				this.dispatchEvent(new FlipViewEvent(true));
			}
			
			protected function allergyInputView_keyDownHandler(event:KeyboardEvent):void
			{
				CheckAndSetViewDirty( event );
			}
			
			protected function allergyInputView_clickHandler(event:MouseEvent):void
			{
				CheckAndSetViewDirty( event );				
			}
			
			private function CheckAndSetViewDirty(event:Event):void
			{
				var component:Object = null;
				var IsViewDirty:Boolean = allergyInputView.IsViewDirty;
				
				if( event.target is Skin )
					component = event.target.hostComponent;
				else
					component = event.target;
				
				if(component is UITextField)
					return;
				
				if( component.id == "id_active") // special toggle button case --- button is used inplace of RadioButton :(
					allergyInputView.IsViewDirty = true;
				else
					allergyInputView.IsViewDirty = UtilityFunctions.IsComponentDirty( component ) || IsViewDirty;
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="3"/>
	</s:layout>
	<skins:PatientSubViewTitleBar width="100%" label="ALLERGIES" sectionNumber="1" maxSectionCounter="4"  showInputPart="true" inputCounter="0"
								  MainSectionLabel="History"
								  NextSectionLabel="Comprehensive HX"
								  NavItems="{NavItems}"
								  dictationNoteViewModel="{viewModel.newAllergyInputDictationNoteViewModel}"
								  SectionLevelNote="@{viewModel.notesDTO.Note}"
								  SectionLevelDictationID="{viewModel.dictationDTO.DictationID}"
								  />
	<dictation2:NewPatientDictationNoteView  id="id_DictationNote" 
											 width="100%" minHeight="47" isSectionLevel="true"
											 viewModel="{viewModel.newAllergyInputDictationNoteViewModel}" 
											 SectionLevelNote="@{viewModel.notesDTO.Note}"
											 RecordLevelNote="@{RecordLevelNote}"
											 SectionLevelDictationID="@{viewModel.dictationDTO.DictationID}"
											 />
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<allergy1:AllergyItemInputView id="allergyInputView" 
										   width="100%" 
										   keyUp="allergyInputView_keyDownHandler(event)" 
										   click="allergyInputView_clickHandler(event)" 
										   RecordLevelNote="@{RecordLevelNote}"
										   RecordLevelDictationID="@{id_DictationNote.RecordLevelDictationID}"
										   />
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSort"  
								selectedIndex="0"
								buttonMode="true" 
								toolTip="{uiSort.selectedItem.label}"
								change="onSortChange(event)"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<!--M:TEMP <fx:Object label="Recently Added" />-->
							<fx:Object label="Allergy Name" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			
			<s:List id="uiInboxList"
					width="100%" 
					minHeight="50"
					allowMultipleSelection="false"
					borderVisible="false"
					dataProvider="{model.QIAllergyDTOList}"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.allergy.AllergyListItemRenderer"/>
		</s:Group>	
	</s:Scroller>
</s:SkinnableContainer>