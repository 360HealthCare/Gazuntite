<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" 
					  xmlns:component="com.gazuntite.view.patient.component.*"
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:dictation="com.gazuntite.components.dictation.*"
					  xmlns:skins="com.gazuntite.input.view.skins.*" 
					  xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" 
					  xmlns:dictation2="com.gazuntite.dictation.view.dictation.*"
					  currentState="{viewModel.currentTabState}"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.events.FlexEvent;
			
			import spark.events.DropDownEvent;
			
			[Bindable]	public var viewModel:PatientInputHistoryComprehensiveViewModel = PatientInputHistoryComprehensiveViewModel.getInstance();
			[Bindable]	public var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]
			public var NavItems:ArrayCollection;
			
			protected function onSortDropdownOpen(event:DropDownEvent):void
			{
				// TODO Auto-generated method stub
				uiSortDropdown.dropDown.x = uiSortDropdown.x + 24 ; //add container left padding, should convert to global if we really want perfect
			}
								
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(currentState == 'general')
					model.PreviousGeneralMedicalHistoryList = Sort(model.PreviousGeneralMedicalHistoryList);
				
				else if (currentState == 'family')
					model.PreviousFamilyHistoryList = Sort(model.PreviousFamilyHistoryList);
				
				else if (currentState == 'social')
					model.PreviousSocialHistoryList = Sort(model.PreviousSocialHistoryList);
				
			}
			
			private function Sort(value:ArrayCollection):ArrayCollection
			{
				if(value && value.length)
				{
					switch (uiSortDropdown.selectedIndex)
					{
						case 0:
							value = UtilityFunctions.SortArrayCollection(value,'serialNumber',true,false);
							break;
						case 1: 
							value = UtilityFunctions.SortArrayCollection(value,'label',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSortDropdown)
						uiSortDropdown.selectedIndex = 0;
				}
				
				return value;
			}
			
		]]>
	</fx:Script>
	<fx:Binding source="model.PreviousGeneralMedicalHistoryList" destination="DataList_changeHandler" />
	<fx:Binding source="model.PreviousFamilyHistoryList" destination="DataList_changeHandler" />
	<fx:Binding source="model.PreviousSocialHistoryList" destination="DataList_changeHandler" />
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:states>
		<s:State name="general"/>		
		<s:State name="family"/>
		<s:State name="social"/>				
	</s:states>
	<s:layout>
		<s:VerticalLayout	gap="0" paddingBottom="5"/>
	</s:layout>

	<skins:PatientSubViewTitleBar width="100%" PrevSectionLabel="Allergies" label="COMPREHENSIVE HX" 
								  NextSectionLabel="Chronic Medication"
								  NavItems="{NavItems}"
								  maxSectionCounter="4" sectionNumber="2" showHistoryPart="true"
								  MainSectionLabel="History"
								  dictationNoteViewModel="{viewModel.comprehensiveHistoryDictationNoteHistoryViewModel}"/>

	
	<dictation2:PatientDictationNoteHistoryView width="100%" viewModel="{viewModel.comprehensiveHistoryDictationNoteHistoryViewModel}"
											   dictationNoteDataProvider="{model.comprehensiveHistoryDictationNoteHistoryDTOList}"/>
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.input.view.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSortDropdown"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
								selectedIndex="0" buttonMode="true" toolTip="{uiSortDropdown.selectedIndex == -1 ? 'Sort List': (uiSortDropdown.selectedItem as Object).label}"
								open="onSortDropdownOpen(event)"
								change="SortDataList()"
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="History Name" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			<s:List id="uiInboxGeneralList" includeIn="general"
					width="100%" allowMultipleSelection="true"
					height="100%"
					minHeight="50"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false"
					dataProvider="{model.PreviousGeneralMedicalHistoryList}"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.compHistory.GeneralListItemRenderer"/>
			<s:List id="uiInboxFamilyList" includeIn="family"
					width="100%" allowMultipleSelection="true"
					height="100%"
					minHeight="50"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false"
					dataProvider="{model.PreviousFamilyHistoryList}"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.compHistory.FamilyListItemRenderer"/>
			<s:List id="uiInboxSocialList" includeIn="social"
					width="100%" allowMultipleSelection="true"
					height="100%"
					minHeight="50"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false"
					dataProvider="{model.PreviousSocialHistoryList}"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.compHistory.SocialListItemRenderer"/>
			
		</s:Group>
	</s:Scroller>
</s:SkinnableContainer>