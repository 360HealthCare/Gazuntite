<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:Immunization="com.gazuntite.input.view.inputsections.history.Immunization.*"
					  xmlns:allergy="com.gazuntite.input.view.inputsections.history.allergy.*" 
					  xmlns:immunization="com.gazuntite.input.view.components.patient.itemrenderer.immunization.*"
					  xmlns:dictation="com.gazuntite.components.dictation.*"
					  xmlns:skins="com.gazuntite.input.view.skins.*" 
					  xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" 
					  xmlns:dictation2="com.gazuntite.dictation.view.dictation.*" 
					  creationComplete="cc()" 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleDictationDTO;
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.event.visit.ManageModuleNotesEvent;
			import com.gazuntite.dictation.view.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.input.event.visit.NotesDictation.ManageModuleDictationEvent;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.utils.QIUtilityFunctions;
			import com.gazuntite.input.view.viewmodel.PatientInputViewModel;
			import com.gazuntite.utils.UtilityFunctions;
			
			import spark.components.supportClasses.Skin;
			
			[Bindable]	public var model:QIModelLocator 				= QIModelLocator.getInstance();
			[Bindable]	private var modelInput:PatientInputViewModel 	= PatientInputViewModel.getInstance();
			[Bindable]	public var NavItems:ArrayCollection;
			[Bindable]	private var viewModel:PatientInputHistoryImmunizationViewModel = PatientInputHistoryImmunizationViewModel.getInstance();
			[Bindable]  public var RecordLevelNote:String = '';
			[Bindable]	private var notesDTO:ModuleNoteDTO;
			
			//M:13Nov2013
			[Bindable]	private var dictationDTO:ModuleDictationDTO;
			
			//-------- Creation Complete --------------
			protected function cc():void
			{
				dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.IMMUNIZATION_MODULE_NAME);
				
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(QIConstants.IMMUNIZATION_MODULE_NAME);
				addEventListener(PatientInputHistoryImmunizationEvent.PATIENT_INPUT_IMMUNIZATION_DELETE_EVENT, managePatientImmunizationHandler, false, 0, true);
				addEventListener(PatientInputHistoryImmunizationEvent.PATIENT_INPUT_IMMUNIZATION_EDIT_EVENT, managePatientImmunizationHandler, false, 0, true);
				addEventListener(PatientInputHistoryImmunizationEvent.PATIENT_INPUT_IMMUNIZATION_ADD_EVENT, immunizationAddHandler, false, 0, true);
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
			}
			
			private function immunizationAddHandler(event:PatientInputHistoryImmunizationEvent):void
			{
				if (!event.immunizationDTO)
					return;
				
				if (!model.immunizationDTOList)
					model.immunizationDTOList = new ArrayCollection();
				
				model.immunizationDTOList.addItem(event.immunizationDTO);
				
				event.immunizationDTO.serialNumber = model.immunizationDTOList.length;
				
				viewModel.managePatientImmunization();
			}
			
			private function managePatientImmunizationHandler(event:PatientInputHistoryImmunizationEvent):void
			{
				viewModel.managePatientImmunization();
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = QIConstants.IMMUNIZATION_MODULE_NAME;
				event.data = notesDTO;
				
				if(event.isNoteSave)
				{
					var manage:ManageModuleNotesEvent = new ManageModuleNotesEvent( notesDTO, QIConstants.IMMUNIZATION_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( manage );
				}
				else
				{
					if (!dictationDTO)
					{
						var dictaionId:String = id_DictationNote.SectionLevelDictationID;
						
						dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.IMMUNIZATION_MODULE_NAME);
						dictationDTO.DictationID = dictaionId;
					}
					
					var dicEvent:ManageModuleDictationEvent = new ManageModuleDictationEvent( dictationDTO, QIConstants.IMMUNIZATION_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, model.LoggedInUserSelectedBranchId, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( dicEvent );
				}
			}
			
			private function ManageModuleNotesCallBack(isNoteSaved:Boolean, moduleName:String):void
			{
				trace(moduleName + " module Notes save operation " + (isNoteSaved ? "successful":"failed"));
				if(isNoteSaved)
					viewModel.dictationNoteViewModel.visible = false;
			}
			
			public function clearImmunizationInputView():void
			{
				if(id_ImmunizationInputFormView)
					id_ImmunizationInputFormView.resetImmunizationInputForm();
				
				
				if(model.immunizationDTOList)
					model.immunizationDTOList.removeAll();
				
				notesDTO = null;
				dictationDTO = null;
				
				if( null != id_DictationNote )
					id_DictationNote.SectionLevelNote = "";
				
				if(id_DictationNote)
					id_DictationNote.resetToDefault();
			}
			
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(model.immunizationDTOList && model.immunizationDTOList.length)
				{
					switch (uiSortDropDown.selectedIndex)
					{
						case 0:
							model.immunizationDTOList = UtilityFunctions.SortArrayCollection(model.immunizationDTOList,'serialNumber',true,false);
							break;
						case 1: 
							model.immunizationDTOList = UtilityFunctions.SortArrayCollection(model.immunizationDTOList,'immunizationTypeName',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSortDropDown)
						uiSortDropDown.selectedIndex = 0;
				}
			}
			
			protected function id_ImmunizationInputFormView_keyDownHandler(event:KeyboardEvent):void
			{
				CheckAndSetViewDirty(event);
			}
			
			protected function on_gotoNextSectionEventHandler(event:Event):void
			{
				//dispatchEvent(new SelectSection(SelectSection.SelectTabEvent,'id_InputPhysicalMain'));
			}
			
			protected function id_ImmunizationInputFormView_clickHandler(event:MouseEvent):void
			{
				CheckAndSetViewDirty(event);
			}
			
			private function CheckAndSetViewDirty(event:Event):void
			{
				var component:Object = null;
				var IsViewDirty:Boolean = id_ImmunizationInputFormView.IsViewDirty;
				
				if( event.target is Skin )
					component = event.target.hostComponent;
				else
					component = event.target;
				
				if( component.id == "id_RefusalChk") // special toggle button case --- button is used inplace of RadioButton :(
					id_ImmunizationInputFormView.IsViewDirty = true;
					
				else
					id_ImmunizationInputFormView.IsViewDirty = UtilityFunctions.IsComponentDirty( component ) || IsViewDirty;
			}
			
		]]>
	</fx:Script>
	<fx:Binding source="model.immunizationDTOList" destination="DataList_changeHandler" />
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="10" />
	</s:layout>
	<skins:PatientSubViewTitleBar width="100%" 
								  label="Immunization" 
								  PrevSectionLabel="Chronic Medication" 
								  NextSectionLabel=""
								  MainSectionLabel="History" 
								  NavItems="{NavItems}"
								  maxSectionCounter="4"  sectionNumber="4" showInputPart="true"
								  dictationNoteViewModel="{viewModel.dictationNoteViewModel}"
								  gotoNextSectionEvent="on_gotoNextSectionEventHandler(event)"
								  SectionLevelNote="@{notesDTO.Note}"
								  SectionLevelDictationID="{dictationDTO.DictationID}"
								  />
	<dictation2:NewPatientDictationNoteView  id="id_DictationNote" 
											 width="100%" minHeight="47" 
											 isSectionLevel="true"
											 viewModel="{viewModel.dictationNoteViewModel}"  
											 SectionLevelNote="@{notesDTO.Note}"
											 RecordLevelNote="@{RecordLevelNote}"
											 SectionLevelDictationID="@{dictationDTO.DictationID}"
											 /> <!--SectionLevelNote="@{viewModel.notesDTO.Note}"-->
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			

			<immunization:ImmunizationInputFormView id="id_ImmunizationInputFormView" 
													width="100%" 
													keyUp="id_ImmunizationInputFormView_keyDownHandler(event)" 
													click="id_ImmunizationInputFormView_clickHandler(event)" 
													RecordLevelNote="@{RecordLevelNote}" 
													RecordLevelDictationID="@{id_DictationNote.RecordLevelDictationID}"/>			
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSortDropDown"  skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								selectedIndex="0"
								buttonMode="true" 
								change="SortDataList()"
								toolTip="{uiSortDropDown.selectedItem.label}"
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="Immunization Name" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			
			<s:List id="uiInboxList"
					width="100%"
					minHeight="50"
					allowMultipleSelection="true"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false"
					dataProvider="{model.immunizationDTOList}"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.immunization.ImmunInputListItemRenderer"/>
			
		</s:Group>
	</s:Scroller>
</s:SkinnableContainer>
