			private function isValidTobacooInformation():Boolean
			{	
				var isValid:Boolean = true;
				
				if (setTabState == 1)
				{
					if (tobaccoAddictionDTO.AddictionStatusID == 0)
					{	
						isValid = false;
						Alert.show("Please select Tobacco Status.","Required field", 
							Alert.OK, FlexGlobals.topLevelApplication.mainContainer, 
							function (event:CloseEvent):void
							{
								if (event.detail == Alert.OK)
								{
									id_tobaccoForm.id_types.setFocus();
								}
							});
					}
					else if (!tobaccoAddictionDTO.Type || (tobaccoAddictionDTO.Type && tobaccoAddictionDTO.Type.length <= 0))
					{	
						isValid = false;
						Alert.show("Please select Type.","Required field", 
							Alert.OK, FlexGlobals.topLevelApplication.mainContainer, 
							function( event:CloseEvent):void
							{
								if( event.detail == Alert.OK )
								{
									id_tobaccoForm.id_TypeCmbo.setFocus();
								}
							});
					}
				}
				
				return isValid;
			}
			
