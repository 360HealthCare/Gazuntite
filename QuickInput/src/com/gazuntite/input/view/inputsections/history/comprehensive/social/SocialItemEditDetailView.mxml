			public function selectType( typeId:int ):void
			{
				if( null == model.historyMediumTypesDTOList ) return;
				
				if( (currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME && tobaccoType.length > 0) ||
					(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME && alcoholType.length > 0) ||
					(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME && drugsType.length > 0 )
				) return;
				
				for(var i:int = 0; i < model.historyMediumTypesDTOList.length; i ++ )
				{
					var dto:SocialHistoryMediumTypeDTO= model.historyMediumTypesDTOList.getItemAt( i ) as SocialHistoryMediumTypeDTO;
					if( dto.Addication == typeId )
					{
						if(currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME)
							tobaccoType.addItem(dto);
						else if(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME)
							alcoholType.addItem(dto);
						else if(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME)
							drugsType.addItem(dto);
					}
				}   
			}
			
			public function selectUsageAmount( UsageAmountId:int ):void
			{
				if( null == model.usageAmountTypeDTOList ) return;
				
				if( (currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME && tobaccoAmount.length > 0) ||
					(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME && alcoholAmount.length > 0) ||
					(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME && drugsAmount.length > 0 )
				) return;
				
				
				for(var i:int = 0; i < model.usageAmountTypeDTOList.length; i ++ )
				{
					var dto:SocialHistoryUsageAmountTypeDTO = model.usageAmountTypeDTOList.getItemAt( i ) as SocialHistoryUsageAmountTypeDTO;
					if( dto.AddictionID == UsageAmountId )
					{
						if(currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME)
							tobaccoAmount.addItem(dto);
						else if(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME)
							alcoholAmount.addItem(dto);
						else if(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME)
							drugsAmount.addItem(dto);
					}
				} 
			}
			
