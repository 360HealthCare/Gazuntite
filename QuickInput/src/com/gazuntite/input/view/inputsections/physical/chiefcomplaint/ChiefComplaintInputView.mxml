<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:allergy="com.gazuntite.input.view.inputsections.history.allergy.*"
					  xmlns:vitals="com.gazuntite.input.view.inputsections.physical.vitals.*" 
					  xmlns:chiefcomplaint="com.gazuntite.input.view.inputsections.physical.chiefcomplaint.*"
					  xmlns:dictation="com.gazuntite.components.dictation.*" 
					  xmlns:cchpi="com.gazuntite.input.view.components.patient.itemrenderer.cchpi.*" 
					  xmlns:skins="com.gazuntite.input.view.skins.*" 
					  xmlns:dictation2="com.gazuntite.dictation.view.dictation.*"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin"
					  creationComplete="cc()" 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleDictationDTO;
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.event.visit.ManageModuleNotesEvent;
			import com.gazuntite.dictation.view.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.input.event.visit.NotesDictation.ManageModuleDictationEvent;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.utils.QIUtilityFunctions;
			import com.gazuntite.utils.UtilityFunctions;
			
			import spark.components.supportClasses.Skin;
			
			[Bindable]	public var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]	public var viewModel:PatientInputPhysicalChiefComplaintViewModel = PatientInputPhysicalChiefComplaintViewModel.getInstance();
			[Bindable]	private var notesDTO:ModuleNoteDTO;
			[Bindable]	public var NavItems:ArrayCollection;
			[Bindable]  public var RecordLevelNote:String = '';
			
			//M:13Nov2013
			[Bindable]	private var dictationDTO:ModuleDictationDTO;
			
			private function cc():void
			{
				dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.CHIEF_COMPLAINT_MODULE_NAME);
				
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(QIConstants.CHIEF_COMPLAINT_MODULE_NAME);
				addEventListener(PatientInputPhysicalChiefComplaintEvent.PATIENT_INPUT_CHIEF_COMPLAINT_ITEM_EDIT_KEY_UP_EVENT, chiefComplaintItemEditKeyUpHandler, false, 0, true);
				addEventListener(PatientInputPhysicalChiefComplaintEvent.PATIENT_INPUT_CHIEF_COMPLAINT_ADD_EVENT, chiefComplaintAddHandler, false, 0, true);
				addEventListener(PatientInputPhysicalChiefComplaintEvent.PATIENT_INPUT_CHIEF_COMPLAINT_EDIT_EVENT, manageChiefComplaintHpi, false, 0, true);
				addEventListener(PatientInputPhysicalChiefComplaintEvent.PATIENT_INPUT_CHIEF_COMPLAINT_DELETE_EVENT, manageChiefComplaintHpi, false, 0, true);
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
			}
			
			private function chiefComplaintItemEditKeyUpHandler(event:PatientInputPhysicalChiefComplaintEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 0 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadHpiStaticLists(event.sectionName, event.searchString);
			}
			
			private function chiefComplaintAddHandler(event:PatientInputPhysicalChiefComplaintEvent):void
			{
				if (!event.chiefComplaintHpiDTO)
					return;
				
				if (!model.chiefComplaintHpiDTOList)
					model.chiefComplaintHpiDTOList = new ArrayCollection();
				
				model.chiefComplaintHpiDTOList.addItem(event.chiefComplaintHpiDTO);
				
				event.chiefComplaintHpiDTO.serialNumber = model.chiefComplaintHpiDTOList.length;
				
				viewModel.manageChiefComplaintHpi(QIConstants.INPUT_VIEW);
			}
			
			private function manageChiefComplaintHpi(event:PatientInputPhysicalChiefComplaintEvent):void
			{
				viewModel.manageChiefComplaintHpi(QIConstants.INPUT_VIEW);
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = QIConstants.CHIEF_COMPLAINT_MODULE_NAME;
				event.data = notesDTO;
				
				if(event.isNoteSave)
				{
					var manage:ManageModuleNotesEvent = new ManageModuleNotesEvent( notesDTO, QIConstants.CHIEF_COMPLAINT_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( manage );
				}
				else
				{
					if (!dictationDTO)
					{
						var dictaionId:String = id_DictationNote.SectionLevelDictationID;
						
						dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.CHIEF_COMPLAINT_MODULE_NAME);
						dictationDTO.DictationID = dictaionId;
					}
					
					var dicEvent:ManageModuleDictationEvent = new ManageModuleDictationEvent( dictationDTO, QIConstants.CHIEF_COMPLAINT_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, model.LoggedInUserSelectedBranchId, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( dicEvent );
				}
			}
			
			private function ManageModuleNotesCallBack(isNoteSaved:Boolean, moduleName:String):void
			{
				trace(moduleName + " module Notes save operation " + isNoteSaved ? "successful":"failed");
				if(isNoteSaved)
					viewModel.dictationNoteViewModel.visible = false;
			}
			
			public function ClearInputFormView():void
			{
				if(id_CCHPIFormView)
					id_CCHPIFormView.clearForm();
				
				if(model.chiefComplaintHpiDTOList)
					model.chiefComplaintHpiDTOList.removeAll();
				
				notesDTO = null;
				dictationDTO = null;
				if( null != id_DictationNote )
				{
					id_DictationNote.SectionLevelNote = "";
					id_DictationNote.resetToDefault();
				}
			}
			
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(model.chiefComplaintHpiDTOList && model.chiefComplaintHpiDTOList.length)
				{
					switch (uiSort.selectedIndex)
					{
						case 0:
							model.chiefComplaintHpiDTOList = UtilityFunctions.SortArrayCollection(model.chiefComplaintHpiDTOList,'serialNumber',true,false);
							break;
						case 1: 
							model.chiefComplaintHpiDTOList = UtilityFunctions.SortArrayCollection(model.chiefComplaintHpiDTOList,'label',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSort)
						uiSort.selectedIndex = 0;
				}
			}
			
			protected function id_CCHPIFormView_keyUpHandler(event:KeyboardEvent):void
			{
				CheckAndSetViewDirty( event );
			}
			
			protected function id_CCHPIFormView_clickHandler(event:MouseEvent):void
			{
				CheckAndSetViewDirty( event );
			}
			
			private function CheckAndSetViewDirty(event:Event):void
			{
				var component:Object = null;
				var IsViewDirty:Boolean = id_CCHPIFormView.IsViewDirty;
				
				if( event.target is Skin )
					component = event.target.hostComponent;
				else
					component = event.target;
				
				id_CCHPIFormView.IsViewDirty = UtilityFunctions.IsComponentDirty( component ) || IsViewDirty;
			}
			
		]]>
	</fx:Script>
	
	<fx:Binding source="model.chiefComplaintHpiDTOList" destination="DataList_changeHandler" />
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="3"/>
	</s:layout>
	
	<skins:PatientSubViewTitleBar width="100%" label="CHIEF COMPLAINT/HPI" 
								  sectionNumber="2"  maxSectionCounter="5" showInputPart="true" inputCounter="0"
								  PrevSectionLabel="Vitals"
								  NextSectionLabel="Review of System"
								  MainSectionLabel="Physical"
								  NavItems="{NavItems}"
								  dictationNoteViewModel="{viewModel.dictationNoteViewModel}"
								  SectionLevelNote="@{notesDTO.Note}"
								  SectionLevelDictationID="{dictationDTO.DictationID}"
								  />
	
	<dictation2:NewPatientDictationNoteView id="id_DictationNote" 
											width="100%" minHeight="47" 
											viewModel="{viewModel.dictationNoteViewModel}"
											isSectionLevel="true" 
											SectionLevelNote="@{notesDTO.Note}"
											RecordLevelNote="@{RecordLevelNote}"
											SectionLevelDictationID="@{dictationDTO.DictationID}"
											/>
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" 
				skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<s:HGroup width="100%" paddingTop="2" paddingBottom="2" paddingLeft="0" paddingRight="0">
				<cchpi:ChiefComplaintInputFormView id="id_CCHPIFormView" 
												   width="100%" 
												   keyUp="id_CCHPIFormView_keyUpHandler(event)"
												   click="id_CCHPIFormView_clickHandler(event)"
												   RecordLevelNote="@{RecordLevelNote}"
												   RecordLevelDictationID="@{id_DictationNote.RecordLevelDictationID}"
												   />
			</s:HGroup>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSort"  
								selectedIndex="0"
								buttonMode="true" 
								toolTip="Sort List"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								change="SortDataList()"
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="Complaint" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			
			<s:List id="uiInboxList"
					width="100%" minHeight="50"
					allowMultipleSelection="false"
					borderVisible="false"
					dataProvider="{model.chiefComplaintHpiDTOList}"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.cchpi.ChiefComplaintItemRenderer"/>
		</s:Group>	
	</s:Scroller>
</s:SkinnableContainer>
