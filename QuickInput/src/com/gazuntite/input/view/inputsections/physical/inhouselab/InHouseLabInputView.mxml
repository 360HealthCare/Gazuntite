<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:inHouseLab="com.gazuntite.view.patient.input.physical.inHouseLab.*"
					  xmlns:inhouselab="com.gazuntite.input.view.inputsections.physical.inhouselab.*" 
					  xmlns:dictation="com.gazuntite.components.dictation.*"
					  xmlns:inHouseLab1="com.gazuntite.input.view.components.patient.itemrenderer.inHouseLab.*" 
					  xmlns:skins="com.gazuntite.input.view.skins.*" 
					  xmlns:dictation2="com.gazuntite.dictation.view.dictation.*" 
					  creationComplete="cc()" 
					  >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleDictationDTO;
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.event.visit.ManageModuleNotesEvent;
			import com.gazuntite.common.view.events.SelectSection;
			import com.gazuntite.dictation.view.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.input.event.visit.NotesDictation.ManageModuleDictationEvent;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.utils.QIUtilityFunctions;
			import com.gazuntite.input.utils.SortType;
			import com.gazuntite.input.view.inputsections.assessment.plan.followUp.PatientInputAssessmentFollowUpEvent;
			import com.gazuntite.utils.UtilityFunctions;
			
			import spark.components.supportClasses.Skin;
			import spark.events.IndexChangeEvent;
			
			[Bindable]	
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable] public var RecordLevelNote:String = '';
			
			[Bindable]
			private var viewModel:PatientInputPhysicalInHouseLabViewModel = PatientInputPhysicalInHouseLabViewModel.getInstance();
			
			
			[Bindable]
			private var notesDTO:ModuleNoteDTO;
			
			[Bindable]
			public var NavItems:ArrayCollection;
			
			//M:13Nov2013
			[Bindable]	private var dictationDTO:ModuleDictationDTO;
			
			private function cc():void
			{
				dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.LAB_IN_MODULE_NAME);
				
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(QIConstants.LAB_IN_MODULE_NAME);
				
				addEventListener(PatientInputPhysicalInHouseLabEvent.PATIENT_INPUT_IN_HOUSE_LAB_ITEM_EDIT_KEY_UP_EVENT, 
					inHouseLabItemEditKeyUpHandler, false, 0, true);
				addEventListener(PatientInputPhysicalInHouseLabEvent.PATIENT_INPUT_IN_HOUSE_LAB_ADD_EVENT,
					inHouseLabAddEvent, false, 0, true);
				addEventListener(PatientInputPhysicalInHouseLabEvent.PATIENT_INPUT_IN_HOUSE_LAB_EDIT_EVENT,
					manageInHouseLabHandler, false, 0, true);
				addEventListener(PatientInputPhysicalInHouseLabEvent.PATIENT_INPUT_IN_HOUSE_LAB_DELETE_EVENT,
					manageInHouseLabHandler, false, 0, true);
				
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
				
				viewModel.inputListSortType = SortType.RECENTLY_ADDED;
			}
			
			private function inHouseLabItemEditKeyUpHandler(event:PatientInputPhysicalInHouseLabEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 0 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadInHouseLabTestForInputView(event.searchString, event.searchType);
			}
			
			private function inHouseLabAddEvent(event:PatientInputPhysicalInHouseLabEvent):void
			{
				if (!event.inHouseLabDTO)
					return;
				
				if (!model.inHouseLabDTOList)
					model.inHouseLabDTOList = new ArrayCollection();
				
				model.inHouseLabDTOList.addItem(event.inHouseLabDTO);
				
				event.inHouseLabDTO.serialNumber = model.inHouseLabDTOList.length;
				
				viewModel.manageInHouseLab(QIConstants.INPUT_VIEW, onManageInHouseLab);
				
				dispatchEvent(new PatientInputAssessmentFollowUpEvent(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_LOAD_FOLLOW_UP_LABS, true));
			}
			
			private function manageInHouseLabHandler(event:PatientInputPhysicalInHouseLabEvent):void
			{
				viewModel.manageInHouseLab(QIConstants.INPUT_VIEW, onManageInHouseLab);
				
				dispatchEvent(new PatientInputAssessmentFollowUpEvent(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_LOAD_FOLLOW_UP_LABS, true));
			}
			
			public function onManageInHouseLab():void
			{
				dispatchEvent(new PatientInputAssessmentFollowUpEvent(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_LOAD_FOLLOW_UP_LABS, true));
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = QIConstants.LAB_IN_MODULE_NAME;
				event.data = notesDTO;
				
				if(event.isNoteSave)
				{
					var manage:ManageModuleNotesEvent = new ManageModuleNotesEvent( notesDTO, QIConstants.LAB_IN_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( manage );
				}
				else
				{
					if (!dictationDTO)
					{
						var dictaionId:String = id_DictationNote.SectionLevelDictationID;
						
						dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.LAB_IN_MODULE_NAME);
						dictationDTO.DictationID = dictaionId;
					}
					
					var dicEvent:ManageModuleDictationEvent = new ManageModuleDictationEvent( dictationDTO, QIConstants.LAB_IN_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, model.LoggedInUserSelectedBranchId, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( dicEvent );
				}
			}
			
			private function ManageModuleNotesCallBack(isNoteSaved:Boolean, moduleName:String):void
			{
				trace(moduleName + " module Notes save operation " + isNoteSaved ? "successful":"failed")
				if(isNoteSaved)
					viewModel.dictationNoteViewModel.visible = false;
				
			}
			
			private function sortDropDownChangeHandler(event:IndexChangeEvent):void
			{
				var sortType:String = "";
				
				if (event.newIndex == 0)
				{
					sortType = SortType.RECENTLY_ADDED;
				}
				else
				{
					sortType = SortType.IN_HOUSE_LAB_TEST_NAME;
				}
				
				viewModel.inputListSortType = sortType;
				viewModel.sortInHouseLabList(sortType, QIConstants.INPUT_VIEW);
			}
			
			public function ClearInputFormView():void
			{
				if(id_InhouseLabFormView)
					id_InhouseLabFormView.clearForm();
				
				
				if(model.inHouseLabDTOList)
					model.inHouseLabDTOList.removeAll();
				
				notesDTO = null;
				dictationDTO = null;
				if( null != id_DictationNote )
				{
					id_DictationNote.SectionLevelNote = "";
					id_DictationNote.resetToDefault();
				}
			}
			
			protected function id_InhouseLabFormView_keyDownHandler(event:KeyboardEvent):void
			{
				CheckAndSetViewDirty(event); 
			}
			
			protected function id_InhouseLabFormView_clickHandler(event:MouseEvent):void
			{
				CheckAndSetViewDirty(event); 				
			}
			
			protected function on_gotoNextSectionEventHandler(event:Event):void
			{
				//dispatchEvent(new SelectSection(SelectSection.SelectTabEvent,'id_InputAssessmentMain'));
			}
			
			private function CheckAndSetViewDirty(event:Event):void
			{
				var component:Object = null;
				var IsViewDirty:Boolean = id_InhouseLabFormView.IsViewDirty;
				
				if( event.target is Skin )
					component = event.target.hostComponent;
				else
					component = event.target;
				
				/* if( component.id == "id_active") // special toggle button case --- button is used inplace of RadioButton :(
					id_InhouseLabFormView.IsViewDirty = true; 
					
				else*/
					id_InhouseLabFormView.IsViewDirty = UtilityFunctions.IsComponentDirty( component ) || IsViewDirty;
				
			}
			
			
		]]>
	</fx:Script>
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="10"/>
	</s:layout>
	<skins:PatientSubViewTitleBar width="100%" 
								  label="IN-HOUSE LAB"  
								  maxSectionCounter="5" sectionNumber="5" showInputPart="true"
								  PrevSectionLabel="Physical"
								  NextSectionLabel=""
								  MainSectionLabel="Physical"
								  NavItems="{NavItems}"
								  dictationNoteViewModel="{viewModel.dictationNoteViewModel}"
								  gotoNextSectionEvent="on_gotoNextSectionEventHandler(event)"
								  SectionLevelNote="@{notesDTO.Note}"
								  SectionLevelDictationID="{dictationDTO.DictationID}"
								  />
	
	<dictation2:NewPatientDictationNoteView  id="id_DictationNote" 
											width="100%" minHeight="47" isSectionLevel="true"
											viewModel="{viewModel.dictationNoteViewModel}" SectionLevelNote="@{notesDTO.Note}"
											RecordLevelNote="@{RecordLevelNote}"	
											SectionLevelDictationID="@{dictationDTO.DictationID}"
											/>
	
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<inHouseLab1:InHouseLabInputFormView id="id_InhouseLabFormView" width="100%" dictationNoteViewModel="{viewModel.inlineDictationNoteViewModel}" RecordLevelNote="@{RecordLevelNote}" 
												 keyUp="id_InhouseLabFormView_keyDownHandler(event)" click="id_InhouseLabFormView_clickHandler(event)" 
												 RecordLevelDictationID="@{id_DictationNote.RecordLevelDictationID}"/>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
				<s:DropDownList skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
								selectedIndex="0" buttonMode="true" toolTip="Sort List" change="sortDropDownChangeHandler(event)">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added"/>
							<fx:Object label="Test Name"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%"/>
			</s:SkinnableContainer>
			
			<s:List id="inHouseLabInputList" width="100%" height="100%"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false" dataProvider="{model.inHouseLabDTOList}"
					itemRenderer="com.gazuntite.input.view.components.patient.itemrenderer.inHouseLab.InHouseLabInputListItemRenderer"/>
		</s:Group>	
	</s:Scroller>
</s:SkinnableContainer>
