<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:dictation="com.gazuntite.dictation.view.dictation.*"
					  skinClass="com.gazuntite.skins.controls.container.input.RecordEditPopupSkin"
					  creationComplete="cc()"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.physical.ros.ROSPhysicalBaseDTO;
			import com.gazuntite.common.util.QSConstants;
			import com.gazuntite.common.view.events.GeneralEvent;
			import com.gazuntite.dictation.utils.DictationConstants;
			import com.gazuntite.skins.controls.button.input.DictationButtonSkin;
			import com.gazuntite.skins.controls.button.input.DictationRedButtonSkin;
			import com.gazuntite.skins.controls.button.input.NotesRedButtonSkin;
			import com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			private var m_oDataItem:ROSPhysicalBaseDTO;
			
			[Bindable]
			public function get dataItem():ROSPhysicalBaseDTO
			{
				return m_oDataItem;
			}
			
			public function set dataItem(value:ROSPhysicalBaseDTO):void
			{
				m_oDataItem = value;
			}
			
			/* [Bindable]
			override public function set data(value:Object):void
			{
			super.data = value;
			dataItem = value as IReviewOfSystemItem;
			
			if( null == value ) return;
			
			ReviewOfSystemHelper.setButtonSkin( dataItem, id_btnNormal, id_btnAbnormal );
			} */
			
			protected function onNormalClick(event:MouseEvent):void
			{
				if( event.currentTarget.selected )
				{
					dataItem.IsNormal = QSConstants.STRING_TRUE;
					dataItem.IsAbNormal = QSConstants.STRING_FALSE;
					dataItem.IsDirty = true;
				}
				/* else
				{
				dataItem.IsNormal = '';
				dataItem.IsAbNormal = '';
				dataItem.IsDirty = false;
				} */
				
				/* var ge:GeneralEvent = new GeneralEvent("childChanged", true);
				ge.value = dataItem;
				event.currentTarget.dispatchEvent( ge );
				ReviewOfSystemHelper.setButtonSkin( dataItem, id_btnNormal, id_btnAbnormal ); */
				
			}
			
			protected function onAbNormalClick(event:MouseEvent):void
			{
				if(event.currentTarget.selected)
				{
					dataItem.IsNormal 	= QSConstants.STRING_FALSE;
					dataItem.IsAbNormal = QSConstants.STRING_TRUE;
					dataItem.IsDirty = true;
				}
				/* else
				{
				dataItem.IsNormal = '';
				dataItem.IsAbNormal = '';
				dataItem.IsDirty = false;
				} */
				
				/* var ge:GeneralEvent = new GeneralEvent("childChanged", true);
				ge.value = dataItem;
				event.currentTarget.dispatchEvent( ge );
				ReviewOfSystemHelper.setButtonSkin( dataItem, id_btnNormal, id_btnAbnormal ); */
			}
			
			protected function onDictationNoteButtonsClick():void
			{
				if (!id_btnDictation.selected && !id_btnNote.selected)
				{
					if (viewModel.inDictationMode)
						viewModel.inDictationMode = false;
					
					if (viewModel.inNoteMode)
						viewModel.inNoteMode = false;
					viewModel.visible = false;
				}
			}
			
			private function saveClickHandler():void
			{
				if (!dataItem)
					return;
				
				var ge:GeneralEvent = new GeneralEvent("saveClick", true);
				ge.value = dataItem;
				dispatchEvent( ge );
				
				dispatchEvent( new Event( 'saveStatus', true ) );
			}
			
			protected function cc():void
			{
				viewModel.inlineEditing = true;
			}
			
		]]>
	</fx:Script>
	
	
	
	<s:layout>
		<s:VerticalLayout paddingLeft="8" paddingRight="8" paddingTop="8" paddingBottom="8" gap="5"/>
	</s:layout>
	
	<s:HGroup width="100%" verticalAlign="middle">
		<s:RichText color="#FFFFFF" fontFamily="CalibriCFF"	fontSize="12" maxDisplayedLines="1" showTruncationTip="true"
					text="{(dataItem.SubLevel3CategoryName.length > 0 ? dataItem.SubLevel3CategoryName : dataItem.SubCategoryName)}" typographicCase="uppercase"/>	
		<s:ToggleButton id="id_btnNormal" 
						click="onNormalClick(event)"
						selected="{dataItem.IsNormal == QSConstants.STRING_TRUE }"
						buttonMode="true" useHandCursor="true" toolTip="Normal"
						skinClass="com.gazuntite.common.view.components.reviewofsystem.skin.NTB1"
						/>
		<s:ToggleButton id="id_btnAbnormal" 
						click="onAbNormalClick(event)"
						selected="{dataItem.IsAbNormal == QSConstants.STRING_TRUE }"
						buttonMode="true" useHandCursor="true" toolTip="Abnormal"
						skinClass="com.gazuntite.common.view.components.reviewofsystem.skin.ATB1"
						/>
	</s:HGroup>
	
	<s:HGroup width="100%" horizontalAlign="right" paddingRight="8" verticalAlign="middle">
		<s:ToggleButton id="id_btnDictation"
						click="onDictationNoteButtonsClick()"
						selected="@{viewModel.inDictationMode}"
						toolTip="Record Level Dictation"
						skinClass="{ (dataItem.DictationID &amp;&amp; dataItem.DictationID != DictationConstants.GUID_FORMAT) ? DictationRedButtonSkin:DictationButtonSkin }"
						/>
		
		<s:ToggleButton id="id_btnNote"
						click="onDictationNoteButtonsClick()"
						selected="@{viewModel.inNoteMode}"
						toolTip="Record Level Notes"
						skinClass="{dataItem.Note.length > 0 ? NotesRedButtonSkin : WriteNoteButtonSkin}"
						/>
		<s:Button buttonMode="true"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  toolTip="Save"  
				  click="saveClickHandler()"
				  right="0" verticalCenter="0"
				  tabIndex="5"
				  />
	</s:HGroup>
	
	<dictation:PatientDictationNoteView id="id_dictationNoteView" 
										width="100%" minHeight="47" viewModel="{viewModel}" noteTooltip="{dataItem.Note}" note="@{dataItem.Note}"	isSaveButtonVisible="false"
										DictationID="@{dataItem.DictationID}" IsDictaionEditMode="{true}" ShowSaveButton="false"
										/>
	
</s:SkinnableContainer>
