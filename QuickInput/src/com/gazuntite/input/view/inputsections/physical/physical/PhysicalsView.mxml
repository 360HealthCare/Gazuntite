<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:diabetes="com.gazuntite.provider.live.services.diabetes.view.physical.*"
		 xmlns:physical="com.gazuntite.input.view.inputsections.physical.physical.*" 
		 xmlns:reviewofsystem="com.gazuntite.input.view.inputsections.physical.reviewofsystem.*"
		 xmlns:qicomponent="com.gazuntite.view.patient.component.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:dictation="com.gazuntite.components.dictation.*" 
		 xmlns:skins="com.gazuntite.input.view.skins.*"
		 xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" 
		 xmlns:dictation2="com.gazuntite.dictation.view.dictation.*" 
		 creationComplete="cc(event)"
		 >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleDictationDTO;
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.dto.physical.ros.PhysicalDTO;
			import com.gazuntite.common.event.visit.ManageModuleNotesEvent;
			import com.gazuntite.common.view.components.CustomSaveAndMoveNextAlert;
			import com.gazuntite.common.view.components.reviewofsystem.PatientInputPhysicalReviewOfSystemViewModel;
			import com.gazuntite.common.view.events.SelectSection;
			import com.gazuntite.dictation.view.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.input.event.visit.NotesDictation.ManageModuleDictationEvent;
			import com.gazuntite.input.event.visit.physical.physical.ManagePatientPhysicalEvent;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.utils.QIUtilityFunctions;
			import com.gazuntite.input.view.viewmodel.tempmodel.TempModelPhysicalRos;
			import com.gazuntite.input.view.viewmodel.tempmodel.TempModelPhysicalRosItemLevelOne;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.binding.utils.BindingUtils;
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			[Bindable]	private var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]	public var viewModel:PatientInputPhysicalReviewOfSystemViewModel = new PatientInputPhysicalReviewOfSystemViewModel();//.getInstance();
			[Bindable]	private var dictationNoteViewModel:PatientDictationNoteViewModel =  viewModel.physicalDictationNoteViewModel;
			[Bindable]	private var notesDTO:ModuleNoteDTO;
			[Bindable]  private var dictationDTO:ModuleDictationDTO;
			[Bindable]	public var NavItems:ArrayCollection;
			private var _moduleName:String;
			
			[Bindable]
			public function get moduleName():String
			{
				return _moduleName;
			}
			
			public function set moduleName(value:String):void
			{
				_moduleName = value;
				
				dictationNoteViewModel = viewModel.physicalDictationNoteViewModel;
				
				if (moduleName.length < 0)
					return;
				
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(moduleName);
				dictationDTO = QIUtilityFunctions.getModuleDictationDTO(moduleName);
			}
			
			/////////////////// Physical STATIC DATA PROVIDER ////////////////////////////////////////////
			[Bindable]
			private var PhysicalList:ArrayCollection;
			
			private var firstLevelLabels:Array 		= ["General", "HEENT", "Respiratory", "Cardiovascular", "Breast", "Gastrointestinal", "Genitourinary", "Lymph/Endo", "Nuscle/Skel", "Skin", "Neurological", "Allergy" ,"Psychiatric", "Other", "Respiratory", "Cardiovascular", "Breast", "Gastrointestinal", "Genitourinary", "Lymph/Endo"];
			private var SecondLevelLabels:Array 	= ["Avg. Weight", "Weight Loss/Gain", "Sense of Well Being", "Strength", "Conduct Usual Activities", "Exercise Tolerance", "Fatigue", "Fever/chills", "Weakness", "Trouble Sleeping", "General State of Health", "Other"];
			private var HEENT2ndLevelLabels:Array 	= ["Head", "Eyes", "Ears", "Nose", "Throat"];
			private var HEENT3rdLevelLabels:Array 	= ["Headaches", "Vertigo", "Light Headedness", "Head Injury", "Other"];
			
			private function createDP():void
			{
				PhysicalList = new ArrayCollection();
				var i:int;
				for(i = 0; i < firstLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = firstLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = i;
					
					if( i == 1 )
						create2ndLevelHEENT( dto );
					else
						create2ndLevel( dto );
					
					PhysicalList.addItem( dto );
				}
			}
			
			private function create2ndLevel(parent:PhysicalDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < SecondLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = SecondLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = parent.PhysicalMainCategoryTypeID;
					dto.PhysicalSubCategoryTypeID = i;
					
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			private function create2ndLevelHEENT(parent:PhysicalDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < HEENT2ndLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = HEENT2ndLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = parent.PhysicalMainCategoryTypeID;
					dto.PhysicalSubCategoryTypeID = i;
					create3rdLevel( dto );
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			private function create3rdLevel(parent:PhysicalDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < HEENT3rdLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = HEENT3rdLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = parent.PhysicalSubCategoryTypeID;
					dto.PhysicalSubCategoryTypeID = i;
					
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			/////////////////// Physical STATIC DATA PROVIDER ////////////////////////////////////////////
			
			protected function cc(event:FlexEvent):void
			{
				/* arrCol = new ArrayCollection();
				arrCol.source = [{serialNumber: "1", headerLabel:"General- Avg.Weight [Abnormal]", inDictationNoteMode: false}, 
				{serialNumber: "2", headerLabel:"Head- Headache [Abnormal]", inDictationNoteMode: false}, 
				{serialNumber: "3", headerLabel:"Skin- Rash [Normal]", inDictationNoteMode: false}, 
				{serialNumber: "4", headerLabel:"Complete PE/Chronic [Abnormal]", inDictationNoteMode: false}]; */
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
				createDP();
				BindingUtils.bindSetter(CheckPatientHasDiabetes, model, "diagnosisDTOAcuteHistoryList");
				BindingUtils.bindSetter(CheckPatientHasDiabetes, model, "diagnosisDTOChronicHistoryList");
				BindingUtils.bindSetter(CheckPatientHasDiabetes, model, "diagnosisDTOList");
			}
			
			private function CheckPatientHasDiabetes(collection:Object):void
			{
				/* titleBar.showDiabetesButton = QIUtilityFunctions.isDiabetesPaitent();   */
				QIUtilityFunctions.isDiabetesPaitent();  
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = moduleName;
				event.data = notesDTO;
				
				//M added case for dictation
				if(event.isNoteSave)
				{
					if(null == notesDTO)
					{
						notesDTO = QIUtilityFunctions.getModuleNoteDTO(moduleName);
					}
					var manage:ManageModuleNotesEvent = new ManageModuleNotesEvent( notesDTO, QIConstants.PHYSICAL_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( manage );
				}			
				else
				{
					if (!dictationDTO)
					{
						var dictaionId:String = id_DictationNote.DictationID;
						
						dictationDTO = QIUtilityFunctions.getModuleDictationDTO(QIConstants.PHYSICAL_MODULE_NAME);
						dictationDTO.DictationID = dictaionId;
					}
					
					var dicEvent:ManageModuleDictationEvent = new ManageModuleDictationEvent( dictationDTO, QIConstants.PHYSICAL_MODULE_NAME, model.LoggedInUserId, model.LoggedInUserSessionID, model.ClinicBranchIdSeq, ManageModuleNotesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent( dicEvent );
				}
			}
			
			private function ManageModuleNotesCallBack(isNoteSaved:Boolean, moduleName:String):void
			{
				trace(moduleName + " module Notes save operation " + isNoteSaved ? "successful":"failed")
				if(id_DictationNote)
				{
					dictationNoteViewModel.visible = false;
					//id_DictationNote.note = '';
				}
			}
			
			public function id_allNormalButton_changeHandler(event:Event):void
			{
				if( null != id_PhysicalInputView && null != id_PhysicalInputView.id_PhysicalsView )
				{
					id_PhysicalInputView.id_PhysicalsView.ToggleAllNormal( ! event.target.selected );
				}
			}
			
			protected function saveButton_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("saveData", true) );
			}
			
			protected function id_diabetesRB_changeHandler(event:Event):void
			{
				if(id_DiabetesNormalRB.selected)
					uiViewStack.selectedIndex = 0;
				else if(id_DiabetesRB.selected)
					uiViewStack.selectedIndex = 1;
			} 
			
			/* protected function NextButton_clickHandler(event:MouseEvent):void
			{
			dispatchEvent(new SelectSection(SelectSection.SelectSelectionEvent,'Physical/ROS Panel'));
			} */
			
			// save & Move next logic ......................
			protected function Next_buttonClickHandler(event:MouseEvent):void
			{
				if(null != id_PhysicalInputView && null != id_PhysicalInputView.id_PhysicalsView && id_PhysicalInputView.id_PhysicalsView.IsDataDirty() )
				{
					var hideOption:String = CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE ;
					QIUtilityFunctions.AskMoveNextAlert( MoveNextHandler, null, hideOption );
				}
				else
					MoveToNextPanel();
			}
			
			public function ClearData():void
			{
				if( null != id_PhysicalInputView && null != id_PhysicalInputView.id_PhysicalsView && null != model.physicalDTOList)
				{
					model.physicalDTOList.removeAll();
					id_PhysicalInputView.id_PhysicalsView.clearData();
				}
				dictationDTO = null;
				notesDTO	 = null;
				
				if(id_DictationNote)
				{
					dictationNoteViewModel.visible = false;
					id_DictationNote.note = '';
					id_DictationNote.resetToDefault();
				}				
			}
			
			private function saveData():void
			{
				var mpe:ManagePatientPhysicalEvent = new ManagePatientPhysicalEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( mpe );
			}
			
			private function MoveNextHandler(value:String):void
			{
				switch(value)
				{
					case CustomSaveAndMoveNextAlert.SAVE_AND_MOVE_NEXT :
						SaveAndMoveNext();
						break;
					case CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE :
						saveData();
						break;
					case CustomSaveAndMoveNextAlert.DISCARD_AND_MOVE_NEXT :
						DiscardAndMoveNext();
						break;
				}
			}
			
			private function DiscardAndMoveNext():void
			{
				if( null != id_PhysicalInputView && null != id_PhysicalInputView.id_PhysicalsView && null != model.physicalDTOList)
				{
					id_PhysicalInputView.id_PhysicalsView.clearData();
				}
				MoveToNextPanel();
			}
			
			private function SaveAndMoveNext():void
			{
				saveData();
				MoveToNextPanel();
			}
			
			private function MoveToNextPanel():void
			{
				dispatchEvent(new SelectSection(SelectSection.SelectSelectionEvent,'In-House Lab'));
			}
			
			
			protected function onGotoSectionEventHandler(event:Event):void
			{
				if( null != id_PhysicalInputView && null != id_PhysicalInputView.id_PhysicalsView && null != model.physicalDTOList)
				{
					id_PhysicalInputView.id_PhysicalsView.clearViewModel();
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="id_diabetesRB" change="id_diabetesRB_changeHandler(event)" />
	</fx:Declarations>
	
	<s:BorderContainer width="100%" height="100%" borderVisible="false" backgroundColor="0xFFFFFF" cornerRadius="3">
		<s:layout>
			<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="0"	paddingLeft="1"	paddingRight="1"/>
		</s:layout>
		<skins:PatientSubViewTitleBar id="titleBar" 
									  width="100%" label="{moduleName}"   maxSectionCounter="5" sectionNumber="4" showInputPart="true" inputCounter="0" showFlipButton="true"
									  PrevSectionLabel="Review of System"
									  NextSectionLabel="In-House Lab"
									  MainSectionLabel="Physical"
									  NavItems="{NavItems}"
									  SectionLevelNote="@{id_DictationNote.note}"
									  dictationNoteViewModel="{dictationNoteViewModel}" showAllNormalButton="true"
									  SectionLevelDictationID="{dictationDTO.DictationID}"
									  
									  gotoNextSectionEvent="onGotoSectionEventHandler(event)"
									  gotoPrevSectionEvent="onGotoSectionEventHandler(event)"
									  />
		
		<dictation2:PatientDictationNoteView id="id_DictationNote" 
											 width="100%" minHeight="47" viewModel="{dictationNoteViewModel}"
											 isSectionLevel="true" 
											 note="@{notesDTO.Note}"
											 IsDictaionEditMode="true"
											 DictationID="@{dictationDTO.DictationID}"										 
											 />
		<s:Scroller width="100%" height="100%"  
					skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" 
					horizontalScrollPolicy="off" verticalScrollPolicy="auto">
			<s:Group width="100%" height="100%">
				<s:layout>
					<s:VerticalLayout gap="0" />
				</s:layout>
				
				<s:Group width="100%" height="100%" ><!-- skinClass="com.gazuntite.skins.controls.container.PinkBackgroundSkin"-->
					<components:LabelViewStack id="uiViewStack" width="100%" height="100%" backgroundAlpha="1" borderVisible="false">
						<s:ArrayList>
							<physical:PhysicalInputView id="id_PhysicalInputView" width="100%" height="100%" moduleName="{moduleName}"/>
							<diabetes:PhysicalDiabeticView width="100%" height="100%" />
						</s:ArrayList>
					</components:LabelViewStack>
				</s:Group>
				
				
				<s:HGroup width="100%" verticalAlign="middle" paddingBottom="4" paddingLeft="4" paddingRight="4" paddingTop="3">
					<!--<s:CheckBox id="id_allNormalButton"  visible="{uiViewStack.selectedIndex == 0}" includeInLayout="{id_allNormalButton.visible}"
					verticalCenter="0" skinClass="com.gazuntite.skins.controls.checkbox.AllNormalCheckBoxSkin"
					toolTip="All Normal" buttonMode="true" useHandCursor="true"
					change="id_allNormalButton_changeHandler(event)"
					/>-->
					
					<s:ToggleButton id="id_allNormalButton"  visible="{uiViewStack.selectedIndex == 0}" includeInLayout="{id_allNormalButton.visible}"
									skinClass="com.gazuntite.skins.controls.button.AllNormalToggleButtonSkin"
									toolTip="All Normal" buttonMode="true" useHandCursor="true"
									change="id_allNormalButton_changeHandler(event)"
									/>
					
					<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.BlueRadioButtonBG"
										  height="25" width="110" verticalCenter="0">
						<s:layout>
							<s:HorizontalLayout verticalAlign="middle" gap="0" horizontalAlign="center"/>
						</s:layout>
						<s:RadioButton id="id_DiabetesNormalRB" 
									   groupName="id_diabetesRB" skinClass="com.gazuntite.skins.controls.radioButton.NormalRadioButtonSkin"
									   toolTip="Normal" selected="true" />
						<s:RadioButton id="id_DiabetesRB" 
									   label="Diabetes" 
									   groupName="id_diabetesRB" skinClass="com.gazuntite.skins.controls.radioButton.DiabeticRadioButtonSkin"
									   toolTip="Diabetics" />
					</s:SkinnableContainer>
					<s:Spacer width="100%" />
					
					<s:Button buttonMode="true"
							  skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin" 
							  label="Next" 
							  toolTip="Next"
							  click="Next_buttonClickHandler(event)"/>
				</s:HGroup>
			</s:Group>	
		</s:Scroller>
	</s:BorderContainer>
</s:Group>