			public function setCalculationAndConversions(isMetric:Boolean):void
			{
				this.isMetric = isMetric;
				
				var bh:Number = 0;
				var bw:Number = 0;
				var bt:Number = 0;
				
				if(isMetric)
				{
					id_height.label = "Height (Cm)";
					id_weight.label = "Weight (Kg)";
					id_temp.label   = "Temp (C)";	
					
					id_height.Unit = " Inch";
					id_weight.Unit = " Lbs";
					id_temp.Unit   = " F";														
				}
				else
				{
					id_height.label = "Height (Inch)";
					id_weight.label = "Weight (Lbs)";
					id_temp.label   = "Temp (F)";
					
					id_height.Unit = " Cm";
					id_weight.Unit = " Kg";
					id_temp.Unit   = " C";	
				}
				
				id_height.invalidateDisplayList();
				id_height.invalidateSize();
				id_height.invalidateProperties();
				
				id_weight.invalidateDisplayList();
				id_weight.invalidateSize();
				id_weight.invalidateProperties();
				
				id_temp.invalidateDisplayList();
				id_temp.invalidateSize();
				id_temp.invalidateProperties();
				
				this.invalidateDisplayList();
				this.invalidateSize();
				this.invalidateProperties();
				/* id_weight.invalidateDisplayList();
				id_temp.invalidateDisplayList(); */
				
				bh = id_height.valueB;
				bw = id_weight.valueB;
				bt = id_temp.valueB;
				
				id_weight.valueB = id_weight.valueA;
				id_height.valueB = id_height.valueA;
				id_temp.valueB = id_temp.valueA;
				
				id_weight.valueA = bw;
				id_height.valueA = bh;
				id_temp.valueA = bt;
				
				heightPreValue = id_height.valueA;
				weightPreValue = id_weight.valueA;
				temprPreValue = id_temp.valueA;
				
				calculateBMI();
			}
			
			public function SaveData():void
