					vital.sugarLevel = vitalsDTO.sugarLevel;
					vital.IsDirty = true;
					vital.ModifiedAt = new Date();
					vital.ModifiedBy = model.LoggedInUserId;
					vital.BPDys = id_SysPerDys.valueB.toString();	
					vital.BPSys =  id_SysPerDys.valueA.toString();	
					vital.Height =  id_height.valueA.toString();	
					vital.Weight =  id_weight.valueA.toString();	
					vital.Pulse = id_pulse.valueA.toString(); 	
					vital.Respiration =  id_resp.valueA.toString();	
					vital.Temperature =  id_temp.valueA.toString();	
					vital.Editable = "true";
					vital.PatientID = model.patientDTO.ID;
					
					vital.Oxygen =  id_os2.valueA.toString();	
					vital.IsMetricDisplaySelected = isMetric;
					
					var editEv:PatientInputPhysicalVitalsEvent = new PatientInputPhysicalVitalsEvent(PatientInputPhysicalVitalsEvent.PATIENT_INPUT_VITALS_EDIT_EVENT, true);
					editEv.vitalsDTO = vital;
					
					dispatchEvent(editEv);
				}
