						click="onDictationNoteButtonsClick()"
						selected="@{viewModel.inNoteMode}"
						toolTip="Record Level Notes" visible="false" includeInLayout="false"
						skinClass="com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin"
						/>
		<s:Button buttonMode="true" visible="{ShowSaveButton}" includeInLayout="{ShowSaveButton}"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  toolTip="Save"  click="SaveData()"
				  right="0" verticalCenter="0"
				  tabIndex="5"
				  />
		<s:Button visible="{!ShowSaveButton}" includeInLayout="{!ShowSaveButton}"
			skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin" 
			label="Next" 
			toolTip="Next"
			buttonMode="true" useHandCursor="true"
			tabIndex="8"
			click="NextButton_clickHandler(event)"
			/>
	</s:HGroup>
	
	<dictation2:PatientDictationNoteView id="dictationNoteView" width="100%" minHeight="47" viewModel="{viewModel}" noteTooltip="{vitalsDTO.Note}" note="@{vitalsDTO.Note}" isSaveButtonVisible="false" />
	
</s:Group>