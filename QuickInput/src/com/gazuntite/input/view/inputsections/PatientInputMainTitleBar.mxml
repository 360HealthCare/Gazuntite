<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.InputMainTitleBarSkin"
					  buttonMode="true" toolTip="Toggle Input Details"
					  click="skinnablecontainer1_clickHandler(event)"
					  height="28" 
					  >
	<fx:Metadata>
		[Event(name="InputHeaderClickEvent", type="flash.events.Event")]
		[Event(name="InputHeaderOptionClickEvent", type="flash.events.Event")]
		[Event(name="CheckoutClickEvent", type="flash.events.Event")]
		[Event(name="OpenNavMenueEvent", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.MaxRestorePopupManager;
			import com.gazuntite.common.view.PatientViewModel;
			
			import mx.core.UIComponent;
			[Bindable]
			public var viewModel:PatientViewModel = PatientViewModel.getInstance();
			
			[Bindable]
			public var maximizeView:UIComponent;
			
			protected function onOptionClick(event:MouseEvent):void
			{
				dispatchEvent( new Event("InputHeaderOptionClickEvent", true, false ) );
				
				id_Options.visible = false;
				
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
			}
			
			protected function skinnablecontainer1_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("InputHeaderClickEvent", true, false ) );
			}
			
			protected function onExpandRestore(event:MouseEvent):void
			{
				//				MaxRestorePopupManager.maxRestoreView(maximizeView);
				MaxRestorePopupManager.maxPatientView(PatientViewModel.MAIN_TAB_INPUT);
				event.stopImmediatePropagation();
				expand.selected = false;
			}
			
			protected function checkOut_clickHandler(event:MouseEvent):void
			{
				//if(id_checkTbtn.selected)
			//	{
					dispatchEvent( new Event("CheckoutClickEvent", true, false ) );
					event.stopImmediatePropagation();
					event.stopPropagation();
					event.preventDefault();
			//	}
			}
			
			protected function onOpenNavMenue(event:MouseEvent):void
			{
				dispatchEvent( new Event("OpenNavMenueEvent", true, false ) );
				
				event.stopImmediatePropagation();
				event.stopPropagation();
				event.preventDefault();
			}
			
		]]>
	</fx:Script>
	<s:layout>
		<s:BasicLayout/>
	</s:layout>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:RichText left="6" verticalCenter="0" color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="16" fontWeight="bold"	text="INPUT" visible="false" includeInLayout="false">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	
	<s:HGroup  horizontalCenter="0" verticalCenter="0" gap="10">
		<s:Button id="id_Options"
				  buttonMode="true" useHandCursor="true"
				  skinClass="com.gazuntite.skins.controls.button.input.InputOptionButtonSkin"
				  click="onOptionClick(event)"
				  />
		<s:Group height="100%">
			<s:Button id="id_btnOpenNav" 
					  toolTip="Navigation" click="onOpenNavMenue(event)"
					  skinClass="com.gazuntite.skins.controls.button.input.QINavButtonSkin"
					  useHandCursor="true" buttonMode="true" top="1" />
		</s:Group>
	</s:HGroup>
	
	
	<!-- Patient Name -->
	<s:RichText right="31" verticalCenter="0" color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="16"
				text="{viewModel.expandMainInput?viewModel.selectedPatient.FullName:viewModel.selectedPatient.FullName}" 
				fontWeight="bold" typographicCase="uppercase" 
				visible="false" includeInLayout="false"
				>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<!-- Checkout Button -->
	<s:ToggleButton id="id_checkTbtn" 
					label="Checkout"
					toolTip="Checkout"
					buttonMode="true" useHandCursor="true"
					skinClass="com.gazuntite.skins.controls.toggleButtonSkin.input.CheckoutTBSkin"
					right="36" verticalCenter="0" width="75"
					click="checkOut_clickHandler(event)"
					/>
	<s:ToggleButton id="expand" 
					label="Expand" verticalCenter="0" right="5" 
					enabled="{viewModel.expandMainInput}"
					buttonMode="true" useHandCursor="true" toolTip="{expand.selected?'Restore':'Expand'}"
					skinClass="com.gazuntite.skins.controls.button.eLab.ExpandButtonSkin"
					click="onExpandRestore(event)"
					/>
	
</s:SkinnableContainer>