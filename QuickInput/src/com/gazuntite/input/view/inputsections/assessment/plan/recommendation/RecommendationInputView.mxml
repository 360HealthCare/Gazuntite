<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:recommendation="com.gazuntite.input.view.inputsections.assessment.plan.recommendation.*"
		 creationComplete="cc()"
		 >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.utils.UtilityFunctions;
			
			[Bindable]	public var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]	private var viewModel:PatientInputAssessmentRecommendationViewModel = PatientInputAssessmentRecommendationViewModel.getInstance();
			
			[Bindable] public var RecordLevelNote:String = '';
			[Bindable] public var TempRecordLevelNote:String = '';
			
			//M:11Nov2013
			[Bindable]
			public var RecordLevelDictationID:String;
			
			private function cc():void
			{
				addEventListener(PatientInputAssessmentRecommendationEvent.PATIENT_INPUT_RECOMMENDATION_ITEM_EDIT_KEY_UP_EVENT, 
					recommendationItemEditKeyUpHandler, false, 0, true);
				addEventListener(PatientInputAssessmentRecommendationEvent.PATIENT_INPUT_RECOMMENDATION_ADD_EVENT, 
					recommendationAddHandler, false, 0, true);
				addEventListener(PatientInputAssessmentRecommendationEvent.PATIENT_INPUT_RECOMMENDATION_EDIT_EVENT, 
					managePatientRecommendationHandler, false, 0, true);
				addEventListener(PatientInputAssessmentRecommendationEvent.PATIENT_INPUT_RECOMMENDATION_DELETE_EVENT, 
					managePatientRecommendationHandler, false, 0, true);
			}
			
			private function recommendationItemEditKeyUpHandler(event:PatientInputAssessmentRecommendationEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 2 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadRecommendationWebLinks(event.searchString);
			}
			
			private function recommendationAddHandler(event:PatientInputAssessmentRecommendationEvent):void
			{
				if (!event.recommedationDTO)
					return;
				
				if (!model.recommendationDTOList)
					model.recommendationDTOList = new ArrayCollection();
				
				model.recommendationDTOList.addItem(event.recommedationDTO);
				
				event.recommedationDTO.serialNumber = model.recommendationDTOList.length;
				
				viewModel.managePatientRecommendation(QIConstants.INPUT_VIEW);
			}
			
			private function managePatientRecommendationHandler(event:PatientInputAssessmentRecommendationEvent):void
			{
				viewModel.managePatientRecommendation(QIConstants.INPUT_VIEW);
			}
			
			public function ClearRecommendationView():void
			{
				if(id_recommendationFormView)
					id_recommendationFormView.clearForm();
				if(model.recommendationDTOList)
				model.recommendationDTOList.removeAll();
			}
			
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(model.recommendationDTOList && model.recommendationDTOList.length)
				{
					switch (uiSortDropDown.selectedIndex)
					{
						case 0:
							model.recommendationDTOList = UtilityFunctions.SortArrayCollection(model.recommendationDTOList,'serialNumber',true,false);
							break;
						case 1: 
							model.recommendationDTOList = UtilityFunctions.SortArrayCollection(model.recommendationDTOList,'label',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSortDropDown)
						uiSortDropDown.selectedIndex = 0;
				}
				
			}
			
			
			protected function id_recommendationFormView_keyDownHandler(event:KeyboardEvent):void
			{
				id_recommendationFormView.IsViewDirty = true;
			}
			
		]]>
	</fx:Script>
	<fx:Binding source="model.recommendationDTOList" destination="DataList_changeHandler" />
	<s:layout>
		<s:VerticalLayout paddingLeft="2" paddingRight="2" paddingTop="10" paddingBottom="2" gap="0"/>
	</s:layout>
	
	<s:Scroller width="100%" height="100%" 
				horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<recommendation:RecommendationInputFormView id="id_recommendationFormView" width="100%" dictationNoteViewModel="{viewModel.inlineDictationNoteViewModel}" keyDown="id_recommendationFormView_keyDownHandler(event)" RecordLevelNote="@{RecordLevelNote}"
														RecordLevelDictationID="@{RecordLevelDictationID}"/>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
				<s:DropDownList id="uiSortDropDown" skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
								selectedIndex="0" buttonMode="true" toolTip="Sort List"
								change="SortDataList()">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added"/>
							<fx:Object label="Plan Type"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%"/>
			</s:SkinnableContainer>
			
			<s:List id="recommendationInputList" 
					width="100%" minHeight="50"
					borderVisible="false" 
					dataProvider="{model.recommendationDTOList}"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					itemRenderer="com.gazuntite.input.view.inputsections.assessment.plan.recommendation.RecommendationListItemRenderer"
					/>
		</s:Group>
	</s:Scroller>
</s:Group>
