<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="cc()">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.utils.UtilityFunctions;
			
			[Bindable]
			public var model:QIModelLocator = QIModelLocator.getInstance();
			
			private function cc():void
			{
			}
			
			
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(model.recommendationDTOHistoryList && model.recommendationDTOHistoryList.length)
				{
					switch (uiSortDropDown.selectedIndex)
					{
						case 0:
							model.recommendationDTOHistoryList = UtilityFunctions.SortArrayCollection(model.recommendationDTOHistoryList,'serialNumber',true,false);
							break;
						case 1: 
							model.recommendationDTOHistoryList = UtilityFunctions.SortArrayCollection(model.recommendationDTOHistoryList,'label',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSortDropDown)
						uiSortDropDown.selectedIndex = 0;
				}
				
			}
			
			
		]]>
	</fx:Script>
	<fx:Binding source="model.recommendationDTOHistoryList" destination="DataList_changeHandler" />
	<s:layout>
		<s:VerticalLayout paddingLeft="2" paddingRight="2" paddingTop="10" paddingBottom="2" gap="0"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
		</s:layout>
		<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
		<s:DropDownList id="uiSortDropDown" skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
						selectedIndex="0" buttonMode="true" toolTip="Sort List"
						change="SortDataList()">
			<s:dataProvider>
				<s:ArrayCollection>
					<fx:Object label="Recently Added"/>
					<fx:Object label="Plan Type"/>
				</s:ArrayCollection>
			</s:dataProvider>
		</s:DropDownList>
		<s:Spacer width="100%"/>
	</s:SkinnableContainer>
	
	<s:List id="recommendationHistoryList" width="100%" height="100%"
			skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
			borderVisible="false" dataProvider="{model.recommendationDTOHistoryList}"
			itemRenderer="com.gazuntite.input.view.inputsections.assessment.plan.recommendation.RecommendationListItemRenderer"/>
</s:Group>
