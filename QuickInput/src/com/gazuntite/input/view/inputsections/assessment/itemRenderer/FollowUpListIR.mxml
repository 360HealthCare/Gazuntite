<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx"
				xmlns:components="com.gazuntite.components.*" 				
				xmlns:followUp="com.gazuntite.input.view.inputsections.assessment.plan.followUp.*"
				xmlns:dictation="com.gazuntite.dictation.view.dictation.*" 
				autoDrawBackground="false"
				initialize="init()"
				width="100%" 
				>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.assessment.followUp.FollowUpDTO;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.input.view.inputsections.assessment.plan.followUp.FollowUpListItemEditView;
			import com.gazuntite.input.view.inputsections.assessment.plan.followUp.PatientInputAssessmentFollowUpEvent;
			import com.gazuntite.skins.controls.container.input.RecordEditPopupSkin;
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			[Bindable]	
			public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			[Bindable]	private var followUpDTO:FollowUpDTO;
			[Bindable]  private var isEditViewOpen:Boolean = false;
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				if(data)
					followUpDTO = data as FollowUpDTO;
				
				if (!followUpDTO)
					return;
				
				var serialLabel:String = "";
				if(id_SerialLabel)
					id_SerialLabel.text = followUpDTO.serialNumber + ". ";
				
				if (followUpDTO.IsByDate)
				{
					serialLabel += followUpDTO.FollowUpDate;
				}
				else if (followUpDTO.IsOnCompletion)
				{
					if (followUpDTO.IsLabTestSelected && followUpDTO.LabTest)
					{
						serialLabel += followUpDTO.LabTest.Name;
					}
					else if (followUpDTO.IsDrugselected && followUpDTO.Drug)
					{
						serialLabel += followUpDTO.Drug.Name;
					}
				}
				
				if(id_SerialLabel)
				{
					id_SerialLabel.text += serialLabel;
					id_SerialLabel.toolTip = serialLabel;
				}
				
				setDictationNoteButtonMode();
				//	isEditViewOpen = false;
				//	removeEditView();
				glowAnimation.play(null, true);
				glow1.alpha = 0;
				
				invalidateDisplayList();
			}
			
			override protected function updateDisplayList(unscaledWidth:Number, unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				if(itemIndex == 0)
					id_layout.paddingTop = 3;
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			private function init():void
			{
				viewModel.inlineEditing = true;
			}
			
			protected function toggleEditView(sectionNo:int):void
			{				
				if(!followUpDTO) 
					return;
				
				if(sectionNo == 2 )
				{
					if(id_btnEdit.selected)
					{
						followUpDTO.inEditMode = false;
						isEditViewOpen = true;
						openEditView();
						showGlow();
						return;
					}else
					{
						removeEditView();
						glowAnimation.play(null, true);
						glow1.alpha = 0;
						isEditViewOpen 								= false;
						id_btnEdit.selected 						= false;
						return;
					}
				}else
				{
					removeEditView();
					if(id_btnEdit.selected)
						id_btnEdit.selected = false;
					isEditViewOpen = false;
				}
				
				followUpDTO.inEditMode = !followUpDTO.inEditMode;
				setDictationNoteButtonMode();
				showGlow();
			}
			
			private function toggleEditViewOld():void
			{
				if(!followUpDTO)
					return;
				
				if(followUpDTO)
					followUpDTO.inEditMode = !followUpDTO.inEditMode;
				
				setDictationNoteButtonMode();
			}
			
			protected function openEditView():void
			{
				if(!id_btnEdit.selected)
					return;
				else if(id_editExpandView.numChildren > 0)
					removeEditView();
				
				var editor:FollowUpListItemEditView						= new FollowUpListItemEditView();
				editor.followUpDTO 										= followUpDTO;
				editor.width  											= id_editExpandView.width - 5;
				
				editor.setStyle('skinClass', RecordEditPopupSkin);
				
				editor.addEventListener('saveStatus',function(event:Event):void{
					
					isEditViewOpen = false;
					id_btnEdit.selected = false;
					removeEditView();
					
				});
				
				id_editExpandView.addElement(editor);
				editor.id_followUpTypeCmbo.setFocus();
			}
			
			private function removeEditView():void
			{
				if(id_editExpandView)
				{
					if(id_editExpandView.numChildren > 0)
						id_editExpandView.removeAllElements();
				}
			}
			
			private function deleteClickHandler(event:MouseEvent):void
			{
				if (!followUpDTO)
					return;
				
				UtilityFunctions.AskMessage("Are you sure want to delete selected record ?", function():void
				{
					followUpDTO.IsDeleted = true;
					followUpDTO.IsDirty = true;
					
					var ev:PatientInputAssessmentFollowUpEvent = new PatientInputAssessmentFollowUpEvent(
						PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_FOLLOW_UP_DELETE_EVENT, true);
					
					ev.followUpDTO = followUpDTO;
					
					dispatchEvent(ev);
				});
				
				event.stopPropagation();
			}
			
			private function setDictationNoteButtonMode():void
			{
				if (followUpDTO && !followUpDTO.inEditMode)
				{
					if (viewModel.inDictationMode)
						viewModel.inDictationMode = false;
					
					if (viewModel.inNoteMode)
						viewModel.inNoteMode = false;
				}
				
				showGlow();
			}
			
			private function showGlow():void
			{
				if(!followUpDTO)
					return;
				
				if (followUpDTO.inEditMode)
				{
					glow1.alpha = 1;
					glowAnimation.play();
				}
				else
				{
					glowAnimation.play(null, true);
					glow1.alpha = 0;
					id_ItemExpandView.viewModel.visible 	= false;
				}
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:Animate id="glowAnimation" target="{glow1}" duration="250" >
			<s:motionPaths>
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurX"  />
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurY"/>
			</s:motionPaths>
		</s:Animate>
	</fx:Declarations>
	
	<s:filters>
		<s:GlowFilter id="glow1" blurX="5" blurY="5" alpha="0" color="#3575D0" strength="3" inner="false"/>
	</s:filters>
	
	<s:layout>
		<s:VerticalLayout id="id_layout" horizontalAlign="center" verticalAlign="top" gap="-4" paddingBottom="1" />
	</s:layout>
	
	<s:SkinnableContainer id="id_Header" width="{this.width - 7}" height="26" >
		<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="5" paddingRight="8"
				  buttonMode="true" toolTip="Open/Close Details"
				  click="toggleEditView(1)">
			
			<s:Label id="id_SerialLabel"  color="#333333" fontFamily="CalibriCFF" fontSize="14" maxDisplayedLines="1"
					 text="{itemIndex + 1  + '. ' + followUpDTO.FollowUpDate}"
					 toolTip="{followUpDTO.FollowUpDate}" width="100%"/>			
			
		</s:HGroup>
		<s:HGroup right="5" gap="4" verticalCenter="0" height="100%" verticalAlign="middle" horizontalAlign="right">
			<s:Image source="{QIConstants.IMG_NEW}"  buttonMode="true" useHandCursor="true"/>
			<s:ToggleButton id="id_btnEdit"
							click="toggleEditView(2)"
							buttonMode="true" toolTip="Edit the Record"
							selected="{isEditViewOpen}"
							skinClass="com.gazuntite.skins.controls.toggleButtonSkin.input.EditRecordArrowTBSkin"
							/>
			<s:Button skinClass="com.gazuntite.skins.controls.button.input.RecycleButtonSkin"
					  toolTip="Delete Follow-Up"  click="deleteClickHandler(event)"
					  />
		</s:HGroup>
	</s:SkinnableContainer>
	
	<s:Group id="gp" width="{id_Header.width - 5}" visible="{followUpDTO.inEditMode}" includeInLayout="{followUpDTO.inEditMode}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
		<followUp:FollowUpListItemExpandView id="id_ItemExpandView" width="100%" followUpDTO="{followUpDTO}"/>
	</s:Group>
	
	<s:Group id="id_editExpandView" width="{id_Header.width - 5}" top="21"  visible="{id_btnEdit.selected}" includeInLayout="{id_btnEdit.selected}">
		<s:layout>
			<s:VerticalLayout gap="-4" paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
	</s:Group>
</s:ItemRenderer>