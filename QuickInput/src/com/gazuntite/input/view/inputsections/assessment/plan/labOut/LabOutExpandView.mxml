<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin" xmlns:dictation="com.gazuntite.components.dictation.*"
					  creationComplete="cc(event)" xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" xmlns:dictation2="com.gazuntite.dictation.view.dictation.*"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.assessment.labOut.LabDTO;
			import com.gazuntite.dictation.utils.DictationConstants;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.skins.controls.button.input.DictationButtonSkin;
			import com.gazuntite.skins.controls.button.input.DictationRedButtonSkin;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]	private var leftLabelWidth:int = 90;
			[Bindable]	private var rightLabelWidth:int = 120;
			
			private var _labDTO:LabDTO;
			
			[Bindable]
			public function get labDTO():LabDTO
			{
				return _labDTO;
			}
			
			public function set labDTO(value:LabDTO):void
			{
				_labDTO = value;
				
			}
			
			public function associatedDiagnosisLabel(oItem:Object):String
			{
				var label:String = "";
				
				if (oItem && oItem.hasOwnProperty("IcdDto") && oItem.IcdDto )
				{
					if (oItem.IcdDto.hasOwnProperty("IcdCodeName"))
					{
						label += oItem.IcdDto.IcdCodeName + ", ";
					}
					
					if (oItem.IcdDto.hasOwnProperty("IcdCodeDescription"))
					{
						label += oItem.IcdDto.IcdCodeDescription;
					}
					
					label += oItem.IsChronic ? " (Chronic) " : " (Acute) ";
				}
				return label;
			}
			
			private var _isExpand:Boolean = false;
			
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			[Bindable]
			public function get isExpand():Boolean
			{
				return _isExpand;
			}
			
			public function set isExpand(value:Boolean):void
			{
				_isExpand = value;
				if(!isExpand)
					viewModel.visible = false;
			}
			
			protected function cc(event:FlexEvent):void
			{
				viewModel.inlineEditing = true;
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="5" paddingRight="5" paddingTop="5" paddingBottom="5"/>
	</s:layout>
	
	<s:HGroup width="100%">
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_TestType" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Test Type:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.LabTestType.Name}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_OrderMethod" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Order Method:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.LabTestOrderMethodType.Name}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_TestName" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Test Name:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.LIONICLabTestType.Name}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_TestCode" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Test Code:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:Label styleName="patientFormValue" text="{labDTO.LIONICLabTestType.testNum}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Description:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.Description}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Associated Diagnosis:" width="{rightLabelWidth}" styleName="patientFormLabel" maxDisplayedLines="1"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.DiagnosisInfo}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Priority:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.LabTestPriorityType.Name}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Specimen:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.LabTestSpecimenType.Name}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Collection Date:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.CollectionDate}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_Laboratory" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Laboratory:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:Label width="100%" styleName="patientFormValue" text="{labDTO.LabType.Name}" maxDisplayedLines="1" showTruncationTip="true"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" paddingRight="0" paddingLeft="15">
		<s:Label text="Notes:"	 styleName="patientFormLabel" />
		<s:Label text="{labDTO.Note}" toolTip="{labDTO.Note}" styleName="patientFormValue" maxDisplayedLines="1" showTruncationTip="true" width="100%"/>
		<s:ToggleButton id="id_btnDictation"
						selected="@{viewModel.inDictationMode}"
						toolTip="Record Level Dictation"
						click="{!id_btnDictation.selected ? viewModel.visible = false : true}"
						skinClass="{ (labDTO.DictationID &amp;&amp; labDTO.DictationID != DictationConstants.GUID_FORMAT) ? DictationRedButtonSkin:DictationButtonSkin }"
						/>
	</s:HGroup>
	
	<dictation2:PatientDictationNoteView width="100%" minHeight="47" viewModel="{viewModel}" noteTooltip="{labDTO.Note}" note="@{labDTO.Note}"	isSaveButtonVisible="false"
										 DictationID="{labDTO.DictationID}" IsDictaionEditMode="{false}"/>
	
</s:SkinnableContainer>