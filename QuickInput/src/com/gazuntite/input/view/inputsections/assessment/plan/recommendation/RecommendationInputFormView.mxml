						change="comboChangeHandler(event)"/>-->
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" >
			<s:Spacer width="11"/>
			<s:Label text="Discussed With Patient?" styleName="patientFormLabel"/>
			<s:Spacer width="11"/>
			<s:ToggleButton id="id_DiscussedWithPatient" buttonMode="true" tabIndex="5"
							skinClass="com.gazuntite.input.view.skins.YesNoToggleButtonSkin"
							toolTip="{id_DiscussedWithPatient.selected ? 'Yes' : 'No'}"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="50%" gap="7" verticalAlign="middle" >
			<s:BitmapImage id="img_Description" source="{QIConstants.IMG_RED}"/>
			<advancedTextInput:AdvancedTextInput id="id_Description" 
												 width="100%" 
												 prompt="Enter Description" toolTip="Description"  tabIndex="6"
												 change="descriptionChangeHandler()"
												 skinClass="com.gazuntite.components.kapit.advancedTextInput.AdvancedTextInputWithClearButtonSkin"
												 />
		
	</s:HGroup>
	<s:HGroup width="100%" gap="0" horizontalAlign="right">
		<s:HGroup width="100%" height="100%" verticalAlign="bottom" horizontalAlign="right">
			<s:ToggleButton 
				id="dictation"  includeInLayout="false" visible="false"
				toolTip="Dictation"
				skinClass="com.gazuntite.skins.controls.button.input.DictationButtonSkin" tabIndex="7"
				selected="@{dictationNoteViewModel.inDictationMode}"/>
			<s:ToggleButton 
				id="note" 
				toolTip="Note" includeInLayout="false" visible="false"
				skinClass="com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin" tabIndex="8"
				selected="@{dictationNoteViewModel.inNoteMode}"/>
			<s:Button id="save" 
					  toolTip="Save" 
					  skinClass="com.gazuntite.skins.controls.button.SavePlusButtonSkin"
					  click="saveClickHandler()" tabIndex="9"/>
			<s:Button id="Next" buttonMode="true"  useHandCursor="true"
					  toolTip="Next" skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin" 
					  label="Next"
					  click="Next_clickHandler(event)" tabIndex="10"/>
