									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
									   selectedItemChange="id_PlanTypeCmbo_selectedItemChangeHandler(event)"
									   textCleared="id_PlanTypeCmbo_textClearedHandler(event)"
									   />
			<!--<s:ComboBox id="id_PlanTypeCmbo" prompt="Select Plan Type" toolTip="Plan Type" width="100%" tabIndex="0"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						dataProvider="{model.recommendationPlanTypeDTOList}" labelField="Name"
						change="comboChangeHandler(event)"/>-->
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" >
			<s:Spacer width="11"/>
			<autoComplete:AutoComplete id="id_AssociatedDiagnosisCmbo" 
									   prompt="Select Associated Diagnosis" toolTip="Associated Diagnosis" width="100%" tabIndex="1"
									   dataProvider="{model.diagnosisDTOList}" labelFunction="associatedDiagnosisLabel"
									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
									   />
			<!--<s:ComboBox id="id_AssociatedDiagnosisCmbo" prompt="Select Associated Diagnosis" toolTip="Associated Diagnosis" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF" tabIndex="1"
						dataProvider="{model.diagnosisDTOList}" labelFunction="associatedDiagnosisLabel"/>-->
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" gap="0">
		<s:HGroup width="50%" verticalAlign="middle" >
			<s:BitmapImage id="img_Method" source="{QIConstants.IMG_RED}"/>
			<autoComplete:AutoComplete id="id_MethodCmbo" 
									   prompt="Select Method" toolTip="Method" width="100%" tabIndex="1"
									   dataProvider="{model.recommendationMethodTypeDTOList}" labelField="Name"
									   selectedItemChange="id_MethodCmbo_selectedItemChangeHandler(event)"
									   textCleared="id_MethodCmbo_textClearedHandler(event)"
									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
									   />
			<!--<s:ComboBox id="id_MethodCmbo" prompt="Select Method" toolTip="Method" width="100%" tabIndex="2"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						dataProvider="{model.recommendationMethodTypeDTOList}" labelField="Name"
						change="comboChangeHandler(event)"/>-->
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" >
			<s:Spacer width="11"/>
			<autoComplete:AutoComplete id="id_WebLinksCmbo" 
									   prompt="Enter Web Links" toolTip="Web Links" width="100%" tabIndex="3"
									   dataProvider="{model.recommendationLinkAutoCompleteDTOList}" labelField="label"
									   keyUp="webLinksKeyUpHandler(event)"
									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
									   />
			<!--<s:ComboBox id="id_WebLinksCmbo" prompt="Enter Web Links" toolTip="Web Links" width="100%" tabIndex="3"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						dataProvider="{model.recommendationLinkAutoCompleteDTOList}" labelField="label"
						keyUp="webLinksKeyUpHandler(event)"/>-->
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" gap="0">
		<s:HGroup width="50%" verticalAlign="middle" >
			<s:BitmapImage id="img_Duration" source="{QIConstants.IMG_RED}"/>
			<autoComplete:AutoComplete id="id_DurationCmbo" 
									   prompt="Select Duration" toolTip="Duration" width="100%" tabIndex="4"
									   dataProvider="{model.recommendationDurationTypeDTOList}" labelField="Name"
									   selectedItemChange="id_DurationCmbo_selectedItemChangeHandler(event)"
									   textCleared="id_DurationCmbo_textClearedHandler(event)"
									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
									   />
			
			<!--<s:ComboBox id="id_DurationCmbo" prompt="Select Duration" toolTip="Duration" width="100%" tabIndex="4"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
