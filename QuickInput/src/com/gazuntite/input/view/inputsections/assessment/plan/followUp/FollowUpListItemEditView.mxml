									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
									   keyUp="combo_keyUpHandler(event)"
									   textCleared="cmbo_textClearedHandler(event)"
									   />
		</s:HGroup>
		
	</s:HGroup>
	<s:HGroup width="100%" includeInLayout="{!id_PRN.selected}" visible="{!id_PRN.selected}">
		<s:HGroup width="33%" verticalAlign="middle" height="100%">
			<s:Spacer width="100%"/>
		</s:HGroup>		
		<s:HGroup   id="id_duration3"
					width="33%" verticalAlign="middle" height="100%" 
					includeInLayout="{(String(id_FollowUpFrequencyCmbo.selectedItem) == 'Duration')}" visible="{(String(id_FollowUpFrequencyCmbo.selectedItem) == 'Duration')}">
			<s:BitmapImage id="img_For" source="{id_ForDurationValue.text.length > 0? QIConstants.IMG_GREEN : QIConstants.IMG_RED}"/>
			<advancedTextInput:AdvancedTextInput id="id_ForDurationValue" width="100%" height="100%"
												 prompt="For" restrict="[0-9]"  maxChars="10" toolTip="For Duration" tabIndex="10"
												 skinClass="com.gazuntite.components.kapit.advancedTextInput.AdvancedTextInputWithClearButtonSkin"/>
		</s:HGroup>
		<s:HGroup   id="id_duration4"
					width="33%" verticalAlign="middle" height="100%" 
					includeInLayout="{(String(id_FollowUpFrequencyCmbo.selectedItem) == 'Duration')}" visible="{(String(id_FollowUpFrequencyCmbo.selectedItem) == 'Duration')}">
