						click="onDictationNoteButtonsClick()"
						selected="@{dictationNoteViewModel.inDictationMode}"
						toolTip="Record Level Dictation" tabIndex="12"
						skinClass="{ (followUpDTO.DictationID &amp;&amp; followUpDTO.DictationID != DictationConstants.GUID_FORMAT) ? DictationRedButtonSkin:DictationButtonSkin }"
						/>
		
		<s:ToggleButton id="id_btnNote"
						click="onDictationNoteButtonsClick()"
						selected="@{dictationNoteViewModel.inNoteMode}"
						toolTip="Record Level Notes" tabIndex="13"
						skinClass="{followUpDTO.Note.length ?NotesRedButtonSkin :WriteNoteButtonSkin}"
						/>
		<s:Button buttonMode="true"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  toolTip="Save"  click="saveClickHandler()"
				  right="0" verticalCenter="0"
				  tabIndex="14"
				  />
	</s:HGroup>
	<dictation2:PatientDictationNoteView width="100%" minHeight="47" viewModel="{dictationNoteViewModel}" noteTooltip="{followUpDTO.Note}" note="@{followUpDTO.Note}" ShowSaveButton="false"
										 DictationID="@{followUpDTO.DictationID}" IsDictaionEditMode="true"/>
	
	
</s:SkinnableContainer>
