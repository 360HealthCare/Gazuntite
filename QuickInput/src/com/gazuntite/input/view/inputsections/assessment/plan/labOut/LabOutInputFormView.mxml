				<components:LabelDateField id="id_ColDate" 
										   prompt="Collection Date" toolTip="Collection Date" width="100%"
										   yearNavigationEnabled="true" maxYear="{new Date().getFullYear()}" minYear="1901"
										   selectableRange="{{rangeStart : new Date()}}" 
										   IsEditAllow="false" editable="false"
										   styleName="coverDateField"
										   />
				
			</s:SkinnableContainer>
			
			<s:HGroup width="100%" height="100%" verticalAlign="bottom" horizontalAlign="right">
				<s:ToggleButton id="dictation" includeInLayout="false" visible="false"
								toolTip="Dictation" selected="@{dictationNoteViewModel.inDictationMode}"
								skinClass="com.gazuntite.skins.controls.button.input.DictationButtonSkin"
								/>
				<s:ToggleButton id="note"  includeInLayout="false" visible="false"
								toolTip="Note" selected="@{dictationNoteViewModel.inNoteMode}"
								skinClass="com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin"
								/>
				
				<s:Button id="save" 
						  toolTip="Save" skinClass="com.gazuntite.skins.controls.button.SavePlusButtonSkin"
						  click="saveClickHandler()"/>
				<s:Button id="next" click="next_clickHandler(event)"
						  buttonMode="true" useHandCursor="true"
						  toolTip="Next" skinClass="com.gazuntite.skins.controls.button.BlackButtonSkin" 
						  label="Next" />
			</s:HGroup>
		</s:HGroup>
	</s:HGroup>
	
	
	
	<dictation2:PatientDictationNoteView id="dictationNoteView" width="100%" viewModel="{dictationNoteViewModel}" isSaveButtonVisible="false"/>
	
</s:Group>