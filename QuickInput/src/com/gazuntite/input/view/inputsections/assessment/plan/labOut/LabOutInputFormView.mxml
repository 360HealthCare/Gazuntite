			protected function next_clickHandler(event:MouseEvent):void
			{
				
				if(IsViewDirty)
					//UtilityFunctions.AskMessageWithCustomButtonLabels(QIConstants.FormDitry_askMessage,QIConstants.FormDitry_yesMessage,QIConstants.FormDitry_NoMessage,saveClickHandler,null,SaveAndMoveNext,null);
					QIUtilityFunctions.AskMoveNextAlert( MoveNextHandler );
				else
					MoveToNextPanel();
			}
			
			private function MoveNextHandler(value:String):void
			{
				switch(value)
				{
					case CustomSaveAndMoveNextAlert.SAVE_AND_MOVE_NEXT :
						SaveAndMoveNext();
						break;
					case CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE :
						saveClickHandler();
						break;
					case CustomSaveAndMoveNextAlert.DISCARD_AND_MOVE_NEXT :
						DiscardAndMoveNext();
						break;
				}
			}
			
			private function DiscardAndMoveNext():void
			{
				clearForm();
				MoveToNextPanel();
			}
			
			private function SaveAndMoveNext():void
			{
				if (isInvalid())
					return;
				
				saveClickHandler();
				MoveToNextPanel();
			}
			
			private function MoveToNextPanel():void
			{
				dispatchEvent(new SelectSection(SelectSection.SelectInnerTabEvent,'Recommendation'));
			}
			
