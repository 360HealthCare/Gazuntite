				if(id_TestTypeCmbo.selectedIndex >= 0 || id_TestTypeCmbo.selectedItem != null)
					img_TestType.source	= QIConstants.IMG_GREEN;
			}
			protected function id_TestTypeCmbo_textClearedHandler(event:Event):void
			{
				if(id_TestTypeCmbo.text.length <= 2)
					img_TestType.source = QIConstants.IMG_RED;
			}
