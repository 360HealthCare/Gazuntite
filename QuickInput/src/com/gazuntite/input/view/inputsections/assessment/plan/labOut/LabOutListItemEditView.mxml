			protected function id_TestNameCmbo_selectedItemChangeHandler(event:AutoCompleteEvent):void
			{
				if(id_TestNameCmbo.selectedIndex >= 0 || id_TestNameCmbo.selectedItem != null)
				{
					img_TestName.source	= QIConstants.IMG_GREEN;
					if(id_TestNameCmbo.selectedIndex >= 0)
						id_TestCodeCmbo.selectedItem = model.lionicLabTestTypeDTOList.getItemAt(id_TestNameCmbo.selectedIndex);
				}
			}
			
			protected function id_TestNameCmbo_textClearedHandler(event:Event):void
			{
				if(id_TestNameCmbo.text.length <= 2)
					img_TestName.source = QIConstants.IMG_RED;
