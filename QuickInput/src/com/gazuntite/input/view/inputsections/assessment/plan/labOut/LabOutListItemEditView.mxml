			private function setRequiredIcon(cmbo:AutoComplete, icon:Class):void
			{
				switch (cmbo.id)
				{
					case "id_TestTypeCmbo":
						
						img_TestType.source = icon;
						break;
					
					case "id_OrderMethodCmbo":
						
						img_OrderMethod.source = icon;
						break;
					
					case "id_TestNameCmbo":
						
						img_TestName.source = icon;
						break;
					
					case "id_TestCodeCmbo":
						
						img_TestCode.source = icon;
						break;
					
					case "id_LaboratoryCmbo":
						
						img_Laboratory.source = icon;
						break;
					
					default:
						break;
				}
			}
			
			private function testTypeCmboChangeHandler(event:IndexChangeEvent):void
			{
				if (event.newIndex == event.oldIndex)
					return;
				
				id_TestCodeCmbo.selectedIndex = -1;
				id_TestCodeCmbo.text = "";
				
				setRequiredIcon(id_TestCodeCmbo, QIConstants.IMG_RED);
				
				id_TestNameCmbo.selectedIndex = -1;
				id_TestNameCmbo.text = "";
				
				setRequiredIcon(id_TestNameCmbo, QIConstants.IMG_RED);
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function comboKeyUpHandler(event:KeyboardEvent):void
			{
				if(UtilityFunctions.TrimString(id_TestNameCmbo.text).length == 0)
					img_TestName.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_TestCodeCmbo.text).length == 0)
					img_TestCode.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_TestTypeCmbo.text).length == 0)
					img_TestType.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_OrderMethodCmbo.text).length == 0)
					img_OrderMethod.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_LaboratoryCmbo.text).length == 0)
					img_Laboratory.source = QIConstants.IMG_RED;
				
				if (event.keyCode == Keyboard.ENTER || event.keyCode == Keyboard.UP || event.keyCode == Keyboard.DOWN)
					return;
				
				var curTar:AutoComplete = event.currentTarget as AutoComplete;
				
				if (!curTar)
					return;
				
				toolTipChanged = true;
				invalidateProperties();
				
				var testType:LabOutTestTypeDTO = id_TestTypeCmbo.selectedItem as LabOutTestTypeDTO;
				
				if (!testType)
					return;
				
				var ev:PatientInputAssessmentLabOutEvent = new PatientInputAssessmentLabOutEvent(
					PatientInputAssessmentLabOutEvent.PATIENT_INPUT_LAB_OUT_ITEM_EDIT_KEY_UP_EVENT, true);
				
				ev.searchString = curTar.text;
				ev.testTypeID = testType.ID;
				
				if (curTar == id_TestCodeCmbo)
				{
					ev.searchType = PatientInputAssessmentLabOutViewModel.LAB_TEST_CODE;
				}
				else if (curTar == id_TestNameCmbo)
				{
					ev.searchType = PatientInputAssessmentLabOutViewModel.LAB_TEST_NAME;
				}
				
				dispatchEvent(ev);
			}
			
			private function comboChangeHandler(event:IndexChangeEvent):void
			{
				var curTar:AutoComplete = event.currentTarget as AutoComplete;
				
				if (!curTar)
					return;
				
				if (curTar == id_TestTypeCmbo || curTar == id_OrderMethodCmbo || curTar == id_TestCodeCmbo ||
					curTar == id_TestNameCmbo || curTar == id_LaboratoryCmbo)
				{
					if (curTar.id == "id_TestCodeCmbo")
					{
						id_TestNameCmbo.selectedIndex = curTar.selectedIndex;
					}
					else
					{
						id_TestCodeCmbo.selectedIndex = curTar.selectedIndex;
					}
					
					if (curTar.selectedIndex >= 0)
					{
						if (curTar.id == "id_TestNameCmbo" || curTar.id == "id_TestCodeCmbo")
						{
							setRequiredIcon(id_TestNameCmbo, QIConstants.IMG_GREEN);
							setRequiredIcon(id_TestCodeCmbo, QIConstants.IMG_GREEN);
						}
						else
						{
							setRequiredIcon(curTar, QIConstants.IMG_GREEN);
						}
					}
					else
					{
						if (curTar.id == "id_TestNameCmbo" || curTar.id == "id_TestCodeCmbo")
						{
							id_TestNameCmbo.text = "";
							id_TestCodeCmbo.text = "";
							
							setRequiredIcon(id_TestNameCmbo, QIConstants.IMG_RED);
							setRequiredIcon(id_TestCodeCmbo, QIConstants.IMG_RED);
						}
						else
						{
							setRequiredIcon(curTar, QIConstants.IMG_RED);
						}
					}
				}
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function saveClickHandler():void
			{
				if (isInvalid())
					return;
				
				if (!labDTO)
					return;
				
				labDTO.IsDirty = true;
				
				labDTO.LabTestType = id_TestTypeCmbo.selectedItem as LabOutTestTypeDTO;
				labDTO.LabTestOrderMethodType = id_OrderMethodCmbo.selectedItem as GeneralTypeDTO;
				labDTO.LIONICLabTestType = id_TestNameCmbo.selectedItem as LabOutLIONICLabTestDTO;
				labDTO.Description = id_Description.text;
				
				labDTO.LabTestPriorityType = id_PriorityCmbo.selectedItem as GeneralTypeDTO;
				labDTO.LabTestSpecimenType = id_SpecimenCmbo.selectedItem as GeneralTypeDTO;
				labDTO.CollectionDate = id_ColDate.text;
				labDTO.LabType = id_LaboratoryCmbo.selectedItem as GeneralTypeDTO;
				
				labDTO.ModifiedAt = new Date();
				labDTO.ModifiedBy = model.LoggedInUserId;
				
				LabOutviewModel.managePatientLab(QIConstants.INPUT_VIEW);
				
				dispatchEvent( new Event( 'saveStatus', true ) );
				
			/* 	var ev:PatientInputAssessmentLabOutEvent = new PatientInputAssessmentLabOutEvent(
					PatientInputAssessmentLabOutEvent.PATIENT_INPUT_LAB_OUT_EDIT_EVENT, true);
				
				ev.labDTO = labDTO;
				
				dispatchEvent(ev); */
			}
			
			private function isInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:Object;
				
				if (isTestTypeInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Test Type\n";
					
					if (!toSetFocus)
						toSetFocus = id_TestTypeCmbo;
				}
				
				if (isOrderMethodInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Order Method\n";
					
					if (!toSetFocus)
						toSetFocus = id_OrderMethodCmbo;
				}
				
				if (isTestNameInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Test Name\n";
					
					if (!toSetFocus)
						toSetFocus = id_TestNameCmbo;	
				}
				
				if (isTestCodeInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Test Code\n";
					
					if (!toSetFocus)
						toSetFocus = id_TestCodeCmbo;
				}
				
				if (isPriorityInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Priority\n";
					
					if (!toSetFocus)
						toSetFocus = id_PriorityCmbo;
				}
				
				if (isSpecimenInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Specimen\n";
					
					if (!toSetFocus)
						toSetFocus = id_SpecimenCmbo;
				}
				
				if (isLaboratoryInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Laboratory\n";
					
					if (!toSetFocus)
						toSetFocus = id_LaboratoryCmbo;
				}
				
				if (errorStr.length > 0)
				{
					Alert.show(errorStr, "Required Field", Alert.OK, FlexGlobals.topLevelApplication.mainContainer, function():void
					{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
				}
				
				return isNotValid;
			}
			
			private function isTestTypeInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_TestTypeCmbo.selectedIndex < 0)
				{
					if (!id_TestTypeCmbo.selectedItem)
					{
						isNotValid = true;
					}
					else
					{
						var testType:LabOutTestTypeDTO = id_TestTypeCmbo.selectedItem as LabOutTestTypeDTO;
						
						if (!testType)
							isNotValid = true;
					}
				}
				
				return isNotValid;
			}
			
