										   prompt="Collection Date" toolTip="{id_ColDate.text}" width="100%"
										   yearNavigationEnabled="true" maxYear="{new Date().getFullYear()}" minYear="1901"
										   selectableRange="{{rangeStart : new Date()}}" 
										   IsEditAllow="false" editable="false"
										   text="{labDTO.CollectionDate}" 
										   styleName="coverDateField"
										   />
			</s:SkinnableContainer>
		</s:HGroup>
		
		<s:HGroup width="50%" verticalAlign="middle" >
			<s:BitmapImage id="img_Laboratory" source="{QIConstants.IMG_GREEN}"/>
			<autoComplete:AutoComplete id="id_LaboratoryCmbo" 
									   width="100%" prompt="Enter Laboratory" toolTip="Laboratory"
									   dataProvider="{model.labTypeDTOList}" labelField="Name"
									   selectedItemChange="id_LaboratoryCmbo_selectedItemChangeHandler(event)"
									   textCleared="id_LaboratoryCmbo_textClearedHandler(event)"
									   keyUp="comboKeyUpHandler(event)"
									   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" horizontalAlign="right">
		<s:ToggleButton id="id_btnDictation"
						click="onDictationNoteButtonsClick()"
						selected="@{viewModel.inDictationMode}"
						toolTip="Record Level Dictation"
						skinClass="{ (labDTO.DictationID &amp;&amp; labDTO.DictationID != DictationConstants.GUID_FORMAT) ? DictationRedButtonSkin:DictationButtonSkin }"
						/>
		
		<s:ToggleButton id="id_btnNote"
						click="onDictationNoteButtonsClick()"
						selected="@{viewModel.inNoteMode}"
						toolTip="Record Level Notes"
						skinClass="{labDTO.Note.length ? NotesRedButtonSkin : WriteNoteButtonSkin}"
						/>
		<s:Button buttonMode="true"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  toolTip="Save"  click="saveClickHandler()"
				  right="0" verticalCenter="0"
				  tabIndex="5"
				  />
	</s:HGroup>
	
	<dictation2:PatientDictationNoteView width="100%" minHeight="47" viewModel="{viewModel}" noteTooltip="{labDTO.Note}" note="@{labDTO.Note}"	ShowSaveButton="false"
										 DictationID="{labDTO.DictationID}" IsDictaionEditMode="{true}"/>
	
</s:SkinnableContainer>