			public function associatedDiagnosisLabel(oItem:Object):String
			{
				var label:String = "";
				
				if (oItem && oItem.hasOwnProperty("IcdDto") && oItem.IcdDto )
				{
					//[10/10/2013] Shahid Munir, #4333
					/* if (oItem.IcdDto.hasOwnProperty("IcdCodeName"))
					{
						label += oItem.IcdDto.IcdCodeName + ", ";
					} */
					
					if (oItem.IcdDto.hasOwnProperty("IcdCodeDescription"))
					{
						label += oItem.IcdDto.IcdCodeDescription;
					}
					
					label += oItem.IsChronic ? " (Chronic) " : " (Acute) ";
				}
				return label;
			}
			
			protected function id_TestTypeCmbo_selectedItemChangeHandler(event:AutoCompleteEvent):void
