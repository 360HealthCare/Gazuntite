				if(id_TestCodeCmbo.selectedIndex >= 0 || id_TestCodeCmbo.selectedItem != null)
				{
					img_TestCode.source	= QIConstants.IMG_GREEN;
					if(id_TestCodeCmbo.selectedIndex >= 0)
						id_TestNameCmbo.selectedItem = model.lionicLabTestTypeDTOList.getItemAt(id_TestCodeCmbo.selectedIndex);
				}
			}
			
			protected function id_TestCodeCmbo_textClearedHandler(event:Event):void
