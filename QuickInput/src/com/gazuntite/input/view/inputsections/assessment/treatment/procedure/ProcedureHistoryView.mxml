<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="cc(event)"
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			[Bindable]
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			private var viewModel:PatientInputAssessmentProcedureViewModel = PatientInputAssessmentProcedureViewModel.getInstance();
			
			protected function cc(event:FlexEvent):void
			{
				addEventListener(PatientInputAssessmentProcedureEvent.PATIENT_INPUT_PROCEDURE_ITEM_KEY_UP_EVENT, 
					patientInputProcedureItemKeyUpHandler, false, 0, true);
				
				addEventListener(PatientInputAssessmentProcedureEvent.PATIENT_INPUT_PROCEDURE_EDIT_EVENT,
					manageProcedureHandler, false, 0, true);
				
				addEventListener(PatientInputAssessmentProcedureEvent.PATIENT_INPUT_PROCEDURE_DELETE_EVENT,
					manageProcedureHandler, false, 0, true);
			}
			
			private function patientInputProcedureItemKeyUpHandler(event:PatientInputAssessmentProcedureEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 2 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadMedicalCPTCodeForHistoryView(event.searchString, event.searchType);
			}
			
			private function manageProcedureHandler(event:PatientInputAssessmentProcedureEvent):void
			{
				viewModel.managePatientProcedure(QIConstants.HISTORY_VIEW);
			}
			public function set DataList_changeHandler(value:ArrayCollection):void
			{
				SortDataList();
			}
			
			public function SortDataList():void
			{
				if(model.procedureDTOHistoryList && model.procedureDTOHistoryList.length)
				{
					switch (uiSortDropDown.selectedIndex)
					{
						case 0:
							model.procedureDTOHistoryList = UtilityFunctions.SortArrayCollection(model.procedureDTOHistoryList,'serialNumber',true,false);
							break;
						case 1: 
							model.procedureDTOHistoryList = UtilityFunctions.SortArrayCollection(model.procedureDTOHistoryList,'label',false,false);
							break;
					}
				}
					
				else
				{
					if(uiSortDropDown)
						uiSortDropDown.selectedIndex = 0;
				}
				
			}
			
			
		]]>
	</fx:Script>
	<fx:Binding source="model.procedureDTOList" destination="DataList_changeHandler" />
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="3" paddingTop="5" paddingLeft="5"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
		</s:layout>
		
		<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
		
		<s:DropDownList id="uiSortDropDown"
			skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
						selectedIndex="0"
						buttonMode="true" toolTip="Sort List"
						change="SortDataList()">
			<s:dataProvider>
				<s:ArrayCollection>
					<fx:Object label="Recently Added" />
					<fx:Object label="Procedure" />
				</s:ArrayCollection>
			</s:dataProvider>
		</s:DropDownList>
		<s:Spacer width="100%"/>
	</s:SkinnableContainer>
	
	<s:List id="uiprocedureList" 
			width="100%" height="100%" 
			minHeight="50" allowMultipleSelection="false" borderVisible="false"
			skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
			dataProvider="{model.procedureDTOHistoryList}"
			itemRenderer="com.gazuntite.input.view.inputsections.assessment.itemRenderer.ProcedureListIR"
			/>
</s:Group>