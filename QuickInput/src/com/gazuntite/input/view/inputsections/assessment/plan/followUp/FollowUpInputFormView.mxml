			}
			
			protected function cmbo_textClearedHandler(event:Event):void
			{
				if(UtilityFunctions.TrimString(id_followUpTypeCmbo.text).length == 0)
				{
					img_FollowUpType.source = QIConstants.IMG_RED;
					id_followUpListCmbo.dataProvider = null;
					id_followUpListCmbo.visible = false;
					id_followUpListCmbo.includeInLayout = false;
					id_drugLabGroup.visible = false;
					id_drugLabGroup.includeInLayout = false;
				}
				
				if(UtilityFunctions.TrimString(id_Service.text).length == 0)
					img_Service.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_FollowUpNatureCmbo.text).length == 0)
				{
					id_Service.visible = false;
					id_Service.includeInLayout = false;
					img_Service.visible = false;
					img_Service.includeInLayout = false;
				}
				
				if(UtilityFunctions.TrimString(id_FollowUpFrequencyCmbo.text).length == 0)
				{
					img_FollowUpFrequency.source = QIConstants.IMG_RED; 
					id_FollowUpFrequencyCmbo.selectedItem =null;
					id_FollowUpFrequencyCmbo.text = '';
					id_age1.visible = false;
					id_age1.includeInLayout = false;
					id_age2.visible = false;
					id_age2.includeInLayout = false;
					
					id_duration1.visible = false;
					id_duration1.includeInLayout = false;
					id_duration2.visible = false;
					id_duration2.includeInLayout = false;
					id_duration3.visible = false;
					id_duration3.includeInLayout = false;
					id_duration4.visible = false;
					id_duration4.includeInLayout = false; 
					
				}
				
				if(UtilityFunctions.TrimString(id_followUpListCmbo.text).length == 0)
					img_FollowUpList.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_AgeType.text).length == 0)
					img_AgeType.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_AgeType.text).length == 0)
					img_AgeType.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_AgeValue.text).length == 0)
					img_AgeValue.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_AfterDurationType.text).length == 0)
					img_AfterValue.source = QIConstants.IMG_RED;
				
				if(UtilityFunctions.TrimString(id_ForDurationType.text).length == 0)
					img_ForValue.source = QIConstants.IMG_RED;
			}
			
			protected function next_clickHandler(event:MouseEvent):void
			{
				if(IsViewDirty)
				{
					//QIUtilityFunctions.AskMoveNextAlert( MoveNextHandler );
					var hideOption:String = CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE ;
					QIUtilityFunctions.AskMoveNextAlert( MoveNextHandler, null, hideOption );
				}
				else
					MoveToNextPanel();
			}
			
			private function MoveNextHandler(value:String):void
			{
				switch(value)
				{
					case CustomSaveAndMoveNextAlert.SAVE_AND_MOVE_NEXT :
						SaveAndMoveNext();
						break;
					case CustomSaveAndMoveNextAlert.SAVE_AND_ADD_MORE :
						saveClickHandler();
						break;
					case CustomSaveAndMoveNextAlert.DISCARD_AND_MOVE_NEXT :
						DiscardAndMoveNext();
						break;
				}
			}
			
			private function DiscardAndMoveNext():void
			{
				clearForm();
				MoveToNextPanel();
			}
			
			private function SaveAndMoveNext():void
			{
				if (isInvalid())
					return;
				
				saveClickHandler();
				MoveToNextPanel();
			}
			
			private function MoveToNextPanel():void
			{
				dispatchEvent(new SelectSection(SelectSection.SelectInnerTabEvent,'AdvanceCare'));
			}
			
			protected function id_drugLab_changeHandler(event:Event):void
			{
				id_followUpListCmbo.text = '';
				id_followUpListCmbo.selectedItem = null;
				if(id_drugLab.selected)	
				{
					id_followUpListCmbo.dataProvider = model.followUpPatientMedicationlist;
					id_followUpListCmbo.prompt = 'Select Drug';
					id_followUpListCmbo.toolTip = 'Drugs';
				}
				else 	
				{
					id_followUpListCmbo.dataProvider = model.followUpLabsList;
					id_followUpListCmbo.prompt = 'Select Lab';
					id_followUpListCmbo.toolTip = 'Lab Test';
				}
			}
			
			protected function group2_creationCompleteHandler(event:FlexEvent):void
			{
				clearForm();
			}
			
		]]>
	</fx:Script>
