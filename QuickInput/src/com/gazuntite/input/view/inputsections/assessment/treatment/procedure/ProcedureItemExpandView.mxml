<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin" xmlns:dictation="com.gazuntite.components.dictation.*"
					  creationComplete="cc(event)" xmlns:dictation1="com.gazuntite.common.view.components.dictation.*" xmlns:dictation2="com.gazuntite.dictation.view.dictation.*"
					  >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.assessment.procedure.ProcedureDTO;
			import com.gazuntite.input.model.QIModelLocator;
			import com.gazuntite.input.utils.QIConstants;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			public var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]	
			public var labelWidth:Number = 100;
			
			private var _procedureDTO:ProcedureDTO;
			private var toolTipChanged:Boolean;
			
			[Bindable]
			public function get procedureDTO():ProcedureDTO
			{
				return _procedureDTO;
			}
			
			public function set procedureDTO(value:ProcedureDTO):void
			{
				_procedureDTO = value;
			}
			private var _isExpand:Boolean = false;
			
			[Bindable]	public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			[Bindable]
			public function get isExpand():Boolean
			{
				return _isExpand;
			}
			
			public function set isExpand(value:Boolean):void
			{
				_isExpand = value;
				if(!isExpand)
					viewModel.visible = false;
			}
			
			protected function cc(event:FlexEvent):void
			{
				viewModel.inlineEditing = true;
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout gap="5" paddingLeft="8" paddingRight="5" paddingTop="8" paddingBottom="5"/>
	</s:layout>
	
	<s:HGroup width="100%"  height="21" verticalAlign="middle">
		<s:BitmapImage id="img_CptCode" source="{QIConstants.IMG_GREEN}"/>
		<s:Label text="CPT Code:" width="{labelWidth}" styleName="patientFormLabel" />
		<s:Label text="{procedureDTO.cptmedicalDTO.ProcedureCode}"	 toolTip="{procedureDTO.cptmedicalDTO.ProcedureCode}" 
				 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
	</s:HGroup>
	
	<s:HGroup width="100%" height="21" verticalAlign="middle">
		<s:BitmapImage id="img_Procedure" source="{QIConstants.IMG_GREEN}"/>
		<s:Label text="Procedure:" width="{labelWidth}" styleName="patientFormLabel"/>
		<s:Label text="{procedureDTO.cptmedicalDTO.ProcedureDescription}"	 toolTip="{procedureDTO.cptmedicalDTO.ProcedureDescription}" 
				 width="100%" showTruncationTip="true" maxDisplayedLines="1" styleName="patientFormValue"/>
	</s:HGroup>
	<s:HGroup width="100%" paddingRight="0" paddingLeft="15">
		<s:Label text="Notes:"	 styleName="patientFormLabel" />
		<s:Label text="{procedureDTO.Note}" toolTip="{procedureDTO.Note}" styleName="patientFormValue" maxDisplayedLines="1" showTruncationTip="true" width="100%"/>
		<s:ToggleButton id="id_btnDictation"
						selected="@{viewModel.inDictationMode}"
						toolTip="Record Level Dictation"
						click="{!id_btnDictation.selected ? viewModel.visible = false : true}"
						skinClass="com.gazuntite.skins.controls.button.input.DictationButtonSkin"
						/>
	</s:HGroup>
	
	<dictation2:PatientDictationNoteView width="100%" minHeight="47" viewModel="{viewModel}" noteTooltip="{procedureDTO.Note}" note="@{procedureDTO.Note}"	isSaveButtonVisible="false"/>
	
</s:SkinnableContainer>