<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="init()"
		 >
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.event.FlipViewEvent;
			
			import mx.binding.utils.BindingUtils;
			import mx.core.IVisualElement;
			import mx.core.UIComponent;
			import mx.events.EffectEvent;
			
			[Bindable]
			public var flipDuration:Number = 500;
			
			[Bindable]
			protected var flipInView:UIComponent;
			
			[Bindable]
			protected var flipOutView:UIComponent;
			private var _flipViews:Array;
			
			public function get flipViews():Array
			{
				return _flipViews;
			}
			
			public function set flipViews(value:Array):void
			{
				_flipViews = value;
				newViewSet = true;
				invalidateProperties();
			}
			
			
			[Bindable]
			public var menuLabel:String = "Flip View";
			
			private var _selected:Boolean = true;
			
			protected var containerCreated:Boolean = false;
			protected var newViewSet:Boolean = false;
			
			protected var frontView:UIComponent;
			[Bindable]
			protected var backView:UIComponent;
			protected var backViewInitComplete:Boolean = true;
			protected var showingFrontView:Boolean = true;
			
			[Bindable]
			protected var showLoader:Boolean = true;
			
			protected function init():void
			{
				containerCreated = true;
				this.addEventListener(FlipViewEvent.FLIP_VIEW_EVENT, onFlipRequested);
				invalidateProperties();
			}
			override protected function commitProperties():void
			{
				super.commitProperties();
				if (newViewSet && containerCreated && selected)
				{
					newViewSet = false;
					if (flipViews!=null)
					{
						uiViewContainer.removeAllElements();
						frontView = flipViews[0] as UIComponent;
						backView = flipViews[1] as UIComponent
						uiViewContainer.addElementAt(backView, 0);
						uiViewContainer.addElementAt(frontView, 1);
						initView(backView);
						initView(frontView);
						//						backView.rotationY = 180;
						backView.alpha=0;
						//						BindingUtils.bindProperty(backView,'x', this, 'width', false, true);
						backViewInitComplete = false;
						uiViewContainer.invalidateDisplayList();
						this.invalidateDisplayList();
						showLoader = false;
					}
				}
			}
			//			override protected function updateDisplayList(unscaledWidth:Number, unscaledHeight:Number):void
			//			{
			//				super.updateDisplayList(unscaledWidth, unscaledHeight);
			//				//				if (!backViewInitComplete)
			//				//				{
			//				//					uiInitFlip.play();
			//				//					backViewInitComplete = true;
			//				//				}
			//			}
			protected function initView(view:UIComponent):void
			{
				view.percentWidth = 100;
				view.percentHeight = 100;
			}
			public function doFlip(isAlreadyFlipped:Boolean):void
			{
				//TA ---- on Patient Load
				if(isAlreadyFlipped && showingFrontView)
					showingFrontView = isAlreadyFlipped;
				else
					showingFrontView = !showingFrontView;
				
				flipInView = showingFrontView?frontView:backView;
				flipOutView = showingFrontView?backView:frontView;
				
				uiFlipOut.play();
				uiFlipIn.play();
				uiFadeIn.play();
				uiFadeOut.play();
			}
			
			protected function onFlipRequested(event:FlipViewEvent):void
			{
				doFlip(event.isAlreadyFlipped);
			}
			
			protected function onFlipEnd(event:EffectEvent):void
			{
				flipInView.visible = true;
				flipOutView.visible = false;
				
			}

			[Bindable]
			public function get selected():Boolean
			{
				return _selected;
			}

			public function set selected(value:Boolean):void
			{
				_selected = value;
				if (_selected)
				{
					this.invalidateProperties();
				}
			}

			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:Rotate3D id="uiFlipIn" target="{flipInView}" autoCenterTransform="true" focalLength="1000" duration="{flipDuration}" angleYFrom="180" angleYTo="360" effectEnd="onFlipEnd(event)"/>
		<s:Rotate3D id="uiFlipOut" target="{flipOutView}" autoCenterTransform="true" focalLength="1000" duration="{flipDuration}" angleYFrom="0" angleYTo="180" effectEnd="onFlipEnd(event)"/>
		<s:Fade id="uiFadeOut" target="{flipOutView}" duration="0" alphaTo="0" startDelay="{flipDuration/2}"/>
		<s:Fade id="uiFadeIn" target="{flipInView}" duration="0" alphaTo="1" startDelay="{flipDuration/2}"/>
		<s:Rotate3D id="uiInitFlip" target="{backView}" autoCenterTransform="true" focalLength="1000" duration="0" angleYTo="180"/>
	</fx:Declarations>
	
	<s:SkinnableContainer 
		width="100%" height="100%"
		skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
		visible="{showLoader}"
		>
		<s:Label text="Loading {menuLabel}..." horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF"
				 fontSize="16" fontWeight="bold"/>
	</s:SkinnableContainer>
	<s:Group id="uiViewContainer" width="100%" height="100%"/>
	
</s:Group>