<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" width="119">
	<fx:Script>
		<![CDATA[
			//for back of old design
			[Bindable]
			public var label:String;
			
			[Bindable]
			public var tabState:int = 0;
			
			[Bindable]
			public var tabSelected:Boolean = false;
			
			public function onTabSelectionChange(event:Event):void
			{
				tabState = 0;
				if(id_yes.selected)
				{
					tabState = 1;
					id_no.selected = false;
					id_uk.selected = false;
				}
				else if(id_uk.selected)
				{
					tabState = 3;
					id_yes.selected = false;
					id_no.selected = false;
				}
				else if(id_no.selected)
				{
					tabState = 2;
					id_yes.selected = false;
					id_uk.selected = false;
				}
				
				if (!uiToggleButton.selected)
				{
					uiToggleButton.selected = true;
				}
			}
			
			protected function button_changeHandler(event:Event):void
			{
				tabState = 0;
				switch((event.target as ToggleButton).id)
				{
					case 'id_yes':
					{
						if(id_yes.selected)
						{
							tabState = 1;
							id_no.selected = false;
							id_uk.selected = false;
						}
						break;
					}
					case 'id_uk':
					{
						if(id_uk.selected)
						{
							tabState = 3;
							id_yes.selected = false;
							id_no.selected = false;
						}
						break;
					}
					case 'id_no':
					{
						if(id_no.selected)
						{
							tabState = 2;
							id_yes.selected = false;
							id_uk.selected = false;
						}
						break;
					}
				}
				
				if (!uiToggleButton.selected)
				{				
					uiToggleButton.selected = true;					
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:ToggleButton id="uiToggleButton" 
					label="{uiToggleButton.selected?label.toUpperCase():label}" 
					selected="{tabSelected}" change="onTabSelectionChange(event)"
					left="0" right="0" top="0" bottom="0" 
					skinClass="com.gazuntite.input.view.skins.SideTabButtonSkin"
					/>
	<s:SkinnableContainer height="22" right="7" verticalCenter="0" skinClass="com.gazuntite.input.view.skins.SquareRadioButtonContainerSkin"	  >
		<s:layout>
			<s:HorizontalLayout		paddingLeft="1" paddingRight="1" paddingTop="1" paddingBottom="1"	gap="2"	/>
		</s:layout>
		<s:ToggleButton id="id_yes" 
						right="6" verticalCenter="0" 
						skinClass="com.gazuntite.input.view.skins.SquareRadioButtonSkin"
						label="Y" change="button_changeHandler(event)"
						/>
		<s:ToggleButton id="id_uk" 
						right="6" verticalCenter="0" 
						skinClass="com.gazuntite.input.view.skins.SquareRadioButtonSkin"
						label="U" change="button_changeHandler(event)" 
						/>
		<s:ToggleButton id="id_no" 
						right="6" verticalCenter="0" 
						skinClass="com.gazuntite.input.view.skins.SquareRadioButtonSkin"
						label="N" change="button_changeHandler(event)"
						/>
	</s:SkinnableContainer>
</s:Group>