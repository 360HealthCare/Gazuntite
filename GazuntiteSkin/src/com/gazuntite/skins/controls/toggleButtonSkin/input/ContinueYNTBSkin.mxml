<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		width="46" height="24">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" width="45" height="23" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90"
							  rotation.disabledAndSelected="270">
				<s:GradientEntry alpha="1.0" color="#295AB2" ratio="0"
								 color.disabled="#999999"
								 color.disabledAndSelected="#666666"/>
				<s:GradientEntry alpha="1.0" color="#76ADFC" ratio="1"
								 color.disabled="#666666"
								 color.disabledAndSelected="#999999"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="270"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#4887E0" ratio="0"
								 color.disabled="#999999"
								 color.disabledAndSelected="#999999"/>
				<s:GradientEntry alpha="1.0" color="#1C4799" ratio="1"
								 color.disabled="#666666"
								 color.disabledAndSelected="#666666"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:RichText d:userLabel="Text" x="8" color="#FFFFFF" fontFamily="Calibri" fontSize="15"
				fontWeight="bold" lineHeight="0" paddingBottom="0" paddingLeft="0" paddingRight="0"
				paddingTop="0" tabStops="S0" text="Y" trackingRight="1%"
				visible.disabled="false" y.disabled="4"
				y.disabledAndSelected="5"
				visible.down="false" y.down="4"
				y.downAndSelected="5"
				visible.over="false" y.over="4"
				y.overAndSelected="5"
				visible.up="false" y.up="4"
				y.upAndSelected="5">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<s:RichText x="29" y="5" color="#FFFFFF" fontFamily="Calibri" fontSize="15" fontWeight="bold"
				lineHeight="0" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
				tabStops="S0" text="N" trackingRight="1%"
				visible.disabledAndSelected="false"
				visible.downAndSelected="false"
				visible.overAndSelected="false"
				visible.upAndSelected="false">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<s:Rect x="1" y="1" width="22" height="22" radiusX="3"
			x.disabledAndSelected="23"
			x.downAndSelected="23"
			x.overAndSelected="23"
			x.upAndSelected="23">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#D6D6D6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FCFCFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#FFFFFF"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText d:userLabel="Text" includeIn="disabled,down,over,up,upAndSelected" x="9"
				color="#999999" fontFamily="Calibri" fontSize="14" lineHeight="0" paddingBottom="0"
				paddingLeft="0" paddingRight="0" paddingTop="0" tabStops="S0" text="Y"
				trackingRight="1%"
				y.disabled="6"
				y.down="6"
				y.over="6"
				y.up="6"
				visible.upAndSelected="false" y.upAndSelected="5"/>
	<s:RichText includeIn="disabledAndSelected,downAndSelected,overAndSelected,up,upAndSelected"
				x="30" y="6" color="#999999" fontFamily="Calibri" fontSize="14" lineHeight="0"
				paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" tabStops="S0"
				text="N" trackingRight="1%"
				visible.up="false"/>
</s:Skin>
