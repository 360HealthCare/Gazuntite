<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="20" height="20"
		creationComplete="skin1_creationCompleteHandler(event)"
		>
	
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected function skin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent)
				{
					hostComponent.useHandCursor 		= true;
					hostComponent.buttonMode		    = true;
				}
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	
	<s:Rect includeIn="up" width="19" height="19" horizontalCenter="0" radiusX="2"	verticalCenter="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#7A7A7A" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#444545" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#2D2E2E" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#3F4040" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<!--<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>-->
	</s:Rect>
	
	<s:Rect includeIn="down,over,up,upAndSelected, overAndSelected, downAndSelected" x="0" width="20" height="20" radiusX="2"
			y.down="0" width.down="20" height.down="20"
			y.over="0" width.over="20" height.over="20"
			visible.up="false" y.up="1.5">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="0x164AA5" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="0x66A1F7" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" includeIn="down,up" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<!--<s:stroke>
			<s:SolidColorStroke alpha="0.41000000000000003" caps="none" color="#CCCCCC" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>-->
	</s:Rect>
	
	<s:Rect includeIn="disabled,disabledAndSelected" x="0" y="0" width="20" height="20" radiusX="2"
			width.disabled="20" height.disabled="20"
			width.disabledAndSelected="20" height.disabledAndSelected="20">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<!--<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>-->
	</s:Rect>
	
	<s:BitmapImage x="5" y="5" smooth="true" source="@Embed('/assets/images/grid_edit.png')">
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="10" blurY="10" color="#FFFFFF" inner="true" knockout="false" quality="3" strength="6"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>