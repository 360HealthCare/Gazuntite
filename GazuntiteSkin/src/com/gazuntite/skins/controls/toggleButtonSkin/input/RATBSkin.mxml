<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="35" height="35">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0" y="0" width="35" height="35" radiusX="5"
			visible.down="false"
			visible.downAndSelected="false"
			visible.over="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="disabledAndSelected,down,downAndSelected,over,overAndSelected,up,upAndSelected"
			x="0" y="0" width="35" height="35" radiusX="5"
			visible.disabledAndSelected="false"
			visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="0x1347A3" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="0x5B95EC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage x="0" y="0" width="35" smooth="true"
				   source="@Embed('/assets/images/smallbutton_transparentbg.png')"
				   visible.down="false"
				   visible.downAndSelected="false">
		<s:filters>
			<s:DropShadowFilter includeIn="overAndSelected" alpha="1" angle="90" blurX="4.0"
								blurY="4.0" color="#000000" distance="2" hideObject="false"
								inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:BitmapImage includeIn="down,downAndSelected,over,up" x="0" y="0" width="35" smooth="true"
				   source="@Embed('/assets/images/smallbutton_transparentbg.png')"
				   visible.over="false"
				   visible.up="false">
		<s:filters>
			<s:DropShadowFilter includeIn="downAndSelected,over,up" alpha="1" angle="90" blurX="2"
								blurY="2" color="#333333" distance="2" hideObject="false"
								inner="true" knockout="false" quality="3" strength="1"
								blurX.downAndSelected="4" blurY.downAndSelected="4"/>
			<s:DropShadowFilter includeIn="down" alpha="1" angle="90" blurX="4.0" blurY="4.0"
								color="#000000" distance="2" hideObject="false" inner="true"
								knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:Path x="11" y="8" width="12.35" height="21.041"
			data="M 3.797 0.061 L 0 7.442 L 3.74 7.442 L 1.41 11.794 L 4.229 11.794 L 1.755 16.041 L 9.292 9.724 L 6.013 9.724 L 9.35 5.422 L 6.127 5.422 L 9.263 0 L 3.797 0.061 Z">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#1B6582" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Path>
</s:Skin>
