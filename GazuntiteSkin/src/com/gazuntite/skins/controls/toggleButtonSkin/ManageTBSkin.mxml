<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="90" height="34">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0" y="0" width="90" height="25" radiusX="3"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90"
							  rotation.down="270"
							  rotation.over="270">
				<s:GradientEntry alpha="1.0" color="#DDDDDD" ratio="0"
								 color.disabled="#999999"
								 color.disabledAndSelected="#999999"/>
				<s:GradientEntry includeIn="down,downAndSelected,over,overAndSelected,up,upAndSelected"
								 alpha="1.0" color="#BDBDBD" ratio="0.4980392156862745"/>
				<s:GradientEntry includeIn="down,downAndSelected,over,overAndSelected,up,upAndSelected"
								 alpha="1.0" color="#E8E8E8" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#E8E8E8" ratio="1"
								 color.disabled="#7A7A7A"
								 color.disabledAndSelected="#7A7A7A"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="down" alpha="0.75" angle="90" blurX="2" blurY="2"
								color="#000000" distance="1" hideObject="false" inner="true"
								knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="downAndSelected,overAndSelected,upAndSelected" x="0" y="0" width="90" height="34" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#DDDDDD" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#BDBDBD" ratio="0.37254901960784315"/>
				<s:GradientEntry alpha="1.0" color="#E8E8E8" ratio="0.3764705882352941"/>
				<s:GradientEntry alpha="1.0" color="#E8E8E8" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
		</s:filters>
	</s:Rect>
	<s:Ellipse x="5.5" y="2.5" width="19" height="19">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#FFFFFF" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#689BE4" ratio="0"
								 color.disabled="#999999"
								 color.disabledAndSelected="#999999"/>
				<s:GradientEntry alpha="1.0" color="#2F76DA" ratio="1"
								 color.disabled="#666666"
								 color.disabledAndSelected="#666666"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="3" blurY="3" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Ellipse>
	<s:RichText x="9" y="1" width="12" height="19" color="#FFFFFF" fontFamily="CalibriCFF"
				fontSize="22" fontWeight="bold" kerning="auto" lineHeight="0%" paddingBottom="0"
				paddingLeft="0" paddingRight="0" paddingTop="0" tabStops="S0" text="+"
				textAlign="center" trackingRight="0%" whiteSpaceCollapse="preserve">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<s:RichText x="31" y="6" color="#000000" fontFamily="CalibriCFF" fontSize="14" lineHeight="0"
				paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" tabStops="S0"
				text="Manage" 
				typographicCase.upAndSelected="uppercase"
				typographicCase.disabledAndSelected="uppercase"
				typographicCase.downAndSelected="uppercase"
				typographicCase.overAndSelected="uppercase"
				trackingRight="0%"
				color.disabled="#CCCCCC"
				color.disabledAndSelected="#CCCCCC"/>
</s:Skin>