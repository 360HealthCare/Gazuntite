<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="30" height="30">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0" y="0" width="30" height="24" radiusX="3"
			visible.disabled="false"
			visible.disabledAndSelected="false"
			visible.down="false"
			height.downAndSelected="30"
			visible.over="false"
			height.overAndSelected="30"
			visible.up="false"
			height.upAndSelected="30">
		<s:fill>
			<s:SolidColor color="#FFFFFF"
						  color.downAndSelected="#2C2C2C"
						  color.overAndSelected="#2C2C2C"
						  color.upAndSelected="#2C2C2C"/>
		</s:fill>
	</s:Rect>
	<s:BitmapImage x="4" y="5" smooth="true" source="@Embed('/assets/images/Google_Icon.png')"/>
	<s:Path x="27" y="16" width="8" height="5" data="M 11.10 9.60 L 0.00 9.60 5.55 -0.00 Z "
			rotation="180">
		<s:fill>
			<s:SolidColor color="#333333"
						  color.disabled="#CCCCCC"
						  color.disabledAndSelected="#CCCCCC"
						  color.downAndSelected="#FFFFFF"
						  color.overAndSelected="#FFFFFF"
						  color.upAndSelected="#FFFFFF"/>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="270" blurX="0" blurY="0" color="#000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Path>
</s:Skin>