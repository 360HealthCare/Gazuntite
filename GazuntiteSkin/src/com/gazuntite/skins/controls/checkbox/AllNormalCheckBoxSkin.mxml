<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="58" height="25">
	<fx:Metadata>[HostComponent("spark.components.CheckBox")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" width="57" height="24" radiusX="3"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90"
							  rotation.down="270">
				<s:GradientEntry alpha="1.0" color="#A1A0A1" ratio="0"/>
				<s:GradientEntry includeIn="down,downAndSelected,over,overAndSelected,up,upAndSelected"
								 alpha="1.0" color="#B2B3B3" ratio="0.1568627450980392"/>
				<s:GradientEntry alpha="1.0" color="#E5E6E6" ratio="1"
								 color.disabled="#999999"
								 color.disabledAndSelected="#999999"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#999999" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect x="30" y="1" width="27" height="23" radiusX="3"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#D6D6D6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FCFCFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#FFFFFF"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText x="10" y="7" color="#666666" fontFamily="CalibriCFF" fontSize="15" tabStops="S0" text="N"
				visible.downAndSelected="false"
				visible.overAndSelected="false"
				visible.upAndSelected="false"/>
	<s:Rect includeIn="downAndSelected,overAndSelected,upAndSelected" x="0.5" y="0.5" width="57" height="24" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#295AB2" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#76ADFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="270"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#4887E0" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#1C4799" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect includeIn="downAndSelected,overAndSelected,upAndSelected" x="1" y="1" width="27" height="23" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#D6D6D6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FCFCFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#FFFFFF"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText includeIn="downAndSelected,overAndSelected,upAndSelected" x="37" y="7" color="#FFFFFF" fontFamily="CalibriCFF"
				fontSize="15" fontWeight="bold" tabStops="S0" text="N"/>
</s:Skin>
