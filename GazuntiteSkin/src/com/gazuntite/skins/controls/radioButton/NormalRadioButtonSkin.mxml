<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		width="54" height="23"
		creationComplete="skin1_creationCompleteHandler(event)">
	<fx:Metadata>[HostComponent("spark.components.RadioButton")]</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected function skin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent.label)
				{
					hostComponent.toolTip = hostComponent.toolTip;
					hostComponent.useHandCursor = true;
					hostComponent.buttonMode = true;
				}
			}
			
		]]>
	</fx:Script>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	
	<s:Rect x="0" y="0" width="100%" height="100%" radiusX="2"
			visible.disabledAndSelected="false"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1" color="0xF8F8F8" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#DBD9D9" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:RichText color="#999999" fontFamily="CalibriCFF" fontSize="14"
				tabStops="S0" text="Normal"
				visible.disabledAndSelected="false" 
				visible.downAndSelected="false"
				visible.overAndSelected="false"
				horizontalCenter="0" verticalCenter="0"
				visible.upAndSelected="false"/>
	<s:RichText horizontalCenter="0" verticalCenter="0"
				color="#FFFFFF" fontFamily="CalibriCFF" fontSize="14" 
				tabStops="S0" text="Normal"
				visible.disabled="false"
				visible.down="false"
				visible.over="false"
				visible.up="false"/>
</s:Skin>