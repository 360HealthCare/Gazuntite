<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt" xmlns:ai="http://ns.adobe.com/ai/2009" xmlns:flm="http://ns.adobe.com/flame/2008">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="19" radiusX="3" visible.down="false" width="100%" x="0" y="0" visible.disabled="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#6E86A2" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#8093B1" ratio="0.5411764705882353"/>
				<s:GradientEntry alpha="1.0" color="#8B9DB5" ratio="0.5450980392156862"/>
				<s:GradientEntry alpha="1.0" color="#B5BECD" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.8" angle="90" blurX="2" blurX.up="1" blurY="2" blurY.up="1" color="#000000" color.up="#333333" distance="1" hideObject="false" inner="false" knockout="false" quality="3" quality.up="2" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Rect height="19" radiusX="3" width="100%" x="1" y="0" visible.up="false" visible.down="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#E2E3E3" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#C6C7C7" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="19" radiusX="3" width="100%" x="0" y="0" visible.up="false" visible.disabled="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F2BF65" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA64D" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="disabled,down" blurX="2" blurY="2" distance="1" hideObject="false" color="#000000" inner="true" strength="1" alpha="1" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:RichText textAlign="center" width="100%" paddingLeft="2" paddingRight="2"  verticalCenter="0" horizontalCenter="0" color.up="#ffffff" color.disabled="#919191" color.down="#000000" color.over="#000000" text="{hostComponent.label}" columnCount="1" whiteSpaceCollapse="preserve" tabStops="S0" y="6" fontFamily="Calibri" fontSize="14" kerning="on">
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
		<s:filters.up>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters.up>
	</s:RichText>
</s:Skin>