<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="100%" height="29">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	
	<s:Rect height="100%" radiusX="4" width="100%" x="0.5" y="0.5" includeIn="up">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#676767" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#353535" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	
	<s:Rect height="100%" radiusX="4" width="100%" x="0.5" y="0.5" includeIn="disabled">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#787878" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#787878" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#5A5A5A" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#5A5A5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x787878" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#5A5A5A" ratio="0"/>
				<s:GradientEntry alpha="1" color="#787878" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	
	<s:Rect height="100%" includeIn="down,over" radiusX="4" width="100%" x="0.5" y="0.5" alpha.down="0.85">
		<s:fill>
			<s:LinearGradient rotation="90"
							  rotation.down="270">
				<s:GradientEntry alpha="1.0" color="0x164AA5" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="0x66A1F7" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:RichText id="labelDisplay" 
				color="#FFFFFF" fontFamily="CalibriCFF" 
				fontSize="17" lineHeight="0" 
				paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" 
				tabStops="S0 S50 S100" 
				trackingRight="0%" 
				horizontalCenter="0" verticalCenter="0"
				color.disabled="#E1E1E1"
				/>
</s:Skin>