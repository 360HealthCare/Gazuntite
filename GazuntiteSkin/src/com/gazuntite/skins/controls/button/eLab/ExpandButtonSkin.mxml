			<s:DropShadowFilter includeIn="disabledAndSelected,down,downAndSelected,over,overAndSelected,upAndSelected"
								alpha="0.5" angle="270" blurX="4.0" blurY="4.0" color="#000000"
								distance="2" hideObject="false" inner="false" knockout="false"
