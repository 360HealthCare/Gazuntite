<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
				   xmlns:s="library://ns.adobe.com/flex/spark" 
				   xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
				   minWidth="21" minHeight="21" 
				   alpha.disabledStates="0.5">
	
	<!-- host component -->
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.ToggleButton")]
		]]>
	</fx:Metadata>
	
	<!-- states -->
	<s:states>
		<s:State name="up" />
		<s:State name="over" stateGroups="overStates" />
		<s:State name="down" stateGroups="downStates" />
		<s:State name="disabled" stateGroups="disabledStates" />
		<s:State name="upAndSelected" stateGroups="selectedStates, selectedUpStates" />
		<s:State name="overAndSelected" stateGroups="overStates, selectedStates" />
		<s:State name="downAndSelected" stateGroups="downStates, selectedStates" />
		<s:State name="disabledAndSelected" stateGroups="selectedUpStates, disabledStates, selectedStates" />
	</s:states>
	
	<s:Rect x="0" y="0" width="30" height="30" radiusX="5"
			visible.down="false"
			visible.downAndSelected="false"
			visible.over="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="disabledAndSelected,down,downAndSelected,over,overAndSelected,up,upAndSelected"
			x="0" y="0" width="30" height="30" radiusX="5"
			visible.disabledAndSelected="false"
			visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="0x164AA5" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="0x66A1F7" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false"  inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage x="0" y="0" smooth="true"
				   source="@Embed('/assets/images/smallbutton_transparentbg.png')"
				   visible.down="false"
				   visible.downAndSelected="false"
				   alpha.overAndSelected="0.75">
	</s:BitmapImage>
	<s:BitmapImage includeIn="down,downAndSelected,up" x="0" y="0" smooth="true"
				   source="@Embed('/assets/images/smallbutton_transparentbg.png')"
				   visible.up="false">
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#333333" distance="2"
								hideObject="false" inner="true" knockout="false" quality="3"
								strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:BitmapImage x="7" y="6" smooth="true" source="@Embed('/assets/images/writenotesbig.png')"/>
	<s:BitmapImage smooth="true" source="@Embed('/assets/images/redalert.png')"
				   right="-1" top="-1"/>
</s:SparkButtonSkin>
