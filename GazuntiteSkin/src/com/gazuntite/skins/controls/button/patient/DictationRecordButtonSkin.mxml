<!--- The default skin class for the Spark Button component.  

       @see spark.components.Button
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
             xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
             minWidth="21" minHeight="21" 
             alpha.disabled="0.5">
     
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.ToggleButton")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" width="19" height="19" radiusX="3"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#505050" joints="miter" miterLimit="4" weight="1"
								color.upAndSelected="#910000"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90"
							  rotation.down="270"
							  rotation.over="270">
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0"
								 color.disabled="#CCCCCC"
								 color.disabledAndSelected="#CCCCCC"
								 color.upAndSelected="#F91616"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"
								 color.disabled="#999999"
								 color.disabledAndSelected="#999999"
								 color.upAndSelected="0xA03333"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="down" alpha="0.75" angle="90" blurX="2" blurY="2"
								color="#000000" distance="2" hideObject="false" inner="true"
								knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Ellipse x="5" y="5" width="10" height="10"
			   visible.downAndSelected="false"
			   visible.overAndSelected="false"
			   visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F43B3B" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#8C3131" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:fill.disabled>
			<s:SolidColor color="#666666"/>
		</s:fill.disabled>
		<s:fill.disabledAndSelected>
			<s:SolidColor color="#666666"/>
		</s:fill.disabledAndSelected>
		<s:fill.upAndSelected>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill.upAndSelected>
	</s:Ellipse>
	<s:Rect includeIn="downAndSelected,overAndSelected,upAndSelected" x="0.5" y="0.5" width="19" height="19"
			radiusX="3">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#910000" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0"
								 color.downAndSelected="#FF0000"
								 ratio.downAndSelected="0.3686274509803922"
								 color.overAndSelected="#FF0000"
								 ratio.overAndSelected="0.3686274509803922"
								 color.upAndSelected="#F91616" ratio.upAndSelected="0"/>
				<s:GradientEntry alpha="1.0" color="0xA03333" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="downAndSelected" alpha="0.75" angle="90" blurX="2"
								blurY="2" color="#000000" distance="2" hideObject="false"
								inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Ellipse includeIn="downAndSelected,overAndSelected,upAndSelected" x="5" y="5" width="10" height="10">
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:fill>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill>
	</s:Ellipse>
</s:SparkButtonSkin>
