<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="20" height="20">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" width="19" height="19" radiusX="2"
			visible.disabled="false"
			visible.disabledAndSelected="false"
			visible.down="false"
			visible.downAndSelected="false"
			visible.over="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#676767" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#353535" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect includeIn="disabledAndSelected,down,downAndSelected,over,overAndSelected,upAndSelected"
			x="0.5" y="0.5" width="19" height="19" radiusX="2"
			visible.disabledAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90"
							  rotation.over="270"
							  rotation.overAndSelected="270"
							  rotation.upAndSelected="270">
				<s:GradientEntry alpha="1.0" color="#295AB2" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#76ADFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="270"
									weight="1"
									rotation.overAndSelected="90"
									rotation.upAndSelected="90">
				<s:GradientEntry alpha="1.0" color="#4887E0" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#1C4799" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect includeIn="disabled,disabledAndSelected" x="0.5" y="0.5" width="19" height="19"
			radiusX="2">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#999999" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0.5019607843137255"/>
				<s:GradientEntry alpha="1.0" color="#333333" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="270"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#333333" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:BitmapImage x="5" y="5" smooth="true" source="@Embed('/assets/images/Notes.png')"
				   y.down="6"
				   y.downAndSelected="5">
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="0" blurY="0" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
