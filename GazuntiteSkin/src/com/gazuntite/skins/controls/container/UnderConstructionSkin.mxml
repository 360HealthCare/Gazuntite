<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
		width="100%" height="100%">
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.SkinnableContainer")]
		]]>
	</fx:Metadata> 
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	
	
	<s:Rect left="0" right="0" top="0" bottom="0" alpha="0.4"  >
		<s:fill>
			<s:SolidColor color="#000000"/>
		</s:fill>
	</s:Rect>
	
	<s:VGroup  verticalCenter="0" width="100%"  gap="-100" >
		<s:Rect  width="100%" height="55" >
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#5C5C5C" joints="miter" miterLimit="4"
									weight="1"/>
			</s:stroke>
			<s:fill>
				<s:SolidColor color="0x292929"/>
			</s:fill>
			<s:filters>
				<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#333333" inner="true"  knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>
		
		<s:VGroup  width="100%" horizontalAlign="center">
			<s:BitmapImage   width="84" height="69" smooth="true"  
							source="@Embed('/assets/images/Under_construction_icon_blue.png')">
				<s:filters>
					<s:DropShadowFilter alpha="0.75" angle="90" blurX="10" blurY="10" color="#000000"
										distance="6" hideObject="false" inner="false" knockout="false"
										quality="3" strength="1"/>
				</s:filters>
			</s:BitmapImage>
			
			<s:RichText  color="#FFFFFF" fontFamily="Calibri" fontSize="20"  
						 fontWeight="bold" tabStops="S0 S50 S100 S150" text="UNDER CONTRUCTION!"/>
		</s:VGroup>
		
	</s:VGroup>
	
	<!--- @copy spark.components.SkinnableContainer#contentGroup -->
	<s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" >
		<s:layout>
			<s:BasicLayout/>
		</s:layout>
	</s:Group>
	
</s:Skin>
