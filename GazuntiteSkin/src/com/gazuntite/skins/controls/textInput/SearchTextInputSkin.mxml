<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
			 alpha.disabled="0.5" 
			 alpha.disabledWithPrompt="0.5"
			 blendMode="normal"
			 >
	
	<fx:Metadata>
		<![CDATA[ 
		[HostComponent("spark.components.TextInput")]
		]]>
	</fx:Metadata> 
	
	<fx:Script>
		<![CDATA[
			private static const focusExclusions:Array = ["textDisplay"];
			override public function get focusSkinExclusions():Array { return focusExclusions;};
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="normalWithPrompt"/>
		<s:State name="disabled"/>
		<s:State name="disabledWithPrompt"/>
	</s:states>
	
	<s:Rect left="0" right="0" top="0" bottom="0" id="border" radiusX="2">
		<s:stroke>     
			<s:SolidColorStroke id="borderStroke" weight="2" />
		</s:stroke>
	</s:Rect>
	
	<s:Rect id="background" left="1" right="1" top="1" bottom="1" radiusX="2">
		<s:fill>
			<s:SolidColor id="bgFill" color="0xFFFFFF" />
		</s:fill>
	</s:Rect>
	
	<s:Rect left="1" top="1" right="1" height="1" id="shadow" radiusX="2">
		<s:fill>
			<s:SolidColor color="0x000000" alpha="0.12" />
		</s:fill>
	</s:Rect>
	
	<s:RichEditableText id="textDisplay" 
						color="#000000"
						focusIn="{textDisplay.selectRange(0,textDisplay.text.length) }"
						focusRect="false" focusThickness="0" 
						fontFamily="CalibriCFF"
						paddingLeft="8" paddingRight="3" 
						verticalAlign="middle" verticalCenter="0"
						left="1" right="19" top="2" bottom="2" 
						/>
	
	<s:Label 
		id="promptDisplay"
		includeIn="disabledWithPrompt,normalWithPrompt"
		color="#666666"
		bottom="1"
		left="1"
		paddingLeft="8"
		paddingRight="3"
		right="19"
		fontStyle="normal"
		verticalCenter="0"
		verticalAlign="middle"
		fontFamily="CalibriCFF"
		maxDisplayedLines="1"
		/>
	
	<s:Image right="2" 
			 verticalCenter="0" 
			 width="15" 
			 height="12" 
			 smooth="true"
			 source="@Embed('/assets/images/searchicon.png')"
			 rotation="0" 
			 buttonMode="true" 
			 useHandCursor="true" 
			 toolTip="Search"
			 >
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="2"/>
		</s:filters>
	</s:Image>
</s:SparkSkin>
