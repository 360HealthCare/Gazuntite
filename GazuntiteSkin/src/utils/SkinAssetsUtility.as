package utils
{
	import flash.utils.ByteArray;
	import mx.utils.Base64Decoder;

	[Bindable]
	public class SkinAssetsUtility
	{
		public function SkinAssetsUtility()
		{
		}
		
		public static var TOPBAR_LOGO_B4STR:String ='';
		public static var PE_SEARCH_HOVER:String ='';
		
		
		// This method recieved a Base64 String param and return a byteArray
		public static function getByteArray(val:String):ByteArray
		{
			var base64Dec:Base64Decoder = new Base64Decoder();;
			var byteArr:ByteArray;
			base64Dec.decode(val);
			byteArr = base64Dec.toByteArray();
			
			return byteArr;
		}
	}
}