<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"  
					  styleName="greyHeaderAliceBlueBGContainerSkin" 
					  width="100%" height="100%" 
					  xmlns:components="com.gazuntite.controls.extended.components.*"  >
	
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.provider.services.sms.dto.SMSDTO;
			import com.gazuntite.provider.services.sms.dto.SMSRecieverListDTO;
			import com.gazuntite.provider.services.sms.event.SendSMSEvent;
			import com.gazuntite.skins.controls.button.EMailButtonSkin;
			import com.gazuntite.skins.controls.button.communication.SendEmailButtonSkin;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.controls.Alert;
			
			private var _userID:int;
			private var _senderID:int;
			private var _clinicBranchID:String;
			
			[Bindable]
			public function get BranchID():String
			{
				return _clinicBranchID;
			}
			
			public function set BranchID(value:String):void
			{
				_clinicBranchID = value;
			}
			
			[Bindable]
			public function get senderID():int
			{
				return _senderID;
			}
			
			public function set senderID(value:int):void
			{
				_senderID = value;
			}
			
			
			[Bindable]
			public function get userID():int
			{
				return _userID;
			}
			
			public function set userID(value:int):void
			{
				_userID = value;
			}
			
			protected function btnSendSMS_clickHandler(event:MouseEvent):void
			{
				if(txtPhoneNumber.text.replace(" ","") != "" && txtSMSBody.text.replace(" ","") != "")
				{
					var objSMSDTO:SMSDTO=new SMSDTO();
					var smsRecieverDTO:SMSRecieverListDTO = new SMSRecieverListDTO();
					objSMSDTO.clinicBranchID = parseInt(BranchID);
					objSMSDTO.isDeleted = false;
					objSMSDTO.phoneNumber = txtPhoneNumber.text;
					objSMSDTO.Text = txtSMSBody.text;
					objSMSDTO.userId =  senderID;
					objSMSDTO.createdBy = senderID;
					smsRecieverDTO.phoneNumber=txtPhoneNumber.text;
					smsRecieverDTO.userId = senderID;
					
					//objSMSDTO.smsRecieverListDTO.phoneNumber= txtPhoneNumber.text;
					//objSMSDTO.userId = 579;
					//	objSMSDTO.smsRecieverListDTO.phoneNumber = smsRecieverDTO.phoneNumber;
					//	objSMSDTO.smsRecieverListDTO.userId = smsRecieverDTO.userId;
					
					var objSendSMSevent:SendSMSEvent=new SendSMSEvent(objSMSDTO);
					CairngormEventDispatcher.getInstance().dispatchEvent(objSendSMSevent);
					
					btnClear_clickHandler(event);
				}
				else
					Alert.show("Recipient or SMS text cannot be empty.","SMS Sending Error" ,4,this);
					//UtilityFunctions.ShowMessage("Recipient or SMS text cannot be empty.","SMS Sending Error");
				
			}
			
			protected function btnClear_clickHandler(event:MouseEvent):void
			{
				txtPhoneNumber.text = "";
				txtSMSBody.text = "";
			}
			
			private var _showNav:Boolean = true;
			
			[Bindable]
			public function get showNav():Boolean
			{
				return _showNav;
			}
			
			public function set showNav(value:Boolean):void
			{
				_showNav = value;
			}
			
			
		]]>
	</fx:Script>

	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout paddingTop="5" paddingRight="5" paddingLeft="5" paddingBottom="10" gap="10" />
	</s:layout>
	<!--
	<s:HGroup  horizontalAlign="right" width="100%" gap="6" height="30" verticalAlign="top">
	<s:Button id="id_SendBtn" buttonMode="true" useHandCursor="true" label="Send"  click="btnSendSMS_clickHandler(event)"
	toolTip="Click here to send an SMS"  skinClass="com.zigron.gazuntite.skins.controls.button.communication.SendEmailButtonSkin"   />
	
	<s:Button id="btnClsoe" label="Discard"   height="20" 
	click="btnClear_clickHandler(event)" buttonMode="true" toolTip="Discard" styleName="communicationButtonSkin" visible="{showNav}" includeInLayout="{showNav}"/>
	</s:HGroup>
	-->
	
	<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="left" >
		<!--<s:Label text="To" textAlign="right" fontFamily="CalibriCFF" fontSize="14" color="{!showNav ? 0xFFFFFF:0x000000}"/>-->
		<components:LabelTextInput id="txtPhoneNumber" 
								   width="100%" text=""  prompt="To: Mobile #" 
								   skinClass="com.gazuntite.skins.controls.text.EmailFieldSkin"/>
		<s:Button id="id_SendBtn" 
				  buttonMode="true" useHandCursor="true" 
				  click="btnSendSMS_clickHandler(event)"
				  toolTip="Send"
				  skinClass="com.gazuntite.skins.controls.button.communication.SendButtonSkin"/>
		
		<s:Button id="btnClsoe" label="Discard"  
				  click="btnClear_clickHandler(event)" buttonMode="true" toolTip="Discard" styleName="communicationButtonSkin" visible="false" includeInLayout="false"/>
		<!--skinClass="com.zigron.gazuntite.skins.controls.text.EmailFieldSkin"-->
	</s:HGroup>
	
	<!--<s:BorderContainer width="100%" height="100%" cornerRadius="5" borderVisible="true" borderWeight="1" borderColor="0x000000" backgroundColor="0xF1F1F1">-->
		<components:LabelTextArea id="txtSMSBody" 
								  width="100%" height="100%" prompt="Message"  
								  skinClass="com.gazuntite.controls.skins.LabelTextAreaRoundedSkin" 
								  /> <!-- minHeight="100"-->
	<!--</s:BorderContainer>-->	
	 	
</s:SkinnableContainer >
