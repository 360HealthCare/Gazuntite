			protected function btnDelete_clickHandler(event:Event):void
			{
				
				if(id_SentSMS != null)
				{
					var SelectedItems:ArrayCollection = new ArrayCollection();
					
					for each (var item:SMSDTOResponse in  id_SentSMS.uiSmsList.dataProvider)
					{
						if(item.isSelected)
							SelectedItems.addItem(item);
					}
					
					//var selection:Vector.<Object> = new Vector.<Object>( id_SentSMS.uiSmsList.selectedItems );
					
					var smsID:String = "";
					if(SelectedItems.length > 0)
					{
						for (var i:int = 0; i < SelectedItems.length; i++)
						{
							//if(ListCollectionView(id_SentSMS.dgSentSMS.dataProvider).getItemAt(i)["isSelected"]==true)
							smsID	+=  SelectedItems.getItemAt(i)["smsID"]+"^";//ListCollectionView(id_SentSMS.dgSentSMS.dataProvider).getItemAt(i)["smsID"]+"^";
						}
						
						
						if(smsID.length > 0)
						{
							//var smsID:String = "28^31";	
							smsID = smsID.substring(0,smsID.length);
							var smsDeleteEvent : DeleteSMSEvent = new DeleteSMSEvent(smsID,id_SentSMS.model.loggedInUserId,DeleteFunctionCallBack);
							CairngormEventDispatcher.getInstance().dispatchEvent(smsDeleteEvent);
						}
						else
							//Alert.show("No SMS is selected for deletion.","SMS Sending Error" ,4,FlexGlobals.topLevelApplication.mainContainer);
							
							Alert.show("No SMS is selected for deletion.", "SMS Sending Error", Alert.OK, this, function( event:CloseEvent):void
							{
								viewstack1.selectedIndex=1;
							});
						
							//UtilityFunctions.ShowMessage("No SMS is selected for deletion.","SMS Sending Error");
						
					}
					else
						//Alert.show("No row to delete.","SMS Sending Error" ,4,FlexGlobals.topLevelApplication.mainContainer);
						Alert.show("No row to delete.", "SMS Sending Error", Alert.OK, this, function( event:CloseEvent):void
						{
							
						});
					
						//UtilityFunctions.ShowMessage("No row to delete.","SMS Sending Error");
				}
			}
			
			private function DeleteFunctionCallBack():void
			{
				id_SentSMS.GetSMSValuesCallBack();
				LoadSMS();
			}
			
