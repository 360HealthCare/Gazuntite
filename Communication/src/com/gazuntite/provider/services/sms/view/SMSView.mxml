						useHandCursor="true" buttonMode="true"  
						selected="@{viewModel.emailMenuShown}"
						includeInLayout="false"
						visible="false"
						/>
		<s:Label id="uiSmsOption" styleName="emailOption" text="COMPOSE"/>
		<s:Spacer width="100%" />
		
		<s:ToggleButton id="id_composeBtn" 
				  skinClass="com.gazuntite.skins.controls.toggleButtonSkin.communication.ComposeTBSkin"
				  click="id_composeBtn_clickHandler(event)"
				  buttonMode="true" useHandCursor="true"
				  selected="{viewstack1.selectedIndex == 0}"
				  toolTip="Compose"/>
		<s:ToggleButton id="id_SentBtn" 
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.communication.OutboxTBSkin"
						toolTip="Sent" click="id_SentBtn_clickHandler(event)"
						selected="{viewstack1.selectedIndex == 1}"
						buttonMode="true" useHandCursor="true"
						/>
	</s:SkinnableContainer>
	
	<mx:ViewStack id="viewstack1" width="100%" height="100%">
		<s:NavigatorContent width="100%" height="100%" label="Compose">
			<emailview:ComposeSMSView id="id_Compose" width="100%" height="100%" BranchID="{BranchID}" userID="{userID}" senderID="{senderID}" showNav="{showHeader}"/>
		</s:NavigatorContent>
		<s:NavigatorContent width="100%" height="100%" label="Sent">
			<emailview:SentSMSView id="id_SentSMS" userID="{senderID}" clinicBranchID="{BranchID}" width="100%" height="100%" DeleteSelectedSMS="btnDelete_clickHandler(event)"/>
		</s:NavigatorContent>
		
	</mx:ViewStack>
	
	
</s:BorderContainer>
