			private var smsOptionPopup:SmsOptionPopup;
			protected function showComOptionpoup(event:MouseEvent):void
			{
				var toggleView:Boolean = null != smsOptionPopup;
				
				removeAllPopups();
				
				if(toggleView )
				{
					return;
				}
				
				smsOptionPopup = new SmsOptionPopup();
				smsOptionPopup.ShowPopup( this );
				smsOptionPopup.dataProvider = viewstack1;
				smsOptionPopup.addEventListener(EmailOptionEvent.EMAIL_OPTION_CHANGE, function(optionevent:EmailOptionEvent):void 
				{ 
					uiSmsOption.text=optionevent.content;
					uiSmsOption.text=uiSmsOption.text.toUpperCase();
					trace(optionevent);//comOptionpoup
					//					logger.debug( "ComOptionpoup view changed " );
				});
				smsOptionPopup.addEventListener("smsClosePopup", 
					function(closeevent:Event):void 
					{ 
						removeAllPopups();
						viewModel.emailMenuShown = false;
					} );
				
				var pt:Point = popButton.localToGlobal(new Point(event.localX, event.localY));
				//				var pt:Point = new Point(event.localX, event.localY);
				
				smsOptionPopup.move( pt.x - smsOptionPopup.width + popButton.width + 66, pt.y + popButton.height-12);
				//				comOptionpoup.move( pt.x - comOptionpoup.width , pt.y );
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			public function removeAllPopups():void
			{
				if( smsOptionPopup && smsOptionPopup.isPopUp )
				{
					smsOptionPopup.removePopup();
					smsOptionPopup = null;
				}
			}
			
			
