			protected function btnDelete_clickHandler(event:Event):void
			{ 
				//	dgEmailInbox.selectedItems[][]
				
				var SelectedItems:ArrayCollection = new ArrayCollection();
				
				for each (var item:EmailDTO in  id_MailInbox.uiInboxList.dataProvider)
				{
					if(item.isSelected)
						SelectedItems.addItem(item);
				}
				
				if(SelectedItems.length > 0)
				{
					var emailID:String = "";
					
					for (var i:int = 0; i < SelectedItems.length; i++)
					{
						emailID	+= SelectedItems[i].EmailID+"^";					
					}
					
					if(emailID.length > 0)
					{
						emailID=emailID.substring(0,emailID.length-1);
						///////////// Change USer ID later On
						var emailDeleteEvent : DeleteEmailEvent = new DeleteEmailEvent(emailID,model.loggedInUserId,GetEmailValuesCallBack);
						CairngormEventDispatcher.getInstance().dispatchEvent(emailDeleteEvent);
					}
					else
						Alert.show("Select any Email to Delete.","Email Sending Error" ,4,this);
				}
				else
					Alert.show("No Email to Delete.","Email Sending Error" ,4,this);
			}
			
