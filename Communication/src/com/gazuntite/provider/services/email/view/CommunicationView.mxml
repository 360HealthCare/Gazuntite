			protected function id_ReadMail_ReplyEmailEventHandler(event:ReplyEmailEvent):void
			{
				ShowEmailCount(false);
				id_Views.selectedIndex=1;
				if(id_SendMail != null)
				{
					if(model.IsInbox)
					{
						//id_SendMail.id_email.text = event.from;
						EmailAddress = event.from;
						//id_SendMail.EmailAddress = event.from;
						userID = event.userId;
						id_SendMail.senderID = event.userId;
						id_SendMail.id_subject.text = "Re: "+ event.subject;
						id_SendMail.id_message.text = event.message;
						id_SendMail.fileAttachmentArray.removeAll();
						id_SendMail.id_AttachmentGrid.visible = false;
						id_SendMail.id_AttachmentGrid.includeInLayout = false;
						btnComposeMail.selected = true;
						btnInbox.selected = false;
						id_SendMail.isReply = true;
						
					}
					else
					{
						id_SendMail.id_email.text = event.from;
						id_SendMail.id_subject.text = "Forward: "+ event.subject;
						id_SendMail.id_message.text = event.message;
						
						id_SendMail.fileAttachmentArray = event.attachment;
						id_SendMail.id_AttachmentGrid.dataProvider = null;
						id_SendMail.id_AttachmentGrid.dataProvider = id_SendMail.fileAttachmentArray;
						//if(id_SendMail.fileAttachmentArray.length > 0)
						if(event.attachment.length > 0)
						{
							id_SendMail.id_AttachmentGrid.visible = true;
							id_SendMail.id_AttachmentGrid.includeInLayout = false;
							
						}
						else
						{
							id_SendMail.id_AttachmentGrid.visible         = false;
							id_SendMail.id_AttachmentGrid.includeInLayout = false;
						}
						btnComposeMail.selected = true;
						btnSentItem.selected = false;
						id_SendMail.isReply = false;
					}
				}
				
				
				//id_SendMail.id_subject.text ="Re: "+ model.subject;
				//id_SendMail.id_message.text = "\r\n\r\n"+" On "+ model.mailSentAt+ ", "+ model.from +" wrote: \r\n"+model.message ;
			}
			
			
			
