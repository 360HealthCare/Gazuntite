			private var comOptionpoup:EmailOptionpoup
			protected function showComOptionpoup(event:MouseEvent):void
			{
				var toggleView:Boolean = null != comOptionpoup;
				
				removeAllPopups();
				
				if(toggleView )
				{
					return;
				}
				
				comOptionpoup = new EmailOptionpoup();
				comOptionpoup.ShowPopup( this );
				comOptionpoup.dataProvider = id_Views;
				comOptionpoup.addEventListener(EmailOptionEvent.EMAIL_OPTION_CHANGE, function(optionevent:EmailOptionEvent):void 
				{ 
					emailOption.text=optionevent.content;
					emailOption.text=emailOption.text.toUpperCase();
					trace(optionevent);//comOptionpoup
					//					logger.debug( "ComOptionpoup view changed " );
				});
				comOptionpoup.addEventListener("emailClosePopup", 
					function(closeevent:Event):void 
					{ 
						removeAllPopups();
						viewModel.emailMenuShown = false;
					} );
				
				var pt:Point = popButton.localToGlobal(new Point(event.localX, event.localY));
				//				var pt:Point = new Point(event.localX, event.localY);
				
				comOptionpoup.move( pt.x - comOptionpoup.width + popButton.width + 115, pt.y + popButton.height-12);
				//				comOptionpoup.move( pt.x - comOptionpoup.width , pt.y );
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
			public function removeAllPopups():void
			{
				if( comOptionpoup && comOptionpoup.isPopUp )
				{
					comOptionpoup.removePopup();
					comOptionpoup = null;
				}
			}
