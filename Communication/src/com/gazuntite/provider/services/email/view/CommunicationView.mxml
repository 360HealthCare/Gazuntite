						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.communication.InboxTBSkin"
						buttonMode="true" toolTip="Inbox" id="btnInbox" name="bntInbox" click="btnInbox_clickHandler(event)"  styleName="communicationHeaderToggleButtonSkin"/>
		<s:ToggleButton label="Sent Items" id="btnSentItem"  
						skinClass="com.gazuntite.skins.controls.toggleButtonSkin.communication.OutboxTBSkin"
						buttonMode="true" toolTip="Sent Items" name="btnSentItem" click="btnSentItem_clickHandler(event)" styleName="communicationHeaderToggleButtonSkin" />
		<s:Button label="Delete" visible="false" includeInLayout="false" id="btnDelete" width="82" height="25" buttonMode="true" toolTip="Delete" name="btnDelete" click="btnDelete_clickHandler(event)" styleName="communicationButtonSkin" />
		<s:Label paddingRight="4" id="id_EmailCount" text="{emailCounter}" fontFamily="Calibri Bold" visible="false" includeInLayout="false"/>
	</s:SkinnableContainer>
	
	<!--<s:BorderContainer width="100%" borderColor="red" >-->
	
	
	<mx:ViewStack id="id_Views" width="100%" height="100%">
		<s:NavigatorContent id="Inbox" width="100%" height="100%">
			<emailview:MailInboxView id="id_MailInbox" width="100%" height="100%" deleteEmailEvent="btnDelete_clickHandler(event)"
									 LoadEmailEvent="id_MailInbox_LoadEmailEventHandler(event)"/>
		</s:NavigatorContent>
		<s:NavigatorContent id="Compose"  width="100%" height="100%">
			<emailview:ComposeMailView id="id_SendMail" width="100%" height="100%" showNav="{showHeader}" RefreshEmailEvent="id_SendMail_RefreshEmailEventHandler(event)" EmailAddress="{EmailAddress}" userID="{userID}" senderID="{model.loggedInUserId}" stationdID="{model.loggedInUserSelectedStationID}" branchID="{model.loggedInUserSelectedBranchId}" click="id_SendMail_clickHandler(event)"/>
		</s:NavigatorContent>
		<s:NavigatorContent id="Sent">
			
			<emailview:ReadEmailView id="id_ReadMail"   width="100%" height="100%" />
		</s:NavigatorContent>
	</mx:ViewStack>
	
	<!--</s:BorderContainer>-->
</s:BorderContainer>
