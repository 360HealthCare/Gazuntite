			public function getSentItem():void
			{
				if(!model.IsInbox)
				{
					//sendToServer(597,1,1,model.totalPage,EmailConstant.CURRENTPAGE=1);
					var emailSentEvent : GetSentEmailEvent = new GetSentEmailEvent(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,10,1,model.IsInbox,EnableNavigateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailSentEvent);
				}
				else if(model.IsInbox)
				{
					var emailEvent : GetEmailEvent = new GetEmailEvent(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,10,1,model.IsInbox,EnableNavigateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailEvent);
				}
				//	dgEmailInbox.dataProvider="{model.m_oEmailResultList.EmailAll}";
				//id_MailInbox.dgEmailInbox.dataProvider="{model.m_oEmailResultList.EmailAll}";
			}
			public function  EnableNavigationButtons(currentPage:int, totalPages:int ):void //currentPage:int, totalPages:int ):void
			{
				currentPage = EmailConstant.CURRENTPAGE;
				//				btnGotoFirstRecord.enabled = currentPage != 1;
				//				btnGotoLastRecord.enabled 		= currentPage != totalPages;
				//				btnNext.enabled 		=  currentPage != totalPages;
				//				btnPrevious.enabled 	=  currentPage != 1;
			}
			
			private function sendToServer( userId:int, clinicBranchId:int, stationId:int,totalPages:int,currentPage:int ):void
			{
				if(model.IsInbox)
				{
					var id:int=model.loggedInUserId;
					var bid:int = model.loggedInUserSelectedBranchId;
					var cId:int = model.loggedInUserSelectedStationID;
					
					var emailEvent : GetEmailEvent = new GetEmailEvent(userId,clinicBranchId,stationId,totalPages,currentPage,model.IsInbox,EnableNavigateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailEvent);
				}
				else if(!model.IsInbox)
				{
					var emailSentEvent : GetSentEmailEvent = new GetSentEmailEvent(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,10,currentPage,model.IsInbox,EnableNavigateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailSentEvent);
				}
			}
			
			public  function EnableNavigateCallBack(val:* = null):void
			{
				
				EnableNavigationButtons(model.currentPage,model.totalPage);
			}
			
			protected function CheckUncheckAll():void
			{
				var allRows:int =	 model.m_oEmailResultList.EmailAll.length;
				
				for (var i:int = 0; i < allRows; i++)
				{
					
					//if (chkHeader.selected == true)
					if(true)
					{
						trace ("Checked is true");
						ListCollectionView(uiInboxList.dataProvider).getItemAt(i)["isSelected"]=true;
					}
					else
					{
						trace ("Checked is false");
						ListCollectionView(uiInboxList.dataProvider).getItemAt(i)["isSelected"]=false;
					}
				}
				uiInboxList.dataProvider = model.m_oEmailResultList.EmailAll; 
			}
			
