			protected function btnGotoFirstRecord_clickHandler(event:MouseEvent):void
			{
				if(model.IsInbox)
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE=1);
				else
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE=1);
				
			}
			
			protected function btnPrevious_clickHandler(event:MouseEvent):void
			{
				if(model.IsInbox)
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE -=1);
				else
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE -=1);
			}
			
			
			protected function btnNext_clickHandler(event:MouseEvent):void
			{
				if(model.IsInbox)
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE += 1)
				else
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE +=1);
				//sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE +1);
			}
			
			
			protected function btnGotoLastRecord_clickHandler(event:MouseEvent):void
			{
				if(model.IsInbox)
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE = model.totalPage);
				else
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.totalPage,EmailConstant.CURRENTPAGE= model.totalPage);
				//getSentItem();
			}
			
			
			public function Refresh():void
			{
				var currentPage:int =1,totalPages:int =10;
				//EnableNavigationButtons(currentPage,totalPages);
				if(model.IsInbox)
					sendToServer(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,10,1);
				else
					getSentItem();
			}
			
