			protected function id_SendBtn_clickHandler(event:MouseEvent):void
			{
				if(fileAttachmentArray.length > 0 )
				{
					UploadAllFiles();
				}
				else
				{
					SendMail("");
				}
				
				event.stopImmediatePropagation();
				
			} 
			
			private function SendMail(ListfilesName:String):void
			{
				if(id_email.text != "")
				{
					if(id_subject.text != "")
					{					
						var objEmailDTO:EmailDTO = new EmailDTO();
						objEmailDTO.ClinicBranchID= branchID;
						objEmailDTO.StationID = stationdID;
						objEmailDTO.EmailStateID = 1;
						objEmailDTO.EmailTypeID = 1;
						objEmailDTO.EmailTemplateID =0;
						objEmailDTO.HasAttachment = HasAttachment.toString();
						if(HasAttachment)
							objEmailDTO.AttachedFileName = ListfilesName;
						objEmailDTO.Message= id_message.text;
						
						
						if(isReply)
						{
							
							objEmailDTO.RECIEVERID = userID;
							objEmailDTO.SENDERID =senderID;
						}
						else
						{
							objEmailDTO.RECIEVERID = userID;
							objEmailDTO.SENDERID =senderID;
						}
						objEmailDTO.Subject=id_subject.text;
						
						
						var sendMailEvent : SendEmailEvent = new SendEmailEvent(objEmailDTO);
						CairngormEventDispatcher.getInstance().dispatchEvent(sendMailEvent);
						
						var refreshEmail:RefreshInboxPanel  = new RefreshInboxPanel();
						dispatchEvent( refreshEmail );
						id_message.text="";
						id_subject.text="";
						id_email.text = "";
					}
					else
					{
						
						Alert.show("Enter Email Subject.","Email Sending Error",4,this);
						//UtilityFunctions.ShowMessage("Enter Email Subject.","Email Sending Error");
					}
					
				}
				else
					Alert.show("Enter Email Id of the recipient." ,"Email Sending Error",2,this);
					//UtilityFunctions.ShowMessage("Enter Email Id of the recipient." ,"Email Sending Error");
				
			}
			
			
