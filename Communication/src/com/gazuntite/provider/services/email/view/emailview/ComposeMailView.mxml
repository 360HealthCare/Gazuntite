			private function UploadAllFiles():void
			{
				for(fileCounter=fileCounter;fileCounter < fileAttachmentArray.length ;fileCounter++)
				{
					
					if(ListCollectionView(id_AttachmentGrid.dataProvider).getItemAt(fileCounter)["isSelected"] == true)
					{
						
						fileRef=new FileReference();
						fileRef = filerefList[fileCounter];
						fileRef.addEventListener(ProgressEvent.PROGRESS, fileRef_progress);
						fileRef.addEventListener(Event.COMPLETE, fileRef_complete);
						fileRef.addEventListener(Event.CANCEL, fileRef_cancel);
						
						filesName += ListCollectionView(id_AttachmentGrid.dataProvider).getItemAt(fileCounter)["fileName"].toString()+";";
						
