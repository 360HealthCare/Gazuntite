			private function fileRef_select(evt:Event):void 
			{
				try {
					
					if((totalFilesSize + ((fileRef.size/1024)/1024)) > 10)
					{
						Alert.show("Attachement size is greater than 10 Mb","Email Sending Error" ,4,this);
						//UtilityFunctions.ShowMessage("Attachement size is greater than 10 Mb","Email Sending Error");
						
					}
						
					else
					{
						filerefList.addItem(fileRef);
						
						totalFilesSize += (fileRef.size/1024)/1024;
						fileAttachmentArray.addItem(new AttachmentArray(true,fileRef.name));
						id_AttachmentGrid.visible=true;
						id_AttachmentGrid.includeInLayout = true;
					}
					
				} catch (err:Error) {
					//	message.text = "ERROR: zero-byte file";
					Alert.show("Error in uploading","File Upload Error",4,this);
					//UtilityFunctions.ShowMessage("Error in uploading","File Upload Error");
					
				}
			} 
			
			
			
