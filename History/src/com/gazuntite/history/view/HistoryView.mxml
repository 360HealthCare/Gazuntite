<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:view="com.gazuntite.history.view.*"
					  creationComplete="cc()" xmlns:views="com.gazuntite.history.view.views.*" 
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.history.model.HistoryModelLocator;
			import com.gazuntite.history.view.event.ProviderSelectionEvent;
			
			[Bindable]	private var model:HistoryModelLocator = HistoryModelLocator.getInstance();
			
			protected function cc():void
			{
				addEventListener("setDetailsView",function():void{
					
					if(id_ProviderList.id_list.selectedIndex != -1)
						id_detailView.showDetailView = true;
					else
						id_detailView.showDetailView = false;
				});
				
				id_ProviderList.addEventListener(ProviderSelectionEvent.ProviderSelection,GetSelectedProviderData);
			}
			
			private function GetSelectedProviderData(event:ProviderSelectionEvent):void
			{
				id_detailView.LoadSelectedProviderData(event.SelectedProvider);
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="3" verticalAlign="top" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="0"/>
	</s:layout>
	
	<s:HGroup  width="100%" height="100%" >
		<views:ProviderListView  id="id_ProviderList"  height="100%" width="150" dataProvider="{model.PatientHistoryDTOList}" />
		<views:HistoryDetailView id="id_detailView" width="100%" height="100%" />
	</s:HGroup>
	
</s:SkinnableContainer>