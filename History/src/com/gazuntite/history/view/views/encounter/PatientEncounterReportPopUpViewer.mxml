<?xml version="1.0" encoding="utf-8"?>
<s:BorderContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				   xmlns:s="library://ns.adobe.com/flex/spark" 
				   xmlns:mx="library://ns.adobe.com/flex/mx" backgroundColor="#FFFFFF">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import mx.managers.PopUpManager;
			
			private var _reportURL:String;
			
			[Bindable]
			public function get reportURL():String
			{
				return _reportURL;
			}

			public function set reportURL(value:String):void
			{
				_reportURL = value;
			}

			private function closeClickHandler():void
			{
				PopUpManager.removePopUp(this);
			}
			
		]]>
	</fx:Script>
	<s:layout>
		<s:VerticalLayout gap="0"/>
	</s:layout>
	
	<s:BorderContainer id="header" width="100%" backgroundColor="#D0D0D0">
		<s:layout>
			<s:HorizontalLayout paddingLeft="8" paddingRight="4" paddingTop="6" paddingBottom="6" verticalAlign="middle"/>
		</s:layout>
		
		<s:Label id="title" text="REPORT VIEWER" fontFamily="CalibriCFF" fontSize="14" />
		<s:Button id="close" click="closeClickHandler()"
				  skinClass="com.gazuntite.skins.controls.button.SpinnerCancelButton"
				  buttonMode="true" useHandCursor="true" toolTip="Close"
				  />
	</s:BorderContainer>
	
	<mx:HTML id="id_Html" width="100%" height="100%" location="{reportURL}" paddingLeft="5" paddingRight="5"/>
	
</s:BorderContainer>
