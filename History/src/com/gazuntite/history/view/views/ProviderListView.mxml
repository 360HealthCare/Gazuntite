<?xml version="1.0" encoding="utf-8"?>
<s:BorderContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  cornerRadius="3"
					  backgroundColor="#FFFFFF"
					  borderVisible="false"
					  creationComplete="cc(event)"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.history.dto.PatientVisitProviderDTO;
			import com.gazuntite.history.view.event.ProviderSelectionEvent;
			
			import mx.events.FlexEvent;
			
			import spark.collections.Sort;
			import spark.collections.SortField;
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			private var _dataProvider:ArrayCollection;
			private var isComboBoxOpen:Boolean= false;
			
			public function get dataProvider():ArrayCollection
			{
				return _dataProvider;
			}
			
			[Bindable]
			public function set dataProvider(value:ArrayCollection):void
			{
				if(value != null)
				{
					_dataProvider = value;
					
					dataProvider = sort(dataProvider,uiSortDropdown.selectedItem.Field,false);
				}
			}
			
			
			protected function cc(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function uiSortDropdown_changeHandler(event:IndexChangeEvent):void
			{
				lbl_selected.text = uiSortDropdown.selectedItem.label;//Assign the text
				
				dataProvider = sort(dataProvider,uiSortDropdown.selectedItem.Field,false);
				isComboBoxOpen = false;
				
			}
			
			public static function sort(arrayCollection:ArrayCollection, sortBy:String, numericSort:Boolean):ArrayCollection 
			{ 
				
				var dataSortField:SortField        = new SortField(); 
				dataSortField.name                = sortBy; 
				dataSortField.numeric            = numericSort; 
				
				var dataSort:Sort    = new Sort(); 
				dataSort.fields        = [dataSortField]; 
				
				/* Set the ArrayCollection object's sort property to our 
				custom sort, and refresh the ArrayCollection. */ 
				
				dataSortField.descending = false
				arrayCollection.sort = dataSort; 
				arrayCollection.refresh(); 
				
				/* Return the collection */ 
				return arrayCollection; 
			} 
			
			protected function id_list_changeHandler(event:IndexChangeEvent):void
			{
				var PSE:ProviderSelectionEvent = new ProviderSelectionEvent(ProviderSelectionEvent.ProviderSelection,true);
				PSE.SelectedProvider = id_list.selectedItem as PatientVisitProviderDTO;
				dispatchEvent(PSE);
				
			}
			
			protected function id_list_renderHandler(event:Event):void
			{
				/* if(id_list.selectedIndex == -1)
				{ */
					dispatchEvent(new Event("setDetailsView",true));
				/* }  */
			}
			
			protected function skinnablecontainer1_clickHandler(event:MouseEvent):void
			{
				if(isComboBoxOpen)
				{
					uiSortDropdown.closeDropDown(false);
					isComboBoxOpen= false;
				}
				else
				{
					uiSortDropdown.openDropDown(); 
					isComboBoxOpen= true;
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<s:layout>
		<s:VerticalLayout  gap="1" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" />
	</s:layout>
	
	<s:SkinnableContainer  width="100%" height="25" 
						   skinClass="com.gazuntite.skins.controls.container.dmg.DMGArrangeByBgSkin"
						   toolTip="{'Arrange By: '+uiSortDropdown.selectedItem.label}"
						   click="skinnablecontainer1_clickHandler(event)" useHandCursor="true" buttonMode="true"
						   >
		
		<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="8" paddingRight="2" gap="4">
			<s:Label text="Arrange By:" fontSize="12" fontFamily="CalibriCFF"/>
			<s:Label id="lbl_selected" 
					 fontFamily="CalibriCFFBold"
					 width="100%" maxDisplayedLines="1" text="{uiSortDropdown.selectedItem.label}"/>
			<s:Button skinClass="com.gazuntite.skins.controls.combobox.StepperComboOpenButtonSkin"/>
		</s:HGroup>
		
		<s:ComboBox id="uiSortDropdown"
					selectedIndex="0" top="24" width="100%" height="1"
					
					change="uiSortDropdown_changeHandler(event)"
					itemRenderer="com.gazuntite.history.view.itemRenderer.DDItemrederer"
					skinClass="com.gazuntite.skins.controls.combobox.cmbHolderSkin"
					> 
			<s:dataProvider>
				<s:ArrayCollection>
					<fx:Object label="Doctor Name" Field="ProviderFullName" />
					<fx:Object label="Speciality" Field="Speciality" />
				</s:ArrayCollection>
			</s:dataProvider>
		</s:ComboBox>
		
	</s:SkinnableContainer>
	
	<s:List id="id_list"
			left="0"
			width="100%" height="100%"
			allowMultipleSelection="false"
			borderVisible="false"
			horizontalScrollPolicy="off"
			change="id_list_changeHandler(event)"
			render="id_list_renderHandler(event)"
			dataProvider="{dataProvider}"
			itemRenderer="com.gazuntite.history.view.itemRenderer.ProviderListIR"
			skinClass="com.gazuntite.skins.controls.scrollbar.communication.ProviderListSkin"
			/>
	
</s:BorderContainer>