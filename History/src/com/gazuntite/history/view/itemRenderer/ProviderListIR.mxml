<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="false" 
				width="100%" creationComplete="cc(event)">
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			[Bindable]	protected var tooltip:String;
			
			protected function cc(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				if(null != value)
				{
					tooltip = "Provider Name:        <b>" + data.ProviderFirstName +' '+ data.ProviderLastName +"</b><br>Speciality:    <b>"+ data.Speciality + "</b>";
				}
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			private function onMouseOver():void
			{
				id_Header.setStyle('backgroundColor', 0xFFD08F);
			}
			private function onMouseOut():void
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
			}
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="hovered" />
		<s:State name="selected" />
	</s:states>
	
	<s:BorderContainer id="id_Header" 
					   width="100%" height="100%" 
					   useHandCursor="true" buttonMode="true"  borderVisible="false" 
					   skinClass.selected="com.gazuntite.skins.controls.container.dmg.DMGSelectedPatientSkin"
					   mouseOver="onMouseOver()" mouseOut="onMouseOut()"
					   toolTip="{tooltip}"
					   >
		<s:layout>
			<s:VerticalLayout paddingLeft="5" paddingRight="5" paddingTop="5" paddingBottom="5"/>
		</s:layout>
		
		<s:VGroup width="100%" height="30" x="0" y="0" verticalAlign="middle" >
			
			<s:Label text="{data.ProviderFullName}"
					 left="0" width="100%"
					 fontSize="14"
					 color.selected="0xFFFFFF"
					 color="0x333333"
					 fontFamily="CalibriCFFBold"  
					 maxDisplayedLines="1"
					 typographicCase.selected="uppercase"
					 />
			<s:Label text="{data.Speciality}"
					 fontSize="12"
					 left="0" width="100%"
					 color.selected="0xFFFFFF"
					 color="0x333333"
					 fontFamily="CalibriCFF" 
					 maxDisplayedLines="1"
					 />
		</s:VGroup>
		
		
	</s:BorderContainer>
</s:ItemRenderer>
