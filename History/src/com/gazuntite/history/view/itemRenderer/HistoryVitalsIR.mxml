<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				implements="com.gazuntite.history.view.itemRenderer.IHistoryIR"
				height="40"	width="100%" creationComplete="cc(event)" xmlns:view="com.gazuntite.history.view.*" xmlns:views="com.gazuntite.history.view.views.*"
				>
	
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.VitalsDTO;
			import com.gazuntite.common.util.converter.UnitConverter;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			var BMI:Number = 0;
			
			protected function cc(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				if(null != data && data is VitalsDTO)
					calculateBMI();
			}
			public function calculateBMI():void
			{
				
				var hgt:Number = data.Height;
				var wgt:Number = data.Weight;
				var m:Number = 0;
				if (! data.IsMetricDisplaySelected)
				{
					
					var cm:Number 				= UnitConverter.inchesToCentimeters( hgt );
					m				            = UnitConverter.centimetersToMeters( cm );
					var hgtInMeterSq1:Number 	= Math.pow( m, 2 );
					var kg:Number				= UnitConverter.poundsToKilograms( wgt );
					
					if (hgtInMeterSq1 > 0)
					{
						BMI =  int( ( kg / hgtInMeterSq1)* 100 ) / 100;
					}
					else
						BMI = 0;					
				}
				else
				{
					m                     	 = UnitConverter.centimetersToMeters( hgt );
					
					var hgtInMeterSq2:Number = Math.pow( m , 2);
					
					if (hgtInMeterSq2 > 0)
						BMI = int(( wgt / hgtInMeterSq2 ) * 100 ) / 100;
					else
						BMI = 0;
					
				}
				
				if (isNaN(BMI))
					BMI = 0;
				
				/* return BMI.toString(); */
			}
			
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			private function onMouseOver():void
			{
				id_Header.setStyle('backgroundColor', 0xFFD08F);
			}
			private function onMouseOut():void
			{
				id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xC5D1DA : 0xFFFFFF);
			}
			
			
			public function deselectAllButton():void
			{
				id_listBtnBar.deselectAllButton();
			}
			
			public function get listButtonBar():HistoryListButtons
			{
				
				return id_listBtnBar;
			}
			
		]]>
	</fx:Script>
	
	
	<s:states>
		<s:State name="normal" />
		<s:State name="hovered" />
	</s:states>
	
	<s:BorderContainer id="id_Header" 
					   width="100%" height="100%" 
					   useHandCursor="true" buttonMode="true"  borderVisible="false" 
					   mouseOver="onMouseOver()" mouseOut="onMouseOut()"
					   >
		
		<s:layout>
			<s:HorizontalLayout gap="1" paddingLeft="3" paddingBottom="3" paddingTop="3"  verticalAlign="middle"/>
		</s:layout>
		
		<s:VGroup width="80%" toolTip="{'Temp: ' + data.Temperature +'F'}">
			<s:HGroup width="100%" >
			<s:Label width="100%" 
					 text="{'Temp: ' + data.Temperature +'F'}"
					 maxDisplayedLines="1" 
					 showTruncationTip="true"
					 fontSize="14"
					 color="0x333333"
					 fontFamily="CalibriCFFBold"  
					 />
			<s:Label width="100%" 
					 text="{'BP: ' + data.BPSys +'/' + data.BPDys}"
					 maxDisplayedLines="1" 
					 showTruncationTip="true"
					 fontSize="14"
					 color="0x333333"
					 fontFamily="CalibriCFFBold"  
					 />
			
				</s:HGroup>
			
			<s:Label width="100%" 
					 text="{'BMI: ' + BMI }"
					 color="0x666666"
					 showTruncationTip="true"
					 maxDisplayedLines="1"/>
		</s:VGroup>
		
		<s:Line height="100%">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		
		<s:Group right="0" width="70">
			<views:HistoryListButtons id="id_listBtnBar" width="100%" data="{data}" itemrenderer="{this}" />
		</s:Group>
	</s:BorderContainer>
	
</s:ItemRenderer>
