			<s:DropShadowFilter alpha="0.5" angle="0" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Path>
	<s:RichText  id="labelDisplay" color="#FFFFFF" typographicCase.upAndSelected="uppercase" typographicCase.overAndSelected="uppercase" color.up="#000000" fontSize="12" text="" x="10" y="{rect1.height / 3}"  fontFamily="Calibri" fontFamily.upAndSelected="Calibri Bold" fontFamily.overAndSelected="Calibri Bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" alpha.up="0" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
