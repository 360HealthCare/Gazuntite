	</s:states>
	<s:Rect minHeight="21" maxHeight="30" height="100%" id="rect1" includeIn="disabled,over,up,upAndSelected" visible.upAndSelected="false" minWidth="110" width="100%" x="0.5" y="0.5" visible.over="false">
