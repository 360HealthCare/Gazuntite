<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="23" radiusX="2" visible.disabled="false" visible.up="false" width="23" x="0.5" y="0.5">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1" color="#727272" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#727272" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" includeIn="down" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="false" source="@Embed('/assets/Bar_Dictation.png')" x="6" y="6">
		<s:filters>
			<s:GlowFilter blurX="10" blurY="10" color.up="#111111" color="#ffffff" inner="true" strength="10" alpha="1.0" quality="2" knockout="false"/>
			<s:DropShadowFilter includeIn="over" blurX="0" blurY="0" distance="1" hideObject="false" color="#FFFFFF" inner="false" strength="1" alpha="0.25" quality="2" knockout="false" angle="90"/>
			<s:GlowFilter includeIn="down" blurX="10" blurY="10" color="#ffffff" inner="true" strength="10" alpha="1.0" quality="2" knockout="false"/>
			<s:DropShadowFilter includeIn="down" blurX="0" blurY="0" distance="1" hideObject="false" color="#FFFFFF" inner="false" strength="1" alpha="0.25" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
