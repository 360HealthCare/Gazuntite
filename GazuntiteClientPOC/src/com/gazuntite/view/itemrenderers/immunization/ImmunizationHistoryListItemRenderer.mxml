<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				width="100%" 
				height="100%">
	
	<s:layout>
		<s:VerticalLayout paddingBottom="0"
						  paddingRight="0"
						  paddingTop="0"
						  paddingLeft="0"
						  gap="1"/>
	</s:layout>
	
	<s:Group width="100%" height="100%">
		
		<s:layout>
			<s:HorizontalLayout paddingBottom="2"
								paddingRight="2"
								paddingTop="2"
								paddingLeft="2"
								gap="3"
								verticalAlign="middle"/>
		</s:layout>
		
		<s:VGroup width="100%" gap="1">
			<s:Label fontWeight="bold" text="{data.immunization}" maxDisplayedLines="-1"/>
			<s:Label fontSize="10" text="{data.associatedWith}"/>
		</s:VGroup>
		
		<s:Label text="{data.dose}"/>
		
		<s:Image source="assets/itemLevelNote.png"
				 visible="{data.notesTxt != ''}"/>
		<s:Image source="assets/itemLevelDictation.png"
				 visible="{data.dictationPath != ''}"/>
		
	</s:Group>
	
	<s:Line width="100%">
		<s:stroke>
			<s:SolidColorStroke color="#8e8f91" weight="1"/>
		</s:stroke>
	</s:Line>
	
	
	
</s:ItemRenderer>
