<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:controls="com.gazuntite.view.controls.*"
					  xmlns:spicefactory="http://www.spicefactory.org/parsley"
					  xmlns:dictation="com.gazuntite.view.dictation.*" 
					  width="25" 
					  width.down="500"
					  height="85%" 
					  creationComplete="init(event)">
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.view.LiveProviderServiceView;
			import com.gazuntite.events.CloseSlideoutEvent;
			import com.gazuntite.events.DisplayNotesAndDictationEvent;
			import com.gazuntite.skins.TabBarSkin;
			
			import mx.events.EffectEvent;
			import mx.events.FlexEvent;
			
			protected var l:LiveProviderServiceView;
			
			[Bindable]
			protected var _labelText:String;
			
			[Bindable]
			protected var open:Boolean = false;
			
			public function get labelText():String
			{
				return _labelText;
			}
			
			public function set labelText(value:String):void
			{
				_labelText = value;
			}
			
			// fill the entire coverflow
			protected function createSubviews():void
			{
				
			}
			
			public function checkState():void
			{
				if(open == true)
				{
					open = false;
					this.currentState = "normal";
					
				}else
				{
					open = true;
					this.currentState = "down";
					
				}
				
			}
			
			protected function init(event:FlexEvent):void
			{
				
			}
			
			protected function handleOpenEffectEnd(event:EffectEvent):void
			{
				// only init child views when needed to save memory and performance
				createSubviews();
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				// save note or dictation
				//this.closeDropDown();
			}
			
			[MessageHandler]
			public function handleCloseSlideout(event:CloseSlideoutEvent):void
			{
				
				if(open)
				{
					open = false;
					this.currentState = "normal";
				}
				
			}
			
			
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
	</fx:Declarations>
	
	<s:transitions>
		<s:Transition fromState="normal" 
					  toState="down">
			<s:Parallel duration="200" 
						effectEnd="handleOpenEffectEnd(event)">
				<s:Resize target="{this}"/>
			</s:Parallel>
		</s:Transition>
		<s:Transition fromState="down" 
					  toState="normal">
			<s:Parallel duration="350">
				<s:Resize target="{this}"/>
			</s:Parallel>
		</s:Transition>
	</s:transitions>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="down"/>
	</s:states>
	
	<s:filters>
		<s:DropShadowFilter alpha="0.32" distance="6" />
	</s:filters>
	
	<s:VGroup id="mediaGroup" 
			  excludeFrom="normal"
			  paddingLeft="10"
			  paddingTop="10"
			  paddingRight="30"
			  paddingBottom="10"
			  width="80%"
			  height="100%">
		
		
		<s:Label text="Add a note"
				 styleName="vbTitle"/>
		<controls:Notes id="notes" 
						width="100%" />
		
		<s:Spacer height="20"/>
		
		<s:Label text="Add a dictation"
				 styleName="vbTitle"/>
		<dictation:Dictation id="dictation" 
							 width="100%" 
							 height="100%"/>
		
		<!--<s:HGroup>
		<s:Button label="Save" 
		styleName="button"
		click="button1_clickHandler(event)"/>
		
		<s:Button label="Close" 
		styleName="button"
		click="{this.closeDropDown()}"/>
		</s:HGroup>-->
		
		
	</s:VGroup>
	
</s:SkinnableContainer>
