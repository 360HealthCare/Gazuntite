<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:sf="http://www.spicefactory.org/parsley"
					  width="100%" height="100%"
					  visible="{sharedModel.doctorStatusVisible}"
					  includeInLayout="{sharedModel.doctorStatusVisible}"
					  creationComplete="init(event)"
					  skinClass="com.gazuntite.skins.DoctorStatusBlueCalloutBG" 
					  xmlns:callouts="com.gazuntite.view.controls.callouts.*">
	
	<fx:Metadata>
		[ManagedEvents("doctorStatusChangeEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.DoctorStatusChangeEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			[Inject(id="sharedModel")]
			public var sharedModel:SharedModel = new SharedModel();
			
			protected function init(event:FlexEvent):void
			{
				/* if(sharedModel.doctorStatus != "")
				{
				setIcons(sharedModel.doctorStatus);
				} */
				addEventListener(MouseEvent.CLICK, handleMouseClick);
			}
			
			protected function handleMouseClick(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
				event.stopPropagation();
			}
			
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<sf:Configure/>
		<sf:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout paddingBottom="5" 
						  paddingLeft="10" 
						  paddingRight="10" 
						  paddingTop="5"/>
	</s:layout>
	
	<callouts:StatusView width="100%"/>
	
	<s:Button width="100%" 
			  toolTip="Sign Out"
			  buttonMode="true"
			  useHandCursor="true"
			  label="SIGN OUT" 
			  height="24"
			  color="0xffffff"
			  chromeColor="0x2b323b"/>
	
</s:SkinnableContainer>
