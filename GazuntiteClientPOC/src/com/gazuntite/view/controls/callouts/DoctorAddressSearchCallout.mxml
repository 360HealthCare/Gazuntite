							 ipeSelectionChanged="ipecalloutlabeltext1_ipeSelectionChangedHandler(event)">
		
		<ipe:dataProvider>
			<s:ArrayCollection>
				<fx:Object address="95 South Main St."/>
				<fx:Object address="123 Somewhereland"/>
				<fx:Object address="456 Somewhereland"/>
			</s:ArrayCollection>
		</ipe:dataProvider>
	</ipe:IPECalloutLabelText>-->
	
	<callouts:StatusView width="100%"  
						 right="200"
						 top="80"/>

	
	<s:Button width="100%" 
			  label="SIGN OUT" 
			  toolTip="Sign Out"
			  height="24"
			  buttonMode="true"
			  useHandCursor="true"
			  color="0xffffff"
			  chromeColor="0x2b323b"/>
	
</s:SkinnableContainer>