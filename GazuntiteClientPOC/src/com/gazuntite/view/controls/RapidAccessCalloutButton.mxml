<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="init(event)"
		 width="100%"
		 height="100%"
		 maxWidth="130">
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			protected var dp:ArrayCollection = new ArrayCollection([
				{name:"Notifications", img:"rapidAccessNotifications.png"},
				{name:"Refill Notes", img:"rapidAccessRefillNotes.png"},
				{name:"Labs", img:"rapidAccessLabs.png"},
				{name:"Patient Registration", img:"rapidAccessPatientRegistration.png"}]);
			
			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function list_changeHandler(event:IndexChangeEvent):void
			{
				myCB.closeDropDown();
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	
	<s:CalloutButton id="myCB" 
					 horizontalPosition="middle"
					 verticalPosition="after"
					 skinClass="com.gazuntite.skins.RapidAccessCalloutButtonSkin">
		<s:calloutLayout>
			<s:VerticalLayout horizontalAlign="center"/>
		</s:calloutLayout>
		
		<s:List id="list" 
				width="200"
				change="list_changeHandler(event)" 
				dataProvider="{dp}" 
				contentBackgroundColor="0x000000"
				itemRenderer="com.gazuntite.view.itemrenderers.RapidAccessItemRenderer"/>
		
	</s:CalloutButton>
	
</s:Group>
