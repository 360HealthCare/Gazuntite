<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:spicefactory="http://www.spicefactory.org/parsley"  
					  width="100%" height="100%"
					  backgroundColor="0x000000"
					  creationComplete="init(event)">
	
	<fx:Metadata>
		[ManagedEvents("login")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.LoginEvent;
			import com.gazuntite.model.SharedModel;
			import com.gazuntite.services.valueObjects.provider.ProviderDTO;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.collections.XMLListCollection;
			import mx.events.FlexEvent;
			
			[Bindable]
			[Inject(id="sharedModel")]
			public var sharedModel:SharedModel = new SharedModel();
			
			[Bindable]
			public var forgotPasswordString:String="<font color='#ffffff'><a href='#'>Forgot Password</a></font>";
			
			
			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
			protected function loginClickHandler(event:MouseEvent):void
			{
				var e:LoginEvent = new LoginEvent(LoginEvent.LOGIN);
				
				if( CheckLogin( UtilityFunctions.TrimString( userNameTxt.text ),  UtilityFunctions.TrimString( passwordTxt.text ) ) )
				{
					// login successful
					e.success = true;
					sharedModel.providerLoggedIn = true;
				}else
				{
					// login failed, fire event
					e.success = false;
				}
				
				dispatchEvent(e);
			}
			
			private function CheckLogin(userName:String, password:String):Boolean
			{
				
				
				for each(var provider:ProviderDTO in sharedModel.providerList.AllProviders)
				{
					var UserEmail:String 	= provider.UserEmail;
					var UserPassword:String = provider.Password;
					if( UserEmail == userName )
					{
						if(UserPassword == password)
						{
							sharedModel.updateModel( provider );
							
							trace(sharedModel.doctorEmail);
							invalidGroup.visible = false;
							return true;
						}
					}
					trace("User Name: " + UserEmail);
					trace("UserPassword: " + UserPassword); 
				}
				
				//UtilityFunctions.ShowMessage( "Invalid Provider Id/Password...", "Invalid Login!");
				invalidGroup.visible = true;
				return false;
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout horizontalAlign="center" 
						  verticalAlign="top"/>
	</s:layout>
	
	<s:Spacer height="40%"/>
	
	<s:Image source="assets/loginScreenLogo.png"/>
	
	<s:Spacer height="20%"/>
	
	<s:SkinnableContainer skinClass="com.gazuntite.skins.LoginBlueBGSkin" 
						  verticalCenter="0" 
						  horizontalCenter="0"
						  width="400"
						  height="220">
		
		<s:layout>
			<s:VerticalLayout horizontalAlign="center" 
							  verticalAlign="middle"/>
		</s:layout>
		
		<s:SkinnableContainer id="invalidGroup" 
							  visible="false"
							  width="70%" 
							  height="40"
							  skinClass="com.gazuntite.skins.InvalidProviderIDSkin">
			
			<s:layout>
				<s:HorizontalLayout paddingLeft="10" 
									paddingRight="10"
									horizontalAlign="left" 
									verticalAlign="middle"/>
			</s:layout>
			
			<s:Image source="assets/redX.png" />
			
			<s:Label text="Invalid ProviderID" 
					 styleName="loginFormInvalidProviderID"
					 width="100%"/>
			
			<s:RichEditableText id="richTxt" 
								editable="false" 
								focusEnabled="false">
				<s:textFlow>
					<s:TextFlow>
						<s:p>
							<s:a href="#">
								<s:span color="0xffffff" fontSize="12">Forgot Password</s:span>
							</s:a>
						</s:p>
					</s:TextFlow>
				</s:textFlow>
			</s:RichEditableText>
			
		</s:SkinnableContainer>
		
		
		
		<s:Label text="Provider ID" styleName="loginFormTitle"/>
		<s:TextInput id="userNameTxt"
					 width="60%"
					 height="28" 
					 text="tamjeed.hassan@zigron.com"
					 skinClass="com.gazuntite.skins.TextInputSkin"/>
		
		<s:Label text="Password" styleName="loginFormTitle"/>
		<s:TextInput id="passwordTxt"
					 width="60%" 
					 height="28"
					 text="gazuntite123"
					 displayAsPassword="true"
					 skinClass="com.gazuntite.skins.TextInputSkin"/>
		
		<s:Button label="Sign In"
				  color="0xffffff"
				  fontWeight="bold"
				  chromeColor="0x000000"
				  width="100"
				  height="32"
				  click="loginClickHandler(event)"/>
		
	</s:SkinnableContainer>
	
	<s:Spacer height="100%"/>
	
	
</s:SkinnableContainer>