<?xml version="1.0" encoding="utf-8"?>
<dualpanel:DualPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:dualpanel="com.riavalue.components.dualpanel.*" 
					  xmlns:components="com.gazuntite.components.*"
					  width="100%"
					  height="100%"
					  transitionDuration="300"
					  skinClass="com.riavalue.components.dualpanel.SpinSkin"
					  creationComplete="init(event)" 
					  xmlns:forms="com.gazuntite.view.quickInput.forms.*" 
					  xmlns:input="com.gazuntite.view.controls.custom.patientExamView.quickInput.immunization.input.*" 
					  xmlns:controls="com.gazuntite.view.controls.*" 
					  xmlns:skins="com.gazuntite.skins.*" 
					  xmlns:spicefactory="http://www.spicefactory.org/parsley" 
					  xmlns:chiefComplaint="com.gazuntite.view.quickInput.forms.chiefComplaint.*">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.view.controls.Dictation;
			import com.gazuntite.view.itemrenderers.chiefComplaint.ChiefComplaintIRComplaint;
			import com.gazuntite.view.itemrenderers.immunization.AssociatedWithFieldItemRenderer;
			import com.gazuntite.view.itemrenderers.immunization.DoseFieldItemRenderer;
			import com.gazuntite.view.itemrenderers.immunization.ImmunizationFieldItemRenderer;
			import com.gazuntite.events.ArrangeByEvent;
			import com.gazuntite.events.OptionsButtonClickedEvent;
			import com.gazuntite.events.PinViewEvent;
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.events.ToggleFormOptionsEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.collections.ArrayCollection;
			import mx.collections.Sort;
			import mx.controls.Alert;
			import mx.controls.List;
			import mx.events.EffectEvent;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			import mx.validators.Validator;
			
			import spark.collections.SortField;
			import spark.components.Scroller;
			import spark.components.supportClasses.ListBase;
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			protected var selectedRecord:int;
			
			[Bindable]
			protected var editObject:ObjectProxy;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			protected function init(event:FlexEvent):void
			{
				this.currentState = "normal";
				
				this.prefsButton.addEventListener(MouseEvent.CLICK, handlePrefsButtonClick);
			}
			
			protected function handlePrefsButtonClick(event:MouseEvent):void
			{
				
				if(sharedModel.addedChiefComplaintsAC.length > 0)
				{
					editObject = list.selectedItem as ObjectProxy;
				}
				
				if(editObject == null)
				{
					if(sharedModel.chiefComplaintHistoryAC.length > 0)
					{
						editObject = sharedModel.chiefComplaintHistoryAC.getItemAt(0) as ObjectProxy;
					}
				}
				
				resetState();
			}
			
			protected function resetState():void
			{
				trace("start: " + this.currentState);
				
				if(this.currentState == "normal")
				{
					this.currentState = "normalFlipped";
					invalidateDisplayList();
					return;
				}
				
				if(this.currentState == "normalFlipped")
				{
					this.currentState = "normal";
					invalidateDisplayList();
					return;
				}
			}
			
			protected function list_changeHandler(event:IndexChangeEvent):void
			{
				editObject = list.selectedItem;
				
				selectedRecord = list.selectedIndex;
				
				toggleStateHandler();
				
				resetState();
			}
			
			protected function detailList_changeHandler(event:IndexChangeEvent):void
			{
				editObject = detailList.selectedItem;
			}
			
			
			protected function toggleFormOptionsHandler(event:ToggleFormOptionsEvent):void
			{
				
				if(this.currentState == "fullForm")
				{
					this.currentState = "normal";
					return;
				}
				
				if(event.full && this.currentState == "normal")
				{
					this.currentState = "fullForm";	
					return;
				}
				
			}
			
			protected function saveFormDataHandler(event:SaveFormDataEvent):void
			{
				if(event.payload != null)
				{
					if(event.isUpdate)
					{
						// save updated form item
						/* var i:int = list.selectedIndex;
						sharedModel.chiefComplaintHistoryAC.setItemAt(event.payload, i);
						editObject = sharedModel.chiefComplaintHistoryAC.getItemAt(i) as ObjectProxy; */
					}else
					{
						sharedModel.addedChiefComplaintsAC.addItem(event.payload);
						sharedModel.chiefComplaintHistoryAC.addItem(event.payload);
					}
					
				}
				
				invalidateDisplayList();
				
			}
			
			protected function updateEditObject():void
			{
				editObject = detailList.selectedItem;
			}
			
			protected function optionsButtonClickedHandler(event:OptionsButtonClickedEvent):void
			{
				
			}
			
			protected function pinBtnClickHandler(event:MouseEvent):void
			{
				var e:PinViewEvent = new PinViewEvent(PinViewEvent.PIN_VIEW_EVENT, true);
				dispatchEvent(e);
			}
			
			
			protected function arrangebycalloutbutton1_arrangeByHandler(event:ArrangeByEvent):void
			{
				//trace(event.field);
				
				var l:ListBase;
				
				if(this.currentState == "normal")
				{
					l = list;
				}else
				{
					l = detailList;
				}
				
				switch(event.field)
				{
					case "Chief Complaint":
						l.itemRenderer = new ClassFactory(ChiefComplaintIRComplaint);
						break;
				}
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<dualpanel:states>
		<s:State name="normal"/>
		<s:State name="normalFlipped"/>
	</dualpanel:states> 
	
	<!-- dual panel views -->
	
	<dualpanel:frontView>
		<controls:CoverFlowPanelView id="frontPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Chief Complaint: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 optionsButtonClicked="optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				<chiefComplaint:QIChiefComplaintMobileForm includeIn="normal"
														   id="chiefComplaintForm"
														   width="100%"
														   saveFormData="saveFormDataHandler(event)"/>
				
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
					<controls:ArrangeByCalloutButton label="Arrange By:"
													 color="0x000000"
													 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
						<controls:dataProvider>
							<s:ArrayCollection>
								<fx:Object name="Chief Complaint"/>
							</s:ArrayCollection>
						</controls:dataProvider>
					</controls:ArrangeByCalloutButton>
					
					<s:Label text="Chief Complaint records added:" styleName="listLabel"/>
					
				</s:BorderContainer>
				
				<s:List id="list"
						width="100%"
						height="100%"
						dataProvider="{sharedModel.addedChiefComplaintsAC}"
						itemRenderer="com.gazuntite.view.itemrenderers.chiefComplaint.ChiefComplaintIRComplaint"/>
				
				
			</s:BorderContainer>
			
			
			
		</controls:CoverFlowPanelView>
		
	</dualpanel:frontView>
	
	<!-- Back view dual panel -->
	
	<dualpanel:backView>
		<controls:CoverFlowPanelView id="backPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Chief Complaint History: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 optionsButtonClicked="optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				<chiefComplaint:QIChiefComplaintMobileHistoryForm includeIn="normalFlipped"
																  id="chiefComplaintFormFlipped"
																  width="100%"
																  selectedRecord="{editObject}"
																  saveFormData="saveFormDataHandler(event)"/>
				
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
					<controls:ArrangeByCalloutButton label="Arrange By:"
													 color="0x000000"
													 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
						<controls:dataProvider>
							<s:ArrayCollection>
								<fx:Object name="Chief Complaint"/>
							</s:ArrayCollection>
						</controls:dataProvider>
					</controls:ArrangeByCalloutButton>
					
					<s:Label text="Chief Complaint history records:" styleName="listLabel"/>
					
				</s:BorderContainer>
				
				<s:List id="detailList"
						width="100%"
						height="100%"
						change="detailList_changeHandler(event)"
						dataProvider="{sharedModel.chiefComplaintHistoryAC}"
						itemRenderer="com.gazuntite.view.itemrenderers.chiefComplaint.ChiefComplaintIRComplaint"/>
				
				
			</s:BorderContainer>
			
			
			
		</controls:CoverFlowPanelView>
	</dualpanel:backView>
	
</dualpanel:DualPanel>
