<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:sf="http://www.spicefactory.org/parsley"
					  width="100%" height="100%"
					  backgroundColor="0x000000"
					  creationComplete="init(event)" 
					  xmlns:controls="com.gazuntite.view.controls.*">
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			[Inject(id="sharedModel")]
			public var sharedModel:SharedModel = new SharedModel();
			
			protected function init(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<sf:Configure/>
		<sf:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	
	<s:BorderContainer width="100%"
					   height="24"
					   borderWeight="0" 
					   cornerRadius="0" 
					   dropShadowVisible="true"
					   borderAlpha="0">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xdadada" ratio=".1"/>
				<s:GradientEntry color="0xbfbfbf" ratio=".9"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle"
								horizontalAlign="center"
								paddingLeft="10"
								paddingRight="10"/>
		</s:layout>
		
		
		<s:HGroup width="100%" 
				  gap="0"
				  horizontalAlign="left"
				  verticalAlign="middle">
			<s:Button skinClass="com.gazuntite.skins.BrowserLeftArrowButtonSkin"/>
			<s:Button skinClass="com.gazuntite.skins.BrowserRightArrowButtonSkin"/>
			<s:Label text="{sharedModel.searchEngineTitle}" styleName="hudViewTitle"/>
		</s:HGroup>
		
		<controls:TextInputIcon id="searchTxt" 
								width="270"
								clearTextInput="{searchTxt.text = ''}"
								iconPath="assets/textInputSearchIcon.png"
								skinClass="com.gazuntite.skins.TextInputIconSkin"/>
		
		<s:HGroup width="100%"
				  horizontalAlign="right">
			<s:Button skinClass="com.gazuntite.skins.BlackArrowSmallSkin"/>
		</s:HGroup>
		
	</s:BorderContainer>
	
	
	<mx:HTML id="htmlBrowser" location="http://www.google.com" width="100%" height="100%"/>
	
	
	
</s:SkinnableContainer>