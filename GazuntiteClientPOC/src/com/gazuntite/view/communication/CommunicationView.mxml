<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:spicefactory="http://www.spicefactory.org/parsley"  
					  xmlns:providerComm="com.gazuntite.view.communication.providerComm.*" 
					  xmlns:local="*" 
					  xmlns:ns="library://ns.tink.ws/flex/spark" 
					  xmlns:view="com.zigron.provider.services.email.view.*" 
					  xmlns:view1="com.zigron.provider.services.sms.view.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:containers="spark.tink.containers.*" 
					  xmlns:view2="com.gazuntite.view.*"
					  
					  width="100%" height="100%"
					  creationComplete="init(event)" 
					  >
	
	<fx:Metadata>
		[MangedEvents("changeView")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.ChangeViewEvent;
			import com.gazuntite.events.EndChatEvent;
			import com.gazuntite.model.SharedModel;
			import com.gazuntite.utils.UtilityFunctions;
			
			import labs.otuome.p2p.VideoChat;
			
			import mx.binding.utils.BindingUtils;
			import mx.collections.ArrayCollection;
			import mx.events.CollectionEvent;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			private var _sharedModel:SharedModel;
			private var _neighborhood:ArrayCollection;
			
			[Bindable]
			[Inject(id="sharedModel")]
			public var sharedModel:SharedModel = new SharedModel();
			
			[Bindable]
			public function get neighborhood():ArrayCollection
			{
				return _neighborhood;
			}
			
			public function set neighborhood(value:ArrayCollection):void
			{
				_neighborhood = value;
				
				if( value )
				{
					neighborhood.addEventListener(CollectionEvent.COLLECTION_CHANGE, onCollectionChange );
				}
			}
			
			protected function init(event:FlexEvent):void
			{
				UtilityFunctions.ShowMessage( sharedModel.selectedProvider.FullName + " being loged in", "Loging in" );
				id_chatComponent.Login( sharedModel.doctorEmail ); /// get actual email of the provider
				id_chatComponent.currentState = VideoChat.LOBBY;
				
				BindingUtils.bindProperty( this, "neighborhood", id_chatComponent, "neighborhood" ); 
				
				addEventListener( "startVideoChat", function(e:Event):void
				{
					var j:int;
					for(j = 0; j < neighborhood.length; j++ )
					{
						var selectedUser:Object = neighborhood.getItemAt( j );
						if( selectedUser.name == e.target.provider.UserEmail )
						{
							id_chatComponent.SendInvite( selectedUser );
							break;
						}
					}
				});
				
			}
			
			private function onCollectionChange(event:CollectionEvent):void
			{
				trace("onCollectionChange", neighborhood.length);
				
				id_searchname.updateNeighborHoodStatus( neighborhood );
			}
			
			[MessageHandler]
			public function onEndChat(event:EndChatEvent):void
			{
				
				id_chatComponent.LogOff();
				
			}
			
			
			[MessageHandler]
			public function changeView(event:ChangeViewEvent):void
			{
				switch(event.selectedView){
					case "profile":
						vs.selectedIndex = 0;
						break;
					case "email":
						vs.selectedIndex = 1;
						break;
					case "sms":
						vs.selectedIndex = 2;
						break;
					case "chat":
						vs.selectedIndex = 3;
						break;
					case "video":
						if( startVideoChat() && neighborhood && neighborhood.length )
						{
							vs.selectedIndex = 4;
							sharedModel.videoOn = true;
							dispatchEvent( new Event("startVideoChat", true ) );
						}
						else
						{
							UtilityFunctions.ShowMessage( sharedModel.selectedProvider.FullName + " is off-line", "user is off-line" );
						}
						break;
				}
			}
			
			
			private function startVideoChat():Boolean
			{
				if(	sharedModel.selectedProvider.UserEmail == sharedModel.doctorEmail )
				{
					//UtilityFunctions.ShowMessage( "You can't chat with your self", "select user" );
					return false;
				}
				else
				{
					return true;
				}
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout verticalAlign="top" gap="0"/>
	</s:layout>
	
	<s:BorderContainer width="100%"
					   height="24"
					   borderWeight="2"
					   borderColor="0xbbbbbb"
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="1">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xdadada" ratio=".1"/>
				<s:GradientEntry color="0xbfbfbf" ratio=".9"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle"
								horizontalAlign="center"
								paddingLeft="10"
								paddingRight="10"/>
		</s:layout>
		
		<s:HGroup width="100%"
				  horizontalAlign="left"
				  verticalAlign="middle">
			<s:Image source="assets/titleBarDots.png"/>
			<s:Label text="COMMUNICATION" styleName="hudViewTitle"/>
			
			<!-- put arrow and second part of header here -->
			<s:Image source="assets/profileHeaderArrow.png"/>
			
			<s:Label text="{sharedModel.profileSectionTitle}" styleName="hudViewBlueTitle"/>
			
		</s:HGroup>
		
	</s:BorderContainer>
	
	<!-- end top bar -->
	
	<s:HGroup width="100%" height="100%" gap="0" verticalAlign="top">
		
		<!-- side bar -->
		<providerComm:ProviderSearchName id="id_searchname" width="30%" height="100%"/>
		
		<s:VGroup width="100%" height="100%" gap="0">
			
			<view2:PatientHeaderBar width="100%" height="50"/>
			
			<ns:NavigatorGroup id="vs" width="100%" height="100%">
				<s:Group id="Profile" 
						 width="100%" 
						 height="100%">
					
					<providerComm:ProviderView height="100%" width="100%" />
					
					
				</s:Group>
				<s:Group id="Email" 
						 width="100%" 
						 height="100%">
					
					<view:CommunicationView height="100%" width="100%" EmailAddress="{sharedModel.doctorEmail}" userID="{sharedModel.doctorUserID}" />
					
					
				</s:Group>
				<s:Group id="SMS" 
						 width="100%" 
						 height="100%">
					
					<view1:SMSView height="100%" width="100%" />
					
					
				</s:Group>
				<s:Group id="Chat" 
						 width="100%" 
						 height="100%">
					
					<s:Label text="Chat group"/>
					
				</s:Group>
				<s:Group id="Video" 
						 width="100%" 
						 height="100%">
					
					<local:chatComponent id="id_chatComponent" width="100%" height="100%" ShowNeighborList="false"/>
					
				</s:Group>
				
			</ns:NavigatorGroup>
			<!--<mx:HTML id="id_WebView" location="http://quivus.com/QuivusAirDev/videochatstaging/Testhtmlpage.htm" width="40%" height="100%"/>-->
			
			
			<!--<local:chatComponent id="id_chatComponent" width="40%" height="100%" ShowNeighborList="true"/>-->
		</s:VGroup>
		
	</s:HGroup>
	
</s:SkinnableContainer>