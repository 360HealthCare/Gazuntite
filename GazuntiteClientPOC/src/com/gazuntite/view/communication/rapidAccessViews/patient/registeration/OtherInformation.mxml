			protected function comboChangeIndicator(event:IndexChangeEvent):void 
			{
				if(id_Race.selectedIndex >= 0 ||id_Ethenicity.selectedIndex >= 0 || id_Occupation.selectedIndex >= 0 || id_ExemptReport.selectedIndex >= 0 )
					hasChange= true;
				else
					hasChange= false;
			}
			
			protected function textInputChangeIndicator(event:TextOperationEvent):void 
			{
				if(id_OtherContactName.text.length>0 ||id_OtherContactName1.text.length >0 || id_Medicare.text.length >0 || id_Company.text.length>0 )
					hasChange= true;
				else
					hasChange= false;
				
				if(id_OtherContactName.text.length>0 )
				{
					id_MotherPhoneNumberAddmore.enabled = true;
					id_motherBtn.enabled 				= true;
				}
				else
				{
					id_MotherPhoneNumberAddmore.enabled = false;
					id_motherBtn.enabled 				= false;
				}
				
				
				if(id_OtherContactName1.text.length>0 )
				{
					id_FatherPhoneNumberAddmore.enabled = true;
					id_fatherBtn.enabled 				= true;
				}
				else
				{
					id_FatherPhoneNumberAddmore.enabled = false;
					id_fatherBtn.enabled 				= false;
				}
			}
			
			private var _isChanged:Boolean;
			[Bindable]
			public function get isChanged():Boolean
			{
				return _isChanged;
			}
			
			public function set isChanged(value:Boolean):void
			{
				_isChanged = value;
				
				if(id_MotherPhoneNumberAddmore.haschange || id_FatherPhoneNumberAddmore.haschange || id_LanguageAddMore.haschange)
					hasChange = true;
				else
					hasChange = false;
			}
