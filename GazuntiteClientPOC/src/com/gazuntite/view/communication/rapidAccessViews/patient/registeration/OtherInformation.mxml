			private function clearAllPopUps():void
			{
				if (motherPhoneNumberAddMorePopUp)
					motherPhoneNumberAddMorePopUp.clearPopUp();
				
				if (fatherPhoneNumberAddMorePopUp)
					fatherPhoneNumberAddMorePopUp.clearPopUp();
				
				if (languageAddMorePopUp)
					languageAddMorePopUp.clearPopUp();
			}
			
			public function hideAllPopUps():void
			{
				if (motherPhoneNumberAddMorePopUp)
					motherPhoneNumberAddMorePopUp.visible = false;
				
				if (fatherPhoneNumberAddMorePopUp)
					fatherPhoneNumberAddMorePopUp.visible = false;
				
				if (languageAddMorePopUp)
					languageAddMorePopUp.visible = false;
				// hide others as well, if is there any
			}
			
			public function showAllPopUps():void
			{
				if (motherPhoneNumberAddMorePopUp && motherPhoneNumberAddMorePopUp.isAddPhoneNumberPopUpShown)
					motherPhoneNumberAddMorePopUp.visible = true;
				
				if (fatherPhoneNumberAddMorePopUp && fatherPhoneNumberAddMorePopUp.isAddPhoneNumberPopUpShown)
					fatherPhoneNumberAddMorePopUp.visible = true;
				
				if (languageAddMorePopUp && languageAddMorePopUp.isPopUpShown)
					languageAddMorePopUp.visible = true;
				//show all other popups as well, if is there any
			}
			
