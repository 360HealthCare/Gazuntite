			private function AddMorePhoneNumbers(event:Event):void
			{
				personalPhoneNumbers = new ArrayCollection();
				
				if (!personalPhoneNumbers.length)
				{
					var result:Object = id_PhoneNumberAddMore.isInValid(true);
					if (result.hasOwnProperty("isNotValid") && result.isNotValid)
					{
						if (result.hasOwnProperty("errorStr") && result.errorStr)
						{
							Alert.show(result.errorStr, "Phone number entry error", 4, FlexGlobals.topLevelApplication.mainContainer, function():void
							{
								if (result.hasOwnProperty("toSetFocus") && result.toSetFocus)
									result.toSetFocus.setFocus();
							});
						}
						Alert.show('Please complete all mandatory phone fields','Info');
						return;
					}
					personalPhoneNumbers.addItem(id_PhoneNumberAddMore.getPhoneNumberDetails());
				}
				
				if (!phoneNumberAddMorePopUp)
					phoneNumberAddMorePopUp = new PhoneNumberAddMoreTitleWindow();
				
				// Add all other phone numbers into add more phone popup
				/* if(model.patientProfileDTO)
				{
					if(model.patientProfileDTO.PatientAddressBook)
					{
						if(model.patientProfileDTO.PatientAddressBook.PhoneDTOlist)
						{
							if(model.patientProfileDTO.PatientAddressBook.PhoneDTOlist.length >0 )
							{
								for(var p:uint=1; p<model.patientProfileDTO.PatientAddressBook.PhoneDTOlist.length; p++)
								{
									var phoneDTO:PhoneDTO = model.patientProfileDTO.PatientAddressBook.PhoneDTOlist.getItemAt(p) as PhoneDTO;
									if(phoneDTO.OwnerTypeID == Constants.SELF_OWNER_TYPE_ID)
									{
										var obj:Object 						= new Object();
										var obj2:PhoneNumberTypeDTO			= new PhoneNumberTypeDTO();
										obj.phoneNumber 					= phoneDTO.PhoneNumber;
										obj2.NumberTypeName					= phoneDTO.NumberTypeName;
										obj2.NumberTypeID					= phoneDTO.NumberTypeID;
										obj.phoneNumberKind					= obj2;
										obj.phoneExtension 					= phoneDTO.Extension;
										obj.phoneID 						= phoneDTO.PhoneID;
										personalPhoneNumbers.addItem(obj);
									}
								}
							}
						}
					}
				} */
				
				if (!phoneNumberAddMorePopUp.phoneNumbers)
					phoneNumberAddMorePopUp.phoneNumbers = personalPhoneNumbers;
				
				var btn:spark.components.Button = spark.components.Button(event.currentTarget);
				var pt:Point = btn.parent.localToGlobal(new Point(btn.x, btn.y));
				pt.x += btn.width/2 - 100;
				pt.y += btn.height;
				phoneNumberAddMorePopUp.display(this, pt);
				phoneNumberAddMorePopUp.id_PhoneNumberAddMore.id_TelNumber.setFocus();
			}
			
