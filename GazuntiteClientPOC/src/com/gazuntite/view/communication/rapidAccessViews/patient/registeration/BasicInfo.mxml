			protected function UploadImage_clickHandler(event:MouseEvent):void
			{
				var fileTypes:FileFilter = new FileFilter( "Image Files", "*.gif;*.jpeg;*.jpg;*.png" );
				fileToOpen.browse([fileTypes]);
				fileToOpen.addEventListener(Event.SELECT, fileSelected);
			}
			
			private function fileSelected(event:Event):void
			{
				var stream:FileStream = new FileStream(); // open filestream
				stream.open(fileToOpen, FileMode.READ); // open the file
				var size_500K:Number = 500 * 1024;
				if (stream.bytesAvailable <= size_500K)
				{
					m_oImageContent = new ByteArray();
					stream.readBytes( m_oImageContent, 0, stream.bytesAvailable ); // read file
					stream.close(); // close file
					model.patientRegImageDTO 				= new ImageDTO();
					model.patientRegImageDTO.UserTypeID 	= Constants.PATIENT_USER_TYPE_ID;
					model.patientRegImageDTO.ImageTypeId 	= model.profileImageTypeDTO.ImageTypeId;
					model.patientRegImageDTO.CreatedAt 		= new Date();
					model.patientRegImageDTO.CreatedBy		= model.loggedInUserDTO.UserId;
					model.patientRegImageDTO.ImageName 		= fileToOpen.name;
					model.patientRegImageDTO.ImageData 		= AppUtils.getBase64String(m_oImageContent);
				}
				else
				{
					Alert.show("Image size can not be greater than 500k.\n", "Image size error", 4, FlexGlobals.topLevelApplication.mainContainer, function():void
					{
						id_UploadImage.setFocus();
					});
				}
				id_ProfileImage.source =  m_oImageContent;
			} 
			
			public function isInvalid() : Boolean 
			{
				var isNotValid:Boolean = false;
				
				ValidationUtils.Trim( id_FName );
				ValidationUtils.Trim( id_MName );
				ValidationUtils.Trim( id_LName );
				ValidationUtils.Trim(id_Address);
				ValidationUtils.Trim(id_email);
				
				var errorStr:String = ""; 
				var toSetFocus:Object;
				//Type > String, max length >20, Required > OPtional
				if (id_Prefix.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_Prefix))
				{
					isNotValid = true;
					errorStr += "The data in prefix is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = id_Prefix;
				}
				//Type > varchar, max length >100, Required > Yes
				if (id_FName.text.length >= 1 && id_FName.text.length <= 100)
				{
					if (!ValidationUtils.isValidAlphaNumericWithSpaces(id_FName.text))
					{
						isNotValid = true;
						errorStr += "The data in first name is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_FName;
					}
				}
				else
				{
					isNotValid = true;
					errorStr += "Please enter data in first name.\n";
					
					if (!toSetFocus)
						toSetFocus = id_FName;
				}
				//Type > varchar, max length >30, Required > Optional
				if (id_MName.text.length >0)
				{
					
					if(!ValidationUtils.isValidAlphaNumericWithSpaces1(id_MName.text))
					{
						isNotValid = true;
						errorStr += "The data in middle name is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_MName;
					}
				}
				//Type > varchar, max length >100, Required > Yes
				if (id_LName.text.length >= 1 && id_LName.text.length <= 100)
				{
					if (!ValidationUtils.isValidAlphaNumericWithSpaces2(id_LName.text))
					{
						isNotValid = true;
						errorStr += "The data in last name is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_LName;
					}
				}
				else
				{
					isNotValid = true;
					errorStr += "Please enter data in last name.\n";
					
					if (!toSetFocus)
						toSetFocus = id_LName;
				}
				
				//Type > Numaric, max length >30, Required > Yes
				if(id_DOB.selectedDate)
				{
					if (!ValidationUtils.isValidDate(id_DOB))
					{
						isNotValid = true;
						errorStr += "The data in date of birth is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_DOB;
					}
				}else if(id_DOB.text.length > 0)
				{
					if(!ValidationUtils.isValidDateFormat(formatDateTime.format(id_DOB.text)))
					{
						isNotValid = true;
						errorStr += "The data in date of birth is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_DOB;
					}
					
				}
				//Type > String, max length >20, Required > Yes
				if (!ValidationUtils.isValidValueSelected(id_Gender))
				{
					isNotValid = true;
					errorStr += "The data in gender is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = id_Gender;
				}
				//Type > String, max length >100, Required > OPtional
				if (id_MeritalStaus.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_MeritalStaus))
				{
					isNotValid = true;
					errorStr += "The data in merital status is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = id_MeritalStaus;
				}
				//Type > Varchar, max length >100, Required > OPtional
				if( id_Address.text.length == 0 || id_Address.text.length > 100)
				{
					errorStr += "The data in address is invalid.\n";
					isNotValid = true;
					
					if (!toSetFocus)
						toSetFocus = id_Address;
				}
				//Type > Varchar, max length >100, Required > OPtional
				//if (id_State.textInput.text.length < 0 || id_State.selectedIndex == -1)
				if (!ValidationUtils.isValidState(id_ZipCityStateCombine.id_State))
				{
					isNotValid = true;
					errorStr += "The data in state is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = id_ZipCityStateCombine.id_State;
				}
				//Type > Varchar, max length >100, Required > OPtional
				//if (id_City.textInput.text.length < 0 )
				if (!ValidationUtils.isValidCity(id_ZipCityStateCombine.id_City))
				{
					isNotValid = true;
					errorStr += "The data in city is invalid.\n";
					
					if (!toSetFocus)
						toSetFocus = id_ZipCityStateCombine.id_City;
				}
				
				//Type > Varchar, max length >100, Required > OPtional
				if (id_ZipCityStateCombine.id_ZIP.textInput.text.length > 0 && id_ZipCityStateCombine.id_ZIP.textInput.text.length < 50)
				{
					if(!ValidationUtils.isValidZipCode(id_ZipCityStateCombine.id_ZIP.textInput.text))
					{
						isNotValid = true;
						errorStr += "The data in zip is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_ZipCityStateCombine.id_ZIP;
					}
				}
				else
				{
					isNotValid = true;
					errorStr += "Please enter data in ZIP.\n";
					
					if (!toSetFocus)
						toSetFocus = id_ZipCityStateCombine.id_ZIP;
				}
				//Type > Varchar, max length >100, Required > Yes
				if (!ValidationUtils.isValidEmail(id_email))
				{
					if (!ValidationUtils.isValidUserName(id_email.text))
					{
						isNotValid = true;
						errorStr += "The data in email is invalid. \n"; //"Patient's E-mail / 4-8-digit Pin is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_email;
					}
				}
				
				//Type > List, max length >at least 1, Required > yes
				if (!personalPhoneNumbers || !personalPhoneNumbers.length)
				{
					var arePhoneFieldsValid:Object = id_PhoneNumberAddMore.isInValid(true, "Patient's personal");
					if (arePhoneFieldsValid.hasOwnProperty("isNotValid") && arePhoneFieldsValid.isNotValid)
					{
						isNotValid = true;
						
						if (arePhoneFieldsValid.hasOwnProperty("errorStr"))
							errorStr += arePhoneFieldsValid.errorStr;
						
						if (!toSetFocus && arePhoneFieldsValid.hasOwnProperty("toSetFocus"))
							toSetFocus = arePhoneFieldsValid.toSetFocus;
					}
				}
				//Tahir Alvi - 15 june, 2012
				//New Validation on SSN/Other ID
				//Type > Numaric, max length >09, Required > Required
				if(!id_OtherIDChBox.selected) //if SSN is provided
				{
					if(SSNIDValue.length >9)
						SSNIDValue = ValidationUtils.getSSNWithoutMasking(SSNIDValue);
					
					if(SSNIDValue.length > 9 || SSNIDValue.length <= 0)
					{
						isNotValid = true;
						errorStr += "The data in ssn is invalid. \n";
						
						if (!toSetFocus)
							toSetFocus = id_SSN;
					}else if(!ValidationUtils.isSSNValid(SSNIDValue))
					{
						isNotValid = true;
						errorStr += "The data in ssn is invalid. \n";
						
						if (!toSetFocus)
							toSetFocus = id_SSN;
					}
				}else //if Other ID is provided
				{
					if(SSNIDValue.length > 14 || SSNIDValue.length < 4)
					{
						isNotValid = true;
						errorStr += "The data in ssn is invalid. \n";
						
						if (!toSetFocus)
							toSetFocus = id_SSN;
					}
				}
				
				if (isNotValid && errorStr.length)
					Alert.show(errorStr, "Patient Registration Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
				
				return isNotValid;
			}
			
