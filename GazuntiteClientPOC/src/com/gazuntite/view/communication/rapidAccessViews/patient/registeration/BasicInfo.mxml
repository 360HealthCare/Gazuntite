			public function getBasicInfo():void
			{
				/* if(id_Prefix.selectedIndex!=-1){
					model.basicUserDTO.Prefix			= id_Prefix.selectedItem as PrefixTypeDTO;
				}
				model.basicUserDTO.FirstName 			= id_FName.text;
				model.basicUserDTO.MiddleName 			= id_MName.text;
				model.basicUserDTO.LastName 			= id_LName.text;
				model.basicUserDTO.Gender 				= id_Gender.selectedItem as GenderTypeDTO;
				
				if (!ValidationUtils.isValidEmail(id_email))
				{
					if (ValidationUtils.isValidUserName(id_email.text))
					{
						model.basicUserDTO.UserName			= id_email.text;
						model.basicUserDTO.UserEmail = null;
					}
				}
				else
				{
					model.basicUserDTO.UserEmail 			= id_email.text;
					model.basicUserDTO.UserName = null
				}
				
				model.basicUserDTO.CreatedBy 			= model.loggedInUserDTO.UserId;
				model.basicUserDTO.CreatedAt 			= new Date();
				
				model.addressBookDTO.AddressPartyTypeID = Constants.PATIENT_PARTY_TYPE_ID;
				model.addressBookDTO.PartyID = Constants.GUID_FORMAT;
				model.addressBookDTO.CreatedAt = new Date();
				model.addressBookDTO.CreatedBy = model.loggedInUserDTO.UserId;
				model.addressBookDTO.UpdatedAt = new Date();
				
				// optional but if any one field of addres is entered, then all remaining is required.
				if( id_Address.text != "" )
				{
					var addressDTO:AddressDTO;
					
					if(model.addressBookDTO != null && model.addressBookDTO.AddressDTOlist != null && model.addressBookDTO.AddressDTOlist.length >0)
					{
						addressDTO =  model.addressBookDTO.AddressDTOlist.getItemAt(0) as AddressDTO;						
					}
					
					if(addressDTO )
					{
						addressDTO.StreetName 	  = id_Address.text;
						//addressDTO.AddressID = model.addressBookDTO.AddressBookID;
						addressDTO.IsPrimary 	 = true;
						
						model.patientDTO.Address = id_Address.text;
						
						if( id_ZipCityStateCombine.id_ZIP.selectedItem != -1)
						{
							addressDTO.ZipCodeID 	 = id_ZipCityStateCombine.id_ZIP.selectedItem.ZipCodeID;//int(id_ZIP.textInput.text);
							model.patientDTO.ZipCode = id_ZipCityStateCombine.id_ZIP.selectedItem.ZipCode;//id_ZIP.textInput.text; 
						}
						else
						{
							Alert.show("please select zip code","invalid zip-code");
							return;
						}
						
						if( id_ZipCityStateCombine.id_State.selectedItem )
						{
							addressDTO.StateID 	 	 =  id_ZipCityStateCombine.id_State.selectedItem.StateID;
							model.patientDTO.State	 =  id_ZipCityStateCombine.id_State.selectedItem.StateName;
						}
						else
						{
							Alert.show("please select State","invalid State");
							return;
						}
						
						addressDTO.CountryID 	 = Constants.COUNTRY_USA_ID;
						addressDTO.CreatedAt	= new Date();
						addressDTO.UpdatedAt	= new Date();
						
						if(id_ZipCityStateCombine.id_City.selectedItem)
						{
							model.patientDTO.City = id_ZipCityStateCombine.id_City.selectedItem.CityName;
						}
						model.addressBookDTO.AddressDTOlist.removeAll();
						model.addressBookDTO.AddressDTOlist.addItem( addressDTO );
						
					}else
					{
						var addressDTO:AddressDTO = new AddressDTO();
						
						addressDTO.StreetName 	  = id_Address.text;
						//addressDTO.AddressID =     
						addressDTO.IsPrimary 	 = true;
						
						model.patientDTO.Address = id_Address.text;
						
						if( id_ZipCityStateCombine.id_ZIP.selectedItem != -1)
						{
							addressDTO.ZipCodeID 	 = id_ZipCityStateCombine.id_ZIP.selectedItem.ZipCodeID;//int(id_ZIP.textInput.text);
							model.patientDTO.ZipCode = id_ZipCityStateCombine.id_ZIP.selectedItem.ZipCode;//id_ZIP.textInput.text;
						}
						else
						{
							Alert.show("please select zip code","invalid zip-code");
							return;
						}
						
						if( id_ZipCityStateCombine.id_State.selectedItem )
						{
							addressDTO.StateID 	 	 = id_ZipCityStateCombine.id_State.selectedItem.StateID;
							model.patientDTO.State	 = id_ZipCityStateCombine.id_State.selectedItem.StateName;
						}
						else
						{
							Alert.show("please select State","invalid State");
							return;
						}
						
						addressDTO.CountryID 	 = Constants.COUNTRY_USA_ID;
						addressDTO.CreatedAt	= new Date();
						addressDTO.UpdatedAt	= new Date();
						
						if(id_ZipCityStateCombine.id_City.selectedItem)
						{
							model.patientDTO.City = id_ZipCityStateCombine.id_City.selectedItem.CityName;
						}
						if(model.addressBookDTO == null)
							model.addressBookDTO = new AddressBookDTO();
						
						if(model.addressBookDTO.AddressDTOlist == null )
							model.addressBookDTO.AddressDTOlist = new ArrayCollection();
						
						model.addressBookDTO.AddressDTOlist.removeAll();
						
						model.addressBookDTO.AddressDTOlist.addItem( addressDTO );
					}
				}
				
				//Tahir Alvi - Adding personal phone numbers 
				var phoneDto:PhoneDTO
				if (personalPhoneNumbers && personalPhoneNumbers.length)
				{
					// ********** START  remove primary phone number every time before adding phone for save 
					if(model.addressBookDTO.PhoneDTOlist && model.addressBookDTO.PhoneDTOlist.length)
					{
						var tempDTO:PhoneDTO = model.addressBookDTO.PhoneDTOlist.getItemAt(0) as PhoneDTO;
						if(tempDTO.OwnerTypeID == Constants.SELF_OWNER_TYPE_ID)
						{
							tempDTO.IsDeleted = true;
						}
						model.addressBookDTO.PhoneDTOlist.filterFunction = filterDeletedItems;
						model.addressBookDTO.PhoneDTOlist.refresh();
					}
					
					for (var i:int = 0; i < personalPhoneNumbers.length; i++)
					{
						var isPrim:Boolean = false;
						if (i == 0)
						{
							isPrim = true;
							phoneDto = QSUtilityFunctions.makePhoneDTO(personalPhoneNumbers[i], isPrim, Constants.SELF_OWNER_TYPE_ID);
							if( phoneDto.PhoneID != 0 ) 
								phoneDto.IsDirty = true;
						}else
						{
							phoneDto = QSUtilityFunctions.makePhoneDTO(personalPhoneNumbers[i], isPrim, Constants.SELF_OWNER_TYPE_ID);
						}
						
						if(i == 0)
							model.addressBookDTO.PhoneDTOlist.addItemAt(phoneDto, 0);
						else
							model.addressBookDTO.PhoneDTOlist.addItem(phoneDto);
					}
				}
				else
				{
					var personalPhDetails:Object = id_PhoneNumberAddMore.getPhoneNumberDetails();
					
					if (personalPhDetails)
					{
						// ********** START remove primary phone number every time before adding phone for save **********************
						if(model.addressBookDTO.PhoneDTOlist && model.addressBookDTO.PhoneDTOlist.length)
						{
							var tempDTO:PhoneDTO = model.addressBookDTO.PhoneDTOlist.getItemAt(0) as PhoneDTO;
							if(tempDTO.OwnerTypeID == Constants.SELF_OWNER_TYPE_ID)
								tempDTO.IsDeleted = true;
							
							model.addressBookDTO.PhoneDTOlist.filterFunction = filterDeletedItems;
							model.addressBookDTO.PhoneDTOlist.refresh();
						}
						
						phoneDto = QSUtilityFunctions.makePhoneDTO(personalPhDetails, true, Constants.SELF_OWNER_TYPE_ID);
						model.addressBookDTO.PhoneDTOlist.addItemAt(phoneDto, 0);
					}
				}
				
				//End - Adding personal phone numbers 
				
				if(id_DOB.selectedDate!=null){
					var strDate:Date                           = new Date(formatDateTime.format(id_DOB.text));  
					model.patientDTO.DateOfBirth 				= strDate; //id_DOB.selectedDate;
					model.patientDTO.StrDOB  					= model.patientDTO.DateOfBirth.toDateString();
				}				
				else if(id_DOB.text.length >0){
					model.patientDTO.DateOfBirth 				= new Date(formatDateTime.format(id_DOB.text));//Constants.NULL_DATE;
					model.patientDTO.StrDOB  					= model.patientDTO.DateOfBirth.toDateString();
				} 
				
				if(id_MeritalStaus.selectedIndex!=-1){
