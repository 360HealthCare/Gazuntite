<?xml version="1.0" encoding="utf-8"?>
<s:BorderContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				   width="100%" 
				   height="100%"
				   borderAlpha="0"
				   borderWeight="0"
				   xmlns:s="library://ns.adobe.com/flex/spark" 
				   xmlns:mx="library://ns.adobe.com/flex/mx" 
				   xmlns:ns="library://ns.tink.ws/flex/spark"
				   xmlns:sf="http://www.spicefactory.org/parsley" 
				   xmlns:profile="com.gazuntite.view.communication.providerComm.profile.*" xmlns:containers="spark.tink.containers.*" >
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			[Inject(id="sharedModel")]
			public var sharedModel:SharedModel = new SharedModel();
			
			
			
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<sf:Configure/>
		<sf:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0"/>
	</s:layout>
	
	<s:TabBar id="tabs" dataProvider="{vs}" skinClass="com.gazuntite.skins.PatientProfileTabBarSkin"/>
	
	<s:BorderContainer width="100%"
					   height="100%"
					   borderWeight="2"
					   borderColor="0x000000"
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="1">
		
		<s:layout>
			<s:VerticalLayout/>
		</s:layout>
		
		<containers:NavigatorGroup id="vs" width="100%" height="100%" >
			<s:Group id="General" 
					 name="General"
					 width="100%" 
					 height="100%">
				
				
				<profile:GeneralView id="id_ProviderGeneralView" width="100%" height="100%" styleName="whiteNGreyRectangularBGContainerSkin" />
				
				
			</s:Group>
			<s:Group id="Organization" 
					 width="100%" 
					 height="100%"
					 >
				<s:Label text="This is my second tab..."/>
			</s:Group>
			<s:Group id="Insurance" 
					 width="100%" 
					 height="100%">
				<s:Label text="This is my third tab..."/>
			</s:Group>
			<s:Group id="Other" 
					 width="100%" 
					 height="100%">
				<s:Label text="This is my fourth tab..."/>
			</s:Group>
		</containers:NavigatorGroup>
		
	</s:BorderContainer>
	
	
</s:BorderContainer>
