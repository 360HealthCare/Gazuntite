<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:sf="http://www.spicefactory.org/parsley"
					  width="100%" height="100%"
					  backgroundColor="0xffffff"
					  creationComplete="init(event)" 
					  xmlns:controls="com.gazuntite.view.controls.*">
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			[Inject(id="sharedModel")]
			public var sharedModel:SharedModel = new SharedModel();
			
			protected function init(event:FlexEvent):void
			{
				
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<sf:Configure/>
		<sf:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" verticalAlign="top"/>
	</s:layout>
	
	<s:BorderContainer width="100%"
					   height="24"
					   borderWeight="2"
					   borderColor="0xbbbbbb"
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="1">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xdadada" ratio=".1"/>
				<s:GradientEntry color="0xbfbfbf" ratio=".9"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle"
								horizontalAlign="center"
								paddingLeft="10"
								paddingRight="10"/>
		</s:layout>
		
		<s:HGroup width="100%" 
				  gap="5"
				  horizontalAlign="left"
				  verticalAlign="middle">
			<s:Image source="assets/titleBarDots.png"/>
			<s:Label text="RAPID ACCESS" styleName="hudViewTitle"/>
		</s:HGroup>
		
		
		
		<s:HGroup width="100%"
				  horizontalAlign="right">
			<s:Button skinClass="com.gazuntite.skins.BlackArrowSmallSkin"/>
		</s:HGroup>
		
	</s:BorderContainer>
	
	
	
	<!-- end top bar -->
	
	<s:BorderContainer width="70"
					   height="100%"
					   borderWeight="0"
					   borderColor="0xbbbbbb"
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="0">
		
		<s:backgroundFill>
			<s:SolidColor color="0xd3d3d3"/>
		</s:backgroundFill>
		
		<s:layout>
			<s:VerticalLayout gap="-1"/>
		</s:layout>
		
		<s:ButtonBar width="100%"
					 height="100%" 
					 skinClass="com.gazuntite.skins.RapidAccessButtonBarSkin">
			<s:layout>
				<s:TileLayout verticalGap="0"
							  horizontalGap="0"
							  columnWidth="70"
							  rowHeight="50"
							  requestedRowCount="5"/>
			</s:layout>
		
			<s:dataProvider>
				<s:ArrayCollection>
					<fx:Object icon="@Embed('assets/prescriptionBtnIcon.png')"
							   iconSelected="@Embed('assets/prescriptionBtnIconSelected.png')"/>
					<fx:Object icon="@Embed('assets/documentManagementIcon.png')"
							   iconSelected="@Embed('assets/documentManagementIconSelected.png')"/>
					<fx:Object icon="@Embed('assets/patientRegistrationIcon.png')"
							   iconSelected="@Embed('assets/patientRegistrationIconSelected.png')"/>
					<fx:Object icon="@Embed('assets/unsignedEncounterIcon.png')"
							   iconSelected="@Embed('assets/unsignedEncounterIconSelected.png')"/>
					<fx:Object icon="@Embed('assets/schedulerIcon.png')"
							   iconSelected="@Embed('assets/schedulerIconSelected.png')"/>
				</s:ArrayCollection>
			</s:dataProvider>
		</s:ButtonBar>
		
		
		
	</s:BorderContainer>
	
	
	
</s:SkinnableContainer>