	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<dualpanel:states>
		<s:State name="normal"/>
		<s:State name="normalFlipped"/>
	</dualpanel:states> 
	
	<!-- dual panel views -->
	
	<dualpanel:frontView>
		<controls:CoverFlowPanelView id="frontPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Test: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 optionsButtonClicked="frontPanel_optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0"
							   visible="{!isAnimating}"
							   includeInLayout="{!isAnimating}">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				
				<test:TestMobileFormBase includeIn="normal"
										 id="testForm"
										 width="100%"/>
				
				
				
				
				
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
					<controls:ArrangeByCalloutButton label="Arrange By:"
													 color="0x000000"
													 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
						<controls:dataProvider>
							<s:ArrayCollection>
								<fx:Object name="Allergy"/>
								<fx:Object name="OnSet"/>
								<fx:Object name="Reaction"/>
							</s:ArrayCollection>
						</controls:dataProvider>
					</controls:ArrangeByCalloutButton>
					
					<s:Label text="Test records added:" styleName="listLabel"/>
					
				</s:BorderContainer>
				<s:List id="list"
						width="100%"
						height="100%"
						dataProvider="{sharedModel.addedAllergiesAC}"
						itemRenderer="com.gazuntite.view.itemrenderers.allergies.AllergiesItemRenderer"/>
				
				
			</s:BorderContainer>
			
			
		</controls:CoverFlowPanelView>
		
	</dualpanel:frontView>
	
	<!-- Back view dual panel -->
	
	<dualpanel:backView>
		<controls:CoverFlowPanelView id="backPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Test History: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 optionsButtonClicked="optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0"
							   visible="{!isAnimating}"
							   includeInLayout="{!isAnimating}">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				<allergies:QIAllergyForm includeIn="normalFlipped"
										 id="allergyFormFlipped"
										 width="100%"
										 selectedRecord="{editObject}"
										 saveFormData="saveFormDataHandler(event)"/>
				
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
					<controls:ArrangeByCalloutButton label="Arrange By:"
													 color="0x000000"
													 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
						<controls:dataProvider>
							<s:ArrayCollection>
								<fx:Object name="Allergy"/>
								<fx:Object name="OnSet"/>
								<fx:Object name="Reaction"/>
							</s:ArrayCollection>
						</controls:dataProvider>
					</controls:ArrangeByCalloutButton>
					
					<s:Label text="Test history records:" styleName="listLabel"/>
					
				</s:BorderContainer>
				
				<s:List id="detailList"
						width="100%"
						height="100%"
						change="detailList_changeHandler(event)"
						dataProvider="{sharedModel.allergyHistoryAC}"
						itemRenderer="com.gazuntite.view.itemrenderers.allergies.AllergiesItemRenderer"/>
				
				
			</s:BorderContainer>
			
			
			
		</controls:CoverFlowPanelView>
	</dualpanel:backView>
	
</dualpanel:DualPanel>