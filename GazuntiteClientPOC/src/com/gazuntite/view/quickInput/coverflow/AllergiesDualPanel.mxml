<?xml version="1.0" encoding="utf-8"?>
<dualpanel:DualPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:dualpanel="com.riavalue.components.dualpanel.*" 
					  xmlns:components="com.gazuntite.components.*"
					  xmlns:forms="com.gazuntite.view.quickInput.forms.*" 
					  xmlns:input="com.gazuntite.view.controls.custom.patientExamView.quickInput.immunization.input.*" 
					  xmlns:controls="com.gazuntite.view.controls.*" 
					  xmlns:spicefactory="http://www.spicefactory.org/parsley" 
					  xmlns:immunization="com.gazuntite.view.quickInput.forms.immunization.*" 
					  xmlns:allergies="com.gazuntite.view.quickInput.forms.allergies.*"
					  skinClass="com.riavalue.components.dualpanel.SpinSkin"
					  width="100%"
					  height="100%"
					  transitionDuration="300"
					  creationComplete="init(event)" 
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.view.itemrenderers.allergies.AllergiesItemRenderer;
			import com.gazuntite.view.itemrenderers.allergies.AllergireIRReaction;
			import com.gazuntite.view.itemrenderers.allergies.OnSetItemRenderer;
			import com.gazuntite.events.ArrangeByEvent;
			import com.gazuntite.events.OptionsButtonClickedEvent;
			import com.gazuntite.events.PinViewEvent;
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.events.ToggleFormOptionsEvent;
			import com.gazuntite.model.SharedModel;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.collections.ArrayCollection;
			import mx.collections.Sort;
			import mx.controls.Alert;
			import mx.events.EffectEvent;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			import mx.validators.Validator;
			
			import spark.collections.SortField;
			import spark.components.Scroller;
			import spark.components.supportClasses.ListBase;
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			protected var selectedRecord:int;
			
			[Bindable]
			protected var editObject:ObjectProxy;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			protected function init(event:FlexEvent):void
			{
				this.currentState = "normal";
				
				this.prefsButton.addEventListener(MouseEvent.CLICK, handlePrefsButtonClick);
			}
			
			protected function handlePrefsButtonClick(event:MouseEvent):void
			{
				if(editObject == null)
				{
					if(sharedModel.addedAllergiesAC.length > 0)
					{
						editObject = sharedModel.addedAllergiesAC.getItemAt(0) as ObjectProxy;
					}
					
				}
				resetState();
			}
			
			protected function resetState():void
			{
				trace("start: " + this.currentState);
				
				if(this.currentState == "normal" || this.currentState == "fullForm")
				{
					this.currentState = "normal";
					this.currentState = "normalFlipped";
					invalidateDisplayList();
					return;
				}
				
				if(this.currentState == "normalFlipped")
				{
					this.currentState = "normal";
					invalidateDisplayList();
					return;
				}
			}
			
			protected function list_changeHandler(event:IndexChangeEvent):void
			{
				editObject = list.selectedItem;
				
				selectedRecord = list.selectedIndex;
				
				toggleStateHandler();
				
				resetState(); 
			}
			
			protected function detailList_changeHandler(event:IndexChangeEvent):void
			{
				editObject = detailList.selectedItem;
			}
			
			protected function showFullForm(event:MouseEvent):void
			{
				this.currentState = "fullForm";
			}
			
			protected function toggleFormOptionsHandler(event:ToggleFormOptionsEvent):void
			{
				
				if(this.currentState == "fullForm")
				{
					this.currentState = "normal";
					return;
				}
				
				if(event.full && this.currentState == "normal")
				{
					this.currentState = "fullForm";	
					return;
				}
				
			}
			
			protected function saveFormDataHandler(event:SaveFormDataEvent):void
			{
				if(event.payload != null)
				{
					if(event.isUpdate)
					{
						// save updated form item
						var i:int = detailList.selectedIndex;
						sharedModel.allergyHistoryAC.setItemAt(event.payload, i);
						editObject = sharedModel.allergyHistoryAC.getItemAt(i) as ObjectProxy;
					}
					else
					{
						CheckAndRemoveNKDA();
						
						if( event.payload.allergy == "NKDA" && UtilityFunctions.IsNotNullOrEmpty( sharedModel.addedAllergiesAC ) )
						{
							UtilityFunctions.AskMessage("you want to remove all allergies and set NKDA", function():void{
								sharedModel.addedAllergiesAC.removeAll();
								sharedModel.allergyHistoryAC.removeAll();

								AddNewAllergy(event.payload);
							});
						}
						else
						{
							AddNewAllergy(event.payload);
						}
					}
				}
				
				invalidateDisplayList();
				
			}
			
			private function AddNewAllergy(allergy:Object):void
			{
				sharedModel.addedAllergiesAC.addItem(allergy);
				sharedModel.allergyHistoryAC.addItem(allergy);
			}
			
			private function CheckAndRemoveNKDA():void
			{
				var i:int;
				var object:Object;
				
				for( i = 0; i < sharedModel.allergyHistoryAC.length; i++ )
				{
					object = sharedModel.allergyHistoryAC.getItemAt( i );
					if( object.allergy == "NKDA" )
					{
						sharedModel.allergyHistoryAC.removeItemAt( i );
					}
				}
				
				for( i = 0; i < sharedModel.addedAllergiesAC.length; i++ )
				{
					object = sharedModel.addedAllergiesAC.getItemAt( i );
					if( object.allergy == "NKDA" )
					{
						sharedModel.addedAllergiesAC.removeItemAt( i );
					}
				}
			}
			
			protected function updateEditObject():void
			{
				editObject = detailList.selectedItem;
			}
			
			protected function frontPanel_optionsButtonClickedHandler(event:OptionsButtonClickedEvent):void
			{
				
			}
			
			protected function arrangebycalloutbutton1_arrangeByHandler(event:ArrangeByEvent):void
			{
				//trace(event.field);
				
				var l:ListBase; // we don't know yet if this is a List or SpinnerList we're dealing with
				
				if(this.currentState == "normal")
				{
					l = list;
				}else
				{
					l = detailList;
				}
				
				switch(event.field)
				{
					case "Allergy":
						l.itemRenderer = new ClassFactory(AllergiesItemRenderer);
						break;
					case "OnSet":
						l.itemRenderer = new ClassFactory(OnSetItemRenderer);
						break;
					case "Reaction":
						l.itemRenderer = new ClassFactory(AllergireIRReaction);
						break;
					 
				}
			}
			
			protected function optionsButtonClickedHandler(event:OptionsButtonClickedEvent):void
			{
				
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<dualpanel:states>
		<s:State name="normal"/>
		<s:State name="normalFlipped"/>
	</dualpanel:states> 
	
	<!-- dual panel views -->
	
	<dualpanel:frontView>
		<controls:CoverFlowPanelView id="frontPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Allergies: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 optionsButtonClicked="frontPanel_optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
			<allergies:QIAllergyForm includeIn="normal"
									 id="allergiesForm"
									 width="100%"
									 isEditForm="false"
									 saveFormData="saveFormDataHandler(event)"/>
			
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
						<controls:ArrangeByCalloutButton label="Arrange By:"
														 color="0x000000"
														 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
							<controls:dataProvider>
								<s:ArrayCollection>
									<fx:Object name="Allergy"/>
									<fx:Object name="OnSet"/>
									<fx:Object name="Reaction"/>
								</s:ArrayCollection>
							</controls:dataProvider>
						</controls:ArrangeByCalloutButton>
						
						<s:Label text="Allergy records added:" styleName="listLabel"/>
						
					</s:BorderContainer>
						<s:List id="list"
									   width="100%"
									   height="100%"
									   
									   dataProvider="{sharedModel.addedAllergiesAC}"
									   itemRenderer="com.gazuntite.view.itemrenderers.allergies.AllergiesItemRenderer"/>
					
					
				</s:BorderContainer>
				
			
		</controls:CoverFlowPanelView>
		
	</dualpanel:frontView>
	
	<!-- Back view dual panel -->
	
	<dualpanel:backView>
		<controls:CoverFlowPanelView id="backPanel" 
									 width="100%" 
									 height="100%"
									 backgroundColor="0xffffff"
									 borderAlpha="0"
									 title="{'Allergy History: ' + sharedModel.patientName}"
									 contentBackgroundAlpha="1"
									 skinClass="com.gazuntite.skins.DualPanelViewSkin"
									 optionsButtonClicked="optionsButtonClickedHandler(event)">
			
			<s:BorderContainer width="100%"
							   height="100%"
							   borderWeight="0" 
							   cornerRadius="0" 
							   dropShadowVisible="false"
							   borderAlpha="0">
				
				<s:backgroundFill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry color="0xffffff" ratio=".1"/>
						<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
					</s:LinearGradient>
				</s:backgroundFill>
				
				<s:layout>
					<s:VerticalLayout paddingBottom="0"
									  paddingLeft="0"
									  paddingRight="0"
									  paddingTop="0"
									  horizontalAlign="center"/>
				</s:layout>
				
				<allergies:QIAllergyForm includeIn="normalFlipped"
										 id="allergyFormFlipped"
										 width="100%"
										 isEditForm="true"
										 selectedRecord="{editObject}"
										 saveFormData="saveFormDataHandler(event)"/>
			
			<!--<allergies:QIAllergyMobileHistoryForm includeIn="normalFlipped"
												  id="allergyFormFlipped"
												  width="100%"
												  selectedRecord="{editObject}"
												  saveFormData="saveFormDataHandler(event)"/>-->
			
				<s:BorderContainer width="100%"
								   height="24"
								   borderWeight="1" 
								   borderColor="0x898989"
								   cornerRadius="0" 
								   dropShadowVisible="false"
								   borderAlpha="1">
					
					<s:backgroundFill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry color="0x898989" ratio=".1"/>
							<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
						</s:LinearGradient>
					</s:backgroundFill>
					
					<s:layout>
						<s:HorizontalLayout verticalAlign="bottom" 
											paddingLeft="10"
											paddingBottom="10"/>
					</s:layout>
					
						<controls:ArrangeByCalloutButton label="Arrange By:"
														 color="0x000000"
														 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
							<controls:dataProvider>
								<s:ArrayCollection>
									<fx:Object name="Allergy"/>
									<fx:Object name="OnSet"/>
									<fx:Object name="Reaction"/>
								</s:ArrayCollection>
							</controls:dataProvider>
						</controls:ArrangeByCalloutButton>
						
						<s:Label text="Allergy history records:" styleName="listLabel"/>
						
					</s:BorderContainer>
						
						<s:List id="detailList"
									   width="100%"
									   height="100%"
									   change="detailList_changeHandler(event)"
									   dataProvider="{sharedModel.allergyHistoryAC}"
									   itemRenderer="com.gazuntite.view.itemrenderers.allergies.AllergiesItemRenderer"/>

					
				</s:BorderContainer>
				
			
			
		</controls:CoverFlowPanelView>
	</dualpanel:backView>
	
</dualpanel:DualPanel>
