<?xml version="1.0" encoding="utf-8"?>
<custom:PinableSlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
							 xmlns:allergies="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.allergies.*" 
							 xmlns:quickInput="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.*"
							 xmlns:ros="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.physical.ros.*" 
							 xmlns:notes="com.adobe.Quivus.view.controls.custom.patientExamView.notes.*"
							 creationComplete="slideoutpanel1_creationCompleteHandler(event)" 
							 QSViewStateChange="slideoutpanel1_QSViewStateChangeHandler(event)" 
							 >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.AppUtils;
			import com.adobe.Quivus.utils.ChromeUtil;
			import com.adobe.Quivus.utils.Constants;
			import com.adobe.Quivus.utils.QSUtilityFunctions;
			import com.adobe.Quivus.utils.QuivusCombineEventDispatcher;
			import com.adobe.Quivus.utils.security.QSSecurityUtil;
			import com.adobe.Quivus.view.controls.custom.DictationPopup;
			import com.adobe.Quivus.view.controls.custom.patientExamView.notes.NotesPanel;
			import com.adobe.Quivus.view.controls.custom.patientExamView.notes.NotesPopup;
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.manager.QIPopUpManager;
			import com.adobe.Quivus.view.controls.skins.QIinternalBarFocusSkin;
			import com.adobe.Quivus.view.controls.skins.QIinternalBarSkin;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.VBdictationBtnSelected;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.VBnotesBtnSelected;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridDictationButtonSelectedSkin;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridDictationButtonSkin;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.VBIconsBlackButton;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.VBIconsButton;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.VBIconsButtonFilled;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.writeNotesButton;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.writeNotesButtonSelected;
			import com.adobe.Quivus.view.events.QSViewStateEvent;
			import com.adobe.Quivus.view.events.SelectSection;
			import com.zigron.utils.UtilityFunctions;
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.ItemClickEvent;
			import mx.events.MoveEvent;
			
			import spark.events.IndexChangeEvent;
			
			import valueObjects.ModuleDictationDTO;
			import valueObjects.ModuleNoteDTO;
			
			private var m_bIsModelUpdated:Boolean;
			
			var moduleConstantName:String = Constants.REVIEW_OF_SYSTEM_MODULE_NAME;
			public function get IsModelUpdated():Boolean
			{
				return m_bIsModelUpdated;
			}
			
			public function set IsModelUpdated(value:Boolean):void
			{
				m_bIsModelUpdated = value;
				
				UpdateChange();
				
				if( value )
				{
					
					var module:ModuleDictationDTO = QSUtilityFunctions.getModuleDictationDTO(moduleConstantName);					
					var noteDto:ModuleNoteDTO = QSUtilityFunctions.getModuleNoteDTO( moduleConstantName);
					
					if(module.DictationID && module.DictationID != Constants.GUID_FORMAT)
					{
						id_Header.id_Voice.setStyle("skinClass", VBdictationBtnSelected);
						id_Header.id_iconButtons.setStyle("skinClass", VBIconsButtonFilled);
						//id_dictationIndicator.visible = true;
					}
					
					if(noteDto.Note && noteDto.Note != "")
					{
						id_Header.id_NotesBtn.setStyle("skinClass", VBnotesBtnSelected);
						id_Header.id_iconButtons.setStyle("skinClass", VBIconsButtonFilled);
						//id_noteIndicator.visible = true;
					}								
					
				}
			}
			
			private function UpdateChange():void
			{
				try
				{
					UpdateCheckStatus();
					var hasData:Boolean = QSUtilityFunctions.checkROSNormal();
					
					if( hasData == false )
						hasData = QSUtilityFunctions.checkROSNotes();
					
					hasChange =  hasData;
				}
				catch( e:Error )
				{
					trace( "UpdateChange -> QIPhysical::ROS", e.message );
				}
			}
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var notesPanel:NotesPanel;
			
			private var dictationPanel:DictationPopup;
			
			private var m_bHasChange:Boolean;
			
			[Bindable]
			public function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			public function set hasChange(value:Boolean):void
			{
				trace( "ROS Change:",value );
				m_bHasChange = value;
				
				
				if( value )
				{
					id_Header.id_ChangeIndicator.visible		 = true;
					id_Header.id_ChangeIndicator.includeInLayout = true;
				}
				else
				{
					id_Header.id_ChangeIndicator.visible		 = false;
					id_Header.id_ChangeIndicator.includeInLayout = false;
				}
			}
			
			public override function set AllowOtherPopup(value:Boolean):void
			{
				super.AllowOtherPopup = value;
				if( ! value && notesPanel)
					notesPanel.removePopup();
				
				/* if( ! value && id_ImmunizationBodyView.recordNotesPanel )
				id_ImmunizationBodyView.recordNotesPanel.removePopup(); */
				
				if( ! value && dictationPanel)
					dictationPanel.removePopup();
			}
			
			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				if( model.quickInputDataLoadedFlag )
					UpdateChange();
				
				id_Header.id_OptionPopUp.displayPopUp = true;
				id_Header.id_iconButtons.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if(id_notesDictation.id_Area.visible)
					{
						
						if(id_Header.id_OptionPopUp.displayPopUp)
						{
							id_Header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						}
						else
						{
							id_Header.id_iconButtons.setStyle("skinClass", VBIconsButton);	
						}
					}
					this.ExpandedView = true;
					
					event.stopImmediatePropagation();
					
				});	
				
				id_Header.id_Voice.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						id_notesDictation.notesDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.REVIEW_OF_SYSTEM_MODULE_NAME );
						id_notesDictation.DictationDTO = QSUtilityFunctions.getModuleDictationDTO(Constants.REVIEW_OF_SYSTEM_MODULE_NAME);
						
						id_notesDictation.id_Area.visible 		= true;
						id_notesDictation.id_Area.includeInLayout = true;		
						id_notesDictation.id_VBViews.selectedIndex = 1;						
						//id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						id_Header.id_iconButtons.selected = false;
						id_Header.id_OptionPopUp.displayPopUp = false;
						
						
						id_notesDictation.dictationPanel.rec_btn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{													
							id_Header.setIcons(true, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							hasChange = true;
						});	
						id_notesDictation.id_notesPanel.id_body.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{						
							id_Header.setIcons(id_notesDictation.DictationDTO.DictationID && id_notesDictation.DictationDTO.DictationID != Constants.GUID_FORMAT, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							id_notesDictation.id_Area.visible 		= false;
							id_notesDictation.id_Area.includeInLayout = false;
						});
						
						ExpandedView = true;
						if(this.ExpandedView)
						{
							event.stopImmediatePropagation();
						}
					}
				});			
				
				id_Header.id_NotesBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						id_notesDictation.notesDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.REVIEW_OF_SYSTEM_MODULE_NAME );
						id_notesDictation.DictationDTO = QSUtilityFunctions.getModuleDictationDTO(Constants.REVIEW_OF_SYSTEM_MODULE_NAME);
						
						id_notesDictation.id_Area.visible 		= true;
						id_notesDictation.id_Area.includeInLayout = true;						
						id_notesDictation.id_VBViews.selectedIndex = 0;
						//id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						id_Header.id_iconButtons.selected = false;
						id_Header.id_OptionPopUp.displayPopUp = false;
						
						
						id_notesDictation.id_notesPanel.id_body.id_subject.setFocus();
						
						id_notesDictation.dictationPanel.rec_btn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{													
							id_Header.setIcons(true, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							hasChange = true;
						});	
						id_notesDictation.id_notesPanel.id_body.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{						
							id_Header.setIcons(id_notesDictation.DictationDTO.DictationID && id_notesDictation.DictationDTO.DictationID != Constants.GUID_FORMAT, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							id_notesDictation.id_Area.visible 		= false;
							id_notesDictation.id_Area.includeInLayout = false;
						});
						ExpandedView = true;
						if(this.ExpandedView)
						{
							event.stopImmediatePropagation();
						}
					}
				});
				
				id_Header.id_SpinerList.addEventListener(IndexChangeEvent.CHANGE, function(event:IndexChangeEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						id_ROSView.id_TreeList.selectItemByIndex( event.newIndex );
						event.stopImmediatePropagation();
					}
				});
				
				id_ROSView.id_TreeList.addEventListener(ItemClickEvent.ITEM_CLICK, function(event:ItemClickEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						var idx:int = id_Header.id_SpinerList.DataProvider.getItemIndex( event.currentTarget.ParentSelectedItem.data );
						if( -1 == idx )
							idx = 1
						id_Header.id_SpinerList.currIndex = idx;
						event.stopImmediatePropagation();
					}
				});
				
				id_ROSView.id_TreeList.addEventListener("footerClick", function(event:ItemClickEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						id_Header.id_SpinerList.currIndex = id_Header.id_SpinerList.DataProvider.getItemIndex( event.currentTarget.ParentSelectedItem.data );
						event.stopImmediatePropagation();
					}
				});
				
				
				id_Header.id_slideoutBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					ToggleSlideOut();
					event.stopImmediatePropagation();
				});
				id_Header.id_Pin.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						PinView = event.currentTarget.selected;
					}
				});
				
				
				id_Header.id_AllNormalBtn.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_ROS ) )
					{
						if( QSUtilityFunctions.checkROSNotes() )
						{
							Alert.show("This action will clear all notes/dictation, Are you sure you want to clear all notes/dictation?","Clear Notes and Dictation", Alert.YES|Alert.NO, 
								FlexGlobals.topLevelApplication, function(event:CloseEvent):void
								{
									if( event.detail == Alert.YES)
									{
										hasChange = QSUtilityFunctions.setROSToNormal(true);
										//UpdateCheckStatus();
									}
									else if( event.detail == Alert.NO)
									{
										// NO button was clicked
									}
								});
						}
						else
						{
							hasChange = QSUtilityFunctions.setROSToNormal(false);
						}
						event.stopImmediatePropagation();
					}
				});
				
				id_Header.id_OptionPopUp.displayPopUp = false;
			}
			
			public function UpdateCheckStatus():void
			{
				var currIndex:int = id_ROSView.id_TreeList.ParentSelectedIndex;
				var i:int;
				for( i = 0 ; i <  id_ROSView.DataProvider.length ; i++ )
				{
					id_ROSView.id_TreeList.selectItemByIndex( i );
					id_ROSView.UpdateCheckStatus();
				}
				
				id_ROSView.id_TreeList.selectItemByIndex( currIndex );
				hasChange = true;
			}
			
			protected function slideoutpanel1_QSViewStateChangeHandler(event:QSViewStateEvent):void
			{
				if( event.viewState == QSViewStateEvent.EXPANDED_VIEW )
				{
					if( UtilityFunctions.IsNullOrEmpty( model.rosDTOList ) )
					{
						QuivusCombineEventDispatcher.loadROSPhysicalStaticDataEvents(false);
					}
					if( id_Header )
					{
						id_Header.HeadingLable = id_Header.HeadingLable.toUpperCase();
						id_Header.id_pmhHeader.setStyle("skinClass", QIinternalBarFocusSkin);
						id_Header.id_headingLbl.setStyle("color", 0xffffff);
						id_Header.id_expandBtn.selected = true;
					}
				}
				else
				{
					if( id_Header )
					{
						id_Header.HeadingLable = AppUtils.TitleCase(id_Header.HeadingLable);
						id_Header.id_pmhHeader.setStyle("skinClass", QIinternalBarSkin);
						id_Header.id_headingLbl.setStyle("color", 0x000000);
						id_Header.id_expandBtn.selected = false;
					}
					
					QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.ROS);
				}
			}
			
			protected function id_noteIndicator_clickHandler(event:MouseEvent):void
			{
				/* var popup:NotesPopup = new NotesPopup();
				popup.height = 30;
				popup.ShowPopup( this );
				popup.HeaderLabel = "Notes";
				
				var noteDto:ModuleNoteDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.REVIEW_OF_SYSTEM_MODULE_NAME );
				if( noteDto.Note )
				popup.id_message.text  = noteDto.Note;
				
				var pLoc:Point = id_IndicatorGrp.localToGlobal( new Point( id_noteIndicator.x - 15 +  (id_noteIndicator.width /2) , id_noteIndicator.y + 10) ); 
				popup.move(pLoc.x,pLoc.y ); */
				
			}
			
			protected function id_dictationIndicator_clickHandler(event:MouseEvent):void
			{
				/* var module:ModuleDictationDTO = QSUtilityFunctions.getModuleDictationDTO(Constants.REVIEW_OF_SYSTEM_MODULE_NAME);
				
				if( dictationPanel )
				{
				dictationPanel.removePopup();					
				}
				
				dictationPanel 					= new DictationPopup();
				dictationPanel.width			= 200;
				dictationPanel.height			= 75;
				dictationPanel.HeadingLable 	= "Dictation";
				dictationPanel.DictationID	 	= module.DictationID;
				
				dictationPanel.ModuleID	 		= module.ModuleTypeID.toString();
				dictationPanel.ShowPopup( this );
				
				var pLoc:Point = id_IndicatorGrp.localToGlobal( new Point( id_dictationIndicator.x - 125 +  (id_dictationIndicator.width /2) , id_dictationIndicator.y + 14) );
				dictationPanel.move( pLoc.x, pLoc.y ); */
				
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Binding source="id_ROSView.hasChange" destination="hasChange" />
	<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> 
	
	<fx:Binding source="model.rosDTOList" destination="id_ROSView.DataProvider" /> 
	
	
	
	<custom:HeaderContents>
		<s:Group width="100%" height="24" minWidth="{ChromeUtil.topLevelMainContainer.width - 70}">
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" />
			</s:layout>			
			<ros:ROSPanelHeader id="id_Header" width="100%" height="22"  HeadingLable="Review of System" SectionNameID="{QSSecurityUtil.QI_ROS}"/>
		</s:Group>
		
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<s:SkinnableContainer width="100%" minHeight="36" height="100%"  skinClass="com.adobe.Quivus.view.controls.skins.QISlideHeaderOuterSkin">						
			<s:layout>
				<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" paddingRight="5" />
			</s:layout>
			<custom:slideOutQIHeader Label="Review of System" width="100%" height="22" />								   
		</s:SkinnableContainer>					   
		
	</custom:SlideHeaderContents>
	<custom:Contents>
		<s:SkinnableContainer id="sc_ROS" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}" 
							  visible="{model.securityProxyObject.PatientExam.QuickInput.Physicals.ROS.IsViewAllowed}" includeInLayout="{sc_ROS.visible}">
			<s:layout>
				<s:VerticalLayout  verticalAlign="top" gap="0"   horizontalAlign="{isSlideOut? 'right':'center'}" paddingRight="3" paddingBottom="2"
								   paddingTop="{isSlideOut? -2:2}" paddingLeft="{isSlideOut? 1:1}"/>
			</s:layout>
			<!--<s:VGroup width="{id_Header.width}" verticalAlign="top" gap="0" 
			horizontalAlign="{isSlideOut? 'right':'center'}" paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 40:1}">-->
			
			<notes:QISectionLevelNotesDictation id="id_notesDictation" width="100%" 
												/>
			
			
			
			<!--<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}">
			
			<s:layout>
			<s:VerticalLayout gap="2" horizontalAlign="right"  paddingLeft="3" paddingRight="3" paddingTop="10" paddingBottom="5"/>
			</s:layout>
			-->
			<s:HGroup width="100%" horizontalAlign="right" paddingTop="5" >
				<s:Button label="Next" click="dispatchEvent( new SelectSection('SelectSection', 'id_ROSPanel', true, true) )" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin" 
						  toolTip="Next Section" buttonMode="true" />
			</s:HGroup>
			<ros:ROSView id="id_ROSView" width="100%" DataProvider="{model.rosDTOList}" enabled="{model.securityProxyObject.PatientExam.QuickInput.Physicals.ROS.IsEditAllowed}"/>
			<s:HGroup width="100%" paddingBottom="5" paddingRight="3">					
				<s:HGroup id="id_IndicatorGrp" width="100%" horizontalAlign="left" >
					<s:Button id="id_noteIndicator" label="Notes" visible="false" includeInLayout="{id_noteIndicator.visible}"
							  click="id_noteIndicator_clickHandler(event)" toolTip="View Notes" 
							  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.notesIndicatorBtnSkin" />
					<s:Button id="id_dictationIndicator" label="Dictation" visible="false" includeInLayout="{id_dictationIndicator.visible}"
							  click="id_dictationIndicator_clickHandler(event)" toolTip="Play Dictation" 
							  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.dictationIndicatorBtnSkin"/>
				</s:HGroup>
				<s:Group id="id_spacer" width="100%" height="2" />
				
			</s:HGroup>
			<!--</s:BorderContainer> -->
		</s:SkinnableContainer>
		
		<!--</s:VGroup>-->
		
	</custom:Contents>
</custom:PinableSlideOutPanel>