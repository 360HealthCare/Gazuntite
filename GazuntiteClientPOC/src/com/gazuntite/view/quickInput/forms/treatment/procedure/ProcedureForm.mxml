<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="init(event)" 
		 xmlns:diagnosis="com.gazuntite.view.quickInput.forms.diagnosis.*" 
		 xmlns:treatment="com.gazuntite.view.quickInput.forms.treatment.*" 
		 xmlns:procedure="com.gazuntite.view.quickInput.forms.treatment.procedure.*" 
		 xmlns:lists="com.gazuntite.view.lists.*" 
		 >
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.view.itemrenderers.Treatment.Procedure.ProcedureIRCptCode;
			import com.gazuntite.view.itemrenderers.Treatment.Procedure.ProcedureIRProcedure;
			import com.gazuntite.view.itemrenderers.diagnosis.DiagnosisIRICD;
			import com.gazuntite.events.SaveFormDataEvent;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			private var _dataProvider:ArrayCollection;
			[Bindable]
			public function get dataProvider():ArrayCollection
			{
				return _dataProvider;
			}
			
			public function set dataProvider(value:ArrayCollection):void
			{
				_dataProvider = value;
			} 
			protected function init(event:FlexEvent):void
			{
				
			}
			
			protected function addSaveRecord(event:SaveFormDataEvent):void
			{
				trace("bubbling saved record"); 
			}
			
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout horizontalAlign="center"/>
	</s:layout>
	
	 <procedure:ProcedureMobileFormBase id="imfb" width="100%"
									    saveFormData="addSaveRecord(event)" 
									    buttonLabel="Add Record"/>
	
	<lists:SortableList id="id_SortableList" width="100%" label="Treatment records added"
						dataProvider="{dataProvider}" 
						sortableIRList="{new ArrayCollection([{irClass:ProcedureIRCptCode, name:'CPT Code'}, {irClass:ProcedureIRProcedure, name:'Procedure'}])}"
						itemRenderer="com.gazuntite.view.itemrenderers.Treatment.Procedure.ProcedureIRCptCode" />
		
<!--						sortableFeildList="{new ArrayCollection(['CPTCode','Procedure'])}"-->
	
</s:Group>