<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:chronicMedication="com.gazuntite.view.quickInput.forms.chronicMedication.*" 
		 >
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SaveFormDataEvent;
			
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			[Bindable]
			private var _isedit :Boolean;
			
			public function get isedit():Boolean
			{
				return _isedit;
			}

			public function set isedit(value:Boolean):void
			{
				_isedit = value;
			}

			protected function init(event:FlexEvent):void
			{
				
			}
			
			/* protected function addSaveRecord(event:SaveFormDataEvent):void
			{
				trace("bubbling saved record");
			} */
			
			[Bindable]
			protected var _selectedRecord:ObjectProxy;
			
			public function get selectedRecord():ObjectProxy
			{
				return _selectedRecord;
			}
			
			public function set selectedRecord(value:ObjectProxy):void
			{
				_selectedRecord = value;
				setForm();
				trace("selectedRecord set");
			}
			
			
			protected function addSaveRecord(event:SaveFormDataEvent):void
			{
				if(_isedit)
				event.isUpdate = true;
				else
					event.isUpdate= false;
			}
			
			/* protected function init(event:FlexEvent):void
			{
				
			} */
			
			protected function setForm():void
			{
				id_MedicationFB.selectedRecord = _selectedRecord;
			}
			
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout horizontalAlign="center"/>
	</s:layout>
	
	
	<chronicMedication:QIMedicationMobileFormBase
												 isEditForm="{_isedit}"
												 id="id_MedicationFB"
												  width="100%"
												  saveFormData="addSaveRecord(event)" 
												  buttonLabel="Add Medication" />
	
</s:Group>
