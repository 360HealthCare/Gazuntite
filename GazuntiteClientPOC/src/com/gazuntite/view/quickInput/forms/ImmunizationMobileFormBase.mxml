<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:controls="com.gazuntite.view.controls.*"
		 width="100%" 
		 height.full="100%"
		 height.normal="30%"
		 creationComplete="init(event)"
		 xmlns:spicefactory="http://www.spicefactory.org/parsley">
	
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
	</fx:Metadata>
	
	<!-- this is just for testing Parsley -->
	<fx:Metadata>
		[ManagedEvents("saveFormData")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			import org.spicefactory.parsley.core.registry.ObjectProcessor;
			
			[Bindable]
			protected var _buttonLabel:String;
			
			[Bindable]
			protected var _selectedRecord:ObjectProxy;
			
			[Bindable]
			protected var _isEditForm:Boolean = false;
			
			[Bindable]
			protected var didEdit:Boolean = false;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			public function get isEditForm():Boolean
			{
				return _isEditForm;
			}
			
			public function set isEditForm(value:Boolean):void
			{
				_isEditForm = value;
				
				if(value == true)
				{
					//this.currentState = "full";
					fullOptionsHandle.includeInLayout = false;
					this.currentState = "presentation";
				}else
				{
					fullOptionsHandle.includeInLayout = true;
					this.currentState = "normal";
				} 
				
			}
			
			public function get selectedRecord():ObjectProxy
			{
				return _selectedRecord;
			}
			
			public function set selectedRecord(value:ObjectProxy):void
			{
				_selectedRecord = value;
				setForm();
			}
			
			public function get buttonLabel():String
			{
				return _buttonLabel;
			}
			
			public function set buttonLabel(value:String):void
			{
				_buttonLabel = value;
			}
			
			protected function validateForm():Boolean
			{
				if(cb1.selectedItemText == "")
				{
					return false;
				}
				
				if(cb2.selectedItemText == "")
				{
					return false;
				}
				
				if(cb3.selectedItemText == "")
				{
					return false;
				}
				
				
				return true;
			}
			
			protected function validateEditForm():Boolean
			{
				if(cl1.selectedItemText == "")
				{
					return false;
				}
				
				if(cl2.selectedItemText == "")
				{
					return false;
				}
				
				if(cl3.selectedItemText == "")
				{
					return false;
				}
				
				
				return true;
			}
			
			protected function addRecord(event:MouseEvent):void
			{
				
				if(validateForm())
				{
					// dummy data for test binding
					var r:ObjectProxy = new ObjectProxy();
					r.associatedWith = cb1.selectedItemText;
					r.immunization = cb2.selectedItemText;
					r.dose = cb3.selectedItemText;
					
					if(this.currentState == "full")
					{
						r.manufacturer = cb4.selectedItemText;
						r.body = cb5.selectedItemText;
						r.lotNumber = cb6.selectedItemText;
						r.dateAdmin = ds1.selectedItemText;
						r.nextDue = ds2.selectedItemText;
						r.expiryDate = ds3.selectedItemText;
						r.refusal = refusalTS.selected;
						r.reasonForRefusal = cb7.selectedItemText;
						r.site = cb8.selectedItemText;
						r.series = cb9.selectedItemText;
					}
					
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
					e.payload = r;
					
					dispatchEvent(e);
					
					clearForm();
					
				} 
			}
			
			protected function updateRecord(event:MouseEvent):void
			{
				
				if(validateEditForm())
				{
					// dummy data for test binding
					var r:ObjectProxy = new ObjectProxy();
					r.associatedWith = cl1.selectedItemText;
					r.immunization = cl2.selectedItemText;
					r.dose = cl3.selectedItemText;
					
					r.manufacturer = cl4.selectedItemText;
					r.body = cl5.selectedItemText;
					r.lotNumber = cl6.selectedItemText;
					r.dateAdmin = dsl1.selectedItemText;
					r.nextDue = dsl2.selectedItemText;
					r.expiryDate = dsl3.selectedItemText;
					r.refusal = refusalTS2.selected;
					r.reasonForRefusal = cl7.selectedItemText;
					r.site = cl8.selectedItemText;
					r.series = cl9.selectedItemText;
					
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA, true);
					e.payload = r;
					
					dispatchEvent(e);
					
				} 
			}
			
			protected function setForm():void
			{
				this.currentState = "presentation";
				cl1.selectedItemText = _selectedRecord.associatedWith;
				cl2.selectedItemText = _selectedRecord.immunization;
				cl3.selectedItemText = _selectedRecord.dose;
				
				cl4.selectedItemText = _selectedRecord.manufacturer;
				cl5.selectedItemText = _selectedRecord.body;
				cl6.selectedItemText = _selectedRecord.lotNumber;
				
				dsl1.selectedItemText = _selectedRecord.dateAdmin;
				dsl2.selectedItemText = _selectedRecord.nextDue;
				dsl3.selectedItemText = _selectedRecord.expiryDate;
				
				cl7.selectedItemText = _selectedRecord.reasonForRefusal;
				cl8.selectedItemText = _selectedRecord.site;
				cl9.selectedItemText = _selectedRecord.series;
				
				refusalTS.selected = _selectedRecord.refusal;
				
			}
			
			protected function clearForm():void
			{
				cb1.selectedItemText = "";
				cb2.selectedItemText = "";
				cb3.selectedItemText = "";
				
				if(this.currentState == "full")
				{
					cb4.selectedItemText = "";
					cb5.selectedItemText = "";
					cb6.selectedItemText = "";
					
					ds1.selectedItemText = "";
					ds2.selectedItemText = "";
					ds3.selectedItemText = "";
					
					cb7.selectedItemText = "";
					cb8.selectedItemText = "";
					cb9.selectedItemText = "";
					
					refusalTS.selected = false;
				}
				
			}
			
			protected function refusalTS_clickHandler(event:MouseEvent):void
			{
				if(!refusalTS.selected)
				{
					cb7.selectedItemText = "";
					cb8.selectedItemText = "";
					cb9.selectedItemText = "";
				}
			}
			
			protected function refusalTS2_clickHandler(event:MouseEvent):void
			{
				if(!refusalTS2.selected)
				{
					cl7.selectedItemText = "";
					cl8.selectedItemText = "";
					cl9.selectedItemText = "";
				}
			}
			
			protected function init(event:FlexEvent):void
			{
				if(sharedModel.immunizationHistoryAC.length > 0)
				{
					_selectedRecord = sharedModel.immunizationHistoryAC.getItemAt(0) as ObjectProxy;
				}
				
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="full"/>
		<s:State name="presentation"/>
	</s:states>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout paddingBottom="0"
						  paddingLeft="3"
						  paddingRight="3"
						  paddingTop="0"
						  gap="1"
						  horizontalAlign="center"
						  verticalAlign="top"/>
	</s:layout>
	
	<s:BorderContainer id="presentationForm" 
					   width="100%"
					   height="100%"
					   borderWeight="0" 
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="0"
					   includeIn="presentation">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xf3f3f3"/>
				<s:GradientEntry color="0xffffff"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:VerticalLayout paddingBottom="0"
							  paddingLeft="10"
							  paddingRight="10"
							  paddingTop="5"
							  gap="5"/>
		</s:layout>
		
		
		<s:HGroup width="100%">
			<s:VGroup width="100%">
				<!--<s:Label text="Immunization: {_selectedRecord.immunization}" styleName="title"/>-->
				<controls:CalloutLabelText id="cl2" 
										   styleName="title"
										   labelField="immunization" 
										   buttonLabel="Immunization:"
										   required="true" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
							<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
							<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="2000000"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<!--<s:Label text="Associated with: {_selectedRecord.associatedWith}" styleName="subTitle"/>-->
				<controls:CalloutLabelText id="cl1" 
										   styleName="subTitle"
										   labelField="associatedWith" 
										   buttonLabel="Associated with:"
										   required="true" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
							<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
							<fx:Object associatedWith="Visit 3" immunization="Immunization 3" dose="1000000"/>
							<fx:Object associatedWith="Visit 4" immunization="Immunization 3" dose="2000000"/>
							<fx:Object associatedWith="Visit 5" immunization="Immunization 3" dose="3000000"/>
							<fx:Object associatedWith="Visit 6" immunization="Immunization 3" dose="4000000"/>
							<fx:Object associatedWith="Visit 7" immunization="Immunization 3" dose="5000000"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
			</s:VGroup>
			
			<!--<s:Button label="Edit" 
			click="{didEdit = true; this.currentState='full';setForm();}" 
			styleName="button"/>-->
		</s:HGroup>
		
		<s:HGroup width="100%">
			<s:VGroup width="100%">
				<!--<s:Label text="Dose: {_selectedRecord.dose}" styleName="grayText"/>-->
				<controls:CalloutLabelText id="cl3" 
										   newStyleName="grayText"
										   labelField="dose" 
										   buttonLabel="Dose:"
										   required="true"
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
							<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
							<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="2000000"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<!--<s:Label text="Date admin: {_selectedRecord.dateAdmin != null ? _selectedRecord.dateAdmin : ''}" styleName="grayText"/>-->
				<controls:CalloutLabelDateSpinner id="dsl1"
												  newStyleName="grayText"
												  labelField="dateAdmin" 
												  buttonLabel="Date Admin:"
												  required="false"
												  isEditForm="{_isEditForm}"/>
				
				<controls:CalloutLabelDateSpinner id="dsl2"
												  newStyleName="grayText"
												  labelField="nextDue" 
												  buttonLabel="Next Due:"
												  required="false"
												  isEditForm="{_isEditForm}"/>
				
				<controls:CalloutLabelDateSpinner id="dsl3"
												  newStyleName="grayText"
												  labelField="expiryDate" 
												  buttonLabel="Expirty Date:"
												  required="false"
												  isEditForm="{_isEditForm}"/>
				
				<controls:CalloutLabelText id="cl4" 
										   newStyleName="grayText"
										   labelField="manufacturer" 
										   buttonLabel="Manufacturer:" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object manufacturer="Manufacturer 1"/>
							<fx:Object manufacturer="Manufacturer 2"/>
							<fx:Object manufacturer="Manufacturer 3"/>
							<fx:Object manufacturer="Manufacturer 4"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<controls:ToggleSwitchLabel id="refusalTS2" 
											label="Refusal:" 
											click="refusalTS2_clickHandler(event)"
											width="120"/>
				
				<!--<s:Label text="Next due: {_selectedRecord.nextDue != null ? _selectedRecord.nextDue : ''}" styleName="grayText"/>
				<s:Label text="Expirty date: {_selectedRecord.expiryDate != null ? _selectedRecord.expiryDate : ''}" styleName="grayText"/>
				<s:Label text="Manufacturer: {_selectedRecord.manufacturer != null ? _selectedRecord.manufacturer : ''}" styleName="grayText"/>-->
			</s:VGroup>
			
			<s:VGroup width="100%">
				<!--<s:Label text="Body/Side route: {_selectedRecord.body != null ? _selectedRecord.body : ''}" styleName="grayText"/>-->
				<controls:CalloutLabelText id="cl5" 
										   newStyleName="grayText"
										   labelField="body" 
										   buttonLabel="Body/Side Route:" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object body="Body/Side Route 1"/>
							<fx:Object body="Body/Side Route 2"/>
							<fx:Object body="Body/Side Route 3"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				
				<!--<s:Label text="Lot #: {_selectedRecord.lotNumber != null ? _selectedRecord.lotNumber : ''}" styleName="grayText"/>-->
				<controls:CalloutLabelText id="cl6" 
										   newStyleName="grayText"
										   labelField="lot" 
										   buttonLabel="Lot #:" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object lot="Lot # 1"/>
							<fx:Object lot="Lot # 2"/>
							<fx:Object lot="Lot # 3"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<!--<s:Label text="Date admin: {_selectedRecord.reasonForRefusal != null ? _selectedRecord.reasonForRefusal : ''}" styleName="grayText"/>-->
				<controls:CalloutLabelText id="cl7" 
										   newStyleName="grayText"
										   labelField="reason" 
										   buttonLabel="Reason:" 
										   enabled="{refusalTS2.selected}" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object reason="Reason for refusal 1"/>
							<fx:Object reason="Reason for refusal 2"/>
							<fx:Object reason="Reason for refusal 3"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<!--<s:Label text="Next due: {_selectedRecord.site != null ? _selectedRecord.site : ''}" styleName="grayText"/>-->
				<controls:CalloutLabelText id="cl8" 
										   newStyleName="grayText"
										   labelField="site" 
										   buttonLabel="Site:" 
										   enabled="{refusalTS2.selected}" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object site="Site 1"/>
							<fx:Object site="Site 2"/>
							<fx:Object site="Site 3"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<!--<s:Label text="Expirty date: {_selectedRecord.series != null ? _selectedRecord.series : ''}" styleName="grayText"/>-->
				<controls:CalloutLabelText id="cl9" 
										   newStyleName="grayText"
										   labelField="series" 
										   buttonLabel="Series:" 
										   enabled="{refusalTS2.selected}" 
										   isEditForm="{_isEditForm}">
					<controls:dataProvider>
						<s:ArrayCollection>
							<fx:Object series="Series 1"/>
							<fx:Object series="Series 2"/>
							<fx:Object series="Series 3"/>
						</s:ArrayCollection>
					</controls:dataProvider>
				</controls:CalloutLabelText>
				
				<s:Button label="Save"
						  styleName="button"
						  click="updateRecord(event)"/>
				
			</s:VGroup>
		</s:HGroup>
		
	</s:BorderContainer>
	
	
	<!-- end presentation form -->
	
	
	
	
	
	
	
	
	
	
	
	
	
	<s:HGroup width="100%"
			  id="g1"
			  styleName="ipeForm" 
			  horizontalAlign="center" 
			  includeIn="normal, full">
		
		<controls:CalloutButtonText id="cb1" 
									styleName="calloutBtn" 
									labelField="associatedWith" 
									buttonLabel="Associated with:"
									required="true" 
									isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
					<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
					<fx:Object associatedWith="Visit 3" immunization="Immunization 3" dose="1000000"/>
					<fx:Object associatedWith="Visit 4" immunization="Immunization 3" dose="2000000"/>
					<fx:Object associatedWith="Visit 5" immunization="Immunization 3" dose="3000000"/>
					<fx:Object associatedWith="Visit 6" immunization="Immunization 3" dose="4000000"/>
					<fx:Object associatedWith="Visit 7" immunization="Immunization 3" dose="5000000"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb2"
									styleName="calloutBtn" 
									labelField="immunization" 
									buttonLabel="Immunization:"
									required="true"
									isEditForm="{_isEditForm}" >
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
					<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
					<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="2000000"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb3"
									styleName="calloutBtn" 
									labelField="dose" 
									buttonLabel="Dose:"
									required="true"
									isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
					<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
					<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="2000000"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
	</s:HGroup>
	
	<s:HGroup width="100%" 
			  id="g2"
			  styleName="ipeForm"
			  horizontalAlign="center"
			  includeIn="full">
		
		<controls:CalloutButtonText id="cb4" styleName="button" labelField="manufacturer" buttonLabel="Manufacturer:" isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object manufacturer="Manufacturer 1"/>
					<fx:Object manufacturer="Manufacturer 2"/>
					<fx:Object manufacturer="Manufacturer 3"/>
					<fx:Object manufacturer="Manufacturer 4"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb5" styleName="button" labelField="body" buttonLabel="Body/Side Route:" isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object body="Body/Side Route 1"/>
					<fx:Object body="Body/Side Route 2"/>
					<fx:Object body="Body/Side Route 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb6" styleName="button" labelField="lot" buttonLabel="Lot #:" isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object lot="Lot # 1"/>
					<fx:Object lot="Lot # 2"/>
					<fx:Object lot="Lot # 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
	</s:HGroup>
	
	<s:Button excludeFrom="full, presentation"
			  styleName="button"
			  label="{_buttonLabel}"
			  click="addRecord(event)"/>
	
	<s:HGroup id="g3"
			  width="100%" 
			  styleName="ipeForm"
			  horizontalAlign="center"
			  includeIn="full">
		
		<controls:CalloutDateSpinner id="ds1" buttonLabel="Date Admin:" isEditForm="{_isEditForm}"/>
		<controls:CalloutDateSpinner id="ds2" buttonLabel="Next Due:" isEditForm="{_isEditForm}"/>
		<controls:CalloutDateSpinner id="ds3" buttonLabel="Expiry Date:" isEditForm="{_isEditForm}"/>
		
	</s:HGroup>
	
	
	<s:HGroup width="100%" 
			  id="g4"
			  styleName="ipeForm"
			  horizontalAlign="center"
			  includeIn="full">
		
		<controls:CalloutButtonText id="cb7" styleName="button" labelField="reason" buttonLabel="Reason:" enabled="{refusalTS.selected}" isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object reason="Reason for refusal 1"/>
					<fx:Object reason="Reason for refusal 2"/>
					<fx:Object reason="Reason for refusal 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb8" styleName="button" labelField="site" buttonLabel="Site:" enabled="{refusalTS.selected}" isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object site="Site 1"/>
					<fx:Object site="Site 2"/>
					<fx:Object site="Site 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
		<controls:CalloutButtonText id="cb9" 
									styleName="button" 
									labelField="series" 
									buttonLabel="Series:" 
									enabled="{refusalTS.selected}" isEditForm="{_isEditForm}">
			<controls:dataProvider>
				<s:ArrayCollection>
					<fx:Object series="Series 1"/>
					<fx:Object series="Series 2"/>
					<fx:Object series="Series 3"/>
				</s:ArrayCollection>
			</controls:dataProvider>
		</controls:CalloutButtonText>
		
	</s:HGroup>
	
	
	<s:HGroup width="100%"
			  id="g5"
			  styleName="ipeForm"
			  horizontalAlign="center" 
			  paddingLeft="10"
			  includeIn="full">
		
		<controls:ToggleSwitchLabel id="refusalTS" 
									label="Refusal:" 
									click="refusalTS_clickHandler(event)"
									width="120"/>
		
		<!--<s:Spacer width="50%"/>-->
		
		<!--<s:Button label="Cancel"
		styleName="button"
		visible="{_isEditForm}"
		click="{this.currentState='presentation'}"/>-->
		
		<s:Button id="actionBtn"
				  styleName="button"
				  label="{_buttonLabel}"
				  click="addRecord(event)"/>
		
	</s:HGroup>
	
	<s:Spacer height="5"/>
	
	<s:VGroup gap="-1" 
			  width="100%" 
			  horizontalAlign="center"
			  id="fullOptionsHandle">
		<s:Line width="100%">
			<s:stroke>
				<s:SolidColorStroke color="0x898989" weight="2"/>
			</s:stroke>
		</s:Line>
		<s:Image source="assets/optionsHandle.png" 
				 click="{this.currentState = 'full'}"
				 click.full="{this.currentState = 'normal'}"
				 useHandCursor="true"
				 buttonMode="true"/>
	</s:VGroup>
	
	
</s:Group>
