<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="init(event)" 
		 xmlns:components="com.zigron.controls.extended.components.*"
		 width="100%" 
		 height="100%">
	
	<fx:Metadata>
		[Event(name="saveFormData", type="com.gazuntite.events.SaveFormDataEvent")]
		[Event(name="toggleFormOptions", type="com.gazuntite.events.ToggleFormOptionsEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.events.ToggleFormOptionsEvent;
			import com.gazuntite.model.AppModelLocator;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			import mx.validators.Validator;
			
			[Bindable]
			protected var errors:Array;
			
			[Bindable]
			protected var dummyAC:ArrayCollection = new ArrayCollection([]);
			
			protected function init(event:FlexEvent):void
			{
				validatorsArray = new Array();
				
				dummyAC.addItem({ImmunizationTypeName:"Immunization"});
			}
			
			protected function handleShowAllOptions(event:MouseEvent, full:Boolean=true):void
			{
				var e:ToggleFormOptionsEvent = new ToggleFormOptionsEvent(ToggleFormOptionsEvent.TOGGLE_FORM_OPTIONS);
				e.full = full;
				dispatchEvent(e);
			}
			
			protected function validateForm():Boolean
			{
				errors = new Array();
				errors = Validator.validateAll(validatorsArray);
				if (errors.length == 0){
					return true;
				}
				else{
					return false;
				}
			}
			
			protected function addRecord(event:MouseEvent):void
			{
				
				if(validateForm())
				{
					// dummy data for test binding
					var r:ObjectProxy = new ObjectProxy();
					r.associatedWith = myCB.selectedItem.associatedWith;
					r.immunization = myCB2.selectedItem.immunization;
					r.dose = myCB3.selectedItem.dose;
					
					var e:SaveFormDataEvent = new SaveFormDataEvent(SaveFormDataEvent.SAVE_FORM_DATA);
					e.payload = r;
					
					dispatchEvent(e);
					
				}
			}
			
			public function expandForm():void
			{
				this.currentState = "expanded";
			}
			
			public function shortenForm():void
			{
				this.currentState = "normal";
			}
			
			
			
		]]>
	</fx:Script>
	
	
	<fx:Declarations>
		<!--Array of Validators-->
		<fx:Array id="validatorsArray">
			<mx:StringValidator source="{myCB}" property="selectedItem" required="true"
								requiredFieldError="Please enter or select an item." />
			<mx:StringValidator source="{myCB2}" property="selectedItem" required="true"
								requiredFieldError="Please enter or select an item." />
			<mx:StringValidator source="{myCB3}" property="selectedItem" required="true"
								requiredFieldError="Please enter or select an item." />
		</fx:Array>
	</fx:Declarations>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="expanded"/>
	</s:states>
	
	<s:BorderContainer left="0" 
					   right="0" 
					   top="0" 
					   bottom="0"
					   borderWeight="0" 
					   cornerRadius="0" 
					   dropShadowVisible="false"
					   borderAlpha="0">
		
		<s:backgroundFill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color="0xd7d7d7" ratio=".33" />
				<s:GradientEntry color="0xffffff" ratio=".66"/>
			</s:LinearGradient>
		</s:backgroundFill>
		
		<s:layout>
			<s:VerticalLayout paddingBottom="0"
							  paddingLeft="0"
							  paddingRight="0"
							  paddingTop="0"
							  gap="0"
							  horizontalAlign="center"/>
		</s:layout>
		
		<s:Group width="100%" 
				 height="100%" 
				 styleName="ipeForm">
			
			<s:layout>
				<s:VerticalLayout paddingBottom="3"
								  paddingLeft="3"
								  paddingRight="3"
								  paddingTop="3"
								  gap="3"/>
			</s:layout>
			
			<s:HGroup width="100%" verticalAlign="middle">
				
				<s:Label text="Associated with:" 
						 styleName="ipeFormLabel"/>
				<s:DropDownList id="myCB" prompt="Associated With" 
								width="100%"
								height="100%"
								labelField="associatedWith" 
								requireSelection="true"
								tabFocusEnabled="true">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
							<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
							<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="1000000"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				
				
				<s:Label text="Immunization:" 
						 styleName="ipeFormLabel"/>
				<s:DropDownList id="myCB2" 
								prompt="Immunization" 
								width="100%"
								height="100%"
								labelField="immunization" 
								requireSelection="true">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
							<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
							<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="1000000"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				
				
				<s:Label text="Dose:" 
						 styleName="ipeFormLabel"/>
				
				<s:DropDownList id="myCB3" 
								prompt="Dose" 
								width="100%"
								height="100%"
								labelField="dose" 
								requireSelection="true">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object associatedWith="This Visit" immunization="7-Valent" dose="1000000"/>
							<fx:Object associatedWith="Last Visit" immunization="Immunization 2" dose="1000000"/>
							<fx:Object associatedWith="Whenever" immunization="Immunization 3" dose="1000000"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				
				
			</s:HGroup>
			<!--<s:HGroup width="100%" includeIn="expanded">
			<s:Button skinClass="com.gazuntite.skins.NotesFormBtnSkin" 
			useHandCursor="true"
			buttonMode="true"
			toolTip="Notes"/>
			
			<s:Button skinClass="com.gazuntite.skins.DictationFormBtnSkin"
			useHandCursor="true"
			buttonMode="true"
			toolTip="Dictation"/>
			</s:HGroup>-->
			
			<s:HGroup width="100%">
				
				<s:Button label="Add record"
						  includeIn="normal"
						  styleName="button"
						  click="addRecord(event)"/>
			</s:HGroup>
			
			<!-- Optional fields -->
			
			<s:HGroup width="100%"  
					  verticalAlign="middle"
					  includeIn="expanded">
				
				<s:Label text="Manufacturer:" 
						 styleName="ipeFormLabel"/>
				<s:DropDownList prompt="Manufacturer" 
								width="100%"
								height="100%"
								labelField="manufacturer" 
								requireSelection="true">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object manufacturer="Manufacturer 1"/>
							<fx:Object manufacturer="Manufacturer 2"/>
							<fx:Object manufacturer="Manufacturer 3"/>
							<fx:Object manufacturer="Manufacturer 4"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				
				
				
				<s:Label text="Body/Side Route:" 
						 styleName="ipeFormLabel"/>
				<s:DropDownList prompt="Body/Side Route" 
								width="100%"
								height="100%"
								labelField="body" 
								requireSelection="true">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object body="Body/Side Route 1"/>
							<fx:Object body="Body/Side Route 2"/>
							<fx:Object body="Body/Side Route 3"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>		
				
				
				<s:Label text="Lot #:" 
						 styleName="ipeFormLabel"/>
				
				<s:DropDownList prompt="Lot #" 
								width="100%"
								height="100%"
								labelField="lot" 
								requireSelection="true">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object lot="Lot # 1"/>
							<fx:Object lot="Lot # 2"/>
							<fx:Object lot="Lot # 3"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				
				
			</s:HGroup>
			
			<s:HGroup width="100%" 
					  verticalAlign="middle"
					  includeIn="expanded">
				
				<s:Label text="Date Admin:" 
						 styleName="ipeFormLabel"/>
				<components:LabelDateField label="Date Admin"/>
				
				<s:Label text="Next Due:" 
						 styleName="ipeFormLabel"/>
				
				<components:LabelDateField label="Next Due"/>
				
				<s:Label text="Expiry Date:" 
						 styleName="ipeFormLabel"/>
				<components:LabelDateField label="Expiry Date"/>
				
			</s:HGroup>
			
			<s:HGroup width="100%"
					  verticalAlign="middle"
					  includeIn="expanded">
				
				<s:Label text="Refusal:" 
						 styleName="ipeFormLabel"/>
				<s:CheckBox id="refusalCB" label="Refusal"/>
				
				<s:Label text="Reason:" 
						 styleName="ipeFormLabel"/>
				
				<s:DropDownList prompt="Reason for refusal" 
								width="100%"
								height="100%"
								labelField="reason" 
								requireSelection="true"
								includeIn="expanded"
								enabled="{refusalCB.selected}">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object reason="Reason for refusal 1"/>
							<fx:Object reason="Reason for refusal 2"/>
							<fx:Object reason="Reason for refusal 3"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>	
				
				<s:Label text="Site:" 
						 styleName="ipeFormLabel"/>
				
				<s:DropDownList prompt="Site" 
								width="100%"
								height="100%"
								labelField="site" 
								requireSelection="true"
								enabled="{refusalCB.selected}">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object site="Site 1"/>
							<fx:Object site="Site 2"/>
							<fx:Object site="Site 3"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>		
				
			</s:HGroup>
			
			<s:HGroup width="100%" 
					  verticalAlign="middle"
					  includeIn="expanded">
				
				<s:Label text="Series:" 
						 styleName="ipeFormLabel"/>
				
				<s:DropDownList prompt="Series" 
								
								labelField="series" 
								requireSelection="true"
								enabled="{refusalCB.selected}">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object series="Series 1"/>
							<fx:Object series="Series 2"/>
							<fx:Object series="Series 3"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>	
				
				<s:Button label="Add record"
						  includeIn="expanded"
						  styleName="button"
						  click="addRecord(event)"/>
				
			</s:HGroup>
			
			<!--<s:filters>
			<s:DropShadowFilter distance="1"
			strength=".33"/>
			</s:filters>-->
			
		</s:Group>
		
		<!--<s:Spacer height="10"/>-->
		
		<s:Line width="100%">
			<!--<s:filters>
			<s:DropShadowFilter distance="1"
			strength=".55"
			angle="90"/>
			</s:filters>-->
			<s:stroke>
				<s:SolidColorStroke color="#000000" weight="1"/>
			</s:stroke>
		</s:Line>
		
		<s:Button skinClass="com.gazuntite.skins.OptionsHandleBtnSkin"
				  click="handleShowAllOptions(event, true)"
				  click.expanded="handleShowAllOptions(event, false)"
				  buttonMode="true"
				  useHandCursor="true"
				  toolTip="More options">
			<!--<s:filters>
			<s:DropShadowFilter distance="1"
			strength=".55"
			angle="90"/>
			</s:filters>-->
			
		</s:Button>
		
	</s:BorderContainer>
	
</s:Group>
