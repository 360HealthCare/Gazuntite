<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:spicefactory="http://www.spicefactory.org/parsley"
		 width="100%" 
		 height="100%"
		 creationComplete="init(event)" 
		 xmlns:controls="com.gazuntite.view.controls.*" 
		 xmlns:compHistory="com.gazuntite.view.quickInput.compHistory.*" 
		 xmlns:compHistory1="com.gazuntite.view.quickInput.forms.compHistory.*"
		 xmlns:ns="library://ns.tink.ws/flex/spark">
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.view.itemrenderers.compHistory.CompHistoryDetailItemRenderer;
			import com.gazuntite.events.ArrangeByEvent;
			import com.gazuntite.events.SaveFormDataEvent;
			import com.gazuntite.model.SharedModel;
			
			import mx.events.FlexEvent;
			import mx.utils.ObjectProxy;
			
			[Bindable]
			public var sharedModel:SharedModel;
			
			protected var selectedBtn:OptionButton;
			
			protected function init(event:FlexEvent):void
			{
				setYesNoValue();
			}
			
			protected function arrangebycalloutbutton1_arrangeByHandler(event:ArrangeByEvent):void
			{
				
				switch(event.field)
				{
					case "ICD Code":
						detailList.itemRenderer = new ClassFactory(CompHistoryDetailItemRenderer);
						break;
				}
			}
			
			protected function showForm():void
			{
				
			}
			
			private function OnYesNoClick(value:String, secLabel:String, target:OptionButton):void
			{
				setSelectedTab( secLabel );
				setYesNoValue(value);
			}
			
			private function setYesNoValue(value:String=null):void
			{
				/* var elm:GeneralSectionTabImpl = (id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as GeneralSectionTabImpl;
				
				elm.Label = "You have selected \n" + value;
				elm.IsSelected = (value == Constants.STRING_YES_UI) ? true:false;
				
				if( value == Constants.STRING_YES_UI )
				callLater( elm.id_NotesView.id_TextArea.setFocus );
				
				elm.medicalHistoryDto.IsNone = (value == Constants.STRING_NONE_UI )? Constants.STRING_TRUE:Constants.STRING_FALSE;
				
				if( value == Constants.STRING_NONE_UI )
				{
				elm.id_Views.selectedIndex = 0;
				} */
				
				if(value == null)
				{
					if(selectedBtn != null)
					{
						value = selectedBtn.indicator;
					}
				}
				
				
				switch(value)
				{
					case "Y":
						compHistoryForm.setState("form");
						break;
					case "N":
						compHistoryForm.setState("none");
						break;
					default:
						compHistoryForm.setState("nonselected");
						break;
				}
				
				//trace(value);
				
			}
			
			protected function OnTabClick(event:MouseEvent, secLabel:String):void
			{
				setSelectedTab( secLabel );
			}
			
			protected function setSelectedTab(tabName:String):void
			{
				//var tabtitle:String = AppUtils.TitleCase( tabName );
				
				var idx:int;
				
				switch( tabName )
				{
					case "Heart Disease":
						selectedBtn = heartDiseaseBtn;
						idx = 0;
						break;
					case "Hypertension":
						selectedBtn = hypertentionBtn;
						idx = 1;
						break;
					case "Diabetes":
						selectedBtn = diabetesBtn;
						idx = 2;
						break;
					case "Cancer":
						selectedBtn = cancerBtn;
						idx = 3;
					case "Other":
						idx = 4;
						break;
					
				}
				
				//callLater( AppUtils.EnableSelection, [ id_TabButtons, AppUtils.getButtonByLabel( id_TabButtons, tabtitle ) ] );
				resetButtons(idx);
				setYesNoValue();
			}
			
			protected function resetButtons(idx:int):void
			{
				for( var i:int = 0; i < optionsGroup.numElements; i++ )
				{
					var b:OptionButton = optionsGroup.getElementAt( i ) as OptionButton;
					if(i != idx)
					{
						b.id_MainButton.selected = false; 
					}
					else
					{
						b.id_MainButton.selected = true; 
					}
				}
			}
			
			protected function compHistoryForm_saveFormDataHandler(event:SaveFormDataEvent):void
			{
				var o:ObjectProxy = event.payload as ObjectProxy;
				o.type = selectedBtn.Label;
				sharedModel.familyHistoryAC.addItem(event.payload);
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<spicefactory:Configure/>
		<spicefactory:FastInject property="sharedModel" type="{SharedModel}"/>
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	
	<s:BorderContainer id="General" 
					   width="100%">
		
		<s:layout>
			<s:VerticalLayout paddingBottom="0"
							  paddingLeft="3"
							  paddingRight="3"
							  paddingTop="3"
							  horizontalAlign="center"
							  verticalAlign="top"/>
		</s:layout>
		
		<s:HGroup width="100%">
			
			<s:VGroup id="optionsGroup"
					  gap="0" 
					  paddingBottom="0" 
					  paddingTop="0">
				<compHistory:OptionButton id="heartDiseaseBtn" 
										  showOptionButtons="YN" 
										  Label="Heart Disease" 
										  YesNoClickHandler="OnYesNoClick"
										  ButtonClickHandler="OnTabClick"/>
				<compHistory:OptionButton id="hypertentionBtn" 
										  showOptionButtons="YN" 
										  Label="Hypertension" 
										  YesNoClickHandler="OnYesNoClick"
										  ButtonClickHandler="OnTabClick"/>
				<compHistory:OptionButton id="diabetesBtn" 
										  showOptionButtons="YN" 
										  Label="Diabetes" 
										  YesNoClickHandler="OnYesNoClick"
										  ButtonClickHandler="OnTabClick"/>
				<compHistory:OptionButton id="cancerBtn" 
										  showOptionButtons="YN" 
										  Label="Cancer" 
										  YesNoClickHandler="OnYesNoClick"
										  ButtonClickHandler="OnTabClick"/>
			</s:VGroup>
			
			
			<s:VGroup width="100%">
				<compHistory1:QIFamilyHistoryForm id="compHistoryForm" 
											saveFormData="compHistoryForm_saveFormDataHandler(event)"/>
			</s:VGroup>
			
		</s:HGroup>
		
	</s:BorderContainer>
	
	
	
	<!-- History -->
	
	<s:VGroup width="100%" height="100%">
		
		<s:BorderContainer width="100%"
						   height="24"
						   borderWeight="1" 
						   borderColor="0x898989"
						   cornerRadius="0" 
						   dropShadowVisible="false"
						   borderAlpha="1">
			
			<s:backgroundFill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry color="0x898989" ratio=".1"/>
					<s:GradientEntry color="0xf3f3f3" ratio=".9"/>
				</s:LinearGradient>
			</s:backgroundFill>
			
			<s:layout>
				<s:HorizontalLayout verticalAlign="bottom" 
									paddingLeft="10"
									paddingBottom="10"/>
			</s:layout>
			
			<controls:ArrangeByCalloutButton label="Arrange By:"
											 color="0x000000"
											 arrangeBy="arrangebycalloutbutton1_arrangeByHandler(event)">
				<controls:dataProvider>
					<s:ArrayCollection>
						<fx:Object name="ICD Code"/>
					</s:ArrayCollection>
				</controls:dataProvider>
			</controls:ArrangeByCalloutButton>
			
			<s:Label text="Family History records:" styleName="listLabel"/>
			
		</s:BorderContainer>
		
		<s:List id="detailList"
				width="100%"
				height="100%"
				dataProvider="{sharedModel.familyHistoryAC}"
				itemRenderer="com.gazuntite.view.itemrenderers.compHistory.CompHistoryDetailItemRenderer"/>
		
	</s:VGroup>
	
	
</s:Group>
