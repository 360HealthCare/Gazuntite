	<s:states>
		<s:State name="default"/>
		<s:State name="mouseOver"/>
	</s:states>

	<fx:Declarations>
		<mx:DateFormatter id="df" formatString="EEEE MMMM D YYYY, L:NNA"/>
	</fx:Declarations>

	<s:HGroup left="0" right="0" top="0" bottom="0" verticalAlign="middle"
			  paddingRight="10">
		<s:VGroup click="handleSelect(event)"
				  width="100%" height="100%" verticalAlign="middle">
			<s:Label text="{(data as File).name}" maxDisplayedLines="1"/>
		</s:VGroup>
		
		<s:Button skinClass="com.gazuntite.skins.AddDictationBtnSkin"/>
		
		<s:Button skinClass="com.gazuntite.skins.DeleteDictationBtnSkin"
				  click="handleDelete(event)"/>
	</s:HGroup>

	<s:Line bottom="0" left="0" right="0">
		<s:stroke>
			<s:SolidColorStroke color="#505050"	weight="1" alpha="1"/>
		</s:stroke>
	</s:Line>
	
